# Force LF line endings for shell scripts and text config files so they run
# correctly in the Linux CI/smoke containers regardless of the checkout OS.
*.sh text eol=lf
*.py text eol=lf
*.cmake text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.md text eol=lf
CMakeLists.txt text eol=lf
scripts/package/pto_as/bin/ptoas text eol=lf
