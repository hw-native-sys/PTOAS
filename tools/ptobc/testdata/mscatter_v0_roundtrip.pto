module attributes {pto.target_arch = "a5"} {
  func.func @mscatter_v0_roundtrip(%dst: !pto.ptr<f32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %c32 = arith.constant 32 : index
    %c256 = arith.constant 256 : index
    %dst_view = pto.make_tensor_view %dst,
                shape = [%c256], strides = [%c1]
                {layout = #pto.layout<nd>}
              : !pto.tensor_view<?xf32>
    %dst_part = pto.partition_view %dst_view,
                offsets = [%c0], sizes = [%c256]
              : !pto.tensor_view<?xf32>
                -> !pto.partition_tensor_view<256xf32>
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=32, v_row=8, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %idx = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=i32, rows=8, cols=32, v_row=8, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.mscatter ins(%src, %idx : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=32, v_row=8, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=i32, rows=8, cols=32, v_row=8, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
                 outs(%dst_part : !pto.partition_tensor_view<256xf32>)
                 {coalesce = #pto<coalesce elem>,
                  scatterAtomicOp = #pto<scatter_atomic_op add>,
                  scatterOob = #pto<scatter_oob skip>,
                  scatterConflict = #pto<scatter_conflict last>}
    return
  }
}
