// Desired VPTO / pto.mi: PK pack of UE8M0 bytes into ui16 storage.

module {
  func.func @packed_ue8m0_sf_store_mi(
      %sf_u8: !pto.vreg<256xui8>,
      %dst: !pto.ptr<ui16, ub>,
      %off: index) {
    %m = pto.pset_b8 "PAT_ALL" : !pto.mask<b8>
    // Pack adjacent ui8 lanes (pack_factor=2) then store as ui16 / PK path.
    pto.vsts %sf_u8, %dst[%off], %m {dist = "PK_B16"}
        : !pto.vreg<256xui8>, !pto.ptr<ui16, ub>, !pto.mask<b8>
    return
  }
}
