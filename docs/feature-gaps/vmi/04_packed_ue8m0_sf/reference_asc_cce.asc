// ASC/CCE working baseline for gap 04: packed ui16 SF store (ONEPT_B16 / PK_B16).
// Compiles with bisheng --cce-aicore-only (see README).
#include "kernel_operator.h"

// Packed UE8M0 path stores one ui16 per pair of ui8 exponents.
__simd_vf__ inline void vf_onept_u16(__ubuf__ uint16_t* src, __ubuf__ uint16_t* dst) {
  vector_bool v = pset_b16(PAT_ALL);
  vector_u16 x;
  vlds(x, src, 0, NORM);
  vsts(x, dst, 0, ONEPT_B16, v);
}

__simd_vf__ inline void vf_pk_b16(__ubuf__ uint16_t* src, __ubuf__ uint16_t* dst) {
  vector_bool v = pset_b16(PAT_ALL);
  vector_u16 x;
  vlds(x, src, 0, NORM);
  vsts(x, dst, 0, PK_B16, v);
}

extern "C" __global__ __vector__ void ref_gap04_packed_sf(__gm__ uint16_t* /*gm_in*/,
                                                         __gm__ uint16_t* /*gm_out*/) {
  AscendC::InitSocState();
  __ubuf__ uint16_t* ub = (__ubuf__ uint16_t*)0;
  vf_onept_u16(ub, ub + 64);
  vf_pk_b16(ub, ub + 128);
}
