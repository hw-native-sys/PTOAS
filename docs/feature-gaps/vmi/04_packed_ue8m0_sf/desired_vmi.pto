// Idiomatic VMI: pack adjacent UE8M0 bytes into ui16 (pack_factor=2).

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @packed_ue8m0_sf_store(
      %sf_u8: !pto.vmi.vreg<64xui8>,
      %dst: !pto.ptr<ui16, ub>,
      %off: index) {
    %sf_u16 = pto.vmi.vpack %sf_u8
        : !pto.vmi.vreg<64xui8> -> !pto.vmi.vreg<32xui16>
    pto.vmi.vstore %sf_u16, %dst[%off]
        : !pto.vmi.vreg<32xui16>, !pto.ptr<ui16, ub>
    return
  }
}
