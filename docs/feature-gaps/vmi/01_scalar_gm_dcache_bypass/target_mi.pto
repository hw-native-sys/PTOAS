// Desired VPTO / pto.mi shape: one GM scalar store, dcache-bypass, no MTE burst.

module {
  func.func @scale_factor_gm_bypass_mi(
      %sf_gm: !pto.ptr<f32, gm>,
      %scale: !pto.vreg<64xf32>,
      %off: index) {
    %m = pto.pge_b32 "PAT_VL1" : !pto.mask<b32>
    // Single-point GM store; dcache_bypass on the memory op.
    pto.vsts %scale, %sf_gm[%off], %m {dist = "1PT_B32", dcache_bypass}
        : !pto.vreg<64xf32>, !pto.ptr<f32, gm>, !pto.mask<b32>
    return
  }
}
