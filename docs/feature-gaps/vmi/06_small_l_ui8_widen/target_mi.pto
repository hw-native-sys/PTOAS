// Desired MI: ui8→ui16 widen via vcvt (EVEN/ODD), then dense ui16 store.
// Small-L VMI should lower to this shape instead of residual pto.vmi.extui.

module {
  func.func @ui8_to_ui16_widen_mi(
      %input: !pto.vreg<256xui8>,
      %dst: !pto.ptr<ui16, ub>,
      %off: index) {
    pto.vecscope {
      %m = pto.pset_b8 "PAT_ALL" : !pto.mask<b8>
      %even = pto.vcvt %input, %m {part = "EVEN"}
          : !pto.vreg<256xui8>, !pto.mask<b8> -> !pto.vreg<128xui16>
      %m16 = pto.pset_b16 "PAT_ALL" : !pto.mask<b16>
      pto.vsts %even, %dst[%off], %m16
          : !pto.vreg<128xui16>, !pto.ptr<ui16, ub>, !pto.mask<b16>
    }
    return
  }
}
