// Working AscendC baseline: keep a few inverse values in VF locals and multiply
// a short strip. No pad-to-32 UB store + broadcast reload.
// Compiles with bisheng --cce-aicore-only (see README).

#include "kernel_operator.h"

__simd_vf__ inline void vf_reg_local_inverse_mul(__ubuf__ float* data,
                                                 __ubuf__ float* out) {
  vector_bool mall = pset_b32(PAT_ALL);
  // Two inverse lanes kept in locals (stands in for a small recip/inverse set).
  vector_f32 inverse[2];
  vdup(inverse[0], (float)0.5f, mall, MODE_ZEROING);
  vdup(inverse[1], (float)0.25f, mall, MODE_ZEROING);

  vector_f32 x0, x1, y0, y1;
  vlds(x0, data, 0, NORM);
  vlds(x1, data, 64, NORM);
  // Reuse locals directly — the AscendC pattern kernels rely on.
  vmul(y0, x0, inverse[0], mall, MODE_ZEROING);
  vmul(y1, x1, inverse[1], mall, MODE_ZEROING);
  vsts(y0, out, 0, NORM_B32, mall);
  vsts(y1, out, 64, NORM_B32, mall);
}

extern "C" __global__ __vector__ void ref_pad_brc_reg_local_inverse(
    __gm__ float* /*gm_in*/, __gm__ float* /*gm_out*/) {
  AscendC::InitSocState();
  __ubuf__ float* ub_data = (__ubuf__ float*)0;
  __ubuf__ float* ub_out = ub_data + 128;
  vf_reg_local_inverse_mul(ub_data, ub_out);
}
