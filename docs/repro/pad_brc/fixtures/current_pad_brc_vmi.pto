// Current working VMI path: store G=4 recip into a pad-32 layout, reload with
// dist_mode="brc", then multiply a 128-lane strip. Lowers today; not ideal.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @current_pad_brc(
      %recip: !pto.vmi.vreg<4xf32, #pto.vmi.layout<num_groups = 4, slots = 1>>,
      %pad: !pto.ptr<f32, ub>,
      %data: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>,
      %off: index) -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>> {
    %c1 = arith.constant 1 : index
    // Pad-oriented group store (32-wide slot layout in real kernels).
    pto.vmi.vstore %recip, %pad[%off], %c1 {group = 4}
        : !pto.vmi.vreg<4xf32, #pto.vmi.layout<num_groups = 4, slots = 1>>,
          !pto.ptr<f32, ub>
    // Broadcast reload of the padded slot across 128 lanes.
    %expanded = pto.vmi.vload %pad[%off], %c1 {dist_mode = "brc", group = 4}
        : !pto.ptr<f32, ub>
        -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
    %out = pto.vmi.vmul %data, %expanded
        : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
    return %out : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
  }
}
