// Copyright (c) 2026 Huawei Technologies Co., Ltd.
// AscendC reference: FP32 → e4m3 block quantize with two on-chip faces.
// Tile 32×512, stages=2, scale block 32×32, UE8M0-style round_sf.
// Runtime: fixtures/fp32_block_quant_artifact/libfp32_block_quant.so
// (ctypes call_fp32_block_quant; host takes num_tokens dynamically; hidden=2048).
//
// VF ops below are thin __simd_callee__ return wrappers around AscendC
// MicroAPI. Device body is under __DAV_VEC__ so bisheng --shared host compile
// does not need vector_f8e4m3.

#include "kernel_operator.h"

using fp8_e4_t = float8_e4m3_t;

extern "C" __global__ __vector__ void fp32_block_quant_kernel(
    __gm__ fp8_e4_t* out, __gm__ float* output_sf, __gm__ float* x,
    int32_t num_tokens, int32_t sf_stride);

#if defined(__DAV_VEC__)

// --- VF leaf helpers (concrete types only; kept next to this kernel) ----------
__simd_callee__ inline vector_f32 bq_load_f32(__ubuf__ float* p, int32_t off) {
  vector_f32 r;
  vlds(r, p, off, NORM);
  return r;
}
__simd_callee__ inline void bq_store_f32_onept(vector_f32 x, __ubuf__ float* p) {
  vsts(x, p, 0, ONEPT_B32, pset_b32(PAT_ALL));
}
__simd_callee__ inline void bq_store_e4m3(vector_f8e4m3 x, __ubuf__ float8_e4m3_t* p) {
  vsts(x, p, 0, PK4_B32, pset_b8(PAT_ALL));
}
__simd_callee__ inline vector_f32 bq_abs_f32(vector_f32 x) {
  vector_f32 r;
  vabs(r, x, pset_b32(PAT_ALL), MODE_ZEROING);
  return r;
}
__simd_callee__ inline vector_f32 bq_max_f32(vector_f32 a, vector_f32 b) {
  vector_f32 r;
  vmax(r, a, b, pset_b32(PAT_ALL), MODE_ZEROING);
  return r;
}
__simd_callee__ inline vector_f32 bq_mul_f32(vector_f32 a, vector_f32 b) {
  vector_f32 r;
  vmul(r, a, b, pset_b32(PAT_ALL), MODE_ZEROING);
  return r;
}
__simd_callee__ inline vector_f32 bq_dup_f32(float s) {
  vector_f32 r;
  vdup(r, s, pset_b32(PAT_ALL), MODE_ZEROING);
  return r;
}
__simd_callee__ inline vector_u32 bq_dup_u32(uint32_t s) {
  vector_u32 r;
  vdup(r, s, pset_b32(PAT_ALL), MODE_ZEROING);
  return r;
}
__simd_callee__ inline vector_f32 bq_bcast_lo(vector_f32 x) {
  vector_f32 r;
  vdup(r, x, pset_b32(PAT_ALL), POS_LOWEST, MODE_ZEROING);
  return r;
}
__simd_callee__ inline vector_f32 bq_bcast_hi(vector_f32 x) {
  vector_f32 r;
  vdup(r, x, pset_b32(PAT_ALL), POS_HIGHEST, MODE_ZEROING);
  return r;
}
__simd_callee__ inline vector_f32 bq_cmax(vector_f32 x, vector_bool m) {
  vector_f32 r;
  vcmax(r, x, m, MODE_ZEROING);
  return r;
}
__simd_callee__ inline vector_f32 bq_sel_f32(vector_f32 a, vector_f32 b,
                                            vector_bool m) {
  vector_f32 r;
  vsel(r, a, b, m);
  return r;
}
__simd_callee__ inline vector_bool bq_gt_s32(vector_s32 a, int32_t s) {
  vector_bool r;
  vcmps_gt(r, a, s, pset_b32(PAT_ALL));
  return r;
}
__simd_callee__ inline vector_s32 bq_lane_ids() {
  vector_s32 r;
  vci(r, 0, INC_ORDER);
  return r;
}
__simd_callee__ inline vector_u32 bq_sub_u32(vector_u32 a, vector_u32 b) {
  vector_u32 r;
  vsub(r, a, b, pset_b32(PAT_ALL), MODE_ZEROING);
  return r;
}
__simd_callee__ inline vector_u32 bq_shrs_u32(vector_u32 a, int32_t n) {
  vector_u32 r;
  vshrs(r, a, n, pset_b32(PAT_ALL), MODE_ZEROING);
  return r;
}
__simd_callee__ inline vector_u32 bq_shls_u32(vector_u32 a, int32_t n) {
  vector_u32 r;
  vshls(r, a, n, pset_b32(PAT_ALL), MODE_ZEROING);
  return r;
}
__simd_callee__ inline vector_u32 bq_adds_u32(vector_u32 a, int32_t n) {
  vector_u32 r;
  vadds(r, a, n, pset_b32(PAT_ALL), MODE_ZEROING);
  return r;
}
__simd_callee__ inline vector_f8e4m3 bq_f32_to_e4m3(vector_f32 x) {
  vector_f8e4m3 r;
  vcvt(r, x, pset_b8(PAT_ALL), ROUND_R, RS_ENABLE, PART_P0, MODE_ZEROING);
  return r;
}

__simd_vf__ inline void vf_fp32_block_quant_tile(__ubuf__ uint8_t* buf_dyn_shmem,
                                                 int32_t w) {
  vector_f32 inverse[2];
  vector_f32 amax[2];
  vector_bool m_low = pset_b32(PAT_VL32);
  vector_bool m_high = bq_gt_s32(bq_lane_ids(), 31);
  vector_f32 eps = bq_dup_f32(float(0x1.a36e2eb1c432dp-14f));
  vector_f32 inv_fp8_max = bq_dup_f32(float(0x1.2492492492492p-9f));

  for (int32_t chunk = 0; chunk < 4; ++chunk) {
    amax[0] = bq_dup_f32(0.0f);
    amax[1] = bq_dup_f32(0.0f);
    for (int32_t row = 0; row < 32; ++row) {
      amax[0] = bq_max_f32(
          amax[0],
          bq_abs_f32(bq_load_f32(
              (__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[
                  ((((w & 1) * 16384) + (row * 512)) + (chunk * 128))])),
              0)));
      amax[1] = bq_max_f32(
          amax[1],
          bq_abs_f32(bq_load_f32(
              (__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[
                  (((((w & 1) * 16384) + (row * 512)) + (chunk * 128)) + 64)])),
              0)));
    }

    amax[0] = bq_max_f32(amax[0], eps);
    {
      vector_f32 a0 = bq_cmax(amax[0], m_low);
      vector_f32 a1 = bq_cmax(amax[0], m_high);
      vector_f32 amax_pair =
          bq_sel_f32(bq_bcast_lo(a0), bq_bcast_lo(a1), m_low);
      vector_f32 scale_raw = bq_mul_f32(amax_pair, inv_fp8_max);
      vector_u32 bits = (*(vector_u32*)(&(scale_raw)));
      vector_u32 exp =
          bq_adds_u32(bq_shrs_u32(bq_sub_u32(bits, bq_dup_u32(1)), 23), 1);
      vector_u32 scale_bits = bq_shls_u32(exp, 23);
      vector_u32 inv_bits =
          bq_shls_u32(bq_sub_u32(bq_dup_u32(254), exp), 23);
      inverse[0] = (*(vector_f32*)(&(inv_bits)));
      vector_f32 scale_f = (*(vector_f32*)(&(scale_bits)));
      bq_store_f32_onept(
          scale_f,
          (__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[
              ((((w & 1) * 16) + (chunk * 4)) + 32768)])));
      bq_store_f32_onept(
          bq_bcast_hi(scale_f),
          (__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[
              ((((w & 1) * 16) + (chunk * 4)) + 32769)])));
    }

    amax[1] = bq_max_f32(amax[1], eps);
    {
      vector_f32 a0 = bq_cmax(amax[1], m_low);
      vector_f32 a1 = bq_cmax(amax[1], m_high);
      vector_f32 amax_pair =
          bq_sel_f32(bq_bcast_lo(a0), bq_bcast_lo(a1), m_low);
      vector_f32 scale_raw = bq_mul_f32(amax_pair, inv_fp8_max);
      vector_u32 bits = (*(vector_u32*)(&(scale_raw)));
      vector_u32 exp =
          bq_adds_u32(bq_shrs_u32(bq_sub_u32(bits, bq_dup_u32(1)), 23), 1);
      vector_u32 scale_bits = bq_shls_u32(exp, 23);
      vector_u32 inv_bits =
          bq_shls_u32(bq_sub_u32(bq_dup_u32(254), exp), 23);
      inverse[1] = (*(vector_f32*)(&(inv_bits)));
      vector_f32 scale_f = (*(vector_f32*)(&(scale_bits)));
      bq_store_f32_onept(
          scale_f,
          (__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[
              ((((w & 1) * 16) + (chunk * 4)) + 32770)])));
      bq_store_f32_onept(
          bq_bcast_hi(scale_f),
          (__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[
              ((((w & 1) * 16) + (chunk * 4)) + 32771)])));
    }

    for (int32_t row = 0; row < 32; ++row) {
      vector_f32 x0 = bq_load_f32(
          (__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[
              ((((w & 1) * 16384) + (row * 512)) + (chunk * 128))])),
          0);
      vector_f32 x1 = bq_load_f32(
          (__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[
              (((((w & 1) * 16384) + (row * 512)) + (chunk * 128)) + 64)])),
          0);
      bq_store_e4m3(
          bq_f32_to_e4m3(bq_mul_f32(x0, inverse[0])),
          (__ubuf__ float8_e4m3_t*)(&(((__ubuf__ fp8_e4_t*)buf_dyn_shmem)[
              (((((w & 1) * 16384) + (row * 512)) + (chunk * 128)) +
               131200)])));
      bq_store_e4m3(
          bq_f32_to_e4m3(bq_mul_f32(x1, inverse[1])),
          (__ubuf__ float8_e4m3_t*)(&(((__ubuf__ fp8_e4_t*)buf_dyn_shmem)[
              (((((w & 1) * 16384) + (row * 512)) + (chunk * 128)) +
               131264)])));
    }
  }
}

extern "C" __global__ __vector__ void fp32_block_quant_kernel(
    __gm__ fp8_e4_t* out, __gm__ float* output_sf, __gm__ float* x,
    int32_t num_tokens, int32_t sf_stride) {

  AscendC::InitSocState();
  __ubuf__ uint8_t* buf_dyn_shmem = (__ubuf__ uint8_t*)0;
  int32_t sf_m_base = 0;
  int32_t stored_sf_k_base = 0;
  AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
  AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(1);
  AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(0);
  AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(1);
  AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(2);
  AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(3);
  for (int32_t w = 0; w < ((num_tokens + 575) / 576); ++w) {
    if (((w * 72) + ((int32_t)blockIdx.x)) < (((num_tokens + 31) >> 5) * 4)) {
      sf_m_base = ((w * 18) + (((int32_t)blockIdx.x) / 4));
      stored_sf_k_base = ((((int32_t)blockIdx.x) % 4) * 16);
    }
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(((w & 1) + 2));
    AscendC::PipeBarrier<pipe_t::PIPE_MTE3>();
    if (((w * 72) + ((int32_t)blockIdx.x)) < (((num_tokens + 31) >> 5) * 4)) {
      int32_t token_block = sf_m_base;
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>((w & 1));
      copy_gm_to_ubuf_align_v2(
          (__ubuf__ uint8_t*)((&(((__ubuf__ float*)buf_dyn_shmem)[((w & 1) *
                                                                  16384)]))),
          (__gm__ uint8_t*)((&(x[((((int64_t)token_block) * (int64_t)65536) +
                                  ((((int64_t)((int32_t)blockIdx.x)) %
                                    (int64_t)4) *
                                   (int64_t)512))]))),
          0, 32, 2048, 0, 0, 0, 0, 8192, 2048);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>((w & 1));
      AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>((w & 1));
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>((w & 1));
      vf_fp32_block_quant_tile(buf_dyn_shmem, w);
      AscendC::SetFlag<AscendC::HardEvent::V_MTE3>((w & 1));
      AscendC::SetFlag<AscendC::HardEvent::V_MTE2>((w & 1));
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>((w & 1));
      copy_ubuf_to_gm_align_v2(
          (__gm__ void*)((&(out[((((int64_t)token_block) * (int64_t)65536) +
                                 ((((int64_t)((int32_t)blockIdx.x)) %
                                   (int64_t)4) *
                                  (int64_t)512))]))),
          (__ubuf__ void*)((&(((__ubuf__ fp8_e4_t*)buf_dyn_shmem)[
              (((w & 1) * 16384) + 131200)]))),
          0, 32, 512, 4, 2048, 512);
      AscendC::SetFlag<AscendC::HardEvent::MTE3_V>((w & 1));
    }
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(((w & 1) + 2));
    AscendC::PipeBarrier<pipe_t::PIPE_MTE3>();
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(((w & 1) + 2));
    if (((w * 72) + ((int32_t)blockIdx.x)) < (((num_tokens + 31) >> 5) * 4)) {
      copy_ubuf_to_gm_align_v2(
          (__gm__ void*)((&(output_sf[((((int64_t)sf_m_base) *
                                        ((int64_t)sf_stride)) +
                                       ((int64_t)stored_sf_k_base))]))),
          (__ubuf__ void*)((&(((__ubuf__ float*)buf_dyn_shmem)[
              (((w & 1) * 16) + 32768)]))),
          0, 1, 64, 4, 64, 64);
    }
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(((w & 1) + 2));
  }
  AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);
  AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(1);
  AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
  AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(1);
  AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(2);
  AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(3);
}

#else  // host side of bisheng --shared

extern "C" __global__ __vector__ void fp32_block_quant_kernel(
    __gm__ fp8_e4_t* /*out*/, __gm__ float* /*output_sf*/, __gm__ float* /*x*/,
    int32_t /*num_tokens*/, int32_t /*sf_stride*/) {}

#endif  // __DAV_VEC__

