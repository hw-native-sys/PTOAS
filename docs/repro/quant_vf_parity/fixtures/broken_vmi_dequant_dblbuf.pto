// VMI scale-expand + strip mul (dequant hot path), 256-lane / G=8.
// Stays in bf16 (legal contiguous path). Full double-buffer device mismatch:
// RECORDED_DEVICE_NOTES.md + broken_vmi_dequant_dblbuf.ptodsl.py.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @dequant_strip_wide(
      %scale_g: !pto.vmi.vreg<8xbf16, #pto.vmi.layout<num_groups = 8, slots = 1>>,
      %data: !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous>> {
    %scale = pto.vmi.vbrc %scale_g {group = 8}
        : !pto.vmi.vreg<8xbf16, #pto.vmi.layout<num_groups = 8, slots = 1>>
        -> !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous>>
    %out = pto.vmi.vmul %data, %scale
        : !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous>>
    return %out : !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous>>
  }
}
