// AscendC reference: multiply a data strip by a scale strip (dequant-like).
// Compiles with bisheng --cce-aicore-only.

#include "kernel_operator.h"

__simd_vf__ inline void vf_dequant_strip(__ubuf__ float* data,
                                         __ubuf__ float* scale,
                                         __ubuf__ float* out) {
  vector_bool mall = pset_b32(PAT_ALL);
  vector_f32 x, s, y;
  vlds(x, data, 0, NORM);
  vlds(s, scale, 0, NORM);
  vmul(y, x, s, mall, MODE_ZEROING);
  vsts(y, out, 0, NORM_B32, mall);
}

extern "C" __global__ __vector__ void ref_dequant_dblbuf(
    __gm__ float* /*gm_in*/, __gm__ float* /*gm_out*/) {
  AscendC::InitSocState();
  __ubuf__ float* ub = (__ubuf__ float*)0;
  vf_dequant_strip(ub, ub + 128, ub + 256);
}
