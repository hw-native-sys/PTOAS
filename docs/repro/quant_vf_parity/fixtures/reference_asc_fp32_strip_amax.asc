// AscendC: FP32 strip abs-amax into local scales (dense MicroAPI path).
// Compiles with bisheng --cce-aicore-only.

#include "kernel_operator.h"

__simd_vf__ inline void vf_fp32_strip_amax(__ubuf__ float* data,
                                           __ubuf__ float* scale_out) {
  vector_bool mall = pset_b32(PAT_ALL);
  vector_f32 x0, x1, abs0, abs1, amax;
  vdup(amax, 0.0f, mall, MODE_ZEROING);
  vlds(x0, data, 0, NORM);
  vlds(x1, data, 64, NORM);
  vabs(abs0, x0, mall, MODE_ZEROING);
  vabs(abs1, x1, mall, MODE_ZEROING);
  vmax(amax, amax, abs0, mall, MODE_ZEROING);
  vmax(amax, amax, abs1, mall, MODE_ZEROING);
  vsts(amax, scale_out, 0, NORM_B32, mall);
}

extern "C" __global__ __vector__ void ref_fp32_strip_amax(
    __gm__ float* /*gm_in*/, __gm__ float* /*gm_out*/) {
  AscendC::InitSocState();
  __ubuf__ float* ub = (__ubuf__ float*)0;
  vf_fp32_strip_amax(ub, ub + 128);
}
