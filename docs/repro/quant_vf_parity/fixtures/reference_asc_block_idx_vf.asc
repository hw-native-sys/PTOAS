// AscendC baseline: block index used in a bound check around a UB touch.
// Compiles with bisheng --cce-aicore-only.

#include "kernel_operator.h"

extern "C" __global__ __vector__ void ref_block_idx_vf(
    __gm__ float* /*gm_in*/, __gm__ float* /*gm_out*/) {
  AscendC::InitSocState();
  for (int w = 0; w < 6; ++w) {
    int64_t bid = AscendC::GetBlockIdx();
    int64_t q = bid / 8;
    if (q < 43) {
      __ubuf__ float* ub = (__ubuf__ float*)0;
      ub[w & 3] = (float)q;
    }
  }
}
