// AscendC reference: bf16 abs-amax via vand(0x7FFF) + vmax; no f32 widen of the strip.

#include "kernel_operator.h"

__simd_vf__ inline void vf_bf16_abs_amax(__ubuf__ bfloat16_t* data,
                                         __ubuf__ bfloat16_t* out) {
  vector_bool mall = pset_b16(PAT_ALL);
  vector_u16 abs_mask;
  vdup(abs_mask, (uint16_t)0x7FFF, mall, MODE_ZEROING);
  vector_bf16 x, abs_x, amax;
  vdup(amax, (bfloat16_t)0.0f, mall, MODE_ZEROING);
  vlds(x, data, 0, NORM);
  vand(abs_x, x, (*(vector_bf16 *)(&abs_mask)), mall, MODE_ZEROING);
  vmax(amax, amax, abs_x, mall, MODE_ZEROING);
  vsts(amax, out, 0, NORM_B16, mall);
}

extern "C" __global__ __vector__ void ref_bf16_abs_amax(
    __gm__ bfloat16_t* /*gm_in*/, __gm__ bfloat16_t* /*gm_out*/) {
  AscendC::InitSocState();
  __ubuf__ bfloat16_t* ub = (__ubuf__ bfloat16_t*)0;
  vf_bf16_abs_amax(ub, ub + 128);
}
