// Desired: vabs(bf16) legalizes via bitcast+andi 0x7FFF (ASC vand abs-mask).

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @desired_vabs_bf16(
      %src: !pto.vmi.vreg<128xbf16>)
      -> !pto.vmi.vreg<128xbf16> {
    %out = pto.vmi.vabs %src
        : !pto.vmi.vreg<128xbf16> -> !pto.vmi.vreg<128xbf16>
    return %out : !pto.vmi.vreg<128xbf16>
  }
}
