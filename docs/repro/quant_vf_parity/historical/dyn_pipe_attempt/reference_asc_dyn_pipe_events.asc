// AscendC baseline: multi-buffer pipe waits with a loop-derived event index.
// Compiles with bisheng --cce-aicore-only.

#include "kernel_operator.h"

extern "C" __global__ __vector__ void ref_dyn_pipe_events(
    __gm__ float* /*gm_in*/, __gm__ float* /*gm_out*/) {
  AscendC::InitSocState();
  // Three static event slots (0..2), selected by iteration index.
  AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
  AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(1);
  AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(2);
  for (int w = 0; w < 6; ++w) {
    int eid = w % 3;
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(eid);
    // Touch UB so the waits are not DCE'd away in a trivial empty body.
    __ubuf__ float* ub = (__ubuf__ float*)0;
    ub[eid] = (float)w;
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(eid);
  }
  AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
  AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(1);
  AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(2);
}
