    vector_bool v = pset_b32(PAT_ALL);
    auto clamped = simd_inst::vmaxs(amax, float(0x1.a36e2eb1c432dp-14f/*1.000000e-04*/), v, MODE_ZEROING);
    vector_f32 v_ = simd_inst::vmuls(clamped, float(0x1.2492492492492p-9f/*2.232143e-03*/), v, MODE_ZEROING);
    auto bits = (*(vector_u32 *)(&(v_)));
    auto scale = simd_inst::vadds(simd_inst::vshrs(simd_inst::vsub(bits, simd_inst::vdup<uint32_t>(1, v, MODE_ZEROING), v, MODE_ZEROING), 23, v, MODE_ZEROING), 1, v, MODE_ZEROING);
    vector_u32 v__1 = simd_inst::vshls(simd_inst::vsub(simd_inst::vdup<uint32_t>(254, v, MODE_ZEROING), scale, v, MODE_ZEROING), 23, v, MODE_ZEROING);
    auto inverse = (*(vector_f32 *)(&(v__1)));
