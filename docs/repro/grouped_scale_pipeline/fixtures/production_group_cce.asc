__simd_vf__ inline void packed_group_convert_simd_vf_0(__ubuf__ uint8_t* buf_dyn_shmem, int32_t w) {
  vector_bool mask_vl8 = pset_b32(PAT_VL8);
  vector_bool v = pset_b16(PAT_ALL);
  auto abs_mask = simd_inst::vdup<uint16_t>(32767, v, MODE_ZEROING);
  auto zero = simd_inst::vdup<bfloat16_t>(float(0x0p+0f/*0.000000e+00*/), v, MODE_ZEROING);
  for (int32_t row = 0; row < 32; ++row) {
    for (int32_t tile = 0; tile < 4; ++tile) {
      auto v_1 = simd_inst::vld_x2<bfloat16_t>((__ubuf__ bfloat16_t*)(&(((__ubuf__ bfloat16_t*)buf_dyn_shmem)[((((w & 1) * 32768) + (row * 1024)) + (tile * 256))])), DINTLV_B16);
      vector_bf16 v_ = v_1.v0;
      auto abs_x0 = simd_inst::vand((*(vector_u16 *)(&(v_))), abs_mask, v, MODE_ZEROING);
      vector_bf16 v__1 = v_1.v1;
      auto abs_x1 = simd_inst::vand((*(vector_u16 *)(&(v__1))), abs_mask, v, MODE_ZEROING);
      auto maxima = simd_inst::vcgmax(simd_inst::vmax(abs_x0, abs_x1, v, MODE_ZEROING), v, MODE_ZEROING);
      auto v_2 = simd_inst::vintlv(zero, (*(vector_bf16 *)(&(maxima))));
      vector_bf16 v__2 = v_2.v0;
      simd_inst::vsts((*(vector_f32 *)(&(v__2))), (__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[(((((w & 1) * 2048) + (row * 64)) + (tile * 8)) + 49664)])), 0, NORM_B32, mask_vl8);
    }
  }
}

__simd_vf__ inline void packed_group_convert_simd_vf_1(__ubuf__ uint8_t* buf_dyn_shmem, int32_t w) {
  for (int32_t row = 0; row < 32; ++row) {
