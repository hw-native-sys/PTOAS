module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @grouped_scale_body(
      %src: !pto.ptr<bf16, ub>,
      %dst: !pto.ptr<f8E4M3FN, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %c256 = arith.constant 256 : index
    %mask = pto.vmi.create_mask %c256 : index -> !pto.vmi.mask<256xpred>
    %x = pto.vmi.vload %src[%c0]
        : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<256xbf16>
    %xf = pto.vmi.vcvt %x
        : !pto.vmi.vreg<256xbf16> -> !pto.vmi.vreg<256xf32>
    %amax = pto.vmi.vcmax %xf, %mask {group = 8}
        : !pto.vmi.vreg<256xf32>, !pto.vmi.mask<256xpred>
        -> !pto.vmi.vreg<8xf32>
    %scale8 = pto.vmi.vcvt %amax {rounding = "R", saturate = "NOSAT"}
        : !pto.vmi.vreg<8xf32> -> !pto.vmi.vreg<8xbf16>
    %scale = pto.vmi.vbrc %scale8 {group = 8}
        : !pto.vmi.vreg<8xbf16> -> !pto.vmi.vreg<256xbf16>
    %scaled = pto.vmi.vmul %x, %scale, %mask
        : !pto.vmi.vreg<256xbf16>, !pto.vmi.vreg<256xbf16>,
          !pto.vmi.mask<256xpred> -> !pto.vmi.vreg<256xbf16>
    %scaledf = pto.vmi.vcvt %scaled
        : !pto.vmi.vreg<256xbf16> -> !pto.vmi.vreg<256xf32>
    %q = pto.vmi.vcvt %scaledf {rounding = "R", saturate = "SAT"}
        : !pto.vmi.vreg<256xf32> -> !pto.vmi.vreg<256xf8E4M3FN>
    pto.vmi.vstore %q, %dst[%c0]
        : !pto.vmi.vreg<256xf8E4M3FN>, !pto.ptr<f8E4M3FN, ub>
    return
  }
}
