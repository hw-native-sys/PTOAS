  }
}

__simd_vf__ inline void full_roundtrip_cce_vf_1(__ubuf__ uint8_t* buf_dyn_shmem, int32_t w) {
  vector_bool v = pset_b32(PAT_ALL);
  auto quant_max = simd_inst::vdup<float>(448.0f, v, MODE_ZEROING);
  for (int32_t sf_batch = 0; sf_batch < 9; ++sf_batch) {
    auto amax = simd_inst::vlds<float>((__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[(((((w + 1) % 3) * 576) + (sf_batch * 64)) + 27648)])), 0, NORM);
    auto clamped_amax = simd_inst::vmaxs(amax, float(0x1.a36e2eb1c432dp-14f/*1.000000e-04*/), v, MODE_ZEROING);
    auto sf = simd_inst::vdiv_precise(clamped_amax, quant_max, v, MODE_ZEROING);
    auto sf_inv = simd_inst::vdiv_precise(quant_max, clamped_amax, v, MODE_ZEROING);
    simd_inst::vsts(sf, (__ubuf__ float*)buf_dyn_shmem + ((w + 1) % 3) * 576 + sf_batch * 64 + 29376, 0, NORM_B32, v);
    simd_inst::vsts(sf_inv, (__ubuf__ float*)buf_dyn_shmem + ((w + 1) % 3) * 576 + sf_batch * 64 + 31104, 0, NORM_B32, v);
