      auto cast_back1 = simd_inst::vcvt<float>(quantized1, v_3, PART_P0, MODE_ZEROING);
      auto rescaled0 = simd_inst::vmul(cast_back0, sf.v0, v_1, MODE_ZEROING);
      auto rescaled1 = simd_inst::vmul(cast_back1, sf.v0, v_1, MODE_ZEROING);
