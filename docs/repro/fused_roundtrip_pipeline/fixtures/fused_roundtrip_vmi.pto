module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @fused_roundtrip_body(
      %src: !pto.ptr<bf16, ub>,
      %dst: !pto.ptr<bf16, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c256 = arith.constant 256 : index
    %mask = pto.vmi.create_mask %c256 : index -> !pto.vmi.mask<256xpred>
    %x = pto.vmi.vload %src[%c0]
        : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<256xbf16>
    %xf = pto.vmi.vcvt %x
        : !pto.vmi.vreg<256xbf16> -> !pto.vmi.vreg<256xf32>
    %amax = pto.vmi.vcmax %xf, %mask {group = 8}
        : !pto.vmi.vreg<256xf32>, !pto.vmi.mask<256xpred>
        -> !pto.vmi.vreg<8xf32>
    %inv = pto.vmi.vbrc %amax {group = 8}
        : !pto.vmi.vreg<8xf32> -> !pto.vmi.vreg<256xf32>
    %scaled = pto.vmi.vmul %xf, %inv, %mask
        : !pto.vmi.vreg<256xf32>, !pto.vmi.vreg<256xf32>,
          !pto.vmi.mask<256xpred> -> !pto.vmi.vreg<256xf32>
    %q = pto.vmi.vcvt %scaled {rounding = "R", saturate = "SAT"}
        : !pto.vmi.vreg<256xf32> -> !pto.vmi.vreg<256xf8E4M3FN>
    %qf = pto.vmi.vcvt %q
        : !pto.vmi.vreg<256xf8E4M3FN> -> !pto.vmi.vreg<256xf32>
    %scale = pto.vmi.vbrc %amax {group = 8}
        : !pto.vmi.vreg<8xf32> -> !pto.vmi.vreg<256xf32>
    %outf = pto.vmi.vmul %qf, %scale, %mask
        : !pto.vmi.vreg<256xf32>, !pto.vmi.vreg<256xf32>,
          !pto.vmi.mask<256xpred> -> !pto.vmi.vreg<256xf32>
    %out = pto.vmi.vcvt %outf {saturate = "SAT"}
        : !pto.vmi.vreg<256xf32> -> !pto.vmi.vreg<256xbf16>
    pto.vmi.vstore %out, %dst[%c0]
        : !pto.vmi.vreg<256xbf16>, !pto.ptr<bf16, ub>
    return
  }
}
