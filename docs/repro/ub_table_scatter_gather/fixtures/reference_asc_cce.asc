// AscendC peer of the UB-resident scatter/gather table.
// Same three phases: seed -inf, scatter values, gather back.
// Compiles with bisheng --cce-aicore-only (see README).

#include "kernel_operator.h"
#include <math.h>

namespace {
constexpr int VL = 64;
constexpr int POOL = 256;
}

__simd_vf__ inline void vf_ub_table(__ubuf__ float* pool,
                                    __ubuf__ float* val,
                                    __ubuf__ float* out) {
  vector_bool mall = pset_b32(PAT_ALL);
  vector_f32 neg_inf, v, got;
  vector_s32 idx;

  vci(idx, 0, INC_ORDER);
  vdup(neg_inf, (float)(-INFINITY), mall, MODE_ZEROING);

  // Phase 1: seed
  vscatter(neg_inf, pool, *(vector_u32*)(&idx), mall);
  mem_bar(VST_VST);

  // Phase 2: write values
  vlds(v, val, 0, NORM);
  vscatter(v, pool, *(vector_u32*)(&idx), mall);
  mem_bar(VST_VLD);

  // Phase 3: read back
  vgather2(got, pool, *(vector_u32*)(&idx), mall);
  vsts(got, out, 0, NORM_B32, mall);
}

extern "C" __global__ __vector__ void ref_ub_table_scatter_gather(
    __gm__ float* /*gm_val*/, __gm__ float* /*gm_out*/) {
  AscendC::InitSocState();
  __ubuf__ float* ub = (__ubuf__ float*)0;
  __ubuf__ float* pool = ub;
  __ubuf__ float* val = ub + POOL;
  __ubuf__ float* out = val + VL;
  vf_ub_table(pool, val, out);
}
