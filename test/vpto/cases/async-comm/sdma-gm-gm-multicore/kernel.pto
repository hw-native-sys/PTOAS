// -----------------------------------------------------------------------------
// case: async-comm/sdma-gm-gm-multicore
// target_ops: pto.sdma_gm_gm, pto.session_init
// scenarios: single-device, local GM->GM, one channel group per core
// -----------------------------------------------------------------------------
//
// Every core posts its own slice through its own channel group, which is the
// arrangement the channel index exists for: two cores sharing a group would
// interleave writes into one queue ring and corrupt each other's entries.
//
// The core id picks both the slice and the group, so the two stay aligned
// without the host having to describe the mapping. Everything else in the
// session comes from the host's template, which is why only one field is
// written here.

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @sdma_gm_gm_multicore(%dst: !pto.ptr<i8, gm>,
                                  %src: !pto.ptr<i8, gm>,
                                  %sess_gm: !pto.ptr<i8, gm>,
                                  %chunk: i64) attributes {pto.kernel} {
    %bid = pto.get_block_idx
    %bid32 = arith.trunci %bid : i64 to i32

    // Slice base for this core. Both sides move by the same amount, so the
    // destination mirrors the source.
    %off = arith.muli %bid, %chunk : i64
    %src_i64 = pto.castptr %src : !pto.ptr<i8, gm> -> i64
    %dst_i64 = pto.castptr %dst : !pto.ptr<i8, gm> -> i64
    %my_src_i64 = arith.addi %src_i64, %off : i64
    %my_dst_i64 = arith.addi %dst_i64, %off : i64
    %my_src = pto.castptr %my_src_i64 : i64 -> !pto.ptr<i8, gm>
    %my_dst = pto.castptr %my_dst_i64 : i64 -> !pto.ptr<i8, gm>

    %sess = pto.declare_struct -> !pto.struct<i64, i64, i32, i32, i32, i32, i64, i64, i32, i32, i32, i32, i32>

    pto.session_init %sess, %sess_gm
      : !pto.struct<i64, i64, i32, i32, i32, i32, i64, i64, i32, i32, i32, i32, i32>,
        !pto.ptr<i8, gm>

    // The template cannot name the core, so the one field that differs per core
    // is written after the copy. Everything else stays as the host set it.
    pto.struct_set %sess[4], %bid32 : !pto.struct<i64, i64, i32, i32, i32, i32, i64, i64, i32, i32, i32, i32, i32>, i32

    pto.sdma_gm_gm %my_dst, %my_src, %chunk session(%sess)
      : !pto.ptr<i8, gm>, !pto.ptr<i8, gm>, i64,
        !pto.struct<i64, i64, i32, i32, i32, i32, i64, i64, i32, i32, i32, i32, i32>

    return
  }
}
