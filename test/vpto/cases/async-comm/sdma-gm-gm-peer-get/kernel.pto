// -----------------------------------------------------------------------------
// case: async-comm/sdma-gm-gm-peer-get
// target_ops: pto.sdma_gm_gm, pto.session_init
// scenarios: two-device, peer GM->local GM, one channel, block splitting
// -----------------------------------------------------------------------------
//
// Rank 0 reads rank 1's window. There is no `{soft_put}`: A5's engine will
// GET from a peer, so this kick posts SQEs the same way a local copy does.
// The peer-put counterpart needs the attr because that generation cannot write
// remotely through the engine.
//
// The session comes from a template the host wrote, which is also where the
// workspace address lives, so the kernel names neither.

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @sdma_gm_gm_peer_get(%dst: !pto.ptr<i8, gm>,
                                 %src: !pto.ptr<i8, gm>,
                                 %sess_gm: !pto.ptr<i8, gm>,
                                 %nbytes: i64) attributes {pto.kernel} {
    %sess = pto.declare_struct
      -> !pto.struct<i64, i64, i32, i32, i32, i32, i64, i64, i32, i32, i32, i32, i32>

    pto.session_init %sess, %sess_gm
      : !pto.struct<i64, i64, i32, i32, i32, i32, i64, i64, i32, i32, i32, i32, i32>,
        !pto.ptr<i8, gm>

    pto.sdma_gm_gm %dst, %src, %nbytes session(%sess)
      : !pto.ptr<i8, gm>, !pto.ptr<i8, gm>, i64,
        !pto.struct<i64, i64, i32, i32, i32, i32, i64, i64, i32, i32, i32, i32, i32>

    return
  }
}
