// -----------------------------------------------------------------------------
// case: async-comm/sdma-gm-gm-local
// target_ops: pto.sdma_gm_gm, pto.session_init
// scenarios: single-device, local GM->GM, one channel, block splitting
// -----------------------------------------------------------------------------
//
// One core copies between two local GM buffers. The host polls the destination,
// because returning from the kernel does not mean the engine has drained.
//
// Every session value comes from the template the host wrote, including the
// block size, so the kernel says nothing about how the transfer is split. That
// is what lets the host sweep splits without rebuilding this.

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @sdma_gm_gm_local(%dst: !pto.ptr<i8, gm>,
                              %src: !pto.ptr<i8, gm>,
                              %sess_gm: !pto.ptr<i8, gm>,
                              %nbytes: i64) attributes {pto.kernel} {
    %sess = pto.declare_struct
      -> !pto.struct<i64, i64, i32, i32, i32, i32, i64, i64, i32, i32, i32, i32, i32>

    pto.session_init %sess, %sess_gm
      : !pto.struct<i64, i64, i32, i32, i32, i32, i64, i64, i32, i32, i32, i32, i32>,
        !pto.ptr<i8, gm>

    pto.sdma_gm_gm %dst, %src, %nbytes session(%sess)
      : !pto.ptr<i8, gm>, !pto.ptr<i8, gm>, i64,
        !pto.struct<i64, i64, i32, i32, i32, i32, i64, i64, i32, i32, i32, i32, i32>

    return
  }
}
