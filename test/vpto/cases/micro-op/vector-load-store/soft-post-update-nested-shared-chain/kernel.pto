// case: micro-op/vector-load-store/soft-post-update-nested-shared-chain
// target_ops: pto.vlds, pto.vsts, pto.psts
// scenarios: shared-load-store-chain, address-unit-isolation, nested-loops

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @soft_post_update_nested_shared_chain_kernel(
      %input: !pto.ptr<ui8, gm>, %output: !pto.ptr<ui8, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c64 = arith.constant 64 : index
    %c128 = arith.constant 128 : index
    %c512 = arith.constant 512 : index
    %c0_i64 = arith.constant 0 : i64
    %c32_i64 = arith.constant 32 : i64
    %c128_i64 = arith.constant 128 : i64

    %ub_raw = pto.castptr %c0_i64 : i64 -> !pto.ptr<ui8, ub>
    %ub = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    pto.mte_gm_ub %input, %ub_raw, %c0_i64, %c128_i64
      nburst(%c32_i64, %c128_i64, %c128_i64)
      : !pto.ptr<ui8, gm>, !pto.ptr<ui8, ub>, i64, i64, i64, i64, i64

    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %predicate = pto.pset_b8 "PAT_ALL" : !pto.mask<b8>
      scf.for %outer = %c0 to %c128 step %c64 {
        %value = pto.vlds %ub[%outer]
            : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
        pto.vsts %value, %ub[%outer], %mask
            : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
        pto.psts %predicate, %ub[%outer], "NORM"
            : !pto.mask<b8>, !pto.ptr<f32, ub>, index

        scf.for %inner = %c0 to %c128 step %c64 {
          %inner_offset = arith.addi %inner, %c512 : index
          %inner_value = pto.vlds %ub[%inner_offset]
              : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
          pto.vsts %inner_value, %ub[%inner_offset], %mask
              : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
        }
      }
    }

    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_raw, %output, %c128_i64
      nburst(%c32_i64, %c128_i64, %c128_i64)
      : !pto.ptr<ui8, ub>, !pto.ptr<ui8, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
