// case: micro-op/vector-load-store/soft-post-update-normalized-recurrence-types
// target_ops: pto.vlds, pto.vsts, pto.sprsts, pto.vstas, pto.vsldb, pto.vsstb
// scenarios: signed-i16, signed-i32, unsigned-i16, missing-op-runtime-coverage

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @soft_post_update_normalized_recurrence_types_kernel(
      %input: !pto.ptr<ui8, gm>, %output: !pto.ptr<ui8, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c256 = arith.constant 256 : index
    %c2048 = arith.constant 2048 : index
    %c0_i16 = arith.constant 0 : i16
    %c1_i16 = arith.constant 1 : i16
    %c256_i16 = arith.constant 256 : i16
    %c0_i32 = arith.constant 0 : i32
    %c32_i32 = arith.constant 32 : i32
    %c64_i32 = arith.constant 64 : i32
    %c0_i64 = arith.constant 0 : i64
    %c32_i64 = arith.constant 32 : i64
    %c128_i64 = arith.constant 128 : i64
    %c1024_i64 = arith.constant 1024 : i64
    %c2048_i64 = arith.constant 2048 : i64
    %c131072_i64 = arith.constant 131072 : i64
    %c132096_i64 = arith.constant 132096 : i64

    %ub_input = pto.castptr %c0_i64 : i64 -> !pto.ptr<ui8, ub>
    %ub_output = pto.castptr %c131072_i64 : i64 -> !pto.ptr<ui8, ub>
    %spr_output_u32 = pto.castptr %c132096_i64 : i64 -> !pto.ptr<ui32, ub>
    %block_input = pto.addptr %ub_input, %c2048
        : !pto.ptr<ui8, ub> -> !pto.ptr<ui8, ub>
    %block_output = pto.addptr %ub_output, %c2048
        : !pto.ptr<ui8, ub> -> !pto.ptr<ui8, ub>

    pto.mte_gm_ub %input, %ub_input, %c0_i64, %c128_i64
      nburst(%c32_i64, %c128_i64, %c128_i64)
      : !pto.ptr<ui8, gm>, !pto.ptr<ui8, ub>, i64, i64, i64, i64, i64
    pto.mte_gm_ub %output, %ub_output, %c0_i64, %c128_i64
      nburst(%c32_i64, %c128_i64, %c128_i64)
      : !pto.ptr<ui8, gm>, !pto.ptr<ui8, ub>, i64, i64, i64, i64, i64

    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.vecscope {
      %mask = pto.pset_b8 "PAT_ALL" : !pto.mask<b8>

      scf.for %iv = %c0 to %c2 step %c1
          iter_args(%offset = %c0_i16) -> i16 {
        %offset_index = arith.index_cast %offset : i16 to index
        %value = pto.vlds %ub_input[%offset_index]
            : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
        %dst = arith.muli %iv, %c256 : index
        pto.vsts %value, %ub_output[%dst], %mask
            : !pto.vreg<256xui8>, !pto.ptr<ui8, ub>, !pto.mask<b8>
        %next = arith.addi %offset, %c256_i16 : i16
        scf.yield %next : i16
      }

      scf.for %iv = %c0 to %c2 step %c1
          iter_args(%offset = %c0_i32) -> i32 {
        pto.sprclr "AR"
        pto.sprsts "AR", %spr_output_u32[%offset]
            : !pto.ptr<ui32, ub>, i32
        %align = pto.init_align : !pto.align
        pto.vstas %align, %ub_output, %offset
            : !pto.align, !pto.ptr<ui8, ub>, i32
        %next = arith.addi %offset, %c32_i32 : i32
        scf.yield %next : i32
      }

      scf.for %iv = %c0 to %c2 step %c1
          iter_args(%repeat = %c0_i16) -> i16 {
        %value = pto.vsldb %block_input, %c1_i16, %repeat, %mask
            : !pto.ptr<ui8, ub>, i16, i16, !pto.mask<b8>
                -> !pto.vreg<256xui8>
        pto.vsstb %value, %block_output, %c1_i16, %repeat, %mask
            : !pto.vreg<256xui8>, !pto.ptr<ui8, ub>, i16, i16,
              !pto.mask<b8>
        %next = arith.addi %repeat, %c1_i16 : i16
        scf.yield %next : i16
      }
    }

    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_output, %output, %c128_i64
      nburst(%c32_i64, %c128_i64, %c128_i64)
      : !pto.ptr<ui8, ub>, !pto.ptr<ui8, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
