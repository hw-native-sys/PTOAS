// Non-round-trip numeric coverage for pto.vmi.vunzip on 32 -> 16.
//
// This case stores the low and high halves separately and compares each with
// the halves python extracts from the input words.  A round trip alone is
// symmetric, so it would also pass for a consistently wrong split (for example
// two copies of the same half); the separate halves pin down the semantics.
//
// RUN: ptoas --pto-arch a5 --pto-backend=vpto --emit-vpto %s -o /dev/null

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vmi_vunzip_f32_split_halves_kernel(
      %src_gm: !pto.ptr<f32, gm>, %low_gm: !pto.ptr<ui16, gm>,
      %high_gm: !pto.ptr<ui16, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c512_i64 = arith.constant 512 : i64
    %c1024_i64 = arith.constant 1024 : i64
    %c4096_i64 = arith.constant 4096 : i64
    %c4608_i64 = arith.constant 4608 : i64
    %ub_src = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %ub_low = pto.castptr %c4096_i64 : i64 -> !pto.ptr<ui16, ub>
    %ub_high = pto.castptr %c4608_i64 : i64 -> !pto.ptr<ui16, ub>
    pto.mte_gm_ub %src_gm, %ub_src, %c0_i64, %c1024_i64
      nburst(%c1_i64, %c1024_i64, %c1024_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64
    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.vecscope {
      %x = pto.vmi.vload %ub_src[%c0]
          : !pto.ptr<f32, ub> -> !pto.vmi.vreg<256xf32>
      %low, %high = pto.vmi.vunzip %x
          : !pto.vmi.vreg<256xf32> -> !pto.vmi.vreg<256xui16>, !pto.vmi.vreg<256xui16>
      pto.vmi.vstore %low, %ub_low[%c0]
          : !pto.vmi.vreg<256xui16>, !pto.ptr<ui16, ub>
      pto.vmi.vstore %high, %ub_high[%c0]
          : !pto.vmi.vreg<256xui16>, !pto.ptr<ui16, ub>
    }
    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_low, %low_gm, %c512_i64
      nburst(%c1_i64, %c512_i64, %c512_i64)
      : !pto.ptr<ui16, ub>, !pto.ptr<ui16, gm>, i64, i64, i64, i64
    pto.mte_ub_gm %ub_high, %high_gm, %c512_i64
      nburst(%c1_i64, %c512_i64, %c512_i64)
      : !pto.ptr<ui16, ub>, !pto.ptr<ui16, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
