// Bit-exact numeric coverage for pto.vmi.vunzip / pto.vmi.vzip on 32 -> 16.
//
// Each function loads f32, splits every element into its low and high ui16
// halves, zips them back, and stores the result.  Because vunzip/vzip are a bit
// split and its exact inverse, the output must equal the input bit for bit
// under every layout the op supports.  The layouts are pinned on the vunzip
// operand through the surrounding ops:
//
//   contiguous          a plain 256-lane load/store fixes lane_stride = 1
//   deinterleaved = 2   channel_split of the operand requests factor 2
//   deinterleaved = 4   channel_split of the operand requests factor 4
//
// The lane_stride = 2 layout has its own case (f32-lane-stride-2) because its
// half-full carrier needs a different host interface.  The channel_split
// results are written to a UB scratch area (never copied to GM) so the layout
// anchor stays live; the checked result is always the zip of the split, so a
// split that is not the identity inverse makes the case fail.
//
// RUN: ptoas --pto-arch a5 --pto-backend=vpto --emit-vpto %s -o /dev/null

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vmi_vunzip_vzip_f32_contiguous_kernel(%src_gm: !pto.ptr<f32, gm>, %dst_gm: !pto.ptr<f32, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c1024_i64 = arith.constant 1024 : i64
    %c4096_i64 = arith.constant 4096 : i64
    %ub_src = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %ub_dst = pto.castptr %c4096_i64 : i64 -> !pto.ptr<f32, ub>
    pto.mte_gm_ub %src_gm, %ub_src, %c0_i64, %c1024_i64
      nburst(%c1_i64, %c1024_i64, %c1024_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64
    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.vecscope {
      %x = pto.vmi.vload %ub_src[%c0]
          : !pto.ptr<f32, ub> -> !pto.vmi.vreg<256xf32>
      %low, %high = pto.vmi.vunzip %x
          : !pto.vmi.vreg<256xf32> -> !pto.vmi.vreg<256xui16>, !pto.vmi.vreg<256xui16>
      %y = pto.vmi.vzip %low, %high
          : !pto.vmi.vreg<256xui16>, !pto.vmi.vreg<256xui16> -> !pto.vmi.vreg<256xf32>
      pto.vmi.vstore %y, %ub_dst[%c0]
          : !pto.vmi.vreg<256xf32>, !pto.ptr<f32, ub>
    }
    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_dst, %dst_gm, %c1024_i64
      nburst(%c1_i64, %c1024_i64, %c1024_i64)
      : !pto.ptr<f32, ub>, !pto.ptr<f32, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }

  func.func @vmi_vunzip_vzip_f32_deinterleaved_2_kernel(%src_gm: !pto.ptr<f32, gm>, %dst_gm: !pto.ptr<f32, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c1024_i64 = arith.constant 1024 : i64
    %c4096_i64 = arith.constant 4096 : i64
    %ub_src = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %ub_dst = pto.castptr %c4096_i64 : i64 -> !pto.ptr<f32, ub>
    pto.mte_gm_ub %src_gm, %ub_src, %c0_i64, %c1024_i64
      nburst(%c1_i64, %c1024_i64, %c1024_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64
    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.vecscope {
      %c128 = arith.constant 128 : index
      %c8192_i64 = arith.constant 8192 : i64
      %ub_scratch = pto.castptr %c8192_i64 : i64 -> !pto.ptr<f32, ub>
      %x = pto.vmi.vload %ub_src[%c0]
          : !pto.ptr<f32, ub> -> !pto.vmi.vreg<256xf32>
      %ca, %cb = "pto.vmi.channel_split"(%x)
          : (!pto.vmi.vreg<256xf32>) -> (!pto.vmi.vreg<128xf32>, !pto.vmi.vreg<128xf32>)
      pto.vmi.vstore %ca, %ub_scratch[%c0]
          : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
      pto.vmi.vstore %cb, %ub_scratch[%c128]
          : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
      %low, %high = pto.vmi.vunzip %x
          : !pto.vmi.vreg<256xf32> -> !pto.vmi.vreg<256xui16>, !pto.vmi.vreg<256xui16>
      %y = pto.vmi.vzip %low, %high
          : !pto.vmi.vreg<256xui16>, !pto.vmi.vreg<256xui16> -> !pto.vmi.vreg<256xf32>
      pto.vmi.vstore %y, %ub_dst[%c0]
          : !pto.vmi.vreg<256xf32>, !pto.ptr<f32, ub>
    }
    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_dst, %dst_gm, %c1024_i64
      nburst(%c1_i64, %c1024_i64, %c1024_i64)
      : !pto.ptr<f32, ub>, !pto.ptr<f32, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }

  func.func @vmi_vunzip_vzip_f32_deinterleaved_4_kernel(%src_gm: !pto.ptr<f32, gm>, %dst_gm: !pto.ptr<f32, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c1024_i64 = arith.constant 1024 : i64
    %c4096_i64 = arith.constant 4096 : i64
    %ub_src = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %ub_dst = pto.castptr %c4096_i64 : i64 -> !pto.ptr<f32, ub>
    pto.mte_gm_ub %src_gm, %ub_src, %c0_i64, %c1024_i64
      nburst(%c1_i64, %c1024_i64, %c1024_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64
    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.vecscope {
      %c64 = arith.constant 64 : index
      %c128 = arith.constant 128 : index
      %c192 = arith.constant 192 : index
      %c8192_i64 = arith.constant 8192 : i64
      %ub_scratch = pto.castptr %c8192_i64 : i64 -> !pto.ptr<f32, ub>
      %x = pto.vmi.vload %ub_src[%c0]
          : !pto.ptr<f32, ub> -> !pto.vmi.vreg<256xf32>
      %ca, %cb, %cc, %cd = "pto.vmi.channel_split"(%x)
          : (!pto.vmi.vreg<256xf32>) -> (!pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>)
      pto.vmi.vstore %ca, %ub_scratch[%c0]
          : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>
      pto.vmi.vstore %cb, %ub_scratch[%c64]
          : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>
      pto.vmi.vstore %cc, %ub_scratch[%c128]
          : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>
      pto.vmi.vstore %cd, %ub_scratch[%c192]
          : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>
      %low, %high = pto.vmi.vunzip %x
          : !pto.vmi.vreg<256xf32> -> !pto.vmi.vreg<256xui16>, !pto.vmi.vreg<256xui16>
      %y = pto.vmi.vzip %low, %high
          : !pto.vmi.vreg<256xui16>, !pto.vmi.vreg<256xui16> -> !pto.vmi.vreg<256xf32>
      pto.vmi.vstore %y, %ub_dst[%c0]
          : !pto.vmi.vreg<256xf32>, !pto.ptr<f32, ub>
    }
    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_dst, %dst_gm, %c1024_i64
      nburst(%c1_i64, %c1024_i64, %c1024_i64)
      : !pto.ptr<f32, ub>, !pto.ptr<f32, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
