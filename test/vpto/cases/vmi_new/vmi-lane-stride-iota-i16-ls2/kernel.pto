// Regression for #1411 – integer lane-strided iota must use logical right shift.
//
// VL=64 i16: the preferred store layout pattern for 16-bit VL=64 is lane_stride=2
// (kDenseStoreLayoutPatterns: {bits<16>(), ls(2), N<64>(), preferred=true}).
// VMILayoutAssignment propagates this backward through vadds to the vci.
//
// Lowering path exercised (createIotaLaneStrideIntRamp):
//   vci(0, ls=2) → physical [0..127] as i16 (even lanes = logical [0..63])
//   vbitcast(→ui16) → vshrs(>>1, logical) → vbitcast(→i16) → vadds(+0)
//   vsts(PK_B32) selects even physical lanes → 64 i16 values [0..63].
//
// Expected output: 64 i16 elements [0x0000..0x003F].

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vmi_lane_stride_iota_i16_ls2_kernel(
      %dst_gm: !pto.ptr<i16, gm>) attributes {pto.kernel} {
    %c0       = arith.constant 0   : index
    %c0_i16   = arith.constant 0   : i16
    %c0_i64   = arith.constant 0   : i64
    %c1_i64   = arith.constant 1   : i64
    %c128_i64 = arith.constant 128 : i64

    %ub_dst = pto.castptr %c0_i64 : i64 -> !pto.ptr<i16, ub>

    pto.vecscope {
      // VL=64 i16: store preferred layout = lane_stride=2, propagated back to vci.
      // No vadds needed: store directly consumes vci as the layout sink.
      %iota = pto.vmi.vci %c0_i16
          : i16 -> !pto.vmi.vreg<64xi16>
      pto.vmi.vstore %iota, %ub_dst[%c0]
          : !pto.vmi.vreg<64xi16>, !pto.ptr<i16, ub>
    }

    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_dst, %dst_gm, %c128_i64
      nburst(%c1_i64, %c128_i64, %c128_i64)
      : !pto.ptr<i16, ub>, !pto.ptr<i16, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
