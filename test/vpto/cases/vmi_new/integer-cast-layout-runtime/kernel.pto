          : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<256xui8>
      %dst32 = pto.vmi.extui %src32
          : !pto.vmi.vreg<256xui8> -> !pto.vmi.vreg<256xui32>
      pto.vmi.store %dst16, %ub_dst16[%c0]
          : !pto.vmi.vreg<256xui16>, !pto.ptr<ui16, ub>
