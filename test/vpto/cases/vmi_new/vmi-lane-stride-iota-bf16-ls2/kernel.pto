// Regression for #1411 – bf16 lane-strided iota lowering path.
//
// VL=64 bf16: the preferred store layout pattern for 16-bit VL=64 is lane_stride=2
// (kDenseStoreLayoutPatterns: {bits<16>(), ls(2), N<64>(), preferred=true}).
// VMILayoutAssignment propagates this backward through vadds to the vci.
//
// Lowering path exercised (createIotaLaneStrideBF16Ramp) — bf16 cannot use
// the float ramp: vmuls.v128bf16 crashes the bisheng backend and a bare
// vci.v128bf16 yields S8-dtype byte indices in the simulator.  The ramp is
// built on an i16 register and converted numerically:
//   vci(0, i16) → [0..127]
//   vshrs(>>1)  → lane 2k = k, odd lanes hold fill
//   vcvt s16→f16 → vcvt f16→bf16 → numeric [0..63] as bf16
//   vadds(+0.0) → vsts(PK_B32) selects even lanes → [0.0..63.0].
//
// The kernel uses a bare vci→vstore so no user-supplied pred mask is involved;
// the ramp is exercised entirely inside the iota lowering pattern.
//
// Expected output: 64 bf16 elements [0.0..63.0].

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vmi_lane_stride_iota_bf16_ls2_kernel(
      %dst_gm: !pto.ptr<bf16, gm>) attributes {pto.kernel} {
    %c0       = arith.constant 0              : index
    %c0_bf16  = arith.constant 0.000000e+00   : bf16
    %c0_i64   = arith.constant 0              : i64
    %c1_i64   = arith.constant 1              : i64
    %c128_i64 = arith.constant 128            : i64

    %ub_dst = pto.castptr %c0_i64 : i64 -> !pto.ptr<bf16, ub>

    pto.vecscope {
      // VL=64 bf16: store preferred layout = lane_stride=2, propagated back to vci.
      // No explicit mask: the float ramp (vci → vmuls × 0.5 → vadds + 0.0) is
      // generated internally by the iota lowering pattern.
      %iota = pto.vmi.vci %c0_bf16
          : bf16 -> !pto.vmi.vreg<64xbf16>
      pto.vmi.vstore %iota, %ub_dst[%c0]
          : !pto.vmi.vreg<64xbf16>, !pto.ptr<bf16, ub>
    }

    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_dst, %dst_gm, %c128_i64
      nburst(%c1_i64, %c128_i64, %c128_i64)
      : !pto.ptr<bf16, ub>, !pto.ptr<bf16, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
