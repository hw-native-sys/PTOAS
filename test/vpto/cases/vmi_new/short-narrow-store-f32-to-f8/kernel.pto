// Short dense f32 reads narrowed into short packed f8e4m3 stores at four sizes
// and offsets.  The f8 result is packed four to a 32-bit carrier lane
// (lane_stride = 4) while the short store carries a single-carrier group
// packet, so a value only lands in the right bytes when the radix-4 narrowing
// and the carrier layout agree.  Each shape writes a disjoint region; the rest
// of the destination buffer keeps its sentinel, so a wrong byte, a wrong region
// or an overrun shows up as a mismatch.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vmi_short_narrow_store_f8_kernel(%src_gm: !pto.ptr<f32, gm>,
                                              %dst_gm: !pto.ptr<ui8, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c256_i64 = arith.constant 256 : i64
    %c1024_i64 = arith.constant 1024 : i64
    %c2048_i64 = arith.constant 2048 : i64
    %s0 = arith.constant 0 : index
    %d0 = arith.constant 0 : index
    %s32 = arith.constant 32 : index
    %d32 = arith.constant 32 : index
    %s64 = arith.constant 64 : index
    %d64 = arith.constant 64 : index
    %s96 = arith.constant 96 : index
    %d96 = arith.constant 96 : index

    %ub_src = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %ub_dst_u8 = pto.castptr %c2048_i64 : i64 -> !pto.ptr<ui8, ub>
    %ub_dst_f8 = pto.castptr %c2048_i64 : i64 -> !pto.ptr<f8E4M3FN, ub>

    pto.mte_gm_ub %src_gm, %ub_src, %c0_i64, %c1024_i64
      nburst(%c1_i64, %c1024_i64, %c1024_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64
    pto.mte_gm_ub %dst_gm, %ub_dst_u8, %c0_i64, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<ui8, gm>, !pto.ptr<ui8, ub>, i64, i64, i64, i64, i64

    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]

    pto.vecscope {
      %v1 = pto.vmi.vload %ub_src[%s0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<1xf32>
      %n1 = pto.vmi.vcvt %v1 {saturate = "SAT"} : !pto.vmi.vreg<1xf32> -> !pto.vmi.vreg<1xf8E4M3FN>
      pto.vmi.vstore %n1, %ub_dst_f8[%d0] : !pto.vmi.vreg<1xf8E4M3FN>, !pto.ptr<f8E4M3FN, ub>
      %v2 = pto.vmi.vload %ub_src[%s32] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<2xf32>
      %n2 = pto.vmi.vcvt %v2 {saturate = "SAT"} : !pto.vmi.vreg<2xf32> -> !pto.vmi.vreg<2xf8E4M3FN>
      pto.vmi.vstore %n2, %ub_dst_f8[%d32] : !pto.vmi.vreg<2xf8E4M3FN>, !pto.ptr<f8E4M3FN, ub>
      %v4 = pto.vmi.vload %ub_src[%s64] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<4xf32>
      %n4 = pto.vmi.vcvt %v4 {saturate = "SAT"} : !pto.vmi.vreg<4xf32> -> !pto.vmi.vreg<4xf8E4M3FN>
      pto.vmi.vstore %n4, %ub_dst_f8[%d64] : !pto.vmi.vreg<4xf8E4M3FN>, !pto.ptr<f8E4M3FN, ub>
      %v8 = pto.vmi.vload %ub_src[%s96] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
      %n8 = pto.vmi.vcvt %v8 {saturate = "SAT"} : !pto.vmi.vreg<8xf32> -> !pto.vmi.vreg<8xf8E4M3FN>
      pto.vmi.vstore %n8, %ub_dst_f8[%d96] : !pto.vmi.vreg<8xf8E4M3FN>, !pto.ptr<f8E4M3FN, ub>
    }

    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_dst_u8, %dst_gm, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<ui8, ub>, !pto.ptr<ui8, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
