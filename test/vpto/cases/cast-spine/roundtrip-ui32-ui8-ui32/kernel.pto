// RUN: ptoas --pto-arch a5 --pto-backend=vpto --emit-vpto %s -o /dev/null
//
// Direction spine: <down, up> - a single unsigned-integer round trip (ui32 -> ui8 -> ui32).
// // Deliberately NOT recognised by --vmi-prefer-cast-spine-round-trip.
//
// Structure (identical in every cast-spine case):
//   mte_gm_ub -> scf.for(REPEAT) { scf.for(TILE) { chain } } -> mte_ub_gm
// The inner TILE loop walks the whole UB buffer once; the outer REPEAT loop
// replays it so one kernel launch performs REPEAT * 64 iterations of the chain.
// That keeps the per-iteration VPTO shape stable (so the op census of the two
// compiler arms is directly comparable) while making a single launch long enough
// to time above the launch-overhead floor.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vmi_cast_spine_ui32_ui8_ui32_kernel(%src_gm: !pto.ptr<ui32, gm>,
                                %dst_gm: !pto.ptr<ui32, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %c64 = arith.constant 64 : index
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c16384_i64 = arith.constant 16384 : i64
    %one_i32 = arith.constant 1 : i32

    %ub_src = pto.castptr %c0_i64 : i64 -> !pto.ptr<ui32, ub>
    %ub_dst = pto.castptr %c16384_i64 : i64 -> !pto.ptr<ui32, ub>

    pto.mte_gm_ub %src_gm, %ub_src, %c0_i64, %c16384_i64
      nburst(%c1_i64, %c16384_i64, %c16384_i64)
      : !pto.ptr<ui32, gm>, !pto.ptr<ui32, ub>, i64, i64, i64, i64, i64

    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]

    pto.vecscope {
      scf.for %rep = %c0 to %c16 step %c1 {
        scf.for %tile = %c0 to %c64 step %c1 {
          %elem = arith.muli %tile, %c64 : index
          %x = pto.vmi.vload %ub_src[%elem]
              : !pto.ptr<ui32, ub> -> !pto.vmi.vreg<64xui32>
          %n = pto.vmi.vcvt %x {saturate = "NOSAT"}
              : !pto.vmi.vreg<64xui32> -> !pto.vmi.vreg<64xui8>
          %r = pto.vmi.vcvt %n
              : !pto.vmi.vreg<64xui8> -> !pto.vmi.vreg<64xui32>
          %one_bits = pto.vmi.vbrc %one_i32
              : i32 -> !pto.vmi.vreg<64xi32>
          %one = pto.vmi.vinterpret_cast %one_bits
              : !pto.vmi.vreg<64xi32> -> !pto.vmi.vreg<64xui32>
          %s = pto.vmi.vadd %r, %one
              : !pto.vmi.vreg<64xui32>, !pto.vmi.vreg<64xui32>
              -> !pto.vmi.vreg<64xui32>
          pto.vmi.vstore %s, %ub_dst[%elem]
              : !pto.vmi.vreg<64xui32>, !pto.ptr<ui32, ub>
        }
      }
    }

    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_dst, %dst_gm, %c16384_i64
      nburst(%c1_i64, %c16384_i64, %c16384_i64)
      : !pto.ptr<ui32, ub>, !pto.ptr<ui32, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
