module {
  func.func @issue_1329_vabs_zero_all_off(
      %source: !pto.vmi.vreg<256xf16>) -> !pto.vmi.vreg<256xf16> {
    %c0 = arith.constant 0 : index
    %mask = pto.vmi.create_mask %c0
        : index -> !pto.vmi.mask<256xpred>
    %result = pto.vmi.vabs %source, %mask {pmode = "zero"}
        : !pto.vmi.vreg<256xf16>, !pto.vmi.mask<256xpred>
        -> !pto.vmi.vreg<256xf16>
    return %result : !pto.vmi.vreg<256xf16>
  }
}
