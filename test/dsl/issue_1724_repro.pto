!src = !pto.tile_buf<loc=vec, dtype=f32, rows=64, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!view = !pto.tile_buf<loc=vec, dtype=f32, rows=128, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module attributes {pto.target_arch = "a2a3"} {
  func.func @producer(%gm: !pto.ptr<f32>) attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %peer = pto.import_reserved_buffer {name = "c2v", peer_func = @consumer} -> i32
    pto.aic_initialize_pipe {dir_mask = 1, slot_size = 65536, slot_num = 2} (gm_slot_buffer = %gm : !pto.ptr<f32>, c2v_consumer_buf = %peer : i32)
    return
  }
  func.func @consumer(%gm: !pto.ptr<f32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %ring = pto.reserve_buffer {name = "c2v", size = 131072, location = #pto.address_space<vec>, auto = false, base = 0} -> i32
    pto.aiv_initialize_pipe {dir_mask = 1, slot_size = 65536, slot_num = 2} (gm_slot_buffer = %gm : !pto.ptr<f32>, c2v_consumer_buf = %ring : i32)
    %popped = pto.tpop_from_aic(%c0, %c0) {split = 0} -> !src
    %view = pto.treshape %popped : !src -> !view
    pto.set_validshape %view, %c0, %c0 : !view
    pto.tfree_from_aic {split = 0}
    return
  }
}
