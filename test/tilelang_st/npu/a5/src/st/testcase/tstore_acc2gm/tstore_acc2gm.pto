             outs(%l0a_tile : !pto.tile_buf<left, 16x16xbf16, blayout=col_major, slayout=row_major>)

    // TLOAD.MAT ND2NZ: x2 [16,64] bf16
    %tv_x2 = pto.make_tensor_view %x2_gm, shape = [%c16, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xbf16>
    %sv_x2 = pto.partition_view %tv_x2, offsets = [%c0, %c0], sizes = [%c16, %c64] : !pto.tensor_view<?x?xbf16> -> !pto.partition_tensor_view<16x64xbf16>
    %mat_b = pto.alloc_tile : !pto.tile_buf<mat, 16x64xbf16, blayout=col_major, slayout=row_major>
    pto.tload ins(%sv_x2 : !pto.partition_tensor_view<16x64xbf16>)
              outs(%mat_b : !pto.tile_buf<mat, 16x64xbf16, blayout=col_major, slayout=row_major>)
    pto.set_flag["PIPE_MTE2", "PIPE_MTE1", "EVENT_ID1"]
    pto.wait_flag["PIPE_MTE2", "PIPE_MTE1", "EVENT_ID1"]
    %l0b_tile = pto.alloc_tile : !pto.tile_buf<right, 16x64xbf16, blayout=row_major, slayout=col_major>
    pto.tmov ins(%mat_b : !pto.tile_buf<mat, 16x64xbf16, blayout=col_major, slayout=row_major>)
             outs(%l0b_tile : !pto.tile_buf<right, 16x64xbf16, blayout=row_major, slayout=col_major>)

    // TMATMUL: MAT bf16 -> ACC f32
    %acc_c = pto.alloc_tile : !pto.tile_buf<acc, 16x64xf32, blayout=col_major, slayout=row_major>
    pto.set_flag["PIPE_MTE1", "PIPE_M", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE1", "PIPE_M", "EVENT_ID0"]
    pto.tmatmul ins(%l0a_tile, %l0b_tile : !pto.tile_buf<left, 16x16xbf16, blayout=col_major, slayout=row_major>, !pto.tile_buf<right, 16x64xbf16, blayout=row_major, slayout=col_major>)
                outs(%acc_c : !pto.tile_buf<acc, 16x64xf32, blayout=col_major, slayout=row_major>)

    %fp_tile = pto.alloc_tile : !pto.tile_buf<scaling, 1x128xf32, blayout=row_major, slayout=none_box, fractal=512>

    // Load qf322bf16_pre_vec encoded parameters to FB using the pto-isa tileop layout.
    %l1_fp_raw = pto.castptr %c4096_i64 : i64 -> !pto.ptr<ui32, l1>
    %l1_fp = pto.castptr %c4096_i64 : i64 -> !pto.ptr<ui64, l1>
    %fb_fp = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, fb>
    pto.mte_gm_l1 %quant_gm, %l1_fp_raw, %c512_i64
      nburst(%c1_i64, %c0_i64, %c0_i64)
      : !pto.ptr<ui32>, !pto.ptr<ui32, l1>, i64, i64, i64, i64
    pto.set_flag["PIPE_M", "PIPE_FIX", "EVENT_ID2"]
    pto.wait_flag["PIPE_M", "PIPE_FIX", "EVENT_ID2"]
    pto.set_flag["PIPE_MTE2", "PIPE_FIX", "EVENT_ID3"]
    pto.wait_flag["PIPE_MTE2", "PIPE_FIX", "EVENT_ID3"]
    pto.mte_l1_fb %l1_fp, %fb_fp, %c8_i64
      nburst(%c1_i64, %c0_i64, %c0_i64)
      : !pto.ptr<ui64, l1>, !pto.ptr<f32, fb>, i64, i64, i64, i64
    // TSTORE_FP: ACC f32 + scaling f32 -> GM bf16 (qf322bf16_pre_vec)
    %tv_dst = pto.make_tensor_view %dst_gm, shape = [%c16, %c64], strides = [%c64, %c1] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
    %sv_dst = pto.partition_view %tv_dst, offsets = [%c0, %c0], sizes = [%c16, %c64] : !pto.tensor_view<?x?xbf16> -> !pto.partition_tensor_view<16x64xbf16>
    pto.tstore_fp ins(%acc_c, %fp_tile : !pto.tile_buf<acc, 16x64xf32, blayout=col_major, slayout=row_major>, !pto.tile_buf<scaling, 1x128xf32, blayout=row_major, slayout=none_box, fractal=512>)
                  outs(%sv_dst : !pto.partition_tensor_view<16x64xbf16>)

    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }

}
