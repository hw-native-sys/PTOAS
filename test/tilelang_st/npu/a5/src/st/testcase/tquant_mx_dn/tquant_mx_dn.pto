module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  // The DN cases exercise the grouped axis-0 TQUANT followed by DN-to-ZZ.
  func.func @TQUANT_MX_DN_fp8_ocp_64x64(
      %src_ptr: !pto.ptr<f32, gm>, %dst_ptr: !pto.ptr<i8, gm>, %exp_ptr: !pto.ptr<ui8, gm>,
      %max_ptr: !pto.ptr<f32, gm>, %scaling_ptr: !pto.ptr<f32, gm>, %exp_zz_ptr: !pto.ptr<ui8, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c32 = arith.constant 32 : index
    %c64 = arith.constant 64 : index
    %c128 = arith.constant 128 : index
    %src_view = pto.make_tensor_view %src_ptr, shape = [%c64, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xf32>
    %dst_view = pto.make_tensor_view %dst_ptr, shape = [%c64, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xi8>
    %exp_view = pto.make_tensor_view %exp_ptr, shape = [%c2, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xui8>
    %max_view = pto.make_tensor_view %max_ptr, shape = [%c2, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xf32>
    %scaling_view = pto.make_tensor_view %scaling_ptr, shape = [%c2, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xf32>
    %exp_zz_view = pto.make_tensor_view %exp_zz_ptr, shape = [%c1, %c128], strides = [%c128, %c1] : !pto.tensor_view<?x?xui8>
    %src_part = pto.partition_view %src_view, offsets = [%c0, %c0], sizes = [%c64, %c64] : !pto.tensor_view<?x?xf32>
    %dst_part = pto.partition_view %dst_view, offsets = [%c0, %c0], sizes = [%c64, %c64] : !pto.tensor_view<?x?xi8>
    %exp_part = pto.partition_view %exp_view, offsets = [%c0, %c0], sizes = [%c2, %c64] : !pto.tensor_view<?x?xui8>
    %max_part = pto.partition_view %max_view, offsets = [%c0, %c0], sizes = [%c2, %c64] : !pto.tensor_view<?x?xf32>
    %scaling_part = pto.partition_view %scaling_view, offsets = [%c0, %c0], sizes = [%c2, %c64] : !pto.tensor_view<?x?xf32>
    %exp_zz_part = pto.partition_view %exp_zz_view, offsets = [%c0, %c0], sizes = [%c1, %c128] : !pto.tensor_view<?x?xui8>
    %src = pto.alloc_tile : !pto.tile_buf<vec, 64x64xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 64x64xi8>
    %exp = pto.alloc_tile : !pto.tile_buf<vec, 2x64xui8>
    %max = pto.alloc_tile : !pto.tile_buf<vec, 2x64xf32>
    %scaling = pto.alloc_tile : !pto.tile_buf<vec, 2x64xf32>
    %exp_zz = pto.alloc_tile : !pto.tile_buf<vec, 1x128xui8, slayout=row_major>
    %tmp = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui8, valid=1x1>
    pto.tload ins(%src_part : !pto.partition_tensor_view<64x64xf32>) outs(%src : !pto.tile_buf<vec, 64x64xf32>)
    pto.tquant.mx ins(%src : !pto.tile_buf<vec, 64x64xf32>) outs(%dst, %exp, %max, %scaling : !pto.tile_buf<vec, 64x64xi8>, !pto.tile_buf<vec, 2x64xui8>, !pto.tile_buf<vec, 2x64xf32>, !pto.tile_buf<vec, 2x64xf32>) {quant_type = #pto<quant_type MXFP8>, grpAxis = #pto<mx_group_axis axis0>}
    pto.tmov ins(%exp : !pto.tile_buf<vec, 2x64xui8>, %tmp : !pto.tile_buf<vec, 1x32xui8, valid=1x1>) outs(%exp_zz : !pto.tile_buf<vec, 1x128xui8, slayout=row_major>) {grpAxis = #pto<mx_group_axis axis0>}
    pto.tstore ins(%dst : !pto.tile_buf<vec, 64x64xi8>) outs(%dst_part : !pto.partition_tensor_view<64x64xi8>)
    pto.tstore ins(%exp : !pto.tile_buf<vec, 2x64xui8>) outs(%exp_part : !pto.partition_tensor_view<2x64xui8>)
    pto.tstore ins(%max : !pto.tile_buf<vec, 2x64xf32>) outs(%max_part : !pto.partition_tensor_view<2x64xf32>)
    pto.tstore ins(%scaling : !pto.tile_buf<vec, 2x64xf32>) outs(%scaling_part : !pto.partition_tensor_view<2x64xf32>)
    pto.tstore ins(%exp_zz : !pto.tile_buf<vec, 1x128xui8, slayout=row_major>) outs(%exp_zz_part : !pto.partition_tensor_view<1x128xui8>)
    return
  }

  func.func @TQUANT_MX_DN_fp8_ocp_128x32(
      %src_ptr: !pto.ptr<f32, gm>, %dst_ptr: !pto.ptr<i8, gm>, %exp_ptr: !pto.ptr<ui8, gm>,
      %max_ptr: !pto.ptr<f32, gm>, %scaling_ptr: !pto.ptr<f32, gm>, %exp_zz_ptr: !pto.ptr<ui8, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c32 = arith.constant 32 : index
    %c128 = arith.constant 128 : index
    %src_view = pto.make_tensor_view %src_ptr, shape = [%c128, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xf32>
    %dst_view = pto.make_tensor_view %dst_ptr, shape = [%c128, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xi8>
    %exp_view = pto.make_tensor_view %exp_ptr, shape = [%c4, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xui8>
    %max_view = pto.make_tensor_view %max_ptr, shape = [%c4, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xf32>
    %scaling_view = pto.make_tensor_view %scaling_ptr, shape = [%c4, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xf32>
    %exp_zz_view = pto.make_tensor_view %exp_zz_ptr, shape = [%c1, %c128], strides = [%c128, %c1] : !pto.tensor_view<?x?xui8>
    %src_part = pto.partition_view %src_view, offsets = [%c0, %c0], sizes = [%c128, %c32] : !pto.tensor_view<?x?xf32>
    %dst_part = pto.partition_view %dst_view, offsets = [%c0, %c0], sizes = [%c128, %c32] : !pto.tensor_view<?x?xi8>
    %exp_part = pto.partition_view %exp_view, offsets = [%c0, %c0], sizes = [%c4, %c32] : !pto.tensor_view<?x?xui8>
    %max_part = pto.partition_view %max_view, offsets = [%c0, %c0], sizes = [%c4, %c32] : !pto.tensor_view<?x?xf32>
    %scaling_part = pto.partition_view %scaling_view, offsets = [%c0, %c0], sizes = [%c4, %c32] : !pto.tensor_view<?x?xf32>
    %exp_zz_part = pto.partition_view %exp_zz_view, offsets = [%c0, %c0], sizes = [%c1, %c128] : !pto.tensor_view<?x?xui8>
    %src = pto.alloc_tile : !pto.tile_buf<vec, 128x32xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 128x32xi8>
    %exp = pto.alloc_tile : !pto.tile_buf<vec, 4x32xui8>
    %max = pto.alloc_tile : !pto.tile_buf<vec, 4x32xf32>
    %scaling = pto.alloc_tile : !pto.tile_buf<vec, 4x32xf32>
    %exp_zz = pto.alloc_tile : !pto.tile_buf<vec, 1x128xui8, slayout=row_major>
    %tmp = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui8, valid=1x1>
    pto.tload ins(%src_part : !pto.partition_tensor_view<128x32xf32>) outs(%src : !pto.tile_buf<vec, 128x32xf32>)
    pto.tquant.mx ins(%src : !pto.tile_buf<vec, 128x32xf32>) outs(%dst, %exp, %max, %scaling : !pto.tile_buf<vec, 128x32xi8>, !pto.tile_buf<vec, 4x32xui8>, !pto.tile_buf<vec, 4x32xf32>, !pto.tile_buf<vec, 4x32xf32>) {quant_type = #pto<quant_type MXFP8>, grpAxis = #pto<mx_group_axis axis0>}
    pto.tmov ins(%exp : !pto.tile_buf<vec, 4x32xui8>, %tmp : !pto.tile_buf<vec, 1x32xui8, valid=1x1>) outs(%exp_zz : !pto.tile_buf<vec, 1x128xui8, slayout=row_major>) {grpAxis = #pto<mx_group_axis axis0>}
    pto.tstore ins(%dst : !pto.tile_buf<vec, 128x32xi8>) outs(%dst_part : !pto.partition_tensor_view<128x32xi8>)
    pto.tstore ins(%exp : !pto.tile_buf<vec, 4x32xui8>) outs(%exp_part : !pto.partition_tensor_view<4x32xui8>)
    pto.tstore ins(%max : !pto.tile_buf<vec, 4x32xf32>) outs(%max_part : !pto.partition_tensor_view<4x32xf32>)
    pto.tstore ins(%scaling : !pto.tile_buf<vec, 4x32xf32>) outs(%scaling_part : !pto.partition_tensor_view<4x32xf32>)
    pto.tstore ins(%exp_zz : !pto.tile_buf<vec, 1x128xui8, slayout=row_major>) outs(%exp_zz_part : !pto.partition_tensor_view<1x128xui8>)
    return
  }

  func.func @TQUANT_MX_DN_fp8_nv_64x64(
      %src_ptr: !pto.ptr<f32, gm>, %dst_ptr: !pto.ptr<i8, gm>, %exp_ptr: !pto.ptr<ui8, gm>,
      %max_ptr: !pto.ptr<f32, gm>, %scaling_ptr: !pto.ptr<f32, gm>, %exp_zz_ptr: !pto.ptr<ui8, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %c128 = arith.constant 128 : index
    %src_view = pto.make_tensor_view %src_ptr, shape = [%c64, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xf32>
    %dst_view = pto.make_tensor_view %dst_ptr, shape = [%c64, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xi8>
    %exp_view = pto.make_tensor_view %exp_ptr, shape = [%c2, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xui8>
    %max_view = pto.make_tensor_view %max_ptr, shape = [%c2, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xf32>
    %scaling_view = pto.make_tensor_view %scaling_ptr, shape = [%c2, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xf32>
    %exp_zz_view = pto.make_tensor_view %exp_zz_ptr, shape = [%c1, %c128], strides = [%c128, %c1] : !pto.tensor_view<?x?xui8>
    %src_part = pto.partition_view %src_view, offsets = [%c0, %c0], sizes = [%c64, %c64] : !pto.tensor_view<?x?xf32>
    %dst_part = pto.partition_view %dst_view, offsets = [%c0, %c0], sizes = [%c64, %c64] : !pto.tensor_view<?x?xi8>
    %exp_part = pto.partition_view %exp_view, offsets = [%c0, %c0], sizes = [%c2, %c64] : !pto.tensor_view<?x?xui8>
    %max_part = pto.partition_view %max_view, offsets = [%c0, %c0], sizes = [%c2, %c64] : !pto.tensor_view<?x?xf32>
    %scaling_part = pto.partition_view %scaling_view, offsets = [%c0, %c0], sizes = [%c2, %c64] : !pto.tensor_view<?x?xf32>
    %exp_zz_part = pto.partition_view %exp_zz_view, offsets = [%c0, %c0], sizes = [%c1, %c128] : !pto.tensor_view<?x?xui8>
    %src = pto.alloc_tile : !pto.tile_buf<vec, 64x64xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 64x64xi8>
    %exp = pto.alloc_tile : !pto.tile_buf<vec, 2x64xui8>
    %max = pto.alloc_tile : !pto.tile_buf<vec, 2x64xf32>
    %scaling = pto.alloc_tile : !pto.tile_buf<vec, 2x64xf32>
    %exp_zz = pto.alloc_tile : !pto.tile_buf<vec, 1x128xui8, slayout=row_major>
    %tmp = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui8, valid=1x1>
    pto.tload ins(%src_part : !pto.partition_tensor_view<64x64xf32>) outs(%src : !pto.tile_buf<vec, 64x64xf32>)
    pto.tquant.mx ins(%src : !pto.tile_buf<vec, 64x64xf32>) outs(%dst, %exp, %max, %scaling : !pto.tile_buf<vec, 64x64xi8>, !pto.tile_buf<vec, 2x64xui8>, !pto.tile_buf<vec, 2x64xf32>, !pto.tile_buf<vec, 2x64xf32>) {quant_type = #pto<quant_type MXFP8>, quantScaleAlg = #pto<quant_scale_alg nv>, grpAxis = #pto<mx_group_axis axis0>}
    pto.tmov ins(%exp : !pto.tile_buf<vec, 2x64xui8>, %tmp : !pto.tile_buf<vec, 1x32xui8, valid=1x1>) outs(%exp_zz : !pto.tile_buf<vec, 1x128xui8, slayout=row_major>) {grpAxis = #pto<mx_group_axis axis0>}
    pto.tstore ins(%dst : !pto.tile_buf<vec, 64x64xi8>) outs(%dst_part : !pto.partition_tensor_view<64x64xi8>)
    pto.tstore ins(%exp : !pto.tile_buf<vec, 2x64xui8>) outs(%exp_part : !pto.partition_tensor_view<2x64xui8>)
    pto.tstore ins(%max : !pto.tile_buf<vec, 2x64xf32>) outs(%max_part : !pto.partition_tensor_view<2x64xf32>)
    pto.tstore ins(%scaling : !pto.tile_buf<vec, 2x64xf32>) outs(%scaling_part : !pto.partition_tensor_view<2x64xf32>)
    pto.tstore ins(%exp_zz : !pto.tile_buf<vec, 1x128xui8, slayout=row_major>) outs(%exp_zz_part : !pto.partition_tensor_view<1x128xui8>)
    return
  }

  func.func @TQUANT_MX_DN_fp4_bf16_ocp_64x64(
      %src_ptr: !pto.ptr<bf16, gm>, %dst_ptr: !pto.ptr<!pto.f4E2M1x2, gm>, %exp_ptr: !pto.ptr<ui8, gm>,
      %max_ptr: !pto.ptr<bf16, gm>, %scaling_ptr: !pto.ptr<bf16, gm>, %exp_zz_ptr: !pto.ptr<ui8, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c32 = arith.constant 32 : index
    %c64 = arith.constant 64 : index
    %c128 = arith.constant 128 : index
    %src_view = pto.make_tensor_view %src_ptr, shape = [%c64, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xbf16>
    %dst_view = pto.make_tensor_view %dst_ptr, shape = [%c64, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?x!pto.f4E2M1x2>
    %exp_view = pto.make_tensor_view %exp_ptr, shape = [%c2, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xui8>
    %max_view = pto.make_tensor_view %max_ptr, shape = [%c2, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xbf16>
    %scaling_view = pto.make_tensor_view %scaling_ptr, shape = [%c2, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xbf16>
    %exp_zz_view = pto.make_tensor_view %exp_zz_ptr, shape = [%c1, %c128], strides = [%c128, %c1] : !pto.tensor_view<?x?xui8>
    %src_part = pto.partition_view %src_view, offsets = [%c0, %c0], sizes = [%c64, %c64] : !pto.tensor_view<?x?xbf16>
    %dst_part = pto.partition_view %dst_view, offsets = [%c0, %c0], sizes = [%c64, %c32] : !pto.tensor_view<?x?x!pto.f4E2M1x2>
    %exp_part = pto.partition_view %exp_view, offsets = [%c0, %c0], sizes = [%c2, %c64] : !pto.tensor_view<?x?xui8>
    %max_part = pto.partition_view %max_view, offsets = [%c0, %c0], sizes = [%c2, %c64] : !pto.tensor_view<?x?xbf16>
    %scaling_part = pto.partition_view %scaling_view, offsets = [%c0, %c0], sizes = [%c2, %c64] : !pto.tensor_view<?x?xbf16>
    %exp_zz_part = pto.partition_view %exp_zz_view, offsets = [%c0, %c0], sizes = [%c1, %c128] : !pto.tensor_view<?x?xui8>
    %src = pto.alloc_tile : !pto.tile_buf<vec, 64x64xbf16>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 64x32x!pto.f4E2M1x2>
    %exp = pto.alloc_tile : !pto.tile_buf<vec, 2x64xui8>
    %max = pto.alloc_tile : !pto.tile_buf<vec, 2x64xbf16>
    %scaling = pto.alloc_tile : !pto.tile_buf<vec, 2x64xbf16>
    %exp_zz = pto.alloc_tile : !pto.tile_buf<vec, 1x128xui8, slayout=row_major>
    %tmp = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui8, valid=1x1>
    pto.tload ins(%src_part : !pto.partition_tensor_view<64x64xbf16>) outs(%src : !pto.tile_buf<vec, 64x64xbf16>)
    pto.tquant.mx ins(%src : !pto.tile_buf<vec, 64x64xbf16>) outs(%dst, %exp, %max, %scaling : !pto.tile_buf<vec, 64x32x!pto.f4E2M1x2>, !pto.tile_buf<vec, 2x64xui8>, !pto.tile_buf<vec, 2x64xbf16>, !pto.tile_buf<vec, 2x64xbf16>) {quant_type = #pto<quant_type MXFP4_E2M1>, grpAxis = #pto<mx_group_axis axis0>}
    pto.tmov ins(%exp : !pto.tile_buf<vec, 2x64xui8>, %tmp : !pto.tile_buf<vec, 1x32xui8, valid=1x1>) outs(%exp_zz : !pto.tile_buf<vec, 1x128xui8, slayout=row_major>) {grpAxis = #pto<mx_group_axis axis0>}
    pto.tstore ins(%dst : !pto.tile_buf<vec, 64x32x!pto.f4E2M1x2>) outs(%dst_part : !pto.partition_tensor_view<64x32x!pto.f4E2M1x2>)
    pto.tstore ins(%exp : !pto.tile_buf<vec, 2x64xui8>) outs(%exp_part : !pto.partition_tensor_view<2x64xui8>)
    pto.tstore ins(%max : !pto.tile_buf<vec, 2x64xbf16>) outs(%max_part : !pto.partition_tensor_view<2x64xbf16>)
    pto.tstore ins(%scaling : !pto.tile_buf<vec, 2x64xbf16>) outs(%scaling_part : !pto.partition_tensor_view<2x64xbf16>)
    pto.tstore ins(%exp_zz : !pto.tile_buf<vec, 1x128xui8, slayout=row_major>) outs(%exp_zz_part : !pto.partition_tensor_view<1x128xui8>)
    return
  }

  func.func @TQUANT_MX_DN_fp8_ocp_64x96(
      %src_ptr: !pto.ptr<f32, gm>, %dst_ptr: !pto.ptr<i8, gm>, %exp_ptr: !pto.ptr<ui8, gm>,
      %max_ptr: !pto.ptr<f32, gm>, %scaling_ptr: !pto.ptr<f32, gm>, %exp_zz_ptr: !pto.ptr<ui8, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %c96 = arith.constant 96 : index
    %c192 = arith.constant 192 : index
    %src_view = pto.make_tensor_view %src_ptr, shape = [%c64, %c96], strides = [%c96, %c1] : !pto.tensor_view<?x?xf32>
    %dst_view = pto.make_tensor_view %dst_ptr, shape = [%c64, %c96], strides = [%c96, %c1] : !pto.tensor_view<?x?xi8>
    %exp_view = pto.make_tensor_view %exp_ptr, shape = [%c2, %c96], strides = [%c96, %c1] : !pto.tensor_view<?x?xui8>
    %max_view = pto.make_tensor_view %max_ptr, shape = [%c2, %c96], strides = [%c96, %c1] : !pto.tensor_view<?x?xf32>
    %scaling_view = pto.make_tensor_view %scaling_ptr, shape = [%c2, %c96], strides = [%c96, %c1] : !pto.tensor_view<?x?xf32>
    %exp_zz_view = pto.make_tensor_view %exp_zz_ptr, shape = [%c1, %c192], strides = [%c192, %c1] : !pto.tensor_view<?x?xui8>
    %src_part = pto.partition_view %src_view, offsets = [%c0, %c0], sizes = [%c64, %c96] : !pto.tensor_view<?x?xf32>
    %dst_part = pto.partition_view %dst_view, offsets = [%c0, %c0], sizes = [%c64, %c96] : !pto.tensor_view<?x?xi8>
    %exp_part = pto.partition_view %exp_view, offsets = [%c0, %c0], sizes = [%c2, %c96] : !pto.tensor_view<?x?xui8>
    %max_part = pto.partition_view %max_view, offsets = [%c0, %c0], sizes = [%c2, %c96] : !pto.tensor_view<?x?xf32>
    %scaling_part = pto.partition_view %scaling_view, offsets = [%c0, %c0], sizes = [%c2, %c96] : !pto.tensor_view<?x?xf32>
    %exp_zz_part = pto.partition_view %exp_zz_view, offsets = [%c0, %c0], sizes = [%c1, %c192] : !pto.tensor_view<?x?xui8>
    %src = pto.alloc_tile : !pto.tile_buf<vec, 64x96xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 64x96xi8>
    %exp = pto.alloc_tile : !pto.tile_buf<vec, 2x96xui8>
    %max = pto.alloc_tile : !pto.tile_buf<vec, 2x96xf32>
    %scaling = pto.alloc_tile : !pto.tile_buf<vec, 2x96xf32>
    %exp_zz = pto.alloc_tile : !pto.tile_buf<vec, 1x192xui8, slayout=row_major>
    %tmp = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui8, valid=1x1>
    pto.tload ins(%src_part : !pto.partition_tensor_view<64x96xf32>) outs(%src : !pto.tile_buf<vec, 64x96xf32>)
    pto.tquant.mx ins(%src : !pto.tile_buf<vec, 64x96xf32>) outs(%dst, %exp, %max, %scaling : !pto.tile_buf<vec, 64x96xi8>, !pto.tile_buf<vec, 2x96xui8>, !pto.tile_buf<vec, 2x96xf32>, !pto.tile_buf<vec, 2x96xf32>) {quant_type = #pto<quant_type MXFP8>, grpAxis = #pto<mx_group_axis axis0>}
