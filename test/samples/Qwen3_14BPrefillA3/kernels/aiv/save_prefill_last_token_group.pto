module attributes {pto.target_arch = "a2a3"} {
  func.func @save_prefill_last_token_group(%arg0: !pto.ptr<bf16>, %arg1: !pto.ptr<bf16>, %arg2: index, %arg3: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  %c0_i64 = arith.constant 0 : i64
  %c16_index = arith.constant 16 : index
  %c5120_index = arith.constant 5120 : index
  %c1_index = arith.constant 1 : index
  %c2048_index = arith.constant 2048 : index
  %c0_index = arith.constant 0 : index
  %c20_index = arith.constant 20 : index
  %c256_index = arith.constant 256 : index
  %final_hidden__iter_v8_view = pto.make_tensor_view %arg0, shape = [%c16_index, %c5120_index], strides = [%c5120_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
  %group_hidden__rv_v9_view = pto.make_tensor_view %arg1, shape = [%c2048_index, %c5120_index], strides = [%c5120_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
  scf.for %kb__idx_v0 = %c0_index to %c20_index step %c1_index {
    %0 = arith.muli %kb__idx_v0, %c256_index : index
    %final_hidden_chunk__tile = pto.alloc_tile addr = %c0_i64 valid_row = %c1_index valid_col = %c256_index : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %1 = arith.maxsi %arg2, %c0_index : index
    %2 = arith.maxsi %0, %c0_index : index
    %group_hidden__rv_v9_pview = pto.partition_view %group_hidden__rv_v9_view, offsets = [%1, %2], sizes = [%c1_index, %c256_index] : !pto.tensor_view<?x?xbf16> -> !pto.partition_tensor_view<1x256xbf16>
    pto.tload ins(%group_hidden__rv_v9_pview : !pto.partition_tensor_view<1x256xbf16>) outs(%final_hidden_chunk__tile : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    %3 = arith.maxsi %arg3, %c0_index : index
    %4 = arith.maxsi %0, %c0_index : index
    %final_hidden__iter_v10_pview = pto.partition_view %final_hidden__iter_v8_view, offsets = [%3, %4], sizes = [%c1_index, %c256_index] : !pto.tensor_view<?x?xbf16> -> !pto.partition_tensor_view<1x256xbf16>
    pto.tstore ins(%final_hidden_chunk__tile : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%final_hidden__iter_v10_pview : !pto.partition_tensor_view<1x256xbf16>)
  }
  return
  }
}
