module attributes {pto.target_arch = "a5"} {
  func.func private @tinterleave_sample(
      %src0: !pto.tile_buf<vec, 16x64xf32>,
      %src1: !pto.tile_buf<vec, 16x64xf32>,
      %dst0: !pto.tile_buf<vec, 16x64xf32>,
      %dst1: !pto.tile_buf<vec, 16x64xf32>) {
    pto.tinterleave ins(%src0, %src1 :
                          !pto.tile_buf<vec, 16x64xf32>,
                          !pto.tile_buf<vec, 16x64xf32>)
                    outs(%dst0, %dst1 :
                           !pto.tile_buf<vec, 16x64xf32>,
                           !pto.tile_buf<vec, 16x64xf32>)
    return
  }
}
