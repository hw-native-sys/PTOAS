module {
  func.func @tconcatidx_a3(%src0_ptr: !pto.ptr<f32>, %src1_ptr: !pto.ptr<f32>,
      %idx0_ptr: !pto.ptr<i32>, %idx1_ptr: !pto.ptr<i32>, %dst_ptr: !pto.ptr<f32>)
      attributes {pto.entry} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %c64 = arith.constant 64 : index
    %src0_view = pto.make_tensor_view %src0_ptr, shape = [%c8, %c64],
      strides = [%c64, %c1] : !pto.tensor_view<8x64xf32>
    %src1_view = pto.make_tensor_view %src1_ptr, shape = [%c8, %c64],
      strides = [%c64, %c1] : !pto.tensor_view<8x64xf32>
    %idx0_view = pto.make_tensor_view %idx0_ptr, shape = [%c8, %c1],
      strides = [%c1, %c1] : !pto.tensor_view<8x1xi32>
    %idx1_view = pto.make_tensor_view %idx1_ptr, shape = [%c8, %c1],
      strides = [%c1, %c1] : !pto.tensor_view<8x1xi32>
    %dst_view = pto.make_tensor_view %dst_ptr, shape = [%c8, %c64],
      strides = [%c64, %c1] : !pto.tensor_view<8x64xf32>
    %src0_part = pto.partition_view %src0_view, offsets = [%c0, %c0], sizes = [%c8, %c64]
      : !pto.tensor_view<8x64xf32> -> !pto.partition_tensor_view<8x64xf32>
    %src1_part = pto.partition_view %src1_view, offsets = [%c0, %c0], sizes = [%c8, %c64]
      : !pto.tensor_view<8x64xf32> -> !pto.partition_tensor_view<8x64xf32>
    %idx0_part = pto.partition_view %idx0_view, offsets = [%c0, %c0], sizes = [%c8, %c1]
      : !pto.tensor_view<8x1xi32> -> !pto.partition_tensor_view<8x1xi32>
    %idx1_part = pto.partition_view %idx1_view, offsets = [%c0, %c0], sizes = [%c8, %c1]
      : !pto.tensor_view<8x1xi32> -> !pto.partition_tensor_view<8x1xi32>
    %dst_part = pto.partition_view %dst_view, offsets = [%c0, %c0], sizes = [%c8, %c64]
      : !pto.tensor_view<8x64xf32> -> !pto.partition_tensor_view<8x64xf32>
    %src0 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64,
      v_row=8, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src1 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64,
      v_row=8, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %idx0 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=i32, rows=8, cols=8,
      v_row=8, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %idx1 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=i32, rows=8, cols=8,
      v_row=8, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64,
      v_row=8, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tload ins(%src0_part : !pto.partition_tensor_view<8x64xf32>) outs(%src0 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64, v_row=8, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tload ins(%src1_part : !pto.partition_tensor_view<8x64xf32>) outs(%src1 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64, v_row=8, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tload ins(%idx0_part : !pto.partition_tensor_view<8x1xi32>) outs(%idx0 : !pto.tile_buf<loc=vec, dtype=i32, rows=8, cols=8, v_row=8, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tload ins(%idx1_part : !pto.partition_tensor_view<8x1xi32>) outs(%idx1 : !pto.tile_buf<loc=vec, dtype=i32, rows=8, cols=8, v_row=8, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tload ins(%dst_part : !pto.partition_tensor_view<8x64xf32>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64, v_row=8, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tconcatidx ins(%src0, %src1, %idx0, %idx1 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64, v_row=8, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64, v_row=8, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=i32, rows=8, cols=8, v_row=8, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=i32, rows=8, cols=8, v_row=8, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64, v_row=8, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tstore ins(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64, v_row=8, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%dst_part : !pto.partition_tensor_view<8x64xf32>)
    return
  }
}
