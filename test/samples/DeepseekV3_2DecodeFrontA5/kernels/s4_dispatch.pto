module attributes {pto.target_arch = "a5"} {
  func.func @s4_dispatch(%arg0: !pto.ptr<i32>, %arg1: !pto.ptr<bf16>, %arg2: !pto.ptr<bf16>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  %c0_i64 = arith.constant 0 : i64
  %c1_index = arith.constant 1 : index
  %c128_index = arith.constant 128 : index
  %c16_index = arith.constant 16 : index
  %c16384_index = arith.constant 16384 : index
  %c0_index = arith.constant 0 : index
  %layer_id_t__ssa_v0_view = pto.make_tensor_view %arg0, shape = [%c1_index], strides = [%c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?xi32>
  %dispatch_buf__ssa_v0_s0 = arith.muli %c16384_index, %c16_index : index
  %dispatch_buf__ssa_v0_view = pto.make_tensor_view %arg1, shape = [%c128_index, %c16_index, %c16384_index], strides = [%dispatch_buf__ssa_v0_s0, %c16384_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?x?xbf16>
  %attn_front__rv_v2_view = pto.make_tensor_view %arg2, shape = [%c16_index, %c16384_index], strides = [%c16384_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
  %layer_id__tile = pto.load_scalar %arg0[%c0_index] : !pto.ptr<i32> -> i32
  scf.for %b__idx_v0 = %c0_index to %c16_index step %c1_index {
    %0 = arith.index_cast %layer_id__tile : i32 to index
    %1 = arith.addi %b__idx_v0, %0 : index
    %2 = arith.remsi %1, %c128_index : index
    %token_row__tile = pto.alloc_tile addr = %c0_i64 valid_row = %c1_index valid_col = %c16384_index : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=16384, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %3 = arith.maxsi %b__idx_v0, %c0_index : index
    %attn_front__rv_v2_pview = pto.partition_view %attn_front__rv_v2_view, offsets = [%3, %c0_index], sizes = [%c1_index, %c16384_index] : !pto.tensor_view<?x?xbf16> -> !pto.partition_tensor_view<1x16384xbf16>
    pto.tload ins(%attn_front__rv_v2_pview : !pto.partition_tensor_view<1x16384xbf16>) outs(%token_row__tile : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=16384, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    %4 = arith.maxsi %2, %c0_index : index
    %5 = arith.maxsi %b__idx_v0, %c0_index : index
    %dispatch_buf__iter_v1_pview = pto.partition_view %dispatch_buf__ssa_v0_view, offsets = [%4, %5, %c0_index], sizes = [%c1_index, %c1_index, %c16384_index] : !pto.tensor_view<?x?x?xbf16> -> !pto.partition_tensor_view<1x1x16384xbf16>
    pto.tstore ins(%token_row__tile : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=16384, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%dispatch_buf__iter_v1_pview : !pto.partition_tensor_view<1x1x16384xbf16>)
  }
  return
  }
}
