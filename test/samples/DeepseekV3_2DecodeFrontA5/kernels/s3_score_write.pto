module attributes {pto.target_arch = "a5"} {
  func.func @s3_score_write(%arg0: !pto.ptr<f32>, %arg1: !pto.ptr<f32>, %arg2: index, %arg3: i32, %arg4: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
