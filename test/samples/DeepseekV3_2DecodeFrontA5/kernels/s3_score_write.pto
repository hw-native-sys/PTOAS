    %1 = arith.index_cast %arg3 : i32 to index
    %2 = arith.subi %1, %0 : index
    %3 = arith.minsi %2, %c64_index : index
    %4 = arith.muli %sb__idx_v0, %c16_index : index
    %s3_score_valid__tile = pto.alloc_tile addr = %c0_i64 valid_row = %c1_index valid_col = %3 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %5 = arith.maxsi %4, %c0_index : index
    %s3_score_tiles__rv_v2_pview = pto.partition_view %s3_score_tiles__rv_v2_view, offsets = [%5, %c0_index], sizes = [%c1_index, %3] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x?xf32>
    pto.tload ins(%s3_score_tiles__rv_v2_pview : !pto.partition_tensor_view<1x?xf32>) outs(%s3_score_valid__tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    %6 = arith.maxsi %arg4, %c0_index : index
    %7 = arith.maxsi %0, %c0_index : index
    %scores__iter_v4_pview = pto.partition_view %scores__ssa_v3_view, offsets = [%6, %7], sizes = [%c1_index, %3] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x?xf32>
    pto.tstore ins(%s3_score_valid__tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%scores__iter_v4_pview : !pto.partition_tensor_view<1x?xf32>)
