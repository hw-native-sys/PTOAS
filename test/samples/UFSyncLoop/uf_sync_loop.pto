// 128 drains to distinct GM tiles reuse physical ACC address zero.
!left = !pto.tile_buf<loc=left, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
!right = !pto.tile_buf<loc=right, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=col_major, fractal=512, pad=0>
!acc = !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=1024, pad=0>
!out = !pto.partition_tensor_view<32x32xf32>

!amat = !pto.tile_buf<loc=mat, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
!bmat = !pto.tile_buf<loc=mat, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
module attributes {pto.target_arch = "a5"} {
  func.func @uf_sync_loop(%a: !pto.ptr<f16>, %b: !pto.ptr<f16>, %out: !pto.ptr<f32>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %c128 = arith.constant 128 : index
    %c4096 = arith.constant 4096 : index
    %addr0 = arith.constant 0 : i64
    %addr2048 = arith.constant 2048 : i64
    %av = pto.make_tensor_view %a, shape = [%c32, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xf16>
    %bv = pto.make_tensor_view %b, shape = [%c32, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xf16>
    %ov = pto.make_tensor_view %out, shape = [%c4096, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xf32>
    %ap = pto.partition_view %av, offsets = [%c0, %c0], sizes = [%c32, %c32] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<32x32xf16>
    %bp = pto.partition_view %bv, offsets = [%c0, %c0], sizes = [%c32, %c32] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<32x32xf16>
    %al1 = pto.alloc_tile addr = %addr0 : !amat
    %bl1 = pto.alloc_tile addr = %addr2048 : !bmat
    %lhs = pto.alloc_tile addr = %addr0 : !left
    %rhs = pto.alloc_tile addr = %addr0 : !right
    %acc = pto.alloc_tile addr = %addr0 : !acc
    pto.tload ins(%ap : !pto.partition_tensor_view<32x32xf16>) outs(%al1 : !amat)
    pto.tload ins(%bp : !pto.partition_tensor_view<32x32xf16>) outs(%bl1 : !bmat)
    pto.tmov ins(%al1 : !amat) outs(%lhs : !left)
    pto.tmov ins(%bl1 : !bmat) outs(%rhs : !right)
    scf.for %i = %c0 to %c128 step %c1 {
      %row = arith.muli %i, %c32 : index
      %op = pto.partition_view %ov, offsets = [%row, %c0], sizes = [%c32, %c32] : !pto.tensor_view<?x?xf32> -> !out
      pto.tmatmul ins(%lhs, %rhs : !left, !right) outs(%acc : !acc)
        {accPhase = #pto<acc_phase final>}
      pto.tstore ins(%acc : !acc) outs(%op : !out)
        {stPhase = #pto<st_phase final>}
    }
    return
  }
}
