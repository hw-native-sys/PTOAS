  %c25600_index = arith.constant 25600 : index
  %c0_i32 = arith.constant 0 : i32
  %c2_index = arith.constant 2 : index
  %c256_index = arith.constant 256 : index
  %c8_index = arith.constant 8 : index
  %c0_index = arith.constant 0 : index
  %out__iter_v1_view = pto.make_tensor_view %arg0, shape = [%c16_index, %c8192_index], strides = [%c8192_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
  %resid1_tile__rv_v2_view = pto.make_tensor_view %arg1, shape = [%c16_index, %c8192_index], strides = [%c8192_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xf32>
  %mlp_tile__rv_v2_view = pto.make_tensor_view %arg2, shape = [%c16_index, %c25600_index], strides = [%c25600_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
  %w_down__ssa_v0_view = pto.make_tensor_view %arg3, shape = [%c25600_index, %c8192_index], strides = [%c8192_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xbf16>
  %subblock_idx = arith.index_cast %__pypto_spmd_subblock_idx : i32 to index
  %down_proj_residual_c2v_slot_buffer = pto.reserve_buffer {name = "down_proj_residual_c2v_slot_buffer", size = 131072, location = #pto.address_space<vec>, auto = false, base = 0} -> i32
  pto.aiv_initialize_pipe {dir_mask = 1, slot_size = 16384}
      (gm_slot_buffer = %arg4 : !pto.ptr<f32>, c2v_consumer_buf = %down_proj_residual_c2v_slot_buffer : i32, v2c_consumer_buf = %c0_i32 : i32)
  %0 = arith.addi %arg5, %c2_index : index
  scf.for %di__idx_v0 = %arg5 to %0 step %c1_index {
    %1 = arith.muli %di__idx_v0, %c256_index : index
    %resid1_tile_chunk__tile = pto.alloc_tile addr = %c131072_i64 valid_row = %c8_index valid_col = %c256_index : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %2 = arith.muli %subblock_idx, %c8_index : index
    %3 = arith.maxsi %2, %c0_index : index
    %4 = arith.maxsi %1, %c0_index : index
    %resid1_tile__rv_v2_pview = pto.partition_view %resid1_tile__rv_v2_view, offsets = [%3, %4], sizes = [%c8_index, %c256_index] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<8x256xf32>
    pto.tload ins(%resid1_tile__rv_v2_pview : !pto.partition_tensor_view<8x256xf32>) outs(%resid1_tile_chunk__tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    %down_acc__rv_v2_Vec = pto.tpop_from_aic {split = 1} -> !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %out_chunk__tile = pto.alloc_tile addr = %c131072_i64 valid_row = %c8_index valid_col = %c256_index : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tadd ins(%down_acc__rv_v2_Vec, %resid1_tile_chunk__tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%out_chunk__tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tfree_from_aic {split = 1}
    %t__tile = pto.alloc_tile addr = %c131072_i64 valid_row = %c8_index valid_col = %c256_index : !pto.tile_buf<loc=vec, dtype=bf16, rows=8, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tcvt ins(%out_chunk__tile {rmode = #pto<round_mode ROUND>} : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%t__tile : !pto.tile_buf<loc=vec, dtype=bf16, rows=8, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    %5 = arith.muli %subblock_idx, %c8_index : index
    %6 = arith.maxsi %5, %c0_index : index
    %7 = arith.maxsi %1, %c0_index : index
    %out__iter_v3_pview = pto.partition_view %out__iter_v1_view, offsets = [%6, %7], sizes = [%c8_index, %c256_index] : !pto.tensor_view<?x?xbf16> -> !pto.partition_tensor_view<8x256xbf16>
    pto.tstore ins(%t__tile : !pto.tile_buf<loc=vec, dtype=bf16, rows=8, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%out__iter_v3_pview : !pto.partition_tensor_view<8x256xbf16>)
  }
  return
  }
}
