module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @tquant_mx_kernel(%arg0: !pto.ptr<f32, gm>, %arg1: !pto.ptr<i8, gm>,
                              %arg2: !pto.ptr<ui8, gm>, %arg3: !pto.ptr<f32, gm>,
                              %arg4: !pto.ptr<f32, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %c32 = arith.constant 32 : index
    %c512 = arith.constant 512 : index
    %c1024 = arith.constant 1024 : index

    // Canonical axis1 layout: source is [M, N] and grouped auxiliaries are [M, N/32].
    %0 = pto.make_tensor_view %arg0, shape = [%c16, %c1024], strides = [%c1024, %c1] : !pto.tensor_view<?x?xf32>
    %1 = pto.make_tensor_view %arg1, shape = [%c16, %c1024], strides = [%c1024, %c1] : !pto.tensor_view<?x?xi8>
    %2 = pto.make_tensor_view %arg2, shape = [%c16, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xui8>
    %3 = pto.make_tensor_view %arg3, shape = [%c16, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xf32>
    %4 = pto.make_tensor_view %arg4, shape = [%c16, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xf32>

    %6 = pto.partition_view %0, offsets = [%c0, %c0], sizes = [%c16, %c1024] : !pto.tensor_view<?x?xf32>
    %7 = pto.partition_view %1, offsets = [%c0, %c0], sizes = [%c16, %c1024] : !pto.tensor_view<?x?xi8>
    %8 = pto.partition_view %2, offsets = [%c0, %c0], sizes = [%c16, %c32] : !pto.tensor_view<?x?xui8>
    %9 = pto.partition_view %3, offsets = [%c0, %c0], sizes = [%c16, %c32] : !pto.tensor_view<?x?xf32>
    %10 = pto.partition_view %4, offsets = [%c0, %c0], sizes = [%c16, %c32] : !pto.tensor_view<?x?xf32>

    %src = pto.alloc_tile : !pto.tile_buf<vec, 16x1024xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 16x1024xi8>
    // Each grouped row has 32 elements, including byte-wide exponents.
    %exp = pto.alloc_tile : !pto.tile_buf<vec, 16x32xui8>
    %max = pto.alloc_tile : !pto.tile_buf<vec, 16x32xf32>
    %scaling = pto.alloc_tile : !pto.tile_buf<vec, 16x32xf32>

    pto.tload ins(%6 : !pto.partition_tensor_view<16x1024xf32>) outs(%src : !pto.tile_buf<vec, 16x1024xf32>)

    pto.tquant.mx ins(%src : !pto.tile_buf<vec, 16x1024xf32>)
                   outs(%dst, %exp, %max, %scaling : !pto.tile_buf<vec, 16x1024xi8>, !pto.tile_buf<vec, 16x32xui8>, !pto.tile_buf<vec, 16x32xf32>, !pto.tile_buf<vec, 16x32xf32>)
                   {quant_type = #pto<quant_type MXFP8>}


    pto.tstore ins(%dst : !pto.tile_buf<vec, 16x1024xi8>) outs(%7 : !pto.partition_tensor_view<16x1024xi8>)
    pto.tstore ins(%exp : !pto.tile_buf<vec, 16x32xui8>) outs(%8 : !pto.partition_tensor_view<16x32xui8>)
    pto.tstore ins(%max : !pto.tile_buf<vec, 16x32xf32>) outs(%9 : !pto.partition_tensor_view<16x32xf32>)
    pto.tstore ins(%scaling : !pto.tile_buf<vec, 16x32xf32>) outs(%10 : !pto.partition_tensor_view<16x32xf32>)
    return
  }
}
