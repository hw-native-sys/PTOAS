      %my_rank__ssa_v0_idx = arith.index_cast %arg1 : i32 to index
      %5 = arith.maxsi %my_rank__ssa_v0_idx, %c0_index : index
      %combine_arrived__ssa_v0_peer_pview = pto.partition_view %4, offsets = [%5, %c0_index], sizes = [%c1_index, %c1_index] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x1xi32>
      pto.barrier <PIPE_ALL>
      pto.comm.tnotify(%combine_arrived__ssa_v0_peer_pview, %c1_i32 : !pto.partition_tensor_view<1x1xi32>, i32) {notifyOp = #pto<notify_op atomic_add>}
    }
  }
  scf.for %src_inline3232__idx_v0 = %c0_index to %c2_index step %c1_index {
