  func.func @combine_wait(%arg0: !pto.ptr<i32>, %arg1: i32, %arg2: !pto.ptr<i64>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  %c2_index = arith.constant 2 : index
  %c1_index = arith.constant 1 : index
  %c0_index = arith.constant 0 : index
  %c1_i32 = arith.constant 1 : i32
  %combine_arrived__ssa_v0_view = pto.make_tensor_view %arg0, shape = [%c2_index, %c1_index], strides = [%c1_index, %c2_index] {layout = #pto.layout<dn>} : !pto.tensor_view<?x?xi32>
  scf.for %peer_inline3240__idx_v0 = %c0_index to %c2_index step %c1_index {
    %0 = arith.index_cast %arg1 : i32 to index
    %1 = arith.cmpi ne, %peer_inline3240__idx_v0, %0 : index
