// End-to-end form of issue #1745: GM -> L1 -> L0, same-mode
// TMATMUL/TMATMUL_ACC, then FIX -> GM. One cube core owns the output.
!ma = !pto.tile_buf<loc=mat, dtype=f32, rows=80, cols=64, v_row=80, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=1>
!mb = !pto.tile_buf<loc=mat, dtype=f32, rows=64, cols=32, v_row=64, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=1>
!a = !pto.tile_buf<loc=left, dtype=f32, rows=80, cols=64, v_row=80, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=1>
!b = !pto.tile_buf<loc=right, dtype=f32, rows=64, cols=32, v_row=64, v_col=32, blayout=row_major, slayout=col_major, fractal=512, pad=0, compact=1>
!c = !pto.tile_buf<loc=acc, dtype=f32, rows=80, cols=32, v_row=80, v_col=32, blayout=col_major, slayout=row_major, fractal=1024, pad=0, compact=1>
module attributes {pto.target_arch = "a5"} {
  func.func @issue1745_tf32(%out: !pto.ptr<f32>, %lhs: !pto.ptr<f32>, %rhs: !pto.ptr<f32>) {
    %z = arith.constant 0 : index
    %one = arith.constant 1 : index
    %m = arith.constant 80 : index
    %k = arith.constant 64 : index
    %n = arith.constant 32 : index
    %av = pto.make_tensor_view %lhs, shape = [%m, %k], strides = [%k, %one] : !pto.tensor_view<?x?xf32>
    %bv = pto.make_tensor_view %rhs, shape = [%k, %n], strides = [%n, %one] : !pto.tensor_view<?x?xf32>
    %cv = pto.make_tensor_view %out, shape = [%m, %n], strides = [%n, %one] : !pto.tensor_view<?x?xf32>
    %ap = pto.partition_view %av, offsets = [%z, %z], sizes = [%m, %k] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<80x64xf32>
    %bp = pto.partition_view %bv, offsets = [%z, %z], sizes = [%k, %n] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<64x32xf32>
    %cp = pto.partition_view %cv, offsets = [%z, %z], sizes = [%m, %n] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<80x32xf32>
    %ma = pto.alloc_tile : !ma
    %mb = pto.alloc_tile : !mb
    %a = pto.alloc_tile : !a
    %b = pto.alloc_tile : !b
    %c = pto.alloc_tile : !c
    pto.tload ins(%ap : !pto.partition_tensor_view<80x64xf32>) outs(%ma : !ma)
    pto.tload ins(%bp : !pto.partition_tensor_view<64x32xf32>) outs(%mb : !mb)
    pto.tmov ins(%ma : !ma) outs(%a : !a)
    pto.tmov ins(%mb : !mb) outs(%b : !b)
    pto.tmatmul ins(%a, %b : !a, !b) outs(%c : !c) {tf32_mode = #pto<tf32_mode round_away>}
    pto.tmatmul.acc ins(%c, %a, %b : !c, !a, !b) outs(%c : !c) {tf32_mode = #pto<tf32_mode round_away>}
    pto.tstore ins(%c : !c) outs(%cp : !pto.partition_tensor_view<80x32xf32>)
    return
  }
}
