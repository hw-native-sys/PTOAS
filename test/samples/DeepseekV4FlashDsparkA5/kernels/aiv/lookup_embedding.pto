  func.func @lookup_embedding(%arg0: !pto.ptr<bf16>, %arg1: !pto.ptr<i64>, %arg2: !pto.ptr<bf16>, %arg3: index, %arg4: index, %arg5: index, %__pypto_spmd_block_idx: i32, %__pypto_spmd_block_num: i32) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
