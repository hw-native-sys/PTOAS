    %0 = arith.divsi %work_idx_inline7__idx_v0, %c8_index : index
    %1 = arith.remsi %work_idx_inline7__idx_v0, %c8_index : index
    %2 = arith.muli %1, %c512_index : index
    %token_id_inline0__tile = pto.load_scalar %arg1[%0] : !pto.ptr<i64> -> i64
