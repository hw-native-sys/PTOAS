module attributes {pto.target_arch = "a5"} {
  func.func @prefill_idx_topk_copy(%arg0: !pto.ptr<i32>, %arg1: !pto.ptr<i32>, %__pypto_spmd_block_idx: i32, %__pypto_spmd_block_num: i32) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  %c0_i64 = arith.constant 0 : i64
  %c128_index = arith.constant 128 : index
  %c256_index = arith.constant 256 : index
  %c1_index = arith.constant 1 : index
  %c512_index = arith.constant 512 : index
  %c4_index = arith.constant 4 : index
  %c0_index = arith.constant 0 : index
  %topk_idxs__ssa_v0_view = pto.make_tensor_view %arg0, shape = [%c128_index, %c256_index], strides = [%c256_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xi32>
  %cmp_topk_indices__rv_v2_view = pto.make_tensor_view %arg1, shape = [%c128_index, %c512_index], strides = [%c512_index, %c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?x?xi32>
  %tb__ssa_v0 = arith.index_cast %__pypto_spmd_block_idx : i32 to index
  %0 = arith.muli %tb__ssa_v0, %c4_index : index
  scf.for %ti__idx_v0 = %c0_index to %c4_index step %c1_index {
    %1 = arith.addi %0, %ti__idx_v0 : index
    %t__tile = pto.alloc_tile addr = %c0_i64 valid_row = %c1_index valid_col = %c256_index : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %2 = arith.maxsi %1, %c0_index : index
    %cmp_topk_indices__rv_v2_pview = pto.partition_view %cmp_topk_indices__rv_v2_view, offsets = [%2, %c0_index], sizes = [%c1_index, %c256_index] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x256xi32>
    pto.tload ins(%cmp_topk_indices__rv_v2_pview : !pto.partition_tensor_view<1x256xi32>) outs(%t__tile : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    %3 = arith.maxsi %1, %c0_index : index
    %topk_idxs__iter_v1_pview = pto.partition_view %topk_idxs__ssa_v0_view, offsets = [%3, %c0_index], sizes = [%c1_index, %c256_index] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x256xi32>
    pto.tstore ins(%t__tile : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%topk_idxs__iter_v1_pview : !pto.partition_tensor_view<1x256xi32>)
  }
  return
  }
}
