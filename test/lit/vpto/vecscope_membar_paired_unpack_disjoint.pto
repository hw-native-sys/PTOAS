// RUN: pto-test-opt --pto-insert-vecscope-membar %s | FileCheck %s
// RUN: pto-test-opt --pto-insert-vecscope-membar --pto-insert-vecscope-membar %s | FileCheck %s

!mb16 = !pto.mask<b16>
!mb32 = !pto.mask<b32>
!pbf16ub = !pto.ptr<bf16, ub>
!pf32ub = !pto.ptr<f32, ub>
!v128xbf16 = !pto.vreg<128xbf16>
!v64xf32 = !pto.vreg<64xf32>

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {

// CHECK-LABEL: func.func @paired_disjoint(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @paired_disjoint(%n: index) {
    %z = arith.constant 0 : i64
    %p = pto.castptr %z : i64 -> !pf32ub
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c3 = arith.constant 3 : index
    %c128 = arith.constant 128 : index
    %c1024 = arith.constant 1024 : index
    %src = pto.addptr %p, %c0 : !pto.ptr<f32, ub>, index -> !pto.ptr<f32, ub>
    %dst = pto.addptr %p, %c1024 : !pto.ptr<f32, ub>, index -> !pto.ptr<f32, ub>
    %bound = arith.minui %n, %c3 : index
    pto.vecscope {
      %m = pto.pset_b32 "PAT_ALL" : !mb32
      scf.for %i = %c0 to %bound step %c1 {
        %io = arith.muli %i, %c128 : index
        %v, %hi = pto.vldsx2 %src[%io], "DINTLV_B32" : !pf32ub, index -> !v64xf32, !v64xf32
        pto.vsts %v, %dst[%io], %m : !v64xf32, !pf32ub, index, !mb32
      }
    }
    return
  }

// CHECK-LABEL: func.func @paired_real_overlap_war(
// CHECK: pto.vldsx2
// CHECK-NEXT: pto.mem_bar "VLD_VST"
// CHECK-NEXT: pto.vsts
// CHECK-NOT: pto.mem_bar
// CHECK: return
  func.func @paired_real_overlap_war(%n: index, %w: !v64xf32) {
    %z = arith.constant 0 : i64
    %p = pto.castptr %z : i64 -> !pf32ub
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c3 = arith.constant 3 : index
    %c64 = arith.constant 64 : index
    %c128 = arith.constant 128 : index
    %bound = arith.minui %n, %c3 : index
    pto.vecscope {
      %m = pto.pset_b32 "PAT_ALL" : !mb32
      scf.for %i = %c0 to %bound step %c1 {
        %io = arith.muli %i, %c128 : index
        %io2 = arith.addi %io, %c64 : index
        %v, %hi = pto.vldsx2 %p[%io], "DINTLV_B32" : !pf32ub, index -> !v64xf32, !v64xf32
        pto.vsts %w, %p[%io2], %m : !v64xf32, !pf32ub, index, !mb32
      }
    }
    return
  }

// CHECK-LABEL: func.func @unpack_adjacent_chunks(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @unpack_adjacent_chunks() {
    %z = arith.constant 0 : i64
    %p = pto.castptr %z : i64 -> !pbf16ub
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    pto.vecscope {
      %m = pto.pset_b32 "PAT_ALL" : !mb32
      scf.for %i = %c0 to %c2 step %c1 {
        %o = arith.muli %i, %c64 : index
        %v = pto.vlds %p[%o] {dist = "UNPK_B16"} : !pbf16ub, index -> !v128xbf16
        pto.vsts %v, %p[%o], %m {dist = "PK_B32"} : !v128xbf16, !pbf16ub, index, !mb32
      }
    }
    return
  }

// CHECK-LABEL: func.func @unpack_real_overlap_war(
// CHECK: pto.vlds
// CHECK-NEXT: pto.mem_bar "VLD_VST"
// CHECK-NEXT: pto.vsts
// CHECK-NOT: pto.mem_bar
// CHECK: return
  func.func @unpack_real_overlap_war() {
    %z = arith.constant 0 : i64
    %p = pto.castptr %z : i64 -> !pbf16ub
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c64 = arith.constant 64 : index
    %f = arith.constant 0.0 : bf16
    pto.vecscope {
      %m = pto.pset_b32 "PAT_ALL" : !mb32
      %m16 = pto.pset_b16 "PAT_ALL" : !mb16
      %w = pto.vdup %f, %m16 : bf16, !mb16 -> !v128xbf16
      scf.for %i = %c0 to %c4 step %c1 {
        %o = arith.muli %i, %c64 : index
        %v = pto.vlds %p[%o] {dist = "UNPK_B16"} : !pbf16ub, index -> !v128xbf16
        pto.vsts %w, %p[%o], %m {dist = "PK_B32"} : !v128xbf16, !pbf16ub, index, !mb32
      }
    }
    return
  }

// CHECK-LABEL: func.func @unpack_real_carried_overlap(
// CHECK: scf.for
// CHECK: pto.vlds
// CHECK-NEXT: pto.mem_bar "VLD_VST"
// CHECK-NEXT: pto.vsts
// CHECK-NEXT: pto.mem_bar "VV_ALL"
// CHECK-NOT: pto.mem_bar
// CHECK: return
  func.func @unpack_real_carried_overlap() {
    %z = arith.constant 0 : i64
    %p = pto.castptr %z : i64 -> !pbf16ub
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c32 = arith.constant 32 : index
    %f = arith.constant 0.0 : bf16
    pto.vecscope {
      %m = pto.pset_b32 "PAT_ALL" : !mb32
      %m16 = pto.pset_b16 "PAT_ALL" : !mb16
      %w = pto.vdup %f, %m16 : bf16, !mb16 -> !v128xbf16
      scf.for %i = %c0 to %c4 step %c1 {
        %o = arith.muli %i, %c32 : index
        %v = pto.vlds %p[%o] {dist = "UNPK_B16"} : !pbf16ub, index -> !v128xbf16
        pto.vsts %w, %p[%o], %m {dist = "PK_B32"} : !v128xbf16, !pbf16ub, index, !mb32
      }
    }
    return
  }
}
