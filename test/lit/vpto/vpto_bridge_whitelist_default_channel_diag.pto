// Policy YAML is routing-only. Legacy ABI and lowering fields are rejected
// before family lowering can consume them.

// RUN: not pto-test-opt %s "-pto-lower-pipe-family-ops=whitelist-path=%S/Inputs/vpto-bridge-whitelist-missing-custom-tag.yaml" 2>&1 | FileCheck %s --check-prefix=ABI
// RUN: not pto-test-opt %s "-pto-lower-pipe-family-ops=whitelist-path=%S/Inputs/vpto-bridge-whitelist-legacy-family-lowering.yaml" 2>&1 | FileCheck %s --check-prefix=ENTRY

// ABI: VPTO bridge policy: legacy key 'bridge_ops' is not allowed
// ABI-SAME: policy YAML only selects routed families and ops
// ENTRY: VPTO bridge policy: legacy key 'bridge_ops' is not allowed

module {
  func.func private @default_channel_diag(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %pipe = pto.initialize_l2l_pipe{dir_mask = 1, slot_size = 1024, slot_num = 8, flag_base = 0, nosplit = false} (%addr : i32) -> !pto.pipe
    pto.tfree(%pipe : !pto.pipe) {split = 1}
    return
  }
}
