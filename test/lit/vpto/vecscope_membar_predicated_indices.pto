// RUN: pto-test-opt --pto-insert-vecscope-membar %s | FileCheck %s
// RUN: pto-test-opt --pto-insert-vecscope-membar --pto-insert-vecscope-membar %s | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar=true %s | FileCheck %s

!p = !pto.ptr<f32, ub>
!v = !pto.vreg<64xf32>
!s = !pto.vreg<64xsi32>
!u = !pto.vreg<64xui32>
!m = !pto.mask<b32>
!p16 = !pto.ptr<f16, ub>
!v16 = !pto.vreg<128xf16>
!s16 = !pto.vreg<128xsi16>
!u16 = !pto.vreg<128xui16>
!m16 = !pto.mask<b16>
module attributes {pto.target_arch = "a5"} {
// CHECK-LABEL: func.func @bounded_gather(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
func.func @bounded_gather(%p: !p, %idx: !s, %data: !v) {
  %adjacent = arith.constant 256 : index
  %out = arith.constant 1024 : index
  %zero = arith.constant 0 : i32
  %limit = arith.constant 256 : i32
  pto.vecscope {
    %all = pto.pset_b32 "PAT_ALL" : !m
    %zv = pto.vdup %zero, %all : i32, !m -> !s
    %bound = pto.vdup %limit, %all : i32, !m -> !s
    %ge = pto.vcmp %idx, %zv, %all, "ge" : !s, !s, !m -> !m
    %lt = pto.vcmp %idx, %bound, %all, "lt" : !s, !s, !m -> !m
    %valid = pto.pand %ge, %lt, %all : !m, !m, !m -> !m
    %ui = pto.vbitcast %idx : !s -> !u
    pto.vsts %data, %p[%adjacent], %all : !v, !p, index, !m
    %v = pto.vgather2_bc %p, %ui, %valid : !p, !u, !m -> !v
    pto.vsts %v, %p[%out], %all : !v, !p, index, !m
  }
  return
}

// CHECK-LABEL: func.func @bounded_gather16(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
func.func @bounded_gather16(%p: !p16, %idx: !s16, %data: !v16) {
  %adjacent = arith.constant 256 : index
  %out = arith.constant 1024 : index
  %zero = arith.constant 0 : i16
  %limit = arith.constant 256 : i16
  pto.vecscope {
    %all = pto.pset_b16 "PAT_ALL" : !m16
    %zv = pto.vdup %zero, %all : i16, !m16 -> !s16
    %bound = pto.vdup %limit, %all : i16, !m16 -> !s16
    %ge = pto.vcmp %idx, %zv, %all, "ge" : !s16, !s16, !m16 -> !m16
    %lt = pto.vcmp %idx, %bound, %all, "lt" : !s16, !s16, !m16 -> !m16
    %valid = pto.pand %ge, %lt, %all : !m16, !m16, !m16 -> !m16
    %ui = pto.vbitcast %idx : !s16 -> !u16
    pto.vsts %data, %p[%adjacent], %all : !v16, !p16, index, !m16
    %v = pto.vgather2 %p, %ui, %valid : !p16, !u16, !m16 -> !v16
    pto.vsts %v, %p[%out], %all : !v16, !p16, index, !m16
  }
  return
}

// CHECK-LABEL: func.func @bounded_score_offsets(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
func.func @bounded_score_offsets(%p: !p, %idx: !s, %data: !v) {
  %z = arith.constant 513 : index
  %out = arith.constant 1024 : index
  %zero = arith.constant 0 : i32
  %limit = arith.constant 256 : i32
  pto.vecscope {
    %all = pto.pset_b32 "PAT_ALL" : !m
    %zv = pto.vdup %zero, %all : i32, !m -> !s
    %bound = pto.vdup %limit, %all : i32, !m -> !s
    %ge = pto.vcmp %idx, %zv, %all, "ge" : !s, !s, !m -> !m
    %lt = pto.vcmp %idx, %bound, %all, "lt" : !s, !s, !m -> !m
    %valid = pto.pand %ge, %lt, %all : !m, !m, !m -> !m
    %ui = pto.vbitcast %idx : !s -> !u
    %kii = arith.constant 2 : i32
    %ki = builtin.unrealized_conversion_cast %kii : i32 to ui32
    %kv = pto.vdup %ki, %all : ui32, !m -> !u
    %product = pto.vmul %ui, %kv, %all : !u, !u, !m -> !u
    %offset = pto.vadd %product, %kv, %all : !u, !u, !m -> !u
    pto.vsts %data, %p[%z], %all : !v, !p, index, !m
    %v = pto.vgather2_bc %p, %offset, %valid : !p, !u, !m -> !v
    pto.vsts %v, %p[%out], %all : !v, !p, index, !m
  }
  return
}

// CHECK-LABEL: func.func @real_overlap(
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: return
func.func @real_overlap(%p: !p, %idx: !s, %data: !v) {
  %z = arith.constant 0 : index
  %out = arith.constant 1024 : index
  %zero = arith.constant 0 : i32
  %limit = arith.constant 256 : i32
  pto.vecscope {
    %all = pto.pset_b32 "PAT_ALL" : !m
    %zv = pto.vdup %zero, %all : i32, !m -> !s
    %bound = pto.vdup %limit, %all : i32, !m -> !s
    %ge = pto.vcmp %idx, %zv, %all, "ge" : !s, !s, !m -> !m
    %lt = pto.vcmp %idx, %bound, %all, "lt" : !s, !s, !m -> !m
    %valid = pto.pand %ge, %lt, %all : !m, !m, !m -> !m
    %ui = pto.vbitcast %idx : !s -> !u
    pto.vsts %data, %p[%z], %all : !v, !p, index, !m
    %v = pto.vgather2_bc %p, %ui, %valid : !p, !u, !m -> !v
    pto.vsts %v, %p[%out], %all : !v, !p, index, !m
  }
  return
}

