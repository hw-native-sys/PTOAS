// CHECK-LABEL: func.func @or_is_not_conjunction(
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: return
func.func @or_is_not_conjunction(%p: !p, %idx: !s, %data: !v) {
  %adjacent = arith.constant 256 : index
  %out = arith.constant 1024 : index
  %zero = arith.constant 0 : i32
  %limit = arith.constant 256 : i32
  pto.vecscope {
    %all = pto.pset_b32 "PAT_ALL" : !m
    %zv = pto.vdup %zero, %all : i32, !m -> !s
    %bound = pto.vdup %limit, %all : i32, !m -> !s
    %ge = pto.vcmp %idx, %zv, %all, "ge" : !s, !s, !m -> !m
    %lt = pto.vcmp %idx, %bound, %all, "lt" : !s, !s, !m -> !m
    %valid = pto.por %ge, %lt, %all : !m, !m, !m -> !m
    %ui = pto.vbitcast %idx : !s -> !u
    pto.vsts %data, %p[%adjacent], %all : !v, !p, index, !m
    %v = pto.vgather2_bc %p, %ui, %valid : !p, !u, !m -> !v
    pto.vsts %v, %p[%out], %all : !v, !p, index, !m
  }
  return
}

// CHECK-LABEL: func.func @partial_comparison(
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: return
func.func @partial_comparison(%p: !p, %idx: !s, %data: !v) {
  %adjacent = arith.constant 256 : index
  %out = arith.constant 1024 : index
  %zero = arith.constant 0 : i32
  %limit = arith.constant 256 : i32
  pto.vecscope {
    %all = pto.pset_b32 "PAT_ALL" : !m
    %one = pto.pset_b32 "PAT_VL1" : !m
    %zv = pto.vdup %zero, %all : i32, !m -> !s
    %bound = pto.vdup %limit, %all : i32, !m -> !s
    %ge = pto.vcmp %idx, %zv, %one, "ge" : !s, !s, !m -> !m
    %lt = pto.vcmp %idx, %bound, %one, "lt" : !s, !s, !m -> !m
    %valid = pto.pand %ge, %lt, %all : !m, !m, !m -> !m
    %ui = pto.vbitcast %idx : !s -> !u
    pto.vsts %data, %p[%adjacent], %all : !v, !p, index, !m
    %v = pto.vgather2_bc %p, %ui, %valid : !p, !u, !m -> !v
    pto.vsts %v, %p[%out], %all : !v, !p, index, !m
  }
  return
}

// CHECK-LABEL: func.func @wrapping_add(
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: return
func.func @wrapping_add(%p: !p, %idx: !s, %data: !v) {
  %adjacent = arith.constant 256 : index
  %out = arith.constant 1024 : index
  %zero = arith.constant 0 : i32
  %limit = arith.constant 256 : i32
  pto.vecscope {
    %all = pto.pset_b32 "PAT_ALL" : !m
    %zv = pto.vdup %zero, %all : i32, !m -> !s
    %bound = pto.vdup %limit, %all : i32, !m -> !s
    %ge = pto.vcmp %idx, %zv, %all, "ge" : !s, !s, !m -> !m
    %lt = pto.vcmp %idx, %bound, %all, "lt" : !s, !s, !m -> !m
    %valid = pto.pand %ge, %lt, %all : !m, !m, !m -> !m
    %ui = pto.vbitcast %idx : !s -> !u
    %kii = arith.constant 4294967168 : i32
    %ki = builtin.unrealized_conversion_cast %kii : i32 to ui32
    %kv = pto.vdup %ki, %all : ui32, !m -> !u
    %offset = pto.vadd %ui, %kv, %all : !u, !u, !m -> !u
    pto.vsts %data, %p[%adjacent], %all : !v, !p, index, !m
    %v = pto.vgather2_bc %p, %offset, %valid : !p, !u, !m -> !v
    pto.vsts %v, %p[%out], %all : !v, !p, index, !m
  }
  return
}

// CHECK-LABEL: func.func @independent_war(
// CHECK: pto.mem_bar "VLD_VST"
// CHECK: return
func.func @independent_war(%p: !p, %idx: !s, %data: !v) {
  %out = arith.constant 1024 : index
  %zero = arith.constant 0 : i32
  %limit = arith.constant 256 : i32
  pto.vecscope {
    %all = pto.pset_b32 "PAT_ALL" : !m
    %zv = pto.vdup %zero, %all : i32, !m -> !s
    %bound = pto.vdup %limit, %all : i32, !m -> !s
    %ge = pto.vcmp %idx, %zv, %all, "ge" : !s, !s, !m -> !m
    %lt = pto.vcmp %idx, %bound, %all, "lt" : !s, !s, !m -> !m
    %valid = pto.pand %ge, %lt, %all : !m, !m, !m -> !m
    %ui = pto.vbitcast %idx : !s -> !u
    %v = pto.vgather2_bc %p, %ui, %valid : !p, !u, !m -> !v
    pto.vscatter %data, %p, %ui, %valid : !v, !p, !u, !m
    pto.vsts %v, %p[%out], %all : !v, !p, index, !m
  }
  return
}

// CHECK-LABEL: func.func @dependent_war(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
func.func @dependent_war(%p: !p, %idx: !s, %data: !v) {
  %out = arith.constant 1024 : index
  %zero = arith.constant 0 : i32
  %limit = arith.constant 256 : i32
  pto.vecscope {
    %all = pto.pset_b32 "PAT_ALL" : !m
    %zv = pto.vdup %zero, %all : i32, !m -> !s
    %bound = pto.vdup %limit, %all : i32, !m -> !s
    %ge = pto.vcmp %idx, %zv, %all, "ge" : !s, !s, !m -> !m
    %lt = pto.vcmp %idx, %bound, %all, "lt" : !s, !s, !m -> !m
    %valid = pto.pand %ge, %lt, %all : !m, !m, !m -> !m
    %ui = pto.vbitcast %idx : !s -> !u
    %v = pto.vgather2_bc %p, %ui, %valid : !p, !u, !m -> !v
    pto.vscatter %v, %p, %ui, %valid : !v, !p, !u, !m
    pto.vsts %v, %p[%out], %all : !v, !p, index, !m
  }
  return
}

// CHECK-LABEL: func.func @carried_disjoint(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
func.func @carried_disjoint(%p: !p, %idx: !s, %data: !v) {
  %z = arith.constant 0 : index
  %zero = arith.constant 0 : i32
  %limit = arith.constant 256 : i32
  pto.vecscope {
    %all = pto.pset_b32 "PAT_ALL" : !m
    %zv = pto.vdup %zero, %all : i32, !m -> !s
    %bound = pto.vdup %limit, %all : i32, !m -> !s
    %ge = pto.vcmp %idx, %zv, %all, "ge" : !s, !s, !m -> !m
    %lt = pto.vcmp %idx, %bound, %all, "lt" : !s, !s, !m -> !m
    %valid = pto.pand %ge, %lt, %all : !m, !m, !m -> !m
    %ui = pto.vbitcast %idx : !s -> !u
    %two = arith.constant 2 : index
    %step = arith.constant 1 : index
    %stride = arith.constant 256 : index
    scf.for %i = %z to %two step %step {
      %shift = arith.muli %i, %stride : index
      %base = pto.addptr %p, %shift : !pto.ptr<f32, ub>, index -> !pto.ptr<f32, ub>
      pto.vscatter %data, %base, %ui, %valid : !v, !p, !u, !m
    }
  }
  return
}

// CHECK-LABEL: func.func @carried_overlap(
// CHECK: pto.mem_bar "VST_VST"
// CHECK: return
func.func @carried_overlap(%p: !p, %idx: !s, %data: !v) {
  %z = arith.constant 0 : index
  %zero = arith.constant 0 : i32
  %limit = arith.constant 256 : i32
  pto.vecscope {
    %all = pto.pset_b32 "PAT_ALL" : !m
    %zv = pto.vdup %zero, %all : i32, !m -> !s
    %bound = pto.vdup %limit, %all : i32, !m -> !s
    %ge = pto.vcmp %idx, %zv, %all, "ge" : !s, !s, !m -> !m
    %lt = pto.vcmp %idx, %bound, %all, "lt" : !s, !s, !m -> !m
    %valid = pto.pand %ge, %lt, %all : !m, !m, !m -> !m
    %ui = pto.vbitcast %idx : !s -> !u
    %two = arith.constant 2 : index
    %step = arith.constant 1 : index
    %stride = arith.constant 128 : index
    scf.for %i = %z to %two step %step {
      %shift = arith.muli %i, %stride : index
      %base = pto.addptr %p, %shift : !pto.ptr<f32, ub>, index -> !pto.ptr<f32, ub>
      pto.vscatter %data, %base, %ui, %valid : !v, !p, !u, !m
    }
  }
  return
}
}
