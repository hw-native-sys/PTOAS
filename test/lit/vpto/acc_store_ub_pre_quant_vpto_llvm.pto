// End-to-end coverage for pto.mte_l0c_ub pre_quant destinations: wrapper
// round-trip, wrapper expansion, and the LLVM FIX.L0C.TO.UB intrinsic selected
// per destination element type. All probes live in one kernel so their op
// order is stable across pipeline dumps. Append a new mte_l0c_ub probe and its
// CHECK lines here when the emitter gains another destination family (fp8,
// i32, i8, ...).

// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --mlir-print-ir-before=vpto-expand-wrapper-ops %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=ROUNDTRIP
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --mlir-print-ir-after=vpto-expand-wrapper-ops %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=EXPAND
// RUN: ( mkdir -p %T && ptoas --pto-arch=a5 --pto-backend=vpto %s -o %t --mlir-print-ir-after=convert-func-to-llvm 2>&1 || true ) | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @ub_pre_quant_probes(%src: !pto.ptr<f32, l0c>,
                                 %dst_bf16: !pto.ptr<bf16, ub>,
                                 %dst_f16: !pto.ptr<f16, ub>,
                                 %dst_f32: !pto.ptr<f32, ub>,
                                 %scale: !pto.ptr<f32, scaling>) attributes {pto.kernel} {
    %c0_i64 = arith.constant 0 : i64
    %c16_i64 = arith.constant 16 : i64
    %c32_i64 = arith.constant 32 : i64
    %c1_bf16 = arith.constant 1.000000e+00 : bf16

    // Scalar pre_quant, f32 accumulator -> bf16 destination (#1588).
    pto.mte_l0c_ub %src, %dst_bf16, %c16_i64, %c16_i64, %c16_i64, %c32_i64, dst_mode(%c0_i64),
      pre_quant(%c1_bf16, mode = f32_bf16),
      nz2nd
      : !pto.ptr<f32, l0c>, !pto.ptr<bf16, ub>, i64, i64, i64, i64, i64,
        bf16

    // Vector pre_quant, f32 accumulator -> f16 destination.
    pto.mte_l0c_ub %src, %dst_f16, %c16_i64, %c16_i64, %c16_i64, %c32_i64, dst_mode(%c0_i64),
      pre_quant(%scale, mode = qf322f16_pre_vec),
      nz2nd
      : !pto.ptr<f32, l0c>, !pto.ptr<f16, ub>, i64, i64, i64, i64, i64,
        !pto.ptr<f32, scaling>

    // Vector pre_quant, f32 accumulator -> f32 destination.
    pto.mte_l0c_ub %src, %dst_f32, %c16_i64, %c16_i64, %c16_i64, %c32_i64, dst_mode(%c0_i64),
      pre_quant(%scale, mode = qf322f32_pre_vec),
      nz2nd
      : !pto.ptr<f32, l0c>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64,
        !pto.ptr<f32, scaling>

    // Vector pre_quant, f32 accumulator -> bf16 destination.
    pto.mte_l0c_ub %src, %dst_bf16, %c16_i64, %c16_i64, %c16_i64, %c32_i64, dst_mode(%c0_i64),
      pre_quant(%scale, mode = qf322bf16_pre_vec),
      nz2nd
      : !pto.ptr<f32, l0c>, !pto.ptr<bf16, ub>, i64, i64, i64, i64, i64,
        !pto.ptr<f32, scaling>
    return
  }
}

// ROUNDTRIP-LABEL: func.func @ub_pre_quant_probes(
// ROUNDTRIP: pre_quant(%{{.*}}, mode = f32_bf16)
// ROUNDTRIP: pre_quant(%{{.*}}, mode = qf322f16_pre_vec)
// ROUNDTRIP: pre_quant(%{{.*}}, mode = qf322f32_pre_vec)
// ROUNDTRIP: pre_quant(%{{.*}}, mode = qf322bf16_pre_vec)

// EXPAND-LABEL: func.func @ub_pre_quant_probes(
// EXPAND: pto.set_quant_pre
// EXPAND: pto.copy_matrix_cc_to_ub
// EXPAND: pto.set_fpc
// EXPAND: pto.copy_matrix_cc_to_ub
// EXPAND: pto.set_fpc
// EXPAND: pto.copy_matrix_cc_to_ub
// EXPAND: pto.set_fpc
// EXPAND: pto.copy_matrix_cc_to_ub

// CHECK-LABEL: llvm.func @ub_pre_quant_probes_mix_aic
// CHECK: llvm.call @llvm.hivm.FIX.L0C.TO.UB.f322bf16.EXT
// CHECK: llvm.call @llvm.hivm.FIX.L0C.TO.UB.f322f16.EXT
// CHECK: llvm.call @llvm.hivm.FIX.L0C.TO.UB.f32.EXT
// CHECK: llvm.call @llvm.hivm.FIX.L0C.TO.UB.f322bf16.EXT
