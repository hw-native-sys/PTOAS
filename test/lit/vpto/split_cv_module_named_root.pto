// A named source module must keep its identity on the outer wrapper while
// vector and cube children become anonymous sibling modules.
// RUN: pto-test-opt --vpto-split-cv-module %s | FileCheck %s

module @top_sym attributes {pto.target_arch = "a5"} {
  func.func @kernel_fn(%arg0: i32) attributes {pto.kernel} {
    pto.section.vector {
      pto.sync.set <PIPE_V>, 0
    }
    pto.section.cube {
      pto.sync.set <PIPE_MTE1>, 0
    }
    return
  }
}

// CHECK: module @top_sym attributes {pto.target_arch = "a5"} {
// CHECK-NEXT: module attributes {{.*}}pto.kernel_kind = #pto.kernel_kind<vector>
// CHECK-NEXT: func.func @kernel_fn
// CHECK: pto.sync.set <PIPE_V>, 0
// CHECK: module attributes {{.*}}pto.kernel_kind = #pto.kernel_kind<cube>
// CHECK-NEXT: func.func @kernel_fn
// CHECK: pto.sync.set <PIPE_MTE1>, 0
