// RUN: pto-test-opt --pto-insert-vecscope-membar %s | FileCheck %s
// RUN: pto-test-opt --pto-insert-vecscope-membar --pto-insert-vecscope-membar %s | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar=true %s | FileCheck %s

!p = !pto.ptr<f32, ub>
!v = !pto.vreg<64xf32>
!m = !pto.mask<b32>
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
// CHECK-LABEL: func.func @conditional_increment(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
func.func @conditional_increment(%condition: i1, %n: index, %data: !v) {
  %z64 = arith.constant 0 : i64
  %p = pto.castptr %z64 : i64 -> !p
  %z = arith.constant 0 : index
  %one = arith.constant 1 : index
  %limit = arith.constant 4 : index
  %init = arith.constant 0 : i16
  %step = arith.constant 1 : i16
  %sink_base = arith.constant 8192 : index
  %stride = arith.constant 64 : index
  %dst = arith.constant 384 : index
  pto.vecscope {
    %m = pto.pset_b32 "PAT_ALL" : !m
    scf.for %i = %z to %limit step %one iter_args(%row = %init) -> (i16) {
      %next = scf.if %condition -> (i16) {
        %inc = arith.addi %row, %step : i16
        scf.yield %inc : i16
      } else {
        scf.yield %row : i16
      }
      %rowidx = arith.index_cast %next : i16 to index
      %offset = arith.muli %rowidx, %stride : index
      %loaded = pto.vlds %p[%offset] : !p, index -> !v
      %column = arith.muli %i, %stride : index
      %sink = arith.addi %sink_base, %column : index
      pto.vsts %loaded, %p[%sink], %m : !v, !p, index, !m
      scf.yield %next : i16
    }
    pto.vsts %data, %p[%dst], %m : !v, !p, index, !m
  }
  return
}
// CHECK-LABEL: func.func @recurrence_real_overlap(
// CHECK: pto.mem_bar
// CHECK: return
func.func @recurrence_real_overlap(%condition: i1, %n: index, %data: !v) {
  %z64 = arith.constant 0 : i64
  %p = pto.castptr %z64 : i64 -> !p
  %z = arith.constant 0 : index
  %one = arith.constant 1 : index
  %limit = arith.constant 4 : index
  %init = arith.constant 0 : i16
  %step = arith.constant 1 : i16
  %sink_base = arith.constant 8192 : index
  %stride = arith.constant 64 : index
  %dst = arith.constant 128 : index
  pto.vecscope {
    %m = pto.pset_b32 "PAT_ALL" : !m
    scf.for %i = %z to %limit step %one iter_args(%row = %init) -> (i16) {
      %next = scf.if %condition -> (i16) {
        %inc = arith.addi %row, %step : i16
        scf.yield %inc : i16
      } else {
        scf.yield %row : i16
      }
      %rowidx = arith.index_cast %next : i16 to index
      %offset = arith.muli %rowidx, %stride : index
      %loaded = pto.vlds %p[%offset] : !p, index -> !v
      %column = arith.muli %i, %stride : index
      %sink = arith.addi %sink_base, %column : index
      pto.vsts %loaded, %p[%sink], %m : !v, !p, index, !m
      scf.yield %next : i16
    }
    pto.vsts %data, %p[%dst], %m : !v, !p, index, !m
  }
  return
}
// CHECK-LABEL: func.func @recurrence_wrap_rejected(
// CHECK: pto.mem_bar
// CHECK: return
func.func @recurrence_wrap_rejected(%condition: i1, %n: index, %data: !v) {
  %z64 = arith.constant 0 : i64
  %p = pto.castptr %z64 : i64 -> !p
  %z = arith.constant 0 : index
  %one = arith.constant 1 : index
  %limit = arith.constant 4 : index
  %init = arith.constant 32767 : i16
  %step = arith.constant 1 : i16
  %sink_base = arith.constant 8192 : index
  %stride = arith.constant 64 : index
  %dst = arith.constant -2097152 : index
  pto.vecscope {
    %m = pto.pset_b32 "PAT_ALL" : !m
    scf.for %i = %z to %limit step %one iter_args(%row = %init) -> (i16) {
      %next = scf.if %condition -> (i16) {
        %inc = arith.addi %row, %step : i16
        scf.yield %inc : i16
      } else {
        scf.yield %row : i16
      }
      %rowidx = arith.index_cast %next : i16 to index
      %offset = arith.muli %rowidx, %stride : index
      %loaded = pto.vlds %p[%offset] : !p, index -> !v
      %column = arith.muli %i, %stride : index
      %sink = arith.addi %sink_base, %column : index
      pto.vsts %loaded, %p[%sink], %m : !v, !p, index, !m
      scf.yield %next : i16
    }
    pto.vsts %data, %p[%dst], %m : !v, !p, index, !m
  }
  return
}
// CHECK-LABEL: func.func @recurrence_unknown_bound(
// CHECK: pto.mem_bar
// CHECK: return
func.func @recurrence_unknown_bound(%condition: i1, %n: index, %data: !v) {
  %z64 = arith.constant 0 : i64
  %p = pto.castptr %z64 : i64 -> !p
  %z = arith.constant 0 : index
  %one = arith.constant 1 : index
  %limit = arith.constant 4 : index
  %init = arith.constant 0 : i16
  %step = arith.constant 1 : i16
  %sink_base = arith.constant 8192 : index
  %stride = arith.constant 64 : index
  %dst = arith.constant 384 : index
  pto.vecscope {
    %m = pto.pset_b32 "PAT_ALL" : !m
    scf.for %i = %z to %n step %one iter_args(%row = %init) -> (i16) {
      %next = scf.if %condition -> (i16) {
        %inc = arith.addi %row, %step : i16
        scf.yield %inc : i16
      } else {
        scf.yield %row : i16
      }
      %rowidx = arith.index_cast %next : i16 to index
      %offset = arith.muli %rowidx, %stride : index
      %loaded = pto.vlds %p[%offset] : !p, index -> !v
      %column = arith.muli %i, %stride : index
      %sink = arith.addi %sink_base, %column : index
      pto.vsts %loaded, %p[%sink], %m : !v, !p, index, !m
      scf.yield %next : i16
    }
    pto.vsts %data, %p[%dst], %m : !v, !p, index, !m
  }
  return
}
}
