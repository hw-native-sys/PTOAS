// pto.assert must lower to a condition-guarded trap before LLVM export.
// The message attribute has no device printf channel on the VPTO backend
// and is dropped by the lowering.
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s
// RUN: ptoas --cann-output-version=9.0.0 --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @assert_vpto_llvm(%arg0: i1) attributes {pto.entry} {
    pto.assert %arg0 {message = "bounds check"} : i1
    return
  }
}

// CHECK-DAG: declare void @llvm.hivm.TRAP()
// CHECK-LABEL: define void @assert_vpto_llvm_mix_aiv
// CHECK: xor i1 %{{.*}}, true
// CHECK: br i1 %{{.*}}
// CHECK: call void @llvm.hivm.TRAP()
