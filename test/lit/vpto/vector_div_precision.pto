// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --vpto-scheduler=off --emit-vpto-llvm-ir %s -o - | FileCheck %s --check-prefix=LLVM
// LLVM: call <64 x float> @llvm.hivm.vdiv
// LLVM: call <64 x i32> @llvm.hivm.vadds{{.*}}i32 -1
// LLVM: call <64 x i32> @llvm.hivm.vadds{{.*}}i32 1
// LLVM-COUNT-3: call <64 x float> @llvm.hivm.vmula
// CHECK: pto.vdiv
// CHECK: pto.vbitcast
// CHECK: pto.vmula
// CHECK: pto.vsel
// CHECK-NOT: high_precision

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vector_div_precision(%lhs: !pto.vreg<64xf32>,
                                  %rhs: !pto.vreg<64xf32>,
                                  %dst: !pto.ptr<f32, ub>,
                                  %mask: !pto.mask<b32>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %quotient = pto.vdiv %lhs, %rhs, %mask {precisionType = #pto<div_precision high_precision>} :
      !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
    pto.vsts %quotient, %dst[%c0], %mask :
      !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    return
  }
}

