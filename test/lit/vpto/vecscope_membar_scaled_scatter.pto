// RUN: pto-test-opt --pto-insert-vecscope-membar %s | FileCheck %s
// RUN: pto-test-opt --pto-insert-vecscope-membar --pto-insert-vecscope-membar %s | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar=true %s | FileCheck %s

!mb32 = !pto.mask<b32>
!pf32ub = !pto.ptr<f32, ub>
!v64xf32 = !pto.vreg<64xf32>
!v64xi32 = !pto.vreg<64xi32>
!v64xui32 = !pto.vreg<64xui32>

module {
// CHECK-LABEL: func.func @scaled_last_lane_overlap(
// CHECK-NOT: pto.mem_bar
// CHECK: pto.vscatter
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: pto.vlds
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @scaled_last_lane_overlap(%dyn: !v64xui32, %pred: !mb32) {
    %read = arith.constant 504 : index
    %sinkoff = arith.constant 10000 : index
    %base = arith.constant 0 : i32
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %ub = pto.castptr %addr : i64 -> !pf32ub
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !mb32
      %v = pto.vdup %f, %all : f32, !mb32 -> !v64xf32
      %i = pto.vci %base : i32 -> !v64xi32
      %off = pto.vbitcast %i : !v64xi32 -> !v64xui32
      %rawfactor = arith.constant 8 : i32
      %factor = builtin.unrealized_conversion_cast %rawfactor : i32 to ui32
      %scaled = pto.vmuls %off, %factor, %all : !v64xui32, ui32, !mb32 -> !v64xui32
      pto.vscatter %v, %ub, %scaled, %all : !v64xf32, !pf32ub, !v64xui32, !mb32
      %z = pto.vlds %ub[%read] : !pf32ub, index -> !v64xf32
      pto.vsts %z, %ub[%sinkoff], %all : !v64xf32, !pf32ub, index, !mb32
    }
    return
  }

// CHECK-LABEL: func.func @scaled_prefix_adjacent(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @scaled_prefix_adjacent(%dyn: !v64xui32, %pred: !mb32) {
    %read = arith.constant 25 : index
    %sinkoff = arith.constant 10000 : index
    %base = arith.constant 0 : i32
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %ub = pto.castptr %addr : i64 -> !pf32ub
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !mb32
      %m = pto.pset_b32 "PAT_VL4" : !mb32
      %v = pto.vdup %f, %all : f32, !mb32 -> !v64xf32
      %i = pto.vci %base : i32 -> !v64xi32
      %off = pto.vbitcast %i : !v64xi32 -> !v64xui32
      %rawfactor = arith.constant 8 : i32
      %factor = builtin.unrealized_conversion_cast %rawfactor : i32 to ui32
      %scaled = pto.vmuls %off, %factor, %all : !v64xui32, ui32, !mb32 -> !v64xui32
      pto.vscatter %v, %ub, %scaled, %m : !v64xf32, !pf32ub, !v64xui32, !mb32
      %z = pto.vlds %ub[%read] : !pf32ub, index -> !v64xf32
      pto.vsts %z, %ub[%sinkoff], %all : !v64xf32, !pf32ub, index, !mb32
    }
    return
  }

// CHECK-LABEL: func.func @scaled_overflow(
// CHECK-NOT: pto.mem_bar
// CHECK: pto.vscatter
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: pto.vlds
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @scaled_overflow(%dyn: !v64xui32, %pred: !mb32) {
    %read = arith.constant 0 : index
    %sinkoff = arith.constant 10000 : index
    %base = arith.constant 1073741824 : i32
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %ub = pto.castptr %addr : i64 -> !pf32ub
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !mb32
      %v = pto.vdup %f, %all : f32, !mb32 -> !v64xf32
      %i = pto.vci %base : i32 -> !v64xi32
      %off = pto.vbitcast %i : !v64xi32 -> !v64xui32
      %rawfactor = arith.constant 8 : i32
      %factor = builtin.unrealized_conversion_cast %rawfactor : i32 to ui32
      %scaled = pto.vmuls %off, %factor, %all : !v64xui32, ui32, !mb32 -> !v64xui32
      pto.vscatter %v, %ub, %scaled, %all : !v64xf32, !pf32ub, !v64xui32, !mb32
      %z = pto.vlds %ub[%read] : !pf32ub, index -> !v64xf32
      pto.vsts %z, %ub[%sinkoff], %all : !v64xf32, !pf32ub, index, !mb32
    }
    return
  }

// CHECK-LABEL: func.func @scaled_partial_arithmetic(
// CHECK-NOT: pto.mem_bar
// CHECK: pto.vscatter
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: pto.vlds
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @scaled_partial_arithmetic(%dyn: !v64xui32, %pred: !mb32) {
    %read = arith.constant 512 : index
    %sinkoff = arith.constant 10000 : index
    %base = arith.constant 0 : i32
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %ub = pto.castptr %addr : i64 -> !pf32ub
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !mb32
      %v = pto.vdup %f, %all : f32, !mb32 -> !v64xf32
      %i = pto.vci %base : i32 -> !v64xi32
      %off = pto.vbitcast %i : !v64xi32 -> !v64xui32
      %rawfactor = arith.constant 8 : i32
      %factor = builtin.unrealized_conversion_cast %rawfactor : i32 to ui32
      %arithmask = pto.pset_b32 "PAT_VL4" : !mb32
      %scaled = pto.vmuls %off, %factor, %arithmask : !v64xui32, ui32, !mb32 -> !v64xui32
      pto.vscatter %v, %ub, %scaled, %all : !v64xf32, !pf32ub, !v64xui32, !mb32
      %z = pto.vlds %ub[%read] : !pf32ub, index -> !v64xf32
      pto.vsts %z, %ub[%sinkoff], %all : !v64xf32, !pf32ub, index, !mb32
    }
    return
  }

// CHECK-LABEL: func.func @scaled_negative_factor(
// CHECK-NOT: pto.mem_bar
// CHECK: pto.vscatter
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: pto.vlds
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @scaled_negative_factor(%dyn: !v64xui32, %pred: !mb32) {
    %read = arith.constant 0 : index
    %sinkoff = arith.constant 10000 : index
    %base = arith.constant 0 : i32
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %ub = pto.castptr %addr : i64 -> !pf32ub
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !mb32
      %v = pto.vdup %f, %all : f32, !mb32 -> !v64xf32
      %i = pto.vci %base : i32 -> !v64xi32
      %off = pto.vbitcast %i : !v64xi32 -> !v64xui32
      %allinus = arith.constant -1 : i32
      %factor = builtin.unrealized_conversion_cast %allinus : i32 to ui32
      %scaled = pto.vmuls %off, %factor, %all : !v64xui32, ui32, !mb32 -> !v64xui32
      pto.vscatter %v, %ub, %scaled, %all : !v64xf32, !pf32ub, !v64xui32, !mb32
      %z = pto.vlds %ub[%read] : !pf32ub, index -> !v64xf32
      pto.vsts %z, %ub[%sinkoff], %all : !v64xf32, !pf32ub, index, !mb32
    }
    return
  }

// CHECK-LABEL: func.func @scaled_carried_overlap(
// CHECK: scf.for
// CHECK: pto.vscatter
// CHECK: pto.mem_bar "VST_VST"
// CHECK: return
  func.func @scaled_carried_overlap() {
    %zero = arith.constant 0 : index
    %two = arith.constant 2 : index
    %one = arith.constant 1 : index
    %start = arith.constant 0 : i32
    %rawfactor = arith.constant 8 : i32
    %factor = builtin.unrealized_conversion_cast %rawfactor : i32 to ui32
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %base = pto.castptr %addr : i64 -> !pf32ub
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !mb32
      %mask = pto.pset_b32 "PAT_VL4" : !mb32
      %v = pto.vdup %f, %all : f32, !mb32 -> !v64xf32
      %idx = pto.vci %start : i32 -> !v64xi32
      %offsets = pto.vbitcast %idx : !v64xi32 -> !v64xui32
      %scaled = pto.vmuls %offsets, %factor, %all : !v64xui32, ui32, !mb32 -> !v64xui32
      scf.for %iv = %zero to %two step %one {
        pto.vscatter %v, %base, %scaled, %mask : !v64xf32, !pf32ub, !v64xui32, !mb32
      }
    }
    return
  }
}
