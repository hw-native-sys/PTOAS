// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --enable-vpto-soft-postupdate --emit-vpto %s -o - | FileCheck %s

// Same-op candidates with different root bases form independent buckets even
// when their operations are physically interleaved.
// CHECK-LABEL: func.func @same_op_different_roots
// CHECK: %{{.*}}, [[A1:%[a-zA-Z0-9_]+]] = pto.vlds {{%.*}}[[[ASTEP:%[a-zA-Z0-9_]+]]]
// CHECK: %{{.*}}, [[B1:%[a-zA-Z0-9_]+]] = pto.vlds {{%.*}}[[[BSTEP:%[a-zA-Z0-9_]+]]]
// CHECK: %{{.*}}, [[A2:%[a-zA-Z0-9_]+]] = pto.vlds [[A1]][[[ASTEP]]]
// CHECK: %{{.*}}, [[B2:%[a-zA-Z0-9_]+]] = pto.vlds [[B1]][[[BSTEP]]]
// CHECK: %{{.*}} = pto.vlds [[A2]][%c0]
// CHECK: %{{.*}} = pto.vlds [[B2]][%c0]

// An already-post-update op is excluded from candidate collection. It neither
// joins nor breaks the non-post run around it.
// CHECK-LABEL: func.func @already_post_does_not_break_run
// CHECK: %{{.*}}, [[P1:%[a-zA-Z0-9_]+]] = pto.vlds {{%.*}}[[[PSTEP:%[a-zA-Z0-9_]+]]]
// CHECK: %{{.*}}, %{{.*}} = pto.vlds {{%.*}}[%c4]
// CHECK: %{{.*}}, [[P2:%[a-zA-Z0-9_]+]] = pto.vlds [[P1]][[[PSTEP]]]
// CHECK: %{{.*}} = pto.vlds [[P2]][%c0]

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @same_op_different_roots(%src0: !pto.ptr<f32, ub>, %src1: !pto.ptr<f32, ub>, %sink: !pto.ptr<f32, ub>, %step0_i32: i32, %step1_i32: i32) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %step0 = arith.index_cast %step0_i32 : i32 to index
    %step1 = arith.index_cast %step1_i32 : i32 to index
    %step0_2 = arith.addi %step0, %step0 : index
    %step1_2 = arith.addi %step1, %step1 : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %a0 = pto.vlds %src0[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %a0, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %b0 = pto.vlds %src1[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %b0, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %a1 = pto.vlds %src0[%step0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %a1, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %b1 = pto.vlds %src1[%step1] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %b1, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %a2 = pto.vlds %src0[%step0_2] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %a2, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %b2 = pto.vlds %src1[%step1_2] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %b2, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }

  func.func @already_post_does_not_break_run(%src: !pto.ptr<f32, ub>, %other: !pto.ptr<f32, ub>, %sink: !pto.ptr<f32, ub>, %step_i32: i32) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c4 = arith.constant 4 : index
    %step = arith.index_cast %step_i32 : i32 to index
    %step2 = arith.addi %step, %step : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v0 = pto.vlds %src[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v0, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %post, %next = pto.vlds %other[%c4] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>, !pto.ptr<f32, ub>
      pto.vsts %post, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v1 = pto.vlds %src[%step] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v1, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v2 = pto.vlds %src[%step2] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v2, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }
}
