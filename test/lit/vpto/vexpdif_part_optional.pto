// RUN: pto-test-opt %s -split-input-file | FileCheck %s

// An f32 source covers the whole vector with a single instruction, so `part`
// may be omitted. The compact form round-trips unchanged.
module {
  func.func @vexpdif_f32_without_part(
      %input: !pto.vreg<64xf32>,
      %max: !pto.vreg<64xf32>,
      %mask: !pto.mask<b32>) -> !pto.vreg<64xf32> {
    // CHECK-LABEL: func.func @vexpdif_f32_without_part
    // CHECK: pto.vexpdif %{{.*}}, %{{.*}}, %{{.*}} : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
    %result = pto.vexpdif %input, %max, %mask : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
    return %result : !pto.vreg<64xf32>
  }
}

// -----

// The explicit f32 form keeps its positional token, so existing producers that
// pass the hardware contract value stay valid.
module {
  func.func @vexpdif_f32_with_part(
      %input: !pto.vreg<64xf32>,
      %max: !pto.vreg<64xf32>,
      %mask: !pto.mask<b32>) -> !pto.vreg<64xf32> {
    // CHECK-LABEL: func.func @vexpdif_f32_with_part
    // CHECK: pto.vexpdif %{{.*}}, %{{.*}}, %{{.*}}, "ODD" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
    %result = pto.vexpdif %input, %max, %mask, "ODD" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
    return %result : !pto.vreg<64xf32>
  }
}

// -----

// An f16 source packs two elements per 32-bit lane and one instruction only
// consumes the selected half, so the half selection stays explicit.
module {
  func.func @vexpdif_f16_with_part(
      %input: !pto.vreg<128xf16>,
      %max: !pto.vreg<128xf16>,
      %mask: !pto.mask<b16>) -> !pto.vreg<64xf32> {
    // CHECK-LABEL: func.func @vexpdif_f16_with_part
    // CHECK: pto.vexpdif %{{.*}}, %{{.*}}, %{{.*}}, "EVEN" : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
    %result = pto.vexpdif %input, %max, %mask, "EVEN" : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
    return %result : !pto.vreg<64xf32>
  }
}
