// Convention defaults of the whitelist schema: the minimal whitelist
// (Inputs/vpto-bridge-whitelist-minimal-defaults.yaml) declares the
// wrapper with name/includes only and the entry with op/wrapper/abi
// (operand+role) only. Everything else derives: the entry name and the
// call spelling from the op name (pto.tadd -> pto_vpto_add, pto::TADD),
// the parameter names from the abi roles, and the __DAV_VEC__ core guard
// from the collected VEC tile kinds.

// RUN: pto-test-opt %s "-pto-lower-declarative-bridge-ops=whitelist-path=%S/Inputs/vpto-bridge-whitelist-minimal-defaults.yaml" "-pto-emit-vpto-bridge-wrapper=whitelist-path=%S/Inputs/vpto-bridge-whitelist-minimal-defaults.yaml" | FileCheck %s --check-prefix=MIN

// MIN: module attributes {{{.*}}pto.vpto.bridge.wrapper_source = "
// MIN-SAME: // VPTO bridge wrapper for 'vec_elem_min'.
// MIN-SAME: #include <pto/npu/a5/TAdd.hpp>
// MIN-SAME: #ifdef __DAV_VEC__
// MIN-SAME: extern \22C\22 [aicore] void pto_vpto_add(uint64_t resultTileAddress, uint64_t leftTileAddress, uint64_t rightTileAddress)
// MIN-SAME: ResultTile resultTile;
// MIN-SAME: LeftTile leftTile;
// MIN-SAME: RightTile rightTile;
// MIN-SAME: pto::TADD(resultTile, leftTile, rightTile);
// MIN-SAME: #endif

// MIN-LABEL: func.func private @tadd_minimal_defaults
// MIN: pto.bridge_call "pto_vpto_add"

module attributes {pto.target_arch = "a5"} {
  func.func private @tadd_minimal_defaults(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c512 = arith.constant 512 : i64
    %c1024 = arith.constant 1024 : i64
    %src0 = pto.alloc_tile addr = %c0
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src1 = pto.alloc_tile addr = %c512
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile addr = %c1024
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tadd ins(%src0, %src1
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>,
        !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                                blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}
