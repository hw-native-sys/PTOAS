// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --enable-vpto-soft-postupdate --emit-vpto %s -o - | FileCheck %s

// select is outside the supported affine grammar, but reusing the same SSA
// value makes it a stable symbolic leaf. Because it is defined after the run
// head, its pure definition is cloned before the first access.
// CHECK-LABEL: func.func @late_pure_symbolic_leaf
// CHECK: pto.vecscope
// CHECK: [[STEP_I32:%[a-zA-Z0-9_]+]] = arith.select
// CHECK: [[STEP:%[a-zA-Z0-9_]+]] = arith.index_cast [[STEP_I32]]
// CHECK: %{{.*}}, [[L1:%[a-zA-Z0-9_]+]] = pto.vlds {{%.*}}[[[STEP]]]
// CHECK: %{{.*}}, [[L2:%[a-zA-Z0-9_]+]] = pto.vlds [[L1]][[[STEP]]]
// CHECK: %{{.*}} = pto.vlds [[L2]][%c0]

// The same N3 direct-symbolic profitability rule applies to stores.
// CHECK-LABEL: func.func @direct_symbolic_leaf_vsts
// CHECK: [[S1:%[a-zA-Z0-9_]+]] = pto.vsts {{.*}}, {{%.*}}[[[SSTEP:%[a-zA-Z0-9_]+]]],
// CHECK: [[S2:%[a-zA-Z0-9_]+]] = pto.vsts {{.*}}, [[S1]][[[SSTEP]]],
// CHECK: pto.vsts {{.*}}, [[S2]][%c0],

// Block-stride stores use the same rule in their native i16 stride type.
// CHECK-LABEL: func.func @direct_symbolic_leaf_vsstb
// CHECK: [[B1:%[a-zA-Z0-9_]+]] = pto.vsstb {{.*}}, {{%.*}}, %c1_i16, [[BSTEP:%[a-zA-Z0-9_]+]], {{.*}} -> !pto.ptr<f32,
// CHECK: [[B2:%[a-zA-Z0-9_]+]] = pto.vsstb {{.*}}, [[B1]], %c1_i16, [[BSTEP]], {{.*}} -> !pto.ptr<f32,
// CHECK: pto.vsstb {{.*}}, [[B2]], %c1_i16, %c0_i16, {{.*}} : {{.*}}!pto.mask<b32>

// Distinct opaque SSA leaves are not assumed equal, so the candidate sequence
// is conservatively left in non-post-update form.
// CHECK-LABEL: func.func @distinct_symbolic_leaves
// CHECK: {{^ *}}%{{[^, ]+}} = pto.vlds {{%.*}}[%c0]
// CHECK: {{^ *}}%{{[^, ]+}} = pto.vlds {{%.*}}[{{%.*}}]
// CHECK: {{^ *}}%{{[^, ]+}} = pto.vlds {{%.*}}[{{%.*}}]

// A potentially trapping definition cannot be moved before the run head. The
// run is rejected and no partial materialization is left behind.
// CHECK-LABEL: func.func @late_non_speculatable_leaf
// CHECK: {{^ *}}%{{[^, ]+}} = pto.vlds {{%.*}}[%c0]
// CHECK: arith.divui
// CHECK: {{^ *}}%{{[^, ]+}} = pto.vlds {{%.*}}[{{%.*}}]
// CHECK: {{^ *}}%{{[^, ]+}} = pto.vlds {{%.*}}[{{%.*}}]

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @late_pure_symbolic_leaf(%src: !pto.ptr<f32, ub>, %sink: !pto.ptr<f32, ub>, %cond: i1, %lhs: i32, %rhs: i32) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v0 = pto.vlds %src[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v0, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %step_i32 = arith.select %cond, %lhs, %rhs : i32
      %step = arith.index_cast %step_i32 : i32 to index
      %v1 = pto.vlds %src[%step] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v1, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %step2 = arith.addi %step, %step : index
      %v2 = pto.vlds %src[%step2] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v2, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }

  func.func @direct_symbolic_leaf_vsts(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>, %step_i32: i32) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %step = arith.index_cast %step_i32 : i32 to index
    %step2 = arith.addi %step, %step : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %vec = pto.vlds %src[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %vec, %dst[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.vsts %vec, %dst[%step], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.vsts %vec, %dst[%step2], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }

  func.func @direct_symbolic_leaf_vsstb(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>, %step_i8: i8) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c0_i16 = arith.constant 0 : i16
    %c1_i16 = arith.constant 1 : i16
    %step = arith.extsi %step_i8 : i8 to i16
    %step2 = arith.addi %step, %step : i16
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %vec = pto.vlds %src[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsstb %vec, %dst, %c1_i16, %c0_i16, %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
      pto.vsstb %vec, %dst, %c1_i16, %step, %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
      pto.vsstb %vec, %dst, %c1_i16, %step2, %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
    }
    return
  }

  func.func @distinct_symbolic_leaves(%src: !pto.ptr<f32, ub>, %sink: !pto.ptr<f32, ub>, %numerator: index, %denom0: index, %denom1: index) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %step0 = arith.divui %numerator, %denom0 : index
    %step1 = arith.divui %numerator, %denom1 : index
    %sum = arith.addi %step0, %step1 : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v0 = pto.vlds %src[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v0, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v1 = pto.vlds %src[%step0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v1, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v2 = pto.vlds %src[%sum] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v2, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }

  func.func @late_non_speculatable_leaf(%src: !pto.ptr<f32, ub>, %sink: !pto.ptr<f32, ub>, %numerator: index, %denominator: index) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v0 = pto.vlds %src[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v0, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %step = arith.divui %numerator, %denominator : index
      %v1 = pto.vlds %src[%step] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v1, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %step2 = arith.addi %step, %step : index
      %v2 = pto.vlds %src[%step2] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v2, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }
}
