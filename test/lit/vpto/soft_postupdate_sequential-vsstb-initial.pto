// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --enable-vpto-soft-postupdate --emit-vpto %s -o - | FileCheck %s

// The first repeat_stride is four 32-byte blocks, but this constant-only run
// has no structural profitability signal and therefore remains normal.
// CHECK-LABEL: func.func @vsstb_nonzero_initial_stride
// CHECK: {{^ *}}pto.vsstb {{.*}}, %c2_i16, %c4_i16, {{.*}} : {{.*}}!pto.mask<b32>{{ *$}}
// CHECK: {{^ *}}pto.vsstb {{.*}}, %c2_i16, %c7_i16, {{.*}} : {{.*}}!pto.mask<b32>{{ *$}}
// CHECK: {{^ *}}pto.vsstb {{.*}}, %c2_i16, %c10_i16, {{.*}} : {{.*}}!pto.mask<b32>{{ *$}}

// A base delta of 320000 f32 elements is 40000 blocks. The resulting stride
// does not fit i16, so analysis rejects the run without materializing it.
// CHECK-LABEL: func.func @vsstb_sequential_stride_out_of_range
// CHECK: {{^ *}}pto.vsstb {{.*}} : {{.*}}!pto.mask<b32>{{ *$}}
// CHECK: {{^ *}}pto.vsstb {{.*}} : {{.*}}!pto.mask<b32>{{ *$}}
// CHECK: {{^ *}}pto.vsstb {{.*}} : {{.*}}!pto.mask<b32>{{ *$}}

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vsstb_nonzero_initial_stride(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c2_i16 = arith.constant 2 : i16
    %c4_i16 = arith.constant 4 : i16
    %c7_i16 = arith.constant 7 : i16
    %c10_i16 = arith.constant 10 : i16
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %vec = pto.vlds %src[%c0] : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
      pto.vsstb %vec, %dst, %c2_i16, %c4_i16, %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
      pto.vsstb %vec, %dst, %c2_i16, %c7_i16, %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
      pto.vsstb %vec, %dst, %c2_i16, %c10_i16, %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
    }
    return
  }

  func.func @vsstb_sequential_stride_out_of_range(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c320000 = arith.constant 320000 : index
    %c640000 = arith.constant 640000 : index
    %c0_i16 = arith.constant 0 : i16
    %c2_i16 = arith.constant 2 : i16
    %base1 = pto.addptr %dst, %c320000 : !pto.ptr<f32, ub>, index -> !pto.ptr<f32, ub>
    %base2 = pto.addptr %dst, %c640000 : !pto.ptr<f32, ub>, index -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %vec = pto.vlds %src[%c0] : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
      pto.vsstb %vec, %dst, %c2_i16, %c0_i16, %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
      pto.vsstb %vec, %base1, %c2_i16, %c0_i16, %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
      pto.vsstb %vec, %base2, %c2_i16, %c0_i16, %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
    }
    return
  }
}
