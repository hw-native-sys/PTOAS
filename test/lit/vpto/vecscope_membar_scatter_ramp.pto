// CHECK-LABEL: func.func @lane_geometry(
// CHECK: pto.vscatter
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: pto.vlds
// CHECK: return
  func.func @lane_geometry(%dyn: !v64xui32, %pred: !mb32) {
    %read = arith.constant 4 : index
    %sinkoff = arith.constant 256 : index
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %ub = pto.castptr %addr : i64 -> !pf32ub
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !mb32
      %m = pto.pset_b32 "PAT_VL4" : !mb32
      %v = pto.vdup %f, %all : f32, !mb32 -> !v64xf32
      %base16 = arith.constant 0 : i16
      %i = pto.vci %base16 : i16 -> !v128xi16
      %off = pto.vbitcast %i : !v128xi16 -> !v64xui32
      pto.vscatter %v, %ub, %off, %m : !v64xf32, !pf32ub, !v64xui32, !mb32
      %z = pto.vlds %ub[%read] : !pf32ub, index -> !v64xf32
      pto.vsts %z, %ub[%sinkoff], %all : !v64xf32, !pf32ub, index, !mb32
    }
    return
  }

// CHECK-LABEL: func.func @outer_bounded_ramp(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @outer_bounded_ramp() {
    %lb = arith.constant 0 : index
    %ub = arith.constant 2 : index
    %step = arith.constant 1 : index
    %read = arith.constant 8 : index
    %sinkoff = arith.constant 256 : index
    %four = arith.constant 4 : i32
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %base = pto.castptr %addr : i64 -> !pf32ub
    scf.for %iv = %lb to %ub step %step {
      %ext = arith.index_cast %iv : index to i32
      %start = arith.muli %ext, %four : i32
      pto.vecscope {
        %all = pto.pset_b32 "PAT_ALL" : !mb32
        %mask = pto.pset_b32 "PAT_VL4" : !mb32
        %v = pto.vdup %f, %all : f32, !mb32 -> !v64xf32
        %idx = pto.vci %start : i32 -> !v64xi32
        %offsets = pto.vbitcast %idx : !v64xi32 -> !v64xui32
        pto.vscatter %v, %base, %offsets, %mask : !v64xf32, !pf32ub, !v64xui32, !mb32
        %z = pto.vlds %base[%read] : !pf32ub, index -> !v64xf32
        pto.vsts %z, %base[%sinkoff], %all : !v64xf32, !pf32ub, index, !mb32
      }
    }
    return
  }

// CHECK-LABEL: func.func @outer_real_overlap(
// CHECK: pto.vscatter
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: pto.vlds
// CHECK: return
  func.func @outer_real_overlap() {
    %lb = arith.constant 0 : index
    %ub = arith.constant 2 : index
    %step = arith.constant 1 : index
    %read = arith.constant 7 : index
    %sinkoff = arith.constant 256 : index
    %four = arith.constant 4 : i32
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %base = pto.castptr %addr : i64 -> !pf32ub
    scf.for %iv = %lb to %ub step %step {
      %ext = arith.index_cast %iv : index to i32
      %start = arith.muli %ext, %four : i32
      pto.vecscope {
        %all = pto.pset_b32 "PAT_ALL" : !mb32
        %mask = pto.pset_b32 "PAT_VL4" : !mb32
        %v = pto.vdup %f, %all : f32, !mb32 -> !v64xf32
        %idx = pto.vci %start : i32 -> !v64xi32
        %offsets = pto.vbitcast %idx : !v64xi32 -> !v64xui32
        pto.vscatter %v, %base, %offsets, %mask : !v64xf32, !pf32ub, !v64xui32, !mb32
        %z = pto.vlds %base[%read] : !pf32ub, index -> !v64xf32
        pto.vsts %z, %base[%sinkoff], %all : !v64xf32, !pf32ub, index, !mb32
      }
    }
    return
  }

// CHECK-LABEL: func.func @carried_scatter_overlap(
// CHECK: scf.for
// CHECK: pto.vscatter
// CHECK: pto.mem_bar "VST_VST"
// CHECK: return
  func.func @carried_scatter_overlap() {
    %zero = arith.constant 0 : index
    %two = arith.constant 2 : index
    %one = arith.constant 1 : index
    %start = arith.constant 0 : i32
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %base = pto.castptr %addr : i64 -> !pf32ub
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_VL4" : !mb32
      %v = pto.vdup %f, %mask : f32, !mb32 -> !v64xf32
      %idx = pto.vci %start : i32 -> !v64xi32
      %offsets = pto.vbitcast %idx : !v64xi32 -> !v64xui32
      scf.for %iv = %zero to %two step %one {
        pto.vscatter %v, %base, %offsets, %mask : !v64xf32, !pf32ub, !v64xui32, !mb32
      }
    }
    return
  }

// CHECK-LABEL: func.func @b16_request_count(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @b16_request_count() {
    %read = arith.constant 4 : index
    %sinkoff = arith.constant 1024 : index
    %start = arith.constant 0 : i16
    %f = arith.constant 1.0 : f16
    %addr = arith.constant 0 : i64
    %base = pto.castptr %addr : i64 -> !pf16ub
    pto.vecscope {
      %all = pto.pset_b16 "PAT_ALL" : !mb16
      %mask = pto.pset_b16 "PAT_VL4" : !mb16
      %v = pto.vdup %f, %all : f16, !mb16 -> !v128xf16
      %idx = pto.vci %start : i16 -> !v128xi16
      %offsets = pto.vbitcast %idx : !v128xi16 -> !v128xui16
      pto.vscatter %v, %base, %offsets, %mask : !v128xf16, !pf16ub, !v128xui16, !mb16
      %z = pto.vlds %base[%read] : !pf16ub, index -> !v128xf16
      pto.vsts %z, %base[%sinkoff], %all : !v128xf16, !pf16ub, index, !mb16
    }
    return
  }

// CHECK-LABEL: func.func @b8_request_count(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @b8_request_count() {
    %read = arith.constant 128 : index
    %sinkoff = arith.constant 1024 : index
    %start = arith.constant 0 : i16
    %f = arith.constant 1 : i8
    %addr = arith.constant 0 : i64
    %base = pto.castptr %addr : i64 -> !pi8ub
    pto.vecscope {
      %all = pto.pset_b8 "PAT_ALL" : !mb8
      %mask = pto.pset_b16 "PAT_ALL" : !mb16
      %v = pto.vdup %f, %all : i8, !mb8 -> !v256xi8
      %idx = pto.vci %start : i16 -> !v128xi16
      %offsets = pto.vbitcast %idx : !v128xi16 -> !v128xui16
      pto.vscatter %v, %base, %offsets, %mask : !v256xi8, !pi8ub, !v128xui16, !mb16
      %z = pto.vlds %base[%read] : !pi8ub, index -> !v256xi8
      pto.vsts %z, %base[%sinkoff], %all : !v256xi8, !pi8ub, index, !mb8
    }
    return
  }
}
