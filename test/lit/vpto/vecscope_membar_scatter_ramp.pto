// RUN: pto-test-opt --pto-insert-vecscope-membar %s | FileCheck %s
// RUN: pto-test-opt --pto-insert-vecscope-membar --pto-insert-vecscope-membar %s | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar=true %s | FileCheck %s

!mb16 = !pto.mask<b16>
!mb32 = !pto.mask<b32>
!mb8 = !pto.mask<b8>
!pf16ub = !pto.ptr<f16, ub>
!pf32ub = !pto.ptr<f32, ub>
!pi8ub = !pto.ptr<i8, ub>
!v128xf16 = !pto.vreg<128xf16>
!v128xi16 = !pto.vreg<128xi16>
!v128xui16 = !pto.vreg<128xui16>
!v256xi8 = !pto.vreg<256xi8>
!v64xf32 = !pto.vreg<64xf32>
!v64xi32 = !pto.vreg<64xi32>
!v64xsi32 = !pto.vreg<64xsi32>
!v64xui32 = !pto.vreg<64xui32>

module {
// CHECK-LABEL: func.func @prefix_adjacent(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @prefix_adjacent(%dyn: !v64xui32, %pred: !mb32) {
    %read = arith.constant 4 : index
    %sinkoff = arith.constant 256 : index
    %base = arith.constant 0 : i32
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %ub = pto.castptr %addr : i64 -> !pf32ub
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !mb32
      %m = pto.pset_b32 "PAT_VL4" : !mb32
      %v = pto.vdup %f, %all : f32, !mb32 -> !v64xf32
      %i = pto.vci %base : i32 -> !v64xi32
      %signed = pto.vbitcast %i : !v64xi32 -> !v64xsi32
      %off = pto.vbitcast %signed : !v64xsi32 -> !v64xui32
      pto.vscatter %v, %ub, %off, %m : !v64xf32, !pf32ub, !v64xui32, !mb32
      %z = pto.vlds %ub[%read] : !pf32ub, index -> !v64xf32
      pto.vsts %z, %ub[%sinkoff], %all : !v64xf32, !pf32ub, index, !mb32
    }
    return
  }

// CHECK-LABEL: func.func @ramp_overlap(
// CHECK: pto.vscatter
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: pto.vlds
// CHECK: return
  func.func @ramp_overlap(%dyn: !v64xui32, %pred: !mb32) {
    %read = arith.constant 3 : index
    %sinkoff = arith.constant 256 : index
    %base = arith.constant 0 : i32
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %ub = pto.castptr %addr : i64 -> !pf32ub
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !mb32
      %m = pto.pset_b32 "PAT_VL4" : !mb32
      %v = pto.vdup %f, %all : f32, !mb32 -> !v64xf32
      %i = pto.vci %base : i32 -> !v64xi32
      %signed = pto.vbitcast %i : !v64xi32 -> !v64xsi32
      %off = pto.vbitcast %signed : !v64xsi32 -> !v64xui32
      pto.vscatter %v, %ub, %off, %m : !v64xf32, !pf32ub, !v64xui32, !mb32
      %z = pto.vlds %ub[%read] : !pf32ub, index -> !v64xf32
      pto.vsts %z, %ub[%sinkoff], %all : !v64xf32, !pf32ub, index, !mb32
    }
    return
  }

