// CHECK-LABEL: func.func @descending(
// CHECK: pto.vscatter
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: pto.vlds
// CHECK: return
  func.func @descending(%dyn: !v64xui32, %pred: !mb32) {
    %read = arith.constant 4 : index
    %sinkoff = arith.constant 256 : index
    %base = arith.constant 0 : i32
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %ub = pto.castptr %addr : i64 -> !pf32ub
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !mb32
      %m = pto.pset_b32 "PAT_VL4" : !mb32
      %v = pto.vdup %f, %all : f32, !mb32 -> !v64xf32
      %i = pto.vci %base {order = "DESC"} : i32 -> !v64xi32
      %signed = pto.vbitcast %i : !v64xi32 -> !v64xsi32
      %off = pto.vbitcast %signed : !v64xsi32 -> !v64xui32
      pto.vscatter %v, %ub, %off, %m : !v64xf32, !pf32ub, !v64xui32, !mb32
      %z = pto.vlds %ub[%read] : !pf32ub, index -> !v64xf32
      pto.vsts %z, %ub[%sinkoff], %all : !v64xf32, !pf32ub, index, !mb32
    }
    return
  }

