// Regression for issue 1241: integer types without a SoftLib implementation
// must fail before reaching the unsupported integer HiVM VDIV path. Issue
// 1607 adds ui16/ui32 support, so use i8 to retain the rejection coverage.
// RUN: ! ptoas --pto-arch=a5 --pto-backend=vpto %s 2>&1 | FileCheck %s
// CHECK: error: A5 integer pto.vdiv is not supported for '!pto.vreg<256xi8>' with mask '!pto.mask<b8>'
// CHECK: only signed, signless or unsigned 16-bit vectors with a b16 mask and 32-bit vectors with a b32 mask

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @issue_1241_vdiv_i8(%lhs: !pto.vreg<256xi8>, %rhs: !pto.vreg<256xi8>,
      %dst: !pto.ptr<i8, ub>, %mask: !pto.mask<b8>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %q = pto.vdiv %lhs, %rhs, %mask :
      !pto.vreg<256xi8>, !pto.vreg<256xi8>, !pto.mask<b8> -> !pto.vreg<256xi8>
    pto.vsts %q, %dst[%c0], %mask : !pto.vreg<256xi8>, !pto.ptr<i8, ub>, index, !pto.mask<b8>
    return
  }
}
