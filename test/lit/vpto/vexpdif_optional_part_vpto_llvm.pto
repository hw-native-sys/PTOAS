// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vexpdif_f32_without_part_store(%input: !pto.vreg<64xf32>, %max: !pto.vreg<64xf32>, %dst: !pto.ptr<f32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %out = pto.vexpdif %input, %max, %mask : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %out, %dst[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }

  func.func @vexpdif_f16_with_part_store(%input: !pto.vreg<128xf16>, %max: !pto.vreg<128xf16>, %dst: !pto.ptr<f32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %mask16 = pto.pset_b16 "PAT_ALL" : !pto.mask<b16>
      %mask32 = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %out = pto.vexpdif %input, %max, %mask16, "EVEN" : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
      pto.vsts %out, %dst[%c0], %mask32 : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }
}

// An omitted `part` on an f32 source still lowers to the f32 callee with the
// ODD hardware contract immediate (PART_ODD = 1) that every f32 producer in the
// pipeline uses.
// CHECK-LABEL: define void @vexpdif_f32_without_part_store_mix_aiv
// CHECK: call <64 x float> @llvm.hivm.vexpdif.v64f32({{.*}}, i32 1)

// An f16 source keeps lowering through the interleave callee with the selected
// half (PART_EVEN = 0).
// CHECK-LABEL: define void @vexpdif_f16_with_part_store_mix_aiv
// CHECK: call <64 x float> @llvm.hivm.vexpdif.interleave.v128f16({{.*}}, i32 0)
