// RUN: pto-test-opt %s -vpto-soft-postupdate | FileCheck %s

// A region-bearing op is cloned conservatively by accumulator pruning. Its own
// operands must therefore be liveness roots, even when the region is empty and
// recursively pure.

// CHECK-LABEL: func.func @accum_region_op_operand
// CHECK: [[LOOP:%[0-9]+]]:3 = scf.for
// CHECK-SAME: iter_args([[OFF:%[a-zA-Z0-9_]+]] = %c0,
// CHECK: [[CMP:%[0-9]+]] = arith.cmpi eq, [[OFF]], %c0 : index
// CHECK: scf.if [[CMP]]
// CHECK: arith.addi [[OFF]], %c64

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @accum_region_op_operand(%base: !pto.ptr<f32, ub>, %sink: !pto.ptr<f32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c64 = arith.constant 64 : index

    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      scf.for %iv = %c0 to %c4 step %c1 iter_args(%off = %c0) -> (index) {
        %cmp = arith.cmpi eq, %off, %c0 : index
        scf.if %cmp {
        }
        %vec = pto.vlds %base[%off] {dist = "NORM"}
          : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
        pto.vsts %vec, %sink[%iv], %mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
        %next = arith.addi %off, %c64 : index
        scf.yield %next : index
      }
    }
    return
  }
}
