// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - 2>&1 | FileCheck %s

module attributes {pto.backend = "vpto", pto.target_arch = "a5"} {
  func.func @tprint_vpto_unsupported() attributes {pto.entry} {
    %tile = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tprint ins(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16,
                                        v_row=16, v_col=16, blayout=row_major,
                                        slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// CHECK: ExpandTileOp: pto.tprint is only supported by the EmitC backend; VPTO lowering for TPRINT is not implemented
