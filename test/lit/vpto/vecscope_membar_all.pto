// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar=false --enable-vecscope-mem-bar-all %s -o - 2>/dev/null | FileCheck %s --check-prefix=ALL --implicit-check-not=SS_ALL
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar-all=false %s -o - 2>/dev/null | FileCheck %s --check-prefix=OFF

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vecscope_membar_all() {
    %c0 = arith.constant 0 : index
    %c0_i64 = arith.constant 0 : i64
    %c256_i64 = arith.constant 256 : i64
    %ub0 = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %ub1 = pto.castptr %c256_i64 : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v0 = pto.vlds %ub0[%c0] : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
      pto.vsts %v0, %ub0[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
      pto.mem_bar "VST_VLD"
      %scalar = pto.load %ub0[%c0] : !pto.ptr<f32, ub>, index -> f32
      pto.store %scalar, %ub1[%c0] : !pto.ptr<f32, ub>, index, f32
      %v1 = pto.vlds %ub0[%c0] : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
      pto.vsts %v1, %ub1[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
    }
    return
  }
}

// ALL-LABEL: func.func @vecscope_membar_all
// The debug mode places family-wide barriers before every vector and scalar UB access,
// including accesses already preceded by a directed barrier.
// ALL: pto.mem_bar "SV_ALL"
// ALL-NEXT: pto.mem_bar "VV_ALL"
// ALL-NEXT: pto.vlds
// ALL: pto.mem_bar "SV_ALL"
// ALL-NEXT: pto.mem_bar "VV_ALL"
// ALL-NEXT: pto.vsts
// ALL: pto.mem_bar "VST_VLD"
// ALL: pto.mem_bar "VS_ALL"
// ALL-NEXT: pto.load
// ALL: pto.mem_bar "VS_ALL"
// ALL-NEXT: pto.store
// ALL: pto.mem_bar "SV_ALL"
// ALL-NEXT: pto.mem_bar "VV_ALL"
// ALL-NEXT: pto.vlds
// ALL: pto.mem_bar "SV_ALL"
// ALL-NEXT: pto.mem_bar "VV_ALL"
// ALL-NEXT: pto.vsts

// OFF-LABEL: func.func @vecscope_membar_all
// OFF: pto.vsts
// OFF-NEXT: pto.mem_bar "VST_VLD"
// OFF: pto.mem_bar "VST_LD"
// OFF-NEXT: pto.vlds
