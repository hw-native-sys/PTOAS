// RUN: pto-test-opt --split-input-file --verify-diagnostics %s

module attributes {pto.target_arch = "a5"} {
  func.func @invalid(%a: f16, %b: f16) -> f16 {
    // expected-error @+1 {{high_precision requires scalar f32 operands}}
    %q = pto.divf %a, %b {precisionType = #pto<div_precision high_precision>} : f16
    return %q : f16
  }
}

// -----

module attributes {pto.target_arch = "a5"} {
  func.func @invalid(%a: f32, %b: f32) -> f32 {
    // expected-error @+1 {{high_precision does not allow fastmath flags}}
    %q = pto.divf %a, %b {precisionType = #pto<div_precision high_precision>, fastmath = #pto.fastmath<fast>} : f32
    return %q : f32
  }
}
