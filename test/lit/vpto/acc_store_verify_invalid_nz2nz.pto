// Issue #1751: only the channel split (X_t[42] SPLIT_EN) restricts an nz2nz
// destination to f32. The split operand is present here, so the store is
// rejected; the same store without `%split` is the native normal-mode
// writeback and accepts a bf16 destination (see acc_store_l1_normal_bf16.pto).

// RUN: not ptoas --pto-arch=a5 %s -o - 2>&1 | FileCheck %s

module attributes {"pto.target_arch" = "a5"} {
  func.func @acc_store_verify_invalid_nz2nz(%src: !pto.ptr<f32, l0c>,
                                            %dst: !pto.ptr<f16, ub>) {
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c16_i64 = arith.constant 16 : i64
    %c32_i64 = arith.constant 32 : i64

    pto.mte_l0c_ub %src, %dst, %c16_i64, %c16_i64, %c16_i64, %c32_i64, dst_mode(%c0_i64), nz2nz(%c1_i64)
      : !pto.ptr<f32, l0c>, !pto.ptr<f16, ub>, i64, i64, i64, i64, i64, i64

    return
  }
}

// CHECK: nz2nz requires destination element type to be f32 when the channel split may be enabled
