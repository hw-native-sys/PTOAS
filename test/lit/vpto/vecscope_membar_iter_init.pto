// RUN: pto-test-opt %s --pto-insert-vecscope-membar | FileCheck %s
// RUN: pto-test-opt %s --pto-insert-vecscope-membar --pto-insert-vecscope-membar | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar=true %s -o - | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  func.func @backward(%n: i16, %v: !pto.vreg<64xf32>, %bs: i16, %sink: !pto.ptr<f32, ub>) {
    %zero = arith.constant 0 : i16
    %one = arith.constant 1 : i16
    %addr = arith.constant 512 : i64
    %low = arith.constant 0 : i64
    %p = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
    %q = pto.castptr %low : i64 -> !pto.ptr<f32, ub>
    %off = arith.constant 0 : index
    %delta = arith.constant -128 : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %end = scf.for %i = %zero to %n step %one iter_args(%ptr = %p) -> (!pto.ptr<f32, ub>) : i16 {
        pto.vsstb %v, %ptr, %bs, %zero, %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
        %x = pto.vlds %q[%off] : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
        pto.vsts %x, %sink[%off], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
        %next = pto.addptr %ptr, %delta : !pto.ptr<f32, ub>, index -> !pto.ptr<f32, ub>
        scf.yield %next : !pto.ptr<f32, ub>
      }
    }
    return
  }
  func.func @forward(%n: i16, %v: !pto.vreg<64xf32>, %bs: i16, %sink: !pto.ptr<f32, ub>) {
    %zero = arith.constant 0 : i16
    %one = arith.constant 1 : i16
    %addr = arith.constant 512 : i64
    %low = arith.constant 0 : i64
    %p = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
    %q = pto.castptr %low : i64 -> !pto.ptr<f32, ub>
    %off = arith.constant 0 : index
    %delta = arith.constant 128 : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %end = scf.for %i = %zero to %n step %one iter_args(%ptr = %p) -> (!pto.ptr<f32, ub>) : i16 {
        pto.vsstb %v, %ptr, %bs, %zero, %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
        %x = pto.vlds %q[%off] : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
        pto.vsts %x, %sink[%off], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
        %next = pto.addptr %ptr, %delta : !pto.ptr<f32, ub>, index -> !pto.ptr<f32, ub>
        scf.yield %next : !pto.ptr<f32, ub>
      }
    }
    return
  }
  func.func @stationary(%n: i16, %v: !pto.vreg<64xf32>, %bs: i16, %sink: !pto.ptr<f32, ub>) {
    %zero = arith.constant 0 : i16
    %one = arith.constant 1 : i16
    %addr = arith.constant 512 : i64
    %low = arith.constant 0 : i64
    %p = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
    %q = pto.castptr %low : i64 -> !pto.ptr<f32, ub>
    %off = arith.constant 0 : index
    %delta = arith.constant 0 : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %end = scf.for %i = %zero to %n step %one iter_args(%ptr = %p) -> (!pto.ptr<f32, ub>) : i16 {
        pto.vsstb %v, %ptr, %bs, %zero, %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
        %x = pto.vlds %q[%off] : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
        pto.vsts %x, %sink[%off], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
        scf.yield %ptr : !pto.ptr<f32, ub>
      }
    }
    return
  }
}

// CHECK-LABEL: func.func @backward(
// CHECK: pto.vsstb
// CHECK-NEXT: pto.mem_bar "VST_VLD"
// CHECK-NEXT: {{.*}}pto.vlds
// CHECK: return
// CHECK-LABEL: func.func @forward(
// CHECK: pto.vsstb
// CHECK-NEXT: pto.mem_bar "VST_VLD"
// CHECK-NEXT: {{.*}}pto.vlds
// CHECK: return
// CHECK-LABEL: func.func @stationary(
// CHECK: pto.vsstb
// CHECK-NOT: pto.mem_bar
// CHECK: pto.vlds
// CHECK: return
