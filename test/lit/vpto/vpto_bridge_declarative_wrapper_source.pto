// Generic declarative renderer litmus: the built-in whitelist registers the
// matmul wrapper in the wrappers section (includes + core guard) and its
// entries carry only call/tmpl_args/abi, yet the rendered wrapper source is
// semantically identical to the old hardcoded matmul renderer -- the same
// includes, the same role-named tile typedefs (sorted by target name), the
// same cube guard and the same TASSIGN-bound TMATMUL call with the merged
// acc phase template argument. No C++ renderer knows 'matmul' anymore.

// RUN: env -u PTOAS_VPTO_BRIDGE_WHITELIST pto-test-opt %s -pto-lower-declarative-bridge-ops -pto-emit-vpto-bridge-wrapper | FileCheck %s

// CHECK: module attributes {{{.*}}pto.vpto.bridge.wrapper_source = "
// CHECK-SAME: #include <pto/pto-inst.hpp>
// CHECK-SAME: #include <pto/npu/a5/TMatmul.hpp>
// CHECK-SAME: #include <stdint.h>
// CHECK-SAME: using LeftTile = pto::Tile<pto::TileType::Left, half, 16, 16, pto::BLayout::ColMajor, 16, 16, pto::SLayout::RowMajor, 512>;
// CHECK-SAME: using ResultTile = pto::Tile<pto::TileType::Acc, float, 16, 16, pto::BLayout::ColMajor, 16, 16, pto::SLayout::RowMajor, 1024>;
// CHECK-SAME: using RightTile = pto::Tile<pto::TileType::Right, half, 16, 16, pto::BLayout::RowMajor, 16, 16, pto::SLayout::ColMajor, 512>;
// CHECK-SAME: #ifdef __DAV_CUBE__
// CHECK-SAME: extern \22C\22 [aicore] void pto_vpto_matmul(uint64_t dstAddress, uint64_t lhsAddress, uint64_t rhsAddress)
// CHECK-SAME: ResultTile dst;
// CHECK-SAME: LeftTile lhs;
// CHECK-SAME: RightTile rhs;
// CHECK-SAME: pto::TASSIGN_IMPL(dst, dstAddress);
// CHECK-SAME: pto::TASSIGN_IMPL(lhs, lhsAddress);
// CHECK-SAME: pto::TASSIGN_IMPL(rhs, rhsAddress);
// CHECK-SAME: pto::TMATMUL<pto::AccPhase::Final>(dst, lhs, rhs);
// CHECK-SAME: #endif
// CHECK-NOT: pto.vpto.bridge.spec

module attributes {pto.target_arch = "a5"} {
  func.func private @declarative_matmul_cube(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c0 = arith.constant 0 : i64
    %c1024 = arith.constant 1024 : i64
    %c2048 = arith.constant 2048 : i64
    %lhs = pto.alloc_tile addr = %c0
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %rhs = pto.alloc_tile addr = %c1024
      : !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %acc = pto.alloc_tile addr = %c2048
      : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    pto.tmatmul ins(%lhs, %rhs
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>,
        !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      outs(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                                blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
      {accPhase = #pto<acc_phase final>}
    return
  }
}
