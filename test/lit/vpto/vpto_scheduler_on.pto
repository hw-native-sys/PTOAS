// RUN: pto-test-opt %s '-pto-vpto-scheduler=mode=on trace=true' > %t 2> %t.trace
// RUN: FileCheck %s --check-prefix=ORDER < %t
// RUN: FileCheck %s --check-prefix=TRACE < %t.trace
// RUN: pto-test-opt %s '-pto-vpto-scheduler=mode=off' > %t.off
// RUN: pto-test-opt %s '-pto-vpto-scheduler=mode=analyze' > %t.analyze-ir 2> %t.analyze
// RUN: diff %t.off %t.analyze-ir
// RUN: FileCheck %s --check-prefix=ANALYZE < %t.analyze
// RUN: pto-test-opt %s '-pto-vpto-scheduler=mode=on' > %t.again 2> %t.quiet
// RUN: diff %t %t.again
// RUN: FileCheck %s --check-prefix=QUIET --allow-empty < %t.quiet

// ORDER-LABEL: func.func @aabbcc
// ORDER: pto.vmax
// ORDER-NEXT: pto.vmax
// ORDER-NEXT: pto.vmin
// ORDER-NEXT: pto.vmin
// ORDER-NEXT: pto.vmax
// ORDER-NEXT: pto.vmax

// ORDER-LABEL: func.func @pressure_tie
// ORDER: pto.vcmp
// ORDER-NEXT: pto.vmax
// ORDER-NEXT: pto.vsel
// ORDER-NEXT: pto.vcmp

// ORDER-LABEL: func.func @pressure_idle
// ORDER-COUNT-6: pto.vcmp
// ORDER-NEXT: pto.vsel

// TRACE: vpto-scheduler: function=aabbcc mode=on target=a5 model=generic-a5-v4
// TRACE: vpto-scheduler: region=0 before=block-start after=block-end nodes=6
// TRACE: vpto-scheduler: pressure node=0
// TRACE: vpto-scheduler: schedule-result block=0 region=0 nodes=6 work-units={{[0-9]+}}
// TRACE: result-position=0 node=0 original-index=0 cycle=0 direction=top reason=deterministic-tie-break op=pto.vmax
// TRACE-NEXT: vpto-scheduler: result-position=1 node=3 original-index=3 cycle=0 direction=top reason=only-candidate op=pto.vmax
// TRACE-NEXT: vpto-scheduler: result-position=2 node=1 original-index=1 cycle=10 direction=top reason=lower-pressure-delta op=pto.vmin
// TRACE-NEXT: vpto-scheduler: result-position=3 node=4 original-index=4 cycle=10 direction=top reason=only-candidate op=pto.vmin
// TRACE-NEXT: vpto-scheduler: result-position=4 node=2 original-index=2 cycle=20 direction=top reason=deterministic-tie-break op=pto.vmax
// TRACE-NEXT: vpto-scheduler: result-position=5 node=5 original-index=5 cycle=20 direction=top reason=only-candidate op=pto.vmax
// TRACE: vpto-scheduler: function=pressure_tie mode=on
// TRACE: result-position=2 node=3 original-index=3 cycle=10 direction=top reason=lower-pressure-delta op=pto.vsel
// TRACE-NEXT: vpto-scheduler: result-position=3 node=2 original-index=2 cycle=10 direction=top reason=only-candidate op=pto.vcmp
// TRACE: vpto-scheduler: function=pressure_idle mode=on
// TRACE: vpto-scheduler: schedule-result block=0 region=0 nodes=18 work-units={{[0-9]+}} pressure-idles=2 peak={vector:2,predicate:4}
// TRACE: vpto-scheduler: result-position=3 node=9 original-index=9 cycle=10 direction=top reason={{[^ ]+}} op=pto.vsel pressure-idle=true
// TRACE: vpto-scheduler: result-position=9 node=12 original-index=12 cycle=20 direction=top reason={{[^ ]+}} op=pto.vsel pressure-idle=true

// ANALYZE: vpto-scheduler: function=aabbcc mode=analyze target=a5 model=generic-a5-v4
// ANALYZE: vpto-scheduler: region=0 before=block-start after=block-end nodes=6
// ANALYZE: vpto-scheduler: pressure node=0
// ANALYZE-NOT: schedule-result
// ANALYZE-NOT: result-position=
// ANALYZE: vpto-scheduler: coverage

// QUIET-NOT: vpto-scheduler:

module attributes {pto.target_arch = "a5"} {
  func.func @aabbcc(%x0: !pto.vreg<64xf32>, %x1: !pto.vreg<64xf32>,
                    %x2: !pto.vreg<64xf32>, %active: !pto.mask<b32>) {
    pto.vecscope {
      %a0 = pto.vmax %x0, %x1, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %b0 = pto.vmin %a0, %x1, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %c0 = pto.vmax %b0, %x2, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %a1 = pto.vmax %x1, %x2, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %b1 = pto.vmin %a1, %x2, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %c1 = pto.vmax %b1, %x0, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
    }
    return
  }

  func.func @pressure_tie(%x0: !pto.vreg<64xf32>,
                          %x1: !pto.vreg<64xf32>,
                          %active: !pto.mask<b32>) {
    pto.vecscope {
      %p0 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %trigger = pto.vmax %x0, %x1, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %new = pto.vcmp %trigger, %x1, %active, "gt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %consume = pto.vsel %x0, %x1, %p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %new_user = pto.vsel %trigger, %x1, %new : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %consume_user = pto.vmax %consume, %x1, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
    }
    return
  }

  func.func @pressure_idle(%x0: !pto.vreg<64xf32>,
                           %x1: !pto.vreg<64xf32>,
                           %active: !pto.mask<b32>) {
    pto.vecscope {
      %p0 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p1 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p2 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p3 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p4 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p5 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p6 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p7 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p8 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %s0 = pto.vsel %x0, %x1, %p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %s1 = pto.vsel %x0, %x1, %p1 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %s2 = pto.vsel %x0, %x1, %p2 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %s3 = pto.vsel %x0, %x1, %p3 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %s4 = pto.vsel %x0, %x1, %p4 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %s5 = pto.vsel %x0, %x1, %p5 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %s6 = pto.vsel %x0, %x1, %p6 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %s7 = pto.vsel %x0, %x1, %p7 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %s8 = pto.vsel %x0, %x1, %p8 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
    }
    return
  }
}
