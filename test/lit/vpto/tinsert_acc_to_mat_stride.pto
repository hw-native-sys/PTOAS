// ACC-to-MAT FIXPIPE strides must reach hardware in C0 units / elements.
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s
// CHECK-LABEL: func.func @insert_acc_mat_stride
// CHECK-DAG: %[[XM:.*]] = arith.constant 549756862720 : i64
// CHECK-DAG: %[[XT:.*]] = arith.constant 4398046511120 : i64
// CHECK: pto.copy_matrix_cc_to_cbuf {{.*}}, %[[XM]], %[[XT]]

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @insert_acc_mat_stride() attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %src = pto.alloc_tile : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>
    %dst = pto.alloc_tile : !pto.tile_buf<mat, 16x16xf32, blayout=col_major, slayout=row_major, fractal=512>
    pto.tinsert ins(%src, %c0, %c0 : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>, index, index)
      outs(%dst : !pto.tile_buf<mat, 16x16xf32, blayout=col_major, slayout=row_major, fractal=512>)
    return
  }
}
