// pto.mte_gm_l1 has no pad group, so an unaligned constant len_burst leaves the\n// L1 tail block holding source data. Warn instead of rejecting the op.
// RUN: pto-test-opt %s 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  // CHECK: warning: pto.mte_gm_l1 len_burst (16 bytes) is not a multiple of 32
  func.func @mte_gm_l1_unaligned_probe(%src: !pto.ptr<f16, gm>, %dst: !pto.ptr<f16, l1>) {
    %c1_i64 = arith.constant 1 : i64
    %c16_i64 = arith.constant 16 : i64
    pto.mte_gm_l1 %src, %dst, %c16_i64
      nburst(%c1_i64, %c16_i64, %c16_i64)
      : !pto.ptr<f16, gm>, !pto.ptr<f16, l1>, i64, i64, i64, i64
    return
  }
}
