// RUN: not pto-test-opt %s -split-input-file 2>&1 | FileCheck %s

module {
  func.func @plds_requires_matching_updated_base(%src: !pto.ptr<i8, ub>) {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %mask, %next = pto.plds %src[%c0], "NORM"
          : !pto.ptr<i8, ub>, index -> !pto.mask<b8>, !pto.ptr<i16, ub>
    }
    return
  }
}

// CHECK: 'pto.plds' op requires updated base result to match base type

// -----

module {
  func.func @pldi_requires_matching_updated_base(%src: !pto.ptr<i8, ub>) {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %mask, %next = pto.pldi %src[%c0], "NORM"
          : !pto.ptr<i8, ub>, index -> !pto.mask<b8>, !pto.ptr<i16, ub>
    }
    return
  }
}

// CHECK: 'pto.pldi' op requires updated base result to match base type

// -----

module {
  func.func @psts_requires_matching_updated_base(
      %mask: !pto.mask<b8>, %dst: !pto.ptr<i8, ub>) {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %next = pto.psts %mask, %dst[%c0], "NORM"
          : !pto.mask<b8>, !pto.ptr<i8, ub>, index -> !pto.ptr<i16, ub>
    }
    return
  }
}

// CHECK: 'pto.psts' op requires updated base result to match base type

// -----

module {
  func.func @psti_requires_matching_updated_base(
      %mask: !pto.mask<b8>, %dst: !pto.ptr<i8, ub>) {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %next = pto.psti %mask, %dst[%c0], "NORM"
          : !pto.mask<b8>, !pto.ptr<i8, ub>, index -> !pto.ptr<i16, ub>
    }
    return
  }
}

// CHECK: 'pto.psti' op requires updated base result to match base type
