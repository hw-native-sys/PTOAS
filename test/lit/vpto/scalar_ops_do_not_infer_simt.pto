// Execution-domain-independent scalar value and PTO-pointer operations must
// not cause the uncovered-section pass to infer a SIMT/vector kernel kind.
// RUN: pto-test-opt --pto-normalize-uncovered-tile-sections %s | FileCheck %s

module {
  func.func @scalar_value_ops(%lhs: f32, %rhs: f32) -> f32 {
    %one = pto.constant 1.000000e+00 : f32
    %sum = pto.addf %lhs, %one : f32
    %ordered = pto.cmpf gt %sum, %rhs : f32
    %max = pto.maxf %sum, %rhs : f32
    %root = pto.sqrt %max : f32 -> f32
    return %root : f32
  }

  func.func @scalar_pointer_ops(%ptr: !pto.ptr<f32, ub>) -> f32 {
    %c0 = arith.constant 0 : index
    %value = pto.load %ptr[%c0] : !pto.ptr<f32, ub> -> f32
    pto.store %value, %ptr[%c0] : !pto.ptr<f32, ub>, f32
    return %value : f32
  }
}

// CHECK: module {
// CHECK-NOT: pto.kernel_kind
// CHECK: func.func @scalar_value_ops
// CHECK-NOT: pto.kernel_kind
// CHECK: pto.constant
// CHECK: pto.addf
// CHECK: pto.cmpf gt
// CHECK: pto.maxf
// CHECK: pto.sqrt
// CHECK: func.func @scalar_pointer_ops
// CHECK-NOT: pto.kernel_kind
// CHECK: pto.load
// CHECK: pto.store
