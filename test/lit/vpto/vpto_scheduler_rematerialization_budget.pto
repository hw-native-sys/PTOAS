// RUN: pto-test-opt %s '-pto-vpto-scheduler=mode=on trace=true rematerialize=true' > %t 2> %t.trace
// RUN: FileCheck %s --check-prefix=IR < %t
// RUN: FileCheck %s --check-prefix=TRACE < %t.trace

// IR-LABEL: func.func @remat_candidate_budget
// IR: pto.vci
// IR-COUNT-48: pto.vadds
// IR: scf.for
// IR-NOT: pto.vci

// TRACE: vpto-scheduler: remat-partial-plan reason=insufficient-estimated-relief selected=16 clones=32 dynamic-micro-ops=64
// TRACE: vpto-scheduler: remat-summary function=remat_candidate_budget changed=true high-regions=2 selected=16 groups=16 clones=32 dynamic-micro-ops=64
// TRACE: vpto-scheduler: remat-result function=remat_candidate_budget accepted=false initial-peak=48 final-peak=33 second-schedule=success
// TRACE-SAME: pressure-over-limit=vector

module attributes {pto.target_arch = "a5"} {
  func.func @remat_candidate_budget() {
    %zero = arith.constant 0 : i32
    %lower = arith.constant 0 : index
    %upper = arith.constant 2 : index
    %step = arith.constant 1 : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %root = pto.vci %zero : i32 -> !pto.vreg<64xi32>
      %index0 = pto.vadds %root, %zero, %mask : !pto.vreg<64xi32>, i32, !pto.mask<b32> -> !pto.vreg<64xi32>
      %index1 = pto.vadds %root, %zero, %mask : !pto.vreg<64xi32>, i32, !pto.mask<b32> -> !pto.vreg<64xi32>
