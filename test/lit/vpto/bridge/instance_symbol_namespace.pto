// Independent units must link normally even when both start at instance zero.
// The helper also checks deterministic names, location independence, different
// specializations, matching C++/IR symbols, and same-unit deduplication.
// Global IR printing options must preserve names and include dense payloads.
// No CANN, device or host JIT is needed; lit adds LLVM tools to PATH.
// RUN: bash "%S/Inputs/check_bridge_symbol_namespace.sh" "%s" "%t" %python "pto-test-opt" llvm-link

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.namespace_payload = dense<[1, 2]> : tensor<2xi32>} {
  func.func @unit_a(%local: i32) {
    %pipe0 = pto.initialize_l2l_pipe {dir_mask = 2, slot_size = 1024, slot_num = 8, flag_base = 0, nosplit = true}(%local : i32) -> !pto.pipe
    %pipe1 = pto.initialize_l2l_pipe {dir_mask = 2, slot_size = 1024, slot_num = 8, flag_base = 0, nosplit = true}(%local : i32) -> !pto.pipe
    return
  }
}
