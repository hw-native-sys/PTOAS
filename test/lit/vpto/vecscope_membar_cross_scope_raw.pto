// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar %s -o - 2>/dev/null | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @cross_scope_raw() {
    %c0 = arith.constant 0 : index
    %c0_i64 = arith.constant 0 : i64
    %c256_i64 = arith.constant 256 : i64
    %c512_i64 = arith.constant 512 : i64
    %ub0 = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %ub1 = pto.castptr %c256_i64 : i64 -> !pto.ptr<f32, ub>
    %ub2 = pto.castptr %c512_i64 : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %value = pto.vlds %ub1[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %value, %ub0[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %value = pto.vlds %ub0[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %value, %ub2[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }

  func.func @cross_scope_disjoint() {
    %c0 = arith.constant 0 : index
    %c0_i64 = arith.constant 0 : i64
    %c256_i64 = arith.constant 256 : i64
    %c512_i64 = arith.constant 512 : i64
    %ub0 = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %ub1 = pto.castptr %c256_i64 : i64 -> !pto.ptr<f32, ub>
    %ub2 = pto.castptr %c512_i64 : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %value = pto.vlds %ub0[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %value, %ub1[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %value = pto.vlds %ub2[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %value, %ub2[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }

  func.func @cross_scope_waw() {
    %c0 = arith.constant 0 : index
    %c0_i64 = arith.constant 0 : i64
    %c256_i64 = arith.constant 256 : i64
    %ub0 = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %ub1 = pto.castptr %c256_i64 : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %value = pto.vlds %ub1[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %value, %ub0[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %value = pto.vlds %ub1[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %value, %ub0[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }

  func.func @cross_scope_war() {
    %c0 = arith.constant 0 : index
    %c0_i64 = arith.constant 0 : i64
    %c256_i64 = arith.constant 256 : i64
    %c512_i64 = arith.constant 512 : i64
    %ub0 = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %ub1 = pto.castptr %c256_i64 : i64 -> !pto.ptr<f32, ub>
    %ub2 = pto.castptr %c512_i64 : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %value = pto.vlds %ub0[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %value, %ub1[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %value = pto.vlds %ub2[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %value, %ub0[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }
}

// CHECK-LABEL: func.func @cross_scope_raw
// CHECK: pto.vecscope {
// CHECK: pto.vsts
// CHECK: pto.vecscope {
// CHECK-NEXT: pto.mem_bar "VST_VLD"
// CHECK: pto.vlds
// CHECK-LABEL: func.func @cross_scope_disjoint
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-LABEL: func.func @cross_scope_waw
// CHECK: pto.vecscope {
// CHECK: pto.vsts
// CHECK: pto.vecscope {
// CHECK-NEXT: pto.mem_bar "VST_VST"
// CHECK: pto.vsts
// CHECK-LABEL: func.func @cross_scope_war
// CHECK: pto.vecscope {
// CHECK: pto.vlds
// CHECK: pto.vecscope {
// CHECK-NEXT: pto.mem_bar "VLD_VST"
// CHECK: pto.vsts
