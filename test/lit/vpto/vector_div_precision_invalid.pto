// RUN: pto-test-opt --split-input-file --verify-diagnostics %s

module attributes {pto.target_arch = "a5"} {
  func.func @invalid(%a: !pto.vreg<64xi32>, %b: !pto.vreg<64xi32>, %mask: !pto.mask<b32>) {
    // expected-error @+1 {{high_precision currently requires f32 vector operands}}
    %q = pto.vdiv %a, %b, %mask {precisionType = #pto<div_precision high_precision>} : !pto.vreg<64xi32>, !pto.vreg<64xi32>, !pto.mask<b32> -> !pto.vreg<64xi32>
    return
  }
}

// -----

module attributes {pto.target_arch = "a5"} {
  func.func @invalid(%a: !pto.vreg<64xf32>, %b: !pto.vreg<64xf32>, %mask: !pto.mask<b16>) {
    // expected-error @+1 {{high_precision f32 requires a b32 mask}}
    %q = pto.vdiv %a, %b, %mask {precisionType = #pto<div_precision high_precision>} : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b16> -> !pto.vreg<64xf32>
    return
  }
}
