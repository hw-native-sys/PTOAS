// RUN: not pto-test-opt %s -pto-infer-vpto-vecscope 2>&1 | FileCheck %s

// Carrying a vector does not make a nested scalar-pipeline barrier legal in
// vector scope. Keep the escape diagnostic instead of swallowing the boundary.
module {
  func.func @vector_carrier_with_barrier(%end: index, %value: f32, %mask: !pto.mask<b32>, %dst: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %vec = pto.vdup %value, %mask : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
    %loop = scf.for %i = %c0 to %end step %c1 iter_args(%carry = %vec) -> (!pto.vreg<64xf32>) {
      pto.barrier #pto.pipe<PIPE_ALL>
      scf.yield %carry : !pto.vreg<64xf32>
    }
    pto.vsts %loop, %dst[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
    return
  }
}

// CHECK: error: 'pto.vdup' op cannot infer resultless pto.vecscope because VPTO vector-scope data cannot have external users
