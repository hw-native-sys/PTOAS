// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --enable-vpto-soft-postupdate --emit-vpto %s -o - | FileCheck %s

// An invalid zero-step pair drops only its first candidate. The second
// candidate is reused as the head of a later three-op run.
// CHECK-LABEL: func.func @restart_after_zero_pair
// CHECK: {{^ *}}%{{[^, ]+}} = pto.vlds {{%.*}}[%c0]
// CHECK: %{{.*}}, [[Z1:%[a-zA-Z0-9_]+]] = pto.vlds {{%.*}}[[[ZSTEP:%[a-zA-Z0-9_]+]]]
// CHECK: %{{.*}}, [[Z2:%[a-zA-Z0-9_]+]] = pto.vlds [[Z1]][[[ZSTEP]]]
// CHECK: %{{.*}} = pto.vlds [[Z2]][%c0]

// A valid pair that is too short is not rewritten. The candidate that breaks
// that tentative run becomes the head of the next run.
// CHECK-LABEL: func.func @restart_after_short_run
// CHECK: {{^ *}}%{{[^, ]+}} = pto.vlds {{%.*}}[%c0]
// CHECK: {{^ *}}%{{[^, ]+}} = pto.vlds {{%.*}}[[[BAD:%[a-zA-Z0-9_]+]]]
// CHECK: %{{.*}}, [[S1:%[a-zA-Z0-9_]+]] = pto.vlds {{%.*}}[[[SSTEP:%[a-zA-Z0-9_]+]]]
// CHECK: %{{.*}}, [[S2:%[a-zA-Z0-9_]+]] = pto.vlds [[S1]][[[SSTEP]]]
// CHECK: %{{.*}} = pto.vlds [[S2]][%c0]

// If a two-candidate tentative run is rejected, its second candidate must be
// retried as the head of an overlapping later run.
// CHECK-LABEL: func.func @restart_after_overlapping_short_run
// CHECK: {{^ *}}%{{[^, ]+}} = pto.vlds {{%.*}}[[[OBAD:%[a-zA-Z0-9_]+]]]
// CHECK: %{{.*}}, [[O1:%[a-zA-Z0-9_]+]] = pto.vlds {{%.*}}[[[OSTEP:%[a-zA-Z0-9_]+]]]
// CHECK: %{{.*}}, [[O2:%[a-zA-Z0-9_]+]] = pto.vlds [[O1]][[[OSTEP]]]
// CHECK: %{{.*}} = pto.vlds [[O2]][%c0]

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @restart_after_zero_pair(%src: !pto.ptr<f32, ub>, %sink: !pto.ptr<f32, ub>, %step_i32: i32) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %step = arith.index_cast %step_i32 : i32 to index
    %step2 = arith.addi %step, %step : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v0 = pto.vlds %src[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v0, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v1 = pto.vlds %src[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v1, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v2 = pto.vlds %src[%step] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v2, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v3 = pto.vlds %src[%step2] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v3, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }

  func.func @restart_after_short_run(%src: !pto.ptr<f32, ub>, %sink: !pto.ptr<f32, ub>, %bad: index, %step_i32: i32) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %step = arith.index_cast %step_i32 : i32 to index
    %step2 = arith.addi %step, %step : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v0 = pto.vlds %src[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v0, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v1 = pto.vlds %src[%bad] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v1, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v2 = pto.vlds %src[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v2, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v3 = pto.vlds %src[%step] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v3, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v4 = pto.vlds %src[%step2] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v4, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }

  func.func @restart_after_overlapping_short_run(%src: !pto.ptr<f32, ub>, %sink: !pto.ptr<f32, ub>, %bad: index, %step_i32: i32) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %step = arith.index_cast %step_i32 : i32 to index
    %step2 = arith.addi %step, %step : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v0 = pto.vlds %src[%bad] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v0, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v1 = pto.vlds %src[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v1, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v2 = pto.vlds %src[%step] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v2, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %v3 = pto.vlds %src[%step2] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %v3, %sink[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }
}
