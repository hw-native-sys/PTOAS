// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --emit-vpto %s -o - | FileCheck %s
// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --enable-vpto-soft-postupdate=false --emit-vpto %s -o - | FileCheck %s --check-prefix=DISABLED
// RUN: ptoas --help | FileCheck %s --check-prefix=HELP
// RUN: ptoas --enable-bisheng-soft-postupdate --help > /dev/null
// RUN: ptoas --enable-bisheng-soft-postupdate=false --help > /dev/null

// The CLI pipeline must normalize the index IV before soft-postupdate. Without
// that ordering the latter cannot consume the non-i16 address recurrence.
// CHECK-LABEL: func.func @cli_pipeline_order
// CHECK: scf.for {{.*}} iter_args({{%.*}} = %arg0)
// CHECK: pto.vlds {{.*}} -> !pto.vreg<256xui8>, !pto.ptr<ui8, ub>
// DISABLED-LABEL: func.func @cli_pipeline_order
// DISABLED: pto.vlds {{.*}} -> !pto.vreg<256xui8>
// DISABLED-NOT: pto.vlds {{.*}} -> !pto.vreg<256xui8>, !pto.ptr<ui8, ub>
// HELP: --enable-bisheng-soft-postupdate
// HELP-SAME: Enable Bisheng's LLVM-level vector auto post-update passes for VPTO device compilation; disabled by default because PTOAS performs the optimization before LLVM lowering
// HELP: --enable-vpto-soft-postupdate
// HELP-SAME: Enable VPTO soft post-update optimization (enabled by default; pass --enable-vpto-soft-postupdate=false to disable)

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @cli_pipeline_order(
      %base: !pto.ptr<ui8, ub>,
      %sink: !pto.ptr<ui8, ub>,
      %mask: !pto.mask<b8>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    pto.vecscope {
      scf.for %iv = %c0 to %c4 step %c1 {
        %value = pto.vlds %base[%iv]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
        pto.vsts %value, %sink[%c0], %mask
          : !pto.vreg<256xui8>, !pto.ptr<ui8, ub>, !pto.mask<b8>
      }
    }
    return
  }
}
