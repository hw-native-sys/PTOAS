// RUN: pto-test-opt %s --pto-insert-vecscope-membar | FileCheck %s
// RUN: pto-test-opt %s --pto-insert-vecscope-membar --pto-insert-vecscope-membar | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar=true %s -o - | FileCheck %s

module attributes {pto.target_arch = "a5"} {
// A pointer iter_arg changes address even though its SSA identity is shared.
// CHECK-LABEL: func.func @moving_root(
// CHECK: scf.for
// CHECK: pto.vlds
// CHECK: pto.mem_bar "VV_ALL"
// CHECK-NEXT: scf.yield
// CHECK: return
  func.func @moving_root(%p: !pto.ptr<f32, ub>, %n: i16, %data: !pto.vreg<64xf32>) {
    %z = arith.constant 0 : i16
    %one = arith.constant 1 : i16
    %two = arith.constant 2 : i16
    %bound = arith.minui %n, %two : i16
    %stride = arith.constant 128 : index
    %half = arith.constant 64 : index
    %sink = arith.constant 1024 : index
    %back = arith.constant -64 : index
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %end:2 = scf.for %i = %z to %bound step %one iter_args(%ptr = %p, %acc = %data) -> (!pto.ptr<f32, ub>, !pto.vreg<64xf32>) : i16 {
        %ii = arith.index_cast %i : i16 to index
        %off = arith.muli %ii, %stride : index
        %hi = arith.addi %off, %half : index
        pto.vsts %data, %ptr[%off], %all : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
        %v = pto.vlds %ptr[%hi] : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
        %sum = pto.vadd %acc, %v, %all : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
        %next = pto.addptr %ptr, %back : !pto.ptr<f32, ub>, index -> !pto.ptr<f32, ub>
        scf.yield %next, %sum : !pto.ptr<f32, ub>, !pto.vreg<64xf32>
      }
      pto.vsts %end#1, %p[%sink], %all : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
    }
    return
  }

// Constant relative offsets must not bypass the root-invariance check.
// CHECK-LABEL: func.func @constant_offset_moving_root(
// CHECK: scf.for
// CHECK: pto.vlds
// CHECK: pto.mem_bar "VV_ALL"
// CHECK-NEXT: scf.yield
// CHECK: return
  func.func @constant_offset_moving_root(%p: !pto.ptr<f32, ub>, %n: i16, %data: !pto.vreg<64xf32>) {
    %z = arith.constant 0 : i16
    %one = arith.constant 1 : i16
    %two = arith.constant 2 : i16
    %bound = arith.minui %n, %two : i16
    %half = arith.constant 64 : index
    %sink = arith.constant 1024 : index
    %back = arith.constant 64 : index
    %zidx = arith.constant 0 : index
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %end:2 = scf.for %i = %z to %bound step %one iter_args(%ptr = %p, %acc = %data) -> (!pto.ptr<f32, ub>, !pto.vreg<64xf32>) : i16 {
        pto.vsts %data, %ptr[%zidx], %all : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
        %v = pto.vlds %ptr[%half] : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
        %sum = pto.vadd %acc, %v, %all : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
        %next = pto.addptr %ptr, %back : !pto.ptr<f32, ub>, index -> !pto.ptr<f32, ub>
        scf.yield %next, %sum : !pto.ptr<f32, ub>, !pto.vreg<64xf32>
      }
      pto.vsts %end#1, %p[%sink], %all : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
    }
    return
  }

// The external root still allows disjoint increasing accesses to be proved.
// CHECK-LABEL: func.func @invariant_root(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @invariant_root(%p: !pto.ptr<f32, ub>, %n: i16, %data: !pto.vreg<64xf32>) {
    %z = arith.constant 0 : i16
    %one = arith.constant 1 : i16
    %two = arith.constant 2 : i16
    %bound = arith.minui %n, %two : i16
    %stride = arith.constant 128 : index
    %half = arith.constant 64 : index
    %sink = arith.constant 1024 : index
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %end = scf.for %i = %z to %bound step %one iter_args(%acc = %data) -> (!pto.vreg<64xf32>) : i16 {
        %ii = arith.index_cast %i : i16 to index
        %off = arith.muli %ii, %stride : index
        %hi = arith.addi %off, %half : index
        pto.vsts %data, %p[%off], %all : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
        %v = pto.vlds %p[%hi] : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
        %sum = pto.vadd %acc, %v, %all : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
        scf.yield %sum : !pto.vreg<64xf32>
      }
      pto.vsts %end, %p[%sink], %all : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
    }
    return
  }

// INTLV ignores PAT_VL1: its second 256-byte half overlaps the load.
// CHECK-LABEL: func.func @paired_dynamic(
// CHECK: pto.vstsx2
// CHECK-NEXT: pto.mem_bar "VST_VLD"
// CHECK-NEXT: {{.*}}pto.vlds
// CHECK: return
  func.func @paired_dynamic(%p: !pto.ptr<f32, ub>, %n: i16, %a: !pto.vreg<64xf32>, %b: !pto.vreg<64xf32>) {
    %z = arith.constant 0 : i16
    %one = arith.constant 1 : i16
    %three = arith.constant 3 : i16
    %bound = arith.minui %n, %three : i16
    %stride = arith.constant 128 : index
    %half = arith.constant 64 : index
    %sink = arith.constant 1024 : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_VL1" : !pto.mask<b32>
      %all = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      scf.for %i = %z to %bound step %one : i16 {
        %ii = arith.index_cast %i : i16 to index
        %off = arith.muli %ii, %stride : index
        %hi = arith.addi %off, %half : index
        pto.vstsx2 %a, %b, %p[%off], "INTLV_B32", %mask : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
        %v = pto.vlds %p[%hi] : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
        pto.vsts %v, %p[%sink], %all : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
      }
    }
    return
  }
}
