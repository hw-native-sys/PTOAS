// VUSQZ generates exclusive prefix counts; it has no SQZN operand and no #st
// hint (visa.txt:5682-5702), and the VPTO emitter emits it without a store
// hint. It therefore cannot produce SQZN for a VSTUR.
//
// RUN: not pto-test-opt %s 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vstur_with_vusqz_value(%value: !pto.vreg<64xi32>,
                                    %mask: !pto.mask<b32>,
                                    %dst: !pto.ptr<i32, ub>) {
    pto.vecscope {
      %idx = pto.vusqz %value, %mask
          : !pto.vreg<64xi32>, !pto.mask<b32> -> !pto.vreg<64xi32>
      %align = pto.init_align : !pto.align
      %next = pto.vstur %align, %idx, %dst, "NO_POST_UPDATE"
          : !pto.align, !pto.vreg<64xi32>, !pto.ptr<i32, ub> -> !pto.align
      pto.vstar %next, %dst : !pto.align, !pto.ptr<i32, ub>
    }
    return
  }
}

// CHECK: error: 'pto.vstur' op requires its value to be produced by a pto.vsqz (directly or through pto.vbitcast)
// CHECK-SAME: only VSQZ writes SQZN
