// Issue #1751: the f32-destination requirement of `nz2nz` belongs to the
// channel split (X_t[42] SPLIT_EN), not to the layout mode. Enabling the split
// on a non-f32 destination is still an illegal configuration.
//
// One invalid function per file: ptoas reports a nondeterministic subset of the
// per-function diagnostics when one module holds several failing functions, so
// this file (and its `pto.constant` sibling) each carry exactly one.

// RUN: not ptoas --pto-arch=a5 %s -o - 2>&1 | FileCheck %s

module attributes {"pto.target_arch" = "a5"} {
  func.func @acc_store_verify_invalid_nz2nz_split(%src: !pto.ptr<f32, l0c>,
                                                  %dst: !pto.ptr<bf16, l1>) {
    %c1_i64 = arith.constant 1 : i64
    %c16_i64 = arith.constant 16 : i64

    pto.mte_l0c_l1 %src, %dst, %c16_i64, %c16_i64, %c16_i64, %c16_i64, nz2nz(%c1_i64)
      : !pto.ptr<f32, l0c>, !pto.ptr<bf16, l1>, i64, i64, i64, i64, i64

    return
  }
}

// CHECK: nz2nz requires destination element type to be f32 when the channel split may be enabled
