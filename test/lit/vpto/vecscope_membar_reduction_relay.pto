// RUN: pto-test-opt --pto-insert-vecscope-membar %s | FileCheck %s
// RUN: pto-test-opt --pto-insert-vecscope-membar --pto-insert-vecscope-membar %s | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar=true %s | FileCheck %s

!mb32 = !pto.mask<b32>
!pf32ub = !pto.ptr<f32, ub>
!v64xf32 = !pto.vreg<64xf32>

module {
// CHECK-LABEL: func.func @last_iteration_only(
// CHECK: pto.mem_bar "VV_ALL"
// CHECK: return
func.func @last_iteration_only() {
  %c0 = arith.constant 0 : index
  %c1 = arith.constant 1 : index
  %c2 = arith.constant 2 : index
  %c64 = arith.constant 64 : index
  %a0 = arith.constant 0 : i64
  %b0 = arith.constant 4096 : i64
  %d0 = arith.constant 8192 : i64
  %f0 = arith.constant 0.0 : f32
  %a = pto.castptr %a0 : i64 -> !pf32ub
  %b = pto.castptr %b0 : i64 -> !pf32ub
  %d = pto.castptr %d0 : i64 -> !pf32ub
  pto.vecscope {
    %m = pto.pset_b32 "PAT_ALL" : !mb32
    %zero = pto.vdup %f0, %m : f32, !mb32 -> !v64xf32
    %sum = scf.for %i = %c0 to %c2 step %c1 iter_args(%acc = %zero) -> (!v64xf32) {
      %off = arith.muli %i, %c64 : index
      %v = pto.vlds %a[%off] : !pf32ub, index -> !v64xf32
      %next = pto.vadd %zero, %v, %m : !v64xf32, !v64xf32, !mb32 -> !v64xf32
      scf.yield %next : !v64xf32
    }
    pto.vsts %sum, %b[%c0], %m : !v64xf32, !pf32ub, index, !mb32
    pto.mem_bar "VST_VLD"
    %s = pto.vlds %b[%c0] : !pf32ub, index -> !v64xf32
    pto.vsts %s, %d[%c0], %m : !v64xf32, !pf32ub, index, !mb32
    pto.mem_bar "VST_VLD"
    scf.for %j = %c0 to %c2 step %c1 {
      %off = arith.muli %j, %c64 : index
      %s2 = pto.vlds %d[%c0] : !pf32ub, index -> !v64xf32
      pto.vsts %s2, %a[%off], %m : !v64xf32, !pf32ub, index, !mb32
    }
  }
  return
}

// CHECK-LABEL: func.func @possibly_empty_reduction(
// CHECK: pto.mem_bar "VV_ALL"
// CHECK: return
func.func @possibly_empty_reduction(%n: index) {
  %c0 = arith.constant 0 : index
  %c1 = arith.constant 1 : index
  %c2 = arith.constant 2 : index
  %c64 = arith.constant 64 : index
  %a0 = arith.constant 0 : i64
  %b0 = arith.constant 4096 : i64
  %d0 = arith.constant 8192 : i64
  %f0 = arith.constant 0.0 : f32
  %a = pto.castptr %a0 : i64 -> !pf32ub
  %b = pto.castptr %b0 : i64 -> !pf32ub
  %d = pto.castptr %d0 : i64 -> !pf32ub
  pto.vecscope {
    %m = pto.pset_b32 "PAT_ALL" : !mb32
    %zero = pto.vdup %f0, %m : f32, !mb32 -> !v64xf32
    %sum = scf.for %i = %c0 to %n step %c1 iter_args(%acc = %zero) -> (!v64xf32) {
      %off = arith.muli %i, %c64 : index
      %v = pto.vlds %a[%off] : !pf32ub, index -> !v64xf32
      %next = pto.vadd %acc, %v, %m : !v64xf32, !v64xf32, !mb32 -> !v64xf32
      scf.yield %next : !v64xf32
    }
    pto.vsts %sum, %b[%c0], %m : !v64xf32, !pf32ub, index, !mb32
    pto.mem_bar "VST_VLD"
    %s = pto.vlds %b[%c0] : !pf32ub, index -> !v64xf32
    pto.vsts %s, %d[%c0], %m : !v64xf32, !pf32ub, index, !mb32
    pto.mem_bar "VST_VLD"
    scf.for %j = %c0 to %c2 step %c1 {
      %off = arith.muli %j, %c64 : index
      %s2 = pto.vlds %d[%c0] : !pf32ub, index -> !v64xf32
      pto.vsts %s2, %a[%off], %m : !v64xf32, !pf32ub, index, !mb32
    }
  }
  return
}

// CHECK-LABEL: func.func @empty_middle_relay(
// CHECK-NOT: pto.mem_bar
// CHECK: pto.mem_bar "VST_VLD"
// CHECK-NOT: pto.mem_bar
// CHECK: pto.mem_bar "VST_VLD"
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
func.func @empty_middle_relay() {
  %c0 = arith.constant 0 : index
  %c1 = arith.constant 1 : index
  %c2 = arith.constant 2 : index
  %c64 = arith.constant 64 : index
  %a0 = arith.constant 0 : i64
  %b0 = arith.constant 4096 : i64
  %d0 = arith.constant 8192 : i64
  %f0 = arith.constant 0.0 : f32
  %a = pto.castptr %a0 : i64 -> !pf32ub
  %b = pto.castptr %b0 : i64 -> !pf32ub
  %d = pto.castptr %d0 : i64 -> !pf32ub
  pto.vecscope {
    %m = pto.pset_b32 "PAT_ALL" : !mb32
    %zero = pto.vdup %f0, %m : f32, !mb32 -> !v64xf32
    %sum = scf.for %i = %c0 to %c2 step %c1 iter_args(%acc = %zero) -> (!v64xf32) {
      %off = arith.muli %i, %c64 : index
      %v = pto.vlds %a[%off] : !pf32ub, index -> !v64xf32
      %next = pto.vadd %acc, %v, %m : !v64xf32, !v64xf32, !mb32 -> !v64xf32
      scf.yield %next : !v64xf32
    }
    pto.vsts %sum, %b[%c0], %m : !v64xf32, !pf32ub, index, !mb32
    pto.mem_bar "VST_VLD"
    scf.for %k = %c0 to %c0 step %c1 {
      %s = pto.vlds %b[%c0] : !pf32ub, index -> !v64xf32
      pto.vsts %s, %d[%c0], %m : !v64xf32, !pf32ub, index, !mb32
    }
    pto.mem_bar "VST_VLD"
    scf.for %j = %c0 to %c2 step %c1 {
      %off = arith.muli %j, %c64 : index
      %s2 = pto.vlds %d[%c0] : !pf32ub, index -> !v64xf32
      pto.vsts %s2, %a[%off], %m : !v64xf32, !pf32ub, index, !mb32
    }
  }
  return
}

// CHECK-LABEL: func.func @nonempty_middle_relay(
// CHECK-NOT: pto.mem_bar
// CHECK: pto.mem_bar "VST_VLD"
// CHECK-NOT: pto.mem_bar
// CHECK: pto.mem_bar "VST_VLD"
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
func.func @nonempty_middle_relay() {
  %c0 = arith.constant 0 : index
  %c1 = arith.constant 1 : index
  %c2 = arith.constant 2 : index
  %c64 = arith.constant 64 : index
  %a0 = arith.constant 0 : i64
  %b0 = arith.constant 4096 : i64
  %d0 = arith.constant 8192 : i64
  %f0 = arith.constant 0.0 : f32
  %a = pto.castptr %a0 : i64 -> !pf32ub
  %b = pto.castptr %b0 : i64 -> !pf32ub
  %d = pto.castptr %d0 : i64 -> !pf32ub
  pto.vecscope {
    %m = pto.pset_b32 "PAT_ALL" : !mb32
    %zero = pto.vdup %f0, %m : f32, !mb32 -> !v64xf32
    %sum = scf.for %i = %c0 to %c2 step %c1 iter_args(%acc = %zero) -> (!v64xf32) {
      %off = arith.muli %i, %c64 : index
      %v = pto.vlds %a[%off] : !pf32ub, index -> !v64xf32
      %next = pto.vadd %acc, %v, %m : !v64xf32, !v64xf32, !mb32 -> !v64xf32
      scf.yield %next : !v64xf32
    }
    pto.vsts %sum, %b[%c0], %m : !v64xf32, !pf32ub, index, !mb32
    pto.mem_bar "VST_VLD"
    scf.for %k = %c0 to %c1 step %c1 {
      %s = pto.vlds %b[%c0] : !pf32ub, index -> !v64xf32
      pto.vsts %s, %d[%c0], %m : !v64xf32, !pf32ub, index, !mb32
    }
    pto.mem_bar "VST_VLD"
    scf.for %j = %c0 to %c2 step %c1 {
      %off = arith.muli %j, %c64 : index
      %s2 = pto.vlds %d[%c0] : !pf32ub, index -> !v64xf32
      pto.vsts %s2, %a[%off], %m : !v64xf32, !pf32ub, index, !mb32
    }
  }
  return
}

// CHECK-LABEL: func.func @different_iter_arg_drops_history(
// CHECK: pto.mem_bar "VV_ALL"
// CHECK: return
func.func @different_iter_arg_drops_history() {
  %c0 = arith.constant 0 : index
  %c1 = arith.constant 1 : index
  %c2 = arith.constant 2 : index
  %c64 = arith.constant 64 : index
  %a0 = arith.constant 0 : i64
  %b0 = arith.constant 4096 : i64
  %d0 = arith.constant 8192 : i64
  %f0 = arith.constant 0.0 : f32
  %a = pto.castptr %a0 : i64 -> !pf32ub
  %b = pto.castptr %b0 : i64 -> !pf32ub
  %d = pto.castptr %d0 : i64 -> !pf32ub
  pto.vecscope {
    %m = pto.pset_b32 "PAT_ALL" : !mb32
    %zero = pto.vdup %f0, %m : f32, !mb32 -> !v64xf32
    %sum:2 = scf.for %i = %c0 to %c2 step %c1 iter_args(%acc = %zero, %other = %zero) -> (!v64xf32, !v64xf32) {
      %off = arith.muli %i, %c64 : index
      %v = pto.vlds %a[%off] : !pf32ub, index -> !v64xf32
      %next = pto.vadd %other, %v, %m : !v64xf32, !v64xf32, !mb32 -> !v64xf32
      scf.yield %next, %zero : !v64xf32, !v64xf32
    }
    pto.vsts %sum#0, %b[%c0], %m : !v64xf32, !pf32ub, index, !mb32
    pto.mem_bar "VST_VLD"
    %s = pto.vlds %b[%c0] : !pf32ub, index -> !v64xf32
    pto.vsts %s, %d[%c0], %m : !v64xf32, !pf32ub, index, !mb32
    pto.mem_bar "VST_VLD"
    scf.for %j = %c0 to %c2 step %c1 {
      %off = arith.muli %j, %c64 : index
      %s2 = pto.vlds %d[%c0] : !pf32ub, index -> !v64xf32
      pto.vsts %s2, %a[%off], %m : !v64xf32, !pf32ub, index, !mb32
    }
  }
  return
}
}
