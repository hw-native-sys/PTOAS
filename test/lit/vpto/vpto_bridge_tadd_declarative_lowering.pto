// Second declarative family, zero C++: pto.tadd rides the built-in
// whitelist registration (vec_elem wrapper + op/wrapper/call/abi entry)
// through the same declarative channel as matmul. No env, no pass option:
// the default whitelist routes the op, the pass collects the three vec
// tile roles into the per-function specialization and replaces the op
// with a bridge_call naming the entry derived from the op name
// (pto.tadd -> pto_vpto_add).

// RUN: env -u PTOAS_VPTO_BRIDGE_WHITELIST pto-test-opt %s -pto-lower-declarative-bridge-ops | FileCheck %s --check-prefix=SPEC

// SPEC-LABEL: func.func private @tadd_bridge_vec
// SPEC-SAME: pto.vpto.bridge.func_spec = {
// SPEC-SAME: entry.add = "pto_vpto_add"
// SPEC-SAME: left_tile = "pto::Tile<pto::TileType::Vec, float, 8, 16, pto::BLayout::RowMajor, 8, 16>"
// SPEC-SAME: result_tile = "pto::Tile<pto::TileType::Vec, float, 8, 16, pto::BLayout::RowMajor, 8, 16>"
// SPEC-SAME: right_tile = "pto::Tile<pto::TileType::Vec, float, 8, 16, pto::BLayout::RowMajor, 8, 16>"
// SPEC: pto.bridge_call "pto_vpto_add"
// SPEC-SAME: : i64, i64, i64
// SPEC-NOT: pto.tadd

module attributes {pto.target_arch = "a5"} {
  func.func private @tadd_bridge_vec(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c512 = arith.constant 512 : i64
    %c1024 = arith.constant 1024 : i64
    %src0 = pto.alloc_tile addr = %c0
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src1 = pto.alloc_tile addr = %c512
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile addr = %c1024
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tadd ins(%src0, %src1
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>,
        !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                                blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}
