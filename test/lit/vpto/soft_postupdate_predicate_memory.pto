// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --enable-vpto-soft-postupdate --emit-vpto %s -o - | FileCheck %s

// CHECK-LABEL: func.func @sequential_plds
// CHECK: %{{.*}}, [[PLDS1:%[a-zA-Z0-9_]+]] = pto.plds {{%.*}}[%c4]
// CHECK: %{{.*}}, [[PLDS2:%[a-zA-Z0-9_]+]] = pto.plds [[PLDS1]][%c4]
// CHECK: %{{.*}}, %{{.*}} = pto.plds [[PLDS2]][%c4]

// CHECK-LABEL: func.func @sequential_pldi
// CHECK: %{{.*}}, [[PLDI1:%[a-zA-Z0-9_]+]] = pto.pldi {{%.*}}[%c4]
// CHECK: %{{.*}}, [[PLDI2:%[a-zA-Z0-9_]+]] = pto.pldi [[PLDI1]][%c4]
// CHECK: %{{.*}}, %{{.*}} = pto.pldi [[PLDI2]][%c4]

// CHECK-LABEL: func.func @sequential_psts
// CHECK: [[PSTS1:%[a-zA-Z0-9_]+]] = pto.psts {{.*}}[%c4]
// CHECK: [[PSTS2:%[a-zA-Z0-9_]+]] = pto.psts {{.*}}[[PSTS1]][%c4]
// CHECK: %{{.*}} = pto.psts {{.*}}[[PSTS2]][%c4]

// CHECK-LABEL: func.func @sequential_psti
// CHECK: [[PSTI1:%[a-zA-Z0-9_]+]] = pto.psti {{.*}}[%c4]
// CHECK: [[PSTI2:%[a-zA-Z0-9_]+]] = pto.psti {{.*}}[[PSTI1]][%c4]
// CHECK: %{{.*}} = pto.psti {{.*}}[[PSTI2]][%c4]

// Immediate predicate offsets count 32-byte blocks. A 32-byte addptr step
// must therefore become post-update stride 1, not 32.
// CHECK-LABEL: func.func @immediate_base_steps_use_blocks
// CHECK: %{{.*}}, [[PLDI_BLOCK1:%[a-zA-Z0-9_]+]] = pto.pldi {{%.*}}[%c1]
// CHECK: %{{.*}}, [[PLDI_BLOCK2:%[a-zA-Z0-9_]+]] = pto.pldi [[PLDI_BLOCK1]][%c1]
// CHECK: %{{.*}}, %{{.*}} = pto.pldi [[PLDI_BLOCK2]][%c1]
// CHECK: [[PSTI_BLOCK1:%[a-zA-Z0-9_]+]] = pto.psti {{.*}}[%c1]
// CHECK: [[PSTI_BLOCK2:%[a-zA-Z0-9_]+]] = pto.psti {{.*}}[[PSTI_BLOCK1]][%c1]
// CHECK: %{{.*}} = pto.psti {{.*}}[[PSTI_BLOCK2]][%c1]

// Dynamic strides are legal for plds/psts but not for the immediate pldi/psti
// forms. The latter remain unchanged when their base step is symbolic.
// CHECK-LABEL: func.func @dynamic_immediate_stride_is_skipped
// CHECK: scf.for
// CHECK: {{^ *}}%{{[^, ]+}} = pto.pldi
// CHECK: {{^ *}}pto.psti

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @sequential_plds(%src: !pto.ptr<i8, ub>, %sink: !pto.ptr<i8, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    pto.vecscope {
      %m0 = pto.plds %src[%c0], "NORM" : !pto.ptr<i8, ub>, index -> !pto.mask<b8>
      pto.psti %m0, %sink[%c0], "NORM" : !pto.mask<b8>, !pto.ptr<i8, ub>, index
      %m1 = pto.plds %src[%c4], "NORM" : !pto.ptr<i8, ub>, index -> !pto.mask<b8>
      pto.psti %m1, %sink[%c0], "NORM" : !pto.mask<b8>, !pto.ptr<i8, ub>, index
      %m2 = pto.plds %src[%c8], "NORM" : !pto.ptr<i8, ub>, index -> !pto.mask<b8>
      pto.psti %m2, %sink[%c0], "NORM" : !pto.mask<b8>, !pto.ptr<i8, ub>, index
    }
    return
  }

  func.func @sequential_pldi(%src: !pto.ptr<i8, ub>, %sink: !pto.ptr<i8, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    pto.vecscope {
      %m0 = pto.pldi %src[%c0], "NORM" : !pto.ptr<i8, ub>, index -> !pto.mask<b8>
      pto.psti %m0, %sink[%c0], "NORM" : !pto.mask<b8>, !pto.ptr<i8, ub>, index
      %m1 = pto.pldi %src[%c4], "NORM" : !pto.ptr<i8, ub>, index -> !pto.mask<b8>
      pto.psti %m1, %sink[%c0], "NORM" : !pto.mask<b8>, !pto.ptr<i8, ub>, index
      %m2 = pto.pldi %src[%c8], "NORM" : !pto.ptr<i8, ub>, index -> !pto.mask<b8>
      pto.psti %m2, %sink[%c0], "NORM" : !pto.mask<b8>, !pto.ptr<i8, ub>, index
    }
    return
  }

  func.func @sequential_psts(%mask: !pto.mask<b8>, %dst: !pto.ptr<i8, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    pto.vecscope {
      pto.psts %mask, %dst[%c0], "NORM" : !pto.mask<b8>, !pto.ptr<i8, ub>, index
      pto.psts %mask, %dst[%c4], "NORM" : !pto.mask<b8>, !pto.ptr<i8, ub>, index
      pto.psts %mask, %dst[%c8], "NORM" : !pto.mask<b8>, !pto.ptr<i8, ub>, index
    }
    return
  }

  func.func @sequential_psti(%mask: !pto.mask<b8>, %dst: !pto.ptr<i8, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    pto.vecscope {
      pto.psti %mask, %dst[%c0], "NORM" : !pto.mask<b8>, !pto.ptr<i8, ub>, index
      pto.psti %mask, %dst[%c4], "NORM" : !pto.mask<b8>, !pto.ptr<i8, ub>, index
      pto.psti %mask, %dst[%c8], "NORM" : !pto.mask<b8>, !pto.ptr<i8, ub>, index
    }
    return
  }

  func.func @immediate_base_steps_use_blocks(
      %src: !pto.ptr<i8, ub>,
      %sink: !pto.ptr<i8, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %c64 = arith.constant 64 : index
    %src32 = pto.addptr %src, %c32
        : !pto.ptr<i8, ub> -> !pto.ptr<i8, ub>
    %src64 = pto.addptr %src, %c64
        : !pto.ptr<i8, ub> -> !pto.ptr<i8, ub>
    %sink32 = pto.addptr %sink, %c32
        : !pto.ptr<i8, ub> -> !pto.ptr<i8, ub>
    %sink64 = pto.addptr %sink, %c64
        : !pto.ptr<i8, ub> -> !pto.ptr<i8, ub>
    pto.vecscope {
      %m0 = pto.pldi %src[%c0], "NORM"
          : !pto.ptr<i8, ub>, index -> !pto.mask<b8>
      %m1 = pto.pldi %src32[%c0], "NORM"
          : !pto.ptr<i8, ub>, index -> !pto.mask<b8>
      %m2 = pto.pldi %src64[%c0], "NORM"
          : !pto.ptr<i8, ub>, index -> !pto.mask<b8>
      pto.psti %m0, %sink[%c0], "NORM"
          : !pto.mask<b8>, !pto.ptr<i8, ub>, index
      pto.psti %m1, %sink32[%c0], "NORM"
          : !pto.mask<b8>, !pto.ptr<i8, ub>, index
      pto.psti %m2, %sink64[%c0], "NORM"
          : !pto.mask<b8>, !pto.ptr<i8, ub>, index
    }
    return
  }

  func.func @dynamic_immediate_stride_is_skipped(
      %src: !pto.ptr<i8, ub>, %dst: !pto.ptr<i8, ub>, %step: index) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    pto.vecscope {
      scf.for %iv = %c0 to %c4 step %c1 {
        %scaled = arith.muli %iv, %step : index
        %src_at = pto.addptr %src, %scaled : !pto.ptr<i8, ub> -> !pto.ptr<i8, ub>
        %dst_at = pto.addptr %dst, %scaled : !pto.ptr<i8, ub> -> !pto.ptr<i8, ub>
        %mask = pto.pldi %src_at[%c0], "NORM"
            : !pto.ptr<i8, ub>, index -> !pto.mask<b8>
        pto.psti %mask, %dst_at[%c0], "NORM"
            : !pto.mask<b8>, !pto.ptr<i8, ub>, index
      }
    }
    return
  }
}
