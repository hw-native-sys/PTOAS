// Pipe family ops without a configured whitelist must fail with a clear
// diagnostic: pipe ops have no non-bridge VPTO lowering.

// RUN: not pto-test-opt %s -pto-lower-pipe-family-ops 2>&1 | FileCheck %s

// CHECK: error: pipe family ops present but no VPTO bridge whitelist configured

module {
  func.func private @no_whitelist_pipe(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %pipe = pto.initialize_l2l_pipe{dir_mask = 1, slot_size = 1024, slot_num = 8, flag_base = 0, nosplit = false} (%addr : i32) -> !pto.pipe
    pto.tfree(%pipe : !pto.pipe) {split = 1}
    return
  }
}
