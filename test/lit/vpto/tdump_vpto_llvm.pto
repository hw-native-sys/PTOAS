// pto.tdump lowers to a 64-byte metadata header written with scalar GM
// stores (llvm.hivm.stg.cache.b32) followed by a UB-to-GM DMA copy
// (llvm.hivm.MOV.UB.TO.OUT.*) of the raw tile data.
// RUN: ptoas --pto-arch=a3 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s
// RUN: ptoas --cann-output-version=9.0.0 --pto-arch=a3 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @tdump_vpto_llvm(%out: !pto.ptr<f32, gm>) attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %c16 = arith.constant 16 : index
    %tile = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %view = pto.make_tensor_view %out,
                shape = [%c8, %c16], strides = [%c16, %c1]
                {layout = #pto.layout<nd>}
              : !pto.tensor_view<?x?xf32>
    %part = pto.partition_view %view,
                offsets = [%c0, %c0], sizes = [%c8, %c16]
              : !pto.tensor_view<?x?xf32>
                -> !pto.partition_tensor_view<8x16xf32>
    pto.tdump ins(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
              outs(%part : !pto.partition_tensor_view<8x16xf32>)
    return
  }
}

// CHECK-DAG: declare {{.*}} @llvm.hivm.stg.cache.b32(
// CHECK-DAG: declare {{.*}} @llvm.hivm.MOV.UB.TO.OUT
// CHECK-LABEL: define void @tdump_vpto_llvm
// Data copy after the 64-byte header (main function).
// CHECK: call {{.*}} @llvm.hivm.MOV.UB.TO.OUT
// Header stores live in the outlined simt_entry helper below.
// Header magic "PTD0" (0x50544450 little-endian).
// CHECK: call void @llvm.hivm.stg.cache.b32({{.*}} i32 1347699792
// Header version 1.
// CHECK: call void @llvm.hivm.stg.cache.b32({{.*}} i32 1
