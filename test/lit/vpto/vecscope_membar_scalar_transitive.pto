// RUN: pto-test-opt --pto-insert-vecscope-membar %s -o %t
// RUN: FileCheck %s < %t
// RUN: pto-test-opt --pto-insert-vecscope-membar %t | FileCheck %s

// Preserve typed hazards when a fence or an unconditional SSA relay is absent.

module attributes {pto.target_arch = "a5"} {
  func.func @nonalias_fence_relay(%n: index, %cond: i1) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    %c512 = arith.constant 512 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %ub = pto.castptr %zero : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v = pto.vdup %one, %mask : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %v, %ub[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
      pto.vsts %v, %ub[%c256], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
      %s = pto.load %ub[%c0] : !pto.ptr<f32, ub>, index -> f32
      pto.store %s, %ub[%c256] : !pto.ptr<f32, ub>, index, f32
      %reload = pto.load %ub[%c256] : !pto.ptr<f32, ub>, index -> f32
      pto.store %reload, %ub[%c512] : !pto.ptr<f32, ub>, index, f32
    }
    return
  }

  func.func @missing_value_relay(%n: index, %cond: i1) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    %c512 = arith.constant 512 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %ub = pto.castptr %zero : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v = pto.vdup %one, %mask : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %v, %ub[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
      pto.vsts %v, %ub[%c256], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
      %s = pto.load %ub[%c0] : !pto.ptr<f32, ub>, index -> f32
      pto.store %one, %ub[%c256] : !pto.ptr<f32, ub>, index, f32
      pto.store %s, %ub[%c512] : !pto.ptr<f32, ub>, index, f32
    }
    return
  }

  func.func @producer_after_fence(%n: index, %cond: i1) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    %c512 = arith.constant 512 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %ub = pto.castptr %zero : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v = pto.vdup %one, %mask : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %v, %ub[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
      %s = pto.load %ub[%c0] : !pto.ptr<f32, ub>, index -> f32
      pto.vsts %v, %ub[%c256], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
      pto.store %s, %ub[%c256] : !pto.ptr<f32, ub>, index, f32
    }
    return
  }

  func.func @wrong_fence_family(%n: index, %cond: i1) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    %c512 = arith.constant 512 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %ub = pto.castptr %zero : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v = pto.vdup %one, %mask : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %v, %ub[%c256], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
      pto.mem_bar "VST_VLD"
      %s = pto.load %ub[%c0] : !pto.ptr<f32, ub>, index -> f32
      pto.store %s, %ub[%c256] : !pto.ptr<f32, ub>, index, f32
    }
    return
  }

  func.func @existing_fence_relay(%n: index, %cond: i1) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    %c512 = arith.constant 512 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %ub = pto.castptr %zero : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v = pto.vdup %one, %mask : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %v, %ub[%c256], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
      pto.mem_bar "VST_LD"
      %s = pto.load %ub[%c0] : !pto.ptr<f32, ub>, index -> f32
      pto.store %s, %ub[%c256] : !pto.ptr<f32, ub>, index, f32
    }
    return
  }

  func.func @possibly_empty_relay(%n: index, %cond: i1) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    %c512 = arith.constant 512 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %ub = pto.castptr %zero : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v = pto.vdup %one, %mask : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %v, %ub[%c256], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
      %s = scf.for %i = %c0 to %n step %c1 iter_args(%acc = %one) -> (f32) {
        pto.mem_bar "VST_LD"
        %x = pto.load %ub[%c0] : !pto.ptr<f32, ub>, index -> f32
        scf.yield %x : f32
      }
      pto.store %s, %ub[%c256] : !pto.ptr<f32, ub>, index, f32
    }
    return
  }

  func.func @conditional_relay(%n: index, %cond: i1) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    %c512 = arith.constant 512 : index
    %zero = arith.constant 0 : i64
    %one = arith.constant 1.0 : f32
    %ub = pto.castptr %zero : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v = pto.vdup %one, %mask : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %v, %ub[%c256], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
      %s = scf.if %cond -> (f32) {
        pto.mem_bar "VST_LD"
        %x = pto.load %ub[%c0] : !pto.ptr<f32, ub>, index -> f32
        scf.yield %x : f32
      } else {
        scf.yield %one : f32
      }
      pto.store %s, %ub[%c256] : !pto.ptr<f32, ub>, index, f32
    }
    return
  }
}

// CHECK-LABEL: func.func @nonalias_fence_relay
// The reload at UB[256] reads the value the relayed store wrote, so the
// VST_LD fence plus the SSA relay order both the RAW and WAW cuts: no
// further barrier is needed.
// CHECK: pto.vsts
// CHECK: pto.vsts
// CHECK: pto.mem_bar "VST_LD"
// CHECK-NEXT: %[[S:.*]] = pto.load
// CHECK-NEXT: pto.store %[[S]]
// CHECK-NEXT: %{{.*}} = pto.load
// CHECK-NEXT: pto.store %{{.*}}
// CHECK-NOT: pto.mem_bar
// CHECK: return

// CHECK-LABEL: func.func @missing_value_relay
// The store writes a constant instead of the loaded value, so no SSA
// relay exists and the WAW keeps its VST_ST.
// CHECK: pto.vsts
// CHECK: pto.vsts
// CHECK: pto.mem_bar "VST_LD"
// CHECK-NEXT: %{{.*}} = pto.load
// CHECK-NEXT: pto.mem_bar "VST_ST"
// CHECK-NEXT: pto.store
// CHECK: return

// CHECK-LABEL: func.func @producer_after_fence
// The second vector store (WAW producer) sits after the fence, so the
// VST_ST must be placed after it, right before the scalar store.
// CHECK: pto.vsts
// CHECK: pto.mem_bar "VST_LD"
// CHECK-NEXT: %{{.*}} = pto.load
// CHECK-NEXT: pto.vsts
// CHECK-NEXT: pto.mem_bar "VST_ST"
// CHECK-NEXT: pto.store
// CHECK: return

// CHECK-LABEL: func.func @wrong_fence_family
// The pre-existing VST_VLD covers the wrong family; hazards whose
// consumer is a scalar op still get their own kinds.
// CHECK: pto.vsts
// CHECK: pto.mem_bar "VST_VLD"
// CHECK-NEXT: %{{.*}} = pto.load
// CHECK-NEXT: pto.mem_bar "VST_ST"
// CHECK-NEXT: pto.store
// CHECK: return

// CHECK-LABEL: func.func @existing_fence_relay
// The fence plus the unconditional SSA relay cover every hazard; nothing
// new is inserted after the existing barrier.
// CHECK: pto.vsts
// CHECK: pto.mem_bar "VST_LD"
// CHECK-NEXT: %[[S:.*]] = pto.load
// CHECK-NEXT: pto.store %[[S]]
// CHECK-NOT: pto.mem_bar
// CHECK: return

// CHECK-LABEL: func.func @possibly_empty_relay
// The loop may run zero times, so the relay is conditional and the WAW
// keeps its VST_ST after the loop.
// CHECK: pto.vsts
// CHECK: scf.for
// CHECK: pto.mem_bar "VST_LD"
// CHECK-NEXT: %{{.*}} = pto.load
// CHECK: scf.yield
// CHECK: pto.mem_bar "VST_ST"
// CHECK-NEXT: pto.store
// CHECK: return

// CHECK-LABEL: func.func @conditional_relay
// The else branch yields a constant, so the relay is conditional and the
// WAW keeps its VST_ST after the if.
// CHECK: pto.vsts
// CHECK: scf.if
// CHECK: pto.mem_bar "VST_LD"
// CHECK-NEXT: %{{.*}} = pto.load
// CHECK: scf.yield
// CHECK: } else {
// CHECK: pto.mem_bar "VST_ST"
// CHECK-NEXT: pto.store
// CHECK: return
