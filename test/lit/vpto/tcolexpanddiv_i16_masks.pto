// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-tile-op-expand %s -o - | FileCheck %s

!short_data = !pto.tile_buf<loc=vec, dtype=i16, rows=8, cols=16, v_row=8, v_col=8,
                           blayout=row_major, slayout=none_box, fractal=512, pad=0>
!short_row = !pto.tile_buf<loc=vec, dtype=i16, rows=8, cols=16, v_row=1, v_col=8,
                          blayout=row_major, slayout=none_box, fractal=512, pad=0>

// The second i16 chunk has three valid columns, so the even path needs two
// f32 lanes and the odd path one. The physical row is padded to 32 bytes.
!data = !pto.tile_buf<loc=vec, dtype=i16, rows=8, cols=144, v_row=8, v_col=131,
                     blayout=row_major, slayout=none_box, fractal=512, pad=0>
!row = !pto.tile_buf<loc=vec, dtype=i16, rows=8, cols=144, v_row=1, v_col=131,
                    blayout=row_major, slayout=none_box, fractal=512, pad=0>

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @colexpanddiv_i16_short() {
    %src0 = pto.alloc_tile : !short_data
    %src1 = pto.alloc_tile : !short_row
    %dst = pto.alloc_tile : !short_data
    pto.tcolexpanddiv ins(%src0, %src1 : !short_data, !short_row) outs(%dst : !short_data)
    return
  }

  func.func @colexpanddiv_i16_tail() {
    %src0 = pto.alloc_tile : !data
    %src1 = pto.alloc_tile : !row
    %dst = pto.alloc_tile : !data
    pto.tcolexpanddiv ins(%src0, %src1 : !data, !row) outs(%dst : !data)
    return
  }
}

// The reported 8-column case needs four active f32 lanes in both divisions.
// CHECK-LABEL: func.func @colexpanddiv_i16_short()
// CHECK-DAG: %[[FOUR:.*]] = arith.constant 4 : i32
// CHECK-DAG: %[[EIGHT:.*]] = arith.constant 8 : i32
// CHECK: %[[SHORT_I16:[^,]+]], %{{.*}} = pto.plt_b16 %[[EIGHT]]
// CHECK: %[[SHORT_F32:[^,]+]], %{{.*}} = pto.plt_b32 %[[FOUR]]
// CHECK: pto.vdiv %{{[^,]+}}, %{{[^,]+}}, %[[SHORT_F32]]
// CHECK: pto.vdiv %{{[^,]+}}, %{{[^,]+}}, %[[SHORT_F32]]
// CHECK: pto.vsts {{.*}}, %[[SHORT_I16]] :

// Derive both counts from the loop's incoming count. Only the next
// iteration uses the carry-out of pto.plt_b16.
// CHECK-LABEL: func.func @colexpanddiv_i16_tail()
// CHECK: %[[TWO:.*]] = arith.constant 2 : index
// CHECK: scf.for {{.*}} iter_args(%[[REMAINING:[^ ]+]] = {{.*}}) -> (index)
// CHECK: %[[REMAINING_I32:.*]] = arith.index_cast %[[REMAINING]] : index to i32
// CHECK: %[[MASK16:[^,]+]], %[[NEXT:[^ ]+]] = pto.plt_b16 %[[REMAINING_I32]]
// CHECK: %[[ODD:.*]] = arith.floordivsi %[[REMAINING]], %[[TWO]] : index
// CHECK: %[[EVEN:.*]] = arith.subi %[[REMAINING]], %[[ODD]] : index
// CHECK: %[[EVEN_I32:.*]] = arith.index_cast %[[EVEN]] : index to i32
// CHECK: %[[ODD_I32:.*]] = arith.index_cast %[[ODD]] : index to i32
// CHECK: %[[EVEN_MASK:[^,]+]], %{{.*}} = pto.plt_b32 %[[EVEN_I32]]
// CHECK: %[[ODD_MASK:[^,]+]], %{{.*}} = pto.plt_b32 %[[ODD_I32]]
// CHECK: %[[NEXT_INDEX:.*]] = arith.index_cast %[[NEXT]] : i32 to index
// CHECK: %[[EVEN_DIV:.*]] = pto.vdiv %{{[^,]+}}, %{{[^,]+}}, %[[EVEN_MASK]]
// CHECK: %[[ODD_DIV:.*]] = pto.vdiv %{{[^,]+}}, %{{[^,]+}}, %[[ODD_MASK]]
// CHECK: %[[EVEN_I16:.*]] = pto.vcvt %[[EVEN_DIV]], %[[EVEN_MASK]] {part = "EVEN", rnd = "Z"
// CHECK: %[[ODD_I16:.*]] = pto.vcvt %[[ODD_DIV]], %[[ODD_MASK]] {part = "ODD", rnd = "Z"
// CHECK: %[[RESULT:.*]] = pto.vor %[[EVEN_I16]], %[[ODD_I16]], %[[MASK16]]
// CHECK: pto.vsts %[[RESULT]], {{.*}}, %[[MASK16]] :
// CHECK: scf.yield %[[NEXT_INDEX]] : index
