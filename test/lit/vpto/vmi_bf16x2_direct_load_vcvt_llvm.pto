// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - 2>/dev/null | FileCheck %s --check-prefix=VPTO --implicit-check-not=pto.vor
// RUN: ptoas --cann-output-version=9.0.0 --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s --check-prefix=LLVM

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @bf16x2_direct_load_vcvt(
      %src: !pto.ptr<!pto.bf16x2, ub>,
      %dst: !pto.ptr<!pto.f4E1M2x2, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %wide = pto.vmi.vload %src[%c0]
          : !pto.ptr<!pto.bf16x2, ub>
         -> !pto.vmi.vreg<256x!pto.bf16x2>
      %packed = pto.vmi.vcvt %wide {rounding = "R"}
          : !pto.vmi.vreg<256x!pto.bf16x2>
         -> !pto.vmi.vreg<256x!pto.f4E1M2x2>
      pto.vmi.vstore %packed, %dst[%c0]
          : !pto.vmi.vreg<256x!pto.f4E1M2x2>,
            !pto.ptr<!pto.f4E1M2x2, ub>
    }
    return
  }

  func.func @bf16x2_direct_load_vcvt_e2m1(
      %src: !pto.ptr<!pto.bf16x2, ub>,
      %dst: !pto.ptr<!pto.f4E2M1x2, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %wide = pto.vmi.vload %src[%c0]
          : !pto.ptr<!pto.bf16x2, ub>
         -> !pto.vmi.vreg<64x!pto.bf16x2>
      %packed = pto.vmi.vcvt %wide {rounding = "A"}
          : !pto.vmi.vreg<64x!pto.bf16x2>
         -> !pto.vmi.vreg<64x!pto.f4E2M1x2>
      pto.vmi.vstore %packed, %dst[%c0]
          : !pto.vmi.vreg<64x!pto.f4E2M1x2>,
            !pto.ptr<!pto.f4E2M1x2, ub>
    }
    return
  }
}

// VPTO-LABEL: func.func @bf16x2_direct_load_vcvt
// VPTO-COUNT-4: pto.vlds {{.*}} : !pto.ptr<!pto.bf16x2, ub> -> !pto.vreg<64x!pto.bf16x2>
// VPTO-COUNT-4: pto.vcvt {{.*}} {part = "P0", rnd = "R"}
// VPTO-NOT: pto.vmi.
// VPTO-NOT: !pto.vmi.

// LLVM-LABEL: define void @bf16x2_direct_load_vcvt_mix_aiv
// LLVM-COUNT-4: call <64 x i32> @llvm.hivm.vldsx1.v64bf16x2
// LLVM-COUNT-4: call <256 x float4e1m2x2> @llvm.hivm.vcvtff2.bf162f4e1m2x2.x

// VPTO-LABEL: func.func @bf16x2_direct_load_vcvt_e2m1
// VPTO: pto.vlds {{.*}} : !pto.ptr<!pto.bf16x2, ub> -> !pto.vreg<64x!pto.bf16x2>
// VPTO: pto.vcvt {{.*}} {part = "P0", rnd = "A"}
// VPTO: pto.vsts
// VPTO-NOT: pto.vmi.

// LLVM-LABEL: define void @bf16x2_direct_load_vcvt_e2m1_mix_aiv
// LLVM: call <64 x i32> @llvm.hivm.vldsx1.v64bf16x2
// LLVM: call <256 x float4e2m1x2> @llvm.hivm.vcvtff2.bf162f4e2m1x2.x
