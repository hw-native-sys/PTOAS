// RUN: ptoas %s --pto-arch=a5 --pto-backend=vpto --emit-vpto --vmi-fastmath=false --enable-vecscope-mem-bar=true -o - | FileCheck %s
// RUN: ptoas %s --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir --vmi-fastmath=false --enable-vecscope-mem-bar=true -o %t.ll

// Four consecutive 16-byte writes share an alignment stream and one flush.
// Source and maxima are disjoint even when full vector reads and physical
// partial-block store transactions are included. Keep the real maxima RAW.
// CHECK-LABEL: func.func @vf2_minimal_sync_repro
// CHECK: pto.init_align
// CHECK-NOT: pto.vstas
// CHECK: scf.for
// CHECK-NOT: pto.init_align
// CHECK-NOT: pto.mem_bar
// CHECK: pto.vstus
// CHECK-NOT: pto.mem_bar
// CHECK-NOT: pto.vstas
// CHECK: scf.yield
// CHECK: pto.vstas
// CHECK-NEXT: pto.mem_bar "VST_VLD"
// CHECK-NEXT: {{.*}}pto.vlds
// CHECK-NOT: pto.mem_bar
// CHECK: return

// Minimal VF2 reproducer: one row, four group-max stores, then one load.
// The four stores are lowered through the stateful vstus/vstas path.
module attributes {pto.target_arch = "a5", pto.backend = "vpto"} {
  func.func @vf2_minimal_sync_repro(%arg0: !pto.ptr<ui8, ub>) attributes {pto.aiv} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %c128 = arith.constant 128 : index
    %c2048 = arith.constant 2048 : index
    %c3072 = arith.constant 3072 : index
    %c32767 = arith.constant 32767 : i16
    %u32767 = builtin.unrealized_conversion_cast %c32767 : i16 to ui16
    %typed = pto.castptr %arg0 : !pto.ptr<ui8, ub> -> !pto.ptr<bf16, ub>
    %src = pto.addptr %typed, %c0 : !pto.ptr<bf16, ub>, index -> !pto.ptr<bf16, ub>
    %max = pto.addptr %typed, %c2048 : !pto.ptr<bf16, ub>, index -> !pto.ptr<bf16, ub>
    %output = pto.addptr %typed, %c3072 : !pto.ptr<bf16, ub>, index -> !pto.ptr<bf16, ub>
    pto.vecscope {
      %full128 = pto.vmi.pset "PAT_ALL" : !pto.vmi.mask<128xpred>
      %abs_mask = pto.vmi.vbrc %u32767 : ui16 -> !pto.vmi.vreg<128xui16>
      scf.for %chunk = %c0 to %c4 step %c1 {
        %off = arith.muli %chunk, %c128 : index
        %x = pto.vmi.vload %src[%off] : !pto.ptr<bf16, ub>, index -> !pto.vmi.vreg<128xbf16>
        %bits = pto.vmi.vinterpret_cast %x : !pto.vmi.vreg<128xbf16> -> !pto.vmi.vreg<128xui16>
        %abs = pto.vmi.vand %bits, %abs_mask, %full128 {pmode = "zero"} : !pto.vmi.vreg<128xui16>, !pto.vmi.vreg<128xui16>, !pto.vmi.mask<128xpred> -> !pto.vmi.vreg<128xui16>
        %group = pto.vmi.group_reduce_maxi %abs, %full128 {num_groups = 8 : i64} : !pto.vmi.vreg<128xui16>, !pto.vmi.mask<128xpred> -> !pto.vmi.vreg<8xui16>
        %group_bf = pto.vmi.vinterpret_cast %group : !pto.vmi.vreg<8xui16> -> !pto.vmi.vreg<8xbf16>
        %dst_off = arith.muli %chunk, %c8 : index
        pto.vmi.vstore %group_bf, %max[%dst_off] : !pto.vmi.vreg<8xbf16>, !pto.ptr<bf16, ub>, index
      }
      %out = pto.vmi.vload %max[%c0] : !pto.ptr<bf16, ub>, index -> !pto.vmi.vreg<32xbf16>
      pto.vmi.vstore %out, %output[%c0] : !pto.vmi.vreg<32xbf16>, !pto.ptr<bf16, ub>, index
    }
    return
  }
}
