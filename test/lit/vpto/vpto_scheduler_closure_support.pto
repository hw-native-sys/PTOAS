// RUN: pto-test-opt %s '-pto-vpto-scheduler=mode=on trace=true' > %t 2> %t.trace
// RUN: FileCheck %s --check-prefix=ORDER < %t
// RUN: FileCheck %s --check-prefix=TRACE < %t.trace

// ORDER-LABEL: func.func @memory_gated_predicate_closure
// ORDER: %[[P0:[0-9]+]] = pto.vcmp
// ORDER-NEXT: %{{[0-9]+}} = pto.vcmp
// ORDER-NEXT: %{{[0-9]+}} = pto.vcmp
// ORDER-NEXT: pto.vsts {{.*}}%arg3
// ORDER-NEXT: pto.vsts {{.*}}%[[P0]]
// ORDER-NEXT: %{{[0-9]+}} = pto.vcmp

// TRACE-LABEL: vpto-scheduler: function=memory_gated_predicate_closure mode=on
// TRACE: schedule-result block=0 region=0 nodes=17 work-units={{[0-9]+}} pressure-idles={{[0-9]+}} peak={vector:2,predicate:4}
// TRACE: original-index=0 cycle={{[0-9]+}} direction=top reason=advance-pressure-closure op=pto.vsts

module attributes {pto.target_arch = "a5"} {
  func.func @memory_gated_predicate_closure(%x0: !pto.vreg<64xf32>, %x1: !pto.vreg<64xf32>, %dst: !pto.ptr<f32, ub>, %active: !pto.mask<b32>) {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      pto.vsts %x0, %dst[%c0], %active {dist = "NORM_B32"} : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %p0 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p1 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p2 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p3 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p4 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p5 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p6 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %p7 = pto.vcmp %x0, %x1, %active, "lt" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      pto.vsts %x0, %dst[%c0], %p0 {dist = "NORM_B32"} : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.vsts %x0, %dst[%c0], %p1 {dist = "NORM_B32"} : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.vsts %x0, %dst[%c0], %p2 {dist = "NORM_B32"} : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.vsts %x0, %dst[%c0], %p3 {dist = "NORM_B32"} : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.vsts %x0, %dst[%c0], %p4 {dist = "NORM_B32"} : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.vsts %x0, %dst[%c0], %p5 {dist = "NORM_B32"} : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.vsts %x0, %dst[%c0], %p6 {dist = "NORM_B32"} : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.vsts %x0, %dst[%c0], %p7 {dist = "NORM_B32"} : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }
}
