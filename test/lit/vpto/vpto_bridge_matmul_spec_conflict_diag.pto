// The wrapper renders one token per spec field, so two bridged matmul ops
// of one function must agree on every role tile. Identical tokens
// deduplicate; a different token for a field already collected is
// diagnosed instead of crashing the spec DictionaryAttr assembly.

// RUN: not pto-test-opt %s -pto-lower-declarative-bridge-ops 2>&1 | FileCheck %s

// CHECK: VPTO declarative bridge spec field 'left_tile' was already collected as 'pto::Tile<pto::TileType::Left, half, 16, 16, pto::BLayout::ColMajor, 16, 16, pto::SLayout::RowMajor, 512>'; the wrapper renders one token per spec field

module attributes {pto.target_arch = "a5"} {
  func.func private @matmul_conflict_cube(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c0 = arith.constant 0 : i64
    %c1024 = arith.constant 1024 : i64
    %c2048 = arith.constant 2048 : i64
    %c4096 = arith.constant 4096 : i64
    %c8192 = arith.constant 8192 : i64
    %lhs0 = pto.alloc_tile addr = %c0
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %lhs1 = pto.alloc_tile addr = %c4096
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=32, v_row=16, v_col=32,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %rhs0 = pto.alloc_tile addr = %c1024
      : !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %rhs1 = pto.alloc_tile addr = %c8192
      : !pto.tile_buf<loc=right, dtype=f16, rows=32, cols=16, v_row=32, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %acc0 = pto.alloc_tile addr = %c2048
      : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    pto.tmatmul ins(%lhs0, %rhs0
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>,
        !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      outs(%acc0 : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                                 blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
    pto.tmatmul ins(%lhs1, %rhs1
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=32, v_row=16, v_col=32,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>,
        !pto.tile_buf<loc=right, dtype=f16, rows=32, cols=16, v_row=32, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      outs(%acc0 : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                                 blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
    return
  }
}
