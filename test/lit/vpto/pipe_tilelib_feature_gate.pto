// RUN: not ptoas --pto-arch=a3 --pto-backend=vpto --tile-lib-backend=ptodsl --enable-pipe-tilelib-expand --emit-vpto %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=ARCH
// RUN: not ptoas --pto-arch=a5 --pto-backend=emitc --tile-lib-backend=ptodsl --enable-pipe-tilelib-expand %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=BACKEND
// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=tilelang --enable-pipe-tilelib-expand --emit-vpto %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=TILELIB
// RUN: ptoas --pto-arch=a3 %s 2>&1 | FileCheck %s --check-prefix=EMITC

module {
  func.func @emitc_pipe_unchanged()
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %slots = pto.declare_global -> !pto.tensor_view<16x16xf32>
    %pipe = "pto.initialize_l2g2l_pipe"(%slots) <{
      dir_mask = 1 : i8,
      slot_size = 1024 : i32,
      slot_num = 8 : i32,
      flag_base = 0 : i32,
      operandSegmentSizes = array<i32: 1, 0, 0>
    }> : (!pto.tensor_view<16x16xf32>) -> !pto.pipe
    %entry = pto.declare_global -> !pto.tensor_view<16x16xf32>
    pto.talloc(%entry, %pipe : !pto.tensor_view<16x16xf32>, !pto.pipe) {split = 0}
    pto.tpush(%entry, %pipe : !pto.tensor_view<16x16xf32>, !pto.pipe) {split = 0}
    return
  }
}

// ARCH: Error: --enable-pipe-tilelib-expand requires --pto-arch=a5.
// BACKEND: Error: --enable-pipe-tilelib-expand requires --pto-backend=vpto.
// TILELIB: Error: --enable-pipe-tilelib-expand requires --tile-lib-backend=ptodsl.
// EMITC-LABEL: AICORE void emitc_pipe_unchanged(
// EMITC: TPipe<0, Direction::DIR_C2V, 1024, 8, 8, true>
// EMITC: TALLOC<
// EMITC: TPUSH<
// EMITC-NOT: TDrain
