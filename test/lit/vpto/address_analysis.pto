// RUN: pto-test-opt %s -mlir-disable-threading -pto-print-address-analysis 2>&1 | FileCheck %s
// RUN: pto-test-opt %s -mlir-disable-threading -pto-print-address-analysis 2>/dev/null | FileCheck %s --check-prefix=IR

// IR-LABEL: func.func @direct_index
// IR: scf.for
// IR: pto.vlds
// IR: pto.vsts
// IR-NOT: pto.addptr
// IR-LABEL: func.func @typed_recurrences

// CHECK-LABEL: address-analysis @direct_index
// CHECK: value {{%.*}} type=index evolution=initial=0 step=1 trip-count=4 range=signed[0,4] no-wrap=true
// CHECK: op=pto.vlds {{.*}} element-offset=0 current-offset=element:{{%.*}} delta-bytes=4 unit1=4 unit2=2 unit4=1 unit32=unknown(inexact-unit-conversion)
// CHECK: op=pto.vsts {{.*}} element-offset=0 current-offset=element:{{%.*}} delta-bytes=4

// CHECK-LABEL: address-analysis @typed_recurrences
// CHECK: type=i8 evolution=initial=0 step=32 trip-count=2 range=signed[0,64] no-wrap=true
// CHECK: type=i8 evolution=unknown(possible-wrap)
// CHECK: type=i16 evolution=initial=0 step=64 trip-count=4 range=signed[0,256] no-wrap=true
// CHECK: type=i16 evolution=unknown(possible-wrap)
// CHECK: type=i32 evolution=initial=0 step=1000 trip-count=4 range=signed[0,4000] no-wrap=true
// CHECK: type=i32 evolution=unknown(possible-wrap)

// CHECK-LABEL: address-analysis @dynamic_recurrences
// CHECK: type=index evolution=initial=0 step={{%.*}} trip-count=4 range=signed[0,10] no-wrap=true
// CHECK: type=index evolution=initial=0 step={{%.*}} trip-count=3 range=signed[0,15] no-wrap=true
// CHECK: type=index evolution=initial=4 step=1 trip-count=3 range=signed[4,7] no-wrap=true
// CHECK: type=i8 evolution=unknown(possible-wrap)

// CHECK-LABEL: address-analysis @signed_unsigned_casts
// CHECK: type=index evolution=initial=-32 step=32 trip-count=2 range=signed[-32,32] no-wrap=true
// CHECK: type=index evolution=unknown(possible-wrap)

// CHECK-LABEL: address-analysis @unknowns
// CHECK: type=index evolution=unknown(unknown-loop-domain)
// CHECK: type=i16 evolution=unknown(unknown-loop-domain)
// CHECK: type=i32 evolution=unknown(non-affine-recurrence)
// CHECK: type=i8 evolution=unknown(unsupported-cast)

// CHECK-LABEL: address-analysis @address_components
// CHECK: op=pto.vlds {{.*}} element-offset=0 current-offset=element:{{%.*}} delta-bytes=12 unit1=12 unit2=6 unit4=3 unit32=unknown(inexact-unit-conversion)
// CHECK: op=pto.vldus {{.*}} element-offset=0 current-offset=none delta-bytes=4 unit1=4 unit2=2 unit4=1

// CHECK-LABEL: address-analysis @address_units
// CHECK: op=pto.plds {{.*}} current-offset=byte:{{%.*}} delta-bytes=1 unit1=1 unit2=unknown(inexact-unit-conversion)
// CHECK: op=pto.vsldb {{.*}} current-offset=block:{{%.*}} delta-bytes=32 unit1=32 unit2=16 unit4=8 unit32=1
// CHECK: op=pto.pldi {{.*}} current-offset=alignment:{{%.*}} delta-bytes=32 unit1=32 unit2=16 unit4=8 unit32=1

// CHECK-LABEL: address-analysis @opaque_and_scaled
// CHECK: op=pto.vlds root={{%.*}} element-offset={{%.*}} current-offset=element:{{%.*}} delta-bytes=12

// CHECK-LABEL: address-analysis @addptr_unsigned_descending
// CHECK: type=index evolution=initial=3 step=-1 trip-count=3 range=unsigned[0,3] no-wrap=true
// CHECK: op=pto.vlds root={{%[^ ]+}} element-offset=index_castui({{%[^)]+}})
// CHECK-SAME: current-offset=element:{{%.*}} delta-bytes=-1 unit1=-1
// CHECK-SAME: unit2=unknown(inexact-unit-conversion)

// CHECK-LABEL: address-analysis @cast_constant_folding
// CHECK: op=pto.vlds {{.*}} delta-bytes=255 unit1=255
// CHECK: op=pto.vlds {{.*}} delta-bytes=1 unit1=1

// CHECK-LABEL: address-analysis @index_arithmetic_wrap
// CHECK: type=i64 evolution=unknown(possible-wrap)
// CHECK: type=i64 evolution=unknown(possible-wrap)
// CHECK: type=i64 evolution=unknown(possible-wrap)
// CHECK: type=i64 evolution=initial=1 step=1 trip-count=3 range=signed[1,4] no-wrap=true
// CHECK: type=i64 evolution=initial=-1 step=1 trip-count=3 range=signed[-1,2] no-wrap=true
// CHECK: type=i64 evolution=initial=0 step=1 trip-count=3 range=signed[0,3] no-wrap=true

// CHECK-LABEL: address-analysis @constant_address_zero_delta
// CHECK: op=pto.vlds {{.*}} delta-bytes=0 unit1=0 unit2=0 unit4=0 unit32=0 self-difference-bytes=0

// CHECK-LABEL: address-analysis @source_arithmetic_addptr
// CHECK: type=index evolution=unknown(possible-wrap)
// CHECK: op=pto.vlds {{.*}} delta-bytes=unknown(possible-wrap) self-difference-bytes=0
// CHECK: type=index evolution=unknown(possible-wrap)
// CHECK: op=pto.vlds {{.*}} delta-bytes=unknown(possible-wrap) self-difference-bytes=0
// CHECK: type=index evolution=unknown(possible-wrap)
// CHECK: op=pto.vlds {{.*}} delta-bytes=unknown(possible-wrap) self-difference-bytes=0
// CHECK: type=index evolution=initial=0 step=32 trip-count=2 range=signed[0,64] no-wrap=true
// CHECK: op=pto.vlds {{.*}} delta-bytes=32 unit1=32{{.*}}self-difference-bytes=0

module attributes {pto.target_arch = "a5"} {
  func.func @direct_index(%src: !pto.ptr<f32, ub>,
                          %dst: !pto.ptr<f32, ub>,
                          %mask: !pto.mask<b32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    scf.for %iv = %c0 to %c4 step %c1 {
      %value = pto.vlds %src[%iv]
          : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      pto.vsts %value, %dst[%iv], %mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }

  func.func @typed_recurrences() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4 = arith.constant 4 : index
    %c0_i8 = arith.constant 0 : i8
    %c32_i8 = arith.constant 32 : i8
    %c96_i8 = arith.constant 96 : i8
    %c16_i8 = arith.constant 16 : i8
    %c0_i16 = arith.constant 0 : i16
    %c64_i16 = arith.constant 64 : i16
    %c32760_i16 = arith.constant 32760 : i16
    %c4_i16 = arith.constant 4 : i16
    %c0_i32 = arith.constant 0 : i32
    %c1000_i32 = arith.constant 1000 : i32
    %c2147483640_i32 = arith.constant 2147483640 : i32
    %c4_i32 = arith.constant 4 : i32
    scf.for %iv = %c0 to %c2 step %c1
        iter_args(%safe8 = %c0_i8, %wrap8 = %c96_i8) -> (i8, i8) {
      %next_safe8 = arith.addi %safe8, %c32_i8 : i8
      %next_wrap8 = arith.addi %wrap8, %c16_i8 : i8
      scf.yield %next_safe8, %next_wrap8 : i8, i8
    }
    scf.for %iv = %c0 to %c4 step %c1
        iter_args(%safe16 = %c0_i16) -> (i16) {
      %next = arith.addi %safe16, %c64_i16 : i16
      scf.yield %next : i16
    }
    scf.for %iv = %c0 to %c2 step %c1
        iter_args(%wrap16 = %c32760_i16) -> (i16) {
      %next = arith.addi %wrap16, %c4_i16 : i16
      scf.yield %next : i16
    }
    scf.for %iv = %c0 to %c4 step %c1
        iter_args(%safe32 = %c0_i32) -> (i32) {
      %next = arith.addi %safe32, %c1000_i32 : i32
      scf.yield %next : i32
    }
    scf.for %iv = %c0 to %c2 step %c1
        iter_args(%wrap32 = %c2147483640_i32) -> (i32) {
      %next = arith.addi %wrap32, %c4_i32 : i32
      scf.yield %next : i32
    }
    return
  }

  func.func @dynamic_recurrences() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c3 = arith.constant 3 : index
    %c4 = arith.constant 4 : index
    %c120_i8 = arith.constant 120 : i8
    %c4_i8 = arith.constant 4 : i8
    scf.for %iv = %c0 to %c4 step %c1
        iter_args(%offset = %c0) -> (index) {
      %increment = arith.addi %iv, %c1 : index
      %next = arith.addi %offset, %increment : index
      scf.yield %next : index
    }
    scf.for %iv = %c0 to %c3 step %c1
        iter_args(%offset = %c0, %stride = %c4) -> (index, index) {
      %next_offset = arith.addi %offset, %stride : index
      %next_stride = arith.addi %stride, %c1 : index
      scf.yield %next_offset, %next_stride : index, index
    }
    scf.for %iv = %c0 to %c3 step %c1
        iter_args(%wrapping = %c120_i8) -> (i8) {
      %iv_i8 = arith.index_cast %iv : index to i8
      %increment = arith.addi %iv_i8, %c4_i8 : i8
      %next = arith.addi %wrapping, %increment : i8
      scf.yield %next : i8
    }
    return
  }

  func.func @signed_unsigned_casts() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %cm32_i8 = arith.constant -32 : i8
    %c32_i8 = arith.constant 32 : i8
    scf.for %iv = %c0 to %c2 step %c1
        iter_args(%signed_value = %cm32_i8) -> (i8) {
      %signed_index = arith.index_cast %signed_value : i8 to index
      %next = arith.addi %signed_value, %c32_i8 : i8
      scf.yield %next : i8
    }
    scf.for %iv = %c0 to %c2 step %c1
        iter_args(%unsigned_value = %cm32_i8) -> (i8) {
      %unsigned_index = arith.index_castui %unsigned_value : i8 to index
      %next = arith.addi %unsigned_value, %c32_i8 : i8
      scf.yield %next : i8
    }
    return
  }

  func.func @unknowns(%upper: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c0_i16 = arith.constant 0 : i16
    %c1_i16 = arith.constant 1 : i16
    %c2_i32 = arith.constant 2 : i32
    scf.for %iv = %c0 to %upper step %c1
        iter_args(%value = %c0_i16) -> (i16) {
      %next = arith.addi %value, %c1_i16 : i16
      scf.yield %next : i16
    }
    scf.for %iv = %c0 to %c2 step %c1
        iter_args(%value = %c2_i32) -> (i32) {
      %square = arith.muli %value, %value : i32
      %truncated = arith.trunci %value : i32 to i8
      scf.yield %square : i32
    }
    return
  }

  func.func @address_components(%src: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    scf.for %iv = %c0 to %c2 step %c1
        iter_args(%ptr = %src) -> (!pto.ptr<f32, ub>) {
      %offset = arith.muli %iv, %c2 : index
      %value = pto.vlds %ptr[%offset]
          : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %align = pto.vldas %ptr : !pto.ptr<f32, ub> -> !pto.align
      %unused_value, %unused_align = pto.vldus %ptr, %align
          : !pto.ptr<f32, ub>, !pto.align -> !pto.vreg<64xf32>, !pto.align
      %next_ptr = pto.addptr %ptr, %c1
          : !pto.ptr<f32, ub> -> !pto.ptr<f32, ub>
      scf.yield %next_ptr : !pto.ptr<f32, ub>
    }
    return
  }

  func.func @address_units(%byte_src: !pto.ptr<i8, ub>,
                           %block_src: !pto.ptr<f32, ub>,
                           %mask8: !pto.mask<b8>,
                           %mask32: !pto.mask<b32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c32 = arith.constant 32 : index
    %c1_i16 = arith.constant 1 : i16
    scf.for %iv = %c0 to %c2 step %c1 {
      %predicate = pto.plds %byte_src[%iv], "NORM"
          : !pto.ptr<i8, ub>, index -> !pto.mask<b8>
      %repeat_stride = arith.index_castui %iv : index to i16
      %value = pto.vsldb %block_src, %c1_i16, %repeat_stride, %mask32
          : !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
          -> !pto.vreg<64xf32>
    }
    scf.for %iv = %c0 to %c2 step %c1
        iter_args(%align_ptr = %byte_src) -> (!pto.ptr<i8, ub>) {
      %aligned = pto.pldi %align_ptr[%c0], "NORM"
          : !pto.ptr<i8, ub>, index -> !pto.mask<b8>
      %next = pto.addptr %align_ptr, %c32
          : !pto.ptr<i8, ub> -> !pto.ptr<i8, ub>
      scf.yield %next : !pto.ptr<i8, ub>
    }
    return
  }

  func.func @opaque_and_scaled(%src: !pto.ptr<f32, ub>, %bias: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c3 = arith.constant 3 : index
    %biased = pto.addptr %src, %bias
        : !pto.ptr<f32, ub> -> !pto.ptr<f32, ub>
    scf.for %iv = %c0 to %c3 step %c1 {
      %scaled = arith.muli %iv, %c3 : index
      %value = pto.vlds %biased[%scaled]
          : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    }
    return
  }

  func.func @addptr_unsigned_descending(%src: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c3 = arith.constant 3 : index
    %c1_i8 = arith.constant 1 : i8
    %c3_i8 = arith.constant 3 : i8
    scf.for %iv = %c0 to %c3 step %c1
        iter_args(%offset_i8 = %c3_i8) -> (i8) {
      %offset = arith.index_castui %offset_i8 : i8 to index
      %address = pto.addptr %src, %offset
          : !pto.ptr<ui8, ub> -> !pto.ptr<ui8, ub>
      %value = pto.vlds %address[%c0]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
      %next = arith.subi %offset_i8, %c1_i8 : i8
      scf.yield %next : i8
    }
    return
  }

  func.func @cast_constant_folding(%src: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %cm1_i8 = arith.constant -1 : i8
    %c256_i16 = arith.constant 256 : i16
    %extended = arith.extui %cm1_i8 : i8 to i16
    %extended_index = arith.index_castui %extended : i16 to index
    %truncated = arith.trunci %c256_i16 : i16 to i8
    %truncated_index = arith.index_castui %truncated : i8 to index
    %truncated_step = arith.addi %truncated_index, %c1 : index
    scf.for %iv = %c0 to %c2 step %c1
        iter_args(%ptr = %src) -> (!pto.ptr<ui8, ub>) {
      %value = pto.vlds %ptr[%c0]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
      %next = pto.addptr %ptr, %extended_index
          : !pto.ptr<ui8, ub> -> !pto.ptr<ui8, ub>
      scf.yield %next : !pto.ptr<ui8, ub>
    }
    scf.for %iv = %c0 to %c2 step %c1
        iter_args(%ptr = %src) -> (!pto.ptr<ui8, ub>) {
      %value = pto.vlds %ptr[%c0]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
      %next = pto.addptr %ptr, %truncated_step
          : !pto.ptr<ui8, ub> -> !pto.ptr<ui8, ub>
      scf.yield %next : !pto.ptr<ui8, ub>
    }
    return
  }

  func.func @index_arithmetic_wrap() {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c3 = arith.constant 3 : index
    %cmax = arith.constant 9223372036854775807 : index
    %cmin = arith.constant -9223372036854775808 : index
    scf.for %iv = %c0 to %c3 step %c1 {
      %add = arith.addi %iv, %cmax : index
      %sub = arith.subi %cmin, %iv : index
      %mul = arith.muli %iv, %cmax : index
      %add_i64 = arith.index_cast %add : index to i64
      %sub_i64 = arith.index_cast %sub : index to i64
      %mul_i64 = arith.index_cast %mul : index to i64
      %safe_add = arith.addi %iv, %c1 : index
      %safe_sub = arith.subi %iv, %c1 : index
      %safe_mul = arith.muli %iv, %c1 : index
      %safe_add_i64 = arith.index_cast %safe_add : index to i64
      %safe_sub_i64 = arith.index_cast %safe_sub : index to i64
      %safe_mul_i64 = arith.index_cast %safe_mul : index to i64
    }
    return
  }

  func.func @constant_address_zero_delta(%base: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    scf.for %iv = %c0 to %c2 step %c1 {
      %value = pto.vlds %base[%c0]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
    }
    return
  }

  func.func @source_arithmetic_addptr(%base: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c32 = arith.constant 32 : index
    %cmax = arith.constant 9223372036854775807 : index
    %cmin = arith.constant -9223372036854775808 : index
    scf.for %iv = %c0 to %c2 step %c1 {
      %wrapping_add = arith.addi %iv, %cmax : index
      %add_address = pto.addptr %base, %wrapping_add
          : !pto.ptr<ui8, ub> -> !pto.ptr<ui8, ub>
      %add_value = pto.vlds %add_address[%c0]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
      %wrapping_sub = arith.subi %cmin, %iv : index
      %sub_address = pto.addptr %base, %wrapping_sub
          : !pto.ptr<ui8, ub> -> !pto.ptr<ui8, ub>
      %sub_value = pto.vlds %sub_address[%c0]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
      %wrapping_mul = arith.muli %iv, %cmax : index
      %mul_address = pto.addptr %base, %wrapping_mul
          : !pto.ptr<ui8, ub> -> !pto.ptr<ui8, ub>
      %mul_value = pto.vlds %mul_address[%c0]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
      %safe_mul = arith.muli %iv, %c32 : index
      %safe_address = pto.addptr %base, %safe_mul
          : !pto.ptr<ui8, ub> -> !pto.ptr<ui8, ub>
      %safe_value = pto.vlds %safe_address[%c0]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
    }
    return
  }
}
