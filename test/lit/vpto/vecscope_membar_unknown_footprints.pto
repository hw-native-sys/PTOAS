// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar %s -o - 2>/dev/null | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @reduction_point_to_gather() {
    %zero = arith.constant 0 : index
    %addr = arith.constant 0 : i64
    %sinkaddr = arith.constant 4096 : i64
    %f = arith.constant 2.0 : f32
    %idx_i32 = arith.constant 0 : i32
    %idx = builtin.unrealized_conversion_cast %idx_i32 : i32 to ui32
    %ub = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
    %sink = pto.castptr %sinkaddr : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %one = pto.pset_b32 "PAT_VL1" : !pto.mask<b32>
      %x = pto.vdup %f, %all : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      %indices = pto.vdup %idx, %all : ui32, !pto.mask<b32> -> !pto.vreg<64xui32>
      pto.vsts %x, %ub[%zero], %one {dist = "1PT_B32"} : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %y = pto.vgather2_bc %ub, %indices, %all : !pto.ptr<f32, ub>, !pto.vreg<64xui32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %y, %sink[%zero], %all : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }
  func.func @store_to_unaligned() {
    %zero = arith.constant 0 : index
    %step = arith.constant 64 : index
    %addr = arith.constant 0 : i64
    %sinkaddr = arith.constant 4096 : i64
    %f = arith.constant 2.0 : f32
    %ub = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
    %sink = pto.castptr %sinkaddr : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %x = pto.vdup %f, %all : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %x, %ub[%zero], %all : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %align = pto.vldas %ub : !pto.ptr<f32, ub> -> !pto.align
      %y, %nextalign, %nextptr = pto.vldus %ub, %align, %step : !pto.ptr<f32, ub>, !pto.align, index -> !pto.vreg<64xf32>, !pto.align, !pto.ptr<f32, ub>
      pto.vsts %y, %sink[%zero], %all : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }
  func.func @external_offset_and_deep_loop(%offset: index) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %addr = arith.constant 0 : i64
    %f = arith.constant 2.0 : f32
    %ub = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %all = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %x = pto.vdup %f, %all : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %x, %ub[%offset], %all : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      scf.for %k = %zero to %two step %one {
        scf.for %i = %zero to %two step %one {
          scf.for %j = %zero to %two step %one {
            %y = pto.vlds %ub[%offset] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
            %z = pto.vadd %y, %x, %all : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
            pto.vsts %z, %ub[%offset], %all : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
          }
        }
      }
    }
    return
  }
}
// CHECK-LABEL: func.func @reduction_point_to_gather
// CHECK: pto.vsts
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: pto.vgather2_bc
// CHECK-LABEL: func.func @store_to_unaligned
// CHECK: pto.vsts
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: pto.vldus
// CHECK-LABEL: func.func @external_offset_and_deep_loop
// CHECK: pto.vsts
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: scf.for
// CHECK: scf.for
// CHECK: scf.for
// CHECK: pto.vlds
// CHECK: pto.vsts
// CHECK: pto.mem_bar "VV_ALL"
// CHECK: pto.mem_bar "VV_ALL"
// CHECK: pto.mem_bar "VV_ALL"
