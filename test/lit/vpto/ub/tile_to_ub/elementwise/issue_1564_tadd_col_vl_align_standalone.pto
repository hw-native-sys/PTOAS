// Issue #1564: running pto-lower-to-ubuf-ops standalone on input without any
// scf op must not crash when the lowering emits scf.for, and every repeat of
// the binary op must advance src1 by the same repeat stride as dst and src0.
// Bin2LNormModeColVLAlign: 2x256 f32, v_col=128 -> row loop, repeat=2, stride=8.
// RUN: pto-test-opt -pto-lower-to-ubuf-ops %s | FileCheck %s

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  // CHECK-LABEL: func.func @tadd_col_vl_align_standalone()
  func.func @tadd_col_vl_align_standalone() attributes {pto.aicore} {
    %c0 = arith.constant 0 : i64
    %c4096 = arith.constant 4096 : i64
    %c8192 = arith.constant 8192 : i64
    %dst = pto.alloc_tile addr = %c0 : !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=256, v_row=2, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src0 = pto.alloc_tile addr = %c4096 : !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=256, v_row=2, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src1 = pto.alloc_tile addr = %c8192 : !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=256, v_row=2, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    // CHECK: scf.for
    // CHECK-DAG: %[[RPT:.*]] = arith.constant 2 : i64
    // CHECK-DAG: %[[STRIDE:.*]] = arith.constant 8 : i64
    // CHECK: pto.ub.vadd {{%[^,]+}}, {{%[^,]+}}, {{%[^,]+}}, %[[RPT]],
    // CHECK-SAME: %[[STRIDE]], %[[STRIDE]], %[[STRIDE]] :
    pto.tadd ins(%src0, %src1 : !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=256, v_row=2, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=256, v_row=2, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=256, v_row=2, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    // CHECK-NOT: pto.tadd
    return
  }
}
