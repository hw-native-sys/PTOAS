// RUN: not ptoas --pto-arch=a3 --pto-backend=vpto --emit-vpto-llvm-ir %s -o /dev/null 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @mgather_gm_l1_unsupported(
      %mem: !pto.ptr<f16, gm>, %idx: !pto.ptr<i32, gm>) attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %c64 = arith.constant 64 : index
    %memView = pto.make_tensor_view %mem, shape = [%c64, %c32], strides = [%c32, %c1]
      : !pto.tensor_view<?x?xf16>
    %memPart = pto.partition_view %memView, offsets = [%c0, %c0], sizes = [%c64, %c32]
      : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<64x32xf16>
    %idxView = pto.make_tensor_view %idx, shape = [%c1, %c32], strides = [%c32, %c1]
      : !pto.tensor_view<?x?xi32>
    %idxPart = pto.partition_view %idxView, offsets = [%c0, %c0], sizes = [%c1, %c32]
      : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x32xi32>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=mat, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    // CHECK: error: 'pto.mgather' op A2/A3 VPTO lowering currently supports only GM->UB mgather; GM->L1 is deferred
    pto.mgather ins(%memPart, %idxPart : !pto.partition_tensor_view<64x32xf16>, !pto.partition_tensor_view<1x32xi32>)
      outs(%dst : !pto.tile_buf<loc=mat, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
      {coalesce = #pto<coalesce row>}
    return
  }
}
