// RUN: ptoas --pto-arch=a3 --pto-backend=vpto --emit-vpto-llvm-ir %s -o /dev/null
// RUN: ptoas --pto-arch=a2 --pto-backend=vpto --emit-vpto-llvm-ir %s -o /dev/null

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @mgather_a2a3_types(
      %s_i8: !pto.ptr<i8, gm>, %s_ui8: !pto.ptr<ui8, gm>,
      %s_i16: !pto.ptr<i16, gm>, %s_ui16: !pto.ptr<ui16, gm>,
      %s_i32: !pto.ptr<i32, gm>, %s_ui32: !pto.ptr<ui32, gm>,
      %s_f16: !pto.ptr<f16, gm>, %s_bf16: !pto.ptr<bf16, gm>,
      %s_f32: !pto.ptr<f32, gm>) attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index

    %v_i8 = pto.make_tensor_view %s_i8, shape = [%c8], strides = [%c1]
      : !pto.tensor_view<?xi8>
    %p_i8 = pto.partition_view %v_i8, offsets = [%c0], sizes = [%c8]
      : !pto.tensor_view<?xi8> -> !pto.partition_tensor_view<8xi8>
    %v_ui8 = pto.make_tensor_view %s_ui8, shape = [%c8], strides = [%c1]
      : !pto.tensor_view<?xui8>
    %p_ui8 = pto.partition_view %v_ui8, offsets = [%c0], sizes = [%c8]
      : !pto.tensor_view<?xui8> -> !pto.partition_tensor_view<8xui8>
    %v_i16 = pto.make_tensor_view %s_i16, shape = [%c8], strides = [%c1]
      : !pto.tensor_view<?xi16>
    %p_i16 = pto.partition_view %v_i16, offsets = [%c0], sizes = [%c8]
      : !pto.tensor_view<?xi16> -> !pto.partition_tensor_view<8xi16>
    %v_ui16 = pto.make_tensor_view %s_ui16, shape = [%c8], strides = [%c1]
      : !pto.tensor_view<?xui16>
    %p_ui16 = pto.partition_view %v_ui16, offsets = [%c0], sizes = [%c8]
      : !pto.tensor_view<?xui16> -> !pto.partition_tensor_view<8xui16>
    %v_i32 = pto.make_tensor_view %s_i32, shape = [%c8], strides = [%c1]
      : !pto.tensor_view<?xi32>
    %p_i32 = pto.partition_view %v_i32, offsets = [%c0], sizes = [%c8]
      : !pto.tensor_view<?xi32> -> !pto.partition_tensor_view<8xi32>
    %v_ui32 = pto.make_tensor_view %s_ui32, shape = [%c8], strides = [%c1]
      : !pto.tensor_view<?xui32>
    %p_ui32 = pto.partition_view %v_ui32, offsets = [%c0], sizes = [%c8]
      : !pto.tensor_view<?xui32> -> !pto.partition_tensor_view<8xui32>
    %v_f16 = pto.make_tensor_view %s_f16, shape = [%c8], strides = [%c1]
      : !pto.tensor_view<?xf16>
    %p_f16 = pto.partition_view %v_f16, offsets = [%c0], sizes = [%c8]
      : !pto.tensor_view<?xf16> -> !pto.partition_tensor_view<8xf16>
    %v_bf16 = pto.make_tensor_view %s_bf16, shape = [%c8], strides = [%c1]
      : !pto.tensor_view<?xbf16>
    %p_bf16 = pto.partition_view %v_bf16, offsets = [%c0], sizes = [%c8]
      : !pto.tensor_view<?xbf16> -> !pto.partition_tensor_view<8xbf16>
    %v_f32 = pto.make_tensor_view %s_f32, shape = [%c8], strides = [%c1]
      : !pto.tensor_view<?xf32>
    %p_f32 = pto.partition_view %v_f32, offsets = [%c0], sizes = [%c8]
      : !pto.tensor_view<?xf32> -> !pto.partition_tensor_view<8xf32>

    %idx = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>

    %d_i8 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=i8, rows=1, cols=32, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.mgather ins(%p_i8, %idx : !pto.partition_tensor_view<8xi8>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%d_i8 : !pto.tile_buf<loc=vec, dtype=i8, rows=1, cols=32, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {coalesce = #pto<coalesce elem>}

    %d_ui8 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui8, rows=1, cols=32, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.mgather ins(%p_ui8, %idx : !pto.partition_tensor_view<8xui8>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%d_ui8 : !pto.tile_buf<loc=vec, dtype=ui8, rows=1, cols=32, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {coalesce = #pto<coalesce elem>}

    %d_i16 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=i16, rows=1, cols=16, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.mgather ins(%p_i16, %idx : !pto.partition_tensor_view<8xi16>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%d_i16 : !pto.tile_buf<loc=vec, dtype=i16, rows=1, cols=16, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {coalesce = #pto<coalesce elem>}

    %d_ui16 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui16, rows=1, cols=16, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.mgather ins(%p_ui16, %idx : !pto.partition_tensor_view<8xui16>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%d_ui16 : !pto.tile_buf<loc=vec, dtype=ui16, rows=1, cols=16, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {coalesce = #pto<coalesce elem>}

    %d_i32 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.mgather ins(%p_i32, %idx : !pto.partition_tensor_view<8xi32>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%d_i32 : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {coalesce = #pto<coalesce elem>}

    %d_ui32 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.mgather ins(%p_ui32, %idx : !pto.partition_tensor_view<8xui32>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%d_ui32 : !pto.tile_buf<loc=vec, dtype=ui32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {coalesce = #pto<coalesce elem>}

    %d_f16 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=16, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.mgather ins(%p_f16, %idx : !pto.partition_tensor_view<8xf16>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%d_f16 : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=16, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {coalesce = #pto<coalesce elem>}

    %d_bf16 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=16, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.mgather ins(%p_bf16, %idx : !pto.partition_tensor_view<8xbf16>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%d_bf16 : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=16, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {coalesce = #pto<coalesce elem>}

    %d_f32 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.mgather ins(%p_f32, %idx : !pto.partition_tensor_view<8xf32>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%d_f32 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {coalesce = #pto<coalesce elem>}
    return
  }
}
