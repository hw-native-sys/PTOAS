// RUN: not pto-test-opt %s -split-input-file \
// RUN:   "-vpto-bridge-lowering=whitelist-path=%S/Inputs/vpto-bridge-whitelist.yaml" \
// RUN:   2>&1 | FileCheck %s

module {
  func.func private @pto_vpto_pipe_push(i32)
  func.func private @signature_conflict(%storage: !pto.pipe, %addr: i64) {
    pto.bridge_call "pto_vpto_pipe_push" (%storage, %addr : !pto.pipe, i64)
    return
  }
}

// CHECK: VPTO bridge wrapper 'pto_vpto_pipe_push' already has type
// CHECK: requested '(!llvm.ptr, i64) -> ()'

// -----

module {
  func.func private @bad_object_create(%addr: i64) {
    %pipe = pto.bridge_object_create "pto_vpto_pipe_init"(%addr : i64) -> !pto.pipe
    return
  }
}

// CHECK: pipe object init requires one i32 local address
