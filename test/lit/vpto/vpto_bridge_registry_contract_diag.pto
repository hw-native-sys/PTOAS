// RUN: not pto-test-opt %s -split-input-file \
// RUN:   "-vpto-bridge-lowering=whitelist-path=%S/Inputs/vpto-bridge-whitelist.yaml" \
// RUN:   2>&1 | FileCheck %s

module {
  func.func private @pto_vpto_pipe_push(i32)
  func.func private @signature_conflict(%storage: !pto.pipe, %addr: i64) {
    pto.bridge_call <pipe_push> (%storage, %addr : !pto.pipe, i64) {callee = "pto_vpto_pipe_push"}
    return
  }
}

// CHECK: VPTO bridge wrapper 'pto_vpto_pipe_push' already has type
// CHECK: requested '(!llvm.ptr, i64) -> ()'

// -----

module {
  func.func private @bad_object_create(%addr: i64) {
    %pipe = pto.bridge_object_create <pipe_init>(%addr : i64) {callee = "pto_vpto_pipe_init"} -> !pto.pipe
    return
  }
}

// CHECK: VPTO bridge call to registry entry 'pipe.init' argument #0 has type 'i64', which does not match the registry ABI


// -----

module {
  func.func private @bad_result_abi(%storage: !pto.pipe) {
    %bad = pto.bridge_call <pipe_pop> (%storage : !pto.pipe) {callee = "pto_vpto_pipe_pop"} -> i32
    return
  }
}

// CHECK: VPTO bridge call to registry entry 'pipe.pop' result #0 has type 'i32', which does not match the registry ABI


// -----

module {
  func.func private @wrong_entry_symbol(%storage: !pto.pipe) {
    pto.bridge_call <pipe_free> (%storage : !pto.pipe) {callee = "pto_vpto_pipe_push__0"}
    return
  }
}

// CHECK: resolved callee 'pto_vpto_pipe_push__0' does not belong to bridge entry 'pipe.free'
