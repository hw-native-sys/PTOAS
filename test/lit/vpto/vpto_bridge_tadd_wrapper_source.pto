// Generic renderer output for the whitelist-registered tadd: the vec_elem
// wrapper declaration supplies the TAdd include and the __DAV_VEC__ core
// guard, and the single entry renders its role-named vec tile typedefs,
// the TASSIGN address bindings and the template-argument-free pto::TADD
// call. No C++ code in the wrapper generator knows vec_elem or TADD.

// RUN: env -u PTOAS_VPTO_BRIDGE_WHITELIST pto-test-opt %s -pto-lower-declarative-bridge-ops -pto-emit-vpto-bridge-wrapper | FileCheck %s --check-prefix=WRAP

// WRAP: module attributes {{{.*}}pto.vpto.bridge.wrapper_source = "
// WRAP-SAME: // VPTO bridge wrapper for 'vec_elem'.
// WRAP-SAME: #include <pto/pto-inst.hpp>
// WRAP-SAME: #include <pto/npu/a5/TAdd.hpp>
// WRAP-SAME: #include <stdint.h>
// WRAP-SAME: using LeftTile = pto::Tile<pto::TileType::Vec, float, 8, 16, pto::BLayout::RowMajor, 8, 16>;
// WRAP-SAME: using ResultTile = pto::Tile<pto::TileType::Vec, float, 8, 16, pto::BLayout::RowMajor, 8, 16>;
// WRAP-SAME: using RightTile = pto::Tile<pto::TileType::Vec, float, 8, 16, pto::BLayout::RowMajor, 8, 16>;
// WRAP-SAME: #ifdef __DAV_VEC__
// WRAP-SAME: extern \22C\22 [aicore] void pto_vpto_add(uint64_t dstAddress, uint64_t src0Address, uint64_t src1Address)
// WRAP-SAME: ResultTile dst;
// WRAP-SAME: LeftTile src0;
// WRAP-SAME: RightTile src1;
// WRAP-SAME: pto::TASSIGN_IMPL(dst, dstAddress);
// WRAP-SAME: pto::TASSIGN_IMPL(src0, src0Address);
// WRAP-SAME: pto::TASSIGN_IMPL(src1, src1Address);
// WRAP-SAME: pto::TADD(dst, src0, src1);
// WRAP-SAME: #endif
// WRAP-NOT: pto.vpto.bridge.spec

module attributes {pto.target_arch = "a5"} {
  func.func private @tadd_wrapper_vec(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : i64
    %c512 = arith.constant 512 : i64
    %c1024 = arith.constant 1024 : i64
    %src0 = pto.alloc_tile addr = %c0
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src1 = pto.alloc_tile addr = %c512
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile addr = %c1024
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tadd ins(%src0, %src1
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>,
        !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                                blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}
