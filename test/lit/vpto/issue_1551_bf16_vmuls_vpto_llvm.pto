// RUN: ( mkdir -p %T && ptoas --pto-arch=a5 --pto-backend=vpto --vpto-scheduler=off %s -o %t --mlir-print-ir-after=convert-func-to-llvm 2>&1 || true ) | FileCheck %s
// RUN: ( mkdir -p %T && ptoas --pto-arch=a5 --pto-backend=vpto --vpto-scheduler=off %s -o %t --mlir-print-ir-after=vpto-expand-wrapper-ops 2>&1 || true ) | FileCheck %s --check-prefix=EXPAND
// RUN: ( mkdir -p %T && ptoas --pto-arch=a5 --pto-backend=vpto --vpto-scheduler=on %s -o %t --mlir-print-ir-after=pto-vpto-scheduler 2>&1 || true ) | FileCheck %s --check-prefix=SCHED

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @bf16_vmuls(%src: !pto.ptr<bf16, ub>, %dst: !pto.ptr<bf16, ub>, %scale: bf16) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %mask = pto.pset_b16 "PAT_ALL" : !pto.mask<b16>
      %value = pto.vlds %src[%c0] : !pto.ptr<bf16, ub>, index -> !pto.vreg<128xbf16>
      %scaled = pto.vmuls %value, %scale, %mask : !pto.vreg<128xbf16>, bf16, !pto.mask<b16> -> !pto.vreg<128xbf16>
      pto.vsts %scaled, %dst[%c0], %mask : !pto.vreg<128xbf16>, !pto.ptr<bf16, ub>, index, !pto.mask<b16>
    }
    return
  }
}

// CHECK-LABEL: llvm.func @bf16_vmuls_mix_aiv
// CHECK: llvm.call @llvm.hivm.vdups.z.v128bf16
// CHECK: llvm.call @llvm.hivm.vmul.s.x.v128bf16
// CHECK-NOT: llvm.hivm.vmuls.s.x.v128bf16

// EXPAND-LABEL: func.func @bf16_vmuls
// EXPAND: %[[BROADCAST:.*]] = pto.vdup %arg2, %{{.*}} : bf16, !pto.mask<b16> -> !pto.vreg<128xbf16>
// EXPAND: %{{.*}} = pto.vmul %{{.*}}, %[[BROADCAST]], %{{.*}} : !pto.vreg<128xbf16>, !pto.vreg<128xbf16>, !pto.mask<b16> -> !pto.vreg<128xbf16>
// EXPAND-NOT: pto.vmuls

// SCHED-LABEL: func.func @bf16_vmuls
// SCHED: %[[BROADCAST:.*]] = pto.vdup %arg2, %{{.*}} : bf16, !pto.mask<b16> -> !pto.vreg<128xbf16>
// SCHED: %{{.*}} = pto.vmul %{{.*}}, %[[BROADCAST]], %{{.*}} : !pto.vreg<128xbf16>, !pto.vreg<128xbf16>, !pto.mask<b16> -> !pto.vreg<128xbf16>
// SCHED-NOT: pto.vmuls
