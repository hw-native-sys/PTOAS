// RUN: pto-test-opt %s -verify-diagnostics
// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --emit-vpto-llvm-ir %s -o - | FileCheck %s --check-prefix=LLVM

module {
  func.func @vtranspose(%dst: !pto.ptr<i16, ub>, %src: !pto.ptr<i16, ub>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.vtranspose %dst, %src : !pto.ptr<i16, ub>, !pto.ptr<i16, ub>
    return
  }

  func.func @vtranspose_unsigned(%dst: !pto.ptr<ui16, ub>, %src: !pto.ptr<ui16, ub>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.vtranspose %dst, %src : !pto.ptr<ui16, ub>, !pto.ptr<ui16, ub>
    return
  }

  func.func @vtranspose_signed(%dst: !pto.ptr<si16, ub>, %src: !pto.ptr<si16, ub>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    pto.vtranspose %dst, %src : !pto.ptr<si16, ub>, !pto.ptr<si16, ub>
    return
  }

}

// LLVM: declare void @llvm.hivm.VTRANSPOSE.s16.V300(ptr addrspace(6), ptr addrspace(6))
// LLVM: declare void @llvm.hivm.VTRANSPOSE.u16.V300(ptr addrspace(6), ptr addrspace(6))
// LLVM-LABEL: define void @vtranspose(ptr addrspace(6) %{{.*}}, ptr addrspace(6) %{{.*}})
// LLVM: call void @llvm.hivm.VTRANSPOSE.s16.V300(ptr addrspace(6)
// LLVM-LABEL: define void @vtranspose_unsigned(ptr addrspace(6) %{{.*}}, ptr addrspace(6) %{{.*}})
// LLVM: call void @llvm.hivm.VTRANSPOSE.u16.V300(ptr addrspace(6)
// LLVM-LABEL: define void @vtranspose_signed(ptr addrspace(6) %{{.*}}, ptr addrspace(6) %{{.*}})
// LLVM: call void @llvm.hivm.VTRANSPOSE.s16.V300(ptr addrspace(6)
// LLVM-NOT: pto.ttrans
