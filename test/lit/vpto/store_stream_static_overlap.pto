// RUN: pto-test-opt %s --vpto-stateful-stream-fusion | FileCheck %s
// RUN: sed 's/^module {/module attributes {pto.target_arch = "a3"} {/' %s | pto-test-opt --vpto-stateful-stream-fusion | FileCheck %s
// RUN: sed 's/^module {/module attributes {pto.target_arch = "a5"} {/' %s | pto-test-opt --vpto-stateful-stream-fusion | FileCheck %s

// CHECK: scf.for
// CHECK: pto.init_align
// CHECK: pto.vstus
// CHECK: pto.vstas

module {
  func.func @static_roots_overlap(%base: !pto.ptr<bf16, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %upper = arith.constant 4 : index
    %advance = arith.constant 8 : i32
    %zero = arith.constant 0 : i32
    %bfzero = arith.constant 0.0 : bf16
    %stride = arith.constant 8 : index
    %maxoff = arith.constant 2048 : index
    %address = arith.constant 4096 : i64
    %max = pto.castptr %address : i64 -> !pto.ptr<bf16, ub>
    %read_address = arith.constant 4128 : i64
    %read_pointer = pto.castptr %read_address : i64 -> !pto.ptr<bf16, ub>
    pto.vecscope {
      %mask = pto.pset_b16 "PAT_ALL" : !pto.mask<b16>
      %data = pto.vdup %bfzero, %mask : bf16, !pto.mask<b16> -> !pto.vreg<128xbf16>
      scf.for %i = %c0 to %upper step %c1 {
        %off = arith.muli %i, %stride : index
        %dst = pto.addptr %max, %off : !pto.ptr<bf16, ub>, index -> !pto.ptr<bf16, ub>
        %init = pto.init_align : !pto.align
        %align, %next = pto.vstus %init, %advance, %data, %dst : !pto.align, i32, !pto.vreg<128xbf16>, !pto.ptr<bf16, ub> -> !pto.align, !pto.ptr<bf16, ub>
        pto.vstas %align, %next, %zero : !pto.align, !pto.ptr<bf16, ub>, i32
        %read = pto.vlds %read_pointer[%c0] : !pto.ptr<bf16, ub>, index -> !pto.vreg<128xbf16>
      }
    }
    return
  }
}
