// RUN: pto-test-opt %s -vpto-optimize-vcvt | FileCheck %s

// A prefix-masked EVEN f32->bf16 conversion feeding a matching b16 store mask
// has valid payloads in the low half of each b32 lane. PK_B32 stores compact
// those payloads into the dense b16 prefix.
module {
  func.func @prefix_masked_even_bf16_store(
      %src: !pto.vreg<64xf32>, %dst: !pto.ptr<bf16, ub>) {
    %c0 = arith.constant 0 : index
    %mask32 = pto.pset_b32 "PAT_VL8" : !pto.mask<b32>
    %mask16 = pto.pset_b16 "PAT_VL8" : !pto.mask<b16>
    %converted = pto.vcvt %src, %mask32 {part = "EVEN", rnd = "Z", sat = "NOSAT"}
        : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<128xbf16>
    pto.vsts %converted, %dst[%c0], %mask16 {dist = "NORM_B16"}
        : !pto.vreg<128xbf16>, !pto.ptr<bf16, ub>, index, !pto.mask<b16>
    return
  }
}

// CHECK-LABEL: func.func @prefix_masked_even_bf16_store(
// CHECK: %[[MASK32:.*]] = pto.pset_b32 "PAT_VL8" : !pto.mask<b32>
// CHECK: %[[MASK16:.*]] = pto.pset_b16 "PAT_VL8" : !pto.mask<b16>
// CHECK: %[[CVT:.*]] = pto.vcvt %arg0, %[[MASK32]] {part = "EVEN", rnd = "Z", sat = "NOSAT"}
// CHECK: %[[WIDENED_MASK:.*]] = pto.punpack %[[MASK16]], "LOWER" : !pto.mask<b16> -> !pto.mask<b32>
// CHECK: pto.vsts %[[CVT]], %arg1[%{{.*}}], %[[WIDENED_MASK]] {dist = "PK_B32"}
