// Issue #1751: an omitted layout clause is NOT the native normal-mode
// writeback. getAccStoreModeConfig() sets NZ2ND (X_t[43]) for the layout-less
// form, so it emits exactly the `nz2nd` configuration. This file pins that
// behavior so the docs (`pto.mte_l0c_*: use nz2nz for normal mode`) and the
// lowering cannot drift apart again.
//
// X_t = loop_src_stride(16) | quant_pre f32_bf16 (16 << 34) |
//       unit_flag(check_and_clear) (3 << 32) | NZ2ND (1 << 43) = 9083855831056,
// which is the same constant the explicit `nz2nd` store produces in
// acc_store_l1_normal_bf16.pto.

// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --mlir-print-ir-after=vpto-expand-wrapper-ops %s -o /dev/null 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @l1_omitted_layout_bf16_writeback(%acc: !pto.ptr<f32, l0c>,
                                              %l1: !pto.ptr<bf16, l1>) attributes {pto.kernel} {
    %c16_i64 = arith.constant 16 : i64
    %c0_bf16 = arith.constant 0.000000e+00 : bf16

    pto.mte_l0c_l1 %acc, %l1, %c16_i64, %c16_i64, %c16_i64, %c16_i64,
      unit_flag(check_and_clear),
      pre_quant(%c0_bf16, mode = f32_bf16)
      : !pto.ptr<f32, l0c>, !pto.ptr<bf16, l1>, i64, i64, i64, i64, bf16
    return
  }
}

// CHECK-LABEL: func.func @l1_omitted_layout_bf16_writeback(
// CHECK-DAG: %[[XM:.*]] = arith.constant 68720525568 : i64
// CHECK-DAG: %[[XT:.*]] = arith.constant 9083855831056 : i64
// CHECK: pto.copy_matrix_cc_to_cbuf %{{.*}}, %{{.*}}, %[[XM]], %[[XT]]
