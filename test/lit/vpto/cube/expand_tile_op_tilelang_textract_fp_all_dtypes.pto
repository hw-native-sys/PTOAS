  func.func @TEXTRACT_FP_SI32_BF16() attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %src = pto.alloc_tile : !pto.tile_buf<loc=acc, dtype=si32, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=1024, pad=0>
