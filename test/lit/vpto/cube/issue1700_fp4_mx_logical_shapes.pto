// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --enable-tile-op-expand --emit-vpto %s -o - | FileCheck %s

!A = !pto.tile_buf<loc=left, dtype=!pto.f4E2M1x2, rows=16, cols=128, v_row=12, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0>
!B = !pto.tile_buf<loc=right, dtype=!pto.f4E2M1x2, rows=128, cols=32, v_row=128, v_col=24, blayout=row_major, slayout=col_major, fractal=512, pad=0>
!AS = !pto.tile_buf<loc=scaling, dtype=f16, rows=32, cols=4, v_row=24, v_col=4, blayout=row_major, slayout=row_major, fractal=32, pad=0>
!BS = !pto.tile_buf<loc=scaling, dtype=f16, rows=4, cols=64, v_row=4, v_col=48, blayout=col_major, slayout=col_major, fractal=32, pad=0>
!C = !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=64, v_row=24, v_col=48, blayout=col_major, slayout=row_major, fractal=512, pad=0>
!Bias = !pto.tile_buf<loc=bias, dtype=f32, rows=1, cols=64, v_row=1, v_col=48, blayout=row_major, slayout=none_box, fractal=512, pad=0>

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @fp4_mx_logical_mn() attributes {pto.kernel} {
    %a = pto.alloc_tile : !A
    %b = pto.alloc_tile : !B
    %as = pto.alloc_tile : !AS
    %bs = pto.alloc_tile : !BS
    %bias = pto.alloc_tile : !Bias
    %c = pto.alloc_tile : !C
    pto.tmatmul.mx ins(%a, %as, %b, %bs : !A, !AS, !B, !BS) outs(%c : !C)
    pto.tmatmul.mx.acc ins(%c, %a, %as, %b, %bs : !C, !A, !AS, !B, !BS) outs(%c : !C)
    pto.tmatmul.mx.bias ins(%a, %as, %b, %bs, %bias : !A, !AS, !B, !BS, !Bias) outs(%c : !C)
    return
  }
}

// CHECK-LABEL: func.func @fp4_mx_logical_mn
// MAD configuration words encode logical M=24, N=48, K=128.
// CHECK-DAG: %[[BIAS:.*]] = arith.constant 6917529028446912536 : i64
// CHECK-DAG: %[[ACC:.*]] = arith.constant 2305843010019524632 : i64
// CHECK-DAG: %[[INIT:.*]] = arith.constant -6917529026835251176 : i64
// CHECK: pto.mad_mx_raw {{.*}}, %[[INIT]] :
// CHECK: pto.mad_mx_raw {{.*}}, %[[ACC]] :
// CHECK: pto.mad_mx_bias_raw {{.*}}, %[[BIAS]] :
// CHECK-NOT: pto.tmatmul.mx
