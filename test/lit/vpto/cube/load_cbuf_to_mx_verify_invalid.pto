    %dst = pto.castptr %c1 : i64 -> !pto.ptr<f8E4M3FN, l0a>
    pto.mte_l1_l0a_mx %src, %dst, %c0, %c0, %c0, %c0
      : !pto.ptr<!pto.f8E8M0, l1>, !pto.ptr<f8E4M3FN, l0a>, i64, i64, i64, i64
