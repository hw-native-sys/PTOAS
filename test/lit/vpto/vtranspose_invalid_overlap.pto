// RUN: pto-test-opt %s -verify-diagnostics

module {
  func.func @vtranspose_in_place(%buf: !pto.ptr<i16, ub>) {
    // expected-error @+1 {{'pto.vtranspose' op requires distinct destination and source pointers}}
    pto.vtranspose %buf, %buf : !pto.ptr<i16, ub>, !pto.ptr<i16, ub>
    return
  }
}
