// Phase 4 tmpl_map consumption: an uncovered tmpl_map declaration must be
// rejected instead of being silently dropped. With the role-driven
// declarative schema the rejection moved earlier: tile typedefs derive
// from the abi roles and the whitelist validator accepts only 'attr'
// tmpl_map rows for declarative entries, so an uncovered tile declaration
// can no longer reach wrapper generation. The fixture's AccInTile slot (no
// matching abi role) is therefore diagnosed at whitelist parse time.

// RUN: not pto-test-opt %s "-pto-lower-declarative-bridge-ops=whitelist-path=%S/Inputs/vpto-bridge-whitelist-matmul-uncovered-tmpl.yaml" 2>&1 | FileCheck %s

// CHECK: VPTO bridge whitelist: tmpl_map row of entry 'pto_vpto_matmul' uses source 'acc_in_tile', but declarative entries only accept 'attr' rows (tile typedefs derive from the abi roles) in '{{.*}}vpto-bridge-whitelist-matmul-uncovered-tmpl.yaml'

module attributes {pto.target_arch = "a5"} {
  func.func private @matmul_uncovered_cube(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c0 = arith.constant 0 : i64
    %c1024 = arith.constant 1024 : i64
    %c2048 = arith.constant 2048 : i64
    %lhs = pto.alloc_tile addr = %c0
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %rhs = pto.alloc_tile addr = %c1024
      : !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %acc = pto.alloc_tile addr = %c2048
      : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    pto.tmatmul ins(%lhs, %rhs
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>,
        !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      outs(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                                blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
    return
  }
}
