// Phase 4 tmpl_map consumption: wrapper generation validates that every
// tmpl_map slot declared by a used whitelist entry is covered by a token
// the family pass collected. The fixture declares an AccInTile slot fed by
// acc_in_tile for the tmatmul entry, but the module carries no tmatmul.acc,
// so no acc_in_tile token is collected and the declaration must be
// rejected instead of being silently dropped.

// RUN: not pto-test-opt %s "-pto-lower-matmul-family-ops=whitelist-path=%S/Inputs/vpto-bridge-whitelist-matmul-uncovered-tmpl.yaml" "-pto-emit-vpto-bridge-wrapper=whitelist-path=%S/Inputs/vpto-bridge-whitelist-matmul-uncovered-tmpl.yaml" 2>&1 | FileCheck %s

// CHECK: error: VPTO bridge: whitelist entry 'pto_vpto_matmul' declares tmpl_map target 'AccInTile' from source 'acc_in_tile', but no token was collected for it

module attributes {pto.target_arch = "a5"} {
  func.func private @matmul_uncovered_cube(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c0 = arith.constant 0 : i64
    %c1024 = arith.constant 1024 : i64
    %c2048 = arith.constant 2048 : i64
    %lhs = pto.alloc_tile addr = %c0
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %rhs = pto.alloc_tile addr = %c1024
      : !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %acc = pto.alloc_tile addr = %c2048
      : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    pto.tmatmul ins(%lhs, %rhs
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>,
        !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      outs(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                                blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
    return
  }
}
