// RUN: pto-test-opt %s -vpto-normalize-address-recurrences | FileCheck %s
// RUN: pto-test-opt %s -vpto-normalize-address-recurrences -vpto-soft-postupdate | FileCheck %s --check-prefix=POST

// CHECK-LABEL: func.func @i16_final_backedge_wrap
// CHECK-NOT: arith.extsi
// CHECK: pto.sprsts "AR", {{%.*}}[{{%.*}}]

// CHECK-LABEL: func.func @source_i32_wrap
// CHECK-NOT: arith.extsi
// CHECK: pto.sprsts "AR", {{%.*}}[{{%.*}}]

// CHECK-LABEL: func.func @complex_backedge
// CHECK-NOT: arith.extsi
// CHECK: pto.sprsts "AR", {{%.*}}[{{%.*}}]

// CHECK-LABEL: func.func @other_user
// CHECK: scf.for %[[IV:.*]] = %{{.*}} to %{{.*}} step %{{.*}} : i16 {
// CHECK-NEXT: %[[RESTORED:.*]] = arith.index_cast %[[IV]] : i16 to index
// CHECK: pto.vlds {{%.*}}[%[[RESTORED]]]
// CHECK: arith.cmpi eq, %[[RESTORED]], %c0 : index

// CHECK-LABEL: func.func @signed_i8_constraint
// CHECK: scf.for %{{.*}} = %{{.*}} to %{{.*}} step %{{.*}} : i16 {
// CHECK: arith.index_cast %{{.*}} : i16 to index
// CHECK: pto.sprsti "AR", {{%.*}}[%c0_i32]
// POST-LABEL: func.func @signed_i8_constraint
// POST: scf.for %{{.*}} = %{{.*}} to %{{.*}} step %{{.*}} : i16 {
// POST: arith.index_cast %{{.*}} : i16 to index
// POST: pto.sprsti "AR", %{{.*}}[%c0_i32]

// CHECK-LABEL: func.func @constant_constraint_dynamic_advance
// CHECK: arith.index_cast %{{.*}} : i16 to index
// CHECK: pto.pldi {{%.*}}[%c0], "NORM"
// CHECK: overflow<nsw>
// POST-LABEL: func.func @constant_constraint_dynamic_advance
// POST: scf.for {{.*}} iter_args(%{{.*}} = %{{.*}}, %{{.*}} = %c1_i16)
// POST: arith.index_cast %{{.*}} : i16 to index
// POST: pto.pldi %{{.*}}[%c0], "NORM"
// POST: pto.addptr %{{.*}}, %{{.*}}
// POST: overflow<nsw>

// One loop may convert a dynamic vlds candidate while a SignedI8 sprsti
// candidate remains ordinary. Both continue to use the same narrowed IV.
// CHECK-LABEL: func.func @mixed_postupdate_result
// CHECK: scf.for %{{.*}} = %{{.*}} to %{{.*}} step %{{.*}} : i16 {
// CHECK: pto.vlds
// CHECK: pto.sprsti
// POST-LABEL: func.func @mixed_postupdate_result
// POST: scf.for %{{.*}} = %{{.*}} to %{{.*}} step %{{.*}} iter_args(%{{.*}} = %{{.*}}) -> (!pto.ptr<ui32, ub>) : i16 {
// POST: arith.index_cast %{{.*}} : i16 to index
// POST: pto.vlds {{.*}} -> !pto.vreg<64xui32>, !pto.ptr<ui32, ub>
// POST: pto.addptr %{{.*}}, %{{.*}}
// POST: pto.sprsti "AR", %{{.*}}[%c0_i32]

// A safe base offset is normalized even when the same op's explicit offset has
// a complex recurrence that cannot be normalized or consumed by post-update.
// CHECK-LABEL: func.func @best_effort_independent_leaves
// CHECK: scf.for %{{.*}} = %{{.*}} to %{{.*}} step %{{.*}} iter_args(%{{.*}} = %c1) -> (index) : i16 {
// CHECK: arith.index_cast %{{.*}} : i16 to index
// CHECK: pto.addptr %{{.*}}, %{{.*}}
// CHECK: pto.vlds %{{.*}}[{{%.*}}]
// POST-LABEL: func.func @best_effort_independent_leaves
// POST: scf.for %{{.*}} = %{{.*}} to %{{.*}} step %{{.*}} iter_args(%{{.*}} = %c1) -> (index) : i16 {
// POST: arith.index_cast %{{.*}} : i16 to index
// POST: pto.addptr %{{.*}}, %{{.*}}
// POST: pto.vlds %{{.*}}[{{%.*}}] : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>

// CHECK-LABEL: func.func @dynamic_trip_count
// CHECK-NOT: arith.index_cast %{{.*}} : i16 to index
// CHECK: pto.vlds {{%.*}}[{{%.*}}]

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @i16_final_backedge_wrap(%base: !pto.ptr<ui32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c32760_i32 = arith.constant 32760 : i32
    %c4_i32 = arith.constant 4 : i32
    pto.vecscope {
      scf.for %iv = %c0 to %c2 step %c1
          iter_args(%offset = %c32760_i32) -> i32 {
        pto.sprsts "AR", %base[%offset] : !pto.ptr<ui32, ub>, i32
        %next = arith.addi %offset, %c4_i32 : i32
        scf.yield %next : i32
      }
    }
    return
  }

  func.func @source_i32_wrap(%base: !pto.ptr<ui32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %cmax_i32 = arith.constant 2147483647 : i32
    %c1_i32 = arith.constant 1 : i32
    pto.vecscope {
      scf.for %iv = %c0 to %c2 step %c1
          iter_args(%offset = %cmax_i32) -> i32 {
        pto.sprsts "AR", %base[%offset] : !pto.ptr<ui32, ub>, i32
        %next = arith.addi %offset, %c1_i32 : i32
        scf.yield %next : i32
      }
    }
    return
  }

  func.func @complex_backedge(%base: !pto.ptr<ui32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c0_i32 = arith.constant 0 : i32
    %c2_i32 = arith.constant 2 : i32
    pto.vecscope {
      scf.for %iv = %c0 to %c2 step %c1
          iter_args(%offset = %c0_i32) -> i32 {
        pto.sprsts "AR", %base[%offset] : !pto.ptr<ui32, ub>, i32
        %next = arith.muli %offset, %c2_i32 : i32
        scf.yield %next : i32
      }
    }
    return
  }

  func.func @other_user(%base: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    pto.vecscope {
      scf.for %iv = %c0 to %c2 step %c1 {
        %value = pto.vlds %base[%iv]
            : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
        %other = arith.cmpi eq, %iv, %c0 : index
      }
    }
    return
  }

  func.func @signed_i8_constraint(%base: !pto.ptr<ui32, ub>) {
    %c0 = arith.constant 0 : index
    %c128 = arith.constant 128 : index
    %c256 = arith.constant 256 : index
    %c0_i32 = arith.constant 0 : i32
    pto.vecscope {
      scf.for %iv = %c0 to %c256 step %c128 {
        %at = pto.addptr %base, %iv
            : !pto.ptr<ui32, ub> -> !pto.ptr<ui32, ub>
        pto.sprsti "AR", %at[%c0_i32] : !pto.ptr<ui32, ub>, i32
      }
    }
    return
  }

  func.func @constant_constraint_dynamic_advance(%base: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c3 = arith.constant 3 : index
    pto.vecscope {
      scf.for %iv = %c0 to %c3 step %c1
          iter_args(%ptr = %base, %advance = %c1) -> (!pto.ptr<ui8, ub>, index) {
        %mask = pto.pldi %ptr[%c0], "NORM"
            : !pto.ptr<ui8, ub>, index -> !pto.mask<b8>
        %next_ptr = pto.addptr %ptr, %advance
            : !pto.ptr<ui8, ub> -> !pto.ptr<ui8, ub>
        %next_advance = arith.addi %advance, %c1 : index
        scf.yield %next_ptr, %next_advance : !pto.ptr<ui8, ub>, index
      }
    }
    return
  }

  func.func @mixed_postupdate_result(%base: !pto.ptr<ui32, ub>) {
    %c0 = arith.constant 0 : index
    %c128 = arith.constant 128 : index
    %c256 = arith.constant 256 : index
    %c0_i32 = arith.constant 0 : i32
    pto.vecscope {
      scf.for %iv = %c0 to %c256 step %c128 {
        %value = pto.vlds %base[%iv]
            : !pto.ptr<ui32, ub> -> !pto.vreg<64xui32>
        %at = pto.addptr %base, %iv
            : !pto.ptr<ui32, ub> -> !pto.ptr<ui32, ub>
        pto.sprsti "AR", %at[%c0_i32] : !pto.ptr<ui32, ub>, i32
      }
    }
    return
  }

  func.func @best_effort_independent_leaves(%base: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c2 = arith.constant 2 : index
    pto.vecscope {
      scf.for %iv = %c0 to %c4 step %c1
          iter_args(%offset = %c1) -> index {
        %at = pto.addptr %base, %iv
            : !pto.ptr<ui8, ub> -> !pto.ptr<ui8, ub>
        %value = pto.vlds %at[%offset]
            : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
        %next = arith.muli %offset, %c2 : index
        scf.yield %next : index
      }
    }
    return
  }

  func.func @dynamic_trip_count(%base: !pto.ptr<ui8, ub>, %upper: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    pto.vecscope {
      scf.for %iv = %c0 to %upper step %c1 {
        %value = pto.vlds %base[%iv]
            : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
      }
    }
    return
  }
}
