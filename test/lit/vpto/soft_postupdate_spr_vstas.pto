// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --enable-vpto-soft-postupdate --emit-vpto %s -o - | FileCheck %s

// CHECK-LABEL: func.func @sequential_sprsti
// CHECK: [[SPRSTI1:%[a-zA-Z0-9_]+]] = pto.sprsti "AR", {{%.*}}[%c4{{.*}}]
// CHECK: [[SPRSTI2:%[a-zA-Z0-9_]+]] = pto.sprsti "AR", [[SPRSTI1]][%c4{{.*}}]
// CHECK: %{{.*}} = pto.sprsti "AR", [[SPRSTI2]][%c4{{.*}}]

// CHECK-LABEL: func.func @sequential_sprsts
// CHECK: [[SPRSTS1:%[a-zA-Z0-9_]+]] = pto.sprsts "AR", {{%.*}}[%c4{{.*}}]
// CHECK: [[SPRSTS2:%[a-zA-Z0-9_]+]] = pto.sprsts "AR", [[SPRSTS1]][%c4{{.*}}]
// CHECK: %{{.*}} = pto.sprsts "AR", [[SPRSTS2]][%c4{{.*}}]

// CHECK-LABEL: func.func @sprsti_out_of_range_is_skipped
// CHECK: scf.for
// CHECK: pto.sprsti "AR", {{%.*}}[%c0{{.*}}] : !pto.ptr<ui32, ub>, i32

// CHECK-LABEL: func.func @sequential_vstas
// CHECK: [[VSTAS1:%[a-zA-Z0-9_]+]] = pto.vstas {{.*}}, {{%.*}}, %c4{{.*}}
// CHECK: [[VSTAS2:%[a-zA-Z0-9_]+]] = pto.vstas {{.*}}, [[VSTAS1]], %c4{{.*}}
// CHECK: %{{.*}} = pto.vstas {{.*}}, [[VSTAS2]], %c4{{.*}}

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @sequential_sprsti(%dst: !pto.ptr<ui32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : i32
    %c4 = arith.constant 4 : i32
    %c8 = arith.constant 8 : i32
    pto.vecscope {
      pto.sprsti "AR", %dst[%c0] : !pto.ptr<ui32, ub>, i32
      pto.sprsti "AR", %dst[%c4] : !pto.ptr<ui32, ub>, i32
      pto.sprsti "AR", %dst[%c8] : !pto.ptr<ui32, ub>, i32
    }
    return
  }

  func.func @sequential_sprsts(%dst: !pto.ptr<ui32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : i32
    %c4 = arith.constant 4 : i32
    %c8 = arith.constant 8 : i32
    pto.vecscope {
      pto.sprsts "AR", %dst[%c0] : !pto.ptr<ui32, ub>, i32
      pto.sprsts "AR", %dst[%c4] : !pto.ptr<ui32, ub>, i32
      pto.sprsts "AR", %dst[%c8] : !pto.ptr<ui32, ub>, i32
    }
    return
  }

  func.func @sprsti_out_of_range_is_skipped(
      %dst: !pto.ptr<ui32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : i32
    %c0_index = arith.constant 0 : index
    %c1_index = arith.constant 1 : index
    %c4_index = arith.constant 4 : index
    %c128_index = arith.constant 128 : index
    pto.vecscope {
      scf.for %iv = %c0_index to %c4_index step %c1_index {
        %scaled = arith.muli %iv, %c128_index : index
        %dst_at = pto.addptr %dst, %scaled
            : !pto.ptr<ui32, ub> -> !pto.ptr<ui32, ub>
        pto.sprsti "AR", %dst_at[%c0] : !pto.ptr<ui32, ub>, i32
      }
    }
    return
  }

  func.func @sequential_vstas(%dst: !pto.ptr<f32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : i32
    %c4 = arith.constant 4 : i32
    %c8 = arith.constant 8 : i32
    pto.vecscope {
      %align0 = pto.init_align : !pto.align
      pto.vstas %align0, %dst, %c0 : !pto.align, !pto.ptr<f32, ub>, i32
      %align1 = pto.init_align : !pto.align
      pto.vstas %align1, %dst, %c4 : !pto.align, !pto.ptr<f32, ub>, i32
      %align2 = pto.init_align : !pto.align
      pto.vstas %align2, %dst, %c8 : !pto.align, !pto.ptr<f32, ub>, i32
    }
    return
  }
}
