// RUN: pto-test-opt --pto-insert-vecscope-membar %s | FileCheck %s
// RUN: pto-test-opt --pto-insert-vecscope-membar --pto-insert-vecscope-membar %s | FileCheck %s

// Early-pass only: full-pipeline canonicalization folds this overflowing loop.
!mb32 = !pto.mask<b32>
!pf32ub = !pto.ptr<f32, ub>
!v64xf32 = !pto.vreg<64xf32>

module {
// CHECK-LABEL: func.func @outer_wrapping_iv(
// CHECK: pto.vscatter
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: pto.vlds
// CHECK: return
  func.func @outer_wrapping_iv() {
    %lb = arith.constant 100 : i8
    %ub = arith.constant 120 : i8
    %step = arith.constant 100 : i8
    %read = arith.constant 8 : index
    %sinkoff = arith.constant 256 : index
    %four = arith.constant 4 : i32
    %f = arith.constant 1.0 : f32
    %addr = arith.constant 0 : i64
    %base = pto.castptr %addr : i64 -> !pf32ub
    scf.for %iv = %lb to %ub step %step : i8 {
      %ext = arith.extsi %iv : i8 to i32
      %start = arith.muli %ext, %four : i32
      pto.vecscope {
        %all = pto.pset_b32 "PAT_ALL" : !mb32
        %mask = pto.pset_b32 "PAT_VL4" : !mb32
        %v = pto.vdup %f, %all : f32, !mb32 -> !v64xf32
        %idx = pto.vci %start : i32 -> !pto.vreg<64xi32>
        %offsets = pto.vbitcast %idx : !pto.vreg<64xi32> -> !pto.vreg<64xui32>
        pto.vscatter %v, %base, %offsets, %mask : !v64xf32, !pf32ub, !pto.vreg<64xui32>, !mb32
        %z = pto.vlds %base[%read] : !pf32ub, index -> !v64xf32
        pto.vsts %z, %base[%sinkoff], %all : !v64xf32, !pf32ub, index, !mb32
      }
    }
    return
  }

}
