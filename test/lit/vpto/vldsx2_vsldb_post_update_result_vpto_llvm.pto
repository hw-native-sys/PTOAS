// RUN: ptoas --cann-output-version=9.0.0 --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s
// RUN: ptoas --cann-output-version=9.0.0-beta.1 --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @load_post_update(%src: !pto.ptr<f32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1_i16 = arith.constant 1 : i16
    %c2_i16 = arith.constant 2 : i16
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %low, %high, %next_x2 = pto.vldsx2 %src[%c0], "DINTLV_B32"
          : !pto.ptr<f32, ub>, index
          -> !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.ptr<f32, ub>
      %value, %next_block = pto.vsldb %next_x2, %c2_i16, %c1_i16, %mask
          : !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32>
          -> !pto.vreg<64xf32>, !pto.ptr<f32, ub>
      pto.vsts %low, %next_block[%c0], %mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.vsts %high, %next_block[%c0], %mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      pto.vsts %value, %next_block[%c0], %mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }
}

// CHECK-DAG: declare { <64 x float>, <64 x float>, ptr addrspace(6) } @llvm.hivm.vldsx2.post.v64f32
// CHECK-DAG: declare { <64 x float>, ptr addrspace(6) } @llvm.hivm.vsldb.post.v64f32
// CHECK: call { <64 x float>, <64 x float>, ptr addrspace(6) } @llvm.hivm.vldsx2.post.v64f32
// CHECK-SAME: i32 1)
// CHECK: call { <64 x float>, ptr addrspace(6) } @llvm.hivm.vsldb.post.v64f32
// CHECK-SAME: i32 1,
