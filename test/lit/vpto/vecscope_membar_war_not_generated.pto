// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar %s -o - 2>/dev/null | FileCheck %s

// First version does NOT analyze WAR (load -> store) and must NOT insert
// `VLD_VST`. Here the only ordered pair is load@ub0 -> store@ub0 (WAR),
// so no barrier should appear.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vecscope_membar_war_not_generated() {
    %c0 = arith.constant 0 : index
    %c0_i64 = arith.constant 0 : i64
    %ub = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
    // load@ub0 -> store@ub0 is WAR (VLD -> VST). Not handled.
    %vec0 = pto.vlds %ub[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    pto.vsts %vec0, %ub[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    return
  }
}

// CHECK-LABEL: func.func @vecscope_membar_war_not_generated
// CHECK: pto.vecscope
// CHECK: pto.vlds
// CHECK-NOT: pto.mem_bar "VLD_VST"
// CHECK: pto.vsts
