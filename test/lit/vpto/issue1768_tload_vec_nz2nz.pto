// #1768: a canonical 5D NZ view [2, 1, 2, 16, 8] covers g2 * g3 = 32 logical
// rows and g0 * g1 * g4 = 16 logical columns, so it must select the NZ load
// and store templates for a [32, 16] fractal tile.  The template bodies loop
// over the g0 = 2 outer axis, emitting one grouped DMA of
// len_burst = valid_rows * 32 bytes per iteration.
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-tile-op-expand --mlir-print-ir-after=pto-expand-tile-op %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=EXPAND
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-tile-op-expand %s -o - 2>/dev/null | FileCheck %s
// RUN: sed 's/fractal=512/fractal=1024/g' %s > %t.fractal1024.pto
// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-tile-op-expand %t.fractal1024.pto -o /dev/null 2>&1 | FileCheck %s --check-prefix=INCOMPATIBLE
// INCOMPATIBLE: NoMatchingTemplate: no legal template for op='pto.tload' target='a5'

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @tload_vec_nz2nz(%src: !pto.ptr<f32>) attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c8 = arith.constant 8 : index
    %c16 = arith.constant 16 : index
    %c128 = arith.constant 128 : index
    %c256 = arith.constant 256 : index
    %root = pto.make_tensor_view %src,
      shape = [%c2, %c1, %c2, %c16, %c8],
      strides = [%c256, %c256, %c128, %c8, %c1]
      {layout = #pto.layout<nz>}
      : !pto.tensor_view<2x1x2x16x8xf32>
    %part = pto.partition_view %root,
      offsets = [%c0, %c0, %c0, %c0, %c0],
      sizes = [%c2, %c1, %c2, %c16, %c8]
      : !pto.tensor_view<2x1x2x16x8xf32> -> !pto.partition_tensor_view<2x1x2x16x8xf32>
    %tile = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=16, v_row=32, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.tload
      ins(%part : !pto.partition_tensor_view<2x1x2x16x8xf32>)
      outs(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=16, v_row=32, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }

  func.func @tstore_vec_nz2nz(%dst: !pto.ptr<f32>) attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c8 = arith.constant 8 : index
    %c16 = arith.constant 16 : index
    %c128 = arith.constant 128 : index
    %c256 = arith.constant 256 : index
    %root = pto.make_tensor_view %dst,
      shape = [%c2, %c1, %c2, %c16, %c8],
      strides = [%c256, %c256, %c128, %c8, %c1]
      {layout = #pto.layout<nz>}
      : !pto.tensor_view<2x1x2x16x8xf32>
    %part = pto.partition_view %root,
      offsets = [%c0, %c0, %c0, %c0, %c0],
      sizes = [%c2, %c1, %c2, %c16, %c8]
      : !pto.tensor_view<2x1x2x16x8xf32> -> !pto.partition_tensor_view<2x1x2x16x8xf32>
    %tile = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=16, v_row=32, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.tstore
      ins(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=16, v_row=32, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
      outs(%part : !pto.partition_tensor_view<2x1x2x16x8xf32>)
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}

// The GM view's logical extents (g2 * g3 rows, g0 * g1 * g4 columns) must
// accept the NZ templates instead of raising NoMatchingTemplate.  Each
// template loops over g0 = 2 as an scf.for loop with one grouped DMA inside
// the body: nburst count = g1 = 1, len_burst = valid_rows * 32 = 1024, and
// both the GM and UB burst strides are 1024 bytes.
// EXPAND-LABEL: func.func private @{{.*}}__template_tload_nz2nz(
// EXPAND: %[[LOAD_G0:.+]] = pto.constant 2 : index
// EXPAND: scf.for {{.*}} to %[[LOAD_G0]] step
// EXPAND: pto.mte_gm_ub {{.*}} nburst(
// EXPAND-LABEL: func.func private @{{.*}}__template_tstore_nz(
// EXPAND: %[[STORE_G0:.+]] = pto.constant 2 : index
// EXPAND: scf.for {{.*}} to %[[STORE_G0]] step
// EXPAND: pto.mte_ub_gm {{.*}} nburst(

// After the full tile-op-expand path on the VPTO backend, each tile op is
// lowered to one VPTO DMA copy inside its g0 = 2 loop.  n_burst = g1 = 1 is
// the only operand that distinguishes the burst grouping from the shared
// 1024-byte length and strides.
// CHECK-LABEL: func.func @tload_vec_nz2nz(
// CHECK-DAG: %[[LOAD_NB:.+]] = arith.constant 1 : i64
// CHECK-DAG: %[[LOAD_LEN:.+]] = arith.constant 1024 : i64
// CHECK-DAG: %[[LOAD_G0:.+]] = arith.constant 2 : index
// CHECK: scf.for {{.*}} to %[[LOAD_G0]] step
// CHECK: pto.copy_gm_to_ubuf {{.*}}, %[[LOAD_NB]], %[[LOAD_LEN]], {{.*}}, %[[LOAD_LEN]], %[[LOAD_LEN]]
// CHECK-LABEL: func.func @tstore_vec_nz2nz(
// CHECK-DAG: %[[STORE_NB:.+]] = arith.constant 1 : i64
// CHECK-DAG: %[[STORE_LEN:.+]] = arith.constant 1024 : i64
// CHECK-DAG: %[[STORE_G0:.+]] = arith.constant 2 : index
// CHECK: scf.for {{.*}} to %[[STORE_G0]] step
// CHECK: pto.copy_ubuf_to_gm {{.*}}, %[[STORE_NB]], %[[STORE_LEN]], {{.*}}, %[[STORE_LEN]], %[[STORE_LEN]]
