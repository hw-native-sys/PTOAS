// RUN: ptoas --cann-output-version=9.0.0 --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @scalar_contiguous_pto_pointer(
      %src: !pto.ptr<vector<4xf32>, gm>,
      %dst: !pto.ptr<vector<4xf32>, gm>) attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %value = pto.load %src[%c0] : !pto.ptr<vector<4xf32>, gm> -> vector<4xf32>
    pto.store %value, %dst[%c0] : !pto.ptr<vector<4xf32>, gm>, vector<4xf32>
    return
  }
}

// CHECK-LABEL: define void @scalar_contiguous_pto_pointer
// CHECK: load <4 x float>, ptr addrspace(1)
// CHECK: store <4 x float>
