// RUN: pto-test-opt %s -mlir-disable-threading -pto-print-address-analysis 2>&1 | FileCheck %s
module {
  func.func @strength(%p: !pto.ptr<f32, ub> {pto.alignment = 32 : i64}) {
    %z = arith.constant 0 : index
    %v = pto.vlds %p[%z] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    return
  }
  func.func @unsigned_narrow() {
    %n = arith.constant -8 : i4
    %w = arith.extui %n : i4 to i64
    %base = arith.constant 4096 : i64
    %addr = arith.addi %base, %w : i64
    %p = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
    %two = arith.constant 2 : index
    %v = pto.vlds %p[%two] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    return
  }
  func.func @signed_narrow() {
    %n = arith.constant -8 : i4
    %w = arith.extsi %n : i4 to i64
    %base = arith.constant 4096 : i64
    %addr = arith.addi %base, %w : i64
    %p = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
    %two = arith.constant 2 : index
    %v = pto.vlds %p[%two] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    return
  }
  func.func @truncated_select(%c: i1) {
    %a = arith.constant 24 : i64
    %b = arith.constant 40 : i64
    %selected = arith.select %c, %a, %b : i64
    %n = arith.trunci %selected : i64 to i4
    %w = arith.extui %n : i4 to i64
    %base = arith.constant 4096 : i64
    %addr = arith.addi %base, %w : i64
    %p = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
    %two = arith.constant 2 : index
    %v = pto.vlds %p[%two] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
    return
  }

}
// CHECK-LABEL: address-analysis @strength
// CHECK: remainder-bytes 16=0 32=0 64=unknown
// CHECK-LABEL: address-analysis @unsigned_narrow
// CHECK: remainder-bytes 16=0 32=unknown 64=unknown
// CHECK-LABEL: address-analysis @signed_narrow
// CHECK: remainder-bytes 16=0 32=unknown 64=unknown
// CHECK-LABEL: address-analysis @truncated_select
// CHECK: remainder-bytes 16=0 32=unknown 64=unknown
