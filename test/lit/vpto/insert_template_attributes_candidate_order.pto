// Candidate order comes from Python ranking. The preferred candidate
// deliberately has the larger ID so an accidental ID sort fails this test.
//
// RUN: pto-test-opt %s '-pto-insert-template-attributes=daemon-socket-path=unused tile-lib-pkg-path=%S/Inputs daemon-helper-module=ordered_candidate_metadata_helper' | FileCheck %s
// RUN: pto-test-opt %s '-pto-insert-template-attributes=daemon-socket-path=unused tile-lib-pkg-path=%S/Inputs daemon-helper-module=ordered_candidate_metadata_helper' '-pto-expand-tile-op=daemon-socket-path=unused tile-lib-pkg-path=%S/Inputs daemon-helper-module=ordered_candidate_metadata_helper' | FileCheck %s --check-prefix=EXPAND --implicit-check-not=pto.tadd

// CHECK: pto.tadd
// CHECK-SAME: candidates = [{
// CHECK-SAME: id = 99 : i64
// CHECK-SAME: loop_depth = 1 : i64
// CHECK-SAME: name = "preferred_1d"
// CHECK-SAME: postupdate = 0 : i64
// CHECK-SAME: tail = 1 : i64
// CHECK-SAME: }, {
// CHECK-SAME: id = 0 : i64
// CHECK-SAME: loop_depth = 2 : i64
// CHECK-SAME: name = "fallback_2d"

// EXPAND: func.func @candidate_order
// EXPAND: call @{{.*}}__preferred_1d
// EXPAND: func.func private @{{.*}}__preferred_1d

module attributes {pto.target_arch = "a5"} {
  func.func @candidate_order() {
    %src0 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64,
                      v_row=8, v_col=64, blayout=row_major,
                      slayout=none_box, fractal=512, pad=0>
    %src1 = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64,
                      v_row=8, v_col=64, blayout=row_major,
                      slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64,
                      v_row=8, v_col=64, blayout=row_major,
                      slayout=none_box, fractal=512, pad=0>

    pto.tadd ins(
      %src0, %src1
        : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64,
                        v_row=8, v_col=64, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>,
          !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64,
                        v_row=8, v_col=64, blayout=row_major,
                        slayout=none_box, fractal=512, pad=0>)
      outs(
        %dst
          : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=64,
                          v_row=8, v_col=64, blayout=row_major,
                          slayout=none_box, fractal=512, pad=0>)
    return
  }
}
