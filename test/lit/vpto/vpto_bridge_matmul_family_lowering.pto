// Phase 3 second interface family: CUBE-side MATMUL. The tile type
// information is spread over the three (four for the accumulate form)
// operand tile types; the declarative bridge pass collects it from the
// whitelist abi operand/role bindings into the per-function specialization
// and the wrapper generation pass renders the cube-guarded TMATMUL/
// TMATMUL_ACC entries. The accumulation phase attribute flows into the
// template argument list; the phase is module-shared (merged like every
// other spec field), so both entries render with the merged phase.

// RUN: pto-test-opt %s "-pto-lower-declarative-bridge-ops=whitelist-path=%S/Inputs/vpto-bridge-whitelist-matmul.yaml" | FileCheck %s --check-prefix=SPEC
// RUN: pto-test-opt %s "-pto-lower-declarative-bridge-ops=whitelist-path=%S/Inputs/vpto-bridge-whitelist-matmul.yaml" -pto-emit-vpto-bridge-wrapper | FileCheck %s --check-prefix=WRAP

// SPEC-LABEL: func.func private @matmul_bridge_cube
// SPEC-SAME: pto.vpto.bridge.func_spec = {
// SPEC-SAME: entry.matmul = "pto_vpto_matmul"
// SPEC-SAME: left_tile = "pto::Tile<pto::TileType::Left, half, 16, 16, pto::BLayout::ColMajor, 16, 16, pto::SLayout::RowMajor, 512>"
// SPEC-SAME: result_tile = "pto::Tile<pto::TileType::Acc, float, 16, 16, pto::BLayout::ColMajor, 16, 16, pto::SLayout::RowMajor, 1024>"
// SPEC-SAME: right_tile = "pto::Tile<pto::TileType::Right, half, 16, 16, pto::BLayout::RowMajor, 16, 16, pto::SLayout::ColMajor, 512>"
// SPEC: pto.bridge_call "pto_vpto_matmul"
// SPEC-SAME: : i64, i64, i64
// SPEC-NOT: pto.alloc_tile
// SPEC-NOT: pto.tmatmul

// SPEC-LABEL: func.func private @matmul_acc_bridge_cube
// SPEC-SAME: pto.vpto.bridge.func_spec = {
// SPEC-SAME: acc_in_tile = "pto::Tile<pto::TileType::Acc, float, 16, 16, pto::BLayout::ColMajor, 16, 16, pto::SLayout::RowMajor, 1024>"
// SPEC-SAME: acc_phase = "pto::AccPhase::Final"
// SPEC-SAME: entry.matmul_acc = "pto_vpto_matmul_acc"
// SPEC: pto.bridge_call "pto_vpto_matmul_acc"
// SPEC-SAME: : i64, i64, i64, i64
// SPEC-NOT: pto.tmatmul.acc

// WRAP: module attributes {{{.*}}pto.vpto.bridge.wrapper_source = "
// WRAP-SAME: #include <pto/npu/a5/TMatmul.hpp>
// WRAP-SAME: using AccInTile = pto::Tile<pto::TileType::Acc, float, 16, 16, pto::BLayout::ColMajor, 16, 16, pto::SLayout::RowMajor, 1024>;
// WRAP-SAME: using LeftTile = pto::Tile<pto::TileType::Left, half, 16, 16, pto::BLayout::ColMajor, 16, 16, pto::SLayout::RowMajor, 512>;
// WRAP-SAME: using ResultTile = pto::Tile<pto::TileType::Acc, float, 16, 16, pto::BLayout::ColMajor, 16, 16, pto::SLayout::RowMajor, 1024>;
// WRAP-SAME: using RightTile = pto::Tile<pto::TileType::Right, half, 16, 16, pto::BLayout::RowMajor, 16, 16, pto::SLayout::ColMajor, 512>;
// WRAP-SAME: #ifdef __DAV_CUBE__
// WRAP-SAME: pto_vpto_matmul(uint64_t dstAddress, uint64_t lhsAddress, uint64_t rhsAddress)
// WRAP-SAME: pto::TMATMUL<pto::AccPhase::Final>(dst, lhs, rhs);
// WRAP-SAME: pto_vpto_matmul_acc(uint64_t dstAddress, uint64_t accInAddress, uint64_t lhsAddress, uint64_t rhsAddress)
// WRAP-SAME: pto::TMATMUL_ACC<pto::AccPhase::Final>(dst, accIn, lhs, rhs);
// WRAP-SAME: #endif
// WRAP-NOT: pto.vpto.bridge.func_spec

module attributes {pto.target_arch = "a5"} {
  func.func private @matmul_bridge_cube(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c0 = arith.constant 0 : i64
    %c1024 = arith.constant 1024 : i64
    %c2048 = arith.constant 2048 : i64
    %lhs = pto.alloc_tile addr = %c0
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %rhs = pto.alloc_tile addr = %c1024
      : !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %acc = pto.alloc_tile addr = %c2048
      : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    pto.tmatmul ins(%lhs, %rhs
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>,
        !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      outs(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                                blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
    return
  }

  func.func private @matmul_acc_bridge_cube(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c0 = arith.constant 0 : i64
    %c1024 = arith.constant 1024 : i64
    %c2048 = arith.constant 2048 : i64
    %c4096 = arith.constant 4096 : i64
    %acc_in = pto.alloc_tile addr = %c0
      : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    %lhs = pto.alloc_tile addr = %c1024
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %rhs = pto.alloc_tile addr = %c2048
      : !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %acc = pto.alloc_tile addr = %c4096
      : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    pto.tmatmul.acc
      ins(%acc_in, %lhs, %rhs
      : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=1024, pad=0>,
        !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>,
        !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      outs(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                                blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
      {accPhase = #pto<acc_phase final>}
    return
  }
}
