// RUN: pto-test-opt %s -verify-diagnostics

module {
  func.func @vtranspose_mismatched_types(
      %dst: !pto.ptr<i16, ub>, %src: !pto.ptr<ui16, ub>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    // expected-error @+1 {{'pto.vtranspose' op requires destination and source element types to match}}
    pto.vtranspose %dst, %src : !pto.ptr<i16, ub>, !pto.ptr<ui16, ub>
    return
  }
}
