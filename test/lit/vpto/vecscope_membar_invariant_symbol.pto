// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar %s -o - 2>/dev/null | FileCheck %s

// `(x & 1) * 256` is one invariant symbol. Both stores of a carried pair use
// it at the same coefficient, and the address stays inside the i32 range, so
// overlap is decided on `iv * 256` alone. A 256-byte vsts at that stride does
// not overlap. A shorter stride still does, and the barrier stays.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @invariant_symbol_disjoint(%x: i32) {
    %c0 = arith.constant 0 : index
    %c4 = arith.constant 4 : index
    %c1 = arith.constant 1 : index
    %c0_i64 = arith.constant 0 : i64
    %c0_i8 = arith.constant 0 : i8
    %c1_i32 = arith.constant 1 : i32
    %c256_i32 = arith.constant 256 : i32
    %ub = pto.castptr %c0_i64 : i64 -> !pto.ptr<si8, ub>
    %masked = arith.andi %x, %c1_i32 : i32
    %base = arith.muli %masked, %c256_i32 : i32
    pto.vecscope {
      %mask = pto.pset_b8 "PAT_ALL" : !pto.mask<b8>
      %seed = builtin.unrealized_conversion_cast %c0_i8 : i8 to si8
      %zero = pto.vdup %seed, %mask : si8, !pto.mask<b8> -> !pto.vreg<256xsi8>
      scf.for %iv = %c0 to %c4 step %c1 {
        %iv_i32 = arith.index_cast %iv : index to i32
        %step = arith.muli %iv_i32, %c256_i32 : i32
        %sum = arith.addi %base, %step : i32
        %off = arith.index_cast %sum : i32 to index
        %ptr = pto.addptr %ub, %off : <si8, ub> -> <si8, ub>
        pto.vsts %zero, %ptr[%c0], %mask : !pto.vreg<256xsi8>, !pto.ptr<si8, ub>, !pto.mask<b8>
      }
    }
    return
  }

  func.func @invariant_symbol_overlap(%x: i32) {
    %c0 = arith.constant 0 : index
    %c4 = arith.constant 4 : index
    %c1 = arith.constant 1 : index
    %c0_i64 = arith.constant 0 : i64
    %c0_i8 = arith.constant 0 : i8
    %c1_i32 = arith.constant 1 : i32
    %c128_i32 = arith.constant 128 : i32
    %c256_i32 = arith.constant 256 : i32
    %ub = pto.castptr %c0_i64 : i64 -> !pto.ptr<si8, ub>
    %masked = arith.andi %x, %c1_i32 : i32
    %base = arith.muli %masked, %c256_i32 : i32
    pto.vecscope {
      %mask = pto.pset_b8 "PAT_ALL" : !pto.mask<b8>
      %seed = builtin.unrealized_conversion_cast %c0_i8 : i8 to si8
      %zero = pto.vdup %seed, %mask : si8, !pto.mask<b8> -> !pto.vreg<256xsi8>
      scf.for %iv = %c0 to %c4 step %c1 {
        %iv_i32 = arith.index_cast %iv : index to i32
        %step = arith.muli %iv_i32, %c128_i32 : i32
        %sum = arith.addi %base, %step : i32
        %off = arith.index_cast %sum : i32 to index
        %ptr = pto.addptr %ub, %off : <si8, ub> -> <si8, ub>
        pto.vsts %zero, %ptr[%c0], %mask : !pto.vreg<256xsi8>, !pto.ptr<si8, ub>, !pto.mask<b8>
      }
    }
    return
  }
}

// CHECK-LABEL: func.func @invariant_symbol_disjoint
// CHECK: pto.vecscope
// CHECK: scf.for
// CHECK: pto.vsts
// CHECK-NOT: mem_bar
// CHECK-LABEL: func.func @invariant_symbol_overlap
// CHECK: pto.vecscope
// CHECK: scf.for
// CHECK: pto.vsts
// CHECK: pto.mem_bar "VST_VST"
