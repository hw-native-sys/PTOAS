// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - 2>&1 | FileCheck %s

// The VPTO backend carries the scheduling mode into HIVM annotations, so it
// enforces the same {0, 1} contract as the EmitC backend.

module attributes {
  pto.kernel_kind = #pto.kernel_kind<vector>,
  pto.target_arch = "a5"
} {
  func.func @kernel() attributes {pto.entry, pto.sched_mode = 3 : i32} {
    %ctrl = pto.get_ctrl : i64
    pto.set_ctrl %ctrl : i64
    return
  }
}

// CHECK: `pto.sched_mode` must be 0 (normal mode) or 1 (batch mode), got 3
