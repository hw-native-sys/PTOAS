// A5 UB->OUT packs loop strides as src << 40 | dst, the opposite of OUT->UB,
// so expansion must hand (dst, src) to the config op.
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --mlir-print-ir-before=vpto-expand-wrapper-ops %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=WRAPPER
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --mlir-print-ir-after=vpto-expand-wrapper-ops %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=EXPAND-LOOP1
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --mlir-print-ir-after=vpto-expand-wrapper-ops %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=EXPAND-LOOP2

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @mte_ub_gm_one_loop(%out: !pto.ptr<f16, gm>) attributes {pto.aicore} {
    %c0_i64 = arith.constant 0 : i64
    %c2_i64 = arith.constant 2 : i64
    %c50_i64 = arith.constant 50 : i64
    %c64_i64 = arith.constant 64 : i64
    %c1472_i64 = arith.constant 1472 : i64
    %c6400_i64 = arith.constant 6400 : i64
    %ub = pto.castptr %c0_i64 : i64 -> !pto.ptr<f16, ub>

    pto.mte_ub_gm %ub, %out, %c64_i64
      nburst(%c2_i64, %c64_i64, %c50_i64)
      loop(%c2_i64, %c1472_i64, %c6400_i64)
      : !pto.ptr<f16, ub>, !pto.ptr<f16, gm>, i64, i64, i64, i64, loop i64, i64, i64
    return
  }

  func.func @mte_ub_gm_two_loops(%out: !pto.ptr<f16, gm>) attributes {pto.aicore} {
    %c0_i64 = arith.constant 0 : i64
    %c2_i64 = arith.constant 2 : i64
    %c3_i64 = arith.constant 3 : i64
    %c50_i64 = arith.constant 50 : i64
    %c64_i64 = arith.constant 64 : i64
    %c1472_i64 = arith.constant 1472 : i64
    %c1600_i64 = arith.constant 1600 : i64
    %c4416_i64 = arith.constant 4416 : i64
    %c6400_i64 = arith.constant 6400 : i64
    %ub = pto.castptr %c0_i64 : i64 -> !pto.ptr<f16, ub>

    pto.mte_ub_gm %ub, %out, %c64_i64
      nburst(%c2_i64, %c64_i64, %c50_i64)
      loop(%c3_i64, %c1472_i64, %c1600_i64)
      loop(%c2_i64, %c4416_i64, %c6400_i64)
      : !pto.ptr<f16, ub>, !pto.ptr<f16, gm>, i64, i64, i64, i64,
        loop i64, i64, i64, loop i64, i64, i64
    return
  }
}

// Wrapper keeps (count, src_stride, dst_stride).
// WRAPPER-LABEL: func.func @mte_ub_gm_one_loop(
// WRAPPER: pto.mte_ub_gm {{.*}} nburst(%{{[^,]+}}, %{{[^,]+}}, %{{[^)]+}}) loop(%{{[^,]+}}, %[[SRC:.*]], %[[DST:.*]])
// WRAPPER-DAG: %[[SRC]] = arith.constant 1472 : i64
// WRAPPER-DAG: %[[DST]] = arith.constant 6400 : i64

// Config op receives (dst, src).
// EXPAND-LOOP1-LABEL: func.func @mte_ub_gm_one_loop(
// EXPAND-LOOP1-DAG: %[[DST:.*]] = arith.constant 6400 : i64
// EXPAND-LOOP1-DAG: %[[SRC:.*]] = arith.constant 1472 : i64
// EXPAND-LOOP1: pto.set_loop1_stride_ubtoout %[[DST]], %[[SRC]] : i64, i64
// EXPAND-LOOP1: pto.copy_ubuf_to_gm

// Two loops: wrapper entry 0 is loop2 (outer), entry 1 is loop1 (inner).
// EXPAND-LOOP2-LABEL: func.func @mte_ub_gm_two_loops(
// EXPAND-LOOP2-DAG: %[[OUTER_DST:.*]] = arith.constant 1600 : i64
// EXPAND-LOOP2-DAG: %[[OUTER_SRC:.*]] = arith.constant 1472 : i64
// EXPAND-LOOP2-DAG: %[[INNER_DST:.*]] = arith.constant 6400 : i64
// EXPAND-LOOP2-DAG: %[[INNER_SRC:.*]] = arith.constant 4416 : i64
// EXPAND-LOOP2: pto.set_loop2_stride_ubtoout %[[OUTER_DST]], %[[OUTER_SRC]] : i64, i64
// EXPAND-LOOP2: pto.set_loop1_stride_ubtoout %[[INNER_DST]], %[[INNER_SRC]] : i64, i64
// EXPAND-LOOP2: pto.copy_ubuf_to_gm
