// MIN_UI32-LABEL: func.func @vcmin_ui32_broadcast_loop(
// MIN_UI32: pto.vecscope {
// MIN_UI32: %[[BCAST:.*]] = pto.vdup
// MIN_UI32: %[[LOOP:.*]] = scf.for
// MIN_UI32-SAME: iter_args({{.*}} = %[[BCAST]]) -> (!pto.vreg<64xui32>)
// MIN_UI32-NEXT: scf.yield %[[BCAST]] : !pto.vreg<64xui32>
// MIN_UI32: pto.vsts %[[LOOP]],
// MIN_UI32: return

  func.func @dependent_broadcast_loop(%src: !pto.ptr<si32, ub>, %dst: !pto.ptr<si32, ub>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %x = pto.vmi.vload %src[%c0] : !pto.ptr<si32, ub>, index -> !pto.vmi.vreg<64xsi32>
    %m = pto.vmi.create_mask %c64 : index -> !pto.vmi.mask<64xpred>
    %r = pto.vmi.vcadd %x, %m {group = 1 : i64, pmode = "zero"} : !pto.vmi.vreg<64xsi32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<1xsi32>
    %b = pto.vmi.vbrc %r : !pto.vmi.vreg<1xsi32> -> !pto.vmi.vreg<64xsi32>
    %out = scf.for %i = %c0 to %c2 step %c1 iter_args(%acc = %b) -> (!pto.vmi.vreg<64xsi32>) {
      %r2 = pto.vmi.vcadd %acc, %m {group = 1 : i64, pmode = "zero"} : !pto.vmi.vreg<64xsi32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<1xsi32>
      %b2 = pto.vmi.vbrc %r2 : !pto.vmi.vreg<1xsi32> -> !pto.vmi.vreg<64xsi32>
      scf.yield %b2 : !pto.vmi.vreg<64xsi32>
    }
    pto.vmi.vstore %out, %dst[%c0] : !pto.vmi.vreg<64xsi32>, !pto.ptr<si32, ub>, index
    return
  }

// DEPENDENT-LABEL: func.func @dependent_broadcast_loop(
// DEPENDENT: pto.vecscope {
// DEPENDENT: pto.vdup
// DEPENDENT: %[[LOOP:.*]] = scf.for
// DEPENDENT: pto.vdup
// DEPENDENT: scf.yield
// DEPENDENT: pto.vsts %[[LOOP]],
// DEPENDENT: return
}
