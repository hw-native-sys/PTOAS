      %r2 = pto.vmi.vcmin %x, %m {group = 1 : i64, pmode = "zero"} : !pto.vmi.vreg<64xsi32>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<1xsi32>
      %b2 = pto.vmi.vbrc %r2 : !pto.vmi.vreg<1xsi32> -> !pto.vmi.vreg<64xsi32>
