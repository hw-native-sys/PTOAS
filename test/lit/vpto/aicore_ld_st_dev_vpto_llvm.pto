// RUN: ( ptoas --cann-output-version=9.0.0 --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 || true ) | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @aicore_ld_st_dev(
      %gm_i8: !pto.ptr<i8, gm>,
      %gm_i16: !pto.ptr<i16, gm>,
      %gm_i32: !pto.ptr<i32, gm>,
      %gm_i64: !pto.ptr<i64, gm>,
      %dynamic_offset: index) attributes {pto.aicore} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index

    %v8 = pto.ld_dev %gm_i8[%c0] : !pto.ptr<i8, gm> -> i8
    %v16 = pto.ld_dev %gm_i16[%c1] : !pto.ptr<i16, gm> -> i16
    %v32 = pto.ld_dev %gm_i32[%dynamic_offset] : !pto.ptr<i32, gm> -> i32
    %v64 = pto.ld_dev %gm_i64[%c0] : !pto.ptr<i64, gm> -> i64

    pto.st_dev %v8, %gm_i8[%c1] : !pto.ptr<i8, gm>, i8
    pto.st_dev %v16, %gm_i16[%dynamic_offset] : !pto.ptr<i16, gm>, i16
    pto.st_dev %v32, %gm_i32[%c0] : !pto.ptr<i32, gm>, i32
    pto.st_dev %v64, %gm_i64[%c1] : !pto.ptr<i64, gm>, i64
    return
  }
}

// CHECK: error: InsertTemplateAttributes encountered an unsupported operand type '!pto.ptr<i8, gm>'
// CHECK: Pass execution failed.
