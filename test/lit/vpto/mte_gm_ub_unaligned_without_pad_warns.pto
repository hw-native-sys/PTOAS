// A constant len_burst that is not a multiple of 32 leaves a 32B tail block in UB\n// that carries source data. The op stays valid and warns so the author can pass\n// pad(...) when the tail must be deterministic.
// RUN: pto-test-opt %s 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  // CHECK: warning: pto.mte_gm_ub len_burst (8 bytes) is not a multiple of 32
  func.func @mte_gm_ub_unaligned_no_pad_f32(%arg0: !pto.ptr<f32, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c8 = arith.constant 8 : i64
    %ub = pto.castptr %c0 : i64 -> !pto.ptr<f32, ub>
    pto.mte_gm_ub %arg0, %ub, %c0, %c8
      nburst(%c1, %c8, %c8)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64
    return
  }
}
