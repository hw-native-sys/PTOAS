// RUN: not pto-test-opt %s -split-input-file 2>&1 | FileCheck %s

module {
  func.func @bf16x2_vreg_and_bitcast(
      %packed: !pto.vreg<64x!pto.bf16x2>) -> !pto.vreg<64x!pto.bf16x2> {
    %bf16 = pto.vbitcast %packed
        : !pto.vreg<64x!pto.bf16x2> -> !pto.vreg<128xbf16>
    %roundtrip = pto.vbitcast %bf16
        : !pto.vreg<128xbf16> -> !pto.vreg<64x!pto.bf16x2>
    return %roundtrip : !pto.vreg<64x!pto.bf16x2>
  }
}

// -----

module {
  func.func @bf16x2_vreg_oversized(
      %packed: !pto.vreg<128x!pto.bf16x2>) {
    return
  }
}

// CHECK: expected exactly 256 bytes
