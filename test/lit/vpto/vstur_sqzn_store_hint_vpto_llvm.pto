// VSQZ #st is the bridge that pushes SQZN to a VSTUR. #st=1 is emitted only
// when the VSQZ result reaches a VSTUR value, directly or through pto.vbitcast;
// a VSQZ used by any other consumer stays #st=0 and drops its SQZN. These are
// the exact immediates the verifier's value-chain rule relies on.
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vstur_direct_sqz(%value: !pto.vreg<64xf32>, %mask: !pto.mask<b32>,
                              %dst: !pto.ptr<f32, ub>) attributes {pto.kernel} {
    pto.vecscope {
      %sqz = pto.vsqz %value, %mask : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %align = pto.init_align : !pto.align
      %next = pto.vstur %align, %sqz, %dst, "NO_POST_UPDATE"
          : !pto.align, !pto.vreg<64xf32>, !pto.ptr<f32, ub> -> !pto.align
      pto.vstar %next, %dst : !pto.align, !pto.ptr<f32, ub>
    }
    return
  }

  func.func @vstur_via_bitcast(%value: !pto.vreg<64xf32>, %mask: !pto.mask<b32>,
                               %dst: !pto.ptr<i32, ub>) attributes {pto.kernel} {
    pto.vecscope {
      %sqz = pto.vsqz %value, %mask : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %bits = pto.vbitcast %sqz : !pto.vreg<64xf32> -> !pto.vreg<64xi32>
      %align = pto.init_align : !pto.align
      %next = pto.vstur %align, %bits, %dst, "NO_POST_UPDATE"
          : !pto.align, !pto.vreg<64xi32>, !pto.ptr<i32, ub> -> !pto.align
      pto.vstar %next, %dst : !pto.align, !pto.ptr<i32, ub>
    }
    return
  }

  func.func @vsqz_feeds_vsts(%value: !pto.vreg<64xf32>, %mask: !pto.mask<b32>,
                             %dst: !pto.ptr<f32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %sqz = pto.vsqz %value, %mask : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %sqz, %dst[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }
    return
  }
}

// CHECK-LABEL: define void @vstur_direct_sqz_mix_aiv
// CHECK: call <64 x float> @llvm.hivm.vsqz.x.v64f32({{.*}}, i32 1)
// CHECK: call <32 x i8> @llvm.hivm.vstur.v64f32

// CHECK-LABEL: define void @vstur_via_bitcast_mix_aiv
// CHECK: call <64 x float> @llvm.hivm.vsqz.x.v64f32({{.*}}, i32 1)
// CHECK: call <32 x i8> @llvm.hivm.vstur.v64i32

// CHECK-LABEL: define void @vsqz_feeds_vsts_mix_aiv
// CHECK: call <64 x float> @llvm.hivm.vsqz.x.v64f32({{.*}}, i32 0)
// CHECK: call void @llvm.hivm.vstsx1.v64f32
