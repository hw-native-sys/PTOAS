// A dominating VSQZ is not enough: this one feeds a plain pto.vsts and emits
// with #st=0, so its SQZN is dropped. The VSTUR value is still the function
// argument, so the store has no defined length.
//
// RUN: not pto-test-opt %s 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vstur_with_stray_vsqz(%value: !pto.vreg<64xf32>,
                                   %mask: !pto.mask<b32>,
                                   %dst: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %sqz = pto.vsqz %value, %mask
          : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %sqz, %dst[%c0], %mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      %align = pto.init_align : !pto.align
      %next = pto.vstur %align, %value, %dst, "NO_POST_UPDATE"
          : !pto.align, !pto.vreg<64xf32>, !pto.ptr<f32, ub> -> !pto.align
      pto.vstar %next, %dst : !pto.align, !pto.ptr<f32, ub>
    }
    return
  }
}

// CHECK: error: 'pto.vstur' op requires its value to be produced by a pto.vsqz (directly or through pto.vbitcast)
// CHECK-SAME: VSTUR's store length comes from SPR SQZN
