// RUN: not pto-test-opt %s -vpto-normalize-container -mlir-disable-threading 2>&1 | FileCheck %s

// Regression test for issue #1515.
//
// A module that carries 'pto.kernel_kind' and already holds a child module is
// neither a kernel body nor a container: it is a half-normalized mixture. The
// pass must reject it instead of wrapping the existing child into a second
// container level, which the top-level-only container verifier cannot see.

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  module @inner_kernel {
    func.func @foo() {
      return
    }
  }
}

// CHECK: error: a module carrying 'pto.kernel_kind' must not already contain child modules
// CHECK-SAME: expected either a kernel module with function bodies or a container of kernel submodules
