// Verify that ExpandTileOp rewrites pto.simt_launch callees when cloning
// daemon-generated template functions that contain SIMT launches.
//
// RUN: SOCK=$(mktemp -u /tmp/sock_XXXXXX)
// RUN: (python3 %S/Inputs/mock_simt_rename_daemon.py $SOCK &)
// RUN: sleep 1
// RUN: pto-test-opt \
// RUN:   --pto-expand-tile-op="daemon-socket-path=$SOCK" \
// RUN:   --mlir-print-ir-after=pto-expand-tile-op %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s
// RUN: kill %1 2>/dev/null || true
// RUN: rm -f $SOCK

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @test_simt_rename() {
    %a = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %b = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tadd
      ins(%a, %b : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
                 !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      {candidates = [{id = 0 : i64, loop_depth = 2 : i64, name = "template_tadd", postupdate = 0 : i64, tail = 0 : i64}]}
    return
  }
}

// The entry function cloned from @template_entry should contain a simt_launch
// whose callee has been rewritten to the uniquified helper name.
// CHECK: func.func private @__pto_tilelang_a5_tadd_{{.*}}__template_tadd
// CHECK:   pto.simt_launch @__pto_tilelang_a5_tadd_{{.*}}__template_tadd__simt_body

// The helper function cloned from @simt_body should also be present with the
// uniquified name.
// CHECK: func.func private @__pto_tilelang_a5_tadd_{{.*}}__template_tadd__simt_body

// The original unrenamed callee must not appear anywhere.
// CHECK-NOT: pto.simt_launch @simt_body
