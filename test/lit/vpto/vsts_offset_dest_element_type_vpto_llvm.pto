// RUN: ( mkdir -p %T && ptoas --pto-arch=a5 --pto-backend=vpto %s -o %t --mlir-print-ir-after=convert-func-to-llvm 2>&1 || true ) | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vsts_offset_uses_dest_elem_type(%value: !pto.vreg<64xf32>, %dst: !pto.ptr<i16, ub>, %off: index) attributes {pto.kernel} {
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      pto.vsts %value, %dst[%off], %mask {dist = "NORM_B32"} : !pto.vreg<64xf32>, !pto.ptr<i16, ub>, !pto.mask<b32>
    }
    return
  }
}

// CHECK-LABEL: llvm.func @vsts_offset_uses_dest_elem_type
// CHECK: %[[SCALE:.*]] = llvm.mlir.constant(2 : i64)
// CHECK: %[[BYTE_OFFSET:.*]] = llvm.mul {{.*}}, %[[SCALE]] : i64
// CHECK: %[[ADDRESS:.*]] = llvm.getelementptr {{.*}}[%[[BYTE_OFFSET]]]
// CHECK: %[[ZERO:.*]] = llvm.mlir.constant(0 : i32)
// CHECK: llvm.call @llvm.hivm.vstsx1.v64f32({{.*}}, %[[ADDRESS]], %[[ZERO]],
