// RUN: ptoas --cann-output-version=9.0.0 --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @single_kind_section_loop(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>)
      attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    pto.section.vector {
      scf.for %i = %c0 to %c1 step %c1 {
        %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
        %vec = pto.vlds %src[%i] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
        pto.vsts %vec, %dst[%i], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
      }
    }
    return
  }
}

// CHECK-LABEL: define void @single_kind_section_loop_mix_aiv
// CHECK-NOT: pto.section.vector
// CHECK: call <256 x i1> @llvm.hivm.pset.b32
// CHECK: call <64 x float> @llvm.hivm.vldsx1.v64f32
// CHECK: call void @llvm.hivm.vstsx1.v64f32
