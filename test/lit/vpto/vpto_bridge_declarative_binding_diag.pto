// Declarative binding diagnostics: the whitelist-driven channel validates
// every abi binding against the routed op. Four scenarios are covered: an
// out-of-range operand index, a non-tile_buf operand, a result-bearing op
// routed to the buffer-form channel, and a non-enum attribute feeding an
// attr tmpl_map row.
//
// Each scenario needs its own module (-split-input-file), not just its own
// function in a shared module. The declarative pass is a FuncOp nested
// pass, and MLIR's async pass adaptor breaks a worker out of its chunk on
// the first failing function -- so with all four in one module the number
// of diagnostics that surface varied run to run (1 to 4 observed under
// load). Splitting gives each scenario an independent pass-manager run, so
// all four are emitted deterministically.

// RUN: not pto-test-opt %s -split-input-file "-pto-lower-declarative-bridge-ops=whitelist-path=%S/Inputs/vpto-bridge-whitelist-declarative-binding-diag.yaml" 2>&1 | FileCheck %s

// CHECK: error: VPTO declarative bridge: whitelist entry 'pto_vpto_matmul_oob' binds operand #7 but the op has only 3 operands
// CHECK: error: VPTO declarative bridge: operand #1 ('pipe_handle', role pipe_slot) must be a tile_buf
// CHECK: error: VPTO declarative bridge supports the buffer form without a tensor result
// CHECK: error: VPTO declarative bridge: attribute 'some_flag' must be a PTO enum attribute to feed a template slot

module attributes {pto.target_arch = "a5"} {
  func.func private @declarative_operand_out_of_range(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c0 = arith.constant 0 : i64
    %c1024 = arith.constant 1024 : i64
    %c2048 = arith.constant 2048 : i64
    %lhs = pto.alloc_tile addr = %c0
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %rhs = pto.alloc_tile addr = %c1024
      : !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %acc = pto.alloc_tile addr = %c2048
      : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    pto.tmatmul ins(%lhs, %rhs
      : !pto.tile_buf<loc=left, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>,
        !pto.tile_buf<loc=right, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      outs(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                                blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
    return
  }
}

// -----

module attributes {pto.target_arch = "a5"} {
  func.func private @declarative_non_tile_operand(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c0 = arith.constant 0 : i64
    %acc = pto.alloc_tile addr = %c0
      : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    %pipe = pto.initialize_l2l_pipe{dir_mask = 1, slot_size = 1024, slot_num = 8, flag_base = 0, nosplit = false} (%addr : i32) -> !pto.pipe
    pto.tpush(%acc, %pipe
      : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=1024, pad=0>,
        !pto.pipe) {split = 1}
    return
  }
}

// -----

module attributes {pto.target_arch = "a5"} {
  func.func private @declarative_result_op(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %tile = pto.declare_tile
      -> !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                       blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %ub = pto.tile_buf_addr %tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=16, v_row=8, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
     -> !pto.ptr<f32, ub>
    return
  }
}

// -----

module attributes {pto.target_arch = "a5"} {
  func.func private @declarative_non_enum_attr(%addr: i32)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c0 = arith.constant 0 : i64
    %c1024 = arith.constant 1024 : i64
    %c2048 = arith.constant 2048 : i64
    %c4096 = arith.constant 4096 : i64
    %lhs = pto.alloc_tile addr = %c0
      : !pto.tile_buf<loc=left, dtype=f8E4M3FN, rows=16, cols=512, v_row=16, v_col=512,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>
    %rhs = pto.alloc_tile addr = %c1024
      : !pto.tile_buf<loc=right, dtype=f8E4M3FN, rows=512, cols=16, v_row=512, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>
    %bias = pto.alloc_tile addr = %c2048
      : !pto.tile_buf<loc=bias, dtype=f32, rows=1, cols=16, v_row=1, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %acc = pto.alloc_tile addr = %c4096
      : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=1024, pad=0>
    pto.tmatmul.bias ins(%lhs, %rhs, %bias
      : !pto.tile_buf<loc=left, dtype=f8E4M3FN, rows=16, cols=512, v_row=16, v_col=512,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>,
        !pto.tile_buf<loc=right, dtype=f8E4M3FN, rows=512, cols=16, v_row=512, v_col=16,
                      blayout=row_major, slayout=col_major, fractal=512, pad=0>,
        !pto.tile_buf<loc=bias, dtype=f32, rows=1, cols=16, v_row=1, v_col=16,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%acc : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16,
                                blayout=col_major, slayout=row_major, fractal=1024, pad=0>)
      {some_flag = 5 : i32}
    return
  }
}
