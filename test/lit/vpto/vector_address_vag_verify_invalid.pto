// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto %s -o %t --mlir-print-ir-after=convert-func-to-llvm 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vag_requires_loop() attributes {pto.kernel} {
    %c4_i32 = arith.constant 4 : i32
    pto.vecscope {
      %addr = pto.vag %c4_i32 : i32 -> !pto.vaddr<b32>
    }
    return
  }
}

// CHECK: must be nested under scf.for
