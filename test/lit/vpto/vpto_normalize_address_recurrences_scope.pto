// RUN: pto-test-opt %s -vpto-normalize-address-recurrences | FileCheck %s --check-prefix=NORM
// RUN: pto-test-opt %s -vpto-normalize-address-recurrences -vpto-soft-postupdate | FileCheck %s --check-prefix=POST

// NORM-LABEL: func.func @inside_vecscope
// NORM: arith.index_cast %{{.*}} : i16 to index
// NORM: pto.vlds %{{.*}}[{{%.*}}]
// POST-LABEL: func.func @inside_vecscope
// POST: pto.vlds {{.*}} -> !pto.vreg<256xui8>, !pto.ptr<ui8, ub>

// The independent normalizer also processes candidates outside vecscope. Soft
// post-update keeps its own vecscope boundary, so this op remains ordinary but
// permanently uses the narrowed i16 IV without adding an iter_arg.
// NORM-LABEL: func.func @outside_vecscope
// NORM: scf.for %{{.*}} = %{{.*}} to %{{.*}} step %{{.*}} : i16 {
// NORM: arith.index_cast %{{.*}} : i16 to index
// NORM: pto.vlds %{{.*}}[{{%.*}}] : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
// POST-LABEL: func.func @outside_vecscope
// POST: scf.for %{{.*}} = %{{.*}} to %{{.*}} step %{{.*}} : i16 {
// POST: arith.index_cast %{{.*}} : i16 to index
// POST: pto.vlds %{{.*}}[{{%.*}}] : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @inside_vecscope(%base: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    pto.vecscope {
      scf.for %iv = %c0 to %c4 step %c1 {
        %value = pto.vlds %base[%iv]
            : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
      }
    }
    return
  }

  func.func @outside_vecscope(%base: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    scf.for %iv = %c0 to %c4 step %c1 {
      %value = pto.vlds %base[%iv]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
    }
    return
  }
}
