// A guard whose bound equals the loop bound is tautological: with the loop
// induction variable's range known, `iv < 1024` is always true inside a
// `scf.for` that runs `[0, 1024)`. The range-driven phase must fold the guard
// away and hoist the body. This is the behaviour vpto_guarded_licm_pipeline.pto
// used to exercise incidentally before its bounds were decoupled; keep it
// asserted explicitly here.
//
// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --emit-vpto %s -o - | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @tautological_guard(%dst: !pto.ptr<i32, ub>, %laneid: i32) attributes {pto.entry} {
    pto.section.simt<<<32, 1, 1>>> {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c1024 = arith.constant 1024 : index
      scf.for %iv = %c0 to %c1024 step %c1 {
        %in_bounds = arith.cmpi slt, %iv, %c1024 : index
        scf.if %in_bounds {
          pto.store %laneid, %dst[%iv] : !pto.ptr<i32, ub>, i32
        }
      }
    }
    return
  }
}

// CHECK-LABEL: func.func private @tautological_guard_simt_0
// The guard compare and the scf.if wrapper are both gone; the store is
// unconditional inside the loop.
// CHECK-NOT: arith.cmpi
// CHECK-NOT: scf.if
// CHECK: scf.for
// CHECK: pto.store
