// RUN: pto-test-opt %s -split-input-file -verify-diagnostics

module {
  func.func @mismatched_types(%input: !pto.vreg<64xf32>) {
    pto.vecscope {
      // expected-error@+1 {{requires input and result to have identical vector types}}
      %copy = pto.vmov %input : !pto.vreg<64xf32> -> !pto.vreg<64xi32>
    }
    return
  }
}

// -----

module {
  func.func @unsupported_unsigned_i64(%input: !pto.vreg<32xui64>) {
    pto.vecscope {
      // expected-error@+1 {{requires 8/16/32-bit integer or non-unsigned 64-bit integer vector element type}}
      %copy = pto.vmov %input : !pto.vreg<32xui64> -> !pto.vreg<32xui64>
    }
    return
  }
}
