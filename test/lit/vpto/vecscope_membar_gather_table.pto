    %cpptr = pto.castptr %cpaddr : i64 -> !pui8ub
    %cpm = pto.pset_b32 "PAT_VL1" : !mb32
    %cpv = pto.vlds %src[%c0] : !pui16ub, index -> !v64xui32
    pto.vsts %cpv, %cpptr[%c0], %cpm {dist = "1PT_B32"} : !v64xui32, !pui8ub, index, !mb32
  }
  pto.vecscope {
    %m2 = pto.pset_b16 "PAT_ALL" : !mb16
    %idx = pto.vlds %tab[%c0] : !pui16ub, index -> !v128xui16
    %a = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    pto.vsts %a, %dst[%c0], %m2 : !v128xui16, !pui16ub, index, !mb16
    %b = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    %keep = arith.constant 128 : index
    pto.vsts %b, %dst[%keep], %m2 : !v128xui16, !pui16ub, index, !mb16
  }
  return
}

// CHECK-LABEL: func.func @late_table_initializer(
// CHECK: %[[DST:.*]] = arith.constant 2048 : index
// CHECK: pto.vsts {{.*}}[%[[DST]]]
// CHECK-NEXT: pto.mem_bar "VST_VLD"
// CHECK-NEXT: {{.*}}pto.vgather2
// CHECK: return
  func.func @late_table_initializer(%data: !pto.vreg<128xui16>) {
    %zero = arith.constant 0 : index
    %dst = arith.constant 2048 : index
    %sink = arith.constant 4096 : index
    %base = arith.constant 0 : i64
    %table_addr = arith.constant 196608 : i64
    %start = arith.constant 0 : i16
    %p = pto.castptr %base : i64 -> !pto.ptr<ui16, ub>
    %table = pto.castptr %table_addr : i64 -> !pto.ptr<ui16, ub>
    pto.vecscope {
      %m = pto.pset_b16 "PAT_ALL" : !pto.mask<b16>
      %indices = pto.vlds %table[%zero] : !pto.ptr<ui16, ub>, index -> !pto.vreg<128xui16>
      pto.vsts %data, %p[%dst], %m : !pto.vreg<128xui16>, !pto.ptr<ui16, ub>, index, !pto.mask<b16>
      %read = pto.vgather2 %p, %indices, %m : !pto.ptr<ui16, ub>, !pto.vreg<128xui16>, !pto.mask<b16> -> !pto.vreg<128xui16>
      pto.vsts %read, %p[%sink], %m : !pto.vreg<128xui16>, !pto.ptr<ui16, ub>, index, !pto.mask<b16>
      %ramp = pto.vci %start : i16 -> !pto.vreg<128xi16>
      %new_indices = pto.vbitcast %ramp : !pto.vreg<128xi16> -> !pto.vreg<128xui16>
      pto.vsts %new_indices, %table[%zero], %m : !pto.vreg<128xui16>, !pto.ptr<ui16, ub>, index, !pto.mask<b16>
    }
    return
  }

// CHECK-LABEL: func.func @early_table_initializer(
// CHECK: pto.vsts
// CHECK-NEXT: pto.mem_bar "VST_VLD"
// CHECK-NEXT: {{.*}}pto.vlds
// CHECK: pto.vsts
// CHECK-NOT: pto.mem_bar
// CHECK: pto.vgather2
// CHECK-NOT: pto.mem_bar
// CHECK: return
  func.func @early_table_initializer(%data: !pto.vreg<128xui16>) {
    %zero = arith.constant 0 : index
    %dst = arith.constant 2048 : index
    %sink = arith.constant 4096 : index
    %base = arith.constant 0 : i64
    %table_addr = arith.constant 196608 : i64
    %start = arith.constant 0 : i16
    %p = pto.castptr %base : i64 -> !pto.ptr<ui16, ub>
    %table = pto.castptr %table_addr : i64 -> !pto.ptr<ui16, ub>
    pto.vecscope {
      %m = pto.pset_b16 "PAT_ALL" : !pto.mask<b16>
      %ramp = pto.vci %start : i16 -> !pto.vreg<128xi16>
      %new_indices = pto.vbitcast %ramp : !pto.vreg<128xi16> -> !pto.vreg<128xui16>
      pto.vsts %new_indices, %table[%zero], %m : !pto.vreg<128xui16>, !pto.ptr<ui16, ub>, index, !pto.mask<b16>
      %indices = pto.vlds %table[%zero] : !pto.ptr<ui16, ub>, index -> !pto.vreg<128xui16>
      pto.vsts %data, %p[%dst], %m : !pto.vreg<128xui16>, !pto.ptr<ui16, ub>, index, !pto.mask<b16>
      %read = pto.vgather2 %p, %indices, %m : !pto.ptr<ui16, ub>, !pto.vreg<128xui16>, !pto.mask<b16> -> !pto.vreg<128xui16>
      pto.vsts %read, %p[%sink], %m : !pto.vreg<128xui16>, !pto.ptr<ui16, ub>, index, !pto.mask<b16>

    }
    return
  }
}
