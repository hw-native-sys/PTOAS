// CHECK-LABEL: func.func @table_conditional_initializer(
// CHECK: pto.mem_bar
// CHECK: return
func.func @table_conditional_initializer(%cond: i1) {
  %c0 = arith.constant 0 : index
  %s0 = arith.constant 0 : i16
  %src0 = arith.constant 0 : i64
  %dst0 = arith.constant 4096 : i64
  %tab0 = arith.constant 196608 : i64
  %src = pto.castptr %src0 : i64 -> !pui16ub
  %dst = pto.castptr %dst0 : i64 -> !pui16ub
  %tab = pto.castptr %tab0 : i64 -> !pui16ub
  scf.if %cond {
  pto.vecscope {
    %i = pto.vci %s0 : i16 -> !v128xi16
    %u = pto.vbitcast %i : !v128xi16 -> !v128xui16
    %pm = pto.pset_b16 "PAT_ALL" : !mb16
    pto.vsts %u, %tab[%c0], %pm : !v128xui16, !pui16ub, index, !mb16
  }
  }

  pto.vecscope {
    %m2 = pto.pset_b16 "PAT_ALL" : !mb16
    %idx = pto.vlds %tab[%c0] : !pui16ub, index -> !v128xui16
    %a = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    pto.vsts %a, %dst[%c0], %m2 : !v128xui16, !pui16ub, index, !mb16
    %b = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    %keep = arith.constant 128 : index
    pto.vsts %b, %dst[%keep], %m2 : !v128xui16, !pui16ub, index, !mb16
  }
  return
}

// CHECK-LABEL: func.func @table_empty_initializer(
// CHECK: pto.mem_bar
// CHECK: return
func.func @table_empty_initializer(%n: index) {
  %c0 = arith.constant 0 : index
  %c1 = arith.constant 1 : index
  %s0 = arith.constant 0 : i16
  %src0 = arith.constant 0 : i64
  %dst0 = arith.constant 4096 : i64
  %tab0 = arith.constant 196608 : i64
  %src = pto.castptr %src0 : i64 -> !pui16ub
  %dst = pto.castptr %dst0 : i64 -> !pui16ub
  %tab = pto.castptr %tab0 : i64 -> !pui16ub
  scf.for %outer = %c0 to %n step %c1 {
  pto.vecscope {
    %i = pto.vci %s0 : i16 -> !v128xi16
    %u = pto.vbitcast %i : !v128xi16 -> !v128xui16
    %pm = pto.pset_b16 "PAT_ALL" : !mb16
    pto.vsts %u, %tab[%c0], %pm : !v128xui16, !pui16ub, index, !mb16
  }
  }

  pto.vecscope {
    %m2 = pto.pset_b16 "PAT_ALL" : !mb16
    %idx = pto.vlds %tab[%c0] : !pui16ub, index -> !v128xui16
    %a = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    pto.vsts %a, %dst[%c0], %m2 : !v128xui16, !pui16ub, index, !mb16
    %b = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    %keep = arith.constant 128 : index
    pto.vsts %b, %dst[%keep], %m2 : !v128xui16, !pui16ub, index, !mb16
  }
  return
}

// CHECK-LABEL: func.func @table_conditional_clobber(
// CHECK: pto.mem_bar
// CHECK: return
func.func @table_conditional_clobber(%cond: i1) {
  %c0 = arith.constant 0 : index
  %s0 = arith.constant 0 : i16
  %src0 = arith.constant 0 : i64
  %dst0 = arith.constant 4096 : i64
  %tab0 = arith.constant 196608 : i64
  %src = pto.castptr %src0 : i64 -> !pui16ub
  %dst = pto.castptr %dst0 : i64 -> !pui16ub
  %tab = pto.castptr %tab0 : i64 -> !pui16ub

  pto.vecscope {
    %i = pto.vci %s0 : i16 -> !v128xi16
    %u = pto.vbitcast %i : !v128xi16 -> !v128xui16
    %pm = pto.pset_b16 "PAT_ALL" : !mb16
    pto.vsts %u, %tab[%c0], %pm : !v128xui16, !pui16ub, index, !mb16
  }

  scf.if %cond {
    pto.vecscope {
      %cm = pto.pset_b16 "PAT_ALL" : !mb16
      %cv = pto.vlds %src[%c0] : !pui16ub, index -> !v128xui16
      pto.vsts %cv, %tab[%c0], %cm : !v128xui16, !pui16ub, index, !mb16
    }
  }
  pto.vecscope {
    %m2 = pto.pset_b16 "PAT_ALL" : !mb16
    %idx = pto.vlds %tab[%c0] : !pui16ub, index -> !v128xui16
    %a = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    pto.vsts %a, %dst[%c0], %m2 : !v128xui16, !pui16ub, index, !mb16
    %b = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    %keep = arith.constant 128 : index
    pto.vsts %b, %dst[%keep], %m2 : !v128xui16, !pui16ub, index, !mb16
  }
  return
}

// CHECK-LABEL: func.func @table_dma_clobber(
// CHECK: pto.mem_bar
// CHECK: return
func.func @table_dma_clobber(%gm: !pui16gm) {
  %c0 = arith.constant 0 : index
  %s0 = arith.constant 0 : i16
  %src0 = arith.constant 0 : i64
  %dst0 = arith.constant 4096 : i64
  %tab0 = arith.constant 196608 : i64
  %one64 = arith.constant 1 : i64
  %zero64 = arith.constant 0 : i64
  %len64 = arith.constant 256 : i64
  %false = arith.constant false
  %src = pto.castptr %src0 : i64 -> !pui16ub
  %dst = pto.castptr %dst0 : i64 -> !pui16ub
  %tab = pto.castptr %tab0 : i64 -> !pui16ub
  pto.set_loop_size_outtoub %one64, %one64 : i64, i64

  pto.vecscope {
    %i = pto.vci %s0 : i16 -> !v128xi16
    %u = pto.vbitcast %i : !v128xi16 -> !v128xui16
    %pm = pto.pset_b16 "PAT_ALL" : !mb16
    pto.vsts %u, %tab[%c0], %pm : !v128xui16, !pui16ub, index, !mb16
  }

  pto.copy_gm_to_ubuf %gm, %tab, %zero64, %one64, %len64, %zero64, %zero64, %false, %zero64, %len64, %len64 : !pui16gm, !pui16ub, i64, i64, i64, i64, i64, i1, i64, i64, i64
  pto.vecscope {
    %m2 = pto.pset_b16 "PAT_ALL" : !mb16
    %idx = pto.vlds %tab[%c0] : !pui16ub, index -> !v128xui16
    %a = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    pto.vsts %a, %dst[%c0], %m2 : !v128xui16, !pui16ub, index, !mb16
    %b = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    %keep = arith.constant 128 : index
    pto.vsts %b, %dst[%keep], %m2 : !v128xui16, !pui16ub, index, !mb16
  }
  return
}

// CHECK-LABEL: func.func @table_dma_disjoint(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
func.func @table_dma_disjoint(%gm: !pui16gm) {
  %c0 = arith.constant 0 : index
  %s0 = arith.constant 0 : i16
  %src0 = arith.constant 0 : i64
  %dst0 = arith.constant 4096 : i64
  %tab0 = arith.constant 196608 : i64
  %one64 = arith.constant 1 : i64
  %zero64 = arith.constant 0 : i64
  %len64 = arith.constant 256 : i64
  %false = arith.constant false
  %src = pto.castptr %src0 : i64 -> !pui16ub
  %dst = pto.castptr %dst0 : i64 -> !pui16ub
  %tab = pto.castptr %tab0 : i64 -> !pui16ub
  pto.set_loop_size_outtoub %one64, %one64 : i64, i64

  pto.vecscope {
    %i = pto.vci %s0 : i16 -> !v128xi16
    %u = pto.vbitcast %i : !v128xi16 -> !v128xui16
    %pm = pto.pset_b16 "PAT_ALL" : !mb16
    pto.vsts %u, %tab[%c0], %pm : !v128xui16, !pui16ub, index, !mb16
  }

  pto.copy_gm_to_ubuf %gm, %src, %zero64, %one64, %len64, %zero64, %zero64, %false, %zero64, %len64, %len64 : !pui16gm, !pui16ub, i64, i64, i64, i64, i64, i1, i64, i64, i64
  pto.vecscope {
    %m2 = pto.pset_b16 "PAT_ALL" : !mb16
    %idx = pto.vlds %tab[%c0] : !pui16ub, index -> !v128xui16
    %a = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    pto.vsts %a, %dst[%c0], %m2 : !v128xui16, !pui16ub, index, !mb16
    %b = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    %keep = arith.constant 128 : index
    pto.vsts %b, %dst[%keep], %m2 : !v128xui16, !pui16ub, index, !mb16
  }
  return
}

// CHECK-LABEL: func.func @table_unknown_call(
// CHECK: pto.mem_bar
// CHECK: return
func.func @table_unknown_call() {
  %c0 = arith.constant 0 : index
  %s0 = arith.constant 0 : i16
  %src0 = arith.constant 0 : i64
  %dst0 = arith.constant 4096 : i64
  %tab0 = arith.constant 196608 : i64
  %src = pto.castptr %src0 : i64 -> !pui16ub
  %dst = pto.castptr %dst0 : i64 -> !pui16ub
  %tab = pto.castptr %tab0 : i64 -> !pui16ub

  pto.vecscope {
    %i = pto.vci %s0 : i16 -> !v128xi16
    %u = pto.vbitcast %i : !v128xi16 -> !v128xui16
    %pm = pto.pset_b16 "PAT_ALL" : !mb16
    pto.vsts %u, %tab[%c0], %pm : !v128xui16, !pui16ub, index, !mb16
  }

  func.call @opaque() : () -> ()
  pto.vecscope {
    %m2 = pto.pset_b16 "PAT_ALL" : !mb16
    %idx = pto.vlds %tab[%c0] : !pui16ub, index -> !v128xui16
    %a = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    pto.vsts %a, %dst[%c0], %m2 : !v128xui16, !pui16ub, index, !mb16
    %b = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    %keep = arith.constant 128 : index
    pto.vsts %b, %dst[%keep], %m2 : !v128xui16, !pui16ub, index, !mb16
  }
  return
}

// CHECK-LABEL: func.func @table_wrap_initializer(
// CHECK: pto.mem_bar
// CHECK: return
func.func @table_wrap_initializer() {
  %c0 = arith.constant 0 : index
  %s0 = arith.constant 0 : i16
  %s15i = arith.constant 15 : i16
  %s15 = builtin.unrealized_conversion_cast %s15i : i16 to ui16
  %s128i = arith.constant -1 : i16
  %s128 = builtin.unrealized_conversion_cast %s128i : i16 to ui16
  %s4 = arith.constant 4 : i16
  %src0 = arith.constant 0 : i64
  %dst0 = arith.constant 4096 : i64
  %tab0 = arith.constant 196608 : i64
  %src = pto.castptr %src0 : i64 -> !pui16ub
  %dst = pto.castptr %dst0 : i64 -> !pui16ub
  %tab = pto.castptr %tab0 : i64 -> !pui16ub

  pto.vecscope {
    %i = pto.vci %s0 : i16 -> !v128xi16
    %u = pto.vbitcast %i : !v128xi16 -> !v128xui16
    %m = pto.pset_b16 "PAT_ALL" : !mb16
    %maskv = pto.vdup %s15, %m : ui16, !mb16 -> !v128xui16
    %row = pto.vand %u, %maskv, %m : !v128xui16, !v128xui16, !mb16 -> !v128xui16
    %pack = pto.vshrs %u, %s4, %m : !v128xui16, i16, !mb16 -> !v128xui16
    %scaled = pto.vmuls %row, %s128, %m : !v128xui16, ui16, !mb16 -> !v128xui16
    %indices = pto.vadd %scaled, %pack, %m : !v128xui16, !v128xui16, !mb16 -> !v128xui16
    %pm = pto.pset_b16 "PAT_ALL" : !mb16
    pto.vsts %indices, %tab[%c0], %pm : !v128xui16, !pui16ub, index, !mb16
  }

  pto.vecscope {
    %m2 = pto.pset_b16 "PAT_ALL" : !mb16
    %idx = pto.vlds %tab[%c0] : !pui16ub, index -> !v128xui16
    %a = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    pto.vsts %a, %dst[%c0], %m2 : !v128xui16, !pui16ub, index, !mb16
    %b = pto.vgather2 %src, %idx, %m2 : !pui16ub, !v128xui16, !mb16 -> !v128xui16
    %keep = arith.constant 128 : index
    pto.vsts %b, %dst[%keep], %m2 : !v128xui16, !pui16ub, index, !mb16
  }
  return
}

// CHECK-LABEL: func.func @table_scaled_scatter_clobber(
// CHECK: pto.mem_bar
// CHECK: return
func.func @table_scaled_scatter_clobber() {
  %c0 = arith.constant 0 : index
  %s0 = arith.constant 0 : i16
  %src0 = arith.constant 0 : i64
  %dst0 = arith.constant 4096 : i64
  %tab0 = arith.constant 196608 : i64
  %src = pto.castptr %src0 : i64 -> !pui16ub
  %dst = pto.castptr %dst0 : i64 -> !pui16ub
  %tab = pto.castptr %tab0 : i64 -> !pui16ub

  pto.vecscope {
    %i = pto.vci %s0 : i16 -> !v128xi16
    %u = pto.vbitcast %i : !v128xi16 -> !v128xui16
    %pm = pto.pset_b16 "PAT_ALL" : !mb16
    pto.vsts %u, %tab[%c0], %pm : !v128xui16, !pui16ub, index, !mb16
  }

  pto.vecscope {
    %sc0 = arith.constant 1 : i16
    %sc128i = arith.constant 128 : i16
    %sc128 = builtin.unrealized_conversion_cast %sc128i : i16 to ui16
    %sc2048i = arith.constant 2048 : i16
    %sc2048 = builtin.unrealized_conversion_cast %sc2048i : i16 to ui16
    %scbase = arith.constant 196352 : i64
    %scptr = pto.castptr %scbase : i64 -> !pui16ub
    %sm = pto.pset_b16 "PAT_ALL" : !mb16
    %si = pto.vci %sc0 : i16 -> !v128xi16
    %su = pto.vbitcast %si : !v128xi16 -> !v128xui16
    %so = pto.vmuls %su, %sc128, %sm : !v128xui16, ui16, !mb16 -> !v128xui16
    %sv = pto.vdup %sc2048, %sm : ui16, !mb16 -> !v128xui16
    pto.vscatter %sv, %scptr, %so, %sm : !v128xui16, !pui16ub, !v128xui16, !mb16
  }
  pto.vecscope {
    %m2 = pto.pset_b16 "PAT_ALL" : !mb16
