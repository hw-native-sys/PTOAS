// Test pto-unroll-loops diagnostics for malformed hint attributes.
//
// All malformed loops live in ONE function on purpose: the pass validates
// every annotated loop of a function and reports all errors before failing
// once.  Spread across multiple functions the set of emitted diagnostics
// would be nondeterministic - MLIR's function pass adaptor processes
// functions through failableParallelForEach, which stops scheduling new
// functions as soon as one fails (and with threading disabled stops at the
// first failed function outright).

// RUN: not pto-test-opt --pto-unroll-loops %s 2>&1 | FileCheck %s

module {
  func.func @bad_hints(%n: index) {
    %buf = memref.alloc() : memref<1xindex>
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index

    // CHECK: error: unknown 'pto.unroll' value 'sometimes'; only "full" is supported
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll = "sometimes"}

    // "enable" was removed together with the metadata forwarding path.
    // CHECK: error: unknown 'pto.unroll' value 'enable'; only "full" is supported
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll = "enable"}

    // CHECK: error: unknown 'pto.unroll' value 'disable'; only "full" is supported
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll = "disable"}

    // CHECK: error: 'pto.unroll' and 'pto.unroll_factor' are mutually exclusive on one loop
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll = "full", pto.unroll_factor = 4 : i32}

    // CHECK: error: 'pto.unroll_factor' must be a positive integer, got 0
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll_factor = 0 : i32}

    // A wider integer attribute does not fit the signless i32 contract and
    // would silently truncate when read back as a signed 32-bit factor.
    // CHECK: error: 'pto.unroll_factor' must be a signless i32 attribute, got 'i64'
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll_factor = 4 : i64}

    // CHECK: error: 'pto.unroll_factor' must be a signless i32 attribute, got 'i64'
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll_factor = 2147483648 : i64}

    // Right attribute name, wrong attribute kind: the typed getters would
    // return null and the malformed hint would silently survive the pass, so
    // the kind is checked before anything else.
    // CHECK: error: 'pto.unroll' must be a string attribute, got 1 : i32
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll = 1 : i32}

    // CHECK: error: 'pto.unroll_factor' must be a signless i32 attribute, got "4"
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll_factor = "4"}

    return
  }
}
