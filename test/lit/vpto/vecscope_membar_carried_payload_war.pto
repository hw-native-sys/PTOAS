// RUN: pto-test-opt %s --pto-insert-vecscope-membar | FileCheck %s
// RUN: sed 's/^module {/module attributes {pto.target_arch = "a3"} {/' %s | pto-test-opt --pto-insert-vecscope-membar | FileCheck %s
// RUN: sed 's/^module {/module attributes {pto.target_arch = "a5"} {/' %s | pto-test-opt --pto-insert-vecscope-membar | FileCheck %s
// CHECK-LABEL: func.func @carried_payload
// CHECK: pto.vlds
// CHECK: pto.mem_bar "VLD_VST"
// CHECK: pto.vsts
module {
  func.func @carried_payload(%base: !pto.ptr<f32, ub>, %seed: !pto.vreg<64xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %unused = scf.for %i = %c0 to %c4 step %c1 iter_args(%prev = %seed) -> !pto.vreg<64xf32> {
        %cur = pto.vlds %base[%c0] : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
        pto.vsts %prev, %base[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
        scf.yield %cur : !pto.vreg<64xf32>
      }
    }
    return
  }
}
