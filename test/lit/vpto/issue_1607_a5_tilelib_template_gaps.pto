    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui32, rows=2, cols=64, v_row=2, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %scalar_raw = arith.constant 3 : i32
    %scalar = "builtin.unrealized_conversion_cast"(%scalar_raw) : (i32) -> ui32
    pto.trems ins(%src, %scalar, %tmp
