  func.func @TCMPS_BF16() {
    %src = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=bf16, rows=2, cols=256, v_row=2, v_col=256,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
