    %src = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %tmp = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui16, rows=1, cols=64, v_row=1, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %scalar_raw = arith.constant 42 : i16
    %scalar = "builtin.unrealized_conversion_cast"(%scalar_raw) : (i16) -> ui16
    pto.tsels ins(%mask, %src, %tmp, %scalar
        : !pto.tile_buf<loc=vec, dtype=i8, rows=2, cols=64, v_row=2, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>,
          !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>,
          !pto.tile_buf<loc=vec, dtype=ui16, rows=1, cols=64, v_row=1, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>, ui16)
      outs(%dst
        : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
