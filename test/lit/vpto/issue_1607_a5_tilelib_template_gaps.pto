// Issue #1607 round 2: the A5 verifiers accept additional element types for
// tcmps/tfmods/trems/tsels, but TileLib had no template for those signatures,
// so legal kernels failed with NoMatchingTemplate. Each function feeds one
// missing signature through template selection and reaches LLVM emission.

// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-tile-op-expand %s -o - | FileCheck %s --check-prefix=SELECT
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --vpto-scheduler=off --emit-vpto-llvm-ir %s -o - | FileCheck %s --check-prefix=LLVM --implicit-check-not='llvm.hivm.vdiv.s.x.v128bf16'

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @TCMPS_UI16() {
    %src = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=256, v_row=2, v_col=256,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=32, v_row=2, v_col=32,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %scalar_raw = arith.constant 2 : i16
    %scalar = "builtin.unrealized_conversion_cast"(%scalar_raw) : (i16) -> ui16
    pto.tcmps ins(%src, %scalar {cmpMode = #pto<cmp lt>}
        : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=256, v_row=2, v_col=256,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>, ui16)
      outs(%dst
        : !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=32, v_row=2, v_col=32,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }

  func.func @TCMPS_UI32() {
    %src = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui32, rows=2, cols=256, v_row=2, v_col=256,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=32, v_row=2, v_col=32,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %scalar_raw = arith.constant 2 : i32
    %scalar = "builtin.unrealized_conversion_cast"(%scalar_raw) : (i32) -> ui32
    pto.tcmps ins(%src, %scalar {cmpMode = #pto<cmp gt>}
        : !pto.tile_buf<loc=vec, dtype=ui32, rows=2, cols=256, v_row=2, v_col=256,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>, ui32)
      outs(%dst
        : !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=32, v_row=2, v_col=32,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }

  func.func @TFMODS_UI16() {
    %src = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %scalar_raw = arith.constant 3 : i16
    %scalar = "builtin.unrealized_conversion_cast"(%scalar_raw) : (i16) -> ui16
    pto.tfmods ins(%src, %scalar
        : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>, ui16)
      outs(%dst
        : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }

  func.func @TFMODS_UI32() {
    %src = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui32, rows=2, cols=64, v_row=2, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui32, rows=2, cols=64, v_row=2, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %scalar_raw = arith.constant 3 : i32
    %scalar = "builtin.unrealized_conversion_cast"(%scalar_raw) : (i32) -> ui32
    pto.tfmods ins(%src, %scalar
        : !pto.tile_buf<loc=vec, dtype=ui32, rows=2, cols=64, v_row=2, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>, ui32)
      outs(%dst
        : !pto.tile_buf<loc=vec, dtype=ui32, rows=2, cols=64, v_row=2, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }

  func.func @REMS_UI16() {
    %src = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %tmp = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %scalar_raw = arith.constant 3 : i16
    %scalar = "builtin.unrealized_conversion_cast"(%scalar_raw) : (i16) -> ui16
    pto.trems ins(%src, %scalar, %tmp
        : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>, ui16,
          !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst
        : !pto.tile_buf<loc=vec, dtype=ui16, rows=2, cols=64, v_row=2, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }

  func.func @REMS_UI32() {
    %src = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui32, rows=2, cols=64, v_row=2, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %tmp = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=ui32, rows=2, cols=64, v_row=2, v_col=64,
