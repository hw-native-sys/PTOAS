// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-tile-op-expand %s -o - | FileCheck %s
// RUN: not ptoas --pto-arch=a3 %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=A3
// A3: expects src element type to be i16/i32/f16/f32

!Src = !pto.tile_buf<vec, 8x32xbf16>
!Signed = !pto.tile_buf<vec, 8x8xi32, valid=8x1>
!Unsigned = !pto.tile_buf<vec, 8x8xui32, valid=8x1>

// CHECK-LABEL: func.func @rowarg_bf16
// CHECK-COUNT-2: pto.vcmax
// CHECK-COUNT-2: pto.vcmin
// CHECK: pto.vsts
module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @rowarg_bf16() {
    %src = pto.alloc_tile : !Src
    %tmp = pto.alloc_tile : !Src
    %signed = pto.alloc_tile : !Signed
    %unsigned = pto.alloc_tile : !Unsigned
    pto.trowargmax ins(%src, %tmp : !Src, !Src) outs(%signed : !Signed)
    pto.trowargmax ins(%src, %tmp : !Src, !Src) outs(%unsigned : !Unsigned)
    pto.trowargmin ins(%src, %tmp : !Src, !Src) outs(%signed : !Signed)
    pto.trowargmin ins(%src, %tmp : !Src, !Src) outs(%unsigned : !Unsigned)
    return
  }
}
