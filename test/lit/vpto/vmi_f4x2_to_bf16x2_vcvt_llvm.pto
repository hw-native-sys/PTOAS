// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - 2>/dev/null | FileCheck %s --check-prefix=VPTO --implicit-check-not=pto.vor
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s --check-prefix=LLVM

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @f4x2_to_bf16x2_vcvt_store(
      %src: !pto.ptr<!pto.f4E1M2x2, ub>,
      %dst: !pto.ptr<!pto.bf16x2, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %packed = pto.vmi.vload %src[%c0]
          : !pto.ptr<!pto.f4E1M2x2, ub>
         -> !pto.vmi.vreg<64x!pto.f4E1M2x2>
      %wide = pto.vmi.vcvt %packed
          : !pto.vmi.vreg<64x!pto.f4E1M2x2>
         -> !pto.vmi.vreg<64x!pto.bf16x2>
      pto.vmi.vstore %wide, %dst[%c0]
          : !pto.vmi.vreg<64x!pto.bf16x2>,
            !pto.ptr<!pto.bf16x2, ub>
    }
    return
  }

  // 256-lane path: Packed4 widen produces four bf16x2 registers. The solver
  // folds their reordering into two interleaved paired stores, avoiding a
  // software vintlv tree. bf16x2 uses <64 x i32> at the LLVM ABI.
  func.func @f4x2_to_bf16x2_d4_vcvt_store(
      %src: !pto.ptr<!pto.f4E1M2x2, ub>,
      %dst: !pto.ptr<!pto.bf16x2, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %packed = pto.vmi.vload %src[%c0]
          : !pto.ptr<!pto.f4E1M2x2, ub>
         -> !pto.vmi.vreg<256x!pto.f4E1M2x2>
      %wide = pto.vmi.vcvt %packed
          : !pto.vmi.vreg<256x!pto.f4E1M2x2>
         -> !pto.vmi.vreg<256x!pto.bf16x2>
      pto.vmi.vstore %wide, %dst[%c0]
          : !pto.vmi.vreg<256x!pto.bf16x2>,
            !pto.ptr<!pto.bf16x2, ub>
    }
    return
  }
}

// VPTO-LABEL: func.func @f4x2_to_bf16x2_vcvt_store
// VPTO: pto.vlds {{.*}} : !pto.ptr<!pto.f4E1M2x2, ub>, index -> !pto.vreg<256x!pto.f4E1M2x2>
// VPTO: pto.vcvt {{.*}} {part = "P0"} : !pto.vreg<256x!pto.f4E1M2x2>, !pto.mask<b8> -> !pto.vreg<128xbf16>
// VPTO: pto.vbitcast {{.*}} : !pto.vreg<128xbf16> -> !pto.vreg<64x!pto.bf16x2>
// VPTO: pto.vsts {{.*}} : !pto.vreg<64x!pto.bf16x2>, !pto.ptr<!pto.bf16x2, ub>, index, !pto.mask<b32>
// VPTO-NOT: pto.vmi.
// VPTO-NOT: !pto.vmi.

// LLVM-LABEL: define void @f4x2_to_bf16x2_vcvt_store_mix_aiv
// LLVM: call <128 x bfloat> @llvm.hivm.vcvtff2.f4e1m2x22bf16.x(<256 x float4e1m2x2> {{.*}}, <256 x i1> {{.*}}, i32 0)
// LLVM: call void @llvm.hivm.vstsx1.v64bf16x2(<64 x i32> {{.*}}, ptr addrspace(6) {{.*}}, i32 {{.*}}, i32 2, i32 0, <256 x i1> {{.*}})

// LLVM-LABEL: define void @f4x2_to_bf16x2_d4_vcvt_store_mix_aiv
// LLVM: call <128 x bfloat> @llvm.hivm.vcvtff2.f4e1m2x22bf16.x(<256 x float4e1m2x2> {{.*}}, <256 x i1> {{.*}}, i32 0)
// LLVM: call <128 x bfloat> @llvm.hivm.vcvtff2.f4e1m2x22bf16.x(<256 x float4e1m2x2> {{.*}}, <256 x i1> {{.*}}, i32 2)
// LLVM: call <128 x bfloat> @llvm.hivm.vcvtff2.f4e1m2x22bf16.x(<256 x float4e1m2x2> {{.*}}, <256 x i1> {{.*}}, i32 0)
// LLVM: call <128 x bfloat> @llvm.hivm.vcvtff2.f4e1m2x22bf16.x(<256 x float4e1m2x2> {{.*}}, <256 x i1> {{.*}}, i32 2)
// LLVM-NOT: @llvm.hivm.vintlv
// LLVM: call void @llvm.hivm.vstsx2.v64bf16x2(<64 x i32> {{.*}}, <64 x i32> {{.*}}, ptr addrspace(6) {{.*}}, i32 0, i32 11, i32 0, <256 x i1> {{.*}})
// LLVM: call void @llvm.hivm.vstsx2.v64bf16x2(<64 x i32> {{.*}}, <64 x i32> {{.*}}, ptr addrspace(6) {{.*}}, i32 512, i32 11, i32 0, <256 x i1> {{.*}})
// LLVM-NOT: call void @llvm.hivm.vsts
// LLVM: ret void
