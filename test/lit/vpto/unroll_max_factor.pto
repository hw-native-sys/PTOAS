// Test the max-unroll-factor cap: a factor above the cap is not unrolled
// natively (loopUnrollByFactor would clone the body factor times, which a
// huge factor turns into a compile-time hang).  The hint is dropped with a
// remark and the loop is kept.

// RUN: pto-test-opt --pto-unroll-loops=max-unroll-factor=4 %s 2>&1 | FileCheck %s

module {
  // Factor 5 exceeds the cap of 4: the hint is dropped with a remark and the
  // loop is kept unchanged.
  // CHECK:      remark: 'pto.unroll_factor' = 5 exceeds max-unroll-factor=4
  // CHECK-LABEL: func.func @factor_above_cap
  // CHECK:         scf.for
  // CHECK-NOT:     pto.unroll_factor
  func.func @factor_above_cap() {
    %buf = memref.alloc() : memref<8xindex>
    %c0 = arith.constant 0 : index
    %c8 = arith.constant 8 : index
    %c1 = arith.constant 1 : index
    scf.for %i = %c0 to %c8 step %c1 {
      memref.store %i, %buf[%i] : memref<8xindex>
    } {pto.unroll_factor = 5 : i32}
    return
  }

  // Factor 4 is at the cap and still unrolls natively.
  // CHECK-LABEL: func.func @factor_at_cap
  // CHECK:         scf.for
  // CHECK-COUNT-4: memref.store
  // CHECK-NOT:     pto.unroll_factor
  func.func @factor_at_cap() {
    %buf = memref.alloc() : memref<8xindex>
    %c0 = arith.constant 0 : index
    %c8 = arith.constant 8 : index
    %c1 = arith.constant 1 : index
    scf.for %i = %c0 to %c8 step %c1 {
      memref.store %i, %buf[%i] : memref<8xindex>
    } {pto.unroll_factor = 4 : i32}
    return
  }
}
