// RUN: pto-test-opt %s -vpto-soft-postupdate | FileCheck %s

// A descending normalized recurrence widened into an addptr base must retain
// its certified -1 delta through the cast.
// CHECK-LABEL: func.func @canonical_i16_descending_base
// CHECK: pto.vlds {{.*}}[%c-1] : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>, !pto.ptr<ui8, ub>

// A range-proven i16 induction variable remains an IV and can drive
// post-update through its widening cast.
// CHECK-LABEL: func.func @canonical_i16_iv
// CHECK: scf.for %{{.*}} = %{{.*}} to %{{.*}} step %{{.*}} iter_args(%{{.*}} = %{{.*}}) -> (!pto.ptr<ui8, ub>) : i16 {
// CHECK: pto.vlds {{.*}} -> !pto.vreg<256xui8>, !pto.ptr<ui8, ub>

// A loop-varying integer-to-index address is accepted when its source is an
// i16 iter_arg whose nsw/nuw flag certifies the address domain.
// CHECK-LABEL: func.func @canonical_i16_no_wrap
// CHECK: scf.for
// CHECK: pto.vlds {{.*}} -> !pto.vreg<256xui8>, !pto.ptr<ui8, ub>

// The consumer does not repeat trip-count analysis. A dynamic-trip recurrence
// carrying the same nsw IR contract is accepted when soft-postupdate is run on
// already-canonical input.
// CHECK-LABEL: func.func @canonical_dynamic_trip_certificate
// CHECK: scf.for
// CHECK: pto.vlds {{.*}} -> !pto.vreg<256xui8>, !pto.ptr<ui8, ub>

// i8 is not the canonical address width. More importantly, the original
// unsigned address sequence is 224, 0 while a fixed +32 pointer recurrence
// would access 224, 256. Keep the original non-post-update operation.
// CHECK-LABEL: func.func @noncanonical_i8_wrap
// CHECK: scf.for
// CHECK: pto.vlds {{.*}} -> !pto.vreg<256xui8>{{$}}

// A non-wrapping i32 recurrence is still rejected because it has not passed
// through the separate address-normalization contract.
// CHECK-LABEL: func.func @noncanonical_i32_no_wrap
// CHECK: scf.for
// CHECK: pto.vlds {{.*}} -> !pto.vreg<256xui8>{{$}}

// i16 is the canonical width, but its type alone is not a no-wrap proof. The
// original unsigned address sequence is 65504, 0, so this also stays normal.
// CHECK-LABEL: func.func @canonical_i16_wrap
// CHECK: scf.for
// CHECK: pto.vlds {{.*}} -> !pto.vreg<256xui8>{{$}}

// A descending unsigned recurrence is in range, but sign-extending its
// two's-complement i16 increment would not match index_castui materialization.
// Keep it unchanged until address normalization supplies an explicit index
// delta.
// CHECK-LABEL: func.func @canonical_i16_unsigned_sub
// CHECK: scf.for
// CHECK: pto.vlds {{.*}} -> !pto.vreg<256xui8>{{$}}

// An i16 IV with a dynamic bound has no range proof. Its widening cast is not
// enough to justify replacing the original address sequence.
// CHECK-LABEL: func.func @uncertified_dynamic_i16_iv
// CHECK: scf.for
// CHECK: pto.vlds {{.*}} -> !pto.vreg<256xui8>{{$}}

module {
  func.func @canonical_i16_descending_base(%base: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c4_i16 = arith.constant 4 : i16
    %c1_i16 = arith.constant 1 : i16
    pto.vecscope {
      scf.for %iv = %c0 to %c2 step %c1
          iter_args(%offset16 = %c4_i16) -> i16 {
        %offset = arith.index_cast %offset16 : i16 to index
        %at = pto.addptr %base, %offset
            : !pto.ptr<ui8, ub> -> !pto.ptr<ui8, ub>
        %value = pto.vlds %at[%c0]
            : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
        %next = arith.subi %offset16, %c1_i16 overflow<nsw> : i16
        scf.yield %next : i16
      }
    }
    return
  }

  func.func @canonical_i16_iv(%base: !pto.ptr<ui8, ub>) {
    %c0_i16 = arith.constant 0 : i16
    %c1_i16 = arith.constant 1 : i16
    %c4_i16 = arith.constant 4 : i16
    pto.vecscope {
      scf.for %iv = %c0_i16 to %c4_i16 step %c1_i16 : i16 {
        %offset = arith.index_cast %iv : i16 to index
        %value = pto.vlds %base[%offset]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
      }
    }
    return
  }

  func.func @canonical_i16_no_wrap(%base: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c0_i16 = arith.constant 0 : i16
    %c32_i16 = arith.constant 32 : i16
    pto.vecscope {
      scf.for %iv = %c0 to %c2 step %c1
          iter_args(%addr16 = %c0_i16) -> i16 {
        %offset = arith.index_cast %addr16 : i16 to index
        %value = pto.vlds %base[%offset]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
        %next = arith.addi %addr16, %c32_i16 overflow<nsw> : i16
        scf.yield %next : i16
      }
    }
    return
  }

  func.func @canonical_dynamic_trip_certificate(
      %base: !pto.ptr<ui8, ub>, %upper: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c0_i16 = arith.constant 0 : i16
    %c1_i16 = arith.constant 1 : i16
    pto.vecscope {
      scf.for %iv = %c0 to %upper step %c1
          iter_args(%addr16 = %c0_i16) -> i16 {
        %offset = arith.index_cast %addr16 : i16 to index
        %value = pto.vlds %base[%offset]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
        %next = arith.addi %addr16, %c1_i16 overflow<nsw> : i16
        scf.yield %next : i16
      }
    }
    return
  }

  func.func @noncanonical_i8_wrap(%base: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %cm32_i8 = arith.constant -32 : i8
    %c32_i8 = arith.constant 32 : i8
    pto.vecscope {
      scf.for %iv = %c0 to %c2 step %c1
          iter_args(%addr8 = %cm32_i8) -> i8 {
        %offset = arith.index_castui %addr8 : i8 to index
        %value = pto.vlds %base[%offset]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
        %next = arith.addi %addr8, %c32_i8 : i8
        scf.yield %next : i8
      }
    }
    return
  }

  func.func @noncanonical_i32_no_wrap(%base: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c0_i32 = arith.constant 0 : i32
    %c32_i32 = arith.constant 32 : i32
    pto.vecscope {
      scf.for %iv = %c0 to %c2 step %c1
          iter_args(%addr32 = %c0_i32) -> i32 {
        %offset = arith.index_castui %addr32 : i32 to index
        %value = pto.vlds %base[%offset]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
        %next = arith.addi %addr32, %c32_i32 : i32
        scf.yield %next : i32
      }
    }
    return
  }

  func.func @canonical_i16_wrap(%base: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %cm32_i16 = arith.constant -32 : i16
    %c32_i16 = arith.constant 32 : i16
    pto.vecscope {
      scf.for %iv = %c0 to %c2 step %c1
          iter_args(%addr16 = %cm32_i16) -> i16 {
        %offset = arith.index_castui %addr16 : i16 to index
        %value = pto.vlds %base[%offset]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
        %next = arith.addi %addr16, %c32_i16 : i16
        scf.yield %next : i16
      }
    }
    return
  }

  func.func @canonical_i16_unsigned_sub(%base: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c32_i16 = arith.constant 32 : i16
    %c1_i16 = arith.constant 1 : i16
    pto.vecscope {
      scf.for %iv = %c0 to %c2 step %c1
          iter_args(%addr16 = %c32_i16) -> i16 {
        %offset = arith.index_castui %addr16 : i16 to index
        %value = pto.vlds %base[%offset]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
        %next = arith.subi %addr16, %c1_i16 : i16
        scf.yield %next : i16
      }
    }
    return
  }

  func.func @uncertified_dynamic_i16_iv(
      %base: !pto.ptr<ui8, ub>, %upper: i16) {
    %c0_i16 = arith.constant 0 : i16
    %c1_i16 = arith.constant 1 : i16
    pto.vecscope {
      scf.for %iv = %c0_i16 to %upper step %c1_i16 : i16 {
        %offset = arith.index_cast %iv : i16 to index
        %value = pto.vlds %base[%offset]
          : !pto.ptr<ui8, ub> -> !pto.vreg<256xui8>
      }
    }
    return
  }
}
