// A VSQZ in a sibling branch is not the value producer of the VSTUR, so it
// cannot define SQZN for that store. The producer must reach this store's
// value, not merely appear somewhere in the function.
//
// RUN: not pto-test-opt %s 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vstur_non_dominating_sqzn(
      %value: !pto.vreg<64xf32>, %mask: !pto.mask<b32>, %dst: !pto.ptr<f32, ub>,
      %cond: i1) {
    pto.vecscope {
      %align = pto.init_align : !pto.align
      scf.if %cond {
        %sqz = pto.vsqz %value, %mask
            : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      } else {
        %next = pto.vstur %align, %value, %dst, "NO_POST_UPDATE"
            : !pto.align, !pto.vreg<64xf32>, !pto.ptr<f32, ub> -> !pto.align
        pto.vstar %next, %dst : !pto.align, !pto.ptr<f32, ub>
      }
    }
    return
  }
}

// CHECK: error: 'pto.vstur' op requires its value to be produced by a pto.vsqz (directly or through pto.vbitcast)
// CHECK-SAME: VSTUR's store length comes from SPR SQZN
