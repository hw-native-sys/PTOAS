// The unaligned-store family writes UB, so the ops must declare a write
// effect on their base operand. Without it a canonicalizer/DCE run drops every
// store whose result is unused (issue 1716).

// RUN: pto-test-opt --canonicalize %s 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @unaligned_store_ops(%src: !pto.ptr<f32, ub>,
                               %dst: !pto.ptr<f32, ub>,
                               %pred: !pto.ptr<i32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c0_i32 = arith.constant 0 : i32
    %zero = arith.constant 0 : i32
    pto.vecscope {
      %vec = pto.vlds %src[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %ivec = pto.vlds %pred[%c0] : !pto.ptr<i32, ub> -> !pto.vreg<64xi32>
      %full = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %mask = pto.vcmps %ivec, %zero, %full, "gt"
          : !pto.vreg<64xi32>, i32, !pto.mask<b32> -> !pto.mask<b32>
      // vstur reads its length from SPR SQZN; emit the squeeze producer first.
      %sqz = pto.vsqz %vec, %full
          : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      // every result below is intentionally unused
      %align0 = pto.init_align : !pto.align
      %align1 = pto.vstus %align0, %c0_i32, %vec, %dst
          : !pto.align, i32, !pto.vreg<64xf32>, !pto.ptr<f32, ub> -> !pto.align
      %align2 = pto.vstur %align1, %sqz, %dst, "NO_POST_UPDATE"
          : !pto.align, !pto.vreg<64xf32>, !pto.ptr<f32, ub> -> !pto.align
      %align3, %base3 = pto.pstu %align2, %mask, %pred
          : !pto.align, !pto.mask<b32>, !pto.ptr<i32, ub> -> !pto.align, !pto.ptr<i32, ub>
    }
    return
  }
}

// CHECK-LABEL: func.func @unaligned_store_ops
// CHECK-DAG: pto.vstus
// CHECK-DAG: pto.vstur
// CHECK-DAG: pto.pstu
