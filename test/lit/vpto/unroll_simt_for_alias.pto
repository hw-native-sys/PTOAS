// Smoke test for the legacy pass alias: pto-unroll-simt-for behaves exactly
// like pto-unroll-loops (the SIMT-context restriction was lifted when the
// pass was generalized).

// RUN: pto-test-opt --pto-unroll-simt-for %s 2>&1 | FileCheck %s

module {
  // CHECK-LABEL: func.func @alias_full_unroll
  // CHECK-NOT:     scf.for
  // CHECK-COUNT-2: memref.store
  // CHECK-NOT:     memref.store
  // CHECK-NOT:     pto.unroll
  func.func @alias_full_unroll() {
    %buf = memref.alloc() : memref<2xindex>
    %c0 = arith.constant 0 : index
    %c2 = arith.constant 2 : index
    %c1 = arith.constant 1 : index
    scf.for %i = %c0 to %c2 step %c1 {
      memref.store %i, %buf[%i] : memref<2xindex>
    } {pto.unroll = "full"}
    return
  }
}
