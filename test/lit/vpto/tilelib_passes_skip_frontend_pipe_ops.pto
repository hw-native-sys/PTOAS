// TileLib passes and frontend pipe ops: tpush/tpop are now template-eligible
// (marked by InsertTemplateAttributes when a PTODSL runtime is available), so
// these passes require an initialized runtime when such ops are present and
// fail cleanly without one.  Non-template pseudo-ops (talloc/tfree) still take
// no part in template expansion.
// RUN: not pto-test-opt --pto-insert-template-attributes %s 2>&1 | FileCheck %s --check-prefix=INSERT
// RUN: not pto-test-opt --pto-expand-tile-op %s 2>&1 | FileCheck %s --check-prefix=EXPAND

module {
  func.func @frontend_cube_pipe_ops(%base: !pto.ptr<f32, gm>) attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %slots = pto.make_tensor_view %base, shape = [%c16, %c16], strides = [%c16, %c1]
      : !pto.tensor_view<16x16xf32>
    pto.aic_initialize_pipe {id = 0, dir_mask = 1, slot_size = 1024}
      (gm_slot_tensor = %slots : !pto.tensor_view<16x16xf32>)
    %allocated = pto.talloc_to_aiv {id = 0, split = 0}
      -> !pto.tensor_view<16x16xf32>
    pto.tpush_to_aiv(%allocated : !pto.tensor_view<16x16xf32>)
      {id = 0, split = 0}
    return
  }
  func.func @frontend_vector_pipe_ops(%base: !pto.ptr<f32, gm>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %slots = pto.make_tensor_view %base, shape = [%c16, %c16], strides = [%c16, %c1]
      : !pto.tensor_view<16x16xf32>
    pto.aiv_initialize_pipe {id = 0, dir_mask = 1, slot_size = 1024}
      (gm_slot_tensor = %slots : !pto.tensor_view<16x16xf32>)
    %received = pto.tpop_from_aic {id = 0, split = 0}
      -> !pto.tensor_view<16x16xf32>
    pto.tfree_from_aic(%received : !pto.tensor_view<16x16xf32>)
      {id = 0, split = 0}
    return
  }
}

// INSERT: error: InsertTemplateAttributes requires an initialized PTODSL runtime
// EXPAND: error: ExpandTileOp requires an initialized PTODSL runtime
