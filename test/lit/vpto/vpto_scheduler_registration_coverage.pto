// RUN: pto-test-opt %s '-pto-vpto-scheduler=mode=analyze' > /dev/null 2> %t
// RUN: FileCheck %s < %t

// The registration audit is independent of the operations present in the
// input. This module intentionally contains no vecscope.
// CHECK: vpto-scheduler: registration-coverage registered={{[1-9][0-9]*}} schedulable={{[1-9][0-9]*}} boundary=1 unclassified=0
// CHECK-NEXT: vpto-scheduler: registered-boundary-op=pto.dcci reason=explicit-scheduling-boundary
// CHECK-NOT: vpto-scheduler: registered-unclassified-op=
// CHECK-NOT: vpto-scheduler: function=

module attributes {pto.target_arch = "a5"} {
  func.func @no_vecscope() {
    return
  }
}
