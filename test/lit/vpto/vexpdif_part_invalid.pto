// RUN: pto-test-opt %s -verify-diagnostics -split-input-file

// An f16 source only consumes one 16-bit half of every 32-bit lane per
// instruction, so omitting `part` cannot compute the whole vector.
module {
  func.func @vexpdif_f16_missing_part(
      %input: !pto.vreg<128xf16>,
      %max: !pto.vreg<128xf16>,
      %mask: !pto.mask<b16>) -> !pto.vreg<64xf32> {
    // expected-error @+1 {{requires part (EVEN or ODD) for f16 input: one instruction consumes a single 16-bit half of every 32-bit lane}}
    %result = pto.vexpdif %input, %max, %mask : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
    return %result : !pto.vreg<64xf32>
  }
}

// -----

// A present token is still restricted to the EVEN/ODD vocabulary.
module {
  func.func @vexpdif_f32_invalid_part(
      %input: !pto.vreg<64xf32>,
      %max: !pto.vreg<64xf32>,
      %mask: !pto.mask<b32>) -> !pto.vreg<64xf32> {
    // expected-error @+1 {{part must be EVEN or ODD}}
    %result = pto.vexpdif %input, %max, %mask, "P0" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
    return %result : !pto.vreg<64xf32>
  }
}

// -----

module {
  func.func @vexpdif_f16_invalid_part(
      %input: !pto.vreg<128xf16>,
      %max: !pto.vreg<128xf16>,
      %mask: !pto.mask<b16>) -> !pto.vreg<64xf32> {
    // expected-error @+1 {{part must be EVEN or ODD}}
    %result = pto.vexpdif %input, %max, %mask, "LOWER" : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
    return %result : !pto.vreg<64xf32>
  }
}
