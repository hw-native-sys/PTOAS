// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --enable-vpto-soft-postupdate --emit-vpto %s -o - | FileCheck %s

// The loop result exposes the final software accumulator to a later access.
// Post-update may rewrite the in-loop load, but it must retain the original
// offset iter_arg and its update because they remain semantically observable.

// CHECK-LABEL: func.func @accum_live_result
// CHECK: [[LOOP:%[0-9]+]]:3 = scf.for
// CHECK:   [[NEXT:%[0-9]+]] = arith.addi
// CHECK:   scf.yield [[NEXT]],
// CHECK: pto.vlds {{.*}}[[[LOOP]]#0]

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @accum_live_result(%base: !pto.ptr<f32, ub>, %sink: !pto.ptr<f32, ub>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c64 = arith.constant 64 : index

    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %final_off = scf.for %iv = %c0 to %c4 step %c1
          iter_args(%off = %c0) -> (index) {
        %vec = pto.vlds %base[%off] {dist = "NORM"}
          : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
        pto.vsts %vec, %sink[%iv], %mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
        %next = arith.addi %off, %c64 : index
        scf.yield %next : index
      }
      %tail = pto.vlds %base[%final_off] {dist = "NORM"}
        : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
      pto.vsts %tail, %sink[%c0], %mask
        : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
    }
    return
  }
}
