// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @unspecified_value(%destination: !pto.ptr<f32, ub>) attributes {pto.kernel} {
    pto.vecscope {
      %offset = arith.constant 0 : index
      %value = pto.unspecified_value : !pto.vreg<64xf32>
      %mask = pto.unspecified_value : !pto.mask<b32>
      pto.vsts %value, %destination[%offset], %mask
          : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
    }
    return
  }
}

// CHECK-LABEL: define void @unspecified_value_mix_aiv
// CHECK: call void @llvm.hivm.vstsx1.v64f32(<64 x float> undef, {{.*}}<256 x i1> undef)
