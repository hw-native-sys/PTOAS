// Regression for https://github.com/hw-native-sys/PTOAS/issues/1560.
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o %t
// RUN: FileCheck %s --input-file=%t

module attributes {pto.target_arch = "a5"} {
  module attributes {pto.backend = "vpto", pto.kernel_kind = #pto.kernel_kind<vector>, pto.target_arch = "a5"} {
    func.func @issue_1560(%arg0: !pto.ptr<i32, gm>, %arg1: !pto.ptr<f32, gm>, %arg2: !pto.ptr<i32, gm>, %arg3: !pto.ptr<f32, gm>, %arg4: i32) attributes {pto.entry, pto.kernel_kind = #pto.kernel_kind<vector>} {
      %0 = pto.get_block_idx
      %1 = pto.trunci %0 : i64 -> i32
      // This independent range-proven chain must remain optimized even though
      // the function also contains the mixed-result scf.if below.
      %sbi = pto.get_subblock_idx
      %c2_i64 = pto.constant 2 : i64
      %safe_rem = pto.remi %sbi, %c2_i64 unsigned : i64
      %safe_div = pto.divi %sbi, %c2_i64 unsigned : i64
      %safe_sum = pto.addi %safe_rem, %safe_div : i64
      %safe_i32 = pto.trunci %safe_sum : i64 -> i32
      %safe_idx = pto.constant 1 : index
      pto.st_dev %safe_i32, %arg2[%safe_idx] : !pto.ptr<i32, gm>, index, i32
      pto.set_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
      %2 = pto.cmpi lt %1, %arg4 signed : i32
      %3 = pto.constant 0 : i8
      %4 = scf.if %2 -> (i8) {
        %11 = pto.constant 1 : i32
        %12 = pto.addi %1, %11 : i32
        %13 = pto.index_cast %12 signed : i32 -> index
        %14 = pto.load %arg0[%13] : !pto.ptr<i32, gm>, index -> i32
        %15 = pto.constant 0 : i32
        %16 = pto.cmpi ne %14, %15 signed : i32
        %17 = pto.constant 1 : i8
        %18 = pto.constant 0 : i8
        %19 = pto.select %16, %17, %18 : i8
        scf.yield %19 : i8
      } else {
        scf.yield %3 : i8
      }
      %5 = pto.constant 0.000000e+00 : f32
      %6 = scf.if %2 -> (f32) {
        %11 = pto.constant 0 : i8
        %12 = pto.cmpi ne %4, %11 signed : i8
        %13 = scf.if %12 -> (f32) {
          %14 = pto.index_cast %1 signed : i32 -> index
          %15 = pto.load %arg1[%14] : !pto.ptr<f32, gm>, index -> f32
          scf.yield %15 : f32
        } else {
          scf.yield %5 : f32
        }
        scf.yield %13 : f32
      } else {
        scf.yield %5 : f32
      }
      %7 = scf.if %2 -> (i1) {
        %11 = pto.constant 0 : i8
        %12 = pto.cmpi ne %4, %11 signed : i8
        scf.yield %12 : i1
      } else {
        scf.yield %2 : i1
      }
      scf.if %7 {
        pto.wait_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
      }
      %8 = pto.constant 0 : i32
      %9 = scf.if %2 -> (i32) {
        %11 = pto.constant 0 : i8
        %12 = pto.cmpi ne %4, %11 signed : i8
        %13 = scf.if %12 -> (i32) {
          %16 = pto.index_cast %1 signed : i32 -> index
          %17 = pto.load %arg0[%16] : !pto.ptr<i32, gm>, index -> i32
          scf.yield %17 : i32
        } else {
          scf.yield %8 : i32
        }
        %14 = pto.constant 0 : i8
        %15 = pto.cmpi ne %4, %14 signed : i8
        scf.if %15 {
          %16 = pto.castptr %arg3 : !pto.ptr<f32, gm> -> !pto.ptr<i32, gm>
          %17 = pto.bitcast %6 : f32 -> i32
          %18 = pto.constant 0 : index
          pto.st_dev %17, %16[%18] : !pto.ptr<i32, gm>, index, i32
        }
        scf.yield %13 : i32
      } else {
        scf.yield %8 : i32
      }
      %10 = scf.if %2 -> (i1) {
        %11 = pto.constant 0 : i8
        %12 = pto.cmpi ne %4, %11 signed : i8
        scf.yield %12 : i1
      } else {
        scf.yield %2 : i1
      }
      scf.if %10 {
        pto.set_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
      }
      scf.if %2 {
        %11 = pto.constant 0 : i8
        %12 = pto.cmpi ne %4, %11 signed : i8
        scf.if %12 {
          %13 = pto.constant 0 : index
          pto.st_dev %9, %arg2[%13] : !pto.ptr<i32, gm>, index, i32
        }
      }
      pto.wait_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
      return
    }
  }
}


// CHECK-LABEL: func.func @issue_1560
// CHECK-NOT: arith.remui
// CHECK-NOT: arith.divui
// CHECK: pto.st_dev
// CHECK: scf.if {{.*}} -> (i8, f32, i1)
// CHECK: %[[MERGE:[0-9]+]] = scf.if {{.*}} -> (i32)
// CHECK: %[[LOADED:[0-9]+]] = pto.load %arg0
// CHECK: scf.yield %[[LOADED]] : i32
// CHECK: pto.st_dev %[[MERGE]], %arg2
