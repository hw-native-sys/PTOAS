// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s --implicit-check-not=pto.mem_bar

// CHECK-LABEL: func.func @disjoint_loop
// CHECK: arith.minui
// CHECK: scf.for
// CHECK: pto.vsts
!pf32ub = !pto.ptr<f32, ub>

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @disjoint_loop(%n: index) {
    %zero = arith.constant 0 : i64
    %ub = pto.castptr %zero : i64 -> !pf32ub
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c64 = arith.constant 64 : index
    %c4096 = arith.constant 4096 : index
    %src = pto.addptr %ub, %c0 : !pto.ptr<f32, ub>, index -> !pto.ptr<f32, ub>
    %dst = pto.addptr %ub, %c4096 : !pto.ptr<f32, ub>, index -> !pto.ptr<f32, ub>
    %bound = arith.minui %n, %c64 : index
    pto.vecscope {
      %mask = pto.vmi.create_mask %c64 : index -> !pto.vmi.mask<64xpred>
      scf.for %i = %c0 to %bound step %c1 {
        %offset = arith.muli %i, %c64 : index
        %v = pto.vmi.vload %src[%offset] : !pf32ub -> !pto.vmi.vreg<64xf32>
        pto.vmi.vstore %v, %dst[%offset], %mask : !pto.vmi.vreg<64xf32>, !pf32ub, !pto.vmi.mask<64xpred>
      }
    }
    return
  }
}
