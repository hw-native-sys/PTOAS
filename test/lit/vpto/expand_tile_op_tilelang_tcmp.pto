// Test that ExpandTileOp + InlineLibCall + FoldTileBufIntrinsics pipeline
// expands pto.tcmp via the PTODSL TileLib template
//
// Pipeline: ExpandTileOp -> InlineLibCall -> FoldTileBufIntrinsics
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-tile-op-expand %s -o - 2>/dev/null | FileCheck %s

// After the full tile-op-expand path on the VPTO backend, the original
// Tile op should be lowered to vector-style VPTO IR.

// CHECK-LABEL: func.func @TCMP
// CHECK-NOT: pto.tcmp ins
// CHECK: pto.vecscope
// CHECK: pto.vlds
// CHECK: pto.vcmp
// CHECK: pto.pbitcast
// CHECK: pto.pdintlv_b8
// CHECK: pto.psts
// The 64B dst valid row is wider than the 16B PK predicate-store span, so the
// tail bytes [16, 64) are zero-filled to honor the packed-mask contract
// (packed bits, LSB-first, then zero padding up to the valid column count).
// The fill stores one all-inactive 16B PK payload per chunk.
// CHECK: pto.pset_b8 "PAT_ALLF"
// CHECK: scf.for %{{[a-z0-9]+}} = %c16_i16 to %c64_i16 step %c16_i16
// CHECK: pto.psts

// f16 with 32-element valid rows: the packed path stores one 16B PK predicate
// payload per 32B dst row, so the row tail [16, 32) must also be zero-filled.
// CHECK-LABEL: func.func @TCMP_F16
// CHECK-NOT: pto.tcmp ins
// CHECK: pto.vecscope
// CHECK: pto.vcmp
// CHECK: pto.pbitcast
// CHECK: pto.psts
// CHECK: [[TAIL_MASK:%[a-z0-9_]+]] = pto.pset_b8 "PAT_ALLF"
// CHECK-NEXT: pto.mem_bar "VLD_VST"
// CHECK-NEXT: [[TAIL_BASE:%[a-z0-9_]+]] = pto.addptr %{{[a-z0-9]+}}, %c16 : <i8, ub> -> <i8, ub>
// CHECK-NEXT: {{.*}}scf.for {{.*}}iter_args([[TAIL_PTR:%[a-z0-9_]+]] = [[TAIL_BASE]])
// CHECK-NEXT: {{.*}}pto.psts [[TAIL_MASK]], [[TAIL_PTR]][%c32], "PK"
// CHECK-NEXT: scf.yield

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @TCMP() {
    %a = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %b = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %tile_buf = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=i8, rows=16, cols=64, v_row=16, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>

    pto.tcmp ins(%a, %b {cmpMode = #pto<cmp gt>} : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                              blayout=row_major, slayout=none_box, fractal=512, pad=0>,
                          !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64,
                              blayout=row_major, slayout=none_box, fractal=512, pad=0>)
             outs(%tile_buf : !pto.tile_buf<loc=vec, dtype=i8, rows=16, cols=64, v_row=16, v_col=64,
                                   blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }

  func.func @TCMP_F16() {
    %a = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f16, rows=8, cols=32, v_row=8, v_col=32,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %b = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f16, rows=8, cols=32, v_row=8, v_col=32,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %tile_buf = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=i8, rows=8, cols=32, v_row=8, v_col=32,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>

    pto.tcmp ins(%a, %b {cmpMode = #pto<cmp gt>} : !pto.tile_buf<loc=vec, dtype=f16, rows=8, cols=32, v_row=8, v_col=32,
                              blayout=row_major, slayout=none_box, fractal=512, pad=0>,
                          !pto.tile_buf<loc=vec, dtype=f16, rows=8, cols=32, v_row=8, v_col=32,
                              blayout=row_major, slayout=none_box, fractal=512, pad=0>)
             outs(%tile_buf : !pto.tile_buf<loc=vec, dtype=i8, rows=8, cols=32, v_row=8, v_col=32,
                                   blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}
