    %c200 = arith.constant 1 : index
    %c3_i64 = arith.constant 3 : i64
    %c3_i32 = arith.constant 3 : i32
    %c31_i32 = arith.constant 31 : i32
    %r = arith.remsi %s, %c3_i64 : i64
    %t = arith.trunci %r : i64 to i32
    %sh = arith.shrsi %t, %c31_i32 : i32
    %corr = arith.andi %sh, %c3_i32 : i32
    %corrKe = arith.extui %corr : i32 to i64
    %sum = arith.addi %corrKe, %r : i64
    %off = arith.index_cast %sum : i64 to index
    %bound = arith.minui %n, %c1 : index
    pto.vecscope {
      %m = pto.pset_b32 "PAT_ALL" : !mb32
      scf.for %i = %c0 to %bound step %c1 {
        pto.vsts %v0, %p[%off], %m : !v64xf32, !pf32ub, index, !mb32
        %v = pto.vlds %p[%c200] : !pf32ub, index -> !v64xf32
      }
    }
    return
  }
}
