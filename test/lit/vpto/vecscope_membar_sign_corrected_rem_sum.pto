// RUN: pto-test-opt --pto-insert-vecscope-membar %s | FileCheck %s
// RUN: pto-test-opt --pto-insert-vecscope-membar --pto-insert-vecscope-membar %s | FileCheck %s

!mb32 = !pto.mask<b32>
!pf32ub = !pto.ptr<f32, ub>
!v64xf32 = !pto.vreg<64xf32>

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {

// CHECK-LABEL: func.func @rem_sum_stage_disjoint(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @rem_sum_stage_disjoint(%n: index, %s: i64, %v0: !v64xf32) {
    %zero = arith.constant 0 : i64
    %p = pto.castptr %zero : i64 -> !pf32ub
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c200 = arith.constant 200 : index
    %c3_i64 = arith.constant 3 : i64
    %c3_i32 = arith.constant 3 : i32
    %c31_i32 = arith.constant 31 : i32
    %c64_i32 = arith.constant 64 : i32
    %c64_i64 = arith.constant 64 : i64
    %r = arith.remsi %s, %c3_i64 : i64
    %t = arith.trunci %r : i64 to i32
    %sh = arith.shrsi %t, %c31_i32 : i32
    %corr = arith.andi %sh, %c3_i32 : i32
    %corrK = arith.muli %corr, %c64_i32 : i32
    %rK = arith.muli %r, %c64_i64 : i64
    %corrKe = arith.extui %corrK : i32 to i64
    %sum = arith.addi %corrKe, %rK : i64
    %off = arith.index_cast %sum : i64 to index
    %bound = arith.minui %n, %c1 : index
    pto.vecscope {
      %m = pto.pset_b32 "PAT_ALL" : !mb32
      scf.for %i = %c0 to %bound step %c1 {
        pto.vsts %v0, %p[%off], %m : !v64xf32, !pf32ub, index, !mb32
        %v = pto.vlds %p[%c200] : !pf32ub, index -> !v64xf32
      }
    }
    return
  }

// CHECK-LABEL: func.func @rem_sum_real_overlap(
// CHECK: scf.for
// CHECK: pto.vsts
// CHECK-NEXT: pto.mem_bar "VST_VLD"
// CHECK-NOT: pto.mem_bar
// CHECK: return
  func.func @rem_sum_real_overlap(%n: index, %s: i64, %v0: !v64xf32) {
    %zero = arith.constant 0 : i64
    %p = pto.castptr %zero : i64 -> !pf32ub
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %c3_i64 = arith.constant 3 : i64
    %c3_i32 = arith.constant 3 : i32
    %c31_i32 = arith.constant 31 : i32
    %c64_i32 = arith.constant 64 : i32
    %c64_i64 = arith.constant 64 : i64
    %r = arith.remsi %s, %c3_i64 : i64
    %t = arith.trunci %r : i64 to i32
    %sh = arith.shrsi %t, %c31_i32 : i32
    %corr = arith.andi %sh, %c3_i32 : i32
    %corrK = arith.muli %corr, %c64_i32 : i32
    %rK = arith.muli %r, %c64_i64 : i64
    %corrKe = arith.extui %corrK : i32 to i64
    %sum = arith.addi %corrKe, %rK : i64
    %off = arith.index_cast %sum : i64 to index
    %bound = arith.minui %n, %c1 : index
    pto.vecscope {
      %m = pto.pset_b32 "PAT_ALL" : !mb32
      scf.for %i = %c0 to %bound step %c1 {
        pto.vsts %v0, %p[%off], %m : !v64xf32, !pf32ub, index, !mb32
        %v = pto.vlds %p[%c16] : !pf32ub, index -> !v64xf32
      }
    }
    return
  }

// CHECK-LABEL: func.func @rem_sum_wrong_mask_not_matched(
// CHECK: scf.for
// CHECK: pto.vsts
// CHECK-NEXT: pto.mem_bar "VST_VLD"
// CHECK-NOT: pto.mem_bar
// CHECK: return
  func.func @rem_sum_wrong_mask_not_matched(%n: index, %s: i64, %v0: !v64xf32) {
    %zero = arith.constant 0 : i64
    %p = pto.castptr %zero : i64 -> !pf32ub
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c200 = arith.constant 200 : index
    %c3_i64 = arith.constant 3 : i64
    %c1_i32 = arith.constant 1 : i32
    %c31_i32 = arith.constant 31 : i32
    %c64_i32 = arith.constant 64 : i32
    %c64_i64 = arith.constant 64 : i64
    %r = arith.remsi %s, %c3_i64 : i64
    %t = arith.trunci %r : i64 to i32
    %sh = arith.shrsi %t, %c31_i32 : i32
    %corr = arith.andi %sh, %c1_i32 : i32
    %corrK = arith.muli %corr, %c64_i32 : i32
    %rK = arith.muli %r, %c64_i64 : i64
    %corrKe = arith.extui %corrK : i32 to i64
    %sum = arith.addi %corrKe, %rK : i64
    %off = arith.index_cast %sum : i64 to index
    %bound = arith.minui %n, %c1 : index
    pto.vecscope {
      %m = pto.pset_b32 "PAT_ALL" : !mb32
      scf.for %i = %c0 to %bound step %c1 {
        pto.vsts %v0, %p[%off], %m : !v64xf32, !pf32ub, index, !mb32
        %v = pto.vlds %p[%c200] : !pf32ub, index -> !v64xf32
      }
    }
    return
  }

// CHECK-LABEL: func.func @wide_divisor_overlap(
// CHECK: pto.vsts
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: pto.vlds
// CHECK: return
func.func @wide_divisor_overlap(%n: index, %s: i128, %v0: !v64xf32) {
    %zero = arith.constant 0 : i64
    %p = pto.castptr %zero : i64 -> !pf32ub
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c200 = arith.constant 256 : index
    %c3_i128 = arith.constant 18446744073709551619 : i128
    %c3_i32 = arith.constant 3 : i32
    %c31_i32 = arith.constant 31 : i32
    %c64_i32 = arith.constant 64 : i32
    %c64_i128 = arith.constant 64 : i128
    %r = arith.remsi %s, %c3_i128 : i128
    %t = arith.trunci %r : i128 to i32
    %sh = arith.shrsi %t, %c31_i32 : i32
    %corr = arith.andi %sh, %c3_i32 : i32
    %corrK = arith.muli %corr, %c64_i32 : i32
    %rK = arith.muli %r, %c64_i128 : i128
    %corrKe = arith.extui %corrK : i32 to i128
    %sum = arith.addi %corrKe, %rK : i128
    %off = arith.index_cast %sum : i128 to index
    %bound = arith.minui %n, %c1 : index
    pto.vecscope {
      %m = pto.pset_b32 "PAT_ALL" : !mb32
      scf.for %i = %c0 to %bound step %c1 {
        pto.vsts %v0, %p[%off], %m : !v64xf32, !pf32ub, index, !mb32
        %v = pto.vlds %p[%c200] : !pf32ub, index -> !v64xf32
      }
    }
    return
  }

// CHECK-LABEL: func.func @rem_sum_unit_scale_disjoint(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @rem_sum_unit_scale_disjoint(%n: index, %s: i64, %v0: !v64xf32) {
    %zero = arith.constant 0 : i64
    %p = pto.castptr %zero : i64 -> !pf32ub
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c200 = arith.constant 66 : index
    %c3_i64 = arith.constant 3 : i64
    %c3_i32 = arith.constant 3 : i32
    %c31_i32 = arith.constant 31 : i32
    %r = arith.remsi %s, %c3_i64 : i64
    %t = arith.trunci %r : i64 to i32
    %sh = arith.shrsi %t, %c31_i32 : i32
    %corr = arith.andi %sh, %c3_i32 : i32
    %corrKe = arith.extui %corr : i32 to i64
    %sum = arith.addi %corrKe, %r : i64
    %off = arith.index_cast %sum : i64 to index
    %bound = arith.minui %n, %c1 : index
    pto.vecscope {
      %m = pto.pset_b32 "PAT_ALL" : !mb32
      scf.for %i = %c0 to %bound step %c1 {
        pto.vsts %v0, %p[%off], %m : !v64xf32, !pf32ub, index, !mb32
        %v = pto.vlds %p[%c200] : !pf32ub, index -> !v64xf32
      }
    }
    return
  }

// CHECK-LABEL: func.func @rem_sum_reassociated_disjoint(
// CHECK-NOT: pto.mem_bar
// CHECK: return
// CHECK-NOT: pto.mem_bar
  func.func @rem_sum_reassociated_disjoint(%n: index, %s: i64, %v0: !v64xf32) {
    %zero = arith.constant 0 : i64
    %p = pto.castptr %zero : i64 -> !pf32ub
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c200 = arith.constant 66 : index
    %c3_i64 = arith.constant 3 : i64
    %c3_i32 = arith.constant 3 : i32
    %c31_i32 = arith.constant 31 : i32
    %r = arith.remsi %s, %c3_i64 : i64
    %t = arith.trunci %r : i64 to i32
    %sh = arith.shrsi %t, %c31_i32 : i32
    %corr = arith.andi %sh, %c3_i32 : i32
    %corrKe = arith.extui %corr : i32 to i64
    %bound = arith.minui %n, %c1 : index
    pto.vecscope {
      %m = pto.pset_b32 "PAT_ALL" : !mb32
      scf.for %i = %c0 to %bound step %c1 {
        %ci = arith.index_cast %corrKe : i64 to index
        %ri = arith.index_cast %r : i64 to index
        %factor = arith.constant 1 : index
        %scaled = arith.muli %ci, %factor : index
        %head = arith.addi %i, %scaled : index
        %off = arith.addi %head, %ri : index
        pto.vsts %v0, %p[%off], %m : !v64xf32, !pf32ub, index, !mb32
        %v = pto.vlds %p[%c200] : !pf32ub, index -> !v64xf32
      }
    }
    return
  }

// CHECK-LABEL: func.func @rem_sum_unequal_coeff_overlap(
// CHECK: scf.for
// CHECK: pto.vsts
// CHECK: pto.mem_bar "VST_VLD"
// CHECK: pto.vlds
// CHECK: return
  func.func @rem_sum_unequal_coeff_overlap(%n: index, %s: i64, %v0: !v64xf32) {
    %zero = arith.constant 0 : i64
    %p = pto.castptr %zero : i64 -> !pf32ub
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c200 = arith.constant 66 : index
    %c3_i64 = arith.constant 3 : i64
    %c3_i32 = arith.constant 3 : i32
    %c31_i32 = arith.constant 31 : i32
    %r = arith.remsi %s, %c3_i64 : i64
    %t = arith.trunci %r : i64 to i32
    %sh = arith.shrsi %t, %c31_i32 : i32
    %corr = arith.andi %sh, %c3_i32 : i32
    %corrKe = arith.extui %corr : i32 to i64
    %bound = arith.minui %n, %c1 : index
    pto.vecscope {
      %m = pto.pset_b32 "PAT_ALL" : !mb32
      scf.for %i = %c0 to %bound step %c1 {
        %ci = arith.index_cast %corrKe : i64 to index
        %ri = arith.index_cast %r : i64 to index
        %factor = arith.constant 3 : index
        %scaled = arith.muli %ci, %factor : index
        %head = arith.addi %i, %scaled : index
        %off = arith.addi %head, %ri : index
        pto.vsts %v0, %p[%off], %m : !v64xf32, !pf32ub, index, !mb32
        %v = pto.vlds %p[%c200] : !pf32ub, index -> !v64xf32
