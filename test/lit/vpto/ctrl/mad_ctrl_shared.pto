// Three identical plain MADs in one block share one get_ctrl, one
// configuration write, and a single deferred restore at the block end.
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @ctrl_guard_shared(
      %lhs: !pto.ptr<f32, l0a>,
      %rhs: !pto.ptr<f32, l0b>,
      %dst: !pto.ptr<f32, l0c>) attributes {pto.kernel} {
    %c16 = arith.constant 16 : i64
    pto.mad %lhs, %rhs, %dst, %c16, %c16, %c16
      : !pto.ptr<f32, l0a>, !pto.ptr<f32, l0b>, !pto.ptr<f32, l0c>, i64, i64, i64
    pto.mad %lhs, %rhs, %dst, %c16, %c16, %c16
      : !pto.ptr<f32, l0a>, !pto.ptr<f32, l0b>, !pto.ptr<f32, l0c>, i64, i64, i64
    pto.mad %lhs, %rhs, %dst, %c16, %c16, %c16
      : !pto.ptr<f32, l0a>, !pto.ptr<f32, l0b>, !pto.ptr<f32, l0c>, i64, i64, i64
    return
  }
}

// CHECK-LABEL: func.func @ctrl_guard_shared(
// Exactly one CTRL entry read for the whole run of guards.
// CHECK-COUNT-1: %[[ENTRY:.*]] = pto.get_ctrl : i64
// Bit updates only for the controlled bits 45/46/47/51, built once.
// CHECK: pto.sbitset0
// CHECK: pto.sbitset0
// CHECK: pto.sbitset0
// CHECK: pto.sbitset0
// One configuration write.
// CHECK-COUNT-1: pto.set_ctrl %[[ACTIVE:.*]] : i64
// All three raw MADs run under the shared active state.
// CHECK: pto.mad_raw
// CHECK: pto.mad_raw
// CHECK: pto.mad_raw
// Single deferred restore to the entry logical state at the block end.
// CHECK: pto.set_ctrl %[[ENTRY]] : i64
// CHECK: return
//
// No guard survives into emission IR.
// CHECK-NOT: ctrl_state_guard
