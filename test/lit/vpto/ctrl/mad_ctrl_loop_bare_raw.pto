// A bare pto.mad_raw inside a loop body manages CTRL itself, so a MAD
// configuration must NOT be hoisted into the loop preheader across it: the
// loop is CTRL-dirty and each iteration configures and restores around its
// own guarded mad only.
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @ctrl_guard_loop_bare_raw(
      %lhs: !pto.ptr<f32, l0a>,
      %rhs: !pto.ptr<f32, l0b>,
      %dst: !pto.ptr<f32, l0c>) attributes {pto.kernel} {
    %c16 = arith.constant 16 : i64
    %c0 = arith.constant 0 : index
    %c8 = arith.constant 8 : index
    %c1 = arith.constant 1 : index
    scf.for %iv = %c0 to %c8 step %c1 {
      pto.mad %lhs, %rhs, %dst, %c16, %c16, %c16
        : !pto.ptr<f32, l0a>, !pto.ptr<f32, l0b>, !pto.ptr<f32, l0c>, i64, i64, i64
      %xt = arith.constant 16 : i64
      pto.mad_raw %lhs, %rhs, %dst, %xt
        : !pto.ptr<f32, l0a>, !pto.ptr<f32, l0b>, !pto.ptr<f32, l0c>, i64
    }
    return
  }
}

// CHECK-LABEL: func.func @ctrl_guard_loop_bare_raw(
// Nothing is hoisted above the loop.
// CHECK-NOT: pto.set_ctrl
// CHECK: scf.for
// Each iteration: configure, guarded mad, restore before the bare raw MAD,
// which then runs under the entry state.
// CHECK: pto.get_ctrl
// CHECK: pto.set_ctrl
// CHECK: pto.mad_raw
// CHECK: pto.set_ctrl
// CHECK: pto.mad_raw
// CHECK: return
