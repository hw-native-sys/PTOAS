// Two different requirements in one candidate interval switch directly
// between active states without an intermediate restore-to-entry write.
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @ctrl_guard_switch(
      %lhs: !pto.ptr<f32, l0a>,
      %rhs: !pto.ptr<f32, l0b>,
      %dst: !pto.ptr<f32, l0c>,
      %lhs_hif8: !pto.ptr<!pto.hif8, l0a>,
      %rhs_hif8: !pto.ptr<!pto.hif8, l0b>) attributes {pto.kernel} {
    %c16 = arith.constant 16 : i64
    // Plain f32: C = bit45|46|47|51, R = 0.
    pto.mad %lhs, %rhs, %dst, %c16, %c16, %c16
      : !pto.ptr<f32, l0a>, !pto.ptr<f32, l0b>, !pto.ptr<f32, l0c>, i64, i64, i64
    // HiF8: C = bit45|46|47|51, R = bit45.
    pto.mad %lhs_hif8, %rhs_hif8, %dst, %c16, %c16, %c16
      : !pto.ptr<!pto.hif8, l0a>, !pto.ptr<!pto.hif8, l0b>, !pto.ptr<f32, l0c>, i64, i64, i64
    return
  }
}

// CHECK-LABEL: func.func @ctrl_guard_switch(
// One shared logical entry read.
// CHECK-COUNT-1: %[[ENTRY:.*]] = pto.get_ctrl : i64
// First active state (all four controlled bits cleared).
// CHECK: pto.sbitset0
// CHECK: pto.sbitset0
// CHECK: pto.sbitset0
// CHECK: pto.sbitset0
// CHECK: pto.set_ctrl %[[A0:.*]] : i64
// CHECK: pto.mad_raw
// Second requirement switches bit45 to one; no restore-to-entry between them.
// CHECK: pto.sbitset1
// CHECK: pto.set_ctrl %[[A1:.*]] : i64
// CHECK: pto.mad_raw {{.*}}!pto.ptr<!pto.hif8, l0a>, !pto.ptr<!pto.hif8, l0b>
// One deferred restore at the block end.
// CHECK: pto.set_ctrl %[[ENTRY]] : i64
//
// CHECK-NOT: ctrl_state_guard
