// Nested statically positive loops (M-tile around K-tile) with one shared
// requirement hoist a single configuration to the outermost loop entry;
// neither loop body contains any CTRL access, and one restore follows the
// outermost loop.
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @ctrl_guard_nested_loops(
      %lhs: !pto.ptr<f32, l0a>,
      %rhs: !pto.ptr<f32, l0b>,
      %dst: !pto.ptr<f32, l0c>) attributes {pto.kernel} {
    %c16 = arith.constant 16 : i64
    %c0 = arith.constant 0 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %c1 = arith.constant 1 : index
    scf.for %m = %c0 to %c4 step %c1 {
      scf.for %k = %c0 to %c8 step %c1 {
        pto.mad %lhs, %rhs, %dst, %c16, %c16, %c16
          : !pto.ptr<f32, l0a>, !pto.ptr<f32, l0b>, !pto.ptr<f32, l0c>, i64, i64, i64
        pto.mad %lhs, %rhs, %dst, %c16, %c16, %c16
          : !pto.ptr<f32, l0a>, !pto.ptr<f32, l0b>, !pto.ptr<f32, l0c>, i64, i64, i64
      }
    }
    return
  }
}

// CHECK-LABEL: func.func @ctrl_guard_nested_loops(
// One configuration before the outermost loop.
// CHECK: %[[ENTRY:.*]] = pto.get_ctrl : i64
// CHECK: pto.sbitset0
// CHECK: pto.set_ctrl %[[ACTIVE:.*]] : i64
// CHECK: scf.for %[[M:.*]] =
// CHECK: scf.for %[[K:.*]] =
// Raw MADs inside the inner loop; no CTRL access in either loop body.
// CHECK: pto.mad_raw
// CHECK: pto.mad_raw
// CHECK-NOT: pto.get_ctrl
// CHECK-NOT: pto.set_ctrl
// CHECK-NOT: pto.sbitset0
// Single restore after the outermost loop.
// CHECK: pto.set_ctrl %[[ENTRY]] : i64
// CHECK: return
//
// CHECK-NOT: ctrl_state_guard
