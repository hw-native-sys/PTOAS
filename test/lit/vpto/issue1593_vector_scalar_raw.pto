// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-vecscope-mem-bar %s -o - 2>/dev/null | FileCheck %s

// Regression test for issue #1593: a vector store followed by a scalar UB
// load requires the mixed execution-unit barrier VST_LD.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @issue1593_vector_scalar_raw() {
    %c0 = arith.constant 0 : index
    %c152 = arith.constant 152 : index
    %c0i64 = arith.constant 0 : i64
    %ub = pto.castptr %c0i64 : i64 -> !pto.ptr<f32, ub>
    pto.vecscope {
      %mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %v0 = pto.vlds %ub[%c0] : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>
      pto.vsts %v0, %ub[%c152], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
      %s0 = pto.load %ub[%c152] : !pto.ptr<f32, ub>, index -> f32
      %v1 = pto.vdup %s0, %mask : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      pto.vsts %v1, %ub[%c0], %mask : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
    }
    return
  }
}

// CHECK-LABEL: func.func @issue1593_vector_scalar_raw
// CHECK: pto.vsts
// CHECK-NEXT: pto.mem_bar "VST_LD"
// CHECK-NEXT: %{{.*}} = pto.load
