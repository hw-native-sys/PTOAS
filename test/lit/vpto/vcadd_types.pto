      %out_mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %src = pto.vlds %input[%c0] : !pto.ptr<i32, ub>, index -> !pto.vreg<64xi32>
      %sum = pto.vcadd %src, %mask : !pto.vreg<64xi32>, !pto.mask<b32> -> !pto.vreg<64xi32>
      pto.vsts %sum, %output[%c0], %out_mask
          : !pto.vreg<64xi32>, !pto.ptr<i32, ub>, index, !pto.mask<b32>
