      %out_mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %src = pto.vlds %input[%c0] : !pto.ptr<ui32, ub>, index -> !pto.vreg<64xui32>
      %sum = pto.vcadd %src, %mask : !pto.vreg<64xui32>, !pto.mask<b32> -> !pto.vreg<64xui32>
      pto.vsts %sum, %output[%c0], %out_mask
