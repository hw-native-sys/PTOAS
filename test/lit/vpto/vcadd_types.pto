// RUN: pto-test-opt %s | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s

module {

  // CHECK-LABEL: func.func @vcadd_i16(
  // CHECK: pto.vcadd %{{.*}}, %{{.*}} : !pto.vreg<128xi16>, !pto.mask<b16> -> !pto.vreg<64xi32>
  func.func @vcadd_i16(%input: !pto.ptr<i16, ub>, %output: !pto.ptr<i32, ub>) {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %mask = pto.pset_b16 "PAT_ALL" : !pto.mask<b16>
      %out_mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %src = pto.vlds %input[%c0] : !pto.ptr<i16, ub>, index -> !pto.vreg<128xi16>
      %sum = pto.vcadd %src, %mask : !pto.vreg<128xi16>, !pto.mask<b16> -> !pto.vreg<64xi32>
      pto.vsts %sum, %output[%c0], %out_mask
          : !pto.vreg<64xi32>, !pto.ptr<i32, ub>, index, !pto.mask<b32>
    }
    return
  }

  // CHECK-LABEL: func.func @vcadd_si16(
  // CHECK: pto.vcadd %{{.*}}, %{{.*}} : !pto.vreg<128xsi16>, !pto.mask<b16> -> !pto.vreg<64xsi32>
  func.func @vcadd_si16(%input: !pto.ptr<si16, ub>, %output: !pto.ptr<si32, ub>) {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %mask = pto.pset_b16 "PAT_ALL" : !pto.mask<b16>
      %out_mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %src = pto.vlds %input[%c0] : !pto.ptr<si16, ub>, index -> !pto.vreg<128xsi16>
      %sum = pto.vcadd %src, %mask : !pto.vreg<128xsi16>, !pto.mask<b16> -> !pto.vreg<64xsi32>
      pto.vsts %sum, %output[%c0], %out_mask
          : !pto.vreg<64xsi32>, !pto.ptr<si32, ub>, index, !pto.mask<b32>
    }
    return
  }

  // CHECK-LABEL: func.func @vcadd_ui16(
  // CHECK: pto.vcadd %{{.*}}, %{{.*}} : !pto.vreg<128xui16>, !pto.mask<b16> -> !pto.vreg<64xui32>
