    pto.vecscope {
      %mask = pto.pset_b16 "PAT_ALL" : !pto.mask<b16>
      %out_mask = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %src = pto.vlds %input[%c0] : !pto.ptr<ui16, ub>, index -> !pto.vreg<128xui16>
      %sum = pto.vcadd %src, %mask : !pto.vreg<128xui16>, !pto.mask<b16> -> !pto.vreg<64xui32>
      pto.vsts %sum, %output[%c0], %out_mask
          : !pto.vreg<64xui32>, !pto.ptr<ui32, ub>, index, !pto.mask<b32>
    }
    return
