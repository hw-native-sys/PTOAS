// RUN: ptoas --pto-arch=a5 --emit-pto-ir %s -o - | FileCheck %s --check-prefix=IR
// RUN: ptoas --pto-arch=a5 --pto-level=level2 %s -o - | FileCheck %s --check-prefix=CPP
// RUN: ptoas --pto-arch=a5 --pto-level=level2 %S/../../samples/MatmulMxLowPrecision/matmul_mx_low_precision-pto.pto -o - | FileCheck %s --check-prefix=SAMPLE

module attributes {pto.target_arch = "a5"} {
  func.func @b_nn_tail(%ptr: !pto.ptr<!pto.f8E8M0, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c63 = arith.constant 63 : index
    %view = pto.make_tensor_view %ptr, shape = [%c4, %c63], strides = [%c63, %c1] {layout = #pto.layout<mx_b_nn>} : !pto.tensor_view<?x?x!pto.f8E8M0>
    %part = pto.partition_view %view, offsets = [%c0, %c0], sizes = [%c4, %c63] : !pto.tensor_view<?x?x!pto.f8E8M0> -> !pto.partition_tensor_view<4x63x!pto.f8E8M0>
    %tile = pto.alloc_tile : !pto.tile_buf<mat, 4x64x!pto.f8E8M0, valid=4x63, blayout=col_major, slayout=col_major, fractal=32>
    pto.tload ins(%part : !pto.partition_tensor_view<4x63x!pto.f8E8M0>) outs(%tile : !pto.tile_buf<mat, 4x64x!pto.f8E8M0, valid=4x63, blayout=col_major, slayout=col_major, fractal=32>)
    return
  }
  func.func @a_zz_tail(%ptr: !pto.ptr<!pto.f8E8M0, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c17 = arith.constant 17 : index
    %view = pto.make_tensor_view %ptr, shape = [%c17, %c4], strides = [%c4, %c1] {layout = #pto.layout<mx_a_zz>} : !pto.tensor_view<?x?x!pto.f8E8M0>
    %part = pto.partition_view %view, offsets = [%c0, %c0], sizes = [%c17, %c4] : !pto.tensor_view<?x?x!pto.f8E8M0> -> !pto.partition_tensor_view<17x4x!pto.f8E8M0>
    %tile = pto.alloc_tile : !pto.tile_buf<mat, 32x4x!pto.f8E8M0, valid=17x4, blayout=row_major, slayout=row_major, fractal=32>
    pto.tload ins(%part : !pto.partition_tensor_view<17x4x!pto.f8E8M0>) outs(%tile : !pto.tile_buf<mat, 32x4x!pto.f8E8M0, valid=17x4, blayout=row_major, slayout=row_major, fractal=32>)
    return
  }
  func.func @a_nd_tail(%ptr: !pto.ptr<!pto.f8E8M0, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c17 = arith.constant 17 : index
    %view = pto.make_tensor_view %ptr, shape = [%c17, %c4], strides = [%c4, %c1] {layout = #pto.layout<mx_a_nd>} : !pto.tensor_view<?x?x!pto.f8E8M0>
    %part = pto.partition_view %view, offsets = [%c0, %c0], sizes = [%c17, %c4] : !pto.tensor_view<?x?x!pto.f8E8M0> -> !pto.partition_tensor_view<17x4x!pto.f8E8M0>
    %tile = pto.alloc_tile : !pto.tile_buf<mat, 32x4x!pto.f8E8M0, valid=17x4, blayout=row_major, slayout=row_major, fractal=32>
    pto.tload ins(%part : !pto.partition_tensor_view<17x4x!pto.f8E8M0>) outs(%tile : !pto.tile_buf<mat, 32x4x!pto.f8E8M0, valid=17x4, blayout=row_major, slayout=row_major, fractal=32>)
    return
  }
  func.func @dynamic_b_nn_tail(%ptr: !pto.ptr<!pto.f8E8M0, gm>, %cols: index) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %view = pto.make_tensor_view %ptr, shape = [%c4, %cols], strides = [%cols, %c1] {layout = #pto.layout<mx_b_nn>} : !pto.tensor_view<?x?x!pto.f8E8M0>
    %part = pto.partition_view %view, offsets = [%c0, %c0], sizes = [%c4, %cols] : !pto.tensor_view<?x?x!pto.f8E8M0> -> !pto.partition_tensor_view<4x?x!pto.f8E8M0>
    %tile = pto.alloc_tile : !pto.tile_buf<mat, 4x64x!pto.f8E8M0, valid=4x63, blayout=col_major, slayout=col_major, fractal=32>
    pto.tload ins(%part : !pto.partition_tensor_view<4x?x!pto.f8E8M0>) outs(%tile : !pto.tile_buf<mat, 4x64x!pto.f8E8M0, valid=4x63, blayout=col_major, slayout=col_major, fractal=32>)
    return
  }
}

// IR-LABEL: func.func @b_nn_tail
// IR: !pto.partition_tensor_view<4x63x!pto.f8E8M0, #pto.layout<mx_b_nn>>
// IR: valid=4x63
// IR-LABEL: func.func @a_zz_tail
// IR: !pto.partition_tensor_view<17x4x!pto.f8E8M0, #pto.layout<mx_a_zz>>
// IR: valid=17x4
// CPP-LABEL: b_nn_tail(
// CPP: TileShape2D<float8_e8m0_t, 4, 64, pto::Layout::MX_B_NN>
// CPP: BaseShape2D<float8_e8m0_t, 4, 64, pto::Layout::MX_B_NN>
// CPP: TLOAD(
// CPP-LABEL: a_zz_tail(
// CPP: TileShape2D<float8_e8m0_t, 32, 4, pto::Layout::MX_A_ZZ>
// CPP: BaseShape2D<float8_e8m0_t, 32, 4, pto::Layout::MX_A_ZZ>
// CPP: TLOAD(
// CPP-LABEL: a_nd_tail(
// CPP: TileShape2D<float8_e8m0_t, 17, 4, pto::Layout::MX_A_ND>
// CPP: TLOAD(
// CPP-LABEL: dynamic_b_nn_tail(
// CPP: const int64_t [[BLOCK:v[0-9]+]] = 16;
// CPP: {{.*}} / [[BLOCK]]
// CPP: {{.*}} % [[BLOCK]]
// CPP: {{.*}} !=
// CPP: TileShape2D<float8_e8m0_t, -1, -1, pto::Layout::MX_B_NN>
// CPP: TLOAD(
// SAMPLE: TileShape2D<float8_e8m0_t, 4, 64, pto::Layout::MX_B_NN>
// SAMPLE: BaseShape2D<float8_e8m0_t, 4, 64, pto::Layout::MX_B_NN>
// SAMPLE: TLOAD(
// SAMPLE: TMATMUL_MX(
