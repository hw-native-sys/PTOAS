// RUN: not ptoas --pto-arch=linx %s -o - 2>&1 | FileCheck %s
module attributes {pto.target_arch = "linx"} {
  func.func @bad(%in: !pto.linx.partition_tensor_view<16x128xf32>) {
    %t = pto.linx.alloc_tile : !pto.linx.tile_buf<local, 8x128xf32>
    pto.linx.tload ins(%in : !pto.linx.partition_tensor_view<16x128xf32>) outs(%t : !pto.linx.tile_buf<local, 8x128xf32>)
    return
  }
}
// CHECK: requires matching Linx tile and GM view shapes
