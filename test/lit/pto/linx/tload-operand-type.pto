// RUN: not ptoas --pto-arch=linx %s -o - 2>&1 | FileCheck %s
!T = !pto.linx.tile_buf<local, 16x128xf32>
module attributes {pto.target_arch = "linx"} {
  func.func @bad() {
    %a = pto.linx.alloc_tile : !T
    %b = pto.linx.alloc_tile : !T
    "pto.linx.tload"(%a, %b) : (!T, !T) -> ()
    return
  }
}
// CHECK: 'pto.linx.tload' op operand #0 must be Linx static two-dimensional external memory view
