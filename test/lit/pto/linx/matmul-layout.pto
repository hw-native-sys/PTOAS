// RUN: not ptoas --pto-arch=linx %s -o - 2>&1 | FileCheck %s
module attributes {pto.target_arch = "linx"} {
  func.func @bad() {
    %a = pto.alloc_tile : !pto.tile_buf<local, 16x8xf32, blayout=row_major>
    %b = pto.alloc_tile : !pto.tile_buf<local, 8x8xf32, blayout=n8>
    %d = pto.alloc_tile : !pto.tile_buf<local, 16x8xf32, blayout=m16>
    pto.tmatmul ins(%a, %b : !pto.tile_buf<local, 16x8xf32, blayout=row_major>, !pto.tile_buf<local, 8x8xf32, blayout=n8>) outs(%d : !pto.tile_buf<local, 16x8xf32, blayout=m16>)
    return
  }
}
// CHECK: requires lhs/dst with matching m16 or m32 layout and rhs with n8 layout
