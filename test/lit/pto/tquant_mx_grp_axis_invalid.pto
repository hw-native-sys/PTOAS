  pto.tquant.mx ins(%src : !pto.tile_buf<vec, 16x32xf32>) outs(%dst, %exp, %max, %scaling : !pto.tile_buf<vec, 16x32xi8>, !pto.tile_buf<vec, 16x1xui8>, !pto.tile_buf<vec, 16x1xf32>, !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=2, v_row=16, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {quant_type = #pto<quant_type MXFP8>}
