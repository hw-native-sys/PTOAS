// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync \
// RUN:   --emit-pto-ir %s 2>&1 | FileCheck %s --check-prefix=INSERT

module attributes {pto.target_arch = "a3"} {
  func.func @ptr_roundtrip_scalar_sync(%dst: !pto.ptr<ui32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %addr0 = arith.constant 0 : i64

    %dst_view = pto.make_tensor_view %dst,
      shape = [%c1, %c32],
      strides = [%c32, %c1]
      : !pto.tensor_view<1x32xui32>
    %dst_part = pto.partition_view %dst_view,
      offsets = [%c0, %c0],
      sizes = [%c1, %c32]
      : !pto.tensor_view<1x32xui32>
     -> !pto.partition_tensor_view<1x32xui32>

    %tile = pto.alloc_tile addr = %addr0 : !pto.tile_buf<vec, 1x32xui32>
    pto.tstore ins(%tile : !pto.tile_buf<vec, 1x32xui32>)
               outs(%dst_part : !pto.partition_tensor_view<1x32xui32>)

    %raw_addr = pto.ptrtoint %dst : !pto.ptr<ui32> -> i64
    %roundtrip = pto.inttoptr %raw_addr : i64 -> !pto.ptr<ui32>
    %value = pto.load_scalar %roundtrip[%c0] : !pto.ptr<ui32> -> ui32
    pto.store_scalar %value, %roundtrip[%c0] : !pto.ptr<ui32>, ui32
    return
  }
}

// INSERT-LABEL: func.func @ptr_roundtrip_scalar_sync
// INSERT: pto.tstore
// INSERT: pto.set_flag[<PIPE_MTE3>, <PIPE_S>,
// INSERT: pto.wait_flag[<PIPE_MTE3>, <PIPE_S>,
// INSERT-NEXT: pto.load_scalar
