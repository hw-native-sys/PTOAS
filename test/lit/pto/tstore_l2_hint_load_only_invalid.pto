// RUN: not ptoas --pto-arch=a5 --emit-pto-ir %s 2>&1 | FileCheck %s
// CHECK: not_alloc_keep

module {
  func.func private @invalid(%src: !pto.tile_buf<vec, 16x16xf32>, %dst: !pto.partition_tensor_view<16x16xf32>) {
    pto.tstore ins(%src : !pto.tile_buf<vec, 16x16xf32>) outs(%dst : !pto.partition_tensor_view<16x16xf32>) {l2_hint = #pto.store_l2_hint<not_alloc_keep>}
    return
  }
}
