//--- dst_wrong_layout.pto
module { func.func @case(%src: !pto.tile_buf<vec, 16x4xui8>, %tmp: !pto.tile_buf<vec, 1x80xui8>, %dst: !pto.tile_buf<vec, 16x4xui8>) {
  pto.tmov ins(%src : !pto.tile_buf<vec, 16x4xui8>, %tmp : !pto.tile_buf<vec, 1x80xui8>) outs(%dst : !pto.tile_buf<vec, 16x4xui8>)
  return
