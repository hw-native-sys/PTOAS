//--- tmp_too_small.pto
module { func.func @case(%src: !pto.tile_buf<vec, 32x4xui8, valid=20x4>, %tmp: !pto.tile_buf<vec, 1x71xui8>, %dst: !pto.tile_buf<vec, 32x4xui8, valid=20x4, slayout=row_major>) {
  pto.tmov ins(%src : !pto.tile_buf<vec, 32x4xui8, valid=20x4>, %tmp : !pto.tile_buf<vec, 1x71xui8>) outs(%dst : !pto.tile_buf<vec, 32x4xui8, valid=20x4, slayout=row_major>)
  return
} }

//--- nd_src_padded_stride.pto
module { func.func @case(%src: !pto.tile_buf<vec, 32x32xui8, valid=20x4>, %tmp: !pto.tile_buf<vec, 1x72xui8>, %dst: !pto.tile_buf<vec, 32x4xui8, valid=20x4, slayout=row_major>) {
  pto.tmov ins(%src : !pto.tile_buf<vec, 32x32xui8, valid=20x4>, %tmp : !pto.tile_buf<vec, 1x72xui8>) outs(%dst : !pto.tile_buf<vec, 32x4xui8, valid=20x4, slayout=row_major>)
