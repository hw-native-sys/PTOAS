//--- dn_src_padded_stride.pto
module { func.func @case(%src: !pto.tile_buf<vec, 2x32xui8, valid=2x16>, %tmp: !pto.tile_buf<vec, 1x1xui8>, %dst: !pto.tile_buf<vec, 2x16xui8, slayout=row_major>) {
  pto.tmov ins(%src : !pto.tile_buf<vec, 2x32xui8, valid=2x16>, %tmp : !pto.tile_buf<vec, 1x1xui8>) outs(%dst : !pto.tile_buf<vec, 2x16xui8, slayout=row_major>) {grpAxis = #pto<mx_group_axis axis0>}
  return
} }

//--- nd_dynamic_valid.pto
module { func.func @case(%src: !pto.tile_buf<vec, 32x4xui8, valid=?x4>, %tmp: !pto.tile_buf<vec, 1x72xui8>, %dst: !pto.tile_buf<vec, 32x4xui8, valid=?x4, slayout=row_major>) {
  pto.tmov ins(%src : !pto.tile_buf<vec, 32x4xui8, valid=?x4>, %tmp : !pto.tile_buf<vec, 1x72xui8>) outs(%dst : !pto.tile_buf<vec, 32x4xui8, valid=?x4, slayout=row_major>)
  return
} }

//--- dynamic_physical.pto
module { func.func @case(%src: !pto.tile_buf<loc=vec, dtype=ui8, rows=-1, cols=4, v_row=16, v_col=4, blayout=row_major, slayout=none_box, fractal=512, pad=0>, %tmp: !pto.tile_buf<vec, 1x80xui8>, %dst: !pto.tile_buf<vec, 16x4xui8, slayout=row_major>) {
  pto.tmov ins(%src : !pto.tile_buf<loc=vec, dtype=ui8, rows=-1, cols=4, v_row=16, v_col=4, blayout=row_major, slayout=none_box, fractal=512, pad=0>, %tmp : !pto.tile_buf<vec, 1x80xui8>) outs(%dst : !pto.tile_buf<vec, 16x4xui8, slayout=row_major>)
  return
} }

//--- on_a3.pto
module { func.func @case(%src: !pto.tile_buf<vec, 16x4xui8>, %tmp: !pto.tile_buf<vec, 1x80xui8>, %dst: !pto.tile_buf<vec, 16x4xui8, slayout=row_major>) {
  pto.tmov ins(%src : !pto.tile_buf<vec, 16x4xui8>, %tmp : !pto.tile_buf<vec, 1x80xui8>) outs(%dst : !pto.tile_buf<vec, 16x4xui8, slayout=row_major>)
  return
} }
