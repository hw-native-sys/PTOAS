  pto.tmov ins(%src : !pto.tile_buf<vec, 2x8xui8>, %tmp : !pto.tile_buf<vec, 1x1xui8>) outs(%dst : !pto.tile_buf<vec, 2x8xui8, slayout=row_major>) {grpAxis = #pto<mx_group_axis axis0>}
  return
