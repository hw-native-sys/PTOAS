//--- nd_dst_cols_odd.pto
module { func.func @case(%src: !pto.tile_buf<vec, 16x3xui8>, %tmp: !pto.tile_buf<vec, 1x67xui8>, %dst: !pto.tile_buf<vec, 16x3xui8, slayout=row_major>) {
  pto.tmov ins(%src : !pto.tile_buf<vec, 16x3xui8>, %tmp : !pto.tile_buf<vec, 1x67xui8>) outs(%dst : !pto.tile_buf<vec, 16x3xui8, slayout=row_major>)
  return
} }

//--- dn_src_rows_odd.pto
module { func.func @case(%src: !pto.tile_buf<vec, 3x16xui8>, %tmp: !pto.tile_buf<vec, 1x1xui8>, %dst: !pto.tile_buf<vec, 3x16xui8, slayout=row_major>) {
  pto.tmov ins(%src : !pto.tile_buf<vec, 3x16xui8>, %tmp : !pto.tile_buf<vec, 1x1xui8>) outs(%dst : !pto.tile_buf<vec, 3x16xui8, slayout=row_major>) {grpAxis = #pto<mx_group_axis axis0>}
  return
