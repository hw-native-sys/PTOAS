// RUN: ptoas --pto-arch=a5 --pto-level=level3 %s 2>&1 | FileCheck %s

module {
  func.func @tgather_a5_index_no_tmp_level3() {
    %c0 = arith.constant 0 : i64
    %c256 = arith.constant 256 : i64
    %c512 = arith.constant 512 : i64
    %src = pto.alloc_tile addr = %c0 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %indices = pto.alloc_tile addr = %c256 : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile addr = %c512 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tgather ins(%src, %indices : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
                outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// CHECK-LABEL: AICORE void tgather_a5_index_no_tmp_level3(
// CHECK: TGATHER({{[^,)]+}}, {{[^,)]+}}, {{[^,)]+}}, {{[^,)]+}});
