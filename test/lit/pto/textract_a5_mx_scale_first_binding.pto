// RUN: pto-test-opt --pass-pipeline="builtin.module(func.func(pto-a5-normalize-tmov,pto-a5-normalize-tmov))" %s | FileCheck %s

!mat = !pto.tile_buf<mat, 128x128x!pto.f8E8M0, slayout=row_major, fractal=32>
!scale = !pto.tile_buf<scaling, 128x4x!pto.f8E8M0, slayout=row_major, fractal=32>
!data = !pto.tile_buf<left, 128x128xf8E4M3FN, blayout=col_major, slayout=row_major>

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  // CHECK-LABEL: func.func @extract_first_binding(
  // CHECK: %[[SCALE:[0-9]+]] = pto.alloc_tile :
  // CHECK-NEXT: %[[DATA:[0-9]+]] = pto.alloc_tile addr =
  // CHECK-NEXT: pto.tget_scale_addr ins(%[[DATA]] {{.*}} outs(%[[SCALE]]
  // CHECK-NEXT: pto.textract {{.*}} outs(%[[SCALE]]
  // CHECK-NEXT: return
  func.func @extract_first_binding(%src: !mat) {
    %addr = arith.constant 4096 : i64
    %zero = arith.constant 0 : index
    %scale = pto.alloc_tile : !scale
    pto.textract ins(%src, %zero, %zero : !mat, index, index) outs(%scale : !scale)
    %data = pto.alloc_tile addr = %addr : !data
    pto.tget_scale_addr ins(%data : !data) outs(%scale : !scale)
    return
  }
}
