// RUN: ptoas --pto-arch=a5 --enable-tile-op-expand %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  module attributes {
    pto.backend = "emitc"
  } {
    func.func @single_emitc_child_tprint_view(%src: !pto.ptr<f32, gm>) attributes {pto.entry} {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c8 = arith.constant 8 : index

      %view = pto.make_tensor_view %src, shape = [%c1, %c8], strides = [%c8, %c1] : !pto.tensor_view<?x?xf32>
      %part = pto.partition_view %view, offsets = [%c0, %c0], sizes = [%c1, %c8] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
      pto.tprint ins(%part : !pto.partition_tensor_view<1x8xf32>)
      return
    }
  }
}

// CHECK-LABEL: AICORE void single_emitc_child_tprint_view(
// CHECK: TPRINT(
