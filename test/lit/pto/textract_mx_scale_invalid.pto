module attributes {pto.target_arch = "a5"} {
  func.func @left_src_unaligned_rows(%src: !pto.tile_buf<loc=mat, dtype=!pto.f8E8M0, rows=257, cols=8, v_row=257, v_col=8, blayout=row_major, slayout=row_major, fractal=32, pad=0, compact=0>, %dst: !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=256, cols=4, v_row=256, v_col=4, blayout=row_major, slayout=row_major, fractal=32, pad=0, compact=0>) {
    %row = arith.constant 0 : index
    %col = arith.constant 0 : index
    // expected-error@+1 {{expects A5 MX scale textract src physical shape to be aligned to [16, 2]}}
    pto.textract ins(%src, %row, %col : !pto.tile_buf<loc=mat, dtype=!pto.f8E8M0, rows=257, cols=8, v_row=257, v_col=8, blayout=row_major, slayout=row_major, fractal=32, pad=0, compact=0>, index, index)
                 outs(%dst : !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=256, cols=4, v_row=256, v_col=4, blayout=row_major, slayout=row_major, fractal=32, pad=0, compact=0>)
    return
  }
}

