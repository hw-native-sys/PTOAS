// RUN: not ptoas --pto-arch=a3 %s -o /dev/null 2>&1 | FileCheck %s

module {
  func.func @castptr_cross_space_invalid(%ptr: !pto.ptr<i32, gm>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %cast = pto.castptr %ptr : !pto.ptr<i32, gm> -> !pto.ptr<i32, ub>
    return
  }
}

// CHECK: pto.castptr
// CHECK: ptr-to-ptr cast must stay within the same PTO memory space
