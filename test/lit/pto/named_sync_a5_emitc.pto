// RUN: ptoas --pto-arch=a5 %s 2>&1 | FileCheck %s --implicit-check-not=__builtin_cce_

module attributes {
  pto.kernel_kind = #pto.kernel_kind<vector>,
  pto.target_arch = "a5"
} {
  func.func @named_sync_a5_emitc() attributes {pto.kernel} {
    pto.set_cross_block <PIPE_FIX>, 0
    pto.wait_cross_block <PIPE_MTE3>, 0
    pto.set_intra_block <PIPE_MTE1>, 17
    pto.wait_intra_block <PIPE_V>, 17
    return
  }
}

// CHECK-LABEL: extern "C" __global__ AICORE void named_sync_a5_emitc() {
// CHECK: getFFTSMsg(0, {{.*}})
// CHECK: ffts_cross_core_sync(PIPE_FIX, {{.*}});
// CHECK-NEXT: wait_flag_dev(PIPE_MTE3, 0);
// CHECK-NEXT: set_intra_block(PIPE_MTE1, 17);
// CHECK-NEXT: wait_intra_block(PIPE_V, 17);
