// RUN: ptoas --pto-arch=a3 %s -o - | FileCheck %s

module attributes {pto.target_arch = "a2a3"} {
  func.func @ptr_scalar_rw(%src: !pto.ptr<f32, gm>, %dst: !pto.ptr<f32, gm>)
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %src_off = pto.addptr %src, %c8 : !pto.ptr<f32, gm> -> !pto.ptr<f32, gm>
    %val = pto.load_scalar %src_off[%c4] : !pto.ptr<f32, gm> -> f32
    pto.store_scalar %val, %dst[%c4] : !pto.ptr<f32, gm>, f32
    return
  }
}

// CHECK-LABEL: AICORE void ptr_scalar_rw(
// CHECK: float {{.*}} = {{.*}} + {{.*}}[{{.*}}];
