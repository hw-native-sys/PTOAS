// RUN: ptoas --pto-arch=a5 --pto-level=level3 %s 2>&1 | FileCheck %s --check-prefix=EMITC
// RUN: not ptoas --pto-arch=a3 %s 2>&1 | FileCheck %s --check-prefix=A3-REJECT

module {
  func.func @tquant_mx_grp_axis_emitc(
      %nd_src: !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=32, v_row=16, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %nd_dst: !pto.tile_buf<loc=vec, dtype=ui8, rows=16, cols=32, v_row=16, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %nd_exp: !pto.tile_buf<loc=vec, dtype=ui8, rows=1, cols=32, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %nd_max: !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %nd_scaling: !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %dn_src: !pto.tile_buf<loc=vec, dtype=bf16, rows=64, cols=64, v_row=64, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %dn_dst: !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=64, cols=32, v_row=64, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %dn_exp: !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=64, v_row=2, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %dn_max: !pto.tile_buf<loc=vec, dtype=bf16, rows=2, cols=64, v_row=2, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %dn_scaling: !pto.tile_buf<loc=vec, dtype=bf16, rows=2, cols=64, v_row=2, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %il_src: !pto.tile_buf<loc=vec, dtype=bf16, rows=64, cols=32, v_row=64, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %il_dst: !pto.tile_buf<loc=vec, dtype=ui8, rows=64, cols=32, v_row=64, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %il_exp: !pto.tile_buf<loc=vec, dtype=ui8, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %il_max: !pto.tile_buf<loc=vec, dtype=bf16, rows=2, cols=32, v_row=2, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %il_scaling: !pto.tile_buf<loc=vec, dtype=bf16, rows=2, cols=32, v_row=2, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %nd2_src: !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %nd2_dst: !pto.tile_buf<loc=vec, dtype=ui8, rows=16, cols=128, v_row=16, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %nd2_exp: !pto.tile_buf<loc=vec, dtype=ui8, rows=16, cols=32, v_row=16, v_col=2, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %nd2_max: !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=2, v_row=16, v_col=2, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %nd2_scaling: !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=2, v_row=16, v_col=2, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %nv_src: !pto.tile_buf<vec, 16x64xf32>, %nv_dst: !pto.tile_buf<vec, 16x64xi8>,
      %nv_exp: !pto.tile_buf<vec, 16x2xui8>, %nv_max: !pto.tile_buf<vec, 16x2xf32>, %nv_scaling: !pto.tile_buf<vec, 16x2xf32>,
      %unroll_src: !pto.tile_buf<vec, 40x32xf32>, %unroll_dst: !pto.tile_buf<vec, 40x32xi8>,
      %unroll_exp: !pto.tile_buf<loc=vec, dtype=ui8, rows=1, cols=64, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %unroll_max: !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %unroll_scaling: !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=128, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %nd4_src: !pto.tile_buf<vec, 16x32xbf16>, %nd4_dst: !pto.tile_buf<vec, 16x16x!pto.f4E2M1x2>,
      %nd4_exp: !pto.tile_buf<vec, 1x16xui8>, %nd4_max: !pto.tile_buf<vec, 1x16xbf16>,
      %nd4_scaling: !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=128, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %dn8_src: !pto.tile_buf<loc=vec, dtype=f32, rows=64, cols=32, v_row=64, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %dn8_dst: !pto.tile_buf<vec, 64x16xi8>, %dn8_exp: !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %dn8_max: !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
      %dn8_scaling: !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {
    pto.tquant.mx ins(%nd_src : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=32, v_row=16, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%nd_dst, %nd_exp, %nd_max, %nd_scaling : !pto.tile_buf<loc=vec, dtype=ui8, rows=16, cols=32, v_row=16, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=ui8, rows=1, cols=32, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      {quant_type = #pto<quant_type MXFP8>}
    pto.tquant.mx ins(%dn_src : !pto.tile_buf<loc=vec, dtype=bf16, rows=64, cols=64, v_row=64, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dn_dst, %dn_exp, %dn_max, %dn_scaling : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=64, cols=32, v_row=64, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=64, v_row=2, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=bf16, rows=2, cols=64, v_row=2, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=bf16, rows=2, cols=64, v_row=2, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      {quant_type = #pto<quant_type MXFP4_E2M1>, grpAxis = #pto<mx_group_axis axis0>}
    pto.tquant.mx ins(%il_src : !pto.tile_buf<loc=vec, dtype=bf16, rows=64, cols=32, v_row=64, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%il_dst, %il_exp, %il_max, %il_scaling : !pto.tile_buf<loc=vec, dtype=ui8, rows=64, cols=32, v_row=64, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=ui8, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=bf16, rows=2, cols=32, v_row=2, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=bf16, rows=2, cols=32, v_row=2, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      {quant_type = #pto<quant_type MXFP8>, grpAxis = #pto<mx_group_axis axis0>, interleave = true}
    pto.tquant.mx ins(%nd2_src : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%nd2_dst, %nd2_exp, %nd2_max, %nd2_scaling : !pto.tile_buf<loc=vec, dtype=ui8, rows=16, cols=128, v_row=16, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=ui8, rows=16, cols=32, v_row=16, v_col=2, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=2, v_row=16, v_col=2, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=2, v_row=16, v_col=2, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {quant_type = #pto<quant_type MXFP8>, grpAxis = #pto<mx_group_axis axis1>}
    pto.tquant.mx ins(%nv_src : !pto.tile_buf<vec, 16x64xf32>) outs(%nv_dst, %nv_exp, %nv_max, %nv_scaling : !pto.tile_buf<vec, 16x64xi8>, !pto.tile_buf<vec, 16x2xui8>, !pto.tile_buf<vec, 16x2xf32>, !pto.tile_buf<vec, 16x2xf32>) {quant_type = #pto<quant_type MXFP8>, quantScaleAlg = #pto<quant_scale_alg nv>}
    pto.tquant.mx ins(%unroll_src : !pto.tile_buf<vec, 40x32xf32>) outs(%unroll_dst, %unroll_exp, %unroll_max, %unroll_scaling : !pto.tile_buf<vec, 40x32xi8>, !pto.tile_buf<loc=vec, dtype=ui8, rows=1, cols=64, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=128, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {quant_type = #pto<quant_type MXFP8>, quantScaleAlg = #pto<quant_scale_alg nv>, grpAxis = #pto<mx_group_axis axis1>}
    pto.tquant.mx ins(%nd4_src : !pto.tile_buf<vec, 16x32xbf16>) outs(%nd4_dst, %nd4_exp, %nd4_max, %nd4_scaling : !pto.tile_buf<vec, 16x16x!pto.f4E2M1x2>, !pto.tile_buf<vec, 1x16xui8>, !pto.tile_buf<vec, 1x16xbf16>, !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=128, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {quant_type = #pto<quant_type MXFP4_E2M1>, grpAxis = #pto<mx_group_axis axis1>}
    pto.tquant.mx ins(%dn8_src : !pto.tile_buf<loc=vec, dtype=f32, rows=64, cols=32, v_row=64, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%dn8_dst, %dn8_exp, %dn8_max, %dn8_scaling : !pto.tile_buf<vec, 64x16xi8>, !pto.tile_buf<loc=vec, dtype=ui8, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=2, cols=32, v_row=2, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {quant_type = #pto<quant_type MXFP8>, grpAxis = #pto<mx_group_axis axis0>}
    return
  }
}

