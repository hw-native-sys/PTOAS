// PrintOp verifier diagnostics: format strings must carry exactly one
// conversion specifier whose kind matches the scalar operand type, and the
// scalar type must be in the supported print set.

// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a5 %t/two_conversions.pto 2>&1 | FileCheck %s --check-prefix=TWO-CONVERSIONS
// RUN: not ptoas --pto-arch=a5 %t/no_conversion.pto 2>&1 | FileCheck %s --check-prefix=NO-CONVERSION
// RUN: not ptoas --pto-arch=a5 %t/int_operand_float_spec.pto 2>&1 | FileCheck %s --check-prefix=INT-OPERAND-FLOAT-SPEC
// RUN: not ptoas --pto-arch=a5 %t/float_operand_int_spec.pto 2>&1 | FileCheck %s --check-prefix=FLOAT-OPERAND-INT-SPEC
// RUN: not ptoas --pto-arch=a5 %t/unsupported_int_width.pto 2>&1 | FileCheck %s --check-prefix=UNSUPPORTED-INT-WIDTH
// RUN: not ptoas --pto-arch=a5 %t/unsupported_float_type.pto 2>&1 | FileCheck %s --check-prefix=UNSUPPORTED-FLOAT-TYPE

//--- two_conversions.pto
func.func private @two_conversions(%v : i32) {
  pto.print ins("a = %d, b = %d", %v : i32)
  return
}

// TWO-CONVERSIONS: error: 'pto.print' op format string must contain exactly one conversion specifier: "a = %d, b = %d"

//--- no_conversion.pto
func.func private @no_conversion(%v : f32) {
  pto.print ins("no specifier here", %v : f32)
  return
}

// NO-CONVERSION: error: 'pto.print' op format string must contain exactly one conversion specifier: "no specifier here"

//--- int_operand_float_spec.pto
func.func private @int_operand_float_spec(%v : i32) {
  pto.print ins("value = %f", %v : i32)
  return
}

// INT-OPERAND-FLOAT-SPEC: error: 'pto.print' op integer operand requires integer format specifier (%d/%i/%u/%x/%o)

//--- float_operand_int_spec.pto
func.func private @float_operand_int_spec(%v : f32) {
  pto.print ins("value = %d", %v : f32)
  return
}

// FLOAT-OPERAND-INT-SPEC: error: 'pto.print' op float operand requires float format specifier (%f/%e/%g/%a)

//--- unsupported_int_width.pto
func.func private @unsupported_int_width(%v : i4) {
  pto.print ins("value = %d", %v : i4)
  return
}

// UNSUPPORTED-INT-WIDTH: error: 'pto.print' op unsupported integer width for print: 4; supported: i8, i16, i32, i64

//--- unsupported_float_type.pto
func.func private @unsupported_float_type(%v : f8E5M2) {
  pto.print ins("value = %f", %v : f8E5M2)
  return
}

// UNSUPPORTED-FLOAT-TYPE: error: 'pto.print' op unsupported float type for print: 'f8E5M2'; supported: f16, bf16, f32, f64
