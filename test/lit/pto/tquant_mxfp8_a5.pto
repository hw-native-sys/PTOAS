// RUN: ptoas --pto-arch=a5 %s 2>&1 | FileCheck %s --check-prefix=A5
// RUN: not ptoas --pto-arch=a3 %s 2>&1 | FileCheck %s --check-prefix=A3ERR

module attributes {"pto.device-spec" = "Ascend910B3"} {
  func.func @tquant_mxfp8() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 32x32xf32>
    %exp = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui8>
    %max = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %scaling = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 32x32xui8>

    pto.tquant.mx ins(%src : !pto.tile_buf<vec, 32x32xf32>)
                  outs(%dst, %exp, %max, %scaling :
                       !pto.tile_buf<vec, 32x32xui8>,
                       !pto.tile_buf<vec, 1x32xui8>,
                       !pto.tile_buf<vec, 1x32xf32>,
                       !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
                  {quant_type = #pto<quant_type MXFP8>}
    return
  }

  func.func @tquant_mxfp4_ocp() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 32x64xbf16>
    %exp = pto.alloc_tile : !pto.tile_buf<vec, 1x64xui8>
    %max = pto.alloc_tile : !pto.tile_buf<vec, 1x64xbf16>
    %scaling = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=128, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 32x32x!pto.f4E2M1x2>

    pto.tquant.mx ins(%src : !pto.tile_buf<vec, 32x64xbf16>)
                  outs(%dst, %exp, %max, %scaling :
                       !pto.tile_buf<vec, 32x32x!pto.f4E2M1x2>,
                       !pto.tile_buf<vec, 1x64xui8>,
                       !pto.tile_buf<vec, 1x64xbf16>,
                       !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=128, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
                  {quant_type = #pto<quant_type MXFP4_E2M1>}
    return
  }

  func.func @tquant_mxfp8_nz() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 32x32xf32>
    %exp = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui8>
    %max = pto.alloc_tile : !pto.tile_buf<vec, 1x32xf32>
    %scaling = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %exp_zz = pto.alloc_tile : !pto.tile_buf<vec, 1x32xui8>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 32x32xui8>

    pto.tquant.mx ins(%src : !pto.tile_buf<vec, 32x32xf32>)
                  outs(%dst, %exp, %max, %scaling, %exp_zz :
                       !pto.tile_buf<vec, 32x32xui8>,
                       !pto.tile_buf<vec, 1x32xui8>,
                       !pto.tile_buf<vec, 1x32xf32>,
                       !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>,
                       !pto.tile_buf<vec, 1x32xui8>)
                  {quant_type = #pto<quant_type MXFP8>,
                   storeMode = #pto<vec_store_mode nz>}
    return
  }
}

// A5-LABEL: AICORE void tquant_mxfp8(
// A5: TQUANT<1, pto::MxQuantAlg::OcpMxFp8E4M3>(
// A5-LABEL: AICORE void tquant_mxfp4_ocp(
// A5: TQUANT<1, pto::MxQuantAlg::OcpMxFp4E2M1>(
// A5-LABEL: AICORE void tquant_mxfp8_nz(
// A5: TQUANT<pto::QuantType::MXFP8, pto::VecStoreMode::NZ
// A3ERR: error: 'pto.tquant.mx' op tquant.mx is only supported on A5
