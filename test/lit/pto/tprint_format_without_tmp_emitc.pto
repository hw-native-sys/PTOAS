// RUN: ptoas --pto-arch=a3 --pto-backend=emitc %s | FileCheck %s

module {
  func.func @tprint_format_without_tmp() attributes {pto.entry} {
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tprint ins(%src : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
              {printFormat = #pto<print_format width8_precision2>}
    return
  }
}

// CHECK: TPRINT<pto::PrintFormat::Width8_Precision2>({{[_A-Za-z][_A-Za-z0-9]*}});
