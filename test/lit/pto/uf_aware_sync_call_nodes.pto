// RUN: pto-test-opt --pto-insert-sync --pto-insert-sync-debug=2 %s -o /dev/null 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  func.func private @modeled(!pto.tile_buf<vec, 16x16xf32>)
      attributes {pto.tileop.helper, pto.tileop.kind = "vector", pto.tileop.effects = ["read"]}
  func.func private @empty() attributes {pto.tileop.helper, pto.tileop.kind = "vector"}
  func.func private @opaque()

  func.func @call_nodes(%tile: !pto.tile_buf<vec, 16x16xf32>, %callee: () -> ()) {
    func.call @modeled(%tile) : (!pto.tile_buf<vec, 16x16xf32>) -> ()
    func.call @empty() : () -> ()
    func.call @opaque() : () -> ()
    func.call_indirect %callee() : () -> ()
    return
  }
}

// A modeled helper is one compound; all unmodeled call kinds remain opaque.
// CHECK: After Translator
// CHECK: [   0] COMPOUND func.call [PIPE_V]
// CHECK: [   1] PLACE_HOLDER
// CHECK-NEXT: [   2] PLACE_HOLDER
// CHECK-NEXT: [   3] PLACE_HOLDER
// CHECK-NOT: [   4]
// CHECK: After Analysis
