// RUN: not ptoas --pto-arch=a3 --pto-level=level2 --plan-memory-allocator=unknown --emit-pto-ir %s -o /dev/null 2>&1 | FileCheck %s
// RUN: not pto-test-opt --pto-plan-memory="allocator=unknown" %s -o /dev/null 2>&1 | FileCheck %s
// RUN: not ptoas --pto-arch=a3 --pto-level=level2 --plan-memory-allocator=group --emit-pto-ir %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=GROUP
// GROUP: unsupported memory allocator 'group'; expected interval

module {
  func.func @invalid_allocator() {
    return
  }
}
// CHECK: unsupported memory allocator 'unknown'; expected interval
