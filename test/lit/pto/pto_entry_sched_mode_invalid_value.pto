// RUN: not ptoas %s 2>&1 | FileCheck %s

// Only 0 (normal mode) and 1 (batch mode) are valid: the bisheng compiler
// rejects anything else with "Invalid Schedule Mode", so PTOAS rejects it
// earlier and names the accepted values.

module {
  func.func @kernel(%arg0: !pto.ptr<f32>) attributes {pto.entry, pto.sched_mode = 2 : i32} {
    return
  }
}

// CHECK: `pto.sched_mode` must be 0 (normal mode) or 1 (batch mode), got 2
