// RUN: pto-test-opt --split-input-file --verify-diagnostics %s

module attributes {pto.target_arch = "a5"} {
  func.func @e4m3_fnuz_unsupported(%src: !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=32, cols=256, v_row=32, v_col=256, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>, %dst: !pto.tile_buf<loc=vec, dtype=f8E4M3FNUZ, rows=32, cols=512, v_row=32, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>) {
    // expected-error@+1 {{expects A5 tcvt low-precision type pairs to match PTO-ISA support}}
    pto.tcvt ins(%src : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=32, cols=256, v_row=32, v_col=256, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f8E4M3FNUZ, rows=32, cols=512, v_row=32, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>)
    return
  }
}

