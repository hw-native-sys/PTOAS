// RUN: not ptoas %s 2>&1 | FileCheck %s

// The CCE qualifier only applies to kernel functions, so the attribute is
// rejected on a plain device function instead of being dropped.

module {
  func.func @plain_function(%arg0: !pto.ptr<f32>) attributes {pto.sched_mode = 1 : i32} {
    return
  }
}

// The diagnostic names every marker PTOAS accepts, not just `pto.entry`:
// `pto.kernel` is the VPTO entry spelling and `pto.aicore` / `hacc.entry` are
// the legacy aliases, so a message naming only `pto.entry` would be wrong.
// CHECK: `pto.sched_mode` is only valid on a PTO kernel entry function, one marked with `pto.entry` or `pto.kernel` (`pto.aicore` and `hacc.entry` are legacy aliases)
