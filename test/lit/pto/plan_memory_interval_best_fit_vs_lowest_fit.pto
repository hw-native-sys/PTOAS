// RUN: ptoas --pto-arch=a3 --pto-level=level2 --plan-memory-allocator=interval --emit-pto-ir --mlir-print-ir-after=pto-plan-memory %s -o /dev/null 2>&1 | FileCheck %s
// Best-fit reuses the exact 64 KiB middle hole, preserving the 128 KiB low hole.
module {
  func.func @best_fit(%s: !pto.partition_tensor_view<64x512xbf16>, %l: !pto.partition_tensor_view<128x512xbf16>) {
    %a = pto.alloc_tile : !pto.tile_buf<mat, 128x512xbf16>
    %b = pto.alloc_tile : !pto.tile_buf<mat, 64x512xbf16>
    %c = pto.alloc_tile : !pto.tile_buf<mat, 64x512xbf16>
    %e = pto.alloc_tile : !pto.tile_buf<mat, 64x512xbf16>
    pto.tload ins(%l : !pto.partition_tensor_view<128x512xbf16>) outs(%a : !pto.tile_buf<mat, 128x512xbf16>)
    pto.tload ins(%s : !pto.partition_tensor_view<64x512xbf16>) outs(%b : !pto.tile_buf<mat, 64x512xbf16>)
    pto.tload ins(%s : !pto.partition_tensor_view<64x512xbf16>) outs(%c : !pto.tile_buf<mat, 64x512xbf16>)
    pto.tload ins(%s : !pto.partition_tensor_view<64x512xbf16>) outs(%e : !pto.tile_buf<mat, 64x512xbf16>)
    pto.tstore ins(%c : !pto.tile_buf<mat, 64x512xbf16>) outs(%s : !pto.partition_tensor_view<64x512xbf16>)
    pto.tstore ins(%a : !pto.tile_buf<mat, 128x512xbf16>) outs(%l : !pto.partition_tensor_view<128x512xbf16>)
    %d = pto.alloc_tile : !pto.tile_buf<mat, 64x512xbf16>
    pto.tload ins(%s : !pto.partition_tensor_view<64x512xbf16>) outs(%d : !pto.tile_buf<mat, 64x512xbf16>)
    pto.tstore ins(%b : !pto.tile_buf<mat, 64x512xbf16>) outs(%s : !pto.partition_tensor_view<64x512xbf16>)
    pto.tstore ins(%e : !pto.tile_buf<mat, 64x512xbf16>) outs(%s : !pto.partition_tensor_view<64x512xbf16>)
    pto.tstore ins(%d : !pto.tile_buf<mat, 64x512xbf16>) outs(%s : !pto.partition_tensor_view<64x512xbf16>)
    return
  }
}
// CHECK-LABEL: func.func @best_fit
// CHECK-DAG: %[[C:.*]] = arith.constant 196608 : i64
// CHECK: pto.alloc_tile addr = {{.*}} : !pto.tile_buf<mat, 128x512xbf16>
// CHECK: pto.alloc_tile addr = {{.*}} : !pto.tile_buf<mat, 64x512xbf16>
// CHECK: pto.alloc_tile addr = %[[C]] : !pto.tile_buf<mat, 64x512xbf16>
// CHECK: pto.alloc_tile addr = {{.*}} : !pto.tile_buf<mat, 64x512xbf16>
// CHECK: pto.alloc_tile addr = %[[C]] : !pto.tile_buf<mat, 64x512xbf16>
