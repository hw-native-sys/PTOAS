// RUN: ptoas --pto-arch=a3 %s | FileCheck %s --implicit-check-not=__builtin_cce_
// RUN: ptoas --pto-arch=a5 %s | FileCheck %s --implicit-check-not=__builtin_cce_

// General GCC/Clang builtins are distinct from CCE-private backend entry points.
// Keep remainder precision and bit-preserving conversion in the generated audit.
// Scalar FP32 max/min lower NaN and signed-zero handling through the bitcast
// helper, so both the AICORE caller and the helper itself must stay device
// qualified for the AscendC device compiler.
module {
  func.func @scalar_helpers(%lhs: f32, %rhs: f32) -> i32 {
    %rem = arith.remf %lhs, %rhs : f32
    %bits = arith.bitcast %rem : f32 to i32
    return %bits : i32
  }
  func.func @remainder_double(%lhs: f64, %rhs: f64) -> f64 {
    %rem = arith.remf %lhs, %rhs : f64
    return %rem : f64
  }
  func.func @remainder_half(%lhs: f16, %rhs: f16) -> f16 {
    %rem = arith.remf %lhs, %rhs : f16
    return %rem : f16
  }
  func.func @maximum_f32(%lhs: f32, %rhs: f32) -> f32 {
    %max = arith.maximumf %lhs, %rhs : f32
    return %max : f32
  }
  func.func @minimum_f32(%lhs: f32, %rhs: f32) -> f32 {
    %min = arith.minimumf %lhs, %rhs : f32
    return %min : f32
  }
}
// CHECK: template <typename To, typename From>
// CHECK-NOT: static inline To ptoas_bitcast
// CHECK: static AICORE inline To ptoas_bitcast(From from) {
// CHECK: __builtin_memcpy(&to, &from, sizeof(To));
// CHECK-LABEL: scalar_helpers(
// CHECK: __builtin_fmodf(
