// The range-driven offset-chain narrowing rewrites element-offset chains
// feeding pto.load/pto.store into i32 when a local recursive range
// evaluation proves every chain value fits in [0, 2^32). A loop induction
// variable with constant bounds is provably in range, so `iv * stride` under
// a store offset becomes an i32 multiply; a block index with a runtime block
// count cannot be proven (block_count * stride may exceed u32), so its chain
// stays wide. When a provable subchain sits under an unprovable parent (e.g.
// `w * 2048 + block_idx`), the provable operand is still swapped for its i32
// mirror widened back with a zero-extend.
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @narrow_offset(%dst: !pto.ptr<i32, ub>, %gm: !pto.ptr<i32, gm>, %laneid: i32) attributes {pto.entry} {
    pto.section.simt<<<32, 1, 1>>> {
      %c0 = arith.constant 0 : index
      %c64 = arith.constant 64 : index
      %c2048 = arith.constant 2048 : index
      %c1024 = arith.constant 1024 : index
      %c128_i64 = arith.constant 128 : i64
      scf.for %iv = %c0 to %c2048 step %c64 {
        %in_bounds = arith.cmpi slt, %iv, %c1024 : index
        scf.if %in_bounds {
          // Loop-invariant base chain (hoisted by LICM).
          %w64 = arith.extsi %laneid : i32 to i64
          %slot = arith.muli %w64, %c128_i64 : i64
          // IV-dependent product: iv < 2048, so iv * 128 < 2^32 and must be
          // narrowed to an i32 multiply, then widened back for the i64 add.
          %iv64 = arith.index_cast %iv : index to i64
          %dynamic = arith.muli %iv64, %c128_i64 : i64
          %offset = arith.addi %slot, %dynamic : i64
          %addr = arith.index_cast %offset : i64 to index
          pto.store %laneid, %dst[%addr] : !pto.ptr<i32, ub>, i32
        }
      }
    }
    return
  }

  // The block-index chain multiplies the block index (whose block count is a
  // runtime launch parameter) by a stride; block_count * stride may exceed
  // u32, so the chain must NOT be narrowed and stays i64.
  func.func @block_offset_wide(%gm: !pto.ptr<i32, gm>) attributes {pto.entry} {
    %block_idx = pto.get_block_idx
    %c2048_i64 = arith.constant 2048 : i64
    %off = arith.muli %block_idx, %c2048_i64 : i64
    %addr = arith.index_cast %off : i64 to index
    %v = pto.load %gm[%addr] : !pto.ptr<i32, gm> -> i32
    %c0 = arith.constant 0 : index
    pto.store %v, %gm[%c0] : !pto.ptr<i32, gm>, i32
    return
  }

  // The TileLang amax-store shape: a bounded IV product plus the block index
  // ADDED (not multiplied). get_block_idx carries [0, INT32_MAX] (the value
  // is rounded through i32 by the lowering), so the whole chain provably
  // fits u32 and must narrow end to end — including the block-index add —
  // with a single zero-extend at the store offset.
  func.func @amax_fullchain(%gm: !pto.ptr<i32, gm>) attributes {pto.entry} {
    %c0 = arith.constant 0 : index
    %c256 = arith.constant 256 : index
    %c1 = arith.constant 1 : index
    %c2048_i64 = arith.constant 2048 : i64
    scf.for %w = %c0 to %c256 step %c1 {
      %w64 = arith.index_cast %w : index to i64
      %prod = arith.muli %w64, %c2048_i64 : i64
      %block_idx = pto.get_block_idx
      %sum = arith.addi %prod, %block_idx : i64
      %addr = arith.index_cast %sum : i64 to index
      %v = pto.load %gm[%addr] : !pto.ptr<i32, gm> -> i32
      pto.store %v, %gm[%addr] : !pto.ptr<i32, gm>, i32
    }
    return
  }

  // MLY's repro: a chain whose upper bound reaches the i32 sign bit, feeding a
  // SIGNED index_cast that widens i32 -> index. Sign extension would turn the
  // value negative while the unsigned interval still claims [0, hi], so the
  // chain must be rejected: no index_castui may replace the signed cast.
  func.func @signed_widening_cast_rejected(%dst: !pto.ptr<i32, ub>) attributes {pto.entry} {
    pto.section.simt<<<1024, 1, 1>>> {
      %tid = pto.get_tid_x : i32
      %big = arith.constant 2147483647 : i32
      %sum = arith.addi %tid, %big : i32
      %idx = arith.index_cast %sum : i32 to index
      %c4 = arith.constant 4 : index
      %off = arith.addi %idx, %c4 : index
      %v = pto.load %dst[%off] : !pto.ptr<i32, ub> -> i32
      pto.store %v, %dst[%off] : !pto.ptr<i32, ub>, i32
    }
    return
  }

  // A divisor that exceeds u32 would be truncated by the i32 mirror
  // (2^32 -> 0, 2^32+1 -> 1), changing the result or dividing by zero.
  // Such chains must keep their i64 form: no mirror, no trunc.
  func.func @wide_divisor_stays_i64(%gm: !pto.ptr<i32, gm>, %gm64: !pto.ptr<i64, gm>) attributes {pto.entry} {
    %block_idx = pto.get_block_idx
    %c_pow32 = arith.constant 4294967296 : i64
    %c_pow32p1 = arith.constant 4294967297 : i64
    %q1 = arith.floordivsi %block_idx, %c_pow32 : i64
    %q2 = arith.floordivsi %block_idx, %c_pow32p1 : i64
    %addr = arith.index_cast %q2 : i64 to index
    %v = pto.load %gm[%addr] : !pto.ptr<i32, gm> -> i32
    %sum64 = arith.addi %q1, %q2 : i64
    %c0 = arith.constant 0 : index
    pto.store %v, %gm[%c0] : !pto.ptr<i32, gm>, i32
    pto.store %sum64, %gm64[%c0] : !pto.ptr<i64, gm>, i64
    return
  }
}

// CHECK-LABEL: func.func @block_offset_wide(
// The block-index chain keeps its i64 multiply (no narrowing, no trunci).
// CHECK-NOT: arith.trunci
// CHECK:     arith.muli %{{.*}}, %{{.*}} : i64

// CHECK-LABEL: func.func @amax_fullchain(
// The whole chain narrows including the block-index add: i32 multiply,
// i32 add over the (i32-truncated) block index, one zero-extend at the
// offset operand. The canonicalizer folds the trunc-of-zext around the
// block query, so no i64 arithmetic remains on the chain.
// CHECK:     arith.trunci %{{.*}} : i64 to i32
// CHECK:     arith.muli %{{.*}}, %{{.*}} : i32
// CHECK:     arith.addi %{{.*}}, %{{.*}} : i32
// CHECK:     arith.index_castui %{{.*}} : i32 to index

// CHECK-LABEL: func.func @wide_divisor_stays_i64(
// Divisors wider than u32 must never be mirrored: no trunci may be emitted
// anywhere in the function. (The int-range phase itself folds these
// particular chains to zero because the bounded numerator is smaller than
// the divisor — that folding is the safe, correct outcome here.)
// CHECK-NOT: arith.trunci
// CHECK-NOT: arith.divsi
// CHECK-NOT: arith.divui

// CHECK-LABEL: func.func private @narrow_offset_simt_0(
// The IV * 128 product is narrowed to i32 (trunci of the i64 IV, i32 multiply,
// zero-extend back), while the invariant base add stays i64.
// CHECK:     arith.trunci %{{.*}} : i64 to i32
// CHECK:     arith.muli %{{.*}}, %{{.*}} : i32
// CHECK:     arith.extui %{{.*}} : i32 to i64

// CHECK-LABEL: func.func private @signed_widening_cast_rejected_simt_
// The sign bit is reachable (tid + INT32_MAX), so the signed widening cast
// must survive untouched: no index_castui may replace it.
// CHECK:     arith.index_cast %{{.*}} : i32 to index
// CHECK-NOT: arith.index_castui
