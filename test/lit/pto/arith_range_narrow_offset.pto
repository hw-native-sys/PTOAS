// The range-driven offset-chain narrowing rewrites element-offset chains
// feeding pto.load/pto.store/pto.addptr into i32 when a local recursive range
// evaluation proves every chain value fits in [0, 2^32). A loop induction
// variable with constant bounds is provably in range, so `iv * stride` under
// a store offset becomes an i32 multiply; a block index with a runtime block
// count cannot be proven (block_count * stride may exceed u32), so its chain
// stays wide. When a provable subchain sits under an unprovable parent (e.g.
// `w * 2048 + block_idx`), the provable operand is still swapped for its i32
// mirror widened back with a zero-extend.
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @narrow_offset(%dst: !pto.ptr<i32, ub>, %gm: !pto.ptr<i32, gm>, %laneid: i32) attributes {pto.entry} {
    pto.section.simt<<<32, 1, 1>>> {
      %c0 = arith.constant 0 : index
      %c64 = arith.constant 64 : index
      %c2048 = arith.constant 2048 : index
      %c1024 = arith.constant 1024 : index
      %c128_i64 = arith.constant 128 : i64
      scf.for %iv = %c0 to %c2048 step %c64 {
        %in_bounds = arith.cmpi slt, %iv, %c1024 : index
        scf.if %in_bounds {
          // Loop-invariant base chain (hoisted by LICM).
          %w64 = arith.extsi %laneid : i32 to i64
          %slot = arith.muli %w64, %c128_i64 : i64
          // IV-dependent product: iv < 2048, so iv * 128 < 2^32 and must be
          // narrowed to an i32 multiply, then widened back for the i64 add.
          %iv64 = arith.index_cast %iv : index to i64
          %dynamic = arith.muli %iv64, %c128_i64 : i64
          %offset = arith.addi %slot, %dynamic : i64
          %addr = arith.index_cast %offset : i64 to index
          pto.store %laneid, %dst[%addr] : !pto.ptr<i32, ub>, i32
        }
      }
    }
    return
  }

  // The block-index chain multiplies the block index (whose block count is a
  // runtime launch parameter) by a stride; block_count * stride may exceed
  // u32, so the chain must NOT be narrowed and stays i64.
  func.func @block_offset_wide(%gm: !pto.ptr<i32, gm>) attributes {pto.entry} {
    %block_idx = pto.get_block_idx
    %c2048_i64 = arith.constant 2048 : i64
    %off = arith.muli %block_idx, %c2048_i64 : i64
    %addr = arith.index_cast %off : i64 to index
    %v = pto.load %gm[%addr] : !pto.ptr<i32, gm> -> i32
    %c0 = arith.constant 0 : index
    pto.store %v, %gm[%c0] : !pto.ptr<i32, gm>, i32
    return
  }
}

// CHECK-LABEL: func.func @block_offset_wide(
// The block-index chain keeps its i64 multiply (no narrowing, no trunci).
// CHECK-NOT: arith.trunci
// CHECK:     arith.muli %{{.*}}, %{{.*}} : i64

// CHECK-LABEL: func.func private @narrow_offset_simt_0(
// The IV * 128 product is narrowed to i32 (trunci of the i64 IV, i32 multiply,
// zero-extend back), while the invariant base add stays i64.
// CHECK:     arith.trunci %{{.*}} : i64 to i32
// CHECK:     arith.muli %{{.*}}, %{{.*}} : i32
// CHECK:     arith.extui %{{.*}} : i32 to i64
