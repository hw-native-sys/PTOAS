// RUN: ptoas --pto-level=level3 --pto-arch=a5 \
// RUN:   --mlir-print-ir-after=pto-resolve-reserved-buffers %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NATIVE
// RUN: ptoas --pto-level=level3 --pto-arch=a3 --enable-insert-sync %s \
// RUN:   | FileCheck %s --check-prefix=EMITC

module {
  func.func private @tmov_fp_arg(
      %src: !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=1024, pad=0>,
      %fp: !pto.tile_buf<loc=scaling, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=row_major, fractal=512, pad=0>,
      %dst: !pto.tile_buf<loc=mat, dtype=i8, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>) {
    pto.tmov ins(%src : !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=1024, pad=0>, %fp : !pto.tile_buf<loc=scaling, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=row_major, fractal=512, pad=0>)
                outs(%dst : !pto.tile_buf<loc=mat, dtype=i8, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    return
  }
}

// NATIVE-LABEL: func.func private @tmov_fp_arg(
// NATIVE: pto.tmov ins(%arg0 :
// NATIVE-SAME: %arg1 :
// NATIVE-NOT: memref<

// EMITC-LABEL: tmov_fp_arg(
// EMITC: TMOV_FP<
