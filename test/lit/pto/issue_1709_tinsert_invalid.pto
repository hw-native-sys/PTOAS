// RUN: not ptoas --pto-arch=a5 --pto-level=level3 --enable-insert-sync %s 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  func.func @strided_insert() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c4096_i64 = arith.constant 4096 : i64
    %c12288_i64 = arith.constant 12288 : i64
    %c16_index = arith.constant 16 : index
    %c128_index = arith.constant 128 : index
    %c64_index = arith.constant 64 : index
    %c0_index = arith.constant 0 : index
    %local__tile = pto.alloc_tile addr = %c4096_i64 valid_row = %c16_index valid_col = %c128_index : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %slice_view = pto.subview %local__tile[%c0_index, %c64_index] sizes [16, 64] : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0> -> !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %1 = pto.subview %slice_view[%c0_index, %c0_index] sizes [16, 64] valid [%c16_index, %c64_index] : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0> -> !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %gather_src_alloc = pto.alloc_tile addr = %c12288_i64 valid_row = %c16_index valid_col = %c64_index : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tinsert ins(%1, %c0_index, %c0_index : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=16, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index, index) outs(%gather_src_alloc : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=64, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// CHECK: error: 'pto.tinsert' op cannot lower A5 vec-to-vec tinsert: resolved subview source physical shape is 16x128, but destination physical shape is 16x64
