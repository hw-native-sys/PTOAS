// Issue #1599: A5 row extremes accept 8-bit integers (i8/si8/ui8). The ops
// must verify and survive level-2 printing unchanged.

// RUN: ptoas --pto-arch=a5 --pto-level=level2 --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func @row_extremes_i8_ui8() {
    %src_i8 = pto.alloc_tile : !pto.tile_buf<vec, 8x32xi8>
    %tmp_i8 = pto.alloc_tile : !pto.tile_buf<vec, 8x32xi8>
    %dst_i8 = pto.alloc_tile : !pto.tile_buf<vec, 8x32xi8, valid=8x1>
    pto.trowmax ins(%src_i8, %tmp_i8 : !pto.tile_buf<vec, 8x32xi8>, !pto.tile_buf<vec, 8x32xi8>) outs(%dst_i8 : !pto.tile_buf<vec, 8x32xi8, valid=8x1>)
    pto.trowmin ins(%src_i8, %tmp_i8 : !pto.tile_buf<vec, 8x32xi8>, !pto.tile_buf<vec, 8x32xi8>) outs(%dst_i8 : !pto.tile_buf<vec, 8x32xi8, valid=8x1>)

    %src_ui8 = pto.alloc_tile : !pto.tile_buf<vec, 8x32xui8>
    %tmp_ui8 = pto.alloc_tile : !pto.tile_buf<vec, 8x32xui8>
    %dst_ui8 = pto.alloc_tile : !pto.tile_buf<vec, 8x32xui8, valid=8x1>
    pto.trowmax ins(%src_ui8, %tmp_ui8 : !pto.tile_buf<vec, 8x32xui8>, !pto.tile_buf<vec, 8x32xui8>) outs(%dst_ui8 : !pto.tile_buf<vec, 8x32xui8, valid=8x1>)
    pto.trowmin ins(%src_ui8, %tmp_ui8 : !pto.tile_buf<vec, 8x32xui8>, !pto.tile_buf<vec, 8x32xui8>) outs(%dst_ui8 : !pto.tile_buf<vec, 8x32xui8, valid=8x1>)

    %src_si8 = pto.alloc_tile : !pto.tile_buf<vec, 8x32xsi8>
    %tmp_si8 = pto.alloc_tile : !pto.tile_buf<vec, 8x32xsi8>
    %dst_si8 = pto.alloc_tile : !pto.tile_buf<vec, 8x32xsi8, valid=8x1>
    pto.trowmax ins(%src_si8, %tmp_si8 : !pto.tile_buf<vec, 8x32xsi8>, !pto.tile_buf<vec, 8x32xsi8>) outs(%dst_si8 : !pto.tile_buf<vec, 8x32xsi8, valid=8x1>)
    pto.trowmin ins(%src_si8, %tmp_si8 : !pto.tile_buf<vec, 8x32xsi8>, !pto.tile_buf<vec, 8x32xsi8>) outs(%dst_si8 : !pto.tile_buf<vec, 8x32xsi8, valid=8x1>)
    return
  }
}

// CHECK-LABEL: func.func @row_extremes_i8_ui8
// CHECK: pto.trowmax ins(%{{.*}}, %{{.*}} : !pto.tile_buf<vec, 8x32xi8>, !pto.tile_buf<vec, 8x32xi8>) outs(%{{.*}} : !pto.tile_buf<vec, 8x32xi8, valid=8x1>)
// CHECK: pto.trowmin ins(%{{.*}}, %{{.*}} : !pto.tile_buf<vec, 8x32xi8>, !pto.tile_buf<vec, 8x32xi8>) outs(%{{.*}} : !pto.tile_buf<vec, 8x32xi8, valid=8x1>)
// CHECK: pto.trowmax ins(%{{.*}}, %{{.*}} : !pto.tile_buf<vec, 8x32xui8>, !pto.tile_buf<vec, 8x32xui8>) outs(%{{.*}} : !pto.tile_buf<vec, 8x32xui8, valid=8x1>)
// CHECK: pto.trowmin ins(%{{.*}}, %{{.*}} : !pto.tile_buf<vec, 8x32xui8>, !pto.tile_buf<vec, 8x32xui8>) outs(%{{.*}} : !pto.tile_buf<vec, 8x32xui8, valid=8x1>)
// CHECK: pto.trowmax ins(%{{.*}}, %{{.*}} : !pto.tile_buf<vec, 8x32xsi8>, !pto.tile_buf<vec, 8x32xsi8>) outs(%{{.*}} : !pto.tile_buf<vec, 8x32xsi8, valid=8x1>)
// CHECK: pto.trowmin ins(%{{.*}}, %{{.*}} : !pto.tile_buf<vec, 8x32xsi8>, !pto.tile_buf<vec, 8x32xsi8>) outs(%{{.*}} : !pto.tile_buf<vec, 8x32xsi8, valid=8x1>)
