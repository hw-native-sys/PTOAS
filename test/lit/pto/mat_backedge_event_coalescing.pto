// RUN: ptoas --pto-arch=a5 --pto-level=level3 --enable-insert-sync --check-sync-self-coverage %s > %t.cpp
// RUN: FileCheck %s --check-prefix=MERGE < %t.cpp
// RUN: FileCheck %s --check-prefix=SAFE < %t.cpp
// RUN: FileCheck %s --check-prefix=FALLBACK < %t.cpp
// RUN: python3 %S/Inputs/check_mat_backedge_event_coalescing.py %t.cpp
// RUN: ptoas --pto-arch=a5 --pto-level=level3 --enable-insert-sync %S/Inputs/mat_backedge_dynamic.pto > %t.dynamic.cpp
// RUN: FileCheck %s --check-prefix=DYNAMIC < %t.dynamic.cpp
// RUN: python3 %S/Inputs/check_mat_backedge_event_coalescing.py %t.dynamic.cpp dynamic
// RUN: not ptoas --pto-arch=a5 --pto-level=level3 --enable-insert-sync --check-sync-self-coverage %S/Inputs/mat_backedge_dynamic.pto 2>&1 | FileCheck %s --check-prefix=DYNAMIC-G1
// RUN: ptoas --pto-arch=a5 --pto-level=level3 --enable-insert-sync %S/Inputs/mat_backedge_manual.pto > %t.manual.cpp
// RUN: python3 %S/Inputs/check_mat_backedge_event_coalescing.py %t.manual.cpp manual
// RUN: not ptoas --pto-arch=a5 --pto-level=level3 --enable-insert-sync --check-sync-self-coverage %S/Inputs/mat_backedge_manual.pto 2>&1 | FileCheck %s --check-prefix=MANUAL-G1
// Manual synchronization already suppresses automatic insertion for the whole
// function. Pin that behavior and its G1 rejection; do not claim auto coverage.
// MANUAL-G1: func=keep_explicit_event_id
// MANUAL-G1-SAME: uncovered=57
// MANUAL-G1: G1-self coverage: 57 dependency ordering(s)
// Dynamic Mat roots expose existing oracle limitations: a carried-key nest
// collision and five same-MTE2 WAW reports. Keep the exact failing gate while
// independently proving the emitted events for dynamic=65536 and 0/1/3/9 trips.
// DYNAMIC-G1: carried-edge-loop-collision func=keep_unknown_mat_address count=72
// DYNAMIC-G1: func=keep_unknown_mat_address
// DYNAMIC-G1-SAME: uncovered=5 (samepipe=5 crosspipe=0)
// DYNAMIC-G1: G1-self coverage: 5 dependency ordering(s)
// DYNAMIC-LABEL: AICORE void keep_unknown_mat_address(
// DYNAMIC: for (int64_t
// DYNAMIC: for (int64_t
// DYNAMIC: wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID[[DYN_CARRY:[0-7]]]);
// DYNAMIC-NEXT: TLOAD(
// DYNAMIC: // pto: %i5
// DYNAMIC: Tile<TileType::Mat, {{.*}}> [[DYN_TILE:v[0-9]+]]
// DYNAMIC: TASSIGN([[DYN_TILE]],
// DYNAMIC: TLOAD([[DYN_TILE]],
// DYNAMIC-NEXT: set_flag(PIPE_MTE2, PIPE_MTE1, EVENT_ID[[DYN_READY:[0-7]]]);
// DYNAMIC: wait_flag(PIPE_MTE2, PIPE_MTE1, EVENT_ID[[DYN_READY]]);
// DYNAMIC: // pto: %v1_5
// DYNAMIC: TEXTRACT({{v[0-9]+}}, [[DYN_TILE]],
// DYNAMIC-NEXT: set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID[[DYN_CARRY]]);
// DYNAMIC: ptoas_auto_sync_tail(PTOAutoSyncTailMode::kBarrierAll);
// RUN: sed 's/pto.target_arch = "a5"/pto.target_arch = "a2a3"/' %s > %t.a3.pto
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --check-sync-self-coverage %t.a3.pto > %t.a3.cpp
// RUN: FileCheck %s --check-prefix=MERGE < %t.a3.cpp
// RUN: FileCheck %s --check-prefix=SAFE < %t.a3.cpp
// RUN: FileCheck %s --check-prefix=FALLBACK < %t.a3.cpp
// RUN: python3 %S/Inputs/check_mat_backedge_event_coalescing.py %t.a3.cpp
// Three outer carried Mat lifetimes plus six inner lifetimes exceed the
// eight-event MTE1->MTE2 pool. Only after exhaustion may the last two inner
// releases share a token: wait before both TLOADs, set after both final reads.
// Every first-half read has already consumed its MTE2-ready wait, so the
// positive moved interval has no waits or hidden handshakes.
// The checker expands zero/one/three/nine K trips and repeated outputs.

!mat = !pto.tile_buf<mat, 64x64xf16, blayout=col_major, slayout=row_major, fractal=512>
!left = !pto.tile_buf<left, 64x32xf16, blayout=col_major, slayout=row_major, fractal=512>
module attributes {pto.target_arch = "a5"} {
  // MERGE-LABEL: AICORE void coalesce_pressure(
  // MERGE: // pto: %i4
  // MERGE: Tile<TileType::Mat, {{.*}}> [[I4:v[0-9]+]]
  // MERGE: TASSIGN([[I4]],
  // MERGE: wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID[[SHARED:[0-7]]]);
  // MERGE-NEXT: TLOAD([[I4]],
  // MERGE: // pto: %i5
  // MERGE: Tile<TileType::Mat, {{.*}}> [[I5:v[0-9]+]]
  // MERGE: TLOAD([[I5]],
  // MERGE: TEXTRACT({{v[0-9]+}}, [[I4]],
  // MERGE: TEXTRACT({{v[0-9]+}}, [[I5]],
  // MERGE: TEXTRACT({{v[0-9]+}}, [[I4]],
  // MERGE-NOT: set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID[[SHARED]]);
  // MERGE: TEXTRACT({{v[0-9]+}}, [[I5]],
  // MERGE-NEXT: set_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID[[SHARED]]);
  // MERGE: wait_flag(PIPE_MTE1, PIPE_MTE2, EVENT_ID[[SHARED]]);
  // SAFE-LABEL: AICORE void coalesce_pressure(
  // SAFE-NOT: pipe_barrier(PIPE_ALL);
  // SAFE: ptoas_auto_sync_tail(PTOAutoSyncTailMode::kBarrierAll);
  func.func @coalesce_pressure(%src: !pto.ptr<f16>, %trips: index, %condition: i1, %dynamic: i64) attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %z = arith.constant 0 : index
    %one = arith.constant 1 : index
    %three = arith.constant 3 : index
    %rows = arith.constant 64 : index
    %half = arith.constant 32 : index
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 8192 : i64
    %a2 = arith.constant 16384 : i64
    %a3 = arith.constant 24576 : i64
    %a4 = arith.constant 32768 : i64
    %a5 = arith.constant 40960 : i64
    %a6 = arith.constant 49152 : i64
    %a7 = arith.constant 57344 : i64
    %a8 = arith.constant 65536 : i64
    %l0 = arith.constant 0 : i64
    %l1 = arith.constant 4096 : i64
    %l2 = arith.constant 8192 : i64
    %l3 = arith.constant 12288 : i64
    %l4 = arith.constant 16384 : i64
    %l5 = arith.constant 20480 : i64
    %l6 = arith.constant 24576 : i64
    %l7 = arith.constant 28672 : i64
    %l8 = arith.constant 32768 : i64
    %l9 = arith.constant 36864 : i64
    %l10 = arith.constant 40960 : i64
    %l11 = arith.constant 45056 : i64
    %sv = pto.make_tensor_view %src, shape = [%rows, %rows], strides = [%rows, %one] : !pto.tensor_view<?x?xf16>
    %ps = pto.partition_view %sv, offsets = [%z, %z], sizes = [%rows, %rows] : !pto.tensor_view<?x?xf16> -> !pto.partition_tensor_view<64x64xf16>
    scf.for %o = %z to %three step %one {
      %h0 = pto.alloc_tile addr = %a0 : !mat
      pto.tload ins(%ps : !pto.partition_tensor_view<64x64xf16>) outs(%h0 : !mat)
      %h1 = pto.alloc_tile addr = %a1 : !mat
      pto.tload ins(%ps : !pto.partition_tensor_view<64x64xf16>) outs(%h1 : !mat)
      %h2 = pto.alloc_tile addr = %a2 : !mat
      pto.tload ins(%ps : !pto.partition_tensor_view<64x64xf16>) outs(%h2 : !mat)
      %hl0 = pto.alloc_tile addr = %l0 : !left
      pto.textract ins(%h0, %z, %z : !mat, index, index) outs(%hl0 : !left)
      %hl1 = pto.alloc_tile addr = %l1 : !left
      pto.textract ins(%h1, %z, %z : !mat, index, index) outs(%hl1 : !left)
      %hl2 = pto.alloc_tile addr = %l2 : !left
      pto.textract ins(%h2, %z, %z : !mat, index, index) outs(%hl2 : !left)
      scf.for %k = %z to %trips step %one {
        %i0 = pto.alloc_tile addr = %a3 : !mat
        pto.tload ins(%ps : !pto.partition_tensor_view<64x64xf16>) outs(%i0 : !mat)
        %i1 = pto.alloc_tile addr = %a4 : !mat
        pto.tload ins(%ps : !pto.partition_tensor_view<64x64xf16>) outs(%i1 : !mat)
        %i2 = pto.alloc_tile addr = %a5 : !mat
        pto.tload ins(%ps : !pto.partition_tensor_view<64x64xf16>) outs(%i2 : !mat)
        %i3 = pto.alloc_tile addr = %a6 : !mat
        pto.tload ins(%ps : !pto.partition_tensor_view<64x64xf16>) outs(%i3 : !mat)
        %i4 = pto.alloc_tile addr = %a7 : !mat
        pto.tload ins(%ps : !pto.partition_tensor_view<64x64xf16>) outs(%i4 : !mat)
        %i5 = pto.alloc_tile addr = %a8 : !mat
        pto.tload ins(%ps : !pto.partition_tensor_view<64x64xf16>) outs(%i5 : !mat)
        %v0_0 = pto.alloc_tile addr = %l0 : !left
        pto.textract ins(%i0, %z, %z : !mat, index, index) outs(%v0_0 : !left)
        %v0_1 = pto.alloc_tile addr = %l1 : !left
        pto.textract ins(%i1, %z, %z : !mat, index, index) outs(%v0_1 : !left)
        %v0_2 = pto.alloc_tile addr = %l2 : !left
        pto.textract ins(%i2, %z, %z : !mat, index, index) outs(%v0_2 : !left)
        %v0_3 = pto.alloc_tile addr = %l3 : !left
        pto.textract ins(%i3, %z, %z : !mat, index, index) outs(%v0_3 : !left)
        %v0_4 = pto.alloc_tile addr = %l4 : !left
        pto.textract ins(%i4, %z, %z : !mat, index, index) outs(%v0_4 : !left)
        %v0_5 = pto.alloc_tile addr = %l5 : !left
        pto.textract ins(%i5, %z, %z : !mat, index, index) outs(%v0_5 : !left)
        %v1_0 = pto.alloc_tile addr = %l6 : !left
        pto.textract ins(%i0, %z, %half : !mat, index, index) outs(%v1_0 : !left)
        %v1_1 = pto.alloc_tile addr = %l7 : !left
        pto.textract ins(%i1, %z, %half : !mat, index, index) outs(%v1_1 : !left)
        %v1_2 = pto.alloc_tile addr = %l8 : !left
        pto.textract ins(%i2, %z, %half : !mat, index, index) outs(%v1_2 : !left)
        %v1_3 = pto.alloc_tile addr = %l9 : !left
        pto.textract ins(%i3, %z, %half : !mat, index, index) outs(%v1_3 : !left)
        %v1_4 = pto.alloc_tile addr = %l10 : !left
        pto.textract ins(%i4, %z, %half : !mat, index, index) outs(%v1_4 : !left)
        %v1_5 = pto.alloc_tile addr = %l11 : !left
        pto.textract ins(%i5, %z, %half : !mat, index, index) outs(%v1_5 : !left)
      }
    }
    return
  }
  // FALLBACK-LABEL: AICORE void keep_interval_ready_wait(
  // FALLBACK: pipe_barrier(PIPE_ALL);
  // FALLBACK: ptoas_auto_sync_tail(PTOAutoSyncTailMode::kBarrierAll);
  func.func @keep_interval_ready_wait(%src: !pto.ptr<f16>, %trips: index, %condition: i1, %dynamic: i64) attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %z = arith.constant 0 : index
