// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a2 --pto-backend=emitc --pto-level=level3 %t/index.pto 2>&1 | FileCheck %s
// RUN: not ptoas --pto-arch=a3 --pto-backend=emitc --pto-level=level3 %t/index.pto 2>&1 | FileCheck %s
// RUN: not ptoas --pto-arch=a3 --pto-backend=emitc --pto-level=level3 %t/compare.pto 2>&1 | FileCheck %s
// RUN: not ptoas --pto-arch=a5 --pto-backend=emitc --pto-level=level3 %t/compare.pto 2>&1 | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-backend=emitc --pto-level=level3 %t/index.pto | FileCheck %s --check-prefix=A5

//--- index.pto

module {
  func.func @tgather_a2a3_index_missing_tmp() {
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 128 : i64
    %a2 = arith.constant 256 : i64
    %src = pto.alloc_tile addr = %a0 : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %indices = pto.alloc_tile addr = %a1 : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile addr = %a2 : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tgather ins(%src, %indices : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
                outs(%dst : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }

}

//--- compare.pto
module {
  func.func @tgather_compare_missing_tmp() {
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 128 : i64
    %a2 = arith.constant 256 : i64
    %key = arith.constant 1.0 : f32
    %src = pto.alloc_tile addr = %a0 : !pto.tile_buf<vec, 1x32xf32>
    %dst = pto.alloc_tile addr = %a1 : !pto.tile_buf<vec, 1x32xi32>
    %count = pto.alloc_tile addr = %a2 : !pto.tile_buf<vec, 1x8xi32>
    pto.tgather ins(%src, %key : !pto.tile_buf<vec, 1x32xf32>, f32)
               outs(%dst, %count : !pto.tile_buf<vec, 1x32xi32>, !pto.tile_buf<vec, 1x8xi32>)
    return
  }
}

// CHECK: error: 'pto.tgather' op requires explicit tmp when PlanMemory is skipped
// A5: TGATHER({{[^,)]+}}, {{[^,)]+}}, {{[^,)]+}});
