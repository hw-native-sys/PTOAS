// RUN: ptoas --pto-arch=a5 --pto-level=level2 %s | FileCheck %s

module {
  func.func @tcvt_fp4_nd_32x512() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=32, cols=256, v_row=32, v_col=256, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=32, cols=512, v_row=32, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>
    pto.tcvt ins(%src : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=32, cols=256, v_row=32, v_col=256, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=32, cols=512, v_row=32, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>)
    return
  }
  func.func @tcvt_fp4_nd_padded() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=7, cols=160, v_row=5, v_col=129, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=11, cols=384, v_row=5, v_col=258, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>
    pto.tcvt ins(%src : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=7, cols=160, v_row=5, v_col=129, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=11, cols=384, v_row=5, v_col=258, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>)
    return
  }
  func.func @tcvt_fp4_nd_minimum() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>
    pto.tcvt ins(%src : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>)
    return
  }
  func.func @tcvt_fp4_nd_dynamic_rows(%rows: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %src = pto.alloc_tile valid_row = %rows : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=7, cols=160, v_row=?, v_col=129, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>
    %dst = pto.alloc_tile valid_row = %rows : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=11, cols=384, v_row=?, v_col=258, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>
    pto.tcvt ins(%src : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=7, cols=160, v_row=?, v_col=129, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=11, cols=384, v_row=?, v_col=258, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>)
    return
  }
  func.func @tcvt_fp4_direct_subview() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %parent = pto.alloc_tile : !pto.tile_buf<vec, 7x160x!pto.f4E2M1x2>
    %src = pto.subview %parent[%c0, %c0] sizes [5, 160] : !pto.tile_buf<vec, 7x160x!pto.f4E2M1x2>
      -> !pto.tile_buf<vec, 5x160x!pto.f4E2M1x2, valid=5x129>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 11x384xf8E4M3FN, valid=5x258>
    pto.tcvt ins(%src : !pto.tile_buf<vec, 5x160x!pto.f4E2M1x2, valid=5x129>)
      outs(%dst : !pto.tile_buf<vec, 11x384xf8E4M3FN, valid=5x258>)
    return
  }
  func.func @tcvt_existing_subview() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %parent = pto.alloc_tile : !pto.tile_buf<vec, 16x128xf32>
    %src = pto.subview %parent[%c0, %c0] sizes [5, 128] : !pto.tile_buf<vec, 16x128xf32>
      -> !pto.tile_buf<vec, 5x128xf32, valid=3x128>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 5x128xf16, valid=3x128>
    pto.tcvt ins(%src : !pto.tile_buf<vec, 5x128xf32, valid=3x128>)
      outs(%dst : !pto.tile_buf<vec, 5x128xf16, valid=3x128>)
    return
  }

}

// CHECK-LABEL: AICORE void tcvt_fp4_nd_32x512(
// CHECK: Tile<TileType::Vec, float4_e2m1x2_t, 32, 512, BLayout::RowMajor, 32, 512, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>
// CHECK: Tile<TileType::Vec, float8_e4m3_t, 32, 512, BLayout::RowMajor, 32, 512, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>
// CHECK: TCVT({{[^,]+}}, {{[^,]+}}, {{[^,]+}}, {{[^,()]+}});
// CHECK-LABEL: AICORE void tcvt_fp4_nd_padded(
// CHECK: Tile<TileType::Vec, float4_e2m1x2_t, 7, 320, BLayout::RowMajor, 5, 258, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>
// CHECK: Tile<TileType::Vec, float8_e4m3_t, 11, 384, BLayout::RowMajor, 5, 258, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>
// CHECK: TCVT({{[^,]+}}, {{[^,]+}}, {{[^,]+}}, {{[^,()]+}});
// CHECK-LABEL: AICORE void tcvt_fp4_nd_minimum(
// CHECK: Tile<TileType::Vec, float4_e2m1x2_t, 1, 64, BLayout::RowMajor, 1, 64, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>
// CHECK: Tile<TileType::Vec, float8_e4m3_t, 1, 64, BLayout::RowMajor, 1, 64, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>
// CHECK: TCVT({{[^,]+}}, {{[^,]+}}, {{[^,]+}}, {{[^,()]+}});
// CHECK-LABEL: AICORE void tcvt_fp4_nd_dynamic_rows(
// CHECK: Tile<TileType::Vec, float4_e2m1x2_t, 7, 320, BLayout::RowMajor, -1, 258, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>
// CHECK: Tile<TileType::Vec, float8_e4m3_t, 11, 384, BLayout::RowMajor, -1, 258, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>
// CHECK: TCVT({{[^,]+}}, {{[^,]+}}, {{[^,]+}}, {{[^,()]+}});
// CHECK-LABEL: AICORE void tcvt_fp4_direct_subview(
// CHECK: Tile<TileType::Vec, float4_e2m1x2_t, 5, 320, BLayout::RowMajor, 5, 258,
// CHECK: Tile<TileType::Vec, float8_e4m3_t, 11, 384, BLayout::RowMajor, 5, 258,
// CHECK: TCVT(
// CHECK-LABEL: AICORE void tcvt_existing_subview(
// CHECK: Tile<TileType::Vec, float, 5, 128, BLayout::RowMajor, 3, 128,
// CHECK: Tile<TileType::Vec, half, 5, 128, BLayout::RowMajor, 3, 128,
// CHECK: TCVT(
