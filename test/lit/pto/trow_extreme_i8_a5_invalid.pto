// Issue #1599: the A5 row-extreme whitelist accepts 8-bit integers but bf16
// stays outside it. One failing op per file: ptoas stops reporting verifier
// errors after the first failure in some build variants, so multi-error
// CHECK sequences are not reliable here.

// RUN: not ptoas --pto-arch=a5 --pto-level=level2 --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func @trowmax_bf16_still_rejected() {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 8x32xbf16>
    %tmp = pto.alloc_tile : !pto.tile_buf<vec, 8x32xbf16>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 8x32xbf16, valid=8x1>
    pto.trowmax ins(%src, %tmp : !pto.tile_buf<vec, 8x32xbf16>, !pto.tile_buf<vec, 8x32xbf16>) outs(%dst : !pto.tile_buf<vec, 8x32xbf16, valid=8x1>)
    return
  }
}

// CHECK: error: 'pto.trowmax' op expects A5 trowmax element type to be i8/i16/i32/f16/f32
