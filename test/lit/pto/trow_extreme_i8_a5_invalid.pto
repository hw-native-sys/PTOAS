// Issue #1599: on A5 only the row extremes (trowmax/trowmin) accept 8-bit
// integers. Row sums keep the shared whitelist, row products keep their
// arch-specific message, and bf16 stays outside even the widened row-extreme
// whitelist; the final i8 trowmax verifies cleanly.

// RUN: not ptoas --pto-arch=a5 --pto-level=level2 --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func @trowsum_i8_still_rejected() {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 8x32xi8>
    %tmp = pto.alloc_tile : !pto.tile_buf<vec, 8x32xi8>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 8x32xi8, valid=8x1>
    pto.trowsum ins(%src, %tmp : !pto.tile_buf<vec, 8x32xi8>, !pto.tile_buf<vec, 8x32xi8>) outs(%dst : !pto.tile_buf<vec, 8x32xi8, valid=8x1>)
    return
  }

  func.func @trowprod_i8_still_rejected() {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 8x32xi8>
    %tmp = pto.alloc_tile : !pto.tile_buf<vec, 8x32xi8>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 8x32xi8, valid=8x1>
    pto.trowprod ins(%src, %tmp : !pto.tile_buf<vec, 8x32xi8>, !pto.tile_buf<vec, 8x32xi8>) outs(%dst : !pto.tile_buf<vec, 8x32xi8, valid=8x1>)
    return
  }

  func.func @trowmax_bf16_still_rejected() {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 8x32xbf16>
    %tmp = pto.alloc_tile : !pto.tile_buf<vec, 8x32xbf16>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 8x32xbf16, valid=8x1>
    pto.trowmax ins(%src, %tmp : !pto.tile_buf<vec, 8x32xbf16>, !pto.tile_buf<vec, 8x32xbf16>) outs(%dst : !pto.tile_buf<vec, 8x32xbf16, valid=8x1>)
    return
  }

  func.func @trowmax_i8_ok_on_a5() {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 8x32xi8>
    %tmp = pto.alloc_tile : !pto.tile_buf<vec, 8x32xi8>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 8x32xi8, valid=8x1>
    pto.trowmax ins(%src, %tmp : !pto.tile_buf<vec, 8x32xi8>, !pto.tile_buf<vec, 8x32xi8>) outs(%dst : !pto.tile_buf<vec, 8x32xi8, valid=8x1>)
    return
  }
}

// CHECK: error: 'pto.trowsum' op expects element type to be i16/i32/f16/f32
// CHECK: error: 'pto.trowprod' op expects A5 trowprod element type to be i16/i32/f16/f32
// CHECK: error: 'pto.trowmax' op expects A5 trowmax element type to be i8/i16/i32/f16/f32
// CHECK-NOT: error: 'pto.trowmax' op expects element type to be
