// RUN: ptoas --pto-arch=a5 --enable-insert-sync --emit-pto-ir %s 2>&1 | FileCheck %s

!left = !pto.tile_buf<loc=left, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=row_major, fractal=512, pad=0>
!right = !pto.tile_buf<loc=right, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=col_major, fractal=512, pad=0>
!acc = !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=1024, pad=0>
!out = !pto.partition_tensor_view<32x32xf32>

module attributes {pto.target_arch = "a5"} {
  // C: while's before region is token-neutral and the after region is one
  // balanced publish/consume. The exit state equals the entry state, so both
  // the same-iteration and the loop-carried ACC events are covered.
  func.func @uf_while_closed(%out: !out) {
    %c0 = arith.constant 0 : index
    %c4 = arith.constant 4 : index
    %c1 = arith.constant 1 : index
    %lhs = pto.alloc_tile : !left
    %rhs = pto.alloc_tile : !right
    %acc = pto.alloc_tile : !acc
    %state = scf.while (%i = %c0) : (index) -> index {
      %keep = arith.cmpi slt, %i, %c4 : index
      scf.condition(%keep) %i : index
    } do {
    ^bb0(%i: index):
      pto.tmatmul ins(%lhs, %rhs : !left, !right) outs(%acc : !acc)
        {accPhase = #pto<acc_phase final>}
      pto.tstore ins(%acc : !acc) outs(%out : !out)
        {stPhase = #pto<st_phase final>}
      %next = arith.addi %i, %c1 : index
      scf.yield %next : index
    }
    return
  }

  // C: the publish lives in before and the consume in after. The loop exits
  // from before, so the exit state is Set while the entry state is Clear; no
  // hand-off may be removed.
  func.func @uf_while_exit_mismatch(%out: !out) {
    %c0 = arith.constant 0 : index
    %c4 = arith.constant 4 : index
    %c1 = arith.constant 1 : index
    %lhs = pto.alloc_tile : !left
    %rhs = pto.alloc_tile : !right
    %acc = pto.alloc_tile : !acc
    %state = scf.while (%i = %c0) : (index) -> index {
      pto.tmatmul ins(%lhs, %rhs : !left, !right) outs(%acc : !acc)
        {accPhase = #pto<acc_phase final>}
      %keep = arith.cmpi slt, %i, %c4 : index
      scf.condition(%keep) %i : index
    } do {
    ^bb0(%i: index):
      pto.tstore ins(%acc : !acc) outs(%out : !out)
        {stPhase = #pto<st_phase final>}
      %next = arith.addi %i, %c1 : index
      scf.yield %next : index
    }
    return
  }
}

// CHECK-LABEL: func.func @uf_while_closed
// CHECK-NOT: pto.set_flag[<PIPE_M>, <PIPE_FIX>
// CHECK-NOT: pto.set_flag[<PIPE_FIX>, <PIPE_M>
// CHECK-NOT: pto.wait_flag[<PIPE_M>, <PIPE_FIX>
// CHECK-NOT: pto.wait_flag[<PIPE_FIX>, <PIPE_M>
// CHECK-LABEL: func.func @uf_while_exit_mismatch
// CHECK: pto.set_flag[<PIPE_M>, <PIPE_FIX>
// CHECK: pto.wait_flag[<PIPE_M>, <PIPE_FIX>
