// RUN: not ptoas --pto-arch=a3 --pto-level=level2 --plan-memory-allocator=interval --emit-pto-ir --mlir-print-ir-after=pto-plan-memory %s -o /dev/null 2>&1 | FileCheck %s
module {
  func.func @overflow(%gm: !pto.partition_tensor_view<128x256xf32>) {
    %fifo = pto.reserve_buffer {name = "fifo", size = 131072, location = #pto.address_space<vec>, auto = true} -> i32
    %tile = pto.alloc_tile : !pto.tile_buf<vec, 128x256xf32>
    pto.tload ins(%gm : !pto.partition_tensor_view<128x256xf32>) outs(%tile : !pto.tile_buf<vec, 128x256xf32>)
    pto.tstore ins(%tile : !pto.tile_buf<vec, 128x256xf32>) outs(%gm : !pto.partition_tensor_view<128x256xf32>)
    return
  }
}
// CHECK: vec overflow: cannot place a 131072-byte buffer
// CHECK: capacity: 196608 bytes
// CHECK: already planned: 131072 bytes
// CHECK: largest free hole: 65536 bytes
// CHECK: peak live (linear lifetime estimate): 262144 bytes
