// CHECK-NEXT:  TSTORE(

// MSCATTER ignores the view strides, so the window proof must not fire and a
// real sync must separate the two writes. The set_flag lands in the cube
// section and the wait_flag in the vector one, so no CHECK-NEXT here.
// CHECK-LABEL: AICORE void gm_window_tstore_mscatter(
// CHECK:       TSTORE(
// CHECK:       set_flag(PIPE_FIX, PIPE_MTE3, EVENT_ID0);
// CHECK:       wait_flag(PIPE_FIX, PIPE_MTE3, EVENT_ID0);
// CHECK:       MSCATTER(

// A narrow slice nested inside a wide one overlaps byte-for-byte
// (contigA + contigB = 576 <= stride 1024, so the lattice check runs); the
// direction-corrected residue test keeps the sync.
// CHECK-LABEL: AICORE void gm_window_nested_narrow(
// CHECK:       TSTORE(
// CHECK:       pipe_barrier(PIPE_MTE3);
// CHECK-NEXT:  TSTORE(

// A view built on a shifted pointer (pto.addptr) gets no window at all; the
// sync against the root-based view survives.
// CHECK-LABEL: AICORE void gm_window_shifted_base(
// CHECK:       TSTORE(
