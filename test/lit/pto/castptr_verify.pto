// RUN: pto-test-opt -split-input-file -verify-diagnostics %s

module {
  func.func @supported_pointer_elements(%addr: i64) {
    %f8e8m0 = pto.castptr %addr : i64 -> !pto.ptr<!pto.f8E8M0, l1>
    %hif8x2 = pto.castptr %addr : i64 -> !pto.ptr<!pto.hif8x2, ub>
    %bf16x2 = pto.castptr %addr : i64 -> !pto.ptr<!pto.bf16x2, ub>
    %vector = pto.castptr %addr : i64 -> !pto.ptr<vector<4xf32>, ub>
    %packed_vector = pto.castptr %addr : i64 -> !pto.ptr<vector<2xf8E4M3FN>, ub>
    %signed = pto.castptr %addr : i64 -> !pto.ptr<si32, ub>
    return
  }
}

// -----

module {
  func.func @invalid_result_aggregate(%addr: i64) {
    // expected-error@+1 {{result pointer element type is not supported by PTO: 'tensor<2xf32>'}}
    %ptr = pto.castptr %addr : i64 -> !pto.ptr<tensor<2xf32>, ub>
    return
  }
}

// -----

module {
  func.func @invalid_input_aggregate(%ptr: !pto.ptr<tensor<2xf32>, ub>) {
    // expected-error@+1 {{input pointer element type is not supported by PTO: 'tensor<2xf32>'}}
    %addr = pto.castptr %ptr : !pto.ptr<tensor<2xf32>, ub> -> i64
    return
  }
}

// -----

module {
  func.func @invalid_multidimensional_vector(%addr: i64) {
    // expected-error@+1 {{result pointer element type is not supported by PTO: 'vector<2x2xf32>'}}
    %ptr = pto.castptr %addr : i64 -> !pto.ptr<vector<2x2xf32>, ub>
    return
  }
}

// -----

module {
  func.func @invalid_scalable_vector(%addr: i64) {
    // expected-error@+1 {{result pointer element type is not supported by PTO: 'vector<[2]xf32>'}}
    %ptr = pto.castptr %addr : i64 -> !pto.ptr<vector<[2]xf32>, ub>
    return
  }
}

// -----

module {
  func.func @invalid_signed_address(%addr: si64) {
    // expected-error@+1 {{integer address input must be signless i64}}
    %ptr = pto.castptr %addr : si64 -> !pto.ptr<i32, ub>
    return
  }
}

// -----

module {
  func.func @invalid_unsigned_address(%ptr: !pto.ptr<i32, ub>) {
    // expected-error@+1 {{integer address result must be signless i64}}
    %addr = pto.castptr %ptr : !pto.ptr<i32, ub> -> ui64
    return
  }
}
