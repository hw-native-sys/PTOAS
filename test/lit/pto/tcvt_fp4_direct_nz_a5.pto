// RUN: ptoas --pto-arch=a5 --pto-level=level2 %s | FileCheck %s

module {
  func.func @tcvt_fp4_nz_32x512() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=32, cols=256, v_row=32, v_col=256, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=32, cols=512, v_row=32, v_col=512, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=0>
    pto.tcvt ins(%src : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=32, cols=256, v_row=32, v_col=256, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=32, cols=512, v_row=32, v_col=512, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=0>)
    return
  }
  func.func @tcvt_fp4_nz_padded() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=7, cols=160, v_row=5, v_col=129, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=32, cols=384, v_row=5, v_col=258, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=0>
    pto.tcvt ins(%src : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=7, cols=160, v_row=5, v_col=129, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=32, cols=384, v_row=5, v_col=258, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=0>)
    return
  }
  func.func @tcvt_fp4_nz_normal() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %src = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=7, cols=160, v_row=5, v_col=129, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=32, cols=384, v_row=5, v_col=258, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=1>
    pto.tcvt ins(%src : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=7, cols=160, v_row=5, v_col=129, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=32, cols=384, v_row=5, v_col=258, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=1>)
    return
  }
  func.func @tcvt_fp4_nz_dynamic_rows(%rows: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %src = pto.alloc_tile valid_row = %rows : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=7, cols=160, v_row=?, v_col=129, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>
    %dst = pto.alloc_tile valid_row = %rows : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=32, cols=384, v_row=?, v_col=258, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=1>
    pto.tcvt ins(%src : !pto.tile_buf<loc=vec, dtype=!pto.f4E2M1x2, rows=7, cols=160, v_row=?, v_col=129, blayout=row_major, slayout=none_box, fractal=512, pad=0, compact=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f8E4M3FN, rows=32, cols=384, v_row=?, v_col=258, blayout=col_major, slayout=row_major, fractal=512, pad=0, compact=1>)
    return
  }
}

// CHECK-LABEL: AICORE void tcvt_fp4_nz_32x512(
// CHECK: Tile<TileType::Vec, float4_e2m1x2_t, 32, 512, BLayout::RowMajor, 32, 512, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>
// CHECK: Tile<TileType::Vec, float8_e4m3_t, 32, 512, BLayout::ColMajor, 32, 512, SLayout::RowMajor, 512, PadValue::Null, CompactMode::Null>
// CHECK: TCVT({{[^,]+}}, {{[^,]+}}, {{[^,]+}}, {{[^,()]+}});
// CHECK-LABEL: AICORE void tcvt_fp4_nz_padded(
// CHECK: Tile<TileType::Vec, float4_e2m1x2_t, 7, 320, BLayout::RowMajor, 5, 258, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>
// CHECK: Tile<TileType::Vec, float8_e4m3_t, 32, 384, BLayout::ColMajor, 5, 258, SLayout::RowMajor, 512, PadValue::Null, CompactMode::Null>
// CHECK: TCVT({{[^,]+}}, {{[^,]+}}, {{[^,]+}}, {{[^,()]+}});
// CHECK-LABEL: AICORE void tcvt_fp4_nz_normal(
// CHECK: Tile<TileType::Vec, float4_e2m1x2_t, 7, 320, BLayout::RowMajor, 5, 258, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>
// CHECK: Tile<TileType::Vec, float8_e4m3_t, 32, 384, BLayout::ColMajor, 5, 258, SLayout::RowMajor, 512, PadValue::Null, CompactMode::Normal>
// CHECK: TCVT({{[^,]+}}, {{[^,]+}}, {{[^,]+}}, {{[^,()]+}});
// CHECK-LABEL: AICORE void tcvt_fp4_nz_dynamic_rows(
// CHECK: Tile<TileType::Vec, float4_e2m1x2_t, 7, 320, BLayout::RowMajor, -1, 258, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>
// CHECK: Tile<TileType::Vec, float8_e4m3_t, 32, 384, BLayout::ColMajor, -1, 258, SLayout::RowMajor, 512, PadValue::Null, CompactMode::Normal>
// CHECK: TCVT({{[^,]+}}, {{[^,]+}}, {{[^,]+}}, {{[^,()]+}});
