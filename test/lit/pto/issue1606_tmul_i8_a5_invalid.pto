// issue #1606: the TMUL A5 clause does not list 8-bit integers (unlike tmax and
// tsub), so the widened A5 whitelist must still reject them.
// RUN: not ptoas --pto-arch=a5 --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func private @tmul_i8_a5(
      %a: !pto.tile_buf<vec, 8x32xi8>, %b: !pto.tile_buf<vec, 8x32xi8>,
      %dst: !pto.tile_buf<vec, 8x32xi8>) {
    pto.tmul ins(%a, %b : !pto.tile_buf<vec, 8x32xi8>, !pto.tile_buf<vec, 8x32xi8>)
             outs(%dst : !pto.tile_buf<vec, 8x32xi8>)
    return
  }
}

// CHECK: error: 'pto.tmul' op expects A5 tmul element type to be i32/i16/f16/bf16/f32
