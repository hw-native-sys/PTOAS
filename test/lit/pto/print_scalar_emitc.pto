// The PrintOp verifier accepts a format string with exactly one conversion
// specifier whose kind matches the scalar operand type; the EmitC backend
// then lowers the op to a cce::printf call.

// RUN: ptoas --pto-arch=a3 --pto-backend=emitc %s | FileCheck %s

module {
  func.func @print_scalar_float() attributes {pto.entry} {
    %v = arith.constant 1.25 : f32
    pto.print ins("value = %f\n", %v : f32)
    return
  }

  func.func @print_scalar_int() attributes {pto.entry} {
    %c = arith.constant 42 : i32
    pto.print ins("count = %d\n", %c : i32)
    return
  }
}

// CHECK-LABEL: print_scalar_float
// CHECK: cce::printf
// CHECK-LABEL: print_scalar_int
// CHECK: cce::printf
