// RUN: not ptoas %s --pto-arch=a3 --pto-level=level2 2>&1 | FileCheck %s

!P = !pto.tile_buf<vec, 32x256xf32>
!W = !pto.tile_buf<vec, 16x128xf32>

module {
  func.func @mixed_strides(%cond: i1) -> i64 {
    %c0 = arith.constant 0 : index
    %a = pto.alloc_tile : !P
    %b = pto.alloc_tile : !W
    %window = pto.subview %a[%c0, %c0] sizes [16, 128] : !P -> !W
    // CHECK: cannot select tile descriptors with different physical types
    %result = scf.if %cond -> (!W) {
      scf.yield %window : !W
    } else {
      scf.yield %b : !W
    }
    %pointer = pto.tile_buf_addr %result : !W -> !pto.ptr<f32, vec>
    %address = pto.castptr %pointer : !pto.ptr<f32, vec> -> i64
    return %address : i64
  }
}
