// RUN: ptoas --pto-arch=a5 --enable-insert-sync --check-sync-self-coverage %s | FileCheck %s --check-prefixes=COMMON,A5
// RUN: ptoas --pto-arch=a5 %s | FileCheck %s --check-prefix=EXPLICIT
// RUN: sed 's/ {tf32_mode = #pto<tf32_mode round_[a-z]*>}//g' %s | ptoas --pto-arch=a3 --enable-insert-sync --check-sync-self-coverage | FileCheck %s --check-prefix=A3SYNC
// RUN: sed 's/ {tf32_mode = #pto<tf32_mode round_[a-z]*>}//g' %s | ptoas --pto-arch=a3 --enable-unified-sync --check-sync-self-coverage | FileCheck %s --check-prefix=A3SYNC

!left = !pto.tile_buf<loc=left, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
!right = !pto.tile_buf<loc=right, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=col_major, fractal=512, pad=0>
!acc = !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=1024, pad=0>
!bias = !pto.tile_buf<loc=bias, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>

module {
  func.func @chain(%a: !left, %b: !right, %c: !acc) {
    pto.tmatmul ins(%a, %b : !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    pto.tmatmul.acc ins(%c, %a, %b : !acc, !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    return
  }
  func.func @same_m(%a: !left, %b: !right, %c: !acc) {
    pto.tmatmul ins(%a, %b : !left, !right) outs(%c : !acc)
    pto.tmatmul.acc ins(%c, %a, %b : !acc, !left, !right) outs(%c : !acc)
    return
  }
  func.func @loop(%a: !left, %b: !right, %c: !acc, %n: index) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    scf.for %i = %zero to %n step %one {
    pto.tmatmul ins(%a, %b : !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    pto.tmatmul.acc ins(%c, %a, %b : !acc, !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    }
    return
  }
  func.func @mode_boundary(%a: !left, %b: !right, %c: !acc) {
    pto.tmatmul ins(%a, %b : !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    pto.tmatmul.acc ins(%c, %a, %b : !acc, !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_even>}
    pto.tmatmul ins(%a, %b : !left, !right) outs(%c : !acc)
    return
  }
  func.func @explicit_sync(%a: !left, %b: !right, %c: !acc) {
    pto.tmatmul ins(%a, %b : !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    pto.barrier #pto.pipe<PIPE_M>
    pto.set_flag [#pto.pipe<PIPE_M>, #pto.pipe<PIPE_FIX>, #pto.event<EVENT_ID0>]
    pto.wait_flag [#pto.pipe<PIPE_M>, #pto.pipe<PIPE_FIX>, #pto.event<EVENT_ID0>]
    pto.tmatmul.acc ins(%c, %a, %b : !acc, !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    return
  }
  func.func private @opaque()
  func.func @call_boundary(%a: !left, %b: !right, %c: !acc) {
    pto.tmatmul ins(%a, %b : !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    func.call @opaque() : () -> ()
    pto.tmatmul.acc ins(%c, %a, %b : !acc, !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    return
  }
  func.func @conditional(%a: !left, %b: !right, %c: !acc, %cond: i1) {
    scf.if %cond {
      pto.tmatmul ins(%a, %b : !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    } else {
      pto.tmatmul ins(%a, %b : !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    }
    return
  }

}

