// RUN: not ptoas --pto-arch=a5 --emit-pto-ir %s 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  // O1: only an ACC-source tmov drains the unit flag. A phase on an MTE move
  // must be rejected instead of being silently ignored.
  func.func @tmov_phase_non_acc(%src: !pto.tile_buf<loc=mat, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=row_major, fractal=512, pad=0>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %dst = pto.alloc_tile : !pto.tile_buf<loc=left, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=row_major, fractal=512, pad=0>
    pto.tmov ins(%src : !pto.tile_buf<loc=mat, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=row_major, fractal=512, pad=0>)
             outs(%dst : !pto.tile_buf<loc=left, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=row_major, fractal=512, pad=0>)
             {stPhase = #pto<st_phase final>}
    return
  }
}

// CHECK: a non-Unspecified stPhase requires an ACC source tile
