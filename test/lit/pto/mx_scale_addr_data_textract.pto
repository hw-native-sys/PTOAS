// RUN: pto-test-opt --pto-a5-normalize-tmov %s | FileCheck %s --check-prefix=IR --implicit-check-not=tget_scale_addr
// RUN: pto-test-opt --pto-a5-normalize-tmov %s > %t.once
// RUN: pto-test-opt --pto-a5-normalize-tmov %t.once > %t.twice
// RUN: diff %t.once %t.twice
// RUN: ptoas --pto-arch=a5 --pto-level=level3 --enable-insert-sync %s | FileCheck %s --check-prefix=CPP --implicit-check-not=GetScaleAddr

// Real K slicing fills both data handles with TEXTRACT. These payload writes
// preserve the independently allocated handle address, including the RHS
// NZ-to-ZN conversion. Test both 0/32768 data slots and their 0/2048 scales.
!left = !pto.tile_buf<left, 64x128xf8E4M3FN, blayout=col_major, slayout=row_major, fractal=512>
!right = !pto.tile_buf<right, 128x256xf8E4M3FN, slayout=col_major, fractal=512>
!lmat = !pto.tile_buf<mat, 64x256xf8E4M3FN, blayout=col_major, slayout=row_major, fractal=512>
!rmat = !pto.tile_buf<mat, 256x256xf8E4M3FN, blayout=col_major, slayout=row_major, fractal=512>
!lm = !pto.tile_buf<mat, 64x8x!pto.f8E8M0, slayout=row_major, fractal=32>
!rm = !pto.tile_buf<mat, 8x256x!pto.f8E8M0, blayout=col_major, slayout=col_major, fractal=32>
!ls = !pto.tile_buf<scaling, 64x4x!pto.f8E8M0, slayout=row_major, fractal=32>
!rs = !pto.tile_buf<scaling, 4x256x!pto.f8E8M0, blayout=col_major, slayout=col_major, fractal=32>
!acc = !pto.tile_buf<acc, 64x256xf32, blayout=col_major, slayout=row_major, fractal=1024>

module attributes {pto.target_arch = "a5"} {
  // IR-LABEL: func.func @split_k256_data_extracts(
  // Anchor past the original zero data-address constant: the fresh folded
  // scale constant is inserted immediately before its allocation below.
  // IR: %[[DATA1A:.*]] = arith.constant 32768 : i64
  // IR: %{{.*}} = pto.alloc_tile addr = %[[DATA1A]] {{.*}}!pto.tile_buf<right,
  // IR-NEXT: %[[LS0A:.*]] = arith.constant 0 : i64
  // IR-NEXT: %[[LS0:.*]] = pto.alloc_tile addr = %[[LS0A]] {{.*}}!pto.tile_buf<scaling, 64x4x
  // IR: %[[RS0A:.*]] = arith.constant 0 : i64
  // IR-NEXT: %[[RS0:.*]] = pto.alloc_tile addr = %[[RS0A]] {{.*}}!pto.tile_buf<scaling, 4x256x
  // IR: %[[LS1A:.*]] = arith.constant 2048 : i64
  // IR-NEXT: %[[LS1:.*]] = pto.alloc_tile addr = %[[LS1A]] {{.*}}!pto.tile_buf<scaling, 64x4x
  // IR: %[[RS1A:.*]] = arith.constant 2048 : i64
  // IR-NEXT: %[[RS1:.*]] = pto.alloc_tile addr = %[[RS1A]] {{.*}}!pto.tile_buf<scaling, 4x256x
  // IR: pto.textract {{.*}}outs(%[[L0:.*]] : !pto.tile_buf<left,
  // IR-NEXT: pto.textract {{.*}}outs(%[[R0:.*]] : !pto.tile_buf<right,
  // IR-NEXT: pto.textract {{.*}}outs(%[[LS0]]
  // IR-NEXT: pto.textract {{.*}}outs(%[[RS0]]
  // IR-NEXT: pto.tmatmul.mx ins(%[[L0]], %[[LS0]], %[[R0]], %[[RS0]]
  // IR-NEXT: pto.textract {{.*}}outs(%[[L1:.*]] : !pto.tile_buf<left,
  // IR-NEXT: pto.textract {{.*}}outs(%[[R1:.*]] : !pto.tile_buf<right,
  // IR-NEXT: pto.textract {{.*}}outs(%[[LS1]]
  // IR-NEXT: pto.textract {{.*}}outs(%[[RS1]]
  // IR-NEXT: pto.tmatmul.mx.acc ins(%{{.*}}, %[[L1]], %[[LS1]], %[[R1]], %[[RS1]]
  // IR-NEXT: return
  // CPP-LABEL: AICORE void split_k256_data_extracts(
  // CPP: TEXTRACT(
  // CPP: TEXTRACT(
  // CPP: TEXTRACT(
  // CPP: TEXTRACT(
  // CPP: set_flag(PIPE_MTE1, PIPE_M,
  // CPP: wait_flag(PIPE_MTE1, PIPE_M,
  // CPP: TMATMUL_MX(
  // CPP: TEXTRACT(
  // CPP: TEXTRACT(
  // CPP: TEXTRACT(
  // CPP: TEXTRACT(
  // CPP: set_flag(PIPE_MTE1, PIPE_M,
  // CPP: wait_flag(PIPE_MTE1, PIPE_M,
  // CPP: TMATMUL_MX(
  func.func @split_k256_data_extracts() attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %z = arith.constant 0 : i64
    %slot1 = arith.constant 32768 : i64
    %old_scale = arith.constant 1024 : i64
    %rmat_addr = arith.constant 65536 : i64
    %lm_addr = arith.constant 131072 : i64
    %rm_addr = arith.constant 131584 : i64
    %zi = arith.constant 0 : index
    %half = arith.constant 128 : index
    %four = arith.constant 4 : index
    %lmat = pto.alloc_tile addr = %z : !lmat
    %rmat = pto.alloc_tile addr = %rmat_addr : !rmat
    %lm = pto.alloc_tile addr = %lm_addr : !lm
    %rm = pto.alloc_tile addr = %rm_addr : !rm
    %left0 = pto.alloc_tile addr = %z : !left
    %right0 = pto.alloc_tile addr = %z : !right
    %left1 = pto.alloc_tile addr = %slot1 : !left
    %right1 = pto.alloc_tile addr = %slot1 : !right
    %ls0 = pto.alloc_tile addr = %old_scale : !ls
    %rs0 = pto.alloc_tile addr = %old_scale : !rs
    %ls1 = pto.alloc_tile addr = %old_scale : !ls
    %rs1 = pto.alloc_tile addr = %old_scale : !rs
    %acc = pto.alloc_tile addr = %z : !acc
    pto.textract ins(%lmat, %zi, %zi : !lmat, index, index) outs(%left0 : !left)
    pto.textract ins(%rmat, %zi, %zi : !rmat, index, index) outs(%right0 : !right)
    pto.textract ins(%lm, %zi, %zi : !lm, index, index) outs(%ls0 : !ls)
    pto.textract ins(%rm, %zi, %zi : !rm, index, index) outs(%rs0 : !rs)
    pto.tget_scale_addr ins(%left0 : !left) outs(%ls0 : !ls)
    pto.tget_scale_addr ins(%right0 : !right) outs(%rs0 : !rs)
    pto.tmatmul.mx ins(%left0, %ls0, %right0, %rs0 : !left, !ls, !right, !rs) outs(%acc : !acc)
    pto.textract ins(%lmat, %zi, %half : !lmat, index, index) outs(%left1 : !left)
    pto.textract ins(%rmat, %half, %zi : !rmat, index, index) outs(%right1 : !right)
    pto.textract ins(%lm, %zi, %four : !lm, index, index) outs(%ls1 : !ls)
    pto.textract ins(%rm, %four, %zi : !rm, index, index) outs(%rs1 : !rs)
    pto.tget_scale_addr ins(%left1 : !left) outs(%ls1 : !ls)
    pto.tget_scale_addr ins(%right1 : !right) outs(%rs1 : !rs)
    pto.tmatmul.mx.acc ins(%acc, %left1, %ls1, %right1, %rs1 : !acc, !left, !ls, !right, !rs) outs(%acc : !acc)
    return
  }
}
