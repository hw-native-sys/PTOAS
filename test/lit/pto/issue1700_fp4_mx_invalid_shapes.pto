// RUN: pto-test-opt --split-input-file --verify-diagnostics %s

!A = !pto.tile_buf<loc=left, dtype=!pto.f4E2M1x2, rows=16, cols=128, v_row=16, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0>
!B = !pto.tile_buf<loc=right, dtype=!pto.f4E2M1x2, rows=128, cols=32, v_row=128, v_col=32, blayout=row_major, slayout=col_major, fractal=512, pad=0>
!AS = !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=32, cols=4, v_row=32, v_col=4, blayout=row_major, slayout=row_major, fractal=32, pad=0>
!BS = !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=4, cols=64, v_row=4, v_col=64, blayout=col_major, slayout=col_major, fractal=32, pad=0>
!C = !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=32, v_row=16, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
module attributes {pto.target_arch = "a5"} {
  func.func @raw_accumulator(%a: !A, %b: !B, %as: !AS, %bs: !BS, %c: !C) {
    // expected-error@+1 {{expects static matmul tile shapes}}
    pto.tmatmul.mx ins(%a, %as, %b, %bs : !A, !AS, !B, !BS) outs(%c : !C)
    return
  }
}

// -----

!A = !pto.tile_buf<loc=left, dtype=!pto.f4E2M1x2, rows=16, cols=128, v_row=16, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0>
!B = !pto.tile_buf<loc=right, dtype=!pto.f4E2M1x2, rows=128, cols=32, v_row=128, v_col=32, blayout=row_major, slayout=col_major, fractal=512, pad=0>
!AS = !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=16, cols=4, v_row=16, v_col=4, blayout=row_major, slayout=row_major, fractal=32, pad=0>
!BS = !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=4, cols=64, v_row=4, v_col=64, blayout=col_major, slayout=col_major, fractal=32, pad=0>
!C = !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>
module attributes {pto.target_arch = "a5"} {
  func.func @raw_left_scale(%a: !A, %b: !B, %as: !AS, %bs: !BS, %c: !C) {
    // expected-error@+1 {{expects a_scale shape to be}}
    pto.tmatmul.mx ins(%a, %as, %b, %bs : !A, !AS, !B, !BS) outs(%c : !C)
    return
  }
}

// -----

!A = !pto.tile_buf<loc=left, dtype=!pto.f4E2M1x2, rows=16, cols=128, v_row=16, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0>
!B = !pto.tile_buf<loc=right, dtype=!pto.f4E2M1x2, rows=128, cols=32, v_row=128, v_col=32, blayout=row_major, slayout=col_major, fractal=512, pad=0>
!AS = !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=32, cols=4, v_row=32, v_col=4, blayout=row_major, slayout=row_major, fractal=32, pad=0>
!BS = !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=4, cols=32, v_row=4, v_col=32, blayout=col_major, slayout=col_major, fractal=32, pad=0>
!C = !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>
module attributes {pto.target_arch = "a5"} {
  func.func @raw_right_scale(%a: !A, %b: !B, %as: !AS, %bs: !BS, %c: !C) {
    // expected-error@+1 {{expects b_scale shape to be}}
    pto.tmatmul.mx ins(%a, %as, %b, %bs : !A, !AS, !B, !BS) outs(%c : !C)
    return
  }
}

// -----

!A = !pto.tile_buf<loc=left, dtype=!pto.f4E2M1x2, rows=16, cols=128, v_row=16, v_col=128, blayout=col_major, slayout=row_major, fractal=512, pad=0>
!B = !pto.tile_buf<loc=right, dtype=!pto.f4E2M1x2, rows=128, cols=32, v_row=128, v_col=32, blayout=row_major, slayout=col_major, fractal=512, pad=0>
!AS = !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=32, cols=4, v_row=16, v_col=4, blayout=row_major, slayout=row_major, fractal=32, pad=0>
!BS = !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=4, cols=64, v_row=4, v_col=64, blayout=col_major, slayout=col_major, fractal=32, pad=0>
!C = !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=64, v_row=32, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=0>
module attributes {pto.target_arch = "a5"} {
  func.func @raw_valid_scale(%a: !A, %b: !B, %as: !AS, %bs: !BS, %c: !C) {
    // expected-error@+1 {{expects a_scale valid_shape to be}}
    pto.tmatmul.mx ins(%a, %as, %b, %bs : !A, !AS, !B, !BS) outs(%c : !C)
    return
  }
}
