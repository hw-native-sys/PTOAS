// RUN: ptoas --enable-insert-sync --mlir-print-ir-after=pto-insert-sync \
// RUN:   %s 2>&1 1>/dev/null | FileCheck %s --check-prefix=INSERT

// The producer/consumer slots are hidden behind tile alias ops. The sync
// analysis must still trace them back to `pto.multi_tile_get` and keep the
// loop-carried multi-buffer dependency dynamically event-id keyed.

module {
  func.func @multi_tile_alias_slot_dyn_event_id(
      %gm : !pto.partition_tensor_view<16x16xf16>,
      %dst : !pto.partition_tensor_view<16x16xf16>,
      %n : index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index

    %mb = pto.alloc_multi_tile
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2>

    scf.for %i = %c0 to %n step %c1 {
      %next = arith.addi %i, %c1 : index
      %cur_idx = arith.remui %i, %c2 : index
      %nxt_idx = arith.remui %next, %c2 : index

      %prod_slot = pto.multi_tile_get %mb[%nxt_idx]
          : !pto.multi_tile_buf<vec, 16x16xf16, count=2>
         -> !pto.tile_buf<vec, 16x16xf16>
      %prod_view = pto.subview %prod_slot[%c0, %c0] sizes [16, 16] :
          !pto.tile_buf<vec, 16x16xf16> -> !pto.tile_buf<vec, 16x16xf16>
      %prod = pto.treshape %prod_view
          : !pto.tile_buf<vec, 16x16xf16> -> !pto.tile_buf<vec, 16x16xf16>
      pto.tload ins(%gm : !pto.partition_tensor_view<16x16xf16>)
                outs(%prod : !pto.tile_buf<vec, 16x16xf16>)

      %cons_slot = pto.multi_tile_get %mb[%cur_idx]
          : !pto.multi_tile_buf<vec, 16x16xf16, count=2>
         -> !pto.tile_buf<vec, 16x16xf16>
      %cons_view = pto.subview %cons_slot[%c0, %c0] sizes [16, 16] :
          !pto.tile_buf<vec, 16x16xf16> -> !pto.tile_buf<vec, 16x16xf16>
      %cons = pto.treshape %cons_view
          : !pto.tile_buf<vec, 16x16xf16> -> !pto.tile_buf<vec, 16x16xf16>
      pto.tstore ins(%cons : !pto.tile_buf<vec, 16x16xf16>)
                 outs(%dst : !pto.partition_tensor_view<16x16xf16>)
    }
    return
  }
}

// INSERT-LABEL: func.func @multi_tile_alias_slot_dyn_event_id
// INSERT: pto.set_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
// INSERT: pto.set_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID1>]
// INSERT: scf.for
// INSERT: pto.wait_flag_dyn[<PIPE_MTE3>, <PIPE_MTE2>,
// INSERT: pto.tload
// INSERT: pto.tstore
// INSERT: pto.set_flag_dyn[<PIPE_MTE3>, <PIPE_MTE2>,
// INSERT: pto.wait_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID0>]
// INSERT: pto.wait_flag[<PIPE_MTE3>, <PIPE_MTE2>, <EVENT_ID1>]
