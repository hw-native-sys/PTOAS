// RUN: ptoas --pto-level=level3 --pto-arch=a5 \
// RUN:   --mlir-print-ir-after=pto-resolve-reserved-buffers %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NATIVE
// RUN: ptoas --pto-level=level3 --pto-arch=a3 --enable-insert-sync %s \
// RUN:   | FileCheck %s --check-prefix=EMITC

module {
  func.func private @tcvt_arg(
      %src: !pto.tile_buf<vec, 16x16xf32>,
      %dst: !pto.tile_buf<vec, 16x16xf16>) {
    pto.tcvt ins(%src {rmode = #pto<round_mode ROUND>, satmode = #pto<saturation_mode ON>} : !pto.tile_buf<vec, 16x16xf32>)
              outs(%dst : !pto.tile_buf<vec, 16x16xf16>)
    return
  }
}

// NATIVE-LABEL: func.func private @tcvt_arg(
// NATIVE: pto.tcvt ins(%arg0 {{.*}}rmode = #pto<round_mode ROUND>, satmode = #pto<saturation_mode ON>{{.*}} : !pto.tile_buf<vec, 16x16xf32>) outs(%arg1 : !pto.tile_buf<vec, 16x16xf16>)
// NATIVE-NOT: memref<

// EMITC-LABEL: tcvt_arg(
// EMITC: TCVT(
