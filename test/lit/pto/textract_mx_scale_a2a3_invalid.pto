// RUN: pto-test-opt --split-input-file --verify-diagnostics %s

module attributes {pto.target_arch = "a2"} {
  func.func @mx_scale_a2(%src: !pto.tile_buf<loc=mat, dtype=!pto.f8E8M0, rows=256, cols=8, v_row=256, v_col=8, blayout=row_major, slayout=row_major, fractal=32, pad=0, compact=0>, %dst: !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=256, cols=4, v_row=256, v_col=4, blayout=row_major, slayout=row_major, fractal=32, pad=0, compact=0>) {
    %c0 = arith.constant 0 : index
    // expected-error@+1 {{src: dtype '!pto.f8E8M0' is not supported by this op yet}}
    pto.textract ins(%src, %c0, %c0 : !pto.tile_buf<loc=mat, dtype=!pto.f8E8M0, rows=256, cols=8, v_row=256, v_col=8, blayout=row_major, slayout=row_major, fractal=32, pad=0, compact=0>, index, index)
                 outs(%dst : !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=256, cols=4, v_row=256, v_col=4, blayout=row_major, slayout=row_major, fractal=32, pad=0, compact=0>)
    return
  }
}

// -----

module attributes {pto.target_arch = "a3"} {
  func.func @mx_scale_a3(%src: !pto.tile_buf<loc=mat, dtype=!pto.f8E8M0, rows=8, cols=256, v_row=8, v_col=256, blayout=col_major, slayout=col_major, fractal=32, pad=0, compact=0>, %dst: !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=4, cols=256, v_row=4, v_col=256, blayout=col_major, slayout=col_major, fractal=32, pad=0, compact=0>) {
    %c0 = arith.constant 0 : index
    // expected-error@+1 {{src: dtype '!pto.f8E8M0' is not supported by this op yet}}
    pto.textract ins(%src, %c0, %c0 : !pto.tile_buf<loc=mat, dtype=!pto.f8E8M0, rows=8, cols=256, v_row=8, v_col=256, blayout=col_major, slayout=col_major, fractal=32, pad=0, compact=0>, index, index)
                 outs(%dst : !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=4, cols=256, v_row=4, v_col=256, blayout=col_major, slayout=col_major, fractal=32, pad=0, compact=0>)
    return
  }
}
