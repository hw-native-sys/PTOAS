// Regression for issue #1606: the A5 tile eltwise verifiers/ODS were narrower
// than the pto-isa A5 clauses, so dtype anchors that the ISA allows were
// rejected during MLIR verification (before the VPTO simulation ever ran).
// This locks the widened sets:
//   pto.vabs   A5: i8-i32, f16, f32                      (PTOAS docs/isa/micro-isa/06-unary-vector-ops.md)
//   pto.tand/tor A5: 1/2/4-byte integral types           (pto-isa docs/isa/TAND.md, TOR.md)
//   pto.tands/tors/txors A5: 1/2/4-byte integral types   (pto-isa docs/isa/TANDS.md, TORS.md, TXORS.md)
//   pto.tcmps/tfmods A5: also bf16 (and u8/u16/u32)      (pto-isa docs/isa/TCMPS.md, TFMODS.md)
//   pto.tsels/tmax/tmul/tsub A5: also bf16               (pto-isa docs/isa/TSELS.md, TMAX.md, TMUL.md, TSUB.md)

// RUN: ptoas --pto-arch=a5 --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  // pto.vabs on A5 accepts the integer forms as well as f16/f32.
  func.func private @tabs_i8(
      %src: !pto.tile_buf<vec, 8x32xi8>, %dst: !pto.tile_buf<vec, 8x32xi8>) {
    pto.tabs ins(%src : !pto.tile_buf<vec, 8x32xi8>) outs(%dst : !pto.tile_buf<vec, 8x32xi8>)
    return
  }
  func.func private @tabs_i16(
      %src: !pto.tile_buf<vec, 8x32xi16>, %dst: !pto.tile_buf<vec, 8x32xi16>) {
    pto.tabs ins(%src : !pto.tile_buf<vec, 8x32xi16>) outs(%dst : !pto.tile_buf<vec, 8x32xi16>)
    return
  }
  func.func private @tabs_i32(
      %src: !pto.tile_buf<vec, 8x32xi32>, %dst: !pto.tile_buf<vec, 8x32xi32>) {
    pto.tabs ins(%src : !pto.tile_buf<vec, 8x32xi32>) outs(%dst : !pto.tile_buf<vec, 8x32xi32>)
    return
  }

  // The binary bitwise ops accept the 1/2/4-byte integral forms.
  func.func private @tand_i16(
      %a: !pto.tile_buf<vec, 8x32xi16>, %b: !pto.tile_buf<vec, 8x32xi16>,
      %dst: !pto.tile_buf<vec, 8x32xi16>) {
    pto.tand ins(%a, %b : !pto.tile_buf<vec, 8x32xi16>, !pto.tile_buf<vec, 8x32xi16>)
              outs(%dst : !pto.tile_buf<vec, 8x32xi16>)
    return
  }
  func.func private @tor_ui32(
      %a: !pto.tile_buf<vec, 8x32xui32>, %b: !pto.tile_buf<vec, 8x32xui32>,
      %dst: !pto.tile_buf<vec, 8x32xui32>) {
    pto.tor ins(%a, %b : !pto.tile_buf<vec, 8x32xui32>, !pto.tile_buf<vec, 8x32xui32>)
             outs(%dst : !pto.tile_buf<vec, 8x32xui32>)
    return
  }

  // The scalar bitwise ops accept the integral scalar forms, including unsigned.
  func.func private @tands_i16(
      %src: !pto.tile_buf<vec, 8x32xi16>, %scalar: i16,
      %dst: !pto.tile_buf<vec, 8x32xi16>) {
    pto.tands ins(%src, %scalar : !pto.tile_buf<vec, 8x32xi16>, i16)
              outs(%dst : !pto.tile_buf<vec, 8x32xi16>)
    return
  }
  func.func private @tors_ui16(
      %src: !pto.tile_buf<vec, 8x32xui16>, %scalar: ui16,
      %dst: !pto.tile_buf<vec, 8x32xui16>) {
    pto.tors ins(%src, %scalar : !pto.tile_buf<vec, 8x32xui16>, ui16)
             outs(%dst : !pto.tile_buf<vec, 8x32xui16>)
    return
  }
  func.func private @txors_i32(
      %src: !pto.tile_buf<vec, 8x32xi32>, %scalar: i32,
      %dst: !pto.tile_buf<vec, 8x32xi32>) {
    pto.txors ins(%src, %scalar : !pto.tile_buf<vec, 8x32xi32>, i32)
              outs(%dst : !pto.tile_buf<vec, 8x32xi32>)
    return
  }

  // bf16 joins the A5 whitelist of the compare/remainder/fmod scalar ops.
  func.func private @tcmps_bf16(
      %src: !pto.tile_buf<vec, 8x32xbf16>, %scalar: bf16,
      %dst: !pto.tile_buf<vec, 8x32xi8>) {
    pto.tcmps ins(%src, %scalar {cmpMode = #pto<cmp lt>} : !pto.tile_buf<vec, 8x32xbf16>, bf16)
              outs(%dst : !pto.tile_buf<vec, 8x32xi8>)
    return
  }
  func.func private @trems_ui16(
      %src: !pto.tile_buf<vec, 8x32xui16>, %scalar: ui16,
      %tmp: !pto.tile_buf<vec, 8x32xui16>, %dst: !pto.tile_buf<vec, 8x32xui16>) {
    pto.trems ins(%src, %scalar, %tmp : !pto.tile_buf<vec, 8x32xui16>, ui16, !pto.tile_buf<vec, 8x32xui16>)
              outs(%dst : !pto.tile_buf<vec, 8x32xui16>)
    return
  }
  func.func private @tfmods_bf16(
      %src: !pto.tile_buf<vec, 8x32xbf16>, %scalar: bf16,
      %dst: !pto.tile_buf<vec, 8x32xbf16>) {
    pto.tfmods ins(%src, %scalar : !pto.tile_buf<vec, 8x32xbf16>, bf16)
               outs(%dst : !pto.tile_buf<vec, 8x32xbf16>)
    return
  }

  // An unsigned scalar on tcmps.
  func.func private @tcmps_ui8(
      %src: !pto.tile_buf<vec, 8x32xui8>, %scalar: ui8,
      %dst: !pto.tile_buf<vec, 8x32xi8>) {
    pto.tcmps ins(%src, %scalar {cmpMode = #pto<cmp lt>} : !pto.tile_buf<vec, 8x32xui8>, ui8)
              outs(%dst : !pto.tile_buf<vec, 8x32xi8>)
    return
  }

  // bf16 joins the A5 whitelist of the global-select and binary eltwise ops.
  func.func private @tsels_bf16(
      %mask: !pto.tile_buf<vec, 8x32xi8>, %src: !pto.tile_buf<vec, 8x32xbf16>,
      %tmp: !pto.tile_buf<vec, 1x32xbf16>, %scalar: bf16,
      %dst: !pto.tile_buf<vec, 8x32xbf16>) {
    pto.tsels ins(%mask, %src, %tmp, %scalar : !pto.tile_buf<vec, 8x32xi8>, !pto.tile_buf<vec, 8x32xbf16>, !pto.tile_buf<vec, 1x32xbf16>, bf16)
              outs(%dst : !pto.tile_buf<vec, 8x32xbf16>)
    return
  }
  // The A5 tsels clause lists the unsigned integer forms. This case pins only
  // the verifier: the unsigned TileLib payload templates are tracked in #1607.
  func.func private @tsels_ui32(
      %mask: !pto.tile_buf<vec, 8x32xi8>, %src: !pto.tile_buf<vec, 8x32xui32>,
      %tmp: !pto.tile_buf<vec, 1x32xui32>, %scalar: ui32,
      %dst: !pto.tile_buf<vec, 8x32xui32>) {
    pto.tsels ins(%mask, %src, %tmp, %scalar : !pto.tile_buf<vec, 8x32xi8>, !pto.tile_buf<vec, 8x32xui32>, !pto.tile_buf<vec, 1x32xui32>, ui32)
              outs(%dst : !pto.tile_buf<vec, 8x32xui32>)
    return
  }
  func.func private @tmax_bf16(
      %a: !pto.tile_buf<vec, 8x32xbf16>, %b: !pto.tile_buf<vec, 8x32xbf16>,
      %dst: !pto.tile_buf<vec, 8x32xbf16>) {
    pto.tmax ins(%a, %b : !pto.tile_buf<vec, 8x32xbf16>, !pto.tile_buf<vec, 8x32xbf16>)
             outs(%dst : !pto.tile_buf<vec, 8x32xbf16>)
    return
  }
  func.func private @tmul_bf16(
      %a: !pto.tile_buf<vec, 8x32xbf16>, %b: !pto.tile_buf<vec, 8x32xbf16>,
      %dst: !pto.tile_buf<vec, 8x32xbf16>) {
    pto.tmul ins(%a, %b : !pto.tile_buf<vec, 8x32xbf16>, !pto.tile_buf<vec, 8x32xbf16>)
             outs(%dst : !pto.tile_buf<vec, 8x32xbf16>)
    return
  }
  func.func private @tsub_bf16(
      %a: !pto.tile_buf<vec, 8x32xbf16>, %b: !pto.tile_buf<vec, 8x32xbf16>,
      %dst: !pto.tile_buf<vec, 8x32xbf16>) {
    pto.tsub ins(%a, %b : !pto.tile_buf<vec, 8x32xbf16>, !pto.tile_buf<vec, 8x32xbf16>)
             outs(%dst : !pto.tile_buf<vec, 8x32xbf16>)
    return
  }
}

// CHECK-LABEL: func.func private @tabs_i8
// CHECK: pto.tabs
// CHECK-LABEL: func.func private @tabs_i16
// CHECK: pto.tabs
// CHECK-LABEL: func.func private @tabs_i32
// CHECK: pto.tabs
// CHECK-LABEL: func.func private @tand_i16
// CHECK: pto.tand
// CHECK-LABEL: func.func private @tor_ui32
// CHECK: pto.tor
// CHECK-LABEL: func.func private @tands_i16
// CHECK: pto.tands
// CHECK-LABEL: func.func private @tors_ui16
// CHECK: pto.tors
// CHECK-LABEL: func.func private @txors_i32
// CHECK: pto.txors
// CHECK-LABEL: func.func private @tcmps_bf16
// CHECK: pto.tcmps
// CHECK-LABEL: func.func private @trems_ui16
// CHECK: pto.trems
// CHECK-LABEL: func.func private @tfmods_bf16
// CHECK: pto.tfmods
// CHECK-LABEL: func.func private @tcmps_ui8
// CHECK: pto.tcmps
// CHECK-LABEL: func.func private @tsels_bf16
// CHECK: pto.tsels
// CHECK-LABEL: func.func private @tsels_ui32
// CHECK: pto.tsels
// CHECK-LABEL: func.func private @tmax_bf16
// CHECK: pto.tmax
// CHECK-LABEL: func.func private @tmul_bf16
// CHECK: pto.tmul
// CHECK-LABEL: func.func private @tsub_bf16
// CHECK: pto.tsub
