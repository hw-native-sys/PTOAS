// RUN: split-file %s %t
// RUN: not ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir %t/b32.pto 2>&1 | FileCheck %s --check-prefix=B32
// RUN: not ptoas --pto-arch=a3 --pto-level=level2 --emit-pto-ir %t/b16.pto 2>&1 | FileCheck %s --check-prefix=B16

//--- b32.pto
module {
  func.func @tci_b32_tmp_too_small() {
    %c0_i32 = arith.constant 0 : i32
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %tmp = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=128, v_row=1, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    // B32: error: 'pto.tci' op expects A2/A3 tmp capacity to be at least 768 bytes for 32-bit dst element type
    pto.tci ins(%c0_i32, %tmp : i32, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=128, v_row=1, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}

//--- b16.pto
module {
  func.func @tci_b16_tmp_too_small() {
    %c0_i16 = arith.constant 0 : i16
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=i16, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %tmp = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=192, v_row=1, v_col=192, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    // B16: error: 'pto.tci' op expects A2/A3 tmp capacity to be at least 1792 bytes for 16-bit dst element type
    pto.tci ins(%c0_i16, %tmp : i16, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=192, v_row=1, v_col=192, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst : !pto.tile_buf<loc=vec, dtype=i16, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}
