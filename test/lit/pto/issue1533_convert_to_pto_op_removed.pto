// RUN: pto-test-opt --help | FileCheck %s --check-prefix=HELP --implicit-check-not=convert-to-pto-op
// RUN: not pto-test-opt %s -convert-to-pto-op 2>&1 | FileCheck %s --check-prefix=REMOVED
// RUN: not pto-test-opt %s --pass-pipeline='builtin.module(convert-to-pto-op)' 2>&1 | FileCheck %s --check-prefix=PIPELINE
// RUN: pto-test-opt %s | FileCheck %s --check-prefix=PARSE

// The retired pass must not be advertised or accepted through either CLI entry.
// Keep the rank-0 subview reproducer from issue 1533 to verify that valid input
// still parses and that the old invocation diagnoses an unknown pass, not a crash.
// HELP: --canonicalize
// REMOVED: Unknown command line argument '-convert-to-pto-op'
// PIPELINE: 'convert-to-pto-op' does not refer to a registered pass or pass pipeline
// PARSE-LABEL: func.func @bug_trigger
// PARSE: memref.alloc() : memref<f32>
// PARSE: memref.subview
// PARSE: memref.copy %{{.+}}, %{{.+}} : memref<f32> to memref<f32>
// PARSE: return
func.func @bug_trigger(%src: memref<f32>) {
  %alloc = memref.alloc() : memref<f32>
  %sub = memref.subview %alloc [] [] [] : memref<f32> to memref<f32>
  memref.copy %src, %sub : memref<f32> to memref<f32>
  return
}
