// RUN: ptoas --pto-arch=a3 --emit-pto-ir %s -o - 2>&1 | FileCheck %s

module {
  func.func @castptr_make_tensor_view(%addr: i64)
      -> !pto.tensor_view<?xui32>
      attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c1 = arith.constant 1 : index
    %ptr = pto.castptr %addr : i64 -> !pto.ptr<ui32>
    %view = pto.make_tensor_view %ptr, shape = [%c1], strides = [%c1] : !pto.tensor_view<?xui32>
    return %view : !pto.tensor_view<?xui32>
  }
}

// CHECK-LABEL: func.func @castptr_make_tensor_view
// CHECK: pto.castptr
// CHECK: pto.make_tensor_view
