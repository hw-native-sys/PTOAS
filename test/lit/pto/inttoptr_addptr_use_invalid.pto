// RUN: ptoas --pto-arch=a3 %s -o - 2>&1 | FileCheck %s

module {
  func.func @castptr_addptr(%addr: i64, %dst: !pto.ptr<ui32>, %idx: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %ptr = pto.castptr %addr : i64 -> !pto.ptr<ui32>
    %off = pto.addptr %ptr, %idx : !pto.ptr<ui32> -> !pto.ptr<ui32>
    %val = pto.load %off[%c0] : !pto.ptr<ui32> -> ui32
    pto.store %val, %dst[%c0] : !pto.ptr<ui32>, ui32
    return
  }
}

// CHECK-LABEL: AICORE void castptr_addptr
// CHECK: reinterpret_cast<__gm__ uint32_t*>
// CHECK: +
