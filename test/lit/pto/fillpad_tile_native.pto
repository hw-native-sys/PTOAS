// RUN: ptoas --pto-level=level3 --pto-arch=a5 \
// RUN:   --mlir-print-ir-after=pto-resolve-reserved-buffers %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NATIVE
// RUN: ptoas --pto-level=level3 --pto-arch=a3 --enable-insert-sync %s \
// RUN:   | FileCheck %s --check-prefix=EMITC

module {
  func.func private @tfillpad_arg(
      %src: !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=1>,
      %dst: !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=1>) {
    pto.tfillpad ins(%src : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=1>)
                 outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=1>)
    return
  }

  func.func private @tfillpad_inplace_arg(
      %tile: !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=1>) {
    pto.tfillpad ins(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=1>)
                 outs(%tile : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=1>)
    return
  }
}

// NATIVE-LABEL: func.func private @tfillpad_arg(
// NATIVE: pto.tfillpad ins(%arg0
// NATIVE-SAME: outs(%arg1
// NATIVE-LABEL: func.func private @tfillpad_inplace_arg(
// NATIVE: pto.tfillpad ins(%arg0
// NATIVE-SAME: outs(%arg0
// NATIVE-NOT: mode
// NATIVE-NOT: memref<

// EMITC-LABEL: tfillpad_arg(
// EMITC: TFILLPAD(
// EMITC-LABEL: tfillpad_inplace_arg(
// EMITC: TFILLPAD<pto::TFillPadMode::InPlace>(
