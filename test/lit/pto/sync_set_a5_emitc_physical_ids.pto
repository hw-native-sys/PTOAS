// RUN: ptoas --pto-arch=a5 %s 2>&1 | FileCheck %s --implicit-check-not=__builtin_cce_

module attributes {
  pto.kernel_kind = #pto.kernel_kind<vector>,
  pto.target_arch = "a5"
} {
  func.func @sync_set_a5_emitc_ffts_modes() attributes {pto.kernel} {
    pto.sync.set <PIPE_FIX>, 0 {ffts_mode = 0 : i32}
    pto.sync.set <PIPE_MTE1>, 1 {ffts_mode = 1 : i32}
    pto.sync.set <PIPE_MTE2>, 2 {ffts_mode = 2 : i32}
    pto.sync.wait <PIPE_V>, 2 {ffts_mode = 2 : i32}
    return
  }
}

// CHECK-LABEL: extern "C" __global__ AICORE void sync_set_a5_emitc_ffts_modes() {
// CHECK: getFFTSMsg(0, {{.*}})
// CHECK: ffts_cross_core_sync(PIPE_FIX, {{.*}});
// CHECK: getFFTSMsg(1, {{.*}})
// CHECK: ffts_cross_core_sync(PIPE_MTE1, {{.*}});
// CHECK: getFFTSMsg(2, {{.*}})
// CHECK: ffts_cross_core_sync(PIPE_MTE2, {{.*}});
// CHECK: wait_flag_dev(PIPE_V, 2);
// CHECK-NOT: set_intra_block
