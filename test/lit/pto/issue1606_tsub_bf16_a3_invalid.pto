// issue #1606: the bf16 form is A5-only for tsub; the A2/A3 clause stays as is.
// RUN: not ptoas --pto-arch=a3 --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func private @tsub_bf16_a3(
      %a: !pto.tile_buf<vec, 8x32xbf16>, %b: !pto.tile_buf<vec, 8x32xbf16>,
      %dst: !pto.tile_buf<vec, 8x32xbf16>) {
    pto.tsub ins(%a, %b : !pto.tile_buf<vec, 8x32xbf16>, !pto.tile_buf<vec, 8x32xbf16>)
             outs(%dst : !pto.tile_buf<vec, 8x32xbf16>)
    return
  }
}

// CHECK: error: 'pto.tsub' op expects A2/A3 tsub element type to be i32/i16/f16/f32
