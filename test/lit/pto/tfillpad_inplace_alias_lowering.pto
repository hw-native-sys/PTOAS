// RUN: ptoas --pto-level=level3 %s | FileCheck %s

module {
  func.func @tfillpad_inplace_alias() {
    %c0 = arith.constant 0 : i64
    %src = pto.alloc_tile addr = %c0 : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile addr = %c0 : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=1>
    pto.tfillpad ins(%src : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
                 outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=1>)
    return
  }

  func.func @tfillpad_different_addresses() {
    %c0 = arith.constant 0 : i64
    %c4096 = arith.constant 4096 : i64
    %src = pto.alloc_tile addr = %c0 : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile addr = %c4096 : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=1>
    pto.tfillpad ins(%src : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
                 outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=1>)
    return
  }
}

// CHECK-LABEL: AICORE void tfillpad_inplace_alias(
// CHECK: TFILLPAD<pto::TFillPadMode::InPlace>(
// CHECK-LABEL: AICORE void tfillpad_different_addresses(
// CHECK-NOT: TFillPadMode::InPlace
// CHECK: TFILLPAD(
