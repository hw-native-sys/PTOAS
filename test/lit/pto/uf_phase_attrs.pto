// RUN: ptoas --pto-arch=a5 --emit-pto-ir %s -o %t.pto
// RUN: ptoas --pto-arch=a5 --pto-level=level3 --emit-pto-ir %t.pto | FileCheck %s --check-prefix=IR
// RUN: ptoas --pto-arch=a5 --emit-pto-ir %s 2>&1 | FileCheck %s --check-prefix=IR
// RUN: ptoas --pto-arch=a5 %s 2>&1 | FileCheck %s --check-prefix=EMIT

module attributes {pto.target_arch = "a5"} {
  // O1: TMatmulMxBiasOp must carry accPhase through parse -> print -> parse.
  func.func @mx_bias_phase(%a: !pto.tile_buf<loc=left, dtype=f8E4M3FN, rows=16, cols=512, v_row=16, v_col=512, blayout=col_major, slayout=row_major, fractal=512, pad=0>,
                           %b: !pto.tile_buf<loc=right, dtype=f8E4M3FN, rows=512, cols=16, v_row=512, v_col=16, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %a_scale = pto.alloc_tile : !pto.tile_buf<loc=scaling, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=row_major, fractal=32, pad=0>
    %b_scale = pto.alloc_tile : !pto.tile_buf<loc=scaling, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=col_major, fractal=32, pad=0>
    %bias = pto.alloc_tile : !pto.tile_buf<loc=bias, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.tmatmul.mx.bias ins(%a, %a_scale, %b, %b_scale, %bias
        : !pto.tile_buf<loc=left, dtype=f8E4M3FN, rows=16, cols=512, v_row=16, v_col=512, blayout=col_major, slayout=row_major, fractal=512, pad=0>,
          !pto.tile_buf<loc=scaling, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=row_major, fractal=32, pad=0>,
          !pto.tile_buf<loc=right, dtype=f8E4M3FN, rows=512, cols=16, v_row=512, v_col=16, blayout=row_major, slayout=col_major, fractal=512, pad=0>,
          !pto.tile_buf<loc=scaling, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=col_major, fractal=32, pad=0>,
          !pto.tile_buf<loc=bias, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
        outs(%dst : !pto.tile_buf<loc=acc, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
        {accPhase = #pto<acc_phase final>}
    return
  }

  // O1: TGemvMxBiasOp must carry accPhase through parse -> print -> parse.
  func.func @gemv_mx_bias_phase(%a: !pto.tile_buf<loc=left, dtype=f8E4M3FN, rows=1, cols=512, v_row=1, v_col=512, blayout=col_major, slayout=row_major, fractal=512, pad=0>,
                           %b: !pto.tile_buf<loc=right, dtype=f8E4M3FN, rows=512, cols=16, v_row=512, v_col=16, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %a_scale = pto.alloc_tile : !pto.tile_buf<loc=scaling, dtype=f16, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=row_major, fractal=32, pad=0>
    %b_scale = pto.alloc_tile : !pto.tile_buf<loc=scaling, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=col_major, fractal=32, pad=0>
    %bias = pto.alloc_tile : !pto.tile_buf<loc=bias, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=acc, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.tgemv.mx.bias ins(%a, %a_scale, %b, %b_scale, %bias
        : !pto.tile_buf<loc=left, dtype=f8E4M3FN, rows=1, cols=512, v_row=1, v_col=512, blayout=col_major, slayout=row_major, fractal=512, pad=0>,
          !pto.tile_buf<loc=scaling, dtype=f16, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=row_major, fractal=32, pad=0>,
          !pto.tile_buf<loc=right, dtype=f8E4M3FN, rows=512, cols=16, v_row=512, v_col=16, blayout=row_major, slayout=col_major, fractal=512, pad=0>,
          !pto.tile_buf<loc=scaling, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=col_major, fractal=32, pad=0>,
          !pto.tile_buf<loc=bias, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
        outs(%dst : !pto.tile_buf<loc=acc, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
        {accPhase = #pto<acc_phase final>}
    return
  }

  // O1: TGemvMxBiasOp must carry accPhase through parse -> print -> parse.
  func.func @gemv_mx_bias_partial(%a: !pto.tile_buf<loc=left, dtype=f8E4M3FN, rows=1, cols=512, v_row=1, v_col=512, blayout=col_major, slayout=row_major, fractal=512, pad=0>,
                           %b: !pto.tile_buf<loc=right, dtype=f8E4M3FN, rows=512, cols=16, v_row=512, v_col=16, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %a_scale = pto.alloc_tile : !pto.tile_buf<loc=scaling, dtype=f16, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=row_major, fractal=32, pad=0>
    %b_scale = pto.alloc_tile : !pto.tile_buf<loc=scaling, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=col_major, fractal=32, pad=0>
    %bias = pto.alloc_tile : !pto.tile_buf<loc=bias, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=acc, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.tgemv.mx.bias ins(%a, %a_scale, %b, %b_scale, %bias
        : !pto.tile_buf<loc=left, dtype=f8E4M3FN, rows=1, cols=512, v_row=1, v_col=512, blayout=col_major, slayout=row_major, fractal=512, pad=0>,
          !pto.tile_buf<loc=scaling, dtype=f16, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=row_major, fractal=32, pad=0>,
          !pto.tile_buf<loc=right, dtype=f8E4M3FN, rows=512, cols=16, v_row=512, v_col=16, blayout=row_major, slayout=col_major, fractal=512, pad=0>,
          !pto.tile_buf<loc=scaling, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=col_major, fractal=32, pad=0>,
          !pto.tile_buf<loc=bias, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
        outs(%dst : !pto.tile_buf<loc=acc, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
        {accPhase = #pto<acc_phase partial>}
    return
  }

  // O1: TGemvMxBiasOp must carry accPhase through parse -> print -> parse.
  func.func @gemv_mx_bias_default(%a: !pto.tile_buf<loc=left, dtype=f8E4M3FN, rows=1, cols=512, v_row=1, v_col=512, blayout=col_major, slayout=row_major, fractal=512, pad=0>,
                           %b: !pto.tile_buf<loc=right, dtype=f8E4M3FN, rows=512, cols=16, v_row=512, v_col=16, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %a_scale = pto.alloc_tile : !pto.tile_buf<loc=scaling, dtype=f16, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=row_major, fractal=32, pad=0>
    %b_scale = pto.alloc_tile : !pto.tile_buf<loc=scaling, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=col_major, fractal=32, pad=0>
    %bias = pto.alloc_tile : !pto.tile_buf<loc=bias, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=acc, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.tgemv.mx.bias ins(%a, %a_scale, %b, %b_scale, %bias
        : !pto.tile_buf<loc=left, dtype=f8E4M3FN, rows=1, cols=512, v_row=1, v_col=512, blayout=col_major, slayout=row_major, fractal=512, pad=0>,
          !pto.tile_buf<loc=scaling, dtype=f16, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=row_major, fractal=32, pad=0>,
          !pto.tile_buf<loc=right, dtype=f8E4M3FN, rows=512, cols=16, v_row=512, v_col=16, blayout=row_major, slayout=col_major, fractal=512, pad=0>,
          !pto.tile_buf<loc=scaling, dtype=f16, rows=16, cols=16, v_row=16, v_col=16, blayout=col_major, slayout=col_major, fractal=32, pad=0>,
          !pto.tile_buf<loc=bias, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
        outs(%dst : !pto.tile_buf<loc=acc, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
    return
  }

  // O1: TMovOp must carry stPhase on an ACC-source drain and emit the leading
  // STPhase template argument.
  func.func @tmov_phase(%src: !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
      attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
    %dst = pto.alloc_tile : !pto.tile_buf<loc=mat, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tmov ins(%src : !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>)
             outs(%dst : !pto.tile_buf<loc=mat, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
             {stPhase = #pto<st_phase final>}
    return
  }
}

// IR-LABEL: func.func @mx_bias_phase
// IR: accPhase = #pto<acc_phase final>
// IR-LABEL: func.func @gemv_mx_bias_phase
// IR: accPhase = #pto<acc_phase final>
// IR-LABEL: func.func @gemv_mx_bias_partial
// IR: accPhase = #pto<acc_phase partial>
// IR-LABEL: func.func @gemv_mx_bias_default
// IR-NOT: accPhase
// IR-LABEL: func.func @tmov_phase
// IR: stPhase = #pto<st_phase final>

// EMIT-LABEL: AICORE void mx_bias_phase(
// EMIT: TMATMUL_MX<pto::AccPhase::Final>(
// EMIT-LABEL: AICORE void gemv_mx_bias_phase(
// EMIT: TGEMV_MX<pto::AccPhase::Final>(
// EMIT-LABEL: AICORE void gemv_mx_bias_partial(
// EMIT: TGEMV_MX<pto::AccPhase::Partial>(
// EMIT-LABEL: AICORE void gemv_mx_bias_default(
// EMIT: TGEMV_MX(
// EMIT-LABEL: AICORE void tmov_phase(
// EMIT: TMOV<STPhase::Final,
