// RUN: not ptoas %s 2>&1 | FileCheck %s

module {
  func.func @reject_internal_addrs() {
    %multi = pto.alloc_multi_tile {
      pto.multi_buffer_addrs = array<i64: 0, 512>
    } : !pto.multi_tile_buf<!pto.tile_buf<vec, 16x16xf16>, count=2>
    return
  }
}

// CHECK: attribute 'pto.multi_buffer_addrs' is reserved for pto-plan-memory
