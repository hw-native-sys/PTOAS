// A2/A3 compare-form TGATHER derives two operand-less scratch regions from
// the tmp pointer (pto-isa TGather_cmp): the S-pipe index table at
// [tmpEnd, tmpEnd + srcRows*srcCols*4) and the S-pipe typed-K threshold copy
// area right after it. InsertSync must order external accesses against those
// real bytes (issue #1758), must not invent orderings for bytes the
// implementation never touches, must keep runtime-offset (envelope-anchored)
// tmp views and adjacent-row subview consumers covered, and must not let a
// subview-slot disjointness proof drop a derived-range dependency. Every
// scenario runs under both automatic sync modes.
//
// Layout used by the 8x128 cases (tmp = first 256B of an 8192B scratch at
// 4096): bitmap [4096,4352), index [4352,8448), cvt (actual access)
// [8448,8480), reserved conversion padding [8480,8704), free backing
// [8704,12288).

// RUN: split-file %s %t
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/index_overlap.pto -o - 2>&1 | FileCheck %s --check-prefix=IDX
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/index_overlap.pto -o - 2>&1 | FileCheck %s --check-prefix=UIDX
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/cvt_overlap.pto -o - 2>&1 | FileCheck %s --check-prefix=CVT
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/cvt_overlap.pto -o - 2>&1 | FileCheck %s --check-prefix=UCVT
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/bitmap_overlap.pto -o - 2>&1 | FileCheck %s --check-prefix=BMP
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/bitmap_overlap.pto -o - 2>&1 | FileCheck %s --check-prefix=UBMP
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/padding_negative.pto -o - 2>&1 | FileCheck %s --check-prefix=PAD
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/padding_negative.pto -o - 2>&1 | FileCheck %s --check-prefix=UPAD
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/backing_negative.pto -o - 2>&1 | FileCheck %s --check-prefix=NEG
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/backing_negative.pto -o - 2>&1 | FileCheck %s --check-prefix=UNEG
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/dyn_offset_anchor.pto -o - 2>&1 | FileCheck %s --check-prefix=DYN
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/dyn_offset_anchor.pto -o - 2>&1 | FileCheck %s --check-prefix=UDYN
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/adjacent_row.pto -o - 2>&1 | FileCheck %s --check-prefix=ROW
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/adjacent_row.pto -o - 2>&1 | FileCheck %s --check-prefix=UROW
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/nested_subview.pto -o - 2>&1 | FileCheck %s --check-prefix=NEST
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/nested_subview.pto -o - 2>&1 | FileCheck %s --check-prefix=UNEST
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/select_merge.pto -o - 2>&1 | FileCheck %s --check-prefix=SEL
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/select_merge.pto -o - 2>&1 | FileCheck %s --check-prefix=USEL
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/stride_subview.pto -o - 2>&1 | FileCheck %s --check-prefix=STR
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/stride_subview.pto -o - 2>&1 | FileCheck %s --check-prefix=USTR
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/row_col_subview.pto -o - 2>&1 | FileCheck %s --check-prefix=RC
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/row_col_subview.pto -o - 2>&1 | FileCheck %s --check-prefix=URC
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/compact_tmp.pto -o - 2>&1 | FileCheck %s --check-prefix=CMP
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/compact_tmp.pto -o - 2>&1 | FileCheck %s --check-prefix=UCMP
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/k_load.pto -o - 2>&1 | FileCheck %s --check-prefix=KLOAD
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/k_load.pto -o - 2>&1 | FileCheck %s --check-prefix=UKLOAD
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync %t/tail_war.pto -o - 2>&1 | FileCheck %s --check-prefix=WAR
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-unified-sync  %t/tail_war.pto -o - 2>&1 | FileCheck %s --check-prefix=UWAR

//--- index_overlap.pto
module attributes {pto.target_arch = "a2a3"} {
  func.func @gather_compare(%input: !pto.ptr<f32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    %c8 = arith.constant 8 : index
    %src_addr = arith.constant 0 : i64
    %scratch_addr = arith.constant 4096 : i64
    %indices_addr = arith.constant 16384 : i64
    %counts_addr = arith.constant 20480 : i64
    %later_addr = arith.constant 4352 : i64
    %threshold = arith.constant 1.0 : f32
    %src = pto.alloc_tile addr = %src_addr : !pto.tile_buf<vec, 8x128xf32>
    %indices = pto.alloc_tile addr = %indices_addr : !pto.tile_buf<vec, 8x128xi32>
    %counts = pto.alloc_tile addr = %counts_addr : !pto.tile_buf<vec, 1x8xi32>
    %scratch = pto.alloc_tile addr = %scratch_addr : !pto.tile_buf<vec, 1x8192xui8>
    %prefix = pto.subview %scratch[%c0, %c0] sizes [1, 256] valid [%c1, %c256] : !pto.tile_buf<vec, 1x8192xui8> -> !pto.tile_buf<vec, 1x256xui8>
    %mask = pto.treshape %prefix : !pto.tile_buf<vec, 1x256xui8> -> !pto.tile_buf<vec, 8x32xui8>
    %later = pto.alloc_tile addr = %later_addr : !pto.tile_buf<vec, 1x8xf32>
    pto.tgather ins(%src, %threshold, %mask : !pto.tile_buf<vec, 8x128xf32>, f32, !pto.tile_buf<vec, 8x32xui8>) outs(%indices, %counts : !pto.tile_buf<vec, 8x128xi32>, !pto.tile_buf<vec, 1x8xi32>) {cmpMode = #pto<cmp gt>, offset = 7 : i32}
    %input_view = pto.make_tensor_view %input, shape = [%c1, %c8], strides = [%c8, %c1] : !pto.tensor_view<?x?xf32>
    %input_partition = pto.partition_view %input_view, offsets = [%c0, %c0], sizes = [%c1, %c8] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
    pto.tload ins(%input_partition : !pto.partition_tensor_view<1x8xf32>) outs(%later : !pto.tile_buf<vec, 1x8xf32>)
    pto.tprint ins(%later : !pto.tile_buf<vec, 1x8xf32>)
    return
  }
}

// The S index-fill write (WAW) and the V reduce read (WAR) both precede the load.
// IDX-LABEL: AICORE void gather_compare(
// IDX: TGATHER<
// IDX-NOT: TLOAD(
// IDX: set_flag(PIPE_S, PIPE_MTE2,
// IDX-NOT: TLOAD(
// IDX: set_flag(PIPE_V, PIPE_MTE2,
// IDX-NOT: TLOAD(
// IDX: wait_flag(PIPE_V, PIPE_MTE2,
// IDX-NOT: TLOAD(
// IDX: wait_flag(PIPE_S, PIPE_MTE2,
// IDX-NEXT: TLOAD(

// The S index-fill write (WAW) and the V reduce read (WAR) both precede the load.
// UIDX-LABEL: AICORE void gather_compare(
// UIDX: TGATHER<
// UIDX-NOT: TLOAD(
// UIDX: set_flag(PIPE_S, PIPE_MTE2,
// UIDX-NOT: TLOAD(
// UIDX: set_flag(PIPE_V, PIPE_MTE2,
// UIDX-NOT: TLOAD(
// UIDX: wait_flag(PIPE_V, PIPE_MTE2,
// UIDX-NOT: TLOAD(
// UIDX: wait_flag(PIPE_S, PIPE_MTE2,
// UIDX-NEXT: TLOAD(
//--- cvt_overlap.pto
module attributes {pto.target_arch = "a2a3"} {
  func.func @gather_compare(%input: !pto.ptr<f32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    %c8 = arith.constant 8 : index
    %src_addr = arith.constant 0 : i64
    %scratch_addr = arith.constant 4096 : i64
    %indices_addr = arith.constant 16384 : i64
    %counts_addr = arith.constant 20480 : i64
    %later_addr = arith.constant 8448 : i64
    %threshold = arith.constant 1.0 : f32
    %src = pto.alloc_tile addr = %src_addr : !pto.tile_buf<vec, 8x128xf32>
    %indices = pto.alloc_tile addr = %indices_addr : !pto.tile_buf<vec, 8x128xi32>
    %counts = pto.alloc_tile addr = %counts_addr : !pto.tile_buf<vec, 1x8xi32>
    %scratch = pto.alloc_tile addr = %scratch_addr : !pto.tile_buf<vec, 1x8192xui8>
    %prefix = pto.subview %scratch[%c0, %c0] sizes [1, 256] valid [%c1, %c256] : !pto.tile_buf<vec, 1x8192xui8> -> !pto.tile_buf<vec, 1x256xui8>
    %mask = pto.treshape %prefix : !pto.tile_buf<vec, 1x256xui8> -> !pto.tile_buf<vec, 8x32xui8>
    %later = pto.alloc_tile addr = %later_addr : !pto.tile_buf<vec, 1x8xf32>
    pto.tgather ins(%src, %threshold, %mask : !pto.tile_buf<vec, 8x128xf32>, f32, !pto.tile_buf<vec, 8x32xui8>) outs(%indices, %counts : !pto.tile_buf<vec, 8x128xi32>, !pto.tile_buf<vec, 1x8xi32>) {cmpMode = #pto<cmp gt>, offset = 7 : i32}
    %input_view = pto.make_tensor_view %input, shape = [%c1, %c8], strides = [%c8, %c1] : !pto.tensor_view<?x?xf32>
    %input_partition = pto.partition_view %input_view, offsets = [%c0, %c0], sizes = [%c1, %c8] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
    pto.tload ins(%input_partition : !pto.partition_tensor_view<1x8xf32>) outs(%later : !pto.tile_buf<vec, 1x8xf32>)
    pto.tprint ins(%later : !pto.tile_buf<vec, 1x8xf32>)
    return
  }
}

