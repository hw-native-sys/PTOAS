// UDYN: set_flag(PIPE_S, PIPE_MTE2,
// UDYN-NOT: TLOAD(
// UDYN: set_flag(PIPE_V, PIPE_MTE2,
// UDYN-NOT: TLOAD(
// UDYN: wait_flag(PIPE_V, PIPE_MTE2,
// UDYN-NOT: TLOAD(
// UDYN: wait_flag(PIPE_S, PIPE_MTE2,
// UDYN-NEXT: TLOAD(
//--- adjacent_row.pto
// Single-row mask/consumer subviews so areDisjointSubviewSlots actually
// applies; the derived index table must still be ordered against row 1.
module attributes {pto.target_arch = "a2a3"} {
  func.func @gather_compare(%input: !pto.ptr<ui8>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %c64 = arith.constant 64 : index
    %src_addr = arith.constant 0 : i64
    %backing_addr = arith.constant 4096 : i64
    %indices_addr = arith.constant 16384 : i64
    %counts_addr = arith.constant 20480 : i64
    %threshold = arith.constant 1.0 : f32
    %src = pto.alloc_tile addr = %src_addr : !pto.tile_buf<vec, 1x64xf32>
    %indices = pto.alloc_tile addr = %indices_addr : !pto.tile_buf<vec, 1x64xi32>
    %counts = pto.alloc_tile addr = %counts_addr : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %backing = pto.alloc_tile addr = %backing_addr : !pto.tile_buf<vec, 16x32xui8>
    %mask = pto.subview %backing[%c0, %c0] sizes [1, 32] valid [%c1, %c32] : !pto.tile_buf<vec, 16x32xui8> -> !pto.tile_buf<vec, 1x32xui8>
    %row1 = pto.subview %backing[%c1, %c0] sizes [1, 32] valid [%c1, %c32] : !pto.tile_buf<vec, 16x32xui8> -> !pto.tile_buf<vec, 1x32xui8>
    pto.tgather ins(%src, %threshold, %mask : !pto.tile_buf<vec, 1x64xf32>, f32, !pto.tile_buf<vec, 1x32xui8>) outs(%indices, %counts : !pto.tile_buf<vec, 1x64xi32>, !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>) {cmpMode = #pto<cmp gt>, offset = 0 : i32}
    %input_view = pto.make_tensor_view %input, shape = [%c1, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xui8>
    %input_partition = pto.partition_view %input_view, offsets = [%c0, %c0], sizes = [%c1, %c32] : !pto.tensor_view<?x?xui8> -> !pto.partition_tensor_view<1x32xui8>
    pto.tload ins(%input_partition : !pto.partition_tensor_view<1x32xui8>) outs(%row1 : !pto.tile_buf<vec, 1x32xui8>)
    return
  }
}

// Single-row mask (row 0) vs single-row consumer (row 1) of one 16x32
// backing: areDisjointSubviewSlots applies to exactly this shape, so the
// derived index table [4128, 4384) must stay ordered against row 1.
// ROW-LABEL: AICORE void gather_compare(
// ROW: TGATHER<
// ROW-NOT: TLOAD(
// ROW: set_flag(PIPE_S, PIPE_MTE2,
// ROW-NOT: TLOAD(
// ROW: set_flag(PIPE_V, PIPE_MTE2,
// ROW-NOT: TLOAD(
// ROW: wait_flag(PIPE_V, PIPE_MTE2,
// ROW-NOT: TLOAD(
// ROW: wait_flag(PIPE_S, PIPE_MTE2,
// ROW-NEXT: TLOAD(

// Single-row mask (row 0) vs single-row consumer (row 1) of one 16x32
// backing: areDisjointSubviewSlots applies to exactly this shape, so the
// derived index table [4128, 4384) must stay ordered against row 1.
// UROW-LABEL: AICORE void gather_compare(
// UROW: TGATHER<
// UROW-NOT: TLOAD(
// UROW: set_flag(PIPE_S, PIPE_MTE2,
// UROW-NOT: TLOAD(
// UROW: set_flag(PIPE_V, PIPE_MTE2,
// UROW-NOT: TLOAD(
// UROW: wait_flag(PIPE_V, PIPE_MTE2,
// UROW-NOT: TLOAD(
// UROW: wait_flag(PIPE_S, PIPE_MTE2,
// UROW-NEXT: TLOAD(
//--- nested_subview.pto
// A static subview taken from a runtime-offset (envelope) window must stay
// imprecise: the derived regions cannot be narrowed to a finite interval at
// the envelope base. With the runtime offset at 1024 the real index table is
// [5376, 9472) while the wrongly-narrowed model would claim [4352, 8448), so
// a load at 9216 is only ordered when the imprecise mark survives.
module attributes {pto.target_arch = "a2a3"} {
  func.func @gather_compare(%input: !pto.ptr<f32>, %dyn : index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    %c512 = arith.constant 512 : index
    %c8 = arith.constant 8 : index
    %src_addr = arith.constant 0 : i64
    %scratch_addr = arith.constant 4096 : i64
    %indices_addr = arith.constant 16384 : i64
    %counts_addr = arith.constant 20480 : i64
    %later_addr = arith.constant 9216 : i64
    %threshold = arith.constant 1.0 : f32
    %src = pto.alloc_tile addr = %src_addr : !pto.tile_buf<vec, 8x128xf32>
    %indices = pto.alloc_tile addr = %indices_addr : !pto.tile_buf<vec, 8x128xi32>
    %counts = pto.alloc_tile addr = %counts_addr : !pto.tile_buf<vec, 1x8xi32>
    %scratch = pto.alloc_tile addr = %scratch_addr : !pto.tile_buf<vec, 1x8192xui8>
    %win = pto.subview %scratch[%c0, %dyn] sizes [1, 512] valid [%c1, %c512] : !pto.tile_buf<vec, 1x8192xui8> -> !pto.tile_buf<vec, 1x512xui8>
    %prefix = pto.subview %win[%c0, %c0] sizes [1, 256] valid [%c1, %c256] : !pto.tile_buf<vec, 1x512xui8> -> !pto.tile_buf<vec, 1x256xui8>
    %mask = pto.treshape %prefix : !pto.tile_buf<vec, 1x256xui8> -> !pto.tile_buf<vec, 8x32xui8>
    %later = pto.alloc_tile addr = %later_addr : !pto.tile_buf<vec, 1x8xf32>
    pto.tgather ins(%src, %threshold, %mask : !pto.tile_buf<vec, 8x128xf32>, f32, !pto.tile_buf<vec, 8x32xui8>) outs(%indices, %counts : !pto.tile_buf<vec, 8x128xi32>, !pto.tile_buf<vec, 1x8xi32>) {cmpMode = #pto<cmp gt>, offset = 7 : i32}
    %input_view = pto.make_tensor_view %input, shape = [%c1, %c8], strides = [%c8, %c1] : !pto.tensor_view<?x?xf32>
    %input_partition = pto.partition_view %input_view, offsets = [%c0, %c0], sizes = [%c1, %c8] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
    pto.tload ins(%input_partition : !pto.partition_tensor_view<1x8xf32>) outs(%later : !pto.tile_buf<vec, 1x8xf32>)
    return
  }
}

// A static subview of a runtime-offset window inherits the envelope mark;
// derived ranges stay unknown-extent and the in-backing load is ordered.
// NEST-LABEL: AICORE void gather_compare(
// NEST: TGATHER<
// NEST-NOT: TLOAD(
// NEST: set_flag(PIPE_S, PIPE_MTE2,
// NEST-NOT: TLOAD(
// NEST: set_flag(PIPE_V, PIPE_MTE2,
// NEST-NOT: TLOAD(
// NEST: wait_flag(PIPE_V, PIPE_MTE2,
// NEST-NOT: TLOAD(
// NEST: wait_flag(PIPE_S, PIPE_MTE2,
// NEST-NEXT: TLOAD(

// A static subview of a runtime-offset window inherits the envelope mark;
// derived ranges stay unknown-extent and the in-backing load is ordered.
// UNEST-LABEL: AICORE void gather_compare(
// UNEST: TGATHER<
// UNEST-NOT: TLOAD(
// UNEST: set_flag(PIPE_S, PIPE_MTE2,
// UNEST-NOT: TLOAD(
// UNEST: set_flag(PIPE_V, PIPE_MTE2,
// UNEST-NOT: TLOAD(
// UNEST: wait_flag(PIPE_V, PIPE_MTE2,
// UNEST-NOT: TLOAD(
// UNEST: wait_flag(PIPE_S, PIPE_MTE2,
// UNEST-NEXT: TLOAD(
//--- select_merge.pto
// arith.select merges a precise static head with a runtime-offset head that
// carry numerically identical records; dedup must OR the imprecise mark
// instead of dropping the conservative arm (precise arm is the select true
// value, processed first). Load at 9216 must stay ordered.
module attributes {pto.target_arch = "a2a3"} {
  func.func @gather_compare(%input: !pto.ptr<f32>, %dyn : index, %cond : i1) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c256 = arith.constant 256 : index
    %c512 = arith.constant 512 : index
    %c8 = arith.constant 8 : index
    %src_addr = arith.constant 0 : i64
    %scratch_addr = arith.constant 4096 : i64
    %indices_addr = arith.constant 16384 : i64
    %counts_addr = arith.constant 20480 : i64
    %later_addr = arith.constant 9216 : i64
    %threshold = arith.constant 1.0 : f32
    %src = pto.alloc_tile addr = %src_addr : !pto.tile_buf<vec, 8x128xf32>
    %indices = pto.alloc_tile addr = %indices_addr : !pto.tile_buf<vec, 8x128xi32>
    %counts = pto.alloc_tile addr = %counts_addr : !pto.tile_buf<vec, 1x8xi32>
    %scratch = pto.alloc_tile addr = %scratch_addr : !pto.tile_buf<vec, 1x8192xui8>
    %win = pto.subview %scratch[%c0, %dyn] sizes [1, 512] valid [%c1, %c512] : !pto.tile_buf<vec, 1x8192xui8> -> !pto.tile_buf<vec, 1x512xui8>
    %headDyn = pto.subview %win[%c0, %c0] sizes [1, 256] valid [%c1, %c256] : !pto.tile_buf<vec, 1x512xui8> -> !pto.tile_buf<vec, 1x256xui8>
    %headStat = pto.subview %scratch[%c0, %c0] sizes [1, 256] valid [%c1, %c256] : !pto.tile_buf<vec, 1x8192xui8> -> !pto.tile_buf<vec, 1x256xui8>
    %head = arith.select %cond, %headStat, %headDyn : !pto.tile_buf<vec, 1x256xui8>
    %mask = pto.treshape %head : !pto.tile_buf<vec, 1x256xui8> -> !pto.tile_buf<vec, 8x32xui8>
    %later = pto.alloc_tile addr = %later_addr : !pto.tile_buf<vec, 1x8xf32>
    pto.tgather ins(%src, %threshold, %mask : !pto.tile_buf<vec, 8x128xf32>, f32, !pto.tile_buf<vec, 8x32xui8>) outs(%indices, %counts : !pto.tile_buf<vec, 8x128xi32>, !pto.tile_buf<vec, 1x8xi32>) {cmpMode = #pto<cmp gt>, offset = 7 : i32}
    %input_view = pto.make_tensor_view %input, shape = [%c1, %c8], strides = [%c8, %c1] : !pto.tensor_view<?x?xf32>
    %input_partition = pto.partition_view %input_view, offsets = [%c0, %c0], sizes = [%c1, %c8] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
    pto.tload ins(%input_partition : !pto.partition_tensor_view<1x8xf32>) outs(%later : !pto.tile_buf<vec, 1x8xf32>)
    return
  }
}

// The select merges a precise arm and a dynamically-offset arm whose records
// are numerically identical: dedup must keep the imprecise mark.
// SEL-LABEL: AICORE void gather_compare(
// SEL: TGATHER<
// SEL-NOT: TLOAD(
// SEL: set_flag(PIPE_S, PIPE_MTE2,
// SEL-NOT: TLOAD(
// SEL: set_flag(PIPE_V, PIPE_MTE2,
// SEL-NOT: TLOAD(
// SEL: wait_flag(PIPE_V, PIPE_MTE2,
// SEL-NOT: TLOAD(
// SEL: wait_flag(PIPE_S, PIPE_MTE2,
// SEL-NEXT: TLOAD(

// The select merges a precise arm and a dynamically-offset arm whose records
// are numerically identical: dedup must keep the imprecise mark.
// USEL-LABEL: AICORE void gather_compare(
// USEL: TGATHER<
// USEL-NOT: TLOAD(
// USEL: set_flag(PIPE_S, PIPE_MTE2,
// USEL-NOT: TLOAD(
// USEL: set_flag(PIPE_V, PIPE_MTE2,
// USEL-NOT: TLOAD(
// USEL: wait_flag(PIPE_V, PIPE_MTE2,
// USEL-NOT: TLOAD(
// USEL: wait_flag(PIPE_S, PIPE_MTE2,
// USEL-NEXT: TLOAD(
//--- stride_subview.pto
// pto-isa addresses the derived index rows at the src tile's emitted physical
// shape: an 8x128 subview of an 8x256 backing emits 8x256, so the index table
// spans [16640, 24832) -- not the logical 4KiB. The 12288B backing covers the
// full derived footprint (256 bitmap + 8192 index + 32 cvt) and the outputs
// sit past its end. A load at 20768 is only ordered with the physical shape.
module attributes {pto.target_arch = "a2a3"} {
  func.func @gather_compare(%input: !pto.ptr<f32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %c128 = arith.constant 128 : index
    %c256 = arith.constant 256 : index
    %src_addr = arith.constant 0 : i64
    %scratch_addr = arith.constant 16384 : i64
    %indices_addr = arith.constant 28672 : i64
    %counts_addr = arith.constant 32768 : i64
    %later_addr = arith.constant 20768 : i64
    %threshold = arith.constant 1.0 : f32
    %srcRoot = pto.alloc_tile addr = %src_addr : !pto.tile_buf<vec, 8x256xf32>
    %src = pto.subview %srcRoot[%c0, %c0] sizes [8, 128] valid [%c8, %c128] : !pto.tile_buf<vec, 8x256xf32> -> !pto.tile_buf<vec, 8x128xf32>
    %indices = pto.alloc_tile addr = %indices_addr : !pto.tile_buf<vec, 8x128xi32>
    %counts = pto.alloc_tile addr = %counts_addr : !pto.tile_buf<vec, 1x8xi32>
    %scratch = pto.alloc_tile addr = %scratch_addr : !pto.tile_buf<vec, 1x12288xui8>
    %prefix = pto.subview %scratch[%c0, %c0] sizes [1, 256] valid [%c1, %c256] : !pto.tile_buf<vec, 1x12288xui8> -> !pto.tile_buf<vec, 1x256xui8>
    %mask = pto.treshape %prefix : !pto.tile_buf<vec, 1x256xui8> -> !pto.tile_buf<vec, 8x32xui8>
    %later = pto.alloc_tile addr = %later_addr : !pto.tile_buf<vec, 1x8xf32>
    pto.tgather ins(%src, %threshold, %mask : !pto.tile_buf<vec, 8x128xf32>, f32, !pto.tile_buf<vec, 8x32xui8>) outs(%indices, %counts : !pto.tile_buf<vec, 8x128xi32>, !pto.tile_buf<vec, 1x8xi32>) {cmpMode = #pto<cmp gt>, offset = 7 : i32}
    %input_view = pto.make_tensor_view %input, shape = [%c1, %c8], strides = [%c8, %c1] : !pto.tensor_view<?x?xf32>
    %input_partition = pto.partition_view %input_view, offsets = [%c0, %c0], sizes = [%c1, %c8] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
    pto.tload ins(%input_partition : !pto.partition_tensor_view<1x8xf32>) outs(%later : !pto.tile_buf<vec, 1x8xf32>)
    return
  }
}

// STR-LABEL: AICORE void gather_compare(
