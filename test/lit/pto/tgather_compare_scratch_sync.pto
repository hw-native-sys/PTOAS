// USTR-NOT: TLOAD(
// USTR: wait_flag(PIPE_S, PIPE_MTE2,
// USTR-NEXT: TLOAD(
//--- row_col_subview.pto
// A subview shrinking both dims (8x256 -> 4x128) still emits the parent's
