// RUN: pto-test-opt %s -vmi-mask-granularity-assignment | FileCheck %s --enable-var-scope
// RUN: pto-test-opt %s -vmi-mask-granularity-assignment -vmi-mask-granularity-assignment | FileCheck %s --enable-var-scope

// A narrow mask produced outside a pto.vecscope and consumed inside it has to be
// rebuilt inside the scope: VPTO lowering materializes a narrow mask from a
// predicate at the producing site, and a mask value that crosses the scope
// boundary cannot carry that reconstruction. Only the placement adapts, the
// granularity of the value itself does not change.

module {
  func.func @vmi_mask_granularity_vecscope_boundary(%n: index,
      %v: !pto.vmi.vreg<64xf16>, %d: !pto.ptr<f16, ub>, %off: index) {
    %root = pto.vmi.create_mask %n : index -> !pto.vmi.mask<64xpred>
    pto.vecscope {
      pto.vmi.masked_store %v, %d[%off], %root
          : !pto.vmi.vreg<64xf16>, !pto.ptr<f16, ub>, index, !pto.vmi.mask<64xpred>
    }
    return
  }
}

// CHECK-LABEL: func.func @vmi_mask_granularity_vecscope_boundary(
// CHECK: %[[ROOT:.*]] = pto.vmi.create_mask %{{.*}} : index -> !pto.vmi.mask<64xb32>
// CHECK: pto.vecscope {
// CHECK-NEXT: %[[IN_SCOPE:.*]] = pto.vmi.create_mask %{{.*}} : index -> !pto.vmi.mask<64xb16>
// CHECK-NEXT: pto.vmi.masked_store {{.*}}, %{{.*}}{{\[}}%{{.*}}], %[[IN_SCOPE]] : !pto.vmi.vreg<64xf16>, !pto.ptr<f16, ub>, index, !pto.vmi.mask<64xb16>
// CHECK: return
