// RUN: pto-test-opt %s -split-input-file -vmi-to-vpto | FileCheck %s --implicit-check-not=pto.vmi.

// Internal VMI lengths remain general: round partial 128-request groups up,
// including a partial final byte carrier and more than two index chunks.

// CHECK-LABEL: func.func @scatter_n127(
// CHECK-COUNT-1: pto.vscatter
// CHECK-NOT: pto.vscatter
// CHECK: return
module {
  func.func @scatter_n127(
      %value: !pto.vmi.vreg<127xui8, #pto.vmi.layout<contiguous>>,
      %dst: !pto.ptr<ui8, ub>,
      %indices: !pto.vmi.vreg<127xi16, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<127xb8, #pto.vmi.layout<contiguous>>) {
    pto.vmi.scatter %value, %dst[%indices], %mask
        : !pto.vmi.vreg<127xui8, #pto.vmi.layout<contiguous>>, !pto.ptr<ui8, ub>,
          !pto.vmi.vreg<127xi16, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<127xb8, #pto.vmi.layout<contiguous>>
    return
  }
}

