// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=VPTO

// A group-layout reduce result is not carried across the function boundary;
// it is stored to UB through the group-store path.

module {
  func.func @vmi_layout_assignment_group_reduce_f16_s64_g4(
      %source: !pto.vmi.vreg<256xf16>,
      %mask: !pto.vmi.mask<256xpred>,
      %dst: !pto.ptr<f16, ub>, %off: index) {
    %c1 = arith.constant 1 : index
    %out = pto.vmi.vcadd %source, %mask
        {group = 4, reassoc}
        : !pto.vmi.vreg<256xf16>, !pto.vmi.mask<256xpred>
        -> !pto.vmi.vreg<4xf16>
    pto.vmi.vstore %out, %dst[%off], %c1 {group = 4}
        : !pto.vmi.vreg<4xf16>, !pto.ptr<f16, ub>
    return
  }

  func.func @vmi_layout_assignment_group_reduce_f16_s64_g12(
      %source: !pto.vmi.vreg<768xf16>,
      %mask: !pto.vmi.mask<768xpred>,
      %dst: !pto.ptr<f16, ub>, %off: index) {
    %c1 = arith.constant 1 : index
    %out = pto.vmi.vcadd %source, %mask
        {group = 12, reassoc}
        : !pto.vmi.vreg<768xf16>, !pto.vmi.mask<768xpred>
        -> !pto.vmi.vreg<12xf16>
    pto.vmi.vstore %out, %dst[%off], %c1 {group = 12}
        : !pto.vmi.vreg<12xf16>, !pto.ptr<f16, ub>
    return
  }
}

// CHECK-LABEL: func.func @vmi_layout_assignment_group_reduce_f16_s64_g4(
// CHECK-SAME: %arg0: !pto.vmi.vreg<256xf16, #pto.vmi.layout<contiguous>>
// CHECK-SAME: %arg1: !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>>
// CHECK: %[[SRC4:.*]] = pto.vmi.ensure_layout %arg0
// CHECK-SAME: -> !pto.vmi.vreg<256xf16, #pto.vmi.layout<deinterleaved = 4>>
// CHECK: %{{.*}} = pto.vmi.ensure_mask_layout
// CHECK-SAME: -> !pto.vmi.mask<256xb32, #pto.vmi.layout<deinterleaved = 4>>
// CHECK: %{{.*}} = pto.vmi.ensure_mask_granularity
// CHECK-SAME: -> !pto.vmi.mask<256xb16, #pto.vmi.layout<deinterleaved = 4>>
// CHECK: %[[RED4:.*]] = pto.vmi.group_reduce_addf %[[SRC4]], %[[MASK4:[^ ]+]]
// CHECK-SAME: -> !pto.vmi.vreg<4xf16, #pto.vmi.layout<num_groups = 4, slots = 8>>
// CHECK: pto.vmi.group_store %[[RED4]]
// CHECK-SAME: !pto.vmi.vreg<4xf16, #pto.vmi.layout<num_groups = 4, slots = 8>>, !pto.ptr<f16, ub>

// CHECK-LABEL: func.func @vmi_layout_assignment_group_reduce_f16_s64_g12(
// CHECK-SAME: %arg0: !pto.vmi.vreg<768xf16, #pto.vmi.layout<contiguous>>
// CHECK-SAME: %arg1: !pto.vmi.mask<768xb32, #pto.vmi.layout<contiguous>>
// CHECK: %[[SRC12:.*]] = pto.vmi.ensure_layout %arg0
// CHECK-SAME: -> !pto.vmi.vreg<768xf16, #pto.vmi.layout<deinterleaved = 4>>
// CHECK: %{{.*}} = pto.vmi.ensure_mask_granularity
// CHECK-SAME: -> !pto.vmi.mask<768xb16, #pto.vmi.layout<contiguous>>
// CHECK: %{{.*}} = pto.vmi.ensure_mask_layout
// CHECK-SAME: -> !pto.vmi.mask<768xb16, #pto.vmi.layout<deinterleaved = 4>>
// CHECK: %[[RED12:.*]] = pto.vmi.group_reduce_addf %[[SRC12]], %[[MASK12:[^ ]+]]
// CHECK-SAME: -> !pto.vmi.vreg<12xf16, #pto.vmi.layout<num_groups = 12, slots = 8>>
// CHECK: pto.vmi.group_store %[[RED12]]
// CHECK-SAME: !pto.vmi.vreg<12xf16, #pto.vmi.layout<num_groups = 12, slots = 8>>, !pto.ptr<f16, ub>

// VPTO-LABEL: func.func @vmi_layout_assignment_group_reduce_f16_s64_g4(
// VPTO-COUNT-4: pto.vdintlv
// VPTO-COUNT-4: pto.pdintlv_b32
// VPTO-COUNT-4: pto.ppack
// VPTO-COUNT-1: pto.vsts

// VPTO-LABEL: func.func @vmi_layout_assignment_group_reduce_f16_s64_g12(
// VPTO-COUNT-8: pto.vdintlv
// VPTO-COUNT-12: pto.ppack
// VPTO-COUNT-8: pto.pdintlv_b16
// VPTO-COUNT-2: pto.vsts
