// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s

module {
  func.func @vmi_to_vpto_load_deint2_f16(
      %src: !pto.ptr<f16, ub>, %offset: index)
      -> (!pto.vreg<128xf16>, !pto.vreg<128xf16>) {
    %c16 = arith.constant 16 : index
    %aligned_offset = arith.muli %offset, %c16 : index
    %c128 = arith.constant 128 : index
    %second_offset = arith.addi %aligned_offset, %c128 : index
    %first = pto.vmi.vload %src[%aligned_offset]
        : !pto.ptr<f16, ub> -> !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>
    %second = pto.vmi.vload %src[%second_offset]
        : !pto.ptr<f16, ub> -> !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>
    %mask = pto.vmi.pset "PAT_ALL"
        : !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>>
    %lo, %hi = pto.vmi.vdintlv %first, %second, %mask
        : !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>,
           !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>
    %p0 = "pto.vmi.unpack"(%lo)
        : (!pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>) -> !pto.vreg<128xf16>
    %p1 = "pto.vmi.unpack"(%hi)
        : (!pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>) -> !pto.vreg<128xf16>
    return %p0, %p1 : !pto.vreg<128xf16>, !pto.vreg<128xf16>
  }

  func.func @vmi_to_vpto_store_deint2_i8(
      %lo: !pto.vmi.vreg<256xi8, #pto.vmi.layout<contiguous>>,
      %hi: !pto.vmi.vreg<256xi8, #pto.vmi.layout<contiguous>>,
      %dst: !pto.ptr<i8, ub>, %offset: index) {
    %c32 = arith.constant 32 : index
    %c256 = arith.constant 256 : index
    %aligned_offset = arith.muli %offset, %c32 : index
    %second_offset = arith.addi %aligned_offset, %c256 : index
    %mask = pto.vmi.pset "PAT_ALL"
        : !pto.vmi.mask<256xb8, #pto.vmi.layout<contiguous>>
    %first, %second = pto.vmi.vintlv %lo, %hi, %mask
        : !pto.vmi.vreg<256xi8, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<256xi8, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<256xb8, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<256xi8, #pto.vmi.layout<contiguous>>,
           !pto.vmi.vreg<256xi8, #pto.vmi.layout<contiguous>>
    pto.vmi.vstore %first, %dst[%aligned_offset]
        : !pto.vmi.vreg<256xi8, #pto.vmi.layout<contiguous>>, !pto.ptr<i8, ub>
    pto.vmi.vstore %second, %dst[%second_offset]
        : !pto.vmi.vreg<256xi8, #pto.vmi.layout<contiguous>>, !pto.ptr<i8, ub>
    return
  }
}

// CHECK-LABEL: func.func @vmi_to_vpto_load_deint2_f16(
// CHECK: %[[P0:.*]], %[[P1:.*]] = pto.vldsx2 %arg0[{{.*}}], "DINTLV_B16"
// CHECK: return %[[P0]], %[[P1]]
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast

// CHECK-LABEL: func.func @vmi_to_vpto_store_deint2_i8(
// CHECK: %[[MASK:.*]] = pto.pset_b8 "PAT_ALL"
// CHECK: pto.vstsx2 %arg0, %arg1, %arg2[{{.*}}], "INTLV_B8", %[[MASK]]
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast
