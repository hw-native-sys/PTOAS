// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s --implicit-check-not=pto.vmi. --implicit-check-not='!pto.vmi.'

// A short f16 read widened into a short f32 store is planned from the carrier
// view of the assigned layouts.  Layout assignment gives the widening a
// single-carrier group packet source (the narrow read is lane-strided) and a
// group packet result (the short store is a group store), and that pair used to
// reach no vcvt plan at all: the source and result parts were there, but the
// lowering only recognized the dense lane-strided form.  The packet and the
// dense lane-strided value select the same carrier lanes, so the widening now
// emits the same one-part vcvt per part as the dense form.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @short_extend_store_f32_L1(%src: !pto.ptr<f16, ub>, %dst: !pto.ptr<f32, ub>, %off: index) attributes {pto.kernel} {
    %c16 = arith.constant 16 : index
    %aoff = arith.muli %off, %c16 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%aoff] : !pto.ptr<f16, ub> -> !pto.vmi.vreg<1xf16>
      %w = pto.vmi.vcvt %s : !pto.vmi.vreg<1xf16> -> !pto.vmi.vreg<1xf32>
      pto.vmi.vstore %w, %dst[%aoff] : !pto.vmi.vreg<1xf32>, !pto.ptr<f32, ub>
    }
    return
  }
  func.func @short_extend_store_f32_L2(%src: !pto.ptr<f16, ub>, %dst: !pto.ptr<f32, ub>, %off: index) attributes {pto.kernel} {
    %c16 = arith.constant 16 : index
    %aoff = arith.muli %off, %c16 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%aoff] : !pto.ptr<f16, ub> -> !pto.vmi.vreg<2xf16>
      %w = pto.vmi.vcvt %s : !pto.vmi.vreg<2xf16> -> !pto.vmi.vreg<2xf32>
      pto.vmi.vstore %w, %dst[%aoff] : !pto.vmi.vreg<2xf32>, !pto.ptr<f32, ub>
    }
    return
  }
  func.func @short_extend_store_f32_L4(%src: !pto.ptr<f16, ub>, %dst: !pto.ptr<f32, ub>, %off: index) attributes {pto.kernel} {
    %c16 = arith.constant 16 : index
    %aoff = arith.muli %off, %c16 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%aoff] : !pto.ptr<f16, ub> -> !pto.vmi.vreg<4xf16>
      %w = pto.vmi.vcvt %s : !pto.vmi.vreg<4xf16> -> !pto.vmi.vreg<4xf32>
      pto.vmi.vstore %w, %dst[%aoff] : !pto.vmi.vreg<4xf32>, !pto.ptr<f32, ub>
    }
    return
  }
  func.func @short_extend_store_f32_L8(%src: !pto.ptr<f16, ub>, %dst: !pto.ptr<f32, ub>, %off: index) attributes {pto.kernel} {
    %c16 = arith.constant 16 : index
    %aoff = arith.muli %off, %c16 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%aoff] : !pto.ptr<f16, ub> -> !pto.vmi.vreg<8xf16>
      %w = pto.vmi.vcvt %s : !pto.vmi.vreg<8xf16> -> !pto.vmi.vreg<8xf32>
      pto.vmi.vstore %w, %dst[%aoff] : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    }
    return
  }
}

// Every shape widens with the single EVEN part that reads the semantic lanes
// and stores with a bounded predicate, and no VMI op survives the pipeline.
// CHECK-LABEL: func.func @short_extend_store_f32_L1(
// CHECK: pto.vcvt {{.*}}part = "EVEN"
// CHECK: pto.vsts
// CHECK-LABEL: func.func @short_extend_store_f32_L2(
// CHECK: pto.vcvt {{.*}}part = "EVEN"
// CHECK: pto.vsts
// CHECK-LABEL: func.func @short_extend_store_f32_L4(
// CHECK: pto.vcvt {{.*}}part = "EVEN"
// CHECK: pto.vsts
// CHECK-LABEL: func.func @short_extend_store_f32_L8(
// CHECK: pto.vcvt {{.*}}part = "EVEN"
// CHECK: pto.vsts
