// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto -vpto-combine-reductions | FileCheck %s --check-prefix=LOWER

module {
  func.func @vmi_layout_assignment_extf_bf16_amax_contiguous(
      %source: !pto.vmi.vreg<128xbf16>,
      %scale_out: !pto.ptr<f32, ub>,
      %off: index) {
    %c128 = arith.constant 128 : index
    %c1 = arith.constant 1 : index
    %mask = pto.vmi.create_mask %c128 : index -> !pto.vmi.mask<128xpred>
    %wide = pto.vmi.vcvt %source
        : !pto.vmi.vreg<128xbf16> -> !pto.vmi.vreg<128xf32>
    %amax = pto.vmi.vcmax %wide, %mask {group = 4}
        : !pto.vmi.vreg<128xf32>, !pto.vmi.mask<128xpred>
        -> !pto.vmi.vreg<4xf32>
    pto.vmi.vstore %amax, %scale_out[%off], %c1 {group = 4}
        : !pto.vmi.vreg<4xf32>, !pto.ptr<f32, ub>
    return
  }
}

// ASSIGN-LABEL: func.func @vmi_layout_assignment_extf_bf16_amax_contiguous(
// ASSIGN-SAME: %[[SOURCE:.*]]: !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
// ASSIGN: %[[WIDE:.*]] = pto.vmi.extf %[[SOURCE]]
// ASSIGN-SAME: -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NOT: pto.vmi.ensure_layout %[[WIDE]]
// ASSIGN: pto.vmi.group_reduce_maxf %[[WIDE]]

// LOWER-LABEL: func.func @vmi_layout_assignment_extf_bf16_amax_contiguous(
// LOWER: %[[ZERO:.*]] = pto.vdup {{.*}} : bf16, !pto.mask<b16> -> !pto.vreg<128xbf16>
// LOWER: %[[LO:.*]], %[[HI:.*]] = pto.vintlv %[[ZERO]], %arg0
// LOWER: %[[P0:.*]] = pto.vbitcast %[[LO]] : !pto.vreg<128xbf16> -> !pto.vreg<64xf32>
// LOWER: %[[P1:.*]] = pto.vbitcast %[[HI]] : !pto.vreg<128xbf16> -> !pto.vreg<64xf32>
// LOWER: pto.vcmax %[[P0]]
// LOWER: pto.vcmax %[[P1]]
// LOWER-NOT: pto.vcvt
// LOWER-NOT: pto.vmi.
// LOWER-NOT: !pto.vmi.
// LOWER-NOT: unrealized_conversion_cast
