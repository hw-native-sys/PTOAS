// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=VPTO --implicit-check-not=pto.vmi. --implicit-check-not='!pto.vmi'

// E2B produces d4, while the contiguous loads and store can use d2 directly.
// The scale is converted once at its shared producer point and reused by both
// mul operations, costing two vintlv operations. An all-d4 plan would instead
// require four vdintlv plus two vintlv operations.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @multi_use(
      %scale_src: !pto.ptr<f32, ub>, %lhs_src: !pto.ptr<f32, ub>,
      %rhs_src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>, %offset: index) {
    %one = arith.constant 1 : index
    %scale = pto.vmi.vload %scale_src[%offset], %one
        {dist_mode = "brc", group = 8}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<256xf32>
    %lhs = pto.vmi.vload %lhs_src[%offset] {dist_mode = "continuous"}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<256xf32>
    %rhs = pto.vmi.vload %rhs_src[%offset] {dist_mode = "continuous"}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<256xf32>
    %x = pto.vmi.vmul %lhs, %scale
        : !pto.vmi.vreg<256xf32>, !pto.vmi.vreg<256xf32>
          -> !pto.vmi.vreg<256xf32>
    %y = pto.vmi.vmul %rhs, %scale
        : !pto.vmi.vreg<256xf32>, !pto.vmi.vreg<256xf32>
          -> !pto.vmi.vreg<256xf32>
    %sum = pto.vmi.vadd %x, %y
        : !pto.vmi.vreg<256xf32>, !pto.vmi.vreg<256xf32>
          -> !pto.vmi.vreg<256xf32>
    pto.vmi.vstore %sum, %dst[%offset] {dist_mode = "continuous"}
        : !pto.vmi.vreg<256xf32>, !pto.ptr<f32, ub>
    return
  }
}

// ASSIGN-LABEL: func.func @multi_use(
// ASSIGN: pto.vmi.group_broadcast_load
// ASSIGN-SAME: -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN: pto.vmi.ensure_layout
// ASSIGN-SAME: !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>> -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-COUNT-2: pto.vmi.load
// ASSIGN-SAME: -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.mulf
// ASSIGN-SAME: -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.addf
// ASSIGN-SAME: -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.store
// ASSIGN-SAME: !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>>

// VPTO-LABEL: func.func @multi_use(
// VPTO: pto.vlds {{.*}} {dist = "E2B_B32"}
// VPTO-COUNT-2: pto.vintlv
// VPTO-COUNT-4: pto.vldsx2
// VPTO: pto.vmul
// VPTO: pto.vadd
// VPTO: pto.vstsx2
// VPTO-NOT: pto.vdintlv
