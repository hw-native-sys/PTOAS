// CHECK-NEXT: %[[VAL_20:[a-zA-Z0-9_.$-]+]] = pto.vcvt %[[VAL_17]], %[[VAL_13]] {part = "EVEN"} : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
