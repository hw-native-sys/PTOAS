// CHECK-NEXT: pto.vsts %[[VAL_81]], %[[VAL_51]]{{\[}}%[[VAL_65]]], %[[VAL_54]] {dist = "PK_B16"} : !pto.vreg<256xf8E5M2>, !pto.ptr<f8E5M2, ub>, index, !pto.mask<b16>
