// ASSIGN-LABEL: func.func @per_block_bf16_group8_quant_vmi_opt(
// ASSIGN-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.ptr<bf16, ub>,
// ASSIGN-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.ptr<f8E4M3FN, ub>,
// ASSIGN-SAME: %[[VAL_2:[a-zA-Z0-9_.$-]+]]: index) attributes {pto.kernel} {
// ASSIGN-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = arith.constant 128 : index
// ASSIGN-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = arith.constant 256 : index
