// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-pre-assignment-combine | FileCheck %s
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-pre-assignment-combine -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

module {
  func.func @split128(%src: !pto.ptr<bf16, ub>, %a: !pto.ptr<f32, ub>, %b: !pto.ptr<f32, ub>, %off: index) {
    %x = pto.vmi.vload %src[%off] : !pto.ptr<bf16, ub>, index -> !pto.vmi.vreg<128xbf16>
    %w = pto.vmi.vinterpret_cast %x : !pto.vmi.vreg<128xbf16> -> !pto.vmi.vreg<64xui32>
    %lo, %hi = pto.vmi.vunzip %w : !pto.vmi.vreg<64xui32> -> !pto.vmi.vreg<64xbf16>, !pto.vmi.vreg<64xbf16>
    %even = pto.vmi.vcvt %lo : !pto.vmi.vreg<64xbf16> -> !pto.vmi.vreg<64xf32>
    %odd = pto.vmi.vcvt %hi : !pto.vmi.vreg<64xbf16> -> !pto.vmi.vreg<64xf32>
    pto.vmi.vstore %even, %a[%off] : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, index
    pto.vmi.vstore %odd, %b[%off] : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, index
    return
  }
  func.func @extra_half_use(%src: !pto.ptr<bf16, ub>, %a: !pto.ptr<f32, ub>, %b: !pto.ptr<f32, ub>, %off: index) {
    %x = pto.vmi.vload %src[%off] : !pto.ptr<bf16, ub>, index -> !pto.vmi.vreg<128xbf16>
    %w = pto.vmi.vinterpret_cast %x : !pto.vmi.vreg<128xbf16> -> !pto.vmi.vreg<64xui32>
    %lo, %hi = pto.vmi.vunzip %w : !pto.vmi.vreg<64xui32> -> !pto.vmi.vreg<64xbf16>, !pto.vmi.vreg<64xbf16>
    %extra = pto.vmi.vcvt %lo : !pto.vmi.vreg<64xbf16> -> !pto.vmi.vreg<64xf32>
    pto.vmi.vstore %extra, %a[%off] : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, index
    %even = pto.vmi.vcvt %lo : !pto.vmi.vreg<64xbf16> -> !pto.vmi.vreg<64xf32>
    %odd = pto.vmi.vcvt %hi : !pto.vmi.vreg<64xbf16> -> !pto.vmi.vreg<64xf32>
    pto.vmi.vstore %even, %a[%off] : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, index
    pto.vmi.vstore %odd, %b[%off] : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, index
    return
  }
  func.func @extra_view_use(%src: !pto.ptr<bf16, ub>, %a: !pto.ptr<f32, ub>, %b: !pto.ptr<f32, ub>, %off: index, %bits: !pto.ptr<ui32, ub>) {
    %x = pto.vmi.vload %src[%off] : !pto.ptr<bf16, ub>, index -> !pto.vmi.vreg<128xbf16>
    %w = pto.vmi.vinterpret_cast %x : !pto.vmi.vreg<128xbf16> -> !pto.vmi.vreg<64xui32>
    pto.vmi.vstore %w, %bits[%off] : !pto.vmi.vreg<64xui32>, !pto.ptr<ui32, ub>, index
    %lo, %hi = pto.vmi.vunzip %w : !pto.vmi.vreg<64xui32> -> !pto.vmi.vreg<64xbf16>, !pto.vmi.vreg<64xbf16>
    %even = pto.vmi.vcvt %lo : !pto.vmi.vreg<64xbf16> -> !pto.vmi.vreg<64xf32>
    %odd = pto.vmi.vcvt %hi : !pto.vmi.vreg<64xbf16> -> !pto.vmi.vreg<64xf32>
    pto.vmi.vstore %even, %a[%off] : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, index
    pto.vmi.vstore %odd, %b[%off] : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, index
    return
  }
  func.func @explicit_layout(%src: !pto.ptr<bf16, ub>, %a: !pto.ptr<f32, ub>, %b: !pto.ptr<f32, ub>, %off: index) {
    %x = pto.vmi.vload %src[%off] : !pto.ptr<bf16, ub>, index -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
    %w = pto.vmi.vinterpret_cast %x : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xui32, #pto.vmi.layout<contiguous>>
    %lo, %hi = pto.vmi.vunzip %w : !pto.vmi.vreg<64xui32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xbf16, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<64xbf16, #pto.vmi.layout<contiguous>>
    %even = pto.vmi.vcvt %lo : !pto.vmi.vreg<64xbf16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    %odd = pto.vmi.vcvt %hi : !pto.vmi.vreg<64xbf16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    pto.vmi.vstore %even, %a[%off] : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>, !pto.ptr<f32, ub>, index
    pto.vmi.vstore %odd, %b[%off] : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>, !pto.ptr<f32, ub>, index
    return
  }

}

// CHECK-LABEL: func.func @split128
// CHECK: pto.vmi.deinterleave_extf
// CHECK-NOT: pto.vmi.vunzip
// CHECK-NOT: pto.vmi.extf
// LOWER-LABEL: func.func @split128
// LOWER-NOT: pto.vdintlv
// LOWER-NOT: pto.vintlv
// LOWER: pto.vcvt {{.*}} {part = "EVEN"}
// LOWER: pto.vcvt {{.*}} {part = "ODD"}
// LOWER-NOT: pto.vdintlv
// LOWER-NOT: pto.vintlv
// LOWER: return

// CHECK-LABEL: func.func @extra_half_use
// CHECK-NOT: pto.vmi.deinterleave_extf
// CHECK: pto.vmi.vunzip
// CHECK-LABEL: func.func @extra_view_use
// CHECK: pto.vmi.bitcast
// CHECK: pto.vmi.store
// CHECK: pto.vmi.deinterleave_extf

// LOWER-LABEL: func.func @extra_half_use
// LOWER: pto.vdintlv
// LOWER-LABEL: func.func @extra_view_use
// LOWER: pto.vcvt {{.*}} {part = "EVEN"}
// LOWER: pto.vcvt {{.*}} {part = "ODD"}

// CHECK-LABEL: func.func @explicit_layout
// CHECK-NOT: pto.vmi.deinterleave_extf
// CHECK: pto.vmi.vunzip
// LOWER-LABEL: func.func @explicit_layout
// LOWER: pto.vdintlv
