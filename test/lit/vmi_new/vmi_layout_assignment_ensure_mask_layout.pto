// RUN: pto-test-opt %s -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s

module {
  func.func @ensure_mask_layout(
      %x: !pto.vmi.mask<256xb16, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.mask<256xb16, #pto.vmi.layout<deinterleaved = 2>> {
    %r = pto.vmi.ensure_mask_layout %x
        : !pto.vmi.mask<256xb16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.mask<256xb16, #pto.vmi.layout<deinterleaved = 2>>
    return %r : !pto.vmi.mask<256xb16, #pto.vmi.layout<deinterleaved = 2>>
  }
}

// CHECK-LABEL: func.func @ensure_mask_layout(
// CHECK: pto.vmi.ensure_mask_layout
