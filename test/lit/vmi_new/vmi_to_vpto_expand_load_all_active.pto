// RUN: pto-test-opt %s -vmi-to-vpto | FileCheck %s

module {
  func.func @vmi_to_vpto_expand_load_all_active(
      %src: !pto.ptr<f32, ub>,
      %offset: index,
      %passthru: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<64xf32> {
    %active = arith.constant 64 : index
    %mask = pto.vmi.create_mask %active
        : index -> !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
    %out = pto.vmi.expand_load %src[%offset], %mask, %passthru
        : !pto.ptr<f32, ub>,
          !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    %part = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>)
        -> !pto.vreg<64xf32>
    return %part : !pto.vreg<64xf32>
  }

}

// CHECK-LABEL: func.func @vmi_to_vpto_expand_load_all_active(
// CHECK-NOT: pto.vlds
// CHECK: %[[BASE:.*]] = pto.addptr %arg0, %arg1
// CHECK: %[[LOAD:.*]] = pto.vgather2_bc %[[BASE]]
// CHECK: %[[OUT:.*]] = pto.vsel %[[LOAD]], %arg2
// CHECK: return %[[OUT]]
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast
