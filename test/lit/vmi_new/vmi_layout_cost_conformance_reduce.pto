// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance | FileCheck %s --check-prefix=COST
// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance -vmi-to-vpto -test-vmi-layout-lowering-conformance > /dev/null

module {
  func.func @reduce_addf(
      %source: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>> {
    %result = pto.vmi.reduce_addf %source, %mask {
        reassoc, test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
    return %result : !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
  }

  func.func @reduce_addi(
      %source: !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<1xsi32, #pto.vmi.layout<contiguous>> {
    %result = pto.vmi.reduce_addi %source, %mask {
        test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xsi32, #pto.vmi.layout<contiguous>>
    return %result : !pto.vmi.vreg<1xsi32, #pto.vmi.layout<contiguous>>
  }

  func.func @reduce_maxf(
      %source: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>> {
    %result = pto.vmi.reduce_maxf %source, %mask {
        test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
    return %result : !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
  }

  func.func @reduce_minf(
      %source: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>> {
    %result = pto.vmi.reduce_minf %source, %mask {
        test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
    return %result : !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
  }

  func.func @reduce_maxi(
      %source: !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<1xsi32, #pto.vmi.layout<contiguous>> {
    %result = pto.vmi.reduce_maxi %source, %mask {
        test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xsi32, #pto.vmi.layout<contiguous>>
    return %result : !pto.vmi.vreg<1xsi32, #pto.vmi.layout<contiguous>>
  }

  func.func @reduce_mini(
      %source: !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<1xsi32, #pto.vmi.layout<contiguous>> {
    %result = pto.vmi.reduce_mini %source, %mask {
        test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xsi32, #pto.vmi.layout<contiguous>>
    return %result : !pto.vmi.vreg<1xsi32, #pto.vmi.layout<contiguous>>
  }

  func.func @reduce_addf_multichunk(
      %source: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>> {
    %result = pto.vmi.reduce_addf %source, %mask {
        reassoc, test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
    return %result : !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
  }
}

// COST: vmi-layout-cost-conformance reduce_addf pto.vmi.reduce_addf relation=0 cost=0
// COST: vmi-layout-cost-conformance reduce_addi pto.vmi.reduce_addi relation=0 cost=0
// COST: vmi-layout-cost-conformance reduce_maxf pto.vmi.reduce_maxf relation=0 cost=0
// COST: vmi-layout-cost-conformance reduce_minf pto.vmi.reduce_minf relation=0 cost=0
// COST: vmi-layout-cost-conformance reduce_maxi pto.vmi.reduce_maxi relation=0 cost=0
// COST: vmi-layout-cost-conformance reduce_mini pto.vmi.reduce_mini relation=0 cost=0
// COST: vmi-layout-cost-conformance reduce_addf_multichunk pto.vmi.reduce_addf relation=0 cost=0
