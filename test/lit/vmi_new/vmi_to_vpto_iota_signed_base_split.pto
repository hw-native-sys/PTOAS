// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | \
// RUN:   FileCheck %s --implicit-check-not='arith.addi{{.*}}: si32' \
// RUN:     --implicit-check-not='arith.subi{{.*}}: si32' \
// RUN:     --implicit-check-not='arith.addi{{.*}}: ui32'
// RUN: ptoas --pto-backend=vpto --pto-arch=a5 --emit-vpto %s -o /dev/null

module {
  func.func @vmi_to_vpto_iota_signed_base_64(
      %base: si32, %dst: !pto.ptr<si32, ub>) {
    %c0 = arith.constant 0 : index
    %idx = pto.vmi.vci %base : si32 -> !pto.vmi.vreg<64xsi32>
    pto.vmi.vstore %idx, %dst[%c0]
        : !pto.vmi.vreg<64xsi32>, !pto.ptr<si32, ub>
    return
  }

  func.func @vmi_to_vpto_iota_signed_base_split(
      %base: si32, %dst: !pto.ptr<si32, ub>) {
    %c0 = arith.constant 0 : index
    %idx = pto.vmi.vci %base : si32 -> !pto.vmi.vreg<128xsi32>
    pto.vmi.vstore %idx, %dst[%c0]
        : !pto.vmi.vreg<128xsi32>, !pto.ptr<si32, ub>
    return
  }

  func.func @vmi_to_vpto_iota_signed_base_desc_split(
      %base: si32, %dst: !pto.ptr<si32, ub>) {
    %c0 = arith.constant 0 : index
    %idx = pto.vmi.vci %base {order = "DESC"}
        : si32 -> !pto.vmi.vreg<128xsi32>
    pto.vmi.vstore %idx, %dst[%c0]
        : !pto.vmi.vreg<128xsi32>, !pto.ptr<si32, ub>
    return
  }

  func.func @vmi_to_vpto_iota_signed_base_256(
      %base: si32, %dst: !pto.ptr<si32, ub>) {
    %c0 = arith.constant 0 : index
    %idx = pto.vmi.vci %base : si32 -> !pto.vmi.vreg<256xsi32>
    pto.vmi.vstore %idx, %dst[%c0]
        : !pto.vmi.vreg<256xsi32>, !pto.ptr<si32, ub>
    return
  }

  func.func @vmi_to_vpto_iota_unsigned_base_256(
      %base: ui32, %dst: !pto.ptr<ui32, ub>) {
    %c0 = arith.constant 0 : index
    %idx = pto.vmi.vci %base : ui32 -> !pto.vmi.vreg<256xui32>
    pto.vmi.vstore %idx, %dst[%c0]
        : !pto.vmi.vreg<256xui32>, !pto.ptr<ui32, ub>
    return
  }
}

// CHECK-LABEL: func.func @vmi_to_vpto_iota_signed_base_64(
// CHECK-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: si32,
// CHECK-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.ptr<si32, ub>) {
// CHECK-NEXT: %[[VAL_2:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : index
// CHECK-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = pto.vci %[[VAL_0]] : si32 -> !pto.vreg<64xsi32>
// CHECK-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK-NEXT: pto.vsts %[[VAL_3]], %[[VAL_1]]{{\[}}%[[VAL_2]]], %[[VAL_4]] : !pto.vreg<64xsi32>, !pto.ptr<si32, ub>, index, !pto.mask<b32>
// CHECK-NEXT: return
// CHECK-NEXT: }
// CHECK-LABEL: func.func @vmi_to_vpto_iota_signed_base_split(
// CHECK-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: si32,
// CHECK-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.ptr<si32, ub>) {
// CHECK-NEXT: %[[VAL_2:[a-zA-Z0-9_.$-]+]] = arith.constant 1 : i32
// CHECK-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = arith.constant 2 : i32
// CHECK-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : i32
// CHECK-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : index
// CHECK-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = builtin.unrealized_conversion_cast %[[VAL_4]] : i32 to si32
// CHECK-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = builtin.unrealized_conversion_cast %[[VAL_3]] : i32 to si32
// CHECK-NEXT: %[[VAL_9:[a-zA-Z0-9_.$-]+]] = pto.vci %[[VAL_7]] : si32 -> !pto.vreg<64xsi32>
// CHECK-NEXT: %[[VAL_10:[a-zA-Z0-9_.$-]+]] = pto.vmuls %[[VAL_9]], %[[VAL_8]], %[[VAL_6]] : !pto.vreg<64xsi32>, si32, !pto.mask<b32> -> !pto.vreg<64xsi32>
// CHECK-NEXT: %[[VAL_11:[a-zA-Z0-9_.$-]+]] = pto.vadds %[[VAL_10]], %[[VAL_0]], %[[VAL_6]] : !pto.vreg<64xsi32>, si32, !pto.mask<b32> -> !pto.vreg<64xsi32>
// CHECK-NEXT: %[[VAL_12:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK-NEXT: %[[VAL_13:[a-zA-Z0-9_.$-]+]] = builtin.unrealized_conversion_cast %[[VAL_4]] : i32 to si32
// CHECK-NEXT: %[[VAL_14:[a-zA-Z0-9_.$-]+]] = builtin.unrealized_conversion_cast %[[VAL_3]] : i32 to si32
// CHECK-NEXT: %[[VAL_15:[a-zA-Z0-9_.$-]+]] = pto.vci %[[VAL_13]] : si32 -> !pto.vreg<64xsi32>
// CHECK-NEXT: %[[VAL_16:[a-zA-Z0-9_.$-]+]] = pto.vmuls %[[VAL_15]], %[[VAL_14]], %[[VAL_12]] : !pto.vreg<64xsi32>, si32, !pto.mask<b32> -> !pto.vreg<64xsi32>
// CHECK-NEXT: %[[VAL_17:[a-zA-Z0-9_.$-]+]] = builtin.unrealized_conversion_cast %[[VAL_0]] : si32 to i32
// CHECK-NEXT: %[[VAL_18:[a-zA-Z0-9_.$-]+]] = arith.addi %[[VAL_17]], %[[VAL_2]] : i32
// CHECK-NEXT: %[[VAL_19:[a-zA-Z0-9_.$-]+]] = builtin.unrealized_conversion_cast %[[VAL_18]] : i32 to si32
// CHECK-NEXT: %[[VAL_20:[a-zA-Z0-9_.$-]+]] = pto.vadds %[[VAL_16]], %[[VAL_19]], %[[VAL_12]] : !pto.vreg<64xsi32>, si32, !pto.mask<b32> -> !pto.vreg<64xsi32>
// CHECK-NEXT: %[[VAL_21:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK-NEXT: pto.vstsx2 %[[VAL_11]], %[[VAL_20]], %[[VAL_1]]{{\[}}%[[VAL_5]]], "INTLV_B32", %[[VAL_21]] : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.ptr<si32, ub>, index, !pto.mask<b32>
// CHECK-NEXT: return
// CHECK-NEXT: }
// CHECK-LABEL: func.func @vmi_to_vpto_iota_signed_base_desc_split(
// CHECK-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: si32,
// CHECK-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.ptr<si32, ub>) {
