// CHECK-NEXT: %[[VAL_10:[a-zA-Z0-9_.$-]+]] = pto.vmuls %[[VAL_9]], %[[VAL_8]], %[[VAL_6]] : !pto.vreg<64xsi32>, si32, !pto.mask<b32> -> !pto.vreg<64xsi32>
// CHECK-NEXT: %[[VAL_11:[a-zA-Z0-9_.$-]+]] = pto.vdup %[[VAL_0]], %[[VAL_6]] : si32, !pto.mask<b32> -> !pto.vreg<64xsi32>
// CHECK-NEXT: %[[VAL_12:[a-zA-Z0-9_.$-]+]] = pto.vsub %[[VAL_11]], %[[VAL_10]], %[[VAL_6]] : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.vreg<64xsi32>
// CHECK-NEXT: %[[VAL_13:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK-NEXT: %[[VAL_14:[a-zA-Z0-9_.$-]+]] = builtin.unrealized_conversion_cast %[[VAL_4]] : i32 to si32
// CHECK-NEXT: %[[VAL_15:[a-zA-Z0-9_.$-]+]] = builtin.unrealized_conversion_cast %[[VAL_3]] : i32 to si32
