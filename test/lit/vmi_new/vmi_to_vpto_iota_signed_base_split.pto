// CHECK-NEXT: %[[VAL_19:[a-zA-Z0-9_.$-]+]] = arith.subi %[[VAL_18]], %[[VAL_2]] : i32
// CHECK-NEXT: %[[VAL_20:[a-zA-Z0-9_.$-]+]] = builtin.unrealized_conversion_cast %[[VAL_19]] : i32 to si32
// CHECK-NEXT: %[[VAL_21:[a-zA-Z0-9_.$-]+]] = pto.vdup %[[VAL_20]], %[[VAL_13]] : si32, !pto.mask<b32> -> !pto.vreg<64xsi32>
// CHECK-NEXT: %[[VAL_22:[a-zA-Z0-9_.$-]+]] = pto.vsub %[[VAL_21]], %[[VAL_17]], %[[VAL_13]] : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.vreg<64xsi32>
// CHECK-NEXT: %[[VAL_23:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK-NEXT: pto.vstsx2 %[[VAL_12]], %[[VAL_22]], %[[VAL_1]]{{\[}}%[[VAL_5]]], "INTLV_B32", %[[VAL_23]] : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.ptr<si32, ub>, index, !pto.mask<b32>
