// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN --implicit-check-not=pto.vmi.ensure_layout
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -pto-validate-vmi-layout-ir -vmi-to-vpto | FileCheck %s --check-prefix=LOWER --implicit-check-not=pto.vmi. --implicit-check-not='!pto.vmi.'

// Equal-width bitcasts preserve their source layout. Cover both a layout
// selected by the solver and an explicitly annotated group-slot layout.

module {
  // The 32xi32 short load is seeded lane_stride = 2 by the small-load
  // heuristic; the equal-width bitcast takes that layout across unchanged
  // instead of materializing a boundary conversion.
  func.func @eq_width_keeps_lane_stride(
      %src: !pto.ptr<i32, ub>, %dst: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %v = pto.vmi.vload %src[%c0]
        : !pto.ptr<i32, ub> -> !pto.vmi.vreg<32xi32>
    %r = pto.vmi.vinterpret_cast %v
        : !pto.vmi.vreg<32xi32> -> !pto.vmi.vreg<32xf32>
    pto.vmi.vstore %r, %dst[%c0]
        : !pto.vmi.vreg<32xf32>, !pto.ptr<f32, ub>
    return
  }

  func.func @eq_width_keeps_group_slots(
      %v: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>)
      -> !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>> {
    %r = pto.vmi.vinterpret_cast %v
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
       -> !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    return %r
        : !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
  }
}

// ASSIGN-LABEL: func.func @eq_width_keeps_lane_stride(
// ASSIGN-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.ptr<i32, ub>,
// ASSIGN-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.ptr<f32, ub>) {
// ASSIGN-NEXT: %[[VAL_2:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : index
// ASSIGN-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = pto.vmi.load %[[VAL_0]]{{\[}}%[[VAL_2]]] : !pto.ptr<i32, ub> -> !pto.vmi.vreg<32xi32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = pto.vmi.bitcast %[[VAL_3]] : !pto.vmi.vreg<32xi32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<32xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: pto.vmi.store %[[VAL_4]], %[[VAL_1]]{{\[}}%[[VAL_2]]] : !pto.vmi.vreg<32xf32, #pto.vmi.layout<contiguous>>, !pto.ptr<f32, ub>
// ASSIGN-NEXT: return
// ASSIGN-NEXT: }
// ASSIGN-LABEL: func.func @eq_width_keeps_group_slots(
// ASSIGN-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>) -> !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>> {
// ASSIGN-NEXT: %[[VAL_1:[a-zA-Z0-9_.$-]+]] = pto.vmi.bitcast %[[VAL_0]] : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>> -> !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// ASSIGN-NEXT: return %[[VAL_1]] : !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// ASSIGN-NEXT: }

// LOWER-LABEL: func.func @eq_width_keeps_lane_stride(
// LOWER-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.ptr<i32, ub>,
// LOWER-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.ptr<f32, ub>) {
// LOWER-NEXT: %[[VAL_2:[a-zA-Z0-9_.$-]+]] = arith.constant 32 : i32
// LOWER-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : index
// LOWER-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = pto.vlds %[[VAL_0]]{{\[}}%[[VAL_3]]] : !pto.ptr<i32, ub>, index -> !pto.vreg<64xi32>
// LOWER-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = pto.vbitcast %[[VAL_4]] : !pto.vreg<64xi32> -> !pto.vreg<64xf32>
// LOWER-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]], %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.plt_b32 %[[VAL_2]] : i32 -> !pto.mask<b32>, i32
// LOWER-NEXT: pto.vsts %[[VAL_5]], %[[VAL_1]]{{\[}}%[[VAL_3]]], %[[VAL_6]] : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
// LOWER-NEXT: return
// LOWER-NEXT: }
// LOWER-LABEL: func.func @eq_width_keeps_group_slots(
// LOWER-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.vreg<64xf32>) -> !pto.vreg<64xi32> {
// LOWER-NEXT: %[[VAL_1:[a-zA-Z0-9_.$-]+]] = pto.vbitcast %[[VAL_0]] : !pto.vreg<64xf32> -> !pto.vreg<64xi32>
// LOWER-NEXT: return %[[VAL_1]] : !pto.vreg<64xi32>
// LOWER-NEXT: }
