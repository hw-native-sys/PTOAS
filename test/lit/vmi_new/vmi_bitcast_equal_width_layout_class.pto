// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN --implicit-check-not=pto.vmi.ensure_layout
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -pto-validate-vmi-layout-ir -vmi-to-vpto | FileCheck %s --check-prefix=LOWER --implicit-check-not=pto.vmi. --implicit-check-not='!pto.vmi.'

// An equal-width bitcast is a layout *class* edge: getBitcastLayoutFactsForLayout
// answers {L, L} for every layout, so the solver may pick any layout and both
// sides have to carry the very same one.  Nothing restricts it to contiguous
// and nothing is ever materialized on either side - that is the equal-width
// half of the bitcast symmetry.  The two functions below pin the two ends of
// the "any identical layout" statement: a lane-strided layout chosen by the
// solver from a solver-side seed, and a group-slot layout coming from an
// explicit annotation.

module {
  // The 32xi32 short load is seeded lane_stride = 2 by the small-load
  // heuristic; the equal-width bitcast takes that layout across unchanged
  // instead of materializing a boundary conversion.
  func.func @eq_width_keeps_lane_stride(
      %src: !pto.ptr<i32, ub>, %dst: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %v = pto.vmi.vload %src[%c0]
        : !pto.ptr<i32, ub> -> !pto.vmi.vreg<32xi32>
    %r = pto.vmi.vinterpret_cast %v
        : !pto.vmi.vreg<32xi32> -> !pto.vmi.vreg<32xf32>
    pto.vmi.vstore %r, %dst[%c0]
        : !pto.vmi.vreg<32xf32>, !pto.ptr<f32, ub>
    return
  }

  func.func @eq_width_keeps_group_slots(
      %v: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>)
      -> !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>> {
    %r = pto.vmi.vinterpret_cast %v
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
       -> !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    return %r
        : !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
  }
}

// ASSIGN-LABEL: func.func @eq_width_keeps_lane_stride
// ASSIGN: %[[V:.*]] = pto.vmi.load
// ASSIGN-SAME: !pto.vmi.vreg<32xi32, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN: %[[R:.*]] = pto.vmi.bitcast %[[V]]
// ASSIGN-SAME: -> !pto.vmi.vreg<32xf32, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN: pto.vmi.store %[[R]]
// ASSIGN-SAME: !pto.vmi.vreg<32xf32, #pto.vmi.layout<contiguous, lane_stride = 2>>

// ASSIGN-LABEL: func.func @eq_width_keeps_group_slots
// ASSIGN: pto.vmi.bitcast
// ASSIGN-SAME: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// ASSIGN-SAME: -> !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>

// LOWER-LABEL: func.func @eq_width_keeps_lane_stride
// LOWER: pto.vlds {{.*}} {dist = "UNPK_B32"}
// LOWER: pto.vbitcast
// LOWER: pto.vsts {{.*}} {dist = "PK_B64"}

// LOWER-LABEL: func.func @eq_width_keeps_group_slots
// LOWER: pto.vbitcast
// LOWER: return
