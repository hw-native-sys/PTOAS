// RUN: not pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto 2>&1 | FileCheck %s

// Same 32-byte granularity contract on the VMIToVPTO side: when the result
// layout is already assigned the layout pass has nothing to reject, so the
// lowering pre-check has to spell out the block granularity rule.

module {
  func.func @sub_32b_group_load_with_layout(%base: !pto.ptr<ui8, ub>, %off: index) {
    // CHECK: VMI-UNSUPPORTED
    // CHECK-SAME: 32-byte blocks
    // CHECK-SAME: got group = 8 bytes, row_stride = 16 bytes
    %stride16 = arith.constant 16 : index
    %x = pto.vmi.vload %base[%off], %stride16 {group = 8}
        : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<64xui8, #pto.vmi.layout<contiguous>>
    return
  }
}
