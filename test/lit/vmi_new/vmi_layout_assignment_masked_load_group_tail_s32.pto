// ASSIGN-SAME: %[[VAL_2:[a-zA-Z0-9_.$-]+]]: index) {
// ASSIGN-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = arith.constant 0.000000e+00 : f32
// ASSIGN-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = arith.constant 1 : index
// ASSIGN-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = arith.constant 8 : index
// ASSIGN-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = arith.constant 25 : index
// ASSIGN-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = arith.muli %[[VAL_2]], %[[VAL_5]] : index
// ASSIGN-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.vmi.create_group_mask %[[VAL_6]] {group_size = 32 : i64, num_groups = 8 : i64} : index -> !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_9:[a-zA-Z0-9_.$-]+]] = pto.vmi.broadcast %[[VAL_3]] : f32 -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_10:[a-zA-Z0-9_.$-]+]] = pto.vmi.load %[[VAL_0]]{{\[}}%[[VAL_7]]] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_11:[a-zA-Z0-9_.$-]+]] = pto.vmi.select %[[VAL_8]], %[[VAL_10]], %[[VAL_9]] : !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_12:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_reduce_addf %[[VAL_11]], %[[VAL_8]] {num_groups = 8 : i64, reassoc} : !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>>
// ASSIGN-NEXT: pto.vmi.group_store %[[VAL_12]], %[[VAL_1]]{{\[}}%[[VAL_7]]], %[[VAL_4]] {num_groups = 8 : i64} : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>>, !pto.ptr<f32, ub>
// ASSIGN-NEXT: return
// ASSIGN-NEXT: }

