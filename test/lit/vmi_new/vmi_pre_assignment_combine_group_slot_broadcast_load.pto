// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-pre-assignment-combine | FileCheck %s
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-pre-assignment-combine -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

module {
  func.func @not_e2b_num_groups_16(%src: !pto.ptr<f16, ub>, %off: index)
      -> !pto.vmi.vreg<256xf16> {
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %aligned_off = arith.muli %off, %c32 : index
    %slots = pto.vmi.group_slot_load %src[%aligned_off], %c1 {num_groups = 16}
        : !pto.ptr<f16, ub> -> !pto.vmi.vreg<16xf16>
    %out = pto.vmi.vbrc %slots {group = 16}
        : !pto.vmi.vreg<16xf16> -> !pto.vmi.vreg<256xf16>
    return %out : !pto.vmi.vreg<256xf16>
  }

  func.func @e2b_deint4_candidate(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<256xf32> {
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %aligned_off = arith.muli %off, %c8 : index
    %slots = pto.vmi.group_slot_load %src[%aligned_off], %c1 {num_groups = 8}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    %out = pto.vmi.vbrc %slots {group = 8}
        : !pto.vmi.vreg<8xf32> -> !pto.vmi.vreg<256xf32>
    return %out : !pto.vmi.vreg<256xf32>
  }

  func.func @e2b_deint4_consumer(%scale: !pto.ptr<f32, ub>,
                                     %x: !pto.vmi.vreg<256xf16>, %off: index)
      -> !pto.vmi.vreg<256xf32> {
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %aligned_off = arith.muli %off, %c8 : index
    %slots = pto.vmi.group_slot_load %scale[%aligned_off], %c1 {num_groups = 8}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    %sf = pto.vmi.vbrc %slots {group = 8}
        : !pto.vmi.vreg<8xf32> -> !pto.vmi.vreg<256xf32>
    %x32 = pto.vmi.vcvt %x
        : !pto.vmi.vreg<256xf16> -> !pto.vmi.vreg<256xf32>
    %out = pto.vmi.vmul %x32, %sf
        : !pto.vmi.vreg<256xf32>, !pto.vmi.vreg<256xf32>
        -> !pto.vmi.vreg<256xf32>
    return %out : !pto.vmi.vreg<256xf32>
  }
}

// CHECK-LABEL: func.func @not_e2b_num_groups_16
// CHECK-NOT: pto.vmi.group_slot_load
// CHECK: pto.vmi.group_broadcast_load
// CHECK-NOT: pto.vmi.vbrc

// CHECK-LABEL: func.func @e2b_deint4_candidate
// CHECK-NOT: pto.vmi.group_slot_load
// CHECK: pto.vmi.group_broadcast_load
// CHECK-NOT: pto.vmi.vbrc

// CHECK-LABEL: func.func @e2b_deint4_consumer
// CHECK-NOT: pto.vmi.group_slot_load
// CHECK: pto.vmi.group_broadcast_load
// CHECK-NOT: pto.vmi.vbrc

// LOWER-LABEL: func.func @not_e2b_num_groups_16
// LOWER-NOT: E2B_B16
// LOWER: pto.vsldb
// LOWER: pto.vselr

// LOWER-LABEL: func.func @e2b_deint4_candidate
// LOWER: %[[E2B:.*]] = pto.vlds %{{.*}}[%{{.*}}] {dist = "E2B_B32"} : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
// LOWER-NOT: pto.vselr
// LOWER: return %[[E2B]], %[[E2B]], %[[E2B]], %[[E2B]] : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>
// LOWER-NOT: pto.vmi.

// LOWER-LABEL: func.func @e2b_deint4_consumer
// LOWER: %[[E2B2:.*]] = pto.vlds %{{.*}}[%{{.*}}] {dist = "E2B_B32"} : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
// LOWER-NOT: pto.vselr
// LOWER: pto.vmul %{{.*}}, %[[E2B2]]
// LOWER-NOT: pto.vmi.
