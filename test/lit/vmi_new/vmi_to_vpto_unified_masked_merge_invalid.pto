// RUN: not pto-test-opt %s -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-lower-unified-to-legacy -vmi-to-vpto 2>&1 | FileCheck %s

module {
  func.func @binary_merge(%lhs: !pto.vmi.vreg<64xf32>,
                          %rhs: !pto.vmi.vreg<64xf32>,
                          %mask: !pto.vmi.mask<64xpred>)
      -> !pto.vmi.vreg<64xf32> {
    %result = pto.vmi.vadd %lhs, %rhs, %mask {pmode = "merge"}
        : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>,
          !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
    return %result : !pto.vmi.vreg<64xf32>
  }
}

// CHECK: pto.vmi.vadd with pmode=merge requires an explicit passthru lowering
