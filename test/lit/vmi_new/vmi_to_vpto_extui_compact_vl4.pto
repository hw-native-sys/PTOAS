// ASSIGN-SAME: %[[VAL_2:[a-zA-Z0-9_.$-]+]]: index) {
// ASSIGN-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = arith.constant 1 : index
// ASSIGN-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_slot_load %[[VAL_0]]{{\[}}%[[VAL_2]]], %[[VAL_3]] {num_groups = 4 : i64} : !pto.ptr<i8, ub> -> !pto.vmi.vreg<4xi8, #pto.vmi.layout<num_groups = 4, slots = 8>>
// ASSIGN-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = pto.vmi.extui %[[VAL_4]] : !pto.vmi.vreg<4xi8, #pto.vmi.layout<num_groups = 4, slots = 8>> -> !pto.vmi.vreg<4xui32, #pto.vmi.layout<num_groups = 4, slots = 8>>
// ASSIGN-NEXT: pto.vmi.group_store %[[VAL_5]], %[[VAL_1]]{{\[}}%[[VAL_2]]], %[[VAL_3]] {num_groups = 4 : i64} : !pto.vmi.vreg<4xui32, #pto.vmi.layout<num_groups = 4, slots = 8>>, !pto.ptr<ui32, ub>
// ASSIGN-NEXT: return
// ASSIGN-NEXT: }
