// ASSIGN-NEXT: pto.vmi.group_store %[[VAL_5]], %[[VAL_1]]{{\[}}%[[VAL_2]]], %[[VAL_3]] {num_groups = 4 : i64} : !pto.vmi.vreg<4xui32, #pto.vmi.layout<num_groups = 4, slots = 8>>, !pto.ptr<ui32, ub>
