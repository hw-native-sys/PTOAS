// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto -vpto-combine-reductions | FileCheck %s

module {
  func.func @vmi_layout_assignment_group_slots_cf_join(
      %cond: i1,
      %src: !pto.ptr<f32, ub>,
      %rhs: !pto.ptr<f32, ub>,
      %dst: !pto.ptr<f32, ub>,
      %off: index) {
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %c128 = arith.constant 128 : index
    %aligned_off = arith.muli %off, %c8 : index
    %mask = pto.vmi.create_mask %c128 : index -> !pto.vmi.mask<128xpred>
    %sum = scf.if %cond -> !pto.vmi.vreg<8xf32> {
      %x = pto.vmi.vload %src[%aligned_off]
          : !pto.ptr<f32, ub> -> !pto.vmi.vreg<128xf32>
      %a = pto.vmi.vcadd %x, %mask {group = 8, reassoc}
          : !pto.vmi.vreg<128xf32>, !pto.vmi.mask<128xpred>
          -> !pto.vmi.vreg<8xf32>
      scf.yield %a : !pto.vmi.vreg<8xf32>
    } else {
      %b = pto.vmi.vload %rhs[%aligned_off], %c1 {group = 8}
          : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
      scf.yield %b : !pto.vmi.vreg<8xf32>
    }
    %bias = pto.vmi.vload %rhs[%aligned_off], %c1 {group = 8}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    %out = pto.vmi.vadd %sum, %bias
        : !pto.vmi.vreg<8xf32>, !pto.vmi.vreg<8xf32>
        -> !pto.vmi.vreg<8xf32>
    pto.vmi.vstore %out, %dst[%aligned_off], %c1 {group = 8}
        : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    return
  }
}

// CHECK-LABEL: func.func @vmi_layout_assignment_group_slots_cf_join(
// CHECK-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: i1,
// CHECK-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.ptr<f32, ub>,
// CHECK-SAME: %[[VAL_2:[a-zA-Z0-9_.$-]+]]: !pto.ptr<f32, ub>,
// CHECK-SAME: %[[VAL_3:[a-zA-Z0-9_.$-]+]]: !pto.ptr<f32, ub>,
// CHECK-SAME: %[[VAL_4:[a-zA-Z0-9_.$-]+]]: index) {
// CHECK-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : i16
// CHECK-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = arith.constant 8 : index
// CHECK-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = arith.muli %[[VAL_4]], %[[VAL_6]] : index
// CHECK-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK-NEXT: %[[VAL_9:[a-zA-Z0-9_.$-]+]] = scf.if %[[VAL_0]] -> (!pto.vreg<64xf32>) {
// CHECK-NEXT: %[[VAL_10:[a-zA-Z0-9_.$-]+]], %[[VAL_11:[a-zA-Z0-9_.$-]+]] = pto.vldsx2 %[[VAL_1]]{{\[}}%[[VAL_7]]], "DINTLV_B32" : !pto.ptr<f32, ub>, index -> !pto.vreg<64xf32>, !pto.vreg<64xf32>
// CHECK-NEXT: %[[VAL_12:[a-zA-Z0-9_.$-]+]] = pto.vadd %[[VAL_10]], %[[VAL_11]], %[[VAL_8]] : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NEXT: %[[VAL_13:[a-zA-Z0-9_.$-]+]] = pto.vcgadd %[[VAL_12]], %[[VAL_8]] : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NEXT: scf.yield %[[VAL_13]] : !pto.vreg<64xf32>
// CHECK-NEXT: } else {
// CHECK-NEXT: %[[VAL_14:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_VL8" : !pto.mask<b32>
// CHECK-NEXT: %[[VAL_15:[a-zA-Z0-9_.$-]+]] = pto.addptr %[[VAL_2]], %[[VAL_7]] : <f32, ub>, index -> <f32, ub>
// CHECK-NEXT: %[[VAL_16:[a-zA-Z0-9_.$-]+]] = pto.vsldb %[[VAL_15]], %[[VAL_5]], %[[VAL_5]], %[[VAL_14]] : !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NEXT: scf.yield %[[VAL_16]] : !pto.vreg<64xf32>
// CHECK-NEXT: }
// CHECK-NEXT: %[[VAL_17:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_VL8" : !pto.mask<b32>
// CHECK-NEXT: %[[VAL_18:[a-zA-Z0-9_.$-]+]] = pto.addptr %[[VAL_2]], %[[VAL_7]] : <f32, ub>, index -> <f32, ub>
// CHECK-NEXT: %[[VAL_19:[a-zA-Z0-9_.$-]+]] = pto.vsldb %[[VAL_18]], %[[VAL_5]], %[[VAL_5]], %[[VAL_17]] : !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NEXT: %[[VAL_20:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_VL8" : !pto.mask<b32>
// CHECK-NEXT: %[[VAL_21:[a-zA-Z0-9_.$-]+]] = pto.vadd %[[VAL_9]], %[[VAL_19]], %[[VAL_20]] : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NEXT: %[[VAL_22:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_VL8" : !pto.mask<b32>
// CHECK-NEXT: pto.vsts %[[VAL_21]], %[[VAL_3]]{{\[}}%[[VAL_7]]], %[[VAL_22]] : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
// CHECK-NEXT: return
// CHECK-NEXT: }
