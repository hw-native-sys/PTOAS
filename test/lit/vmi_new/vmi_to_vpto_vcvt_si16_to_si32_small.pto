// LAYOUT-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.ptr<si32, ub>,
// LAYOUT-SAME: %[[VAL_2:[a-zA-Z0-9_.$-]+]]: index) attributes {pto.kernel} {
// LAYOUT-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = arith.constant 16 : index
// LAYOUT-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = arith.muli %[[VAL_2]], %[[VAL_3]] : index
// LAYOUT-NEXT: pto.vecscope {
// LAYOUT-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = pto.vmi.load %[[VAL_0]]{{\[}}%[[VAL_4]]] : !pto.ptr<si16, ub>, index -> !pto.vmi.vreg<8xsi16, #pto.vmi.layout<contiguous>>
