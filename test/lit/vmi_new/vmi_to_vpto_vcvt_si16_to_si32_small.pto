// LAYOUT-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.vmi.extsi %[[VAL_7]] : !pto.vmi.vreg<8xsi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>> -> !pto.vmi.vreg<8xsi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// LAYOUT-NEXT: %[[VAL_9:[a-zA-Z0-9_.$-]+]] = arith.constant 1 : index
