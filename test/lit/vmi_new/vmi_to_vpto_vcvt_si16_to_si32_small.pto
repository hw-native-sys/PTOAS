// LAYOUT-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.ptr<si32, ub>,
// LAYOUT-SAME: %[[VAL_2:[a-zA-Z0-9_.$-]+]]: index) attributes {pto.kernel} {
// LAYOUT-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = arith.constant 16 : index
// LAYOUT-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = arith.muli %[[VAL_2]], %[[VAL_3]] : index
// LAYOUT-NEXT: pto.vecscope {
// LAYOUT-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = pto.vmi.load %[[VAL_0]]{{\[}}%[[VAL_4]]] : !pto.ptr<si16, ub>, index -> !pto.vmi.vreg<4xsi16, #pto.vmi.layout<contiguous>>
// LAYOUT-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = pto.vmi.vmul %[[VAL_5]], %[[VAL_5]] : !pto.vmi.vreg<4xsi16, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<4xsi16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<4xsi16, #pto.vmi.layout<contiguous>>
// LAYOUT-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_layout %[[VAL_6]] : !pto.vmi.vreg<4xsi16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<4xsi16, #pto.vmi.layout<num_groups = 4, slots = 8, lane_stride = 2>>
// LAYOUT-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.vmi.extsi %[[VAL_7]] : !pto.vmi.vreg<4xsi16, #pto.vmi.layout<num_groups = 4, slots = 8, lane_stride = 2>> -> !pto.vmi.vreg<4xsi32, #pto.vmi.layout<num_groups = 4, slots = 8>>
// LAYOUT-NEXT: %[[VAL_9:[a-zA-Z0-9_.$-]+]] = arith.constant 1 : index
// LAYOUT-NEXT: pto.vmi.group_store %[[VAL_8]], %[[VAL_1]]{{\[}}%[[VAL_4]]], %[[VAL_9]] {num_groups = 4 : i64} : !pto.vmi.vreg<4xsi32, #pto.vmi.layout<num_groups = 4, slots = 8>>, !pto.ptr<si32, ub>, index
// LAYOUT-NEXT: }
// LAYOUT-NEXT: return
// LAYOUT-NEXT: }
// LAYOUT-LABEL: func.func @si16_extend_store_si32_mul_L8(
