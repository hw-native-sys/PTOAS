// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance | FileCheck %s --check-prefix=COST
// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance -vmi-lower-unified-to-legacy -vmi-to-vpto -test-vmi-layout-lowering-conformance > /dev/null

module {
  func.func @ungrouped_vcmax(
      %source: !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<1xi32, #pto.vmi.layout<contiguous>> {
    %result = pto.vmi.vcmax %source, %mask
      {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>,
        !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xi32, #pto.vmi.layout<contiguous>>
    return %result : !pto.vmi.vreg<1xi32, #pto.vmi.layout<contiguous>>
  }

  func.func @grouped_vcadd(
      %source: !pto.vmi.vreg<32xf16, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<32xb16, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<2xf16,
          #pto.vmi.layout<num_groups = 2, slots = 8>> {
    %result = pto.vmi.vcadd %source, %mask
      {group = 2 : i64, reassoc, test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<32xf16, #pto.vmi.layout<contiguous>>,
        !pto.vmi.mask<32xb16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<2xf16,
            #pto.vmi.layout<num_groups = 2, slots = 8>>
    return %result : !pto.vmi.vreg<2xf16,
        #pto.vmi.layout<num_groups = 2, slots = 8>>
  }

  func.func @ungrouped_vcmin(
      %source: !pto.vmi.vreg<128xi16, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<1xi16, #pto.vmi.layout<contiguous>> {
    %result = pto.vmi.vcmin %source, %mask
      {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<128xi16, #pto.vmi.layout<contiguous>>,
        !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xi16, #pto.vmi.layout<contiguous>>
    return %result : !pto.vmi.vreg<1xi16, #pto.vmi.layout<contiguous>>
  }

}

// COST: vmi-layout-cost-conformance ungrouped_vcmax pto.vmi.vcmax relation=0 cost=0
// COST: vmi-layout-cost-conformance grouped_vcadd pto.vmi.vcadd relation=0 cost=0
// COST: vmi-layout-cost-conformance ungrouped_vcmin pto.vmi.vcmin relation=0 cost=0
