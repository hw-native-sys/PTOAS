// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s

// The group_broadcast_load group-slot fallback reads every group through
// pto.vsldb, whose effective address must be 32-byte aligned.  A unit group
// stride does not prove that: the offset is an arbitrary element offset.  These
// two functions pin the resulting split.

module {
  // Offset provably 32B aligned: the block-strided vsldb plan is legal.
  func.func @gbl_slots8_aligned(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %aligned = arith.muli %off, %c8 : index
    %r = pto.vmi.vload %src[%aligned], %c1 {dist_mode = "brc", group = 4}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %r : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }

  // Offset only 4B aligned: vsldb would fault, so the fallback has to use the
  // lane-zero BRC loads.
  func.func @gbl_slots1_unaligned(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %c1 = arith.constant 1 : index
    %unaligned = arith.addi %off, %c1 : index
    %r = pto.vmi.vload %src[%unaligned], %c1 {dist_mode = "brc", group = 4}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %r : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }
}

// CHECK-LABEL: func.func @gbl_slots8_aligned(
// CHECK: pto.vsldb
// CHECK-NOT: pto.vlds {{.*}} {dist = "BRC_B32"}

// CHECK-LABEL: func.func @gbl_slots1_unaligned(
// CHECK: pto.vlds {{.*}} {dist = "BRC_B32"}
// CHECK-NOT: pto.vsldb
