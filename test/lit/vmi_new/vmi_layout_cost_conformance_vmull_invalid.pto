// RUN: not pto-test-opt %s -test-vmi-layout-cost-conformance 2>&1 | FileCheck %s --check-prefix=COST
// RUN: not pto-test-opt %s -vmi-to-vpto 2>&1 | FileCheck %s --check-prefix=LOWER

module {
  func.func @vmull_lane_stride(
      %a: !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous, lane_stride = 2>>,
      %b: !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous, lane_stride = 2>>,
      %m: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous, lane_stride = 2>>)
      -> (!pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous, lane_stride = 2>>,
          !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous, lane_stride = 2>>) {
    %low, %high = pto.vmi.vmull %a, %b, %m
      {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous, lane_stride = 2>>,
        !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous, lane_stride = 2>>,
        !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous, lane_stride = 2>>
        -> !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous, lane_stride = 2>>,
           !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous, lane_stride = 2>>
    return %low, %high
      : !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous, lane_stride = 2>>,
        !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous, lane_stride = 2>>
  }
}

// COST: error: test layout-cost conformance marker has no exposed relation
// LOWER: requires contiguous or deinterleaved factor 2/4 layout with lane_stride=1
