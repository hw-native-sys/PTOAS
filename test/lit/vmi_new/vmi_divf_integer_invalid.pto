// RUN: pto-test-opt %s -split-input-file -verify-diagnostics

module {
  func.func @vmi_div_byte_invalid(
      %lhs: !pto.vmi.vreg<256xui8>,
      %rhs: !pto.vmi.vreg<256xui8>) {
    // expected-error @+1 {{requires i16, i32, f16, or f32 VMI element type}}
    %quotient = pto.vmi.vdiv %lhs, %rhs
        : !pto.vmi.vreg<256xui8>, !pto.vmi.vreg<256xui8>
        -> !pto.vmi.vreg<256xui8>
    return
  }
}

// -----

module attributes {pto.target_arch = "a5"} {
  func.func @vmi_div_integer_precision_invalid(
      %lhs: !pto.vmi.vreg<128xsi16>, %rhs: !pto.vmi.vreg<128xsi16>) {
    // expected-error @+1 {{integer division requires intrinsic precisionType}}
    %quotient = pto.vmi.vdiv %lhs, %rhs {precisionType = #pto<div_precision precision_0ulp_ftz_true>}
        : !pto.vmi.vreg<128xsi16>, !pto.vmi.vreg<128xsi16>
        -> !pto.vmi.vreg<128xsi16>
    return
  }
}

// -----

module attributes {pto.target_arch = "a3"} {
  func.func @vmi_div_integer_target_invalid(
      %lhs: !pto.vmi.vreg<64xui32>, %rhs: !pto.vmi.vreg<64xui32>) {
    // expected-error @+1 {{integer division requires the A5 target}}
    %quotient = pto.vmi.vdiv %lhs, %rhs
        : !pto.vmi.vreg<64xui32>, !pto.vmi.vreg<64xui32>
        -> !pto.vmi.vreg<64xui32>
    return
  }
}

// -----

module {
  func.func @vmi_div_integer_missing_target(
      %lhs: !pto.vmi.vreg<64xui32>, %rhs: !pto.vmi.vreg<64xui32>) {
    // expected-error @+1 {{integer division requires the A5 target}}
    %quotient = pto.vmi.vdiv %lhs, %rhs
        : !pto.vmi.vreg<64xui32>, !pto.vmi.vreg<64xui32>
        -> !pto.vmi.vreg<64xui32>
    return
  }
}
