// The VMI conversion state is recorded once on the module (vmi-set-fastmath)
// and read back by every VMI pass, so both runs pin it explicitly.
// RUN: pto-test-opt %s -vmi-set-fastmath=vmi-fastmath=true -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s
// RUN: pto-test-opt %s -vmi-set-fastmath=vmi-fastmath=false -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s --check-prefix=STRICT

module {
  func.func @trunc_d2(
      %src: !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>>)
      -> !pto.vmi.vreg<256xbf16, #pto.vmi.layout<deinterleaved = 2>> {
    %result = pto.vmi.vcvt %src {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>>
        -> !pto.vmi.vreg<256xbf16, #pto.vmi.layout<deinterleaved = 2>>
    return %result : !pto.vmi.vreg<256xbf16,
                                     #pto.vmi.layout<deinterleaved = 2>>
  }

  func.func @trunc_d4(
      %src: !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>)
      -> !pto.vmi.vreg<256xbf16, #pto.vmi.layout<deinterleaved = 4>> {
    %result = pto.vmi.vcvt %src {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>
        -> !pto.vmi.vreg<256xbf16, #pto.vmi.layout<deinterleaved = 4>>
    return %result : !pto.vmi.vreg<256xbf16,
                                     #pto.vmi.layout<deinterleaved = 4>>
  }

  func.func @trunc_ls2(
      %src: !pto.vmi.vreg<128xf32,
                           #pto.vmi.layout<contiguous, lane_stride = 2>>)
      -> !pto.vmi.vreg<128xbf16,
                       #pto.vmi.layout<contiguous, lane_stride = 2>> {
    %result = pto.vmi.vcvt %src {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<128xf32,
                        #pto.vmi.layout<contiguous, lane_stride = 2>>
        -> !pto.vmi.vreg<128xbf16,
                         #pto.vmi.layout<contiguous, lane_stride = 2>>
    return %result : !pto.vmi.vreg<128xbf16,
                                     #pto.vmi.layout<contiguous, lane_stride = 2>>
  }

  func.func @trunc_ls4(
      %src: !pto.vmi.vreg<64xf32,
                          #pto.vmi.layout<contiguous, lane_stride = 4>>)
      -> !pto.vmi.vreg<64xbf16,
                       #pto.vmi.layout<contiguous, lane_stride = 4>> {
    %result = pto.vmi.vcvt %src {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<64xf32,
                        #pto.vmi.layout<contiguous, lane_stride = 4>>
        -> !pto.vmi.vreg<64xbf16,
                         #pto.vmi.layout<contiguous, lane_stride = 4>>
    return %result : !pto.vmi.vreg<64xbf16,
                                     #pto.vmi.layout<contiguous, lane_stride = 4>>
  }

  func.func @ext_d2(
      %src: !pto.vmi.vreg<256xbf16, #pto.vmi.layout<deinterleaved = 2>>)
      -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>> {
    %result = pto.vmi.vcvt %src
        : !pto.vmi.vreg<256xbf16, #pto.vmi.layout<deinterleaved = 2>>
        -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>>
    return %result : !pto.vmi.vreg<256xf32,
                                     #pto.vmi.layout<deinterleaved = 2>>
  }

  func.func @ext_d4(
      %src: !pto.vmi.vreg<256xbf16, #pto.vmi.layout<deinterleaved = 4>>)
      -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>> {
    %result = pto.vmi.vcvt %src
        : !pto.vmi.vreg<256xbf16, #pto.vmi.layout<deinterleaved = 4>>
        -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>
    return %result : !pto.vmi.vreg<256xf32,
                                     #pto.vmi.layout<deinterleaved = 4>>
  }

  func.func @ext_ls2(
      %src: !pto.vmi.vreg<128xbf16,
                           #pto.vmi.layout<contiguous, lane_stride = 2>>)
      -> !pto.vmi.vreg<128xf32,
                       #pto.vmi.layout<contiguous, lane_stride = 2>> {
    %result = pto.vmi.vcvt %src
        : !pto.vmi.vreg<128xbf16,
                        #pto.vmi.layout<contiguous, lane_stride = 2>>
        -> !pto.vmi.vreg<128xf32,
                         #pto.vmi.layout<contiguous, lane_stride = 2>>
    return %result : !pto.vmi.vreg<128xf32,
                                     #pto.vmi.layout<contiguous, lane_stride = 2>>
  }

  func.func @ext_ls4(
      %src: !pto.vmi.vreg<64xbf16,
                          #pto.vmi.layout<contiguous, lane_stride = 4>>)
      -> !pto.vmi.vreg<64xf32,
                       #pto.vmi.layout<contiguous, lane_stride = 4>> {
    %result = pto.vmi.vcvt %src
        : !pto.vmi.vreg<64xbf16,
                        #pto.vmi.layout<contiguous, lane_stride = 4>>
        -> !pto.vmi.vreg<64xf32,
                         #pto.vmi.layout<contiguous, lane_stride = 4>>
    return %result : !pto.vmi.vreg<64xf32,
                                     #pto.vmi.layout<contiguous, lane_stride = 4>>
  }
}

// CHECK-LABEL: func.func @trunc_d2(
// CHECK-NOT: pto.vcvt
// CHECK: pto.vdintlv
// CHECK: pto.vdintlv
// CHECK-NOT: pto.vcvt
// CHECK-LABEL: func.func @trunc_d4(
// CHECK: pto.vdintlv
// CHECK: pto.vdintlv
// CHECK-NOT: pto.vcvt
// CHECK-LABEL: func.func @trunc_ls2(
// CHECK: pto.vdintlv
// CHECK: pto.vdintlv
// CHECK-NOT: pto.vcvt
// CHECK-LABEL: func.func @trunc_ls4(
// CHECK: pto.vdintlv
// CHECK: pto.vdintlv
// CHECK-NOT: pto.vcvt
// CHECK-LABEL: func.func @ext_d2(
// CHECK: %[[LOW0:.*]], %[[HIGH0:.*]] = pto.vintlv
// CHECK: %[[LOW1:.*]], %[[HIGH1:.*]] = pto.vintlv
// CHECK: pto.vbitcast %[[LOW0]]
// CHECK: pto.vbitcast %[[HIGH0]]
// CHECK: pto.vbitcast %[[LOW1]]
// CHECK: pto.vbitcast %[[HIGH1]]
// CHECK-NOT: pto.vcvt
// CHECK-LABEL: func.func @ext_d4(
// CHECK: pto.vintlv
// CHECK: pto.vintlv
// CHECK-NOT: pto.vcvt
// CHECK-LABEL: func.func @ext_ls2(
// CHECK: pto.vintlv
// CHECK: pto.vintlv
// CHECK-NOT: pto.vcvt
// CHECK-LABEL: func.func @ext_ls4(
// CHECK: pto.vintlv
// CHECK: pto.vintlv

// STRICT-LABEL: func.func @trunc_d2(
// STRICT: pto.vcvt
// STRICT: pto.vbitcast
// STRICT: pto.vdintlv
// STRICT-LABEL: func.func @trunc_d4(
// STRICT: pto.vcvt
// STRICT-LABEL: func.func @trunc_ls2(
// STRICT: pto.vcvt
// STRICT: pto.vbitcast
// STRICT: pto.vdintlv
// STRICT-LABEL: func.func @trunc_ls4(
// STRICT: pto.vcvt
// STRICT: pto.vbitcast
// STRICT: pto.vdintlv
