// RUN: pto-test-opt %s -vmi-to-vpto | FileCheck %s --implicit-check-not=pto.vmi. --implicit-check-not='!pto.vmi.'

// A narrow-to-wide cast whose operand layouts are group-slot packets used to
// fail conversion: the lowering planned its vcvt parts from the declared layout
// form and only recognized the dense lane-strided carrier, so a single-carrier
// packet (`num_groups = G, slots = 8, lane_stride = 2`) or a packet keeping one
// group per part (slots = 1) reached no plan and the op stayed residual.
//
// A packet places group g at lane (g % slots) * lane_stride of part g / slots,
// which is where a dense value with the same lane stride places logical lane g,
// so the cast is planned from that carrier view and the physical part is
// forwarded unchanged: one vcvt part per part, exactly like the dense
// lane-strided form, with no extra pack, zip or shuffle.

module {
  // 16-bit source with lane_stride = 2: the single carrier holds eight groups
  // at even lanes, and the EVEN part selects exactly those lanes.
  func.func @widen_gs8_lane_stride2(%v: !pto.vmi.vreg<8xf16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>) -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>> {
    %r = pto.vmi.extf %v : !pto.vmi.vreg<8xf16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>> -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    return %r : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
  }

  // The same packet spread over two carriers keeps the per-part plan: each part
  // holds eight groups, so every part casts with its own EVEN vcvt.
  func.func @widen_gs16_lane_stride2(%v: !pto.vmi.vreg<16xf16, #pto.vmi.layout<num_groups = 16, slots = 8, lane_stride = 2>>) -> !pto.vmi.vreg<16xf32, #pto.vmi.layout<num_groups = 16, slots = 8>> {
    %r = pto.vmi.extf %v : !pto.vmi.vreg<16xf16, #pto.vmi.layout<num_groups = 16, slots = 8, lane_stride = 2>> -> !pto.vmi.vreg<16xf32, #pto.vmi.layout<num_groups = 16, slots = 8>>
    return %r : !pto.vmi.vreg<16xf32, #pto.vmi.layout<num_groups = 16, slots = 8>>
  }

  // Radix-4 follows the same rule with the packed-four part family.
  func.func @widen_gs8_lane_stride4(%v: !pto.vmi.vreg<8x!pto.hif8, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 4>>) -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>> {
    %r = pto.vmi.extf %v : !pto.vmi.vreg<8x!pto.hif8, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 4>> -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    return %r : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
  }

  // One group per part: the packet only fills lane 0 of every part, and the
  // EVEN part maps that lane to result lane 0 for each part in turn.
  func.func @widen_gs_slots1(%v: !pto.vmi.vreg<8xf16, #pto.vmi.layout<num_groups = 8, slots = 1>>) -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>> {
    %r = pto.vmi.extf %v : !pto.vmi.vreg<8xf16, #pto.vmi.layout<num_groups = 8, slots = 1>> -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>>
    return %r : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>>
  }

  // The narrowing mirror uses the same carrier view for its result lane
  // stride, so a packet result narrows 1:1 per part as well.
  func.func @narrow_gs8_lane_stride2(%v: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>) -> !pto.vmi.vreg<8xsi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>> {
    %r = pto.vmi.fptosi %v {saturate = "SAT"} : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>> -> !pto.vmi.vreg<8xsi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
    return %r : !pto.vmi.vreg<8xsi16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
  }
}

// CHECK-LABEL: func.func @widen_gs8_lane_stride2(
// CHECK: pto.vcvt {{.*}}part = "EVEN"
// CHECK-NOT: pto.vcvt
// CHECK-LABEL: func.func @widen_gs16_lane_stride2(
// CHECK: pto.vcvt {{.*}}part = "EVEN"
// CHECK: pto.vcvt {{.*}}part = "EVEN"
// CHECK-NOT: pto.vcvt
// CHECK-LABEL: func.func @widen_gs8_lane_stride4(
// CHECK: pto.vcvt {{.*}}part = "P0"
// CHECK-NOT: pto.vcvt
// CHECK-LABEL: func.func @widen_gs_slots1(
// CHECK: pto.vcvt {{.*}}part = "EVEN"
// CHECK-LABEL: func.func @narrow_gs8_lane_stride2(
// CHECK: pto.vcvt {{.*}}part = "EVEN"
// CHECK-NOT: pto.vcvt
