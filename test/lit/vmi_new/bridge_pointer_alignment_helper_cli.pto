// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s --check-prefix=VPTO
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - | FileCheck %s --check-prefix=LLVM
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func private @aligned_load_helper(%p: !pto.ptr<f32, ub> {pto.alignment = 32 : i64}) attributes {no_inline} {
    %addr = arith.constant 4096 : i64
    %dst = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    pto.vmi.vstore %v, %dst[%z] : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    return
  }
  func.func @aligned_load_entry(%p: !pto.ptr<f32, ub> {pto.alignment = 32 : i64}) attributes {pto.entry} {
    func.call @aligned_load_helper(%p) : (!pto.ptr<f32, ub>) -> ()
    return
  }
}
// VPTO-LABEL: func.func private @aligned_load_helper
// VPTO: pto.vsldb
// VPTO-LABEL: func.func @aligned_load_entry
// VPTO: call @aligned_load_helper
// LLVM: define{{.*}} @aligned_load_helper
// LLVM: define{{.*}} @aligned_load_entry
