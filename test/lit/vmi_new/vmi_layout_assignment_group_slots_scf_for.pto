// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

module {
  func.func @vmi_layout_assignment_group_slots_scf_for(
      %init: !pto.ptr<f32, ub>,
      %base: !pto.ptr<f32, ub>,
      %out: !pto.ptr<f32, ub>,
      %off: index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c16 = arith.constant 16 : index
    %acc0 = pto.vmi.vload %init[%off], %c1 {group = 8}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    %acc = scf.for %i = %c0 to %c2 step %c1
        iter_args(%arg = %acc0) -> (!pto.vmi.vreg<8xf32>) {
      %x = pto.vmi.vload %base[%off], %c16 {group = 8}
          : !pto.ptr<f32, ub> -> !pto.vmi.vreg<128xf32>
      %mask = pto.vmi.create_group_mask %c16
          {num_groups = 8, group_size = 16}
          : index -> !pto.vmi.mask<128xpred>
      %sum = pto.vmi.vcadd %x, %mask
          {group = 8, reassoc}
          : !pto.vmi.vreg<128xf32>, !pto.vmi.mask<128xpred>
          -> !pto.vmi.vreg<8xf32>
      %next = pto.vmi.vadd %arg, %sum
          : !pto.vmi.vreg<8xf32>, !pto.vmi.vreg<8xf32>
          -> !pto.vmi.vreg<8xf32>
      scf.yield %next : !pto.vmi.vreg<8xf32>
    }
    pto.vmi.vstore %acc, %out[%off], %c1 {group = 8}
        : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    return
  }
}

// ASSIGN-LABEL: func.func @vmi_layout_assignment_group_slots_scf_for(
// ASSIGN: %[[ACC0:.*]] = pto.vmi.group_slot_load
// ASSIGN-SAME: -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// ASSIGN: %[[ACC:.*]] = scf.for
// ASSIGN-SAME: iter_args(%[[ARG:.*]] = %[[ACC0]])
// ASSIGN-SAME: -> (!pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>)
// ASSIGN: %[[RAW:.*]] = pto.vmi.group_load
// ASSIGN-SAME: -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN: %[[MASK0:.*]] = pto.vmi.create_group_mask
// ASSIGN-SAME: -> !pto.vmi.mask<128xb32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: %[[X:.*]] = pto.vmi.ensure_layout %[[RAW]]
// ASSIGN-SAME: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-SAME: -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: %[[SUM:.*]] = pto.vmi.group_reduce_addf %[[X]], %[[MASK0]]
// ASSIGN-SAME: -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// ASSIGN: pto.vmi.vadd %[[ARG]], %[[SUM]]
// ASSIGN-SAME: -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// ASSIGN: scf.yield
// ASSIGN-SAME: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// ASSIGN: pto.vmi.group_store %[[ACC]]
// ASSIGN-SAME: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>, {{(!pto\.ptr)?<f32, ub>}}

// LOWER-LABEL: func.func @vmi_layout_assignment_group_slots_scf_for(
// LOWER: pto.vsldb
// LOWER-COUNT-2: pto.vlds
// LOWER-NOT: pto.vmi.
