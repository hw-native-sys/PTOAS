// LOWER-NEXT: %[[VAL_10:[a-zA-Z0-9_.$-]+]], %[[VAL_11:[a-zA-Z0-9_.$-]+]] = pto.plt_b8 %[[VAL_3]] : i32 -> !pto.mask<b8>, i32
// LOWER-NEXT: pto.vsts %[[VAL_9]], %[[VAL_1]]{{\[}}%[[VAL_6]]], %[[VAL_10]] : !pto.vreg<256xui8>, !pto.ptr<ui8, ub>, index, !pto.mask<b8>
// LOWER-NEXT: return
// LOWER-NEXT: }
