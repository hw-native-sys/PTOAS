// LOWER-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// LOWER-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.addptr %[[VAL_1]], %[[VAL_5]] : <i32, ub>, index -> <i32, ub>
// LOWER-NEXT: pto.vsstb %[[VAL_6]], %[[VAL_8]], %[[VAL_4]], %[[VAL_3]], %[[VAL_7]] : !pto.vreg<64xi32>, !pto.ptr<i32, ub>, i16, i16, !pto.mask<b32>
// LOWER-NEXT: return
// LOWER-NEXT: }
