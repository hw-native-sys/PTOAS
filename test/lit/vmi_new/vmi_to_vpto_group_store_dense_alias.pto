// LOWER-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : index
// LOWER-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = pto.pset_b8 "PAT_VL1" : !pto.mask<b8>
// LOWER-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = pto.addptr %[[VAL_0]], %[[VAL_4]] : <ui8, ub>, index -> <ui8, ub>
// LOWER-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.vsldb %[[VAL_6]], %[[VAL_3]], %[[VAL_3]], %[[VAL_5]] : !pto.ptr<ui8, ub>, i16, i16, !pto.mask<b8> -> !pto.vreg<256xui8>
