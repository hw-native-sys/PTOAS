// RUN: not pto-test-opt %s -test-vmi-layout-cost-conformance 2>&1 | FileCheck %s --check-prefix=COST
// RUN: not pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto 2>&1 | FileCheck %s --check-prefix=LOWER

module {
  func.func @ungrouped_vcmin_partial(
      %source: !pto.vmi.vreg<64xi16, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<64xb16, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<1xi16, #pto.vmi.layout<contiguous>> {
    %result = pto.vmi.vcmin %source, %mask
      {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xi16, #pto.vmi.layout<contiguous>>,
        !pto.vmi.mask<64xb16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xi16, #pto.vmi.layout<contiguous>>
    return %result : !pto.vmi.vreg<1xi16, #pto.vmi.layout<contiguous>>
  }
}

// COST: error: test layout-cost conformance marker has no exposed relation
// LOWER: requires full source physical chunks
