// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-pre-assignment-combine -vmi-to-vpto | FileCheck %s

// A one-lane load followed by vbrc can use the scalar broadcast-load path.

module {
  func.func @vload_scalar_then_vbrc(
      %src: !pto.ptr<f32, ub>, %offset: index)
      -> (!pto.vreg<64xf32>) {
    %scalar = pto.vmi.vload %src[%offset]
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
    %r = pto.vmi.vbrc %scalar
        : !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    %p0 = "pto.vmi.unpack"(%r)
        : (!pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>) -> (!pto.vreg<64xf32>)
    return %p0 : !pto.vreg<64xf32>
  }
}

// CHECK-LABEL: func.func @vload_scalar_then_vbrc(
// CHECK: pto.vlds %arg0[%arg1] {dist = "BRC_B32"}
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast
