// RUN: not pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto 2>&1 | FileCheck %s

module {
  func.func @vmi_layout_assignment_group_reduce_s12_invalid(
      %source: !pto.vmi.vreg<96xf32>,
      %mask: !pto.vmi.mask<96xpred>,
      %dst: !pto.ptr<f32, ub>,
      %off: index) {
    %c1 = arith.constant 1 : index
    // CHECK: VMI-LAYOUT-CONTRACT: no complete legal VMI layout plan exists for this component
    // CHECK: note: see current operation: %{{.*}} = "pto.vmi.group_reduce_addf"
    %sum = pto.vmi.vcadd %source, %mask
        {group = 8, reassoc}
        : !pto.vmi.vreg<96xf32>, !pto.vmi.mask<96xpred>
        -> !pto.vmi.vreg<8xf32>
    pto.vmi.vstore %sum, %dst[%off], %c1 {group = 8}
        : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    return
  }
}
