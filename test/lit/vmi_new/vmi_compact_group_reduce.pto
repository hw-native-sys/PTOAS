// RUN: ptoas --pto-arch=a5 --pto-level=level3 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s --implicit-check-not='pto.vmi.'
// CHECK-NOT: pto.vmi.
module {
  // CHECK-LABEL: func.func @compact_reduce_i16_1
  // CHECK: pto.vsel
  // CHECK: pto.vsel
  // CHECK: pto.vsel
  func.func @compact_reduce_i16_1(%src: !pto.ptr<i16, ub>, %dst: !pto.ptr<i16, ub>, %active: index) {
    %c0 = arith.constant 0 : index
    %x = pto.vmi.vload %src[%c0] : !pto.ptr<i16, ub> -> !pto.vmi.vreg<1xi16>
    %m = pto.vmi.create_mask %active : index -> !pto.vmi.mask<1xpred>
    %r0 = pto.vmi.vcadd %x, %m {group = 1, reassoc} : !pto.vmi.vreg<1xi16>, !pto.vmi.mask<1xpred> -> !pto.vmi.vreg<1xi16>
    %b0 = pto.vmi.vbrc %r0 : !pto.vmi.vreg<1xi16> -> !pto.vmi.vreg<1xi16>
    %o0 = arith.constant 0 : index
    pto.vmi.vstore %b0, %dst[%o0] : !pto.vmi.vreg<1xi16>, !pto.ptr<i16, ub>
    %r1 = pto.vmi.vcmax %x, %m {group = 1} : !pto.vmi.vreg<1xi16>, !pto.vmi.mask<1xpred> -> !pto.vmi.vreg<1xi16>
    %b1 = pto.vmi.vbrc %r1 : !pto.vmi.vreg<1xi16> -> !pto.vmi.vreg<1xi16>
    %o1 = arith.constant 256 : index
    pto.vmi.vstore %b1, %dst[%o1] : !pto.vmi.vreg<1xi16>, !pto.ptr<i16, ub>
    %r2 = pto.vmi.vcmin %x, %m {group = 1} : !pto.vmi.vreg<1xi16>, !pto.vmi.mask<1xpred> -> !pto.vmi.vreg<1xi16>
    %b2 = pto.vmi.vbrc %r2 : !pto.vmi.vreg<1xi16> -> !pto.vmi.vreg<1xi16>
    %o2 = arith.constant 512 : index
    pto.vmi.vstore %b2, %dst[%o2] : !pto.vmi.vreg<1xi16>, !pto.ptr<i16, ub>
    return
  }
