    %b1 = pto.vmi.vbrc %r1 : !pto.vmi.vreg<1xi16> -> !pto.vmi.vreg<2xi16>
    %o1 = arith.constant 256 : index
    pto.vmi.vstore %b1, %dst[%o1] : !pto.vmi.vreg<2xi16>, !pto.ptr<i16, ub>
    %r2 = pto.vmi.vcmin %x, %m {group = 1} : !pto.vmi.vreg<2xi16>, !pto.vmi.mask<2xpred> -> !pto.vmi.vreg<1xi16>
