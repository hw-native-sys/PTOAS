// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s

// Dense group broadcasts with a group bank smaller than a physical part lower
// per group: one lane-zero BRC load per logical group plus prefix-mask selects.
// That form only needs element alignment, so an arbitrary constant group stride
// and an unaligned effective address both stay legal and no pto.vsldb is
// emitted.

module {
  // gb(2) with a provably 32B-aligned offset.
  func.func @gbl_brc_gb2_aligned(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %aligned = arith.muli %off, %c8 : index
    %r = pto.vmi.vload %src[%aligned], %c1 {dist_mode = "brc", group = 4}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %r : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }

  // Same shape with an offset that is only 4B aligned: still the BRC form.
  func.func @gbl_brc_gb2_unaligned(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %c1 = arith.constant 1 : index
    %unaligned = arith.addi %off, %c1 : index
    %r = pto.vmi.vload %src[%unaligned], %c1 {dist_mode = "brc", group = 4}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %r : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }

  // gb(4) with a constant non-unit group stride, which the dense layout table
  // admits for the per-group plan.
  func.func @gbl_brc_gb4_strided(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %c2 = arith.constant 2 : index
    %r = pto.vmi.vload %src[%off], %c2 {dist_mode = "brc", group = 2}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %r : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }

  // 16-bit gb(1) spanning two physical parts.
  func.func @gbl_brc_gb1_two_parts(%src: !pto.ptr<bf16, ub>, %off: index)
      -> !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous>> {
    %c1 = arith.constant 1 : index
    %r = pto.vmi.vload %src[%off], %c1 {dist_mode = "brc", group = 4}
        : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous>>
    return %r : !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous>>
  }
}

// CHECK-LABEL: func.func @gbl_brc_gb2_aligned(
// CHECK-NOT: pto.vsldb
// CHECK-COUNT-4: pto.vlds {{.*}} {dist = "BRC_B32"}
// CHECK: pto.vsel

// CHECK-LABEL: func.func @gbl_brc_gb2_unaligned(
// CHECK-NOT: pto.vsldb
// CHECK-COUNT-4: pto.vlds {{.*}} {dist = "BRC_B32"}
// CHECK: pto.vsel

// CHECK-LABEL: func.func @gbl_brc_gb4_strided(
// CHECK-NOT: pto.vsldb
// CHECK-COUNT-2: pto.vlds {{.*}} {dist = "BRC_B32"}
// CHECK: pto.vsel

// CHECK-LABEL: func.func @gbl_brc_gb1_two_parts(
// CHECK-NOT: pto.vsldb
// CHECK-COUNT-4: pto.vlds {{.*}} {dist = "BRC_B16"}
// CHECK: pto.vsel
// CHECK: return {{%.*}}, {{%.*}} : !pto.vreg<128xbf16>, !pto.vreg<128xbf16>
