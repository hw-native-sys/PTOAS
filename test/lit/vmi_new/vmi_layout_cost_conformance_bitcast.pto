// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance | FileCheck %s --check-prefix=COST
// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance -vmi-to-vpto -test-vmi-layout-lowering-conformance > /dev/null

module {
  func.func @bitcast_equal_width(
      %source: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>) {
    %result = pto.vmi.bitcast %source {
        test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>
    return
  }

  func.func @bitcast_width_changing(
      %source: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>) {
    %result = pto.vmi.bitcast %source {
        test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xi16, #pto.vmi.layout<contiguous>>
    return
  }

  func.func @bitcast_equal_width_deinterleaved2(
      %source: !pto.vmi.vreg<128xf32,
                              #pto.vmi.layout<deinterleaved = 2>>) {
    %result = pto.vmi.bitcast %source {
        test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
        -> !pto.vmi.vreg<128xi32, #pto.vmi.layout<deinterleaved = 2>>
    return
  }

  func.func @bitcast_equal_width_block_deinterleaved2(
      %source: !pto.vmi.vreg<128xf32,
                              #pto.vmi.layout<block_deinterleaved = 2>>) {
    %result = pto.vmi.bitcast %source {
        test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<128xf32, #pto.vmi.layout<block_deinterleaved = 2>>
        -> !pto.vmi.vreg<128xi32, #pto.vmi.layout<block_deinterleaved = 2>>
    return
  }

  func.func @vinterpret_cast_equal_width(
      %source: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>) {
    %result = pto.vmi.vinterpret_cast %source {
        test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>
    return
  }
}

// COST: vmi-layout-cost-conformance bitcast_equal_width pto.vmi.bitcast relation=0 cost=0
// COST: vmi-layout-cost-conformance bitcast_width_changing pto.vmi.bitcast relation=0 cost=0
// COST: vmi-layout-cost-conformance bitcast_equal_width_deinterleaved2 pto.vmi.bitcast relation=0 cost=0
// COST: vmi-layout-cost-conformance bitcast_equal_width_block_deinterleaved2 pto.vmi.bitcast relation=0 cost=0
// COST: vmi-layout-cost-conformance vinterpret_cast_equal_width pto.vmi.vinterpret_cast relation=0 cost=0
