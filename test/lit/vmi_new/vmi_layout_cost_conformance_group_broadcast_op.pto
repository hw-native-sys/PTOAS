  }

  func.func @slots8_small_group(
      %source: !pto.vmi.vreg<32xf32, #pto.vmi.layout<num_groups = 32, slots = 8>>)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous, lane_stride = 4>> {
