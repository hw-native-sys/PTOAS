// COST: vmi-layout-cost-conformance slots8_deinterleaved4 pto.vmi.group_broadcast relation=0 cost=0
// COST: vmi-layout-cost-conformance-summary slots8_deinterleaved4 pto.vmi.group_broadcast relations=1
