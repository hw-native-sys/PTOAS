    return %value : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
  }

  func.func @slots1_full_two_parts_deinterleaved2(
      %source: !pto.vmi.vreg<1xf32, #pto.vmi.layout<num_groups = 1, slots = 1>>)
