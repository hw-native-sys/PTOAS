        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>>
          -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
    return %value : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
  }

  func.func @slots8_four_blocks_contiguous(
