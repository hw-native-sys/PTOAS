}

// COST: vmi-layout-cost-conformance slots8_half_block pto.vmi.group_broadcast relation=0 cost=0
// COST: vmi-layout-cost-conformance slots8_one_block_contiguous pto.vmi.group_broadcast relation=0 cost=0
// COST: vmi-layout-cost-conformance slots8_one_block_lane_stride2 pto.vmi.group_broadcast relation=0 cost=0
// COST: vmi-layout-cost-conformance slots8_lane_stride2_one_block_contiguous pto.vmi.group_broadcast relation=0 cost=0
// COST: vmi-layout-cost-conformance slots8_lane_stride4_one_block_contiguous pto.vmi.group_broadcast relation=0 cost=0
// COST: vmi-layout-cost-conformance slots8_two_blocks_contiguous pto.vmi.group_broadcast relation=0 cost=0
