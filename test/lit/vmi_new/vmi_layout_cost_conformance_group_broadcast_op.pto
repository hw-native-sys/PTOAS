    return %value
        : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous, lane_stride = 2>>
  }

  func.func @slots8_four_blocks_block_deinterleaved4(
      %source: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>)
      -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<block_deinterleaved = 4>> {
    %value = pto.vmi.group_broadcast %source
        {num_groups = 8 : i64, test.vmi_layout_cost_conformance}
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
          -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<block_deinterleaved = 4>>
    return %value
        : !pto.vmi.vreg<256xf32, #pto.vmi.layout<block_deinterleaved = 4>>
  }

  func.func @slots8_full_group_contiguous(
      %source: !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 8>>)
      -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>> {
    %value = pto.vmi.group_broadcast %source
        {num_groups = 2 : i64, test.vmi_layout_cost_conformance}
        : !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 8>>
          -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
    return %value : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
  }

  func.func @slots1_full_group_contiguous(
      %source: !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>>)
      -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>> {
    %value = pto.vmi.group_broadcast %source
