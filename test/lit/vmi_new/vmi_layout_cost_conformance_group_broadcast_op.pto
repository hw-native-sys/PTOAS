// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance | FileCheck %s --check-prefix=COST
// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance -vmi-to-vpto -test-vmi-layout-lowering-conformance > /dev/null

module {
  func.func @slots8_half_block(
      %source: !pto.vmi.vreg<16xf32, #pto.vmi.layout<num_groups = 16, slots = 8>>)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous, lane_stride = 2>> {
    %value = pto.vmi.group_broadcast %source
        {num_groups = 16 : i64, test.vmi_layout_cost_conformance}
        : !pto.vmi.vreg<16xf32, #pto.vmi.layout<num_groups = 16, slots = 8>>
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous, lane_stride = 2>>
    return %value
        : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous, lane_stride = 2>>
  }

  func.func @slots8_one_block_contiguous(
      %source: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %value = pto.vmi.group_broadcast %source
        {num_groups = 8 : i64, test.vmi_layout_cost_conformance}
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %value : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }

  func.func @slots8_one_block_lane_stride2(
      %source: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous, lane_stride = 2>> {
    %value = pto.vmi.group_broadcast %source
        {num_groups = 8 : i64, test.vmi_layout_cost_conformance}
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous, lane_stride = 2>>
    return %value
        : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous, lane_stride = 2>>
  }

  func.func @slots8_lane_stride2_one_block_contiguous(
      %source: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %value = pto.vmi.group_broadcast %source
        {num_groups = 8 : i64, test.vmi_layout_cost_conformance}
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %value : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }

  func.func @slots8_lane_stride4_one_block_contiguous(
      %source: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 4>>)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %value = pto.vmi.group_broadcast %source
        {num_groups = 8 : i64, test.vmi_layout_cost_conformance}
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 4>>
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %value : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }

  func.func @slots8_two_blocks_contiguous(
      %source: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>)
