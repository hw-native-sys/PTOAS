// COST: vmi-layout-cost-conformance slots8_full_group_contiguous pto.vmi.group_broadcast relation=0 cost=0
// COST: vmi-layout-cost-conformance slots1_full_group_contiguous pto.vmi.group_broadcast relation=0 cost=0
// COST: vmi-layout-cost-conformance slots1_full_two_parts_deinterleaved2 pto.vmi.group_broadcast relation=0 cost=0
// COST: vmi-layout-cost-conformance slots1_full_four_parts_deinterleaved4 pto.vmi.group_broadcast relation=0 cost=0
// COST: vmi-layout-cost-conformance slots1_four_block pto.vmi.group_broadcast relation=0 cost=0
// COST: vmi-layout-cost-conformance-summary slots1_four_block pto.vmi.group_broadcast relations=1
// COST: vmi-layout-cost-conformance slots8_small_group pto.vmi.group_broadcast relation=0 cost=0
