// COST: vmi-layout-cost-conformance slots1_two_blocks_contiguous pto.vmi.group_broadcast relation=0 cost=0
// COST: vmi-layout-cost-conformance slots8_four_blocks_contiguous pto.vmi.group_broadcast relation=0 cost=0
