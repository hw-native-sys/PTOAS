        saturate = "NOSAT", test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<2xui32, #pto.vmi.layout<num_groups = 2, slots = 8>>
        -> !pto.vmi.vreg<2xui16,
            #pto.vmi.layout<num_groups = 2, slots = 8, lane_stride = 2>>
    return %result : !pto.vmi.vreg<2xui16,
        #pto.vmi.layout<num_groups = 2, slots = 8, lane_stride = 2>>
  }

  func.func @trunci_u32_u8_group_slots1(
      %source: !pto.vmi.vreg<2xui32,
                              #pto.vmi.layout<num_groups = 2, slots = 1>>)
      -> !pto.vmi.vreg<2xui8,
                       #pto.vmi.layout<num_groups = 2, slots = 1>> {
