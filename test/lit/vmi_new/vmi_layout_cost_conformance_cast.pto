// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance | FileCheck %s --check-prefix=COST
// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance -vmi-to-vpto -test-vmi-layout-lowering-conformance > /dev/null

module {
  func.func @extf_contiguous_to_deinterleaved(
      %source: !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>> {
    %result = pto.vmi.extf %source {
        test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
    return %result : !pto.vmi.vreg<128xf32,
                                   #pto.vmi.layout<deinterleaved = 2>>
  }

  func.func @truncf_deinterleaved_to_contiguous(
      %source: !pto.vmi.vreg<128xf32,
                              #pto.vmi.layout<deinterleaved = 2>>)
      -> !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>> {
    %result = pto.vmi.truncf %source {saturate = "NOSAT",
        test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
        -> !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>
    return %result : !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>
  }

  func.func @truncf_f32_f16_group_slots1(
      %source: !pto.vmi.vreg<8xf32,
          #pto.vmi.layout<num_groups = 8, slots = 1>>)
      -> !pto.vmi.vreg<8xf16,
          #pto.vmi.layout<num_groups = 8, slots = 1>> {
    %result = pto.vmi.truncf %source {
        saturate = "SAT", test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<8xf32,
          #pto.vmi.layout<num_groups = 8, slots = 1>>
        -> !pto.vmi.vreg<8xf16,
          #pto.vmi.layout<num_groups = 8, slots = 1>>
    return %result : !pto.vmi.vreg<8xf16,
        #pto.vmi.layout<num_groups = 8, slots = 1>>
  }

  func.func @truncf_f32_f16_group_slots8(
      %source: !pto.vmi.vreg<8xf32,
          #pto.vmi.layout<num_groups = 8, slots = 8>>)
      -> !pto.vmi.vreg<8xf16,
          #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>> {
    %result = pto.vmi.truncf %source {
        saturate = "SAT", test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<8xf32,
          #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xf16,
          #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
    return %result : !pto.vmi.vreg<8xf16,
        #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
  }

  func.func @truncf_f32_f8_group_slots1(
      %source: !pto.vmi.vreg<8xf32,
          #pto.vmi.layout<num_groups = 8, slots = 1>>)
      -> !pto.vmi.vreg<8xf8E4M3FN,
