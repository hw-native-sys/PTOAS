        saturate = "NOSAT", test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<2xui32, #pto.vmi.layout<num_groups = 2, slots = 8>>
        -> !pto.vmi.vreg<2xui8,
            #pto.vmi.layout<num_groups = 2, slots = 8, lane_stride = 4>>
    return %result : !pto.vmi.vreg<2xui8,
        #pto.vmi.layout<num_groups = 2, slots = 8, lane_stride = 4>>
  }
