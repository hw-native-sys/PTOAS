// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

module {
  func.func @vmi_layout_assignment_load_truncf(
      %src: !pto.ptr<f32, ub>,
      %offset: index) -> !pto.vmi.vreg<128xf16> {
    %c8 = arith.constant 8 : index
    %aligned_offset = arith.muli %offset, %c8 : index
    %wide = pto.vmi.vload %src[%aligned_offset]
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<128xf32>
    %narrow = pto.vmi.vcvt %wide {saturate = "SAT"}
        : !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xf16>
    return %narrow : !pto.vmi.vreg<128xf16>
  }

  func.func @vmi_layout_assignment_load_truncf_multi_use(
      %src: !pto.ptr<f32, ub>,
      %dst: !pto.ptr<f32, ub>,
      %offset: index) -> !pto.vmi.vreg<128xf16> {
    %c8 = arith.constant 8 : index
    %aligned_offset = arith.muli %offset, %c8 : index
    %wide = pto.vmi.vload %src[%aligned_offset]
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<128xf32>
    pto.vmi.vstore %wide, %dst[%aligned_offset]
        : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    %narrow = pto.vmi.vcvt %wide {saturate = "SAT"}
        : !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xf16>
    return %narrow : !pto.vmi.vreg<128xf16>
  }

  func.func @vmi_layout_assignment_trunc_store_reextend(
      %src: !pto.ptr<f32, ub>,
      %narrow_dst: !pto.ptr<bf16, ub>,
      %wide_dst: !pto.ptr<f32, ub>,
      %offset: index) {
    %c128 = arith.constant 128 : index
    %c16 = arith.constant 16 : index
    // Keep the dynamic element offset aligned for both the f32 load and the
    // bf16 PK_B32 store; this test exercises layout conversion, not alignment.
    %store_offset = arith.muli %offset, %c16 : index
    %wide = pto.vmi.load %src[%store_offset]
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<128xf32>
    %narrow = pto.vmi.truncf %wide {rounding = "R", saturate = "NOSAT"}
        : !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xbf16>
    %mask = pto.vmi.create_mask %c128 : index -> !pto.vmi.mask<128xpred>
    pto.vmi.masked_store %narrow, %narrow_dst[%store_offset], %mask
        : !pto.vmi.vreg<128xbf16>, !pto.ptr<bf16, ub>, !pto.vmi.mask<128xpred>
    %rewide = pto.vmi.extf %narrow
        : !pto.vmi.vreg<128xbf16> -> !pto.vmi.vreg<128xf32>
    pto.vmi.masked_store %rewide, %wide_dst[%store_offset], %mask
        : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<128xpred>
    return
  }

}

// ASSIGN-LABEL: func.func @vmi_layout_assignment_load_truncf(
// ASSIGN-SAME: -> !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN: %[[WIDE:.*]] = pto.vmi.load
// ASSIGN-SAME: {{(!pto\.ptr)?<f32, ub>}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NOT: pto.vmi.ensure_layout
// ASSIGN: %[[NARROW:.*]] = pto.vmi.truncf %[[WIDE]]
// ASSIGN-SAME: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN: return %[[NARROW]] : !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous, lane_stride = 2>>

// LOWER-LABEL: func.func @vmi_layout_assignment_load_truncf(
// LOWER: %[[PART0:.*]] = pto.vlds
// LOWER: %[[PART1:.*]] = pto.vlds
// LOWER: %[[NARROW0:.*]] = pto.vcvt %[[PART0]], {{.*}} {part = "EVEN", rnd = "R", sat = "SAT"}
// LOWER: %[[NARROW1:.*]] = pto.vcvt %[[PART1]], {{.*}} {part = "EVEN", rnd = "R", sat = "SAT"}
// LOWER-NOT: part = "ODD"
// LOWER-NOT: pto.vor
// LOWER: return %[[NARROW0]], %[[NARROW1]] : !pto.vreg<128xf16>, !pto.vreg<128xf16>
// LOWER-NOT: pto.vmi.
// LOWER-NOT: !pto.vmi.

// ASSIGN-LABEL: func.func @vmi_layout_assignment_load_truncf_multi_use(
// ASSIGN-SAME: -> !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN: %[[WIDE:.*]] = pto.vmi.load
// ASSIGN-SAME: {{(!pto\.ptr)?<f32, ub>}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NOT: pto.vmi.ensure_layout %[[WIDE]]
// ASSIGN: pto.vmi.store %[[WIDE]]
// ASSIGN-SAME: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN: %[[NARROW:.*]] = pto.vmi.truncf %[[WIDE]]
// ASSIGN-SAME: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN: return %[[NARROW]] : !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous, lane_stride = 2>>

// LOWER-LABEL: func.func @vmi_layout_assignment_load_truncf_multi_use(
// LOWER: %[[PART0:.*]] = pto.vlds
// LOWER: %[[PART1:.*]] = pto.vlds
// LOWER: pto.vsts %[[PART0]]
// LOWER: pto.vsts %[[PART1]]
// LOWER: pto.vcvt {{.*}} {part = "EVEN", rnd = "R", sat = "SAT"}
// LOWER: pto.vcvt {{.*}} {part = "EVEN", rnd = "R", sat = "SAT"}
// LOWER-NOT: part = "ODD"
// LOWER-NOT: pto.vor
// LOWER: return {{.*}}, {{.*}} : !pto.vreg<128xf16>, !pto.vreg<128xf16>
// LOWER-NOT: pto.vmi.
// LOWER-NOT: !pto.vmi.

// ASSIGN-LABEL: func.func @vmi_layout_assignment_trunc_store_reextend(
// ASSIGN: %[[ROUNDTRIP_WIDE:.*]] = pto.vmi.load
// ASSIGN-SAME: -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN: %[[ROUNDTRIP_NARROW:.*]] = pto.vmi.truncf %[[ROUNDTRIP_WIDE]]
// ASSIGN-SAME: -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN: pto.vmi.masked_store %[[ROUNDTRIP_NARROW]]
// ASSIGN-NOT: pto.vmi.ensure_layout %[[ROUNDTRIP_NARROW]]
// ASSIGN: %[[ROUNDTRIP_REWIDE:.*]] = pto.vmi.extf %[[ROUNDTRIP_NARROW]]
// ASSIGN-SAME: -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN: pto.vmi.masked_store %[[ROUNDTRIP_REWIDE]]

// LOWER-LABEL: func.func @vmi_layout_assignment_trunc_store_reextend(
// LOWER: pto.vcvt {{.*}} {part = "EVEN", rnd = "R", sat = "NOSAT"}
// LOWER: pto.vsts
// LOWER: pto.vcvt {{.*}} {part = "EVEN"}
// LOWER: pto.vsts
// LOWER-NOT: pto.vmi.
// LOWER-NOT: !pto.vmi.
