// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

module {
  // The truncated value is stored out rather than returned.  An un-annotated
  // function result is materialized to the contiguous boundary layout, and that
  // boundary conversion (lane-strided 2 parts into one contiguous part) costs
  // more than folding the narrowing into a deinterleaved source, which is what
  // the solver picks instead.  Storing the value keeps the narrowing on its
  // natural lane-strided result with no boundary conversion at all.
  func.func @vmi_layout_assignment_load_truncf(
      %src: !pto.ptr<f32, ub>,
      %dst: !pto.ptr<f16, ub>,
      %offset: index) {
    %wide = pto.vmi.vload %src[%offset]
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<128xf32>
    %narrow = pto.vmi.vcvt %wide {saturate = "SAT"}
        : !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xf16>
    pto.vmi.vstore %narrow, %dst[%offset]
        : !pto.vmi.vreg<128xf16>, !pto.ptr<f16, ub>
    return
  }

  func.func @vmi_layout_assignment_load_truncf_multi_use(
      %src: !pto.ptr<f32, ub>,
      %dst: !pto.ptr<f32, ub>,
      %dstNarrow: !pto.ptr<f16, ub>,
      %offset: index) {
    %wide = pto.vmi.vload %src[%offset]
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<128xf32>
    pto.vmi.vstore %wide, %dst[%offset]
        : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    %narrow = pto.vmi.vcvt %wide {saturate = "SAT"}
        : !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xf16>
    pto.vmi.vstore %narrow, %dstNarrow[%offset]
        : !pto.vmi.vreg<128xf16>, !pto.ptr<f16, ub>
    return
  }

}

// ASSIGN-LABEL: func.func @vmi_layout_assignment_load_truncf(
// ASSIGN: %[[WIDE:.*]] = pto.vmi.load
// ASSIGN-SAME: {{(!pto\.ptr)?<f32, ub>}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: %[[WIDEC:.*]] = pto.vmi.ensure_layout %[[WIDE]]
// ASSIGN-SAME: -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN: %[[NARROW:.*]] = pto.vmi.truncf %[[WIDEC]]
// ASSIGN-SAME: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN: pto.vmi.store %[[NARROW]]
// ASSIGN-SAME: !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous, lane_stride = 2>>, !pto.ptr<f16, ub>

// LOWER-LABEL: func.func @vmi_layout_assignment_load_truncf(
// LOWER: %[[PARTS:.*]] = pto.vldsx2 %arg0{{.*}} "DINTLV_B32"
// LOWER: %[[PARTS2:.*]] = pto.vintlv %[[PARTS]]
// LOWER: %[[NARROW0:.*]] = pto.vcvt {{.*}} {part = "EVEN", rnd = "R", sat = "SAT"}
// LOWER: %[[NARROW1:.*]] = pto.vcvt {{.*}} {part = "EVEN", rnd = "R", sat = "SAT"}
// LOWER-NOT: part = "ODD"
// LOWER-NOT: pto.vor
// LOWER: pto.vsts %[[NARROW0]]
// LOWER: pto.vsts %[[NARROW1]]
// LOWER-NOT: pto.vmi.
// LOWER-NOT: !pto.vmi.

// ASSIGN-LABEL: func.func @vmi_layout_assignment_load_truncf_multi_use(
// ASSIGN: %[[WIDE:.*]] = pto.vmi.load
// ASSIGN-SAME: {{(!pto\.ptr)?<f32, ub>}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: %[[WIDEC:.*]] = pto.vmi.ensure_layout %[[WIDE]]
// ASSIGN-SAME: -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN: pto.vmi.store %[[WIDE]]
// ASSIGN-SAME: !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>, !pto.ptr<f32, ub>
// ASSIGN: %[[NARROW:.*]] = pto.vmi.truncf %[[WIDEC]]
// ASSIGN-SAME: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN: pto.vmi.store %[[NARROW]]
// ASSIGN-SAME: !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous, lane_stride = 2>>, !pto.ptr<f16, ub>

// LOWER-LABEL: func.func @vmi_layout_assignment_load_truncf_multi_use(
// LOWER: %[[PARTS:.*]] = pto.vldsx2 %arg0{{.*}} "DINTLV_B32"
// LOWER: %[[PARTS2:.*]] = pto.vintlv %[[PARTS]]
// LOWER: pto.vstsx2 %[[PARTS]], {{.*}} "INTLV_B32"
// LOWER: %[[NARROW0:.*]] = pto.vcvt {{.*}} {part = "EVEN", rnd = "R", sat = "SAT"}
// LOWER: %[[NARROW1:.*]] = pto.vcvt {{.*}} {part = "EVEN", rnd = "R", sat = "SAT"}
// LOWER-NOT: part = "ODD"
// LOWER-NOT: pto.vor
// LOWER: pto.vsts %[[NARROW0]]
// LOWER: pto.vsts %[[NARROW1]]
// LOWER-NOT: pto.vmi.
// LOWER-NOT: !pto.vmi.
