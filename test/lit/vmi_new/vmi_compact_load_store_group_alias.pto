// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy | FileCheck %s --check-prefix=LEGACY
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

module {
  func.func @compact_1(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>,
                       %off: index) {
    %value = pto.vmi.vload %src[%off]
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<1xf32>
    pto.vmi.vstore %value, %dst[%off]
        : !pto.vmi.vreg<1xf32>, !pto.ptr<f32, ub>
    return
  }

  func.func @compact_2(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>,
                       %off: index) {
    %value = pto.vmi.vload %src[%off]
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<2xf32>
    pto.vmi.vstore %value, %dst[%off]
        : !pto.vmi.vreg<2xf32>, !pto.ptr<f32, ub>
    return
  }

  func.func @compact_4(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>,
                       %off: index) {
    %value = pto.vmi.vload %src[%off]
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<4xf32>
    pto.vmi.vstore %value, %dst[%off]
        : !pto.vmi.vreg<4xf32>, !pto.ptr<f32, ub>
    return
  }

  func.func @compact_8(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>,
                       %off: index) {
    %value = pto.vmi.vload %src[%off]
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    pto.vmi.vstore %value, %dst[%off]
        : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    return
  }

  func.func @compact_reduce_through_elementwise(
      %source: !pto.vmi.vreg<64xf32>,
      %mask: !pto.vmi.mask<64xpred>, %dst: !pto.ptr<f32, ub>, %off: index) {
    %max = pto.vmi.vcmax %source, %mask
        : !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred>
        -> !pto.vmi.vreg<1xf32>
    %two_scalar = arith.constant 2.0 : f32
    %two = pto.vmi.vbrc %two_scalar : f32 -> !pto.vmi.vreg<1xf32>
    %scaled = pto.vmi.vdiv %max, %two
        : !pto.vmi.vreg<1xf32>, !pto.vmi.vreg<1xf32>
        -> !pto.vmi.vreg<1xf32>
    pto.vmi.vstore %scaled, %dst[%off]
        : !pto.vmi.vreg<1xf32>, !pto.ptr<f32, ub>
    return
  }

}

// LEGACY-LABEL: func.func @compact_1(
// LEGACY: pto.vmi.group_slot_load
// LEGACY-SAME: {num_groups = 1 : i64}
// LEGACY: pto.vmi.group_store
// LEGACY-SAME: {num_groups = 1 : i64}

// LEGACY-LABEL: func.func @compact_2(
// LEGACY: pto.vmi.group_slot_load
// LEGACY-SAME: {num_groups = 2 : i64}
// LEGACY: pto.vmi.group_store
// LEGACY-SAME: {num_groups = 2 : i64}

// LEGACY-LABEL: func.func @compact_4(
// LEGACY: pto.vmi.group_slot_load
// LEGACY-SAME: {num_groups = 4 : i64}
// LEGACY: pto.vmi.group_store
// LEGACY-SAME: {num_groups = 4 : i64}

// LEGACY-LABEL: func.func @compact_8(
// LEGACY: pto.vmi.group_slot_load
// LEGACY-SAME: {num_groups = 8 : i64}
// LEGACY: pto.vmi.group_store
// LEGACY-SAME: {num_groups = 8 : i64}

// LEGACY-LABEL: func.func @compact_reduce_through_elementwise(
// LEGACY: pto.vmi.group_reduce_maxf
// LEGACY-SAME: {num_groups = 1 : i64}
// LEGACY: pto.vmi.divf
// LEGACY: pto.vmi.group_store
// LEGACY-SAME: {num_groups = 1 : i64}

// LOWER-LABEL: func.func @compact_1(
// LOWER: pto.pset_b32 "PAT_VL1"
// LOWER: pto.vsldb
// LOWER: pto.vsts
// LOWER-NOT: pto.vmi.


