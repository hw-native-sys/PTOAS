// RUN: not pto-test-opt %s -test-vmi-layout-cost-conformance 2>&1 | FileCheck %s

// Unified vcvt is intentionally outside the relation-provider phase.  The
// unified-to-legacy pass must canonicalize it before relation conformance.
module {
  func.func @vcvt_requires_canonicalization(
      %source: !pto.vmi.vreg<128xf16>)
      -> !pto.vmi.vreg<128xf32> {
    %result = pto.vmi.vcvt %source
        {test.vmi_layout_cost_conformance}
        : !pto.vmi.vreg<128xf16> -> !pto.vmi.vreg<128xf32>
    return %result : !pto.vmi.vreg<128xf32>
  }
}

// CHECK: test layout-cost conformance marker has no exposed relation
// CHECK-SAME: run the unified-to-legacy canonicalization first
