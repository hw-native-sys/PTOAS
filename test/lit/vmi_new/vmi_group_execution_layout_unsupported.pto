// RUN: not pto-test-opt %s -vmi-to-vpto 2>&1 | FileCheck %s

// CHECK: VMI-UNSUPPORTED{{:}} {{.*}}type=i8, VL=8, group=1, bytes/group=8
// CHECK-SAME: no executable A5 grouped-reduction layout
func.func @forced_byte_vcg(%x: !pto.vmi.vreg<8xi8, #pto.vmi.layout<contiguous, lane_stride = 4>>, %m: !pto.vmi.mask<8xb8, #pto.vmi.layout<contiguous, lane_stride = 4>>) -> !pto.vmi.vreg<1xi8, #pto.vmi.layout<num_groups = 1, slots = 8>> {
  %r = pto.vmi.group_reduce_addi %x, %m {num_groups = 1, reassoc} : !pto.vmi.vreg<8xi8, #pto.vmi.layout<contiguous, lane_stride = 4>>, !pto.vmi.mask<8xb8, #pto.vmi.layout<contiguous, lane_stride = 4>> -> !pto.vmi.vreg<1xi8, #pto.vmi.layout<num_groups = 1, slots = 8>>
  return %r : !pto.vmi.vreg<1xi8, #pto.vmi.layout<num_groups = 1, slots = 8>>
}
