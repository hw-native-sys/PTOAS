// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s

// Frontend contracts prove the exact pointer; later offsets still need proof.
// Unannotated arguments retain the existing address-space ABI contract.
module {
  func.func @annotated(%addr: i64) -> !pto.vmi.vreg<8xf32> {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @offset_one(%addr: i64) -> !pto.vmi.vreg<8xf32> {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %one = arith.constant 1 : index
    %v = pto.vmi.vload %p[%one] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @argument(%p: !pto.ptr<f32, ub> {pto.alignment = 32 : i64}) -> !pto.vmi.vreg<8xf32> {
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @offset_multiple(%addr: i64, %n: index) -> !pto.vmi.vreg<8xf32> {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %eight = arith.constant 8 : index
    %off = arith.muli %n, %eight : index
    %v = pto.vmi.vload %p[%off] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @offset_runtime(%addr: i64, %n: index) -> !pto.vmi.vreg<8xf32> {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %v = pto.vmi.vload %p[%n] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @insufficient_alignment(%addr: i64) -> !pto.vmi.vreg<8xf32> {
    %p = pto.castptr %addr {pto.alignment = 16 : i64} : i64 -> !pto.ptr<f32, ub>
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @combined_one(%addr: i64) -> !pto.vmi.vreg<8xf32> {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %one = arith.constant 1 : index
    %z = arith.constant 0 : index
    %q = pto.addptr %p, %one : !pto.ptr<f32, ub> -> !pto.ptr<f32, ub>
    %v = pto.vmi.vload %q[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @combined_cancel(%addr: i64) -> !pto.vmi.vreg<8xf32> {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %one = arith.constant 1 : index
    %seven = arith.constant 7 : index
    %q = pto.addptr %p, %one : !pto.ptr<f32, ub> -> !pto.ptr<f32, ub>
    %v = pto.vmi.vload %q[%seven] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @combined_dynamic(%addr: i64, %n: index) -> !pto.vmi.vreg<8xf32> {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %one = arith.constant 1 : index
    %seven = arith.constant 7 : index
    %eight = arith.constant 8 : index
    %off = arith.muli %n, %eight : index
    %q = pto.addptr %p, %off : !pto.ptr<f32, ub> -> !pto.ptr<f32, ub>
    %r = pto.addptr %q, %one : !pto.ptr<f32, ub> -> !pto.ptr<f32, ub>
    %v = pto.vmi.vload %r[%seven] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @opaque_projection_proved(%m: memref<64xf32>) -> !pto.vmi.vreg<8xf32> {
    %idx = memref.extract_aligned_pointer_as_index %m : memref<64xf32> -> index
    %addr = arith.index_cast %idx : index to i64
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @opaque_projection_unknown(%m: memref<64xf32>) -> !pto.vmi.vreg<8xf32> {
    %idx = memref.extract_aligned_pointer_as_index %m : memref<64xf32> -> index
    %addr = arith.index_cast %idx : index to i64
    %p = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @masked_store_proved(%value: !pto.vmi.vreg<64xf32>, %mask: !pto.vmi.mask<64xb32>, %addr: i64) {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %z = arith.constant 0 : index
    pto.vmi.vstore %value, %p[%z], %mask : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<64xb32>
    return
  }
  func.func @byte_load_proved(%addr: i64) -> !pto.vmi.vreg<8xui8> {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<ui8, ub>
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p[%z] : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<8xui8>
    return %v : !pto.vmi.vreg<8xui8>
  }
  func.func @legacy_argument(%p: !pto.ptr<f32, ub>) -> !pto.vmi.vreg<8xf32> {
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
}
// CHECK-LABEL: func.func @annotated
// CHECK: pto.vsldb
// CHECK-LABEL: func.func @offset_one
// CHECK: pto.vldas
// CHECK: pto.vldus
// CHECK-LABEL: func.func @argument
// CHECK: pto.vsldb
// CHECK-LABEL: func.func @offset_multiple
// CHECK: pto.vsldb
// CHECK-LABEL: func.func @offset_runtime
// CHECK: pto.vldas
// CHECK: pto.vldus
// CHECK-LABEL: func.func @insufficient_alignment
// CHECK: pto.vldas
// CHECK: pto.vldus
// CHECK-LABEL: func.func @combined_one
// CHECK: pto.vldas
// CHECK: pto.vldus
// CHECK-LABEL: func.func @combined_cancel
// CHECK: pto.vsldb
// CHECK-LABEL: func.func @combined_dynamic
// CHECK: pto.vsldb
// CHECK-LABEL: func.func @opaque_projection_proved
// CHECK: pto.vsldb
// CHECK-LABEL: func.func @opaque_projection_unknown
// CHECK: pto.vldas
// CHECK: pto.vldus
// CHECK-LABEL: func.func @masked_store_proved
// CHECK: pto.vsts
// CHECK-LABEL: func.func @byte_load_proved
// CHECK: pto.vsldb
// CHECK-LABEL: func.func @legacy_argument
// CHECK: pto.vsldb
