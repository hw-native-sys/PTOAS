    %p16 = pto.castptr %p15 : !pto.ptr<i8, ub> -> !pto.ptr<f32, ub>
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p16[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
