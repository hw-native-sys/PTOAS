// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s

module {
  func.func @annotated(%addr: i64) -> !pto.vmi.vreg<8xf32> {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @select_equal(%cond: i1) -> !pto.vmi.vreg<8xf32> {
    %a = arith.constant 1024 : i64
    %b = arith.constant 2048 : i64
    %x = pto.castptr %a : i64 -> !pto.ptr<f32, ub>
    %y = pto.castptr %b : i64 -> !pto.ptr<f32, ub>
    %p = arith.select %cond, %x, %y : !pto.ptr<f32, ub>
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @offset_one(%addr: i64) -> !pto.vmi.vreg<8xf32> {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %one = arith.constant 1 : index
    %v = pto.vmi.vload %p[%one] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @loop_step_one(%addr: i64, %dst: !pto.ptr<f32, ub> {pto.alignment = 32 : i64}) {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %z = arith.constant 0 : index
    %one = arith.constant 1 : index
    %two = arith.constant 2 : index
    %r = scf.for %i = %z to %two step %one iter_args(%q = %p) -> (!pto.ptr<f32, ub>) {
      %v = pto.vmi.vload %q[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
      pto.vmi.vstore %v, %dst[%z] : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
      %n = pto.addptr %q, %one : !pto.ptr<f32, ub> -> !pto.ptr<f32, ub>
      scf.yield %n : !pto.ptr<f32, ub>
    }
    return
  }
  func.func @argument(%p: !pto.ptr<f32, ub> {pto.alignment = 32 : i64}) -> !pto.vmi.vreg<8xf32> {
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @integer_select_nonzero(%c: i1) -> !pto.vmi.vreg<8xf32> {
    %a = arith.constant 1028 : i64
    %b = arith.constant 2052 : i64
    %i = arith.select %c, %a, %b : i64
    %p = pto.castptr %i : i64 -> !pto.ptr<f32, ub>
    %seven = arith.constant 7 : index
    %v = pto.vmi.vload %p[%seven] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @integer_select_mixed(%c: i1) -> !pto.vmi.vreg<8xf32> {
    %a = arith.constant 1024 : i64
    %b = arith.constant 2052 : i64
    %i = arith.select %c, %a, %b : i64
    %p = pto.castptr %i : i64 -> !pto.ptr<f32, ub>
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @offset_multiple(%addr: i64, %n: index) -> !pto.vmi.vreg<8xf32> {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %eight = arith.constant 8 : index
    %off = arith.muli %n, %eight : index
    %v = pto.vmi.vload %p[%off] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
  func.func @offset_runtime(%addr: i64, %n: index) -> !pto.vmi.vreg<8xf32> {
    %p = pto.castptr %addr {pto.alignment = 32 : i64} : i64 -> !pto.ptr<f32, ub>
    %v = pto.vmi.vload %p[%n] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }

  func.func @narrow_cast(%n: i4) -> !pto.vmi.vreg<8xf32> {
    %sixteen = arith.constant 16 : i64
    %extended = arith.extui %n : i4 to i64
    %addr = arith.muli %extended, %sixteen : i64
    %p = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
    %z = arith.constant 0 : index
    %v = pto.vmi.vload %p[%z] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
