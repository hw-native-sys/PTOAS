// RUN: ptoas --pto-arch=a5 --pto-level=level3 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s --implicit-check-not='pto.vmi.' --implicit-check-not='pto.vcg{{(add|max|min)}} {{.*}}!pto.vreg<256x{{(s|u)?}}i8>'
module {
  // CHECK-LABEL: func.func @group_execution_si8_8_8
  // CHECK-NOT: pto.vcadd
  // CHECK-NOT: pto.vsunpack
  // CHECK: pto.vsel
  func.func @group_execution_si8_8_8(%src: !pto.ptr<si8, ub>, %dst: !pto.ptr<si8, ub>, %active: index) {
    %zero = arith.constant 0 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<si8, ub> -> !pto.vmi.vreg<8xsi8>
    %m = pto.vmi.create_mask %active : index -> !pto.vmi.mask<8xpred>
    %r = pto.vmi.vcadd %x, %m {group = 8, reassoc} : !pto.vmi.vreg<8xsi8>, !pto.vmi.mask<8xpred> -> !pto.vmi.vreg<8xsi8>
    %b = pto.vmi.vbrc %r {group = 8} : !pto.vmi.vreg<8xsi8> -> !pto.vmi.vreg<8xsi8>
    pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<8xsi8>, !pto.ptr<si8, ub>
    return
  }
  // CHECK-LABEL: func.func @group_execution_ui8_128_1
  // CHECK-DAG: pto.vzunpack
  // CHECK-DAG: pto.punpack
  // CHECK: pto.vcadd
  func.func @group_execution_ui8_128_1(%src: !pto.ptr<ui8, ub>, %dst: !pto.ptr<ui8, ub>, %active: index) {
    %zero = arith.constant 0 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<128xui8>
    %m = pto.vmi.create_mask %active : index -> !pto.vmi.mask<128xpred>
    %r = pto.vmi.vcadd %x, %m {group = 1, reassoc} : !pto.vmi.vreg<128xui8>, !pto.vmi.mask<128xpred> -> !pto.vmi.vreg<1xui8>
    %b = pto.vmi.vbrc %r {group = 1} : !pto.vmi.vreg<1xui8> -> !pto.vmi.vreg<128xui8>
    pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<128xui8>, !pto.ptr<ui8, ub>
    return
  }
  // CHECK-LABEL: func.func @group_execution_si8_256_1
  // CHECK-DAG: pto.vsunpack
  // CHECK-DAG: pto.punpack
  // CHECK-DAG: pto.punpack {{.*}}"HIGHER"
  // CHECK: pto.vcadd
  func.func @group_execution_si8_256_1(%src: !pto.ptr<si8, ub>, %dst: !pto.ptr<si8, ub>, %active: index) {
    %zero = arith.constant 0 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<si8, ub> -> !pto.vmi.vreg<256xsi8>
    %m = pto.vmi.create_mask %active : index -> !pto.vmi.mask<256xpred>
    %r = pto.vmi.vcadd %x, %m {group = 1, reassoc} : !pto.vmi.vreg<256xsi8>, !pto.vmi.mask<256xpred> -> !pto.vmi.vreg<1xsi8>
    %b = pto.vmi.vbrc %r {group = 1} : !pto.vmi.vreg<1xsi8> -> !pto.vmi.vreg<256xsi8>
    pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<256xsi8>, !pto.ptr<si8, ub>
    return
  }
  // CHECK-LABEL: func.func @group_execution_ui8_256_8
  // CHECK-DAG: pto.vzunpack
  // CHECK-DAG: pto.punpack
  // CHECK-DAG: pto.punpack {{.*}}"HIGHER"
  // CHECK: pto.vcadd
  func.func @group_execution_ui8_256_8(%src: !pto.ptr<ui8, ub>, %dst: !pto.ptr<ui8, ub>, %active: index) {
    %zero = arith.constant 0 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<256xui8>
    %m = pto.vmi.create_mask %active : index -> !pto.vmi.mask<256xpred>
    %r = pto.vmi.vcadd %x, %m {group = 8, reassoc} : !pto.vmi.vreg<256xui8>, !pto.vmi.mask<256xpred> -> !pto.vmi.vreg<8xui8>
    %b = pto.vmi.vbrc %r {group = 8} : !pto.vmi.vreg<8xui8> -> !pto.vmi.vreg<256xui8>
    pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<256xui8>, !pto.ptr<ui8, ub>
    return
  }
  // CHECK-LABEL: func.func @group_execution_i16_64_1
  // CHECK: pto.vcadd
  func.func @group_execution_i16_64_1(%src: !pto.ptr<i16, ub>, %dst: !pto.ptr<i16, ub>, %active: index) {
    %zero = arith.constant 0 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<i16, ub> -> !pto.vmi.vreg<64xi16>
    %m = pto.vmi.create_mask %active : index -> !pto.vmi.mask<64xpred>
    %r = pto.vmi.vcadd %x, %m {group = 1, reassoc} : !pto.vmi.vreg<64xi16>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<1xi16>
    %b = pto.vmi.vbrc %r {group = 1} : !pto.vmi.vreg<1xi16> -> !pto.vmi.vreg<64xi16>
    pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<64xi16>, !pto.ptr<i16, ub>
    return
  }
  // CHECK-LABEL: func.func @group_execution_i16_128_2
  // CHECK: pto.vcadd
  func.func @group_execution_i16_128_2(%src: !pto.ptr<i16, ub>, %dst: !pto.ptr<i16, ub>, %active: index) {
    %zero = arith.constant 0 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<i16, ub> -> !pto.vmi.vreg<128xi16>
    %m = pto.vmi.create_mask %active : index -> !pto.vmi.mask<128xpred>
    %r = pto.vmi.vcadd %x, %m {group = 2, reassoc} : !pto.vmi.vreg<128xi16>, !pto.vmi.mask<128xpred> -> !pto.vmi.vreg<2xi16>
    %b = pto.vmi.vbrc %r {group = 2} : !pto.vmi.vreg<2xi16> -> !pto.vmi.vreg<128xi16>
    pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<128xi16>, !pto.ptr<i16, ub>
    return
  }
  // CHECK-LABEL: func.func @group_execution_ui16_64_8
  // CHECK: pto.vcgadd
  // CHECK: pto.vpack
  func.func @group_execution_ui16_64_8(%src: !pto.ptr<ui16, ub>, %dst: !pto.ptr<ui16, ub>, %active: index) {
    %zero = arith.constant 0 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<ui16, ub> -> !pto.vmi.vreg<64xui16>
    %m = pto.vmi.create_mask %active : index -> !pto.vmi.mask<64xpred>
    %r = pto.vmi.vcadd %x, %m {group = 8, reassoc} : !pto.vmi.vreg<64xui16>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<8xui16>
    %b = pto.vmi.vbrc %r {group = 8} : !pto.vmi.vreg<8xui16> -> !pto.vmi.vreg<64xui16>
    pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<64xui16>, !pto.ptr<ui16, ub>
    return
  }
  // CHECK-LABEL: func.func @group_execution_f16_64_8
  // CHECK: pto.vcgadd
  func.func @group_execution_f16_64_8(%src: !pto.ptr<f16, ub>, %dst: !pto.ptr<f16, ub>, %active: index) {
    %zero = arith.constant 0 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<f16, ub> -> !pto.vmi.vreg<64xf16>
    %m = pto.vmi.create_mask %active : index -> !pto.vmi.mask<64xpred>
    %r = pto.vmi.vcadd %x, %m {group = 8, reassoc} : !pto.vmi.vreg<64xf16>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<8xf16>
    %b = pto.vmi.vbrc %r {group = 8} : !pto.vmi.vreg<8xf16> -> !pto.vmi.vreg<64xf16>
    pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<64xf16>, !pto.ptr<f16, ub>
    return
  }
  // CHECK-LABEL: func.func @group_execution_f32_8_1
  // CHECK: pto.vcgadd
  func.func @group_execution_f32_8_1(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>, %active: index) {
    %zero = arith.constant 0 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    %m = pto.vmi.create_mask %active : index -> !pto.vmi.mask<8xpred>
    %r = pto.vmi.vcadd %x, %m {group = 1, reassoc} : !pto.vmi.vreg<8xf32>, !pto.vmi.mask<8xpred> -> !pto.vmi.vreg<1xf32>
    %b = pto.vmi.vbrc %r {group = 1} : !pto.vmi.vreg<1xf32> -> !pto.vmi.vreg<8xf32>
    pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    return
  }
}
