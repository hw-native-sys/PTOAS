// RUN: not pto-test-opt -split-input-file %s 2>&1 | FileCheck %s

// vunzip / vzip require every operand to carry the same layout when any of them
// carries one.  Plain MLIR verification must reject three present but unequal
// layouts without relying on the semantic-validation pass.

module {
  func.func @vunzip_layout_mismatch(
      %src: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>) {
    %low, %high = pto.vmi.vunzip %src
        : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<deinterleaved = 2>>, !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>
    return
  }
}

// -----

module {
  func.func @vzip_layout_mismatch(
      %low: !pto.vmi.vreg<128xui16, #pto.vmi.layout<deinterleaved = 2>>,
      %high: !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>) {
    %r = pto.vmi.vzip %low, %high
        : !pto.vmi.vreg<128xui16, #pto.vmi.layout<deinterleaved = 2>>, !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xui32, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: requires equal layouts on all operands
// CHECK-SAME: source = #pto.vmi.layout<contiguous>
// CHECK-SAME: low = #pto.vmi.layout<deinterleaved = 2>
// CHECK: requires equal layouts on all operands
// CHECK-SAME: result = #pto.vmi.layout<contiguous>
// CHECK-SAME: low = #pto.vmi.layout<deinterleaved = 2>
