// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance | FileCheck %s
// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance -vmi-to-vpto -test-vmi-layout-lowering-conformance > /dev/null

module {
  func.func @half_block(
      %source: !pto.vmi.vreg<16xf16,
          #pto.vmi.layout<contiguous, lane_stride = 2>>,
      %mask: !pto.vmi.mask<16xb16,
          #pto.vmi.layout<contiguous, lane_stride = 2>>)
      -> !pto.vmi.vreg<2xf16,
          #pto.vmi.layout<num_groups = 2, slots = 8>> {
    %result = pto.vmi.group_reduce_addf %source, %mask {
        num_groups = 2, reassoc, test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<16xf16,
            #pto.vmi.layout<contiguous, lane_stride = 2>>,
          !pto.vmi.mask<16xb16,
            #pto.vmi.layout<contiguous, lane_stride = 2>>
        -> !pto.vmi.vreg<2xf16,
            #pto.vmi.layout<num_groups = 2, slots = 8>>
    return %result : !pto.vmi.vreg<2xf16,
        #pto.vmi.layout<num_groups = 2, slots = 8>>
  }

  func.func @one_block(
      %source: !pto.vmi.vreg<32xf16, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<32xb16, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<2xf16,
          #pto.vmi.layout<num_groups = 2, slots = 8>> {
    %result = pto.vmi.group_reduce_addf %source, %mask {
        num_groups = 2, reassoc, test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<32xf16, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<32xb16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<2xf16,
            #pto.vmi.layout<num_groups = 2, slots = 8>>
    return %result : !pto.vmi.vreg<2xf16,
        #pto.vmi.layout<num_groups = 2, slots = 8>>
  }

