// RUN: not pto-test-opt %s -test-vmi-layout-cost-conformance 2>&1 | FileCheck %s

module {
  func.func @vci_group_noncontiguous(%base: f32)
      -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>> {
    %v = pto.vmi.vci %base {group = 2 : i64,
                            test.vmi_layout_cost_conformance}
      : f32 -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
    return %v : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
  }
}

// CHECK: test layout-cost conformance marker has no exposed relation
