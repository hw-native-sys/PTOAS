// LOWER-NEXT: %[[VAL_16:[a-zA-Z0-9_.$-]+]] = pto.vselr %[[VAL_12]], %[[VAL_15]] : !pto.vreg<64xf32>, !pto.vreg<64xui32> -> !pto.vreg<64xf32>
