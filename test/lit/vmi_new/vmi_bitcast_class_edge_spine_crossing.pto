// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN --implicit-check-not=pto.vmi.ensure_layout
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -pto-validate-vmi-layout-ir -vmi-to-vpto | FileCheck %s --check-prefix=LOWER --implicit-check-not=pto.vmi. --implicit-check-not='!pto.vmi.'

// An equal-width bitcast is a *layout class edge*, so the direction-spine class
// walk must be able to cross it.  Two things have to hold for that to be real
// rather than declared:
//
//   * the walk has to treat the crossed value as still inside the class.  A
//     layout is a physical-carrier property, so the class test is the storage
//     element width, not MLIR element-type identity - an equal-width bitcast
//     reinterprets the element type on purpose (here i32 <-> ui32) while
//     keeping the carrier.
//   * the class edge has to be *free*: the layout the spine family selects must
//     travel through the bitcast with no ensure_layout on either side.
//
// The two functions are the same nested <up,down,up,down> integer round trip,
// once without and once with the equal-width bitcast between the last widening
// leg and the closing narrowing leg.  Both are recognised and both take the
// spine-scoped integer family (deinterleaved = 2 on the narrow side,
// deinterleaved = 4 on the wide side); the ASSIGN run forbids ensure_layout
// anywhere in the file, so the bitcast can only be carrying that layout as a
// class edge.  Before the class test used the storage element width, the second
// function fell back to the generic lane-stride family
// (contiguous + lane_stride = 2 / contiguous), i.e. the declared class edge
// could never be used.

module {
  func.func @spine_without_bitcast(
      %src: !pto.ptr<ui16, ub>, %dst: !pto.ptr<ui16, ub>) {
    %c0 = arith.constant 0 : index
    %x = pto.vmi.vload %src[%c0]
        : !pto.ptr<ui16, ub> -> !pto.vmi.vreg<128xui16>
    %0 = pto.vmi.extui %x
        : !pto.vmi.vreg<128xui16> -> !pto.vmi.vreg<128xui32>
    %1 = pto.vmi.trunci %0 {saturate = "NOSAT"}
        : !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xui16>
    %2 = pto.vmi.extui %1
        : !pto.vmi.vreg<128xui16> -> !pto.vmi.vreg<128xui32>
    %3 = pto.vmi.trunci %2 {saturate = "NOSAT"}
        : !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xui16>
    pto.vmi.vstore %3, %dst[%c0]
        : !pto.vmi.vreg<128xui16>, !pto.ptr<ui16, ub>
    return
  }

  func.func @spine_across_equal_width_bitcast(
      %src: !pto.ptr<ui16, ub>, %dst: !pto.ptr<ui16, ub>) {
    %c0 = arith.constant 0 : index
    %x = pto.vmi.vload %src[%c0]
        : !pto.ptr<ui16, ub> -> !pto.vmi.vreg<128xui16>
    %0 = pto.vmi.extui %x
        : !pto.vmi.vreg<128xui16> -> !pto.vmi.vreg<128xui32>
    %1 = pto.vmi.trunci %0 {saturate = "NOSAT"}
        : !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xui16>
    %2 = pto.vmi.extui %1
        : !pto.vmi.vreg<128xui16> -> !pto.vmi.vreg<128xui32>
    %3 = pto.vmi.vinterpret_cast %2
        : !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xi32>
    %4 = pto.vmi.trunci %3 {saturate = "NOSAT"}
        : !pto.vmi.vreg<128xi32> -> !pto.vmi.vreg<128xui16>
    pto.vmi.vstore %4, %dst[%c0]
        : !pto.vmi.vreg<128xui16>, !pto.ptr<ui16, ub>
    return
  }
}

// ASSIGN-LABEL: func.func @spine_without_bitcast
// ASSIGN: %[[L0:.*]] = pto.vmi.load
// ASSIGN-SAME: !pto.vmi.vreg<128xui16, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: %[[W0:.*]] = pto.vmi.extui %[[L0]]
// ASSIGN-SAME: -> !pto.vmi.vreg<128xui32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN: %[[N0:.*]] = pto.vmi.trunci %[[W0]]
// ASSIGN-SAME: -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.extui %[[N0]]
// ASSIGN: pto.vmi.trunci
// ASSIGN-SAME: -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<deinterleaved = 2>>

// ASSIGN-LABEL: func.func @spine_across_equal_width_bitcast
// ASSIGN: %[[L1:.*]] = pto.vmi.load
// ASSIGN-SAME: !pto.vmi.vreg<128xui16, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: %[[W1:.*]] = pto.vmi.extui %[[L1]]
// ASSIGN-SAME: -> !pto.vmi.vreg<128xui32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN: %[[N1:.*]] = pto.vmi.trunci %[[W1]]
// ASSIGN-SAME: -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: %[[U1:.*]] = pto.vmi.extui %[[N1]]
// ASSIGN-SAME: -> !pto.vmi.vreg<128xui32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN: %[[B1:.*]] = pto.vmi.bitcast %[[U1]]
// ASSIGN-SAME: !pto.vmi.vreg<128xui32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN-SAME: -> !pto.vmi.vreg<128xi32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN: %[[T1:.*]] = pto.vmi.trunci %[[B1]]
// ASSIGN-SAME: -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.store %[[T1]]

// LOWER-LABEL: func.func @spine_without_bitcast
// LOWER: pto.vlds
// LOWER: pto.vdintlv
// LOWER: pto.vsts

// LOWER-LABEL: func.func @spine_across_equal_width_bitcast
// LOWER: pto.vlds
// LOWER: pto.vdintlv
// LOWER: pto.vbitcast
// LOWER: pto.vsts
