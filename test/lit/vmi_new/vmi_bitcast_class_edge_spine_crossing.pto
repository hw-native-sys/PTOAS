// LOWER-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = pto.vlds %[[VAL_0]]{{\[}}%[[VAL_3]]] {dist = "UNPK_B16"} : !pto.ptr<ui16, ub>, index -> !pto.vreg<128xui16>
