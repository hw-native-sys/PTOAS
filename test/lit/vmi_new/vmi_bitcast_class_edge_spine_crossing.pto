// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN --implicit-check-not=pto.vmi.ensure_layout
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -pto-validate-vmi-layout-ir -vmi-to-vpto | FileCheck %s --check-prefix=LOWER --implicit-check-not=pto.vmi. --implicit-check-not='!pto.vmi.'

// Equal-width bitcasts preserve the physical layout across an integer cast
// round trip. Compare the versions with and without the bitcast while allowing
// the physical cost model to choose the cast family.

module {
  func.func @spine_without_bitcast(
      %src: !pto.ptr<ui16, ub>, %dst: !pto.ptr<ui16, ub>) {
    %c0 = arith.constant 0 : index
    %x = pto.vmi.vload %src[%c0]
        : !pto.ptr<ui16, ub> -> !pto.vmi.vreg<128xui16>
    %0 = pto.vmi.extui %x
        : !pto.vmi.vreg<128xui16> -> !pto.vmi.vreg<128xui32>
    %1 = pto.vmi.trunci %0 {saturate = "NOSAT"}
        : !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xui16>
    %2 = pto.vmi.extui %1
        : !pto.vmi.vreg<128xui16> -> !pto.vmi.vreg<128xui32>
    %3 = pto.vmi.trunci %2 {saturate = "NOSAT"}
        : !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xui16>
    pto.vmi.vstore %3, %dst[%c0]
        : !pto.vmi.vreg<128xui16>, !pto.ptr<ui16, ub>
    return
  }

  func.func @spine_across_equal_width_bitcast(
      %src: !pto.ptr<ui16, ub>, %dst: !pto.ptr<ui16, ub>) {
    %c0 = arith.constant 0 : index
    %x = pto.vmi.vload %src[%c0]
        : !pto.ptr<ui16, ub> -> !pto.vmi.vreg<128xui16>
    %0 = pto.vmi.extui %x
        : !pto.vmi.vreg<128xui16> -> !pto.vmi.vreg<128xui32>
    %1 = pto.vmi.trunci %0 {saturate = "NOSAT"}
        : !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xui16>
    %2 = pto.vmi.extui %1
        : !pto.vmi.vreg<128xui16> -> !pto.vmi.vreg<128xui32>
    %3 = pto.vmi.vinterpret_cast %2
        : !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xi32>
    %4 = pto.vmi.trunci %3 {saturate = "NOSAT"}
        : !pto.vmi.vreg<128xi32> -> !pto.vmi.vreg<128xui16>
    pto.vmi.vstore %4, %dst[%c0]
        : !pto.vmi.vreg<128xui16>, !pto.ptr<ui16, ub>
    return
  }
}

// ASSIGN-LABEL: func.func @spine_without_bitcast(
// ASSIGN-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.ptr<ui16, ub>,
// ASSIGN-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.ptr<ui16, ub>) {
// ASSIGN-NEXT: %[[VAL_2:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : index
// ASSIGN-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = pto.vmi.load %[[VAL_0]]{{\[}}%[[VAL_2]]] : !pto.ptr<ui16, ub> -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = pto.vmi.extui %[[VAL_3]] : !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>> -> !pto.vmi.vreg<128xui32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = pto.vmi.trunci %[[VAL_4]] {saturate = "NOSAT"} : !pto.vmi.vreg<128xui32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = pto.vmi.extui %[[VAL_5]] : !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>> -> !pto.vmi.vreg<128xui32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.vmi.trunci %[[VAL_6]] {saturate = "NOSAT"} : !pto.vmi.vreg<128xui32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN-NEXT: pto.vmi.store %[[VAL_7]], %[[VAL_1]]{{\[}}%[[VAL_2]]] : !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>, !pto.ptr<ui16, ub>
// ASSIGN-NEXT: return
// ASSIGN-NEXT: }
// ASSIGN-LABEL: func.func @spine_across_equal_width_bitcast(
// ASSIGN-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.ptr<ui16, ub>,
// ASSIGN-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.ptr<ui16, ub>) {
// ASSIGN-NEXT: %[[VAL_2:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : index
// ASSIGN-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = pto.vmi.load %[[VAL_0]]{{\[}}%[[VAL_2]]] : !pto.ptr<ui16, ub> -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = pto.vmi.extui %[[VAL_3]] : !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>> -> !pto.vmi.vreg<128xui32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = pto.vmi.trunci %[[VAL_4]] {saturate = "NOSAT"} : !pto.vmi.vreg<128xui32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = pto.vmi.extui %[[VAL_5]] : !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>> -> !pto.vmi.vreg<128xui32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.vmi.bitcast %[[VAL_6]] : !pto.vmi.vreg<128xui32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xi32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.vmi.trunci %[[VAL_7]] {saturate = "NOSAT"} : !pto.vmi.vreg<128xi32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN-NEXT: pto.vmi.store %[[VAL_8]], %[[VAL_1]]{{\[}}%[[VAL_2]]] : !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>, !pto.ptr<ui16, ub>
// ASSIGN-NEXT: return
// ASSIGN-NEXT: }

