// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s

module {
  func.func @compact_broadcast_i8_1_1(%src: !pto.ptr<i8, ub>, %dst: !pto.ptr<i8, ub>) {
    %zero = arith.constant 0 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<i8, ub> -> !pto.vmi.vreg<1xi8>
    %r = pto.vmi.vbrc %x {group = 1} : !pto.vmi.vreg<1xi8> -> !pto.vmi.vreg<1xi8>
    pto.vmi.vstore %r, %dst[%zero] : !pto.vmi.vreg<1xi8>, !pto.ptr<i8, ub>
    return
  }

// CHECK-LABEL: func.func @compact_broadcast_i8_1_1(
// CHECK: pto.vselr
// CHECK-NOT: pto.vmi.
  func.func @compact_broadcast_i8_2_1(%src: !pto.ptr<i8, ub>, %dst: !pto.ptr<i8, ub>) {
    %zero = arith.constant 0 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<i8, ub> -> !pto.vmi.vreg<1xi8>
    %r = pto.vmi.vbrc %x {group = 1} : !pto.vmi.vreg<1xi8> -> !pto.vmi.vreg<2xi8>
    pto.vmi.vstore %r, %dst[%zero] : !pto.vmi.vreg<2xi8>, !pto.ptr<i8, ub>
    return
  }

