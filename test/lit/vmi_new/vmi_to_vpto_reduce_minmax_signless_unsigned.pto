// RUN: pto-test-opt %s -pto-vmi-normalize-signless-int-to-unsigned -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s

module {
  func.func @reduce_minmax_signless_unsigned(
      %source: !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>)
      -> (!pto.vreg<64xi32>, !pto.vreg<64xi32>) {
    %max = pto.vmi.vcmax %source, %mask
        : !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xi32, #pto.vmi.layout<contiguous>>
    %min = pto.vmi.vcmin %source, %mask
        : !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xi32, #pto.vmi.layout<contiguous>>
    %max_part = "pto.vmi.unpack"(%max)
        : (!pto.vmi.vreg<1xi32, #pto.vmi.layout<contiguous>>)
        -> !pto.vreg<64xi32>
    %min_part = "pto.vmi.unpack"(%min)
        : (!pto.vmi.vreg<1xi32, #pto.vmi.layout<contiguous>>)
        -> !pto.vreg<64xi32>
    return %max_part, %min_part : !pto.vreg<64xi32>, !pto.vreg<64xi32>
  }
}

// CHECK-LABEL: func.func @reduce_minmax_signless_unsigned(
// CHECK: pto.vcmax {{.*}} : !pto.vreg<64xui32>, !pto.mask<b32> -> !pto.vreg<64xui32>
// CHECK: pto.vcmin {{.*}} : !pto.vreg<64xui32>, !pto.mask<b32> -> !pto.vreg<64xui32>
// CHECK-NOT: pto.vcmax {{.*}} !pto.vreg<64xi32>
// CHECK-NOT: pto.vcmin {{.*}} !pto.vreg<64xi32>
