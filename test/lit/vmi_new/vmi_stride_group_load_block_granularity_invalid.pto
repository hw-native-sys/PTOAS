// RUN: not pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment 2>&1 | FileCheck %s

// A strided group whose group is finer than one 32-byte block has no lowering:
// the block forms address whole blocks and the sub-chunk gather emulation is
// gone, so the layout plan has to reject it.

module {
  func.func @sub_32b_group_load(%base: !pto.ptr<ui8, ub>, %off: index) {
    // CHECK: VMI-LAYOUT-CONTRACT: pto.vmi.group_load with a row stride requires one group to be 32, 64, or 128 bytes and the row stride to be a whole number of 32-byte blocks
    // CHECK-SAME: got group = 8 bytes, row_stride = 16 bytes
    %stride16 = arith.constant 16 : index
    %x = pto.vmi.vload %base[%off], %stride16 {group = 8}
        : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<64xui8>
    return
  }
}
