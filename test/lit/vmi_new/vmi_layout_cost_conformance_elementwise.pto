      : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    %i2 = pto.vmi.mini %i0, %i1 {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>
    %i3 = pto.vmi.maxi %i2, %i1 {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>
    %i4 = pto.vmi.andi %i3, %i1 {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>
    %i5 = pto.vmi.shrsi %i4, %i1 {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>
    %u2 = pto.vmi.ori %u0, %u1 {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>
    %u3 = pto.vmi.xori %u2, %u1 {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>
    %u4 = pto.vmi.shli %u3, %u1 {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>
    %u5 = pto.vmi.shrui %u4, %u1 {test.vmi_layout_cost_conformance}
