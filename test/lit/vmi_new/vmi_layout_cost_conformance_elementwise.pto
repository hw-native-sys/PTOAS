// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance | FileCheck %s --check-prefix=COST
// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance -vmi-to-vpto -test-vmi-layout-lowering-conformance > /dev/null

module {
  func.func @addf(%a: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
                  %b: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %r = pto.vmi.addf %a, %b {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
        !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %r : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }
  func.func @addi(%a: !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>,
                  %b: !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>> {
    %r = pto.vmi.addi %a, %b {test.vmi_layout_cost_conformance}
