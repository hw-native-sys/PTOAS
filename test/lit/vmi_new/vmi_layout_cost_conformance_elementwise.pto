      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %r = pto.vmi.negf %a {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
