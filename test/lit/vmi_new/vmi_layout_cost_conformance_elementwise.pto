  func.func @legacy_generic(
      %f0: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
      %f1: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
      %i0: !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>,
      %i1: !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>,
      %u0: !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>,
      %u1: !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>)
      -> (!pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<64xsi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>) {
    %f2 = pto.vmi.divf %f0, %f1 {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    %f3 = pto.vmi.minf %f2, %f1 {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    %f4 = pto.vmi.maxf %f3, %f1 {test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    %f5 = pto.vmi.sqrt %f4 {test.vmi_layout_cost_conformance}
