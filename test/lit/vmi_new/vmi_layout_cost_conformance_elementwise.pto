  }
  func.func @subf(%a: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
                  %b: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %r = pto.vmi.subf %a, %b {test.vmi_layout_cost_conformance}
