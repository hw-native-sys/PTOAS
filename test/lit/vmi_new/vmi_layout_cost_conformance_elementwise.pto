// COST: vmi-layout-cost-conformance addf pto.vmi.addf relation=0 cost=0
// COST: vmi-layout-cost-conformance addi pto.vmi.addi relation=0 cost=0
// COST: vmi-layout-cost-conformance subi pto.vmi.subi relation=0 cost=0
// COST: vmi-layout-cost-conformance muli pto.vmi.muli relation=0 cost=0
// COST: vmi-layout-cost-conformance negi pto.vmi.negi relation=0 cost=0
// COST: vmi-layout-cost-conformance absi pto.vmi.absi relation=0 cost=0
// COST: vmi-layout-cost-conformance subf pto.vmi.subf relation=0 cost=0
// COST: vmi-layout-cost-conformance mulf pto.vmi.mulf relation=0 cost=0
// COST: vmi-layout-cost-conformance negf pto.vmi.negf relation=0 cost=0
// COST: vmi-layout-cost-conformance absf pto.vmi.absf relation=0 cost=0
// COST: vmi-layout-cost-conformance vadds_zero pto.vmi.vadds relation=0 cost=0
// COST: vmi-layout-cost-conformance vmuls_zero pto.vmi.vmuls relation=0 cost=0
