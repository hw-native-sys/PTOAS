        -> !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>
    return %r : !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>
  }
  func.func @subi(%a: !pto.vmi.vreg<64xi32, #pto.vmi.layout<contiguous>>,
