// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s

// A reduction result has only 2/4/8 logical lanes, but each group-slot result
// still occupies one physical 64xf32 -> 128xbf16 pair.  Round-to-zero can
// therefore use the same zero-paired vdintlv path as a contiguous c/c value.

module {
  func.func @group_reduce_result_2_slots1(
      %source: !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>>)
      -> (!pto.vreg<128xbf16>, !pto.vreg<128xbf16>) {
    %narrow = pto.vmi.vcvt %source {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>>
        -> !pto.vmi.vreg<2xbf16, #pto.vmi.layout<num_groups = 2, slots = 1>>
    %p0, %p1 = "pto.vmi.unpack"(%narrow)
        : (!pto.vmi.vreg<2xbf16, #pto.vmi.layout<num_groups = 2, slots = 1>>)
        -> (!pto.vreg<128xbf16>, !pto.vreg<128xbf16>)
    return %p0, %p1 : !pto.vreg<128xbf16>, !pto.vreg<128xbf16>
  }

  func.func @group_reduce_result_4_slots1(
      %source: !pto.vmi.vreg<4xf32, #pto.vmi.layout<num_groups = 4, slots = 1>>)
      -> (!pto.vreg<128xbf16>, !pto.vreg<128xbf16>, !pto.vreg<128xbf16>,
          !pto.vreg<128xbf16>) {
    %narrow = pto.vmi.vcvt %source {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<4xf32, #pto.vmi.layout<num_groups = 4, slots = 1>>
        -> !pto.vmi.vreg<4xbf16, #pto.vmi.layout<num_groups = 4, slots = 1>>
    %p0, %p1, %p2, %p3 = "pto.vmi.unpack"(%narrow)
        : (!pto.vmi.vreg<4xbf16, #pto.vmi.layout<num_groups = 4, slots = 1>>)
        -> (!pto.vreg<128xbf16>, !pto.vreg<128xbf16>, !pto.vreg<128xbf16>,
            !pto.vreg<128xbf16>)
    return %p0, %p1, %p2, %p3
        : !pto.vreg<128xbf16>, !pto.vreg<128xbf16>, !pto.vreg<128xbf16>,
          !pto.vreg<128xbf16>
  }

  func.func @group_reduce_result_8_slots8(
      %source: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>)
      -> !pto.vreg<128xbf16> {
    %narrow = pto.vmi.vcvt %source {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xbf16,
            #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
    %part = "pto.vmi.unpack"(%narrow)
        : (!pto.vmi.vreg<8xbf16,
            #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>)
        -> !pto.vreg<128xbf16>
    return %part : !pto.vreg<128xbf16>
  }
}

// CHECK-LABEL: func.func @group_reduce_result_2_slots1
// CHECK: pto.vdup
// CHECK: pto.vbitcast
// CHECK-COUNT-2: pto.vdintlv
// CHECK-NOT: pto.vcvt
// CHECK: return

// CHECK-LABEL: func.func @group_reduce_result_4_slots1
// CHECK: pto.vdup
// CHECK: pto.vbitcast
// CHECK-COUNT-4: pto.vdintlv
// CHECK-NOT: pto.vcvt
// CHECK: return

// CHECK-LABEL: func.func @group_reduce_result_8_slots8
// CHECK: pto.vdup
// CHECK: pto.vbitcast
// CHECK-COUNT-1: pto.vdintlv
// CHECK-NOT: pto.vcvt
// CHECK: return
