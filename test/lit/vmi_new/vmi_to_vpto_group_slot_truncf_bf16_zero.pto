// RUN: pto-test-opt %s -vmi-set-fastmath=vmi-fastmath=true -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s
// RUN: pto-test-opt %s -vmi-set-fastmath=vmi-fastmath=false -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s --check-prefix=STRICT

// A reduction result has only 2/4/8 logical lanes, but each group-slot result
// still occupies one physical 64xf32 -> 128xbf16 pair. Matching group-slot
// layouts, including slots=8, use the zero-paired vdintlv fast path.

module {
  func.func @group_reduce_result_2_slots1(
      %source: !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>>)
      -> (!pto.vreg<128xbf16>, !pto.vreg<128xbf16>) {
    %narrow = pto.vmi.vcvt %source {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>>
        -> !pto.vmi.vreg<2xbf16, #pto.vmi.layout<num_groups = 2, slots = 1>>
    %p0, %p1 = "pto.vmi.unpack"(%narrow)
        : (!pto.vmi.vreg<2xbf16, #pto.vmi.layout<num_groups = 2, slots = 1>>)
        -> (!pto.vreg<128xbf16>, !pto.vreg<128xbf16>)
    return %p0, %p1 : !pto.vreg<128xbf16>, !pto.vreg<128xbf16>
  }

  func.func @group_reduce_result_2_slots1_sat(
      %source: !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>>)
      -> (!pto.vreg<128xbf16>, !pto.vreg<128xbf16>) {
    %narrow = pto.vmi.vcvt %source {rounding = "Z", saturate = "SAT"}
        : !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>>
        -> !pto.vmi.vreg<2xbf16, #pto.vmi.layout<num_groups = 2, slots = 1>>
    %p0, %p1 = "pto.vmi.unpack"(%narrow)
        : (!pto.vmi.vreg<2xbf16, #pto.vmi.layout<num_groups = 2, slots = 1>>)
        -> (!pto.vreg<128xbf16>, !pto.vreg<128xbf16>)
    return %p0, %p1 : !pto.vreg<128xbf16>, !pto.vreg<128xbf16>
  }

  func.func @group_reduce_result_4_slots1(
      %source: !pto.vmi.vreg<4xf32, #pto.vmi.layout<num_groups = 4, slots = 1>>)
      -> (!pto.vreg<128xbf16>, !pto.vreg<128xbf16>, !pto.vreg<128xbf16>,
          !pto.vreg<128xbf16>) {
    %narrow = pto.vmi.vcvt %source {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<4xf32, #pto.vmi.layout<num_groups = 4, slots = 1>>
        -> !pto.vmi.vreg<4xbf16, #pto.vmi.layout<num_groups = 4, slots = 1>>
    %p0, %p1, %p2, %p3 = "pto.vmi.unpack"(%narrow)
        : (!pto.vmi.vreg<4xbf16, #pto.vmi.layout<num_groups = 4, slots = 1>>)
        -> (!pto.vreg<128xbf16>, !pto.vreg<128xbf16>, !pto.vreg<128xbf16>,
            !pto.vreg<128xbf16>)
    return %p0, %p1, %p2, %p3
        : !pto.vreg<128xbf16>, !pto.vreg<128xbf16>, !pto.vreg<128xbf16>,
          !pto.vreg<128xbf16>
  }

  func.func @group_reduce_result_8_slots8_stride_mismatch(
      %source: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>)
      -> !pto.vreg<128xbf16> {
    %narrow = pto.vmi.vcvt %source {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xbf16,
            #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
    %part = "pto.vmi.unpack"(%narrow)
        : (!pto.vmi.vreg<8xbf16,
            #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>)
        -> !pto.vreg<128xbf16>
    return %part : !pto.vreg<128xbf16>
  }

  func.func @group_reduce_result_8_slots8_stride2(
      %source: !pto.vmi.vreg<8xf32,
          #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>)
      -> !pto.vreg<128xbf16> {
    %narrow = pto.vmi.vcvt %source {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<8xf32,
            #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
        -> !pto.vmi.vreg<8xbf16,
            #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
    %part = "pto.vmi.unpack"(%narrow)
        : (!pto.vmi.vreg<8xbf16,
            #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>)
        -> !pto.vreg<128xbf16>
    return %part : !pto.vreg<128xbf16>
  }

  func.func @group_reduce_result_8_slots8_stride1(
      %source: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>)
      -> !pto.vreg<128xbf16> {
    %narrow = pto.vmi.vcvt %source {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xbf16, #pto.vmi.layout<num_groups = 8, slots = 8>>
    %part = "pto.vmi.unpack"(%narrow)
        : (!pto.vmi.vreg<8xbf16, #pto.vmi.layout<num_groups = 8, slots = 8>>)
        -> !pto.vreg<128xbf16>
    return %part : !pto.vreg<128xbf16>
  }
}

// CHECK-LABEL: func.func @group_reduce_result_2_slots1
// CHECK: pto.vdup
// CHECK: pto.vbitcast
// CHECK-COUNT-2: pto.vdintlv
// CHECK-NOT: pto.vcvt
// CHECK: return
// CHECK-LABEL: func.func @group_reduce_result_2_slots1_sat
// CHECK: pto.vcvt
// CHECK-NOT: pto.vdintlv

// STRICT-LABEL: func.func @group_reduce_result_2_slots1(
// STRICT: pto.vcvt
// STRICT-NOT: pto.vdintlv
// STRICT-LABEL: func.func @group_reduce_result_2_slots1_sat(
// STRICT: pto.vcvt
// STRICT-NOT: pto.vdintlv
// STRICT-LABEL: func.func @group_reduce_result_4_slots1(
// STRICT: pto.vcvt
// STRICT-NOT: pto.vdintlv
// STRICT-LABEL: func.func @group_reduce_result_8_slots8_stride2(
// STRICT: pto.vcvt
// STRICT-NOT: pto.vdintlv

// CHECK-LABEL: func.func @group_reduce_result_4_slots1
// CHECK: pto.vdup
// CHECK: pto.vbitcast
// CHECK-COUNT-4: pto.vdintlv
// CHECK-NOT: pto.vcvt
// CHECK: return

// CHECK-LABEL: func.func @group_reduce_result_8_slots8_stride_mismatch
// CHECK: pto.vcvt
// CHECK-SAME: {part = "EVEN", rnd = "Z", sat = "NOSAT"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<128xbf16>
// CHECK-NOT: pto.vdintlv
// CHECK: return

// CHECK-LABEL: func.func @group_reduce_result_8_slots8_stride2
// CHECK: pto.vdup
// CHECK: pto.vbitcast
// CHECK-COUNT-1: pto.vdintlv
// CHECK-NOT: pto.vcvt
// CHECK: return

// CHECK-LABEL: func.func @group_reduce_result_8_slots8_stride1
// CHECK: pto.vdup
// CHECK: pto.vbitcast
// CHECK-COUNT-1: pto.vdintlv
// CHECK-NOT: pto.vcvt
// CHECK: return
