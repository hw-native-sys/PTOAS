// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s

module {
  func.func @vmi_to_vpto_reduce_minf(
      %source: !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<128xf16> {
    %out = pto.vmi.vcmin %source, %mask
        : !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xf16, #pto.vmi.layout<contiguous>>
    %part = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<1xf16, #pto.vmi.layout<contiguous>>)
        -> !pto.vreg<128xf16>
    return %part : !pto.vreg<128xf16>
  }
}

// CHECK-LABEL: func.func @vmi_to_vpto_reduce_minf(
// CHECK: %[[FIRST:.*]] = pto.pset_b16 "PAT_VL1" : !pto.mask<b16>
// CHECK: %[[REDUCED:.*]] = pto.vcmin %arg0, %arg1 : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
// CHECK: %[[OUT:.*]] = pto.vmin %[[REDUCED]], {{.*}}, %[[FIRST]] : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
// CHECK: return %[[OUT]]
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast
