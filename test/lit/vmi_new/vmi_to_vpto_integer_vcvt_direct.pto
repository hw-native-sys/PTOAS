// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy | FileCheck %s --check-prefix=UNIFIED
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s --check-prefix=LOWER --implicit-check-not=pto.vmi. --implicit-check-not='!pto.vmi.' --implicit-check-not=unrealized_conversion_cast

module {
  func.func @si16_to_ui32_masked(
      %src: !pto.vmi.vreg<128xsi16, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>>)
      -> (!pto.vreg<64xui32>, !pto.vreg<64xui32>) {
    %wide = pto.vmi.vcvt %src, %mask
        : !pto.vmi.vreg<128xsi16, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xui32, #pto.vmi.layout<deinterleaved = 2>>
    %even, %odd = "pto.vmi.unpack"(%wide)
        : (!pto.vmi.vreg<128xui32, #pto.vmi.layout<deinterleaved = 2>>)
        -> (!pto.vreg<64xui32>, !pto.vreg<64xui32>)
    return %even, %odd : !pto.vreg<64xui32>, !pto.vreg<64xui32>
  }

  func.func @ui32_to_si16_saturated(
      %src: !pto.vmi.vreg<128xui32, #pto.vmi.layout<deinterleaved = 2>>,
      %mask: !pto.vmi.mask<128xb32, #pto.vmi.layout<deinterleaved = 2>>)
      -> !pto.vreg<128xsi16> {
    %narrow = pto.vmi.vcvt %src, %mask {saturate = "SAT"}
        : !pto.vmi.vreg<128xui32, #pto.vmi.layout<deinterleaved = 2>>,
          !pto.vmi.mask<128xb32, #pto.vmi.layout<deinterleaved = 2>>
        -> !pto.vmi.vreg<128xsi16, #pto.vmi.layout<contiguous>>
    %result = "pto.vmi.unpack"(%narrow)
        : (!pto.vmi.vreg<128xsi16, #pto.vmi.layout<contiguous>>)
        -> !pto.vreg<128xsi16>
    return %result : !pto.vreg<128xsi16>
  }
}

// Small integer vcvt must remain unified until VMI-to-VPTO sees its exact
// source/result pair.
// UNIFIED-LABEL: func.func @si16_to_ui32_masked(
// UNIFIED: pto.vmi.vcvt %{{.*}}, %{{.*}}
// UNIFIED-NOT: pto.vmi.extsi
// UNIFIED-NOT: pto.vmi.extui
// UNIFIED-LABEL: func.func @ui32_to_si16_saturated(
// UNIFIED: pto.vmi.vcvt %{{.*}}, %{{.*}} {saturate = "SAT"}
// UNIFIED-NOT: pto.vmi.trunci

// VCVTII.s16->u32 keeps both type signs. Its predicate gates the source lanes,
// and negative values are clamped to zero by the instruction semantics.
// LOWER-LABEL: func.func @si16_to_ui32_masked(
// LOWER-SAME: %[[SRC:[^:]+]]: !pto.vreg<128xsi16>, %[[MASK:[^:]+]]: !pto.mask<b16>
// LOWER: pto.vcvt %[[SRC]], %[[MASK]] {part = "EVEN"} : !pto.vreg<128xsi16>, !pto.mask<b16> -> !pto.vreg<64xui32>
// LOWER: pto.vcvt %[[SRC]], %[[MASK]] {part = "ODD"} : !pto.vreg<128xsi16>, !pto.mask<b16> -> !pto.vreg<64xui32>

// VCVTII.u32->s16 uses the native saturating narrowing pair and preserves the
// signed destination type.
// LOWER-LABEL: func.func @ui32_to_si16_saturated(
// LOWER: pto.vcvt {{.*}} {part = "EVEN", sat = "SAT"} : !pto.vreg<64xui32>, !pto.mask<b32> -> !pto.vreg<128xsi16>
// LOWER: pto.vcvt {{.*}} {part = "ODD", sat = "SAT"} : !pto.vreg<64xui32>, !pto.mask<b32> -> !pto.vreg<128xsi16>
