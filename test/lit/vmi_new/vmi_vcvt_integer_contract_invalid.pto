// RUN: pto-test-opt %s -split-input-file -verify-diagnostics

module {
  func.func @ui16_to_si32_is_not_a_vcvtii_pair(%src: !pto.vmi.vreg<128xui16>) {
    // expected-error@+1 {{unsupported integer vcvt source/result element type pair or saturate mode}}
    %result = pto.vmi.vcvt %src : !pto.vmi.vreg<128xui16> -> !pto.vmi.vreg<128xsi32>
    return
  }
}

// -----

module {
  func.func @ui16_to_si8_cannot_saturate(%src: !pto.vmi.vreg<128xui16>) {
    // expected-error@+1 {{integer narrowing to a signed 8-bit destination from a wider integer source only supports saturate="NOSAT"}}
    %result = pto.vmi.vcvt %src {saturate = "SAT"}
        : !pto.vmi.vreg<128xui16> -> !pto.vmi.vreg<128xsi8>
    return
  }
}
