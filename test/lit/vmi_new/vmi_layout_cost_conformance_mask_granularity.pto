// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance | FileCheck %s
// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance -vmi-to-vpto -test-vmi-layout-lowering-conformance > /dev/null

module {
  func.func @c_widen(%m: !pto.vmi.mask<64xb8, #pto.vmi.layout<contiguous>>) -> !pto.vmi.mask<64xb16, #pto.vmi.layout<deinterleaved = 2>> {
    %r = pto.vmi.ensure_mask_granularity %m {test.vmi_layout_cost_conformance} : !pto.vmi.mask<64xb8, #pto.vmi.layout<contiguous>> -> !pto.vmi.mask<64xb16, #pto.vmi.layout<deinterleaved = 2>>
