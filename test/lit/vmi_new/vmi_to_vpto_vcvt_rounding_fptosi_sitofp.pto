// RUN: not pto-test-opt %s -vmi-layout-assignment -vmi-lower-unified-to-legacy -vmi-to-vpto 2>&1 | FileCheck %s

module {
  func.func @rounding(%fp: !pto.vmi.vreg<64xf32>,
                      %si: !pto.vmi.vreg<64xsi32>) {
    %to_i = pto.vmi.vcvt %fp {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xsi32>
    %to_f = pto.vmi.vcvt %si {rounding = "A"}
        : !pto.vmi.vreg<64xsi32> -> !pto.vmi.vreg<64xf32>
    return
  }
}

// CHECK: 'pto.vmi.vcvt' op 'rounding' attribute is only valid for floating-point narrowing or floating-point-to-integer conversions
