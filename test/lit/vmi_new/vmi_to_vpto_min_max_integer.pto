// RUN: pto-test-opt %s -pto-vmi-normalize-signless-int-to-unsigned -vmi-lower-unified-to-legacy | FileCheck %s --check-prefix=LEGACY
// RUN: pto-test-opt %s -pto-vmi-normalize-signless-int-to-unsigned -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

module {
  func.func @vmi_to_vpto_min_max_integer(
      %lhs: !pto.vmi.vreg<64xi32>,
      %rhs: !pto.vmi.vreg<64xi32>)
      -> (!pto.vmi.vreg<64xi32>, !pto.vmi.vreg<64xi32>) {
    %min = pto.vmi.vmin %lhs, %rhs
        : !pto.vmi.vreg<64xi32>, !pto.vmi.vreg<64xi32>
        -> !pto.vmi.vreg<64xi32>
    %max = pto.vmi.vmax %lhs, %rhs
        : !pto.vmi.vreg<64xi32>, !pto.vmi.vreg<64xi32>
        -> !pto.vmi.vreg<64xi32>
    return %min, %max : !pto.vmi.vreg<64xi32>, !pto.vmi.vreg<64xi32>
  }
}

// LEGACY-LABEL: func.func @vmi_to_vpto_min_max_integer(
// LEGACY: %[[MIN:.*]] = pto.vmi.mini {{.*}} -> !pto.vmi.vreg<64xui32>
// LEGACY: %[[MAX:.*]] = pto.vmi.maxi {{.*}} -> !pto.vmi.vreg<64xui32>
// LEGACY-NOT: pto.vmi.vmin
// LEGACY-NOT: pto.vmi.vmax

// LOWER-LABEL: func.func @vmi_to_vpto_min_max_integer(
// LOWER: %[[MIN:.*]] = pto.vmin {{.*}} -> !pto.vreg<64xui32>
// LOWER: %[[MAX:.*]] = pto.vmax {{.*}} -> !pto.vreg<64xui32>
// LOWER-NOT: pto.vmi.
// LOWER-NOT: !pto.vmi.
// LOWER-NOT: unrealized_conversion_cast
