// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-pre-assignment-combine | FileCheck %s

module {
  func.func @multiple_scalar_uses(%src: !pto.ptr<f32, ub>, %off: index)
      -> (!pto.vmi.vreg<64xf32>, f32) {
    %scalar = pto.load %src[%off] : !pto.ptr<f32, ub>, index -> f32
    %broadcast = pto.vmi.vbrc %scalar : f32 -> !pto.vmi.vreg<64xf32>
    %sum = arith.addf %scalar, %scalar : f32
    return %broadcast, %sum : !pto.vmi.vreg<64xf32>, f32
  }

  func.func @intervening_store(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32> {
    %zero = arith.constant 0.0 : f32
    %scalar = pto.load %src[%off] : !pto.ptr<f32, ub>, index -> f32
    pto.store %zero, %src[%off] : !pto.ptr<f32, ub>, index, f32
    %broadcast = pto.vmi.vbrc %scalar : f32 -> !pto.vmi.vreg<64xf32>
    return %broadcast : !pto.vmi.vreg<64xf32>
  }

  func.func @non_ub_load(%src: !pto.ptr<f32, gm>, %off: index)
      -> !pto.vmi.vreg<64xf32> {
    %scalar = pto.load %src[%off] : !pto.ptr<f32, gm>, index -> f32
    %broadcast = pto.vmi.vbrc %scalar : f32 -> !pto.vmi.vreg<64xf32>
    return %broadcast : !pto.vmi.vreg<64xf32>
  }

  func.func @vmi_load_with_intervening_store(
      %src: !pto.ptr<f32, ub>, %off: index) -> !pto.vmi.vreg<64xf32> {
    %scalar = pto.vmi.vload %src[%off]
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<1xf32>
    %zero = arith.constant 0.0 : f32
    pto.store %zero, %src[%off] : !pto.ptr<f32, ub>, index, f32
    %broadcast = pto.vmi.vbrc %scalar
        : !pto.vmi.vreg<1xf32> -> !pto.vmi.vreg<64xf32>
    return %broadcast : !pto.vmi.vreg<64xf32>
  }

  func.func @scalar_load_with_noalias_store(%off: index)
      -> !pto.vmi.vreg<64xf32> {
    %src = memref.alloc() : memref<64xf32, #pto.address_space<vec>>
    %dst = memref.alloc() : memref<64xf32, #pto.address_space<vec>>
    %scalar = pto.load %src[%off]
        : memref<64xf32, #pto.address_space<vec>>, index -> f32
    %zero = arith.constant 0.0 : f32
    pto.store %zero, %dst[%off]
        : memref<64xf32, #pto.address_space<vec>>, index, f32
    %broadcast = pto.vmi.vbrc %scalar : f32 -> !pto.vmi.vreg<64xf32>
    return %broadcast : !pto.vmi.vreg<64xf32>
  }

  func.func @vmi_load_with_noalias_store(%off: index)
      -> !pto.vmi.vreg<64xf32> {
    %src = memref.alloc() : memref<64xf32, #pto.address_space<vec>>
    %dst = memref.alloc() : memref<64xf32, #pto.address_space<vec>>
    %scalar = pto.vmi.vload %src[%off]
        : memref<64xf32, #pto.address_space<vec>>
        -> !pto.vmi.vreg<1xf32>
    %zero = arith.constant 0.0 : f32
    pto.store %zero, %dst[%off]
        : memref<64xf32, #pto.address_space<vec>>, index, f32
    %broadcast = pto.vmi.vbrc %scalar
        : !pto.vmi.vreg<1xf32> -> !pto.vmi.vreg<64xf32>
    return %broadcast : !pto.vmi.vreg<64xf32>
  }
}

// CHECK-LABEL: func.func @multiple_scalar_uses
// CHECK: pto.load
// CHECK: pto.vmi.broadcast

// CHECK-LABEL: func.func @intervening_store
// CHECK: pto.load
// CHECK: pto.store
// CHECK: pto.vmi.broadcast

// CHECK-LABEL: func.func @non_ub_load
// CHECK: pto.load
// CHECK: pto.vmi.broadcast

// CHECK-LABEL: func.func @vmi_load_with_intervening_store
// CHECK: pto.vmi.load
// CHECK: pto.store
// CHECK: pto.vmi.broadcast

// CHECK-LABEL: func.func @scalar_load_with_noalias_store
// CHECK-NOT: pto.load
// CHECK: pto.store
// CHECK: pto.vmi.group_broadcast_load
// CHECK-NOT: pto.vmi.broadcast

// CHECK-LABEL: func.func @vmi_load_with_noalias_store
// CHECK-NOT: pto.vmi.load
// CHECK: pto.store
// CHECK: pto.vmi.group_broadcast_load
// CHECK-NOT: pto.vmi.broadcast
