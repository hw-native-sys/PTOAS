// RUN: not pto-test-opt %s -test-vmi-layout-cost-conformance 2>&1 | FileCheck %s --check-prefix=COST
// RUN: not pto-test-opt %s -vmi-to-vpto 2>&1 | FileCheck %s --check-prefix=LOWER

module {
  func.func @vexpdif_merge(
      %x: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
      %max: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>> {
    %result = pto.vmi.vexpdif %x, %max, %mask {
      pmode = "merge", test.vmi_layout_cost_conformance
    } : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
        !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
        !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return %result : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
  }
}

// COST: error: test layout-cost conformance marker has no exposed relation
// LOWER: failed to apply conversion patterns
