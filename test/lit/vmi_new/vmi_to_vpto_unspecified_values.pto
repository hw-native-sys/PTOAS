// RUN: pto-test-opt %s -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s

module {
  func.func @vmi_to_vpto_unspecified_values(
      %f32_destination: !pto.ptr<f32, ub>,
      %f16_destination: !pto.ptr<f16, ub>,
      %i32_destination: !pto.ptr<i32, ub>, %offset: index) {
    %physical_value = pto.unspecified_value : !pto.vreg<64xi32>
    %physical_mask = pto.unspecified_value : !pto.mask<b32>
    %f32_value = pto.unspecified_value : !pto.vmi.vreg<64xf32>
    %f16_value = pto.unspecified_value : !pto.vmi.vreg<64xf16>
    %mask = pto.unspecified_value : !pto.vmi.mask<64xpred>
    %c64 = arith.constant 64 : index
    %aligned_offset = arith.muli %offset, %c64 : index
    pto.vmi.vstore %f32_value, %f32_destination[%aligned_offset], %mask
        : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.vmi.mask<64xpred>
    pto.vmi.vstore %f16_value, %f16_destination[%aligned_offset], %mask
        : !pto.vmi.vreg<64xf16>, !pto.ptr<f16, ub>, index, !pto.vmi.mask<64xpred>
    pto.vsts %physical_value, %i32_destination[%aligned_offset], %physical_mask
        : !pto.vreg<64xi32>, !pto.ptr<i32, ub>, index, !pto.mask<b32>
    return
  }
}

// CHECK-LABEL: func.func @vmi_to_vpto_unspecified_values(
// CHECK-DAG: pto.unspecified_value : !pto.vreg<64xi32>
// CHECK-DAG: pto.unspecified_value : !pto.mask<b32>
// CHECK-DAG: pto.unspecified_value : !pto.vreg<64xf32>
// CHECK-DAG: pto.unspecified_value : !pto.vreg<128xf16>
// CHECK-DAG: pto.unspecified_value : !pto.mask<b32>
// CHECK-DAG: pto.unspecified_value : !pto.mask<b16>
// CHECK-DAG: pto.vsts
// CHECK-DAG: pto.vsts
// CHECK: pto.vsts {{.*}} : !pto.vreg<64xi32>, !pto.ptr<i32, ub>, index, !pto.mask<b32>
// CHECK-NOT: pto.vmi.
