// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s --implicit-check-not=pto.vmi. --implicit-check-not='!pto.vmi.'
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=LAYOUT

// A short bf16 read widened into a short f32 store must take the same
// single-carrier group-slot plan as the f16 extend: the preferred BF16/F32
// short-vector pair names a gs(8) source, so layout assignment has to request
// that source and materialize a contiguous -> gs(8) ensure_layout.  When it
// only seeds the result, the extf keeps a contiguous source and no legal cast
// row matches, which fails the VMI-LAYOUT-CONTRACT check.  The same holds when
// the narrow side carries elementwise compute (the group-slot carrier is a
// single physical part, so the narrow-side-compute contiguous anchor is not
// needed and must not override the group-slot pair).

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @bf16_extend_store_f32_L1(%src: !pto.ptr<bf16, ub>, %dst: !pto.ptr<f32, ub>, %off: index) attributes {pto.kernel} {
    %c16 = arith.constant 16 : index
    %aoff = arith.muli %off, %c16 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%aoff] : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<1xbf16>
      %w = pto.vmi.vcvt %s : !pto.vmi.vreg<1xbf16> -> !pto.vmi.vreg<1xf32>
      pto.vmi.vstore %w, %dst[%aoff] : !pto.vmi.vreg<1xf32>, !pto.ptr<f32, ub>
    }
    return
  }
  func.func @bf16_extend_store_f32_L2(%src: !pto.ptr<bf16, ub>, %dst: !pto.ptr<f32, ub>, %off: index) attributes {pto.kernel} {
    %c16 = arith.constant 16 : index
    %aoff = arith.muli %off, %c16 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%aoff] : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<2xbf16>
      %w = pto.vmi.vcvt %s : !pto.vmi.vreg<2xbf16> -> !pto.vmi.vreg<2xf32>
      pto.vmi.vstore %w, %dst[%aoff] : !pto.vmi.vreg<2xf32>, !pto.ptr<f32, ub>
    }
    return
  }
  func.func @bf16_extend_store_f32_L4(%src: !pto.ptr<bf16, ub>, %dst: !pto.ptr<f32, ub>, %off: index) attributes {pto.kernel} {
    %c16 = arith.constant 16 : index
    %aoff = arith.muli %off, %c16 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%aoff] : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<4xbf16>
      %w = pto.vmi.vcvt %s : !pto.vmi.vreg<4xbf16> -> !pto.vmi.vreg<4xf32>
      pto.vmi.vstore %w, %dst[%aoff] : !pto.vmi.vreg<4xf32>, !pto.ptr<f32, ub>
    }
    return
  }
  func.func @bf16_extend_store_f32_L8(%src: !pto.ptr<bf16, ub>, %dst: !pto.ptr<f32, ub>, %off: index) attributes {pto.kernel} {
    %c16 = arith.constant 16 : index
    %aoff = arith.muli %off, %c16 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%aoff] : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<8xbf16>
      %w = pto.vmi.vcvt %s : !pto.vmi.vreg<8xbf16> -> !pto.vmi.vreg<8xf32>
      pto.vmi.vstore %w, %dst[%aoff] : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    }
    return
  }
  func.func @bf16_extend_store_f32_mul_L2(%src: !pto.ptr<bf16, ub>, %dst: !pto.ptr<f32, ub>, %off: index) attributes {pto.kernel} {
    %c16 = arith.constant 16 : index
    %aoff = arith.muli %off, %c16 : index
    pto.vecscope {
      %v = pto.vmi.vload %src[%aoff] : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<2xbf16>
      %a = pto.vmi.vmul %v, %v
          : !pto.vmi.vreg<2xbf16>, !pto.vmi.vreg<2xbf16>
          -> !pto.vmi.vreg<2xbf16>
      %w = pto.vmi.vcvt %a : !pto.vmi.vreg<2xbf16> -> !pto.vmi.vreg<2xf32>
      pto.vmi.vstore %w, %dst[%aoff] : !pto.vmi.vreg<2xf32>, !pto.ptr<f32, ub>
    }
    return
  }
  func.func @bf16_extend_store_f32_mul_L4(%src: !pto.ptr<bf16, ub>, %dst: !pto.ptr<f32, ub>, %off: index) attributes {pto.kernel} {
    %c16 = arith.constant 16 : index
    %aoff = arith.muli %off, %c16 : index
    pto.vecscope {
      %v = pto.vmi.vload %src[%aoff] : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<4xbf16>
      %a = pto.vmi.vmul %v, %v
          : !pto.vmi.vreg<4xbf16>, !pto.vmi.vreg<4xbf16>
          -> !pto.vmi.vreg<4xbf16>
      %w = pto.vmi.vcvt %a : !pto.vmi.vreg<4xbf16> -> !pto.vmi.vreg<4xf32>
      pto.vmi.vstore %w, %dst[%aoff] : !pto.vmi.vreg<4xf32>, !pto.ptr<f32, ub>
    }
    return
  }
  func.func @bf16_extend_store_f32_mul_L8(%src: !pto.ptr<bf16, ub>, %dst: !pto.ptr<f32, ub>, %off: index) attributes {pto.kernel} {
    %c16 = arith.constant 16 : index
    %aoff = arith.muli %off, %c16 : index
    pto.vecscope {
      %v = pto.vmi.vload %src[%aoff] : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<8xbf16>
      %a = pto.vmi.vmul %v, %v
          : !pto.vmi.vreg<8xbf16>, !pto.vmi.vreg<8xbf16>
          -> !pto.vmi.vreg<8xbf16>
      %w = pto.vmi.vcvt %a : !pto.vmi.vreg<8xbf16> -> !pto.vmi.vreg<8xf32>
      pto.vmi.vstore %w, %dst[%aoff] : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    }
    return
  }
}

// CHECK-LABEL: func.func @bf16_extend_store_f32_L1(
// CHECK: pto.vsts
// CHECK-LABEL: func.func @bf16_extend_store_f32_L2(
// CHECK: pto.vsts
// CHECK-LABEL: func.func @bf16_extend_store_f32_L4(
// CHECK: pto.vsts
// CHECK-LABEL: func.func @bf16_extend_store_f32_L8(
// CHECK: pto.vsts
// CHECK-LABEL: func.func @bf16_extend_store_f32_mul_L2(
// CHECK: pto.vsts
// CHECK-LABEL: func.func @bf16_extend_store_f32_mul_L4(
// CHECK: pto.vsts
// CHECK-LABEL: func.func @bf16_extend_store_f32_mul_L8(
// CHECK: pto.vsts

// The assigned layouts, not only a successful compile: the short widen takes
// the single-carrier group-slot plan, with and without narrow-side compute.
// LAYOUT-LABEL: func.func @bf16_extend_store_f32_L8(
// LAYOUT: pto.vmi.ensure_layout {{.*}} -> !pto.vmi.vreg<8xbf16, #pto.vmi.layout<num_groups = 8, slots = 8>>
// LAYOUT: pto.vmi.extf {{.*}} : !pto.vmi.vreg<8xbf16, #pto.vmi.layout<num_groups = 8, slots = 8>> -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// LAYOUT: pto.vmi.group_store
// LAYOUT-LABEL: func.func @bf16_extend_store_f32_mul_L8(
// LAYOUT: pto.vmi.vmul {{.*}} : !pto.vmi.vreg<8xbf16, #pto.vmi.layout<num_groups = 8, slots = 8>>
// LAYOUT: pto.vmi.extf {{.*}} -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// LAYOUT: pto.vmi.group_store

