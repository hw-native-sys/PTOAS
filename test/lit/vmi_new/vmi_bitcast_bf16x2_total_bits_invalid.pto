// RUN: not ptoas --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func @bf16x2_total_bits_mismatch(
      %value: !pto.vmi.vreg<64x!pto.bf16x2>) {
    %cast = pto.vmi.vinterpret_cast %value
        : !pto.vmi.vreg<64x!pto.bf16x2> -> !pto.vmi.vreg<64xbf16>
    return
  }
}

// CHECK: 'pto.vmi.vinterpret_cast' op requires source and result to carry the same total number of bits
