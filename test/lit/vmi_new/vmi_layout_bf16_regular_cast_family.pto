// The regular-layout product is independent of a particular kernel or spine.
// RUN: pto-test-opt %s -vmi-set-fastmath=vmi-fastmath=true -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN --implicit-check-not=pto.vmi.ensure_layout
// RUN: pto-test-opt %s -vmi-set-fastmath=vmi-fastmath=true -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER --implicit-check-not=pto.vmi.
module {
// ASSIGN-LABEL: @cast_1_1_1(
// ASSIGN: pto.vmi.extf
// ASSIGN-SAME: -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
// ASSIGN: pto.vmi.truncf
// ASSIGN-SAME: -> !pto.vmi.vreg<1xbf16, #pto.vmi.layout<contiguous>>
// LOWER-LABEL: @cast_1_1_1(
// LOWER: pto.vintlv
// LOWER: pto.vdintlv
func.func @cast_1_1_1(%x: !pto.vmi.vreg<1xbf16, #pto.vmi.layout<contiguous>>) -> !pto.vmi.vreg<1xbf16, #pto.vmi.layout<contiguous>> {
  %w = pto.vmi.extf %x : !pto.vmi.vreg<1xbf16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
  %r = pto.vmi.truncf %w {rounding = "Z", saturate = "NOSAT"} : !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<1xbf16, #pto.vmi.layout<contiguous>>
  return %r : !pto.vmi.vreg<1xbf16, #pto.vmi.layout<contiguous>>
}
