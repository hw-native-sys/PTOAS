// A one-chunk-per-part dense D2 narrowing requires the same state as dense C.
// RUN: not pto-test-opt %s -vmi-set-fastmath=vmi-fastmath=false -vmi-layout-assignment 2>&1 | FileCheck %s
// RUN: not pto-test-opt %s -vmi-set-fastmath=vmi-fastmath=false -vmi-to-vpto 2>&1 | FileCheck %s --check-prefix=LOWER
// RUN: sed -e 's/128x/256x/g' -e 's/deinterleaved = 2/deinterleaved = 4/g' %s | not pto-test-opt -vmi-set-fastmath=vmi-fastmath=false -vmi-to-vpto 2>&1 | FileCheck %s --check-prefix=LOWER
// RUN: sed -e 's/128x/64x/g' -e 's/deinterleaved = 2/deinterleaved = 4, lane_stride = 2/g' %s | not pto-test-opt -vmi-set-fastmath=vmi-fastmath=false -vmi-to-vpto 2>&1 | FileCheck %s --check-prefix=LOWER
// CHECK: dense same-layout BF16 narrowing
// CHECK-SAME: NaN-relaxed fastmath
// LOWER: dense same-layout BF16 narrowing relation

module {
  func.func @strict_d2(%x: !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>) -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<deinterleaved = 2>> {
    %y = pto.vmi.truncf %x {rounding = "Z", saturate = "NOSAT"} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<deinterleaved = 2>>
    return %y : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<deinterleaved = 2>>
  }
}
