// RUN: not pto-test-opt %s -split-input-file -vmi-lower-unified-to-legacy -vmi-to-vpto 2>&1 | FileCheck %s

module {
  func.func @vmi_load_strided_memref_unsupported(
      %src: memref<128xf32, strided<[2], offset: 0>, #pto.address_space<vec>>) {
    %c0 = arith.constant 0 : index
    %value = pto.vmi.vload %src[%c0]
        : memref<128xf32, strided<[2], offset: 0>, #pto.address_space<vec>>, index
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: pto.vmi.load direct lowering requires a supported memory source

// -----

module {
  func.func @vmi_load_memref_subview_unsupported(%src: memref<128xf32, #pto.address_space<vec>>) {
    %c0 = arith.constant 0 : index
    %view = memref.subview %src[%c0] [64] [1]
        : memref<128xf32, #pto.address_space<vec>> to memref<64xf32, strided<[1], offset: ?>, #pto.address_space<vec>>
    %value = pto.vmi.vload %view[%c0]
        : memref<64xf32, strided<[1], offset: ?>, #pto.address_space<vec>>, index
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: pto.vmi.load direct lowering requires a supported memory source

// -----

module {
  func.func @vmi_masked_load_strided_memref_unsupported(
      %src: memref<128xf32, strided<[2], offset: 0>, #pto.address_space<vec>>,
      %mask: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>,
      %passthru: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>) {
    %c0 = arith.constant 0 : index
    %value = pto.vmi.masked_load %src[%c0], %mask, %passthru
        : memref<128xf32, strided<[2], offset: 0>, #pto.address_space<vec>>,
          index, !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: pto.vmi.masked_load direct lowering requires a supported memory source

// -----

module {
  func.func @vmi_expand_load_strided_memref_unsupported(
      %src: memref<128xf32, strided<[2], offset: 0>, #pto.address_space<vec>>,
      %mask: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>,
      %passthru: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>) {
    %c0 = arith.constant 0 : index
    %value = pto.vmi.expand_load %src[%c0], %mask, %passthru
        : memref<128xf32, strided<[2], offset: 0>, #pto.address_space<vec>>,
          index, !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: pto.vmi.expand_load direct lowering is currently supported

// -----

module {
  func.func @vmi_store_strided_memref_unsupported(
      %value: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
      %dst: memref<128xf32, strided<[2], offset: 0>, #pto.address_space<vec>>) {
    %c0 = arith.constant 0 : index
    pto.vmi.vstore %value, %dst[%c0]
        : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
          memref<128xf32, strided<[2], offset: 0>, #pto.address_space<vec>>, index
    return
  }
}

// CHECK: pto.vmi.store requires an 8/16/32-bit predicate-maskable element type

// -----

module {
  func.func @vmi_store_memref_subview_unsupported(
      %value: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
      %dst: memref<128xf32, #pto.address_space<vec>>) {
    %c0 = arith.constant 0 : index
    %view = memref.subview %dst[%c0] [64] [1]
        : memref<128xf32, #pto.address_space<vec>> to memref<64xf32, strided<[1], offset: ?>, #pto.address_space<vec>>
    pto.vmi.vstore %value, %view[%c0]
        : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
          memref<64xf32, strided<[1], offset: ?>, #pto.address_space<vec>>, index
    return
  }
}

// CHECK: pto.vmi.store requires an 8/16/32-bit predicate-maskable element type

// -----

module {
  func.func @vmi_masked_store_strided_memref_unsupported(
      %value: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>,
      %dst: memref<128xf32, strided<[2], offset: 0>, #pto.address_space<vec>>) {
    %c0 = arith.constant 0 : index
    pto.vmi.vstore %value, %dst[%c0], %mask
        : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
          memref<128xf32, strided<[2], offset: 0>, #pto.address_space<vec>>,
          index, !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: pto.vmi.masked_store requires either full physical chunks
