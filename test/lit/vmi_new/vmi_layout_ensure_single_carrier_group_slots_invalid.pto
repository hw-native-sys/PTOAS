// RUN: not pto-test-opt %s -split-input-file -pto-validate-vmi-layout-ir 2>&1 | FileCheck %s

// The bridge holds only where the two layouts really do select the same lanes
// of one carrier.  Each case below breaks one clause of that invariant and must
// stay unsupported.
// num_groups > slots: the packet needs two carriers, the dense vector one.
func.func @more_groups_than_slots(
    %v: !pto.vmi.vreg<16xf32, #pto.vmi.layout<num_groups = 16, slots = 8>>) {
  %r = pto.vmi.ensure_layout %v
      : !pto.vmi.vreg<16xf32, #pto.vmi.layout<num_groups = 16, slots = 8>>
      -> !pto.vmi.vreg<16xf32, #pto.vmi.layout<contiguous>>
  return
}

// -----

// lane_stride = 2 on a 32-bit element: the two-step bridge normalizes the
// dense lane stride first, and that materialization covers 8/16-bit elements
// only, so the pair stays unsupported.  (The supported same-stride pair is the
// 8-bit stride-4 one: see vmi_ensure_layout_group_slot_lane_stride.pto.)
func.func @strided_group_lanes_unsupported_width(
    %v: !pto.vmi.vreg<8xf32,
                      #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>) {
  %r = pto.vmi.ensure_layout %v
      : !pto.vmi.vreg<8xf32,
                      #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
      -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<contiguous>>
  return
}

// -----

// num_groups > lanesPerPart: the packet cannot fit one carrier at all.
func.func @more_groups_than_lanes(
    %v: !pto.vmi.vreg<128xf32, #pto.vmi.layout<num_groups = 128, slots = 128>>) {
  %r = pto.vmi.ensure_layout %v
      : !pto.vmi.vreg<128xf32, #pto.vmi.layout<num_groups = 128, slots = 128>>
      -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
  return
}

// CHECK: has no registered materialization support
// CHECK: num_groups = 16, slots = 8
// CHECK: has no registered materialization support
// CHECK: lane_stride = 2
// CHECK: has no registered materialization support
// CHECK: num_groups = 128, slots = 128
