// RUN: not pto-test-opt %s -split-input-file -pto-validate-vmi-ir 2>&1 | FileCheck %s

// CHECK: VMI-UNSUPPORTED{{:}} {{.*}}type=i8, VL=512, group=8, bytes/group=64
// CHECK-SAME: no executable A5 grouped-reduction layout
func.func @too_many_byte_carriers(%x: !pto.vmi.vreg<512xi8>, %m: !pto.vmi.mask<512xpred>) -> !pto.vmi.vreg<8xi8> {
  %r = pto.vmi.group_reduce_addi %x, %m {num_groups = 8, reassoc} : !pto.vmi.vreg<512xi8>, !pto.vmi.mask<512xpred> -> !pto.vmi.vreg<8xi8>
  return %r : !pto.vmi.vreg<8xi8>
}


// -----

// CHECK: VMI-UNSUPPORTED{{:}} {{.*}}type=i8, VL=256, group=16, bytes/group=16
// CHECK-SAME: at most eight groups
func.func @too_many_byte_groups(%x: !pto.vmi.vreg<256xi8>, %m: !pto.vmi.mask<256xpred>) -> !pto.vmi.vreg<16xi8> {
  %r = pto.vmi.group_reduce_addi %x, %m {num_groups = 16, reassoc} : !pto.vmi.vreg<256xi8>, !pto.vmi.mask<256xpred> -> !pto.vmi.vreg<16xi8>
  return %r : !pto.vmi.vreg<16xi8>
}
