// RUN: pto-test-opt %s -pto-vmi-normalize-signless-int-to-unsigned -vmi-lower-unified-to-legacy | FileCheck %s

// Signless integers use unsigned semantics, so f16->i8 routes through
// fptoui with an unsigned carrier and bitcasts back to the public i8 type.

module {
  func.func @f16_to_signless_i8(%source: !pto.vmi.vreg<128xf16>)
      -> !pto.vmi.vreg<128xi8> {
    %result = pto.vmi.vcvt %source {saturate = "SAT"}
        : !pto.vmi.vreg<128xf16> -> !pto.vmi.vreg<128xi8>
    return %result : !pto.vmi.vreg<128xi8>
  }
}

// CHECK-LABEL: func.func @f16_to_signless_i8(
// CHECK: %[[UI:.*]] = pto.vmi.fptoui {{.*}} {saturate = "SAT"}
// CHECK-SAME: -> !pto.vmi.vreg<128xui8>
// CHECK: %[[OUT:.*]] = pto.vmi.bitcast %[[UI]]
// CHECK-SAME: !pto.vmi.vreg<128xui8> -> !pto.vmi.vreg<128xi8>
// CHECK: return %[[OUT]]
// CHECK-NOT: pto.vmi.fptosi
