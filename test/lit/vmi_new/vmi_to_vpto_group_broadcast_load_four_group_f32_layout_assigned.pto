// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-pre-assignment-combine -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-expand-implicit-ensure-layouts -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

// Four-group 128-lane group broadcasts on both element widths that reach this
// shape, with NO layout pinned anywhere and the broadcast consumed by a store
// rather than returned: layout assignment must choose the layout itself, which
// is the part the pinned-layout test
// vmi_to_vpto_group_broadcast_load_e2b_four_group.pto structurally cannot see
// (there the result layout is carried by the function return type).
//
// The eight-group E2B packet pairs a group size with a result layout:
//   gb(1) <-> contiguous, gb(2) <-> deinterleaved = 2, gb(4) <-> deinterleaved = 4
// where gb(N) means one group spans N VCG blocks (32 bytes each).  With
// 128 lanes over 4 groups a group is 32 lanes wide, so
//   16-bit elements: 32 / 16 = gb(2)  -> pairs with deinterleaved = 2
//   32-bit elements: 32 /  8 = gb(4)  -> pairs with deinterleaved = 4
// A result layout outside that pairing cannot use the packet, and falls back to
// one lane-zero BRC load per logical group plus a prefix-mask select tree.
//
// Only the lowering is asserted, so that either fix (make the broadcast prefer
// deinterleaved = 4, or admit the packet for a contiguous result) satisfies the
// same contract.

module {
  func.func @group_broadcast_load_four_group_bf16_layout_assigned(
      %src: !pto.ptr<bf16, ub>, %dst: !pto.ptr<bf16, ub>, %off: index) {
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %aligned_off = arith.muli %off, %c16 : index
    %slots = pto.vmi.vload %src[%aligned_off], %c1 {group = 4}
        : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<4xbf16>
    %out = pto.vmi.vbrc %slots {group = 4}
        : !pto.vmi.vreg<4xbf16> -> !pto.vmi.vreg<128xbf16>
    pto.vmi.vstore %out, %dst[%aligned_off]
        : !pto.vmi.vreg<128xbf16>, !pto.ptr<bf16, ub>
    return
  }

  func.func @group_broadcast_load_four_group_f32_layout_assigned(
      %src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>, %off: index) {
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %aligned_off = arith.muli %off, %c8 : index
    %slots = pto.vmi.vload %src[%aligned_off], %c1 {group = 4}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<4xf32>
    %out = pto.vmi.vbrc %slots {group = 4}
        : !pto.vmi.vreg<4xf32> -> !pto.vmi.vreg<128xf32>
    pto.vmi.vstore %out, %dst[%aligned_off]
        : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }

  // The E2B packet needs a 32-byte-aligned source base.  With a non-32-byte
  // offset the result must not commit to the E2B deinterleaved pairing;
  // preferring contiguous lets the per-group BRC path lower it instead of
  // leaving a residual group_broadcast_load behind.
  func.func @group_broadcast_load_four_group_f32_unaligned(
      %src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>, %off: index) {
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %aligned_off = arith.muli %off, %c8 : index
    %unaligned_off = arith.addi %aligned_off, %c1 : index
    %slots = pto.vmi.vload %src[%unaligned_off], %c1 {group = 4}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<4xf32>
    %out = pto.vmi.vbrc %slots {group = 4}
        : !pto.vmi.vreg<4xf32> -> !pto.vmi.vreg<128xf32>
    pto.vmi.vstore %out, %dst[%unaligned_off]
        : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }

  // bf16 128-lane group=4 pairs the packet with deinterleaved=2; the same
  // alignment rule must keep an unaligned base on the BRC path.
  func.func @group_broadcast_load_four_group_bf16_unaligned(
      %src: !pto.ptr<bf16, ub>, %dst: !pto.ptr<bf16, ub>, %off: index) {
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %aligned_off = arith.muli %off, %c16 : index
    %unaligned_off = arith.addi %aligned_off, %c1 : index
    %slots = pto.vmi.vload %src[%unaligned_off], %c1 {group = 4}
        : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<4xbf16>
    %out = pto.vmi.vbrc %slots {group = 4}
        : !pto.vmi.vreg<4xbf16> -> !pto.vmi.vreg<128xbf16>
    pto.vmi.vstore %out, %dst[%unaligned_off]
        : !pto.vmi.vreg<128xbf16>, !pto.ptr<bf16, ub>
    return
  }
}

// LOWER-LABEL: func.func @group_broadcast_load_four_group_bf16_layout_assigned
// LOWER-NOT: BRC_B16
// LOWER: dist = "E2B_B16"

// LOWER-LABEL: func.func @group_broadcast_load_four_group_f32_layout_assigned
// LOWER-NOT: BRC_B32
// LOWER: dist = "E2B_B32"

// An unaligned base cannot use the E2B packet; the pair must fall back to the
// contiguous per-group BRC lowering rather than leave a residual op.
// LOWER-LABEL: func.func @group_broadcast_load_four_group_f32_unaligned
// LOWER: dist = "BRC_B32"
// LOWER-NOT: dist = "E2B_B32"

// LOWER-LABEL: func.func @group_broadcast_load_four_group_bf16_unaligned
// LOWER: dist = "BRC_B16"
// LOWER-NOT: dist = "E2B_B16"
