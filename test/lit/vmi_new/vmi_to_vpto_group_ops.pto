// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s

module {
  func.func @vmi_to_vpto_group_ops(
      %src: !pto.ptr<f32, ub>,
      %dst: !pto.ptr<f32, ub>,
      %row_stride: index,
      %mask: !pto.vmi.mask<512xb32, #pto.vmi.layout<contiguous>>) {
    %c0 = arith.constant 0 : index
    %v = pto.vmi.vload %src[%c0], %row_stride
        {group = 2}
        : !pto.ptr<f32, ub>, index -> !pto.vmi.vreg<512xf32, #pto.vmi.layout<contiguous>>
    %r = pto.vmi.vcadd %v, %mask {group = 2, reassoc}
        : !pto.vmi.vreg<512xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<512xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>>
    pto.vmi.vstore %r, %dst[%c0], %row_stride {group = 2}
        : !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>>, !pto.ptr<f32, ub>, index
    return
  }
}

// CHECK-LABEL: func.func @vmi_to_vpto_group_ops(
// CHECK-COUNT-8: pto.vlds
// CHECK: pto.vcadd
// CHECK: pto.vcadd
// CHECK: pto.vadd
// CHECK: pto.vcadd
// CHECK: pto.vadd
// CHECK: pto.vcadd
// CHECK: pto.vadd
// CHECK: pto.vcadd
// CHECK: pto.vcadd
// CHECK: pto.vadd
// CHECK: pto.vcadd
// CHECK: pto.vadd
// CHECK: pto.vcadd
// CHECK: pto.vadd
// CHECK-NOT: pto.vsel
// CHECK-COUNT-2: pto.vsts {{.*}} {dist = "1PT_B32"}
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast
