// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=DIRECT
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

// Covers kGroupBroadcastLayoutPatterns row {gb(2), gs(1), c()}:
// bf16 G=4 on L=128 has groupSize=32 = two 32B blocks with a slots=1 source.
// Without that row tip rewrites toward slots=8 and fails ensure_layout
// (slots=1 → slots=8 is not materializable). The f32 sibling is
// vmi_to_vpto_group_broadcast_slots1_four_block.pto ({gb(4), gs(1), c()}).

module {
  func.func @group_broadcast_slots1_two_block_bf16(
      %source: !pto.vmi.vreg<4xbf16, #pto.vmi.layout<num_groups = 4, slots = 1>>,
      %data: !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>> {
    %broadcast = pto.vmi.vbrc %source {group = 4}
        : !pto.vmi.vreg<4xbf16, #pto.vmi.layout<num_groups = 4, slots = 1>>
        -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
    %out = pto.vmi.vmul %data, %broadcast
        : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
    return %out
        : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
  }

  func.func @group_broadcast_slots1_two_block_bf16_producer(%scalar: bf16)
      -> !pto.vmi.vreg<128xbf16> {
    %slots = pto.vmi.vbrc %scalar
        : bf16 -> !pto.vmi.vreg<4xbf16>
    %broadcast = pto.vmi.vbrc %slots {group = 4}
        : !pto.vmi.vreg<4xbf16> -> !pto.vmi.vreg<128xbf16>
    return %broadcast : !pto.vmi.vreg<128xbf16>
  }
}

// DIRECT-LABEL: func.func @group_broadcast_slots1_two_block_bf16(
// Keep slots=1 source; do not rewrite toward slots=8.
// DIRECT: %[[MASK:.*]] = pto.pset_b16 "PAT_ALL"
// DIRECT: pto.vdup {{.*}}LOWEST
// DIRECT: pto.vdup {{.*}}LOWEST
// DIRECT: pto.vsel
// DIRECT: pto.vdup {{.*}}LOWEST
// DIRECT: pto.vsel
// DIRECT: pto.vdup {{.*}}LOWEST
// DIRECT: pto.vsel
// DIRECT: pto.vmul
// DIRECT-NOT: pto.vmi.

// ASSIGN-LABEL: func.func @group_broadcast_slots1_two_block_bf16(
// ASSIGN: %[[BROADCAST:.*]] = pto.vmi.group_broadcast %arg0
// ASSIGN-SAME: !pto.vmi.vreg<4xbf16, #pto.vmi.layout<num_groups = 4, slots = 1>>
// ASSIGN-SAME: -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
// ASSIGN-NOT: pto.vmi.ensure_layout

// ASSIGN-LABEL: func.func @group_broadcast_slots1_two_block_bf16_producer(
// ASSIGN: %[[SLOTS:.*]] = pto.vmi.broadcast
// ASSIGN-SAME: -> !pto.vmi.vreg<4xbf16, #pto.vmi.layout<num_groups = 4, slots = 8>>
// ASSIGN: %[[BROADCAST:.*]] = pto.vmi.group_broadcast %[[SLOTS]]
// ASSIGN-SAME: -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<{{.*}}>

// LOWER-LABEL: func.func @group_broadcast_slots1_two_block_bf16_producer(
// LOWER: pto.vdup %arg0
// LOWER: pto.vselr
// LOWER-NOT: pto.vmi.
