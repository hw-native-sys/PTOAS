// RUN: pto-test-opt %s -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=MASKED-LOWER --implicit-check-not=pto.vsel

// Every cast of the family takes the same optional conversion predicate, so
// layout assignment models all of them with the three-endpoint cast relation,
// and VMI-to-VPTO lowers the predicate as the mask operand of the conversion it
// emits (issue #1671).  The six conversions below must be planned like the
// masked extf/truncf -- the predicate keeps the source data layout -- and the
// lowered pto.vcvt must consume that authored predicate instead of an all-true
// seed.

module {
  func.func @masked_fptosi(
      %s: !pto.vmi.vreg<128xf32>, %m: !pto.vmi.mask<128xb32>)
      -> !pto.vmi.vreg<128xsi32> {
    %0 = pto.vmi.fptosi %s, %m {saturate = "SAT"}
        : !pto.vmi.vreg<128xf32>, !pto.vmi.mask<128xb32>
        -> !pto.vmi.vreg<128xsi32>
    return %0 : !pto.vmi.vreg<128xsi32>
  }

  func.func @masked_fptoui(
      %s: !pto.vmi.vreg<128xf16>, %m: !pto.vmi.mask<128xb16>)
      -> !pto.vmi.vreg<128xui8> {
    %0 = pto.vmi.fptoui %s, %m {rounding = "R", saturate = "SAT"}
        : !pto.vmi.vreg<128xf16>, !pto.vmi.mask<128xb16>
        -> !pto.vmi.vreg<128xui8>
    return %0 : !pto.vmi.vreg<128xui8>
  }

  func.func @masked_sitofp(
      %s: !pto.vmi.vreg<128xsi32>, %m: !pto.vmi.mask<128xb32>)
      -> !pto.vmi.vreg<128xf32> {
    %0 = pto.vmi.sitofp %s, %m
        : !pto.vmi.vreg<128xsi32>, !pto.vmi.mask<128xb32>
        -> !pto.vmi.vreg<128xf32>
    return %0 : !pto.vmi.vreg<128xf32>
  }

  func.func @masked_extsi(
      %s: !pto.vmi.vreg<128xsi16>, %m: !pto.vmi.mask<128xb16>)
      -> !pto.vmi.vreg<128xsi32> {
    %0 = pto.vmi.extsi %s, %m
        : !pto.vmi.vreg<128xsi16>, !pto.vmi.mask<128xb16>
        -> !pto.vmi.vreg<128xsi32>
    return %0 : !pto.vmi.vreg<128xsi32>
  }

  func.func @masked_extui(
      %s: !pto.vmi.vreg<128xui8>, %m: !pto.vmi.mask<128xb8>)
      -> !pto.vmi.vreg<128xui32> {
    %0 = pto.vmi.extui %s, %m
        : !pto.vmi.vreg<128xui8>, !pto.vmi.mask<128xb8>
        -> !pto.vmi.vreg<128xui32>
    return %0 : !pto.vmi.vreg<128xui32>
  }

  func.func @masked_trunci(
      %s: !pto.vmi.vreg<128xsi32>, %m: !pto.vmi.mask<128xb32>)
      -> !pto.vmi.vreg<128xsi16> {
    %0 = pto.vmi.trunci %s, %m {saturate = "SAT"}
        : !pto.vmi.vreg<128xsi32>, !pto.vmi.mask<128xb32>
        -> !pto.vmi.vreg<128xsi16>
    return %0 : !pto.vmi.vreg<128xsi16>
  }
}

// The predicate carries the source layout the conversion ended up with.
// ASSIGN-LABEL: func.func @masked_fptosi(
// ASSIGN-SAME: %{{.*}}: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, %{{.*}}: !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>)
// ASSIGN-NEXT: %{{.*}} = pto.vmi.fptosi %{{.*}}, %{{.*}} {saturate = "SAT"} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xsi32, #pto.vmi.layout<contiguous>>
// ASSIGN-LABEL: func.func @masked_fptoui(
// ASSIGN-SAME: %{{.*}}: !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>, %{{.*}}: !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>>)
// ASSIGN-NEXT: %{{.*}} = pto.vmi.fptoui %{{.*}}, %{{.*}} {rounding = "R", saturate = "SAT"} : !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xui8, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN-LABEL: func.func @masked_sitofp(
// ASSIGN-SAME: %{{.*}}: !pto.vmi.vreg<128xsi32, #pto.vmi.layout<contiguous>>, %{{.*}}: !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>)
// ASSIGN-NEXT: %{{.*}} = pto.vmi.sitofp %{{.*}}, %{{.*}} : !pto.vmi.vreg<128xsi32, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-LABEL: func.func @masked_extsi(
// ASSIGN-SAME: %{{.*}}: !pto.vmi.vreg<128xsi16, #pto.vmi.layout<contiguous>>, %{{.*}}: !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>>)
// ASSIGN-NEXT: %{{.*}} = pto.vmi.extsi %{{.*}}, %{{.*}} : !pto.vmi.vreg<128xsi16, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xsi32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-LABEL: func.func @masked_extui(
// ASSIGN-SAME: %{{.*}}: !pto.vmi.vreg<128xui8, #pto.vmi.layout<contiguous>>, %{{.*}}: !pto.vmi.mask<128xb8, #pto.vmi.layout<contiguous>>)
// ASSIGN-NEXT: %{{.*}} = pto.vmi.extui %{{.*}}, %{{.*}} : !pto.vmi.vreg<128xui8, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<128xb8, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xui32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN-LABEL: func.func @masked_trunci(
// ASSIGN-SAME: %{{.*}}: !pto.vmi.vreg<128xsi32, #pto.vmi.layout<contiguous>>, %{{.*}}: !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>)
// ASSIGN-NEXT: %{{.*}} = pto.vmi.trunci %{{.*}}, %{{.*}} {saturate = "SAT"} : !pto.vmi.vreg<128xsi32, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xsi16, #pto.vmi.layout<contiguous, lane_stride = 2>>

// Each conversion keeps the authored predicate as its mask operand; the
// per-part functions are the physical parts the layout planner split the source
// into, and the pto.vcvt zero-inactive contract zeroes the inactive lanes.
// MASKED-LOWER-LABEL: func.func @masked_fptosi(
// MASKED-LOWER-SAME: %{{.*}}: !pto.vreg<64xf32>, %{{.*}}: !pto.vreg<64xf32>, %[[FP0:[^:]+]]: !pto.mask<b32>, %[[FP1:[^:]+]]: !pto.mask<b32>
// MASKED-LOWER: pto.vcvt %{{.*}}, %[[FP0]] {rnd = "R", sat = "SAT"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xsi32>
// MASKED-LOWER: pto.vcvt %{{.*}}, %[[FP1]] {rnd = "R", sat = "SAT"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xsi32>

// MASKED-LOWER-LABEL: func.func @masked_fptoui(
// MASKED-LOWER-SAME: %[[FU0:[^:]+]]: !pto.vreg<128xf16>, %[[FU1:[^:]+]]: !pto.mask<b16>
// MASKED-LOWER: pto.vcvt %[[FU0]], %[[FU1]] {part = "EVEN", rnd = "R", sat = "SAT"} : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<256xui8>

// MASKED-LOWER-LABEL: func.func @masked_sitofp(
// MASKED-LOWER-SAME: %{{.*}}: !pto.vreg<64xsi32>, %{{.*}}: !pto.vreg<64xsi32>, %[[SP0:[^:]+]]: !pto.mask<b32>, %[[SP1:[^:]+]]: !pto.mask<b32>
// MASKED-LOWER: pto.vcvt %{{.*}}, %[[SP0]] {rnd = "R"} : !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// MASKED-LOWER: pto.vcvt %{{.*}}, %[[SP1]] {rnd = "R"} : !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.vreg<64xf32>

// MASKED-LOWER-LABEL: func.func @masked_extsi(
// MASKED-LOWER-SAME: %[[ES0:[^:]+]]: !pto.vreg<128xsi16>, %[[ES1:[^:]+]]: !pto.mask<b16>
// MASKED-LOWER: pto.vcvt %[[ES0]], %[[ES1]] {part = "EVEN"} : !pto.vreg<128xsi16>, !pto.mask<b16> -> !pto.vreg<64xsi32>
// MASKED-LOWER: pto.vcvt %[[ES0]], %[[ES1]] {part = "ODD"} : !pto.vreg<128xsi16>, !pto.mask<b16> -> !pto.vreg<64xsi32>

// MASKED-LOWER-LABEL: func.func @masked_extui(
// MASKED-LOWER-SAME: %[[EU0:[^:]+]]: !pto.vreg<256xui8>, %[[EU1:[^:]+]]: !pto.mask<b8>
// MASKED-LOWER: pto.vcvt %[[EU0]], %[[EU1]] {part = "P0"} : !pto.vreg<256xui8>, !pto.mask<b8> -> !pto.vreg<64xui32>
// MASKED-LOWER: pto.vcvt %[[EU0]], %[[EU1]] {part = "P1"} : !pto.vreg<256xui8>, !pto.mask<b8> -> !pto.vreg<64xui32>
// MASKED-LOWER: pto.vcvt %[[EU0]], %[[EU1]] {part = "P2"} : !pto.vreg<256xui8>, !pto.mask<b8> -> !pto.vreg<64xui32>
// MASKED-LOWER: pto.vcvt %[[EU0]], %[[EU1]] {part = "P3"} : !pto.vreg<256xui8>, !pto.mask<b8> -> !pto.vreg<64xui32>

// MASKED-LOWER-LABEL: func.func @masked_trunci(
// MASKED-LOWER-SAME: %{{.*}}: !pto.vreg<64xsi32>, %{{.*}}: !pto.vreg<64xsi32>, %[[TR0:[^:]+]]: !pto.mask<b32>, %[[TR1:[^:]+]]: !pto.mask<b32>
// MASKED-LOWER: pto.vcvt %{{.*}}, %[[TR0]] {part = "EVEN", sat = "SAT"} : !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.vreg<128xsi16>
// MASKED-LOWER: pto.vcvt %{{.*}}, %[[TR1]] {part = "EVEN", sat = "SAT"} : !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.vreg<128xsi16>
