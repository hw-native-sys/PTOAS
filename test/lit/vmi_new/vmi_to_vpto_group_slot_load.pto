// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s

module {
  func.func @vmi_to_vpto_group_slot_load_slots8(
      %src: !pto.ptr<f32, ub>, %off: index) -> !pto.vreg<64xf32> {
    %c1 = arith.constant 1 : index
    %out = pto.vmi.vload%src[%off], %c1
        {group = 8}
        : !pto.ptr<f32, ub>
        -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    %part = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>)
        -> !pto.vreg<64xf32>
    return %part : !pto.vreg<64xf32>
  }

  func.func @vmi_to_vpto_group_slot_load_slots1(
      %src: !pto.ptr<f32, ub>, %off: index)
      -> (!pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>,
          !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>) {
    %c8 = arith.constant 8 : index
    %out = pto.vmi.vload%src[%off], %c8
        {group = 8}
        : !pto.ptr<f32, ub>
        -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>>
    %p0, %p1, %p2, %p3, %p4, %p5, %p6, %p7 = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>>)
        -> (!pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>,
            !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>)
    return %p0, %p1, %p2, %p3, %p4, %p5, %p6, %p7
        : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>,
          !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.vreg<64xf32>
  }

  func.func @vmi_to_vpto_group_slot_load_slots8_store(
      %src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f32, ub>, %off: index) {
    %c1 = arith.constant 1 : index
    %out = pto.vmi.vload%src[%off], %c1
        {group = 8}
        : !pto.ptr<f32, ub>
        -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    pto.vmi.vstore %out, %dst[%off], %c1 {group = 8}
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>,
          !pto.ptr<f32, ub>
    return
  }

  func.func @vmi_to_vpto_group_slot_load_u8_scale_broadcast(
      %src: !pto.ptr<ui8, ub>, %dst: !pto.ptr<f32, ub>, %off: index) {
    %c1 = arith.constant 1 : index
    %c23_i32 = arith.constant 23 : i32
    %scale_u8 = pto.vmi.vload%src[%off], %c1 {group = 8}
        : !pto.ptr<ui8, ub>
        -> !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 8>>
    %scale_u8_strided = pto.vmi.ensure_layout %scale_u8
        : !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 4>>
    %scale_u32 = pto.vmi.vcvt %scale_u8_strided
        : !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 4>>
        -> !pto.vmi.vreg<8xui32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    %scale_i32 = pto.vmi.vinterpret_cast %scale_u32
        : !pto.vmi.vreg<8xui32, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    %shift = pto.vmi.vbrc %c23_i32
        : i32 -> !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    %bits = pto.vmi.vshl %scale_i32, %shift
        : !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>,
          !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    %scale = pto.vmi.vinterpret_cast %bits
        : !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    %vec = pto.vmi.vbrc %scale {group = 8}
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>
    pto.vmi.vstore %vec, %dst[%off]
        : !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>,
          !pto.ptr<f32, ub>
    return
  }

  func.func @vmi_to_vpto_group_slot_load_u16_broadcast(
      %src: !pto.ptr<ui16, ub>, %dst: !pto.ptr<ui32, ub>, %off: index) {
    %c1 = arith.constant 1 : index
    %scale_u16 = pto.vmi.vload%src[%off], %c1 {group = 8}
        : !pto.ptr<ui16, ub>
        -> !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8>>
    %scale_u16_strided = pto.vmi.ensure_layout %scale_u16
        : !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
    %scale_u32 = pto.vmi.vcvt %scale_u16_strided
        : !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
        -> !pto.vmi.vreg<8xui32, #pto.vmi.layout<num_groups = 8, slots = 8>>
    %vec = pto.vmi.vbrc %scale_u32 {group = 8}
        : !pto.vmi.vreg<8xui32, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<256xui32, #pto.vmi.layout<contiguous>>
    pto.vmi.vstore %vec, %dst[%off]
        : !pto.vmi.vreg<256xui32, #pto.vmi.layout<contiguous>>,
          !pto.ptr<ui32, ub>
    return
  }

  func.func @vmi_to_vpto_group_slot_load_extui_u8_u16_slots8(
      %src: !pto.ptr<ui8, ub>, %dst: !pto.ptr<ui16, ub>, %off: index) {
    %c1 = arith.constant 1 : index
    %narrow = pto.vmi.vload %src[%off], %c1 {group = 8}
        : !pto.ptr<ui8, ub>
        -> !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 8>>
    %strided = pto.vmi.ensure_layout %narrow
        : !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
    %wide = pto.vmi.extui %strided
        : !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>>
        -> !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8>>
    pto.vmi.vstore %wide, %dst[%off], %c1 {group = 8}
        : !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8>>,
          !pto.ptr<ui16, ub>
    return
  }

  func.func @vmi_to_vpto_group_slot_load_extui_u8_u16_slots1(
      %src: !pto.ptr<ui8, ub>, %dst: !pto.ptr<ui16, ub>, %off: index) {
    %c32 = arith.constant 32 : index
    %narrow = pto.vmi.vload %src[%off], %c32 {group = 8}
        : !pto.ptr<ui8, ub>
        -> !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 1>>
    %wide = pto.vmi.extui %narrow
        : !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 1>>
        -> !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 1>>
    pto.vmi.vstore %wide, %dst[%off], %c32 {group = 8}
        : !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 1>>,
          !pto.ptr<ui16, ub>
    return
  }
}

// CHECK-LABEL: func.func @vmi_to_vpto_group_slot_load_slots8(
// CHECK: %[[MASK:.*]] = pto.pset_b32 "PAT_VL8" : !pto.mask<b32>
// CHECK: %[[BASE:.*]] = pto.addptr %arg0, %arg1 : <f32, ub> -> <f32, ub>
// CHECK: %[[OUT:.*]] = pto.vsldb %[[BASE]], {{.*}}, {{.*}}, %[[MASK]] : !pto.ptr<f32, ub>, i16, i16, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK: return %[[OUT]]

// CHECK-LABEL: func.func @vmi_to_vpto_group_slot_load_slots1(
// CHECK-COUNT-8: pto.vsldb

// CHECK-LABEL: func.func @vmi_to_vpto_group_slot_load_slots8_store(
// CHECK: %[[LOAD_MASK:.*]] = pto.pset_b32 "PAT_VL8" : !pto.mask<b32>
// CHECK: %[[BASE:.*]] = pto.addptr %arg0, %arg2 : <f32, ub> -> <f32, ub>
// CHECK: %[[OUT:.*]] = pto.vsldb %[[BASE]], {{.*}}, {{.*}}, %[[LOAD_MASK]]
// CHECK: pto.init_align
// CHECK: pto.vstus
// CHECK: pto.vstas
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast

// CHECK-LABEL: func.func @vmi_to_vpto_group_slot_load_u8_scale_broadcast(
// CHECK: pto.pset_b8 "PAT_VL8" : !pto.mask<b8>
// CHECK: %[[U8:.*]] = pto.vsldb {{.*}} : !pto.ptr<ui8, ub>, i16, i16, !pto.mask<b8> -> !pto.vreg<256xui8>
// CHECK: %[[U16:.*]] = pto.vzunpack %[[U8]]
// CHECK: %[[U32:.*]] = pto.vzunpack %[[U16]]
// CHECK: pto.vbitcast %[[U32]] : !pto.vreg<64xui32> -> !pto.vreg<256xui8>
// CHECK: pto.pset_b8 "PAT_VL32" : !pto.mask<b8>
// CHECK: pto.vcvt {{.*}} {part = "P0"} : !pto.vreg<256xui8>, !pto.mask<b8> -> !pto.vreg<64xui32>
// CHECK: pto.vshl
// CHECK: pto.vselr
// CHECK: pto.vstus
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast

// CHECK-LABEL: func.func @vmi_to_vpto_group_slot_load_u16_broadcast(
// CHECK: pto.pset_b16 "PAT_VL8" : !pto.mask<b16>
// CHECK: %[[U16:.*]] = pto.vsldb {{.*}} : !pto.ptr<ui16, ub>, i16, i16, !pto.mask<b16> -> !pto.vreg<128xui16>
// CHECK: %[[U32:.*]] = pto.vzunpack %[[U16]]
// CHECK: pto.vbitcast %[[U32]] : !pto.vreg<64xui32> -> !pto.vreg<128xui16>
// CHECK: pto.pset_b16 "PAT_VL16" : !pto.mask<b16>
// CHECK: pto.vcvt {{.*}} {part = "EVEN"} : !pto.vreg<128xui16>, !pto.mask<b16> -> !pto.vreg<64xui32>
// CHECK: pto.vstus
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast

// CHECK-LABEL: func.func @vmi_to_vpto_group_slot_load_extui_u8_u16_slots8(
// CHECK: %[[LOAD:.*]] = pto.vsldb {{.*}} : !pto.ptr<ui8, ub>, i16, i16, !pto.mask<b8> -> !pto.vreg<256xui8>
// CHECK: %[[UNPACK:.*]] = pto.vzunpack %[[LOAD]]
// CHECK: %[[WIDE:.*]] = pto.vcvt {{.*}} {part = "EVEN"} : !pto.vreg<256xui8>, !pto.mask<b8> -> !pto.vreg<128xui16>
// CHECK: pto.init_align
// CHECK: pto.vstus {{.*}}, %[[WIDE]],
// CHECK: pto.vstas
// CHECK-NOT: dist = "1PT_B32"
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.

// CHECK-LABEL: func.func @vmi_to_vpto_group_slot_load_extui_u8_u16_slots1(
// CHECK-COUNT-8: pto.vsldb
// CHECK-COUNT-8: pto.vcvt {{.*}} {part = "EVEN"} : !pto.vreg<256xui8>, !pto.mask<b8> -> !pto.vreg<128xui16>
// CHECK-COUNT-8: pto.vsts {{.*}} {dist = "1PT_B16"}
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast
