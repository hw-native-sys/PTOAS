// RUN: not pto-test-opt %s -test-vmi-layout-cost-conformance 2>&1 | FileCheck %s --check-prefix=COST
// RUN: not pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto 2>&1 | FileCheck %s --check-prefix=LOWER

module {
  func.func @vcmp_merge(
      %a: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
      %b: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
      %seed: !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>> {
    %r = pto.vmi.vcmp %a, %b, %seed {cmp = "lt", pmode = "merge",
                                       test.vmi_layout_cost_conformance}
      : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
        !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>,
        !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
    return %r : !pto.vmi.mask<64xb32, #pto.vmi.layout<contiguous>>
  }
}

// COST: error: test layout-cost conformance marker has no exposed relation
// LOWER: VMI-RESIDUAL-OP: failed to convert all VMI ops/types to VPTO
