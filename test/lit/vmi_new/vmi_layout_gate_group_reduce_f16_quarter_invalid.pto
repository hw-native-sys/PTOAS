// RUN: not pto-test-opt %s -pto-validate-vmi-layout-ir 2>&1 | FileCheck %s

module {
  func.func @f16_quarter_block_has_no_physical_mask(
      %source: !pto.vmi.vreg<32xf16,
          #pto.vmi.layout<contiguous, lane_stride = 4>>,
      %mask: !pto.vmi.mask<32xb16,
          #pto.vmi.layout<contiguous, lane_stride = 4>>)
      -> !pto.vmi.vreg<8xf16,
          #pto.vmi.layout<num_groups = 8, slots = 8>> {
    // CHECK: VMI-LAYOUT-CONTRACT: pto.vmi.group_reduce_addf has no registered group_slots layout support
    // CHECK-SAME: group_reduce source/mask/result layouts do not match a legal layout table row
    %result = pto.vmi.group_reduce_addf %source, %mask {
        num_groups = 8, reassoc
      } : !pto.vmi.vreg<32xf16,
            #pto.vmi.layout<contiguous, lane_stride = 4>>,
          !pto.vmi.mask<32xb16,
            #pto.vmi.layout<contiguous, lane_stride = 4>>
        -> !pto.vmi.vreg<8xf16,
            #pto.vmi.layout<num_groups = 8, slots = 8>>
    return %result : !pto.vmi.vreg<8xf16,
        #pto.vmi.layout<num_groups = 8, slots = 8>>
  }
}
