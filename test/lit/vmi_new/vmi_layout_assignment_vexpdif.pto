// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

module {
  func.func @vmi_layout_assignment_vexpdif(
      %x: !pto.vmi.vreg<128xf32>,
      %max: !pto.vmi.vreg<128xf32>,
      %mask: !pto.vmi.mask<128xpred>) -> !pto.vmi.vreg<1xf32> {
    %exp = pto.vmi.vexpdif %x, %max, %mask
        : !pto.vmi.vreg<128xf32>, !pto.vmi.vreg<128xf32>,
          !pto.vmi.mask<128xpred> -> !pto.vmi.vreg<128xf32>
    %sum = pto.vmi.vcadd %exp, %mask {group = 1, reassoc}
        : !pto.vmi.vreg<128xf32>, !pto.vmi.mask<128xpred>
          -> !pto.vmi.vreg<1xf32>
    return %sum : !pto.vmi.vreg<1xf32>
  }
}

// ASSIGN-LABEL: func.func @vmi_layout_assignment_vexpdif(
// ASSIGN-SAME: %arg0: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-SAME: %arg1: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-SAME: %arg2: !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>
// ASSIGN: %[[EXP:.*]] = pto.vmi.vexpdif %arg0, %arg1, %arg2
// ASSIGN-SAME: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN: pto.vmi.group_reduce_addf %[[EXP]], %arg2
// ASSIGN-SAME: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-SAME: !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>
// ASSIGN-SAME: -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<num_groups = 1, slots = 1>>

// LOWER-LABEL: func.func @vmi_layout_assignment_vexpdif(
// LOWER: pto.vexpdif {{.*}}, "ODD"
// LOWER-NOT: pto.vldsx2
// LOWER-NOT: pto.vmi.
