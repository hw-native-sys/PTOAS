// LOWER-NEXT: pto.vsts %[[VAL_23]], %[[VAL_1]]{{\[}}%[[VAL_4]]], %[[VAL_27]] : !pto.vreg<128xui16>, !pto.ptr<ui16, ub>, index, !pto.mask<b16>
// LOWER-NEXT: %[[VAL_28:[a-zA-Z0-9_.$-]+]] = pto.pset_b16 "PAT_ALL" : !pto.mask<b16>
