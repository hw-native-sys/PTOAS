// ASSIGN-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = pto.vmi.bitcast %[[VAL_3]] : !pto.vmi.vreg<32xf16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<64xi8, #pto.vmi.layout<contiguous>>
