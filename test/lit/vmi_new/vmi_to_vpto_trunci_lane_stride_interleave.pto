// RUN: pto-test-opt %s -vmi-to-vpto | FileCheck %s

// A lane-strided result with several physical chunks takes its source chunks
// interleaved across the chunks (partIndex * resultCount + resultIndex), not as
// a contiguous run.  Here 256xsi32 d(2) -> 256xsi8 c(ls2): result chunk 0 is
// filled from source chunks 0 and 2, result chunk 1 from source chunks 1 and 3.

module {
  func.func @trunci_lane_stride_interleave(
      %src: !pto.ptr<si32, ub>, %dst: !pto.ptr<si8, ub>) {
    %c0 = arith.constant 0 : index
    pto.vecscope {
      %v = pto.vmi.load %src[%c0] : !pto.ptr<si32, ub> -> !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 2>>
      %w = pto.vmi.trunci %v {saturate = "NOSAT"} : !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<256xsi8, #pto.vmi.layout<contiguous, lane_stride = 2>>
      pto.vmi.store %w, %dst[%c0] : !pto.vmi.vreg<256xsi8, #pto.vmi.layout<contiguous, lane_stride = 2>>, !pto.ptr<si8, ub>
    }
    return
  }
}

// CHECK-LABEL: func.func @trunci_lane_stride_interleave(
// CHECK: pto.vldsx2 {{.*}} "DINTLV_B32"
// CHECK: pto.vcvt {{.*}} {part = "P0", sat = "NOSAT"}
// CHECK: pto.vcvt {{.*}} {part = "P2", sat = "NOSAT"}
// CHECK: pto.vor
// CHECK: pto.vcvt {{.*}} {part = "P0", sat = "NOSAT"}
// CHECK: pto.vcvt {{.*}} {part = "P2", sat = "NOSAT"}
// CHECK: pto.vor
// CHECK: pto.vsts
