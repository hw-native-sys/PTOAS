// RUN: ptoas --pto-arch=a5 --pto-level=level3 --pto-backend=vpto --emit-vpto %s -o %t
// RUN: FileCheck %s --implicit-check-not=pto.vmi. < %t
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -pto-validate-vmi-layout-ir | FileCheck %s --check-prefix=ASSIGN

// Native producer layouts are independent of stores, broadcasts, casts and
// fanout. The final pipeline may insert consumer conversions where needed.

module {
  func.func @f16_vl64_store(%src: !pto.ptr<f16, ub>, %dst: !pto.ptr<f16, ub>, %wide: !pto.ptr<ui32, ub>, %active: index) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %offset = arith.constant 32 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<f16, ub> -> !pto.vmi.vreg<64xf16>
    %mask = pto.vmi.create_mask %active : index -> !pto.vmi.mask<64xpred>
    %r = pto.vmi.vcadd %x, %mask {group = 8, reassoc} : !pto.vmi.vreg<64xf16>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<8xf16>
    pto.vmi.vstore %r, %dst[%zero] : !pto.vmi.vreg<8xf16>, !pto.ptr<f16, ub>
    return
  }
  func.func @si16_vl128_broadcast(%src: !pto.ptr<si16, ub>, %dst: !pto.ptr<si16, ub>, %wide: !pto.ptr<si32, ub>, %active: index) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %offset = arith.constant 32 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<si16, ub> -> !pto.vmi.vreg<128xsi16>
    %mask = pto.vmi.create_mask %active : index -> !pto.vmi.mask<128xpred>
    %r = pto.vmi.vcadd %x, %mask {group = 8} : !pto.vmi.vreg<128xsi16>, !pto.vmi.mask<128xpred> -> !pto.vmi.vreg<8xsi16>
    %b = pto.vmi.vbrc %r {group = 8} : !pto.vmi.vreg<8xsi16> -> !pto.vmi.vreg<128xsi16>
    pto.vmi.vstore %b, %dst[%offset] : !pto.vmi.vreg<128xsi16>, !pto.ptr<si16, ub>
    return
  }
  func.func @si16_vl128_cast(%src: !pto.ptr<si16, ub>, %dst: !pto.ptr<si16, ub>, %wide: !pto.ptr<si32, ub>, %active: index) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %eight = arith.constant 8 : index
    %offset = arith.constant 32 : index
    %x = pto.vmi.vload %src[%zero] : !pto.ptr<si16, ub> -> !pto.vmi.vreg<128xsi16>
    %mask = pto.vmi.create_mask %active : index -> !pto.vmi.mask<128xpred>
    %r = pto.vmi.vcadd %x, %mask {group = 8} : !pto.vmi.vreg<128xsi16>, !pto.vmi.mask<128xpred> -> !pto.vmi.vreg<8xsi16>
    %w = pto.vmi.extsi %r : !pto.vmi.vreg<8xsi16> -> !pto.vmi.vreg<8xsi32>
    pto.vmi.vstore %w, %wide[%zero] : !pto.vmi.vreg<8xsi32>, !pto.ptr<si32, ub>
    return
  }
  func.func @si16_vl128_group_store(%src: !pto.ptr<si16, ub>, %dst: !pto.ptr<si16, ub>, %wide: !pto.ptr<si32, ub>, %active: index) {
    %zero = arith.constant 0 : index
