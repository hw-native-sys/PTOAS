// Integer narrowing cannot implement a one-part-per-chunk composite carrier.
// RUN: pto-test-opt %s -split-input-file -vmi-layout-assignment -verify-diagnostics

module {
 func.func @invalid(%x: !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 2>>) -> !pto.vmi.vreg<256xsi8, #pto.vmi.layout<deinterleaved = 2, lane_stride = 4>> {
  // expected-error@+1 {{no legal VMI layout relation is registered for pto.vmi.trunci}}
  %r = pto.vmi.trunci %x {saturate = "SAT"} : !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<256xsi8, #pto.vmi.layout<deinterleaved = 2, lane_stride = 4>>
  return %r : !pto.vmi.vreg<256xsi8, #pto.vmi.layout<deinterleaved = 2, lane_stride = 4>>
 }
}
// -----
module {
 func.func @invalid(%x: !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 4>>) -> !pto.vmi.vreg<256xsi8, #pto.vmi.layout<deinterleaved = 4, lane_stride = 4>> {
  // expected-error@+1 {{no legal VMI layout relation is registered for pto.vmi.trunci}}
  %r = pto.vmi.trunci %x {saturate = "SAT"} : !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 4>> -> !pto.vmi.vreg<256xsi8, #pto.vmi.layout<deinterleaved = 4, lane_stride = 4>>
  return %r : !pto.vmi.vreg<256xsi8, #pto.vmi.layout<deinterleaved = 4, lane_stride = 4>>
 }
}
// -----
module {
 func.func @invalid(%x: !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 2>>) -> !pto.vmi.vreg<256xsi16, #pto.vmi.layout<deinterleaved = 2, lane_stride = 2>> {
  // expected-error@+1 {{no legal VMI layout relation is registered for pto.vmi.trunci}}
  %r = pto.vmi.trunci %x {saturate = "SAT"} : !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<256xsi16, #pto.vmi.layout<deinterleaved = 2, lane_stride = 2>>
  return %r : !pto.vmi.vreg<256xsi16, #pto.vmi.layout<deinterleaved = 2, lane_stride = 2>>
 }
}
// -----
module {
 func.func @invalid(%x: !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 4>>) -> !pto.vmi.vreg<256xsi16, #pto.vmi.layout<deinterleaved = 4, lane_stride = 2>> {
  // expected-error@+1 {{no legal VMI layout relation is registered for pto.vmi.trunci}}
  %r = pto.vmi.trunci %x {saturate = "SAT"} : !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 4>> -> !pto.vmi.vreg<256xsi16, #pto.vmi.layout<deinterleaved = 4, lane_stride = 2>>
  return %r : !pto.vmi.vreg<256xsi16, #pto.vmi.layout<deinterleaved = 4, lane_stride = 2>>
 }
}
// -----
