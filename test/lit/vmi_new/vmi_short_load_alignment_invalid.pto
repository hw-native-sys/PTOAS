// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto -verify-diagnostics

// The logical 32B payload fits, but the unaligned stateful sequence accesses
// a 288B envelope. An allocation of 284B is insufficient by one f32.
module {
  func.func @unaligned_read_envelope_too_small(%src: memref<71xf32, #pto.address_space<vec>>)
      -> !pto.vmi.vreg<8xf32> {
    %off = arith.constant 1 : index
    // expected-error@+1 {{no safe unaligned full-read fallback: stateful physical read envelope [0, 288) exceeds proven allocation envelope [0, 284)}}
    %v = pto.vmi.vload %src[%off] : memref<71xf32, #pto.address_space<vec>> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
}
