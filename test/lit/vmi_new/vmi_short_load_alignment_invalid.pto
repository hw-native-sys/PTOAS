// RUN: pto-test-opt %s -split-input-file -vmi-lower-unified-to-legacy \
// RUN:   -vmi-mask-granularity-assignment -vmi-layout-assignment \
// RUN:   -vmi-to-vpto=load-safety=error -verify-diagnostics

// The logical 32B payload fits, but the unaligned stateful sequence accesses
// a 288B envelope. An allocation of 284B is insufficient by one f32.
module {
  func.func @unaligned_read_envelope_too_small(%src: memref<71xf32, #pto.address_space<vec>>)
      -> !pto.vmi.vreg<8xf32> {
    %off = arith.constant 1 : index
    // expected-error@+1 {{load-safety=error requires a safe unaligned full-read proof}}
    %v = pto.vmi.vload %src[%off] : memref<71xf32, #pto.address_space<vec>> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }
}

// -----

// A raw pointer has no allocation extent, so strict mode cannot prove that
// the complete stateful physical read is safe.
module {
  func.func @unaligned_ptr_requires_strict_read_proof() -> !pto.vmi.vreg<8xbf16> {
    %addr = arith.constant 1024 : i64
    %src = pto.castptr %addr : i64 -> !pto.ptr<bf16, ub>
    %off = arith.constant 1 : index
    // expected-error@+1 {{requires statically shaped memref source}}
    %v = pto.vmi.vload %src[%off] : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<8xbf16>
    return %v : !pto.vmi.vreg<8xbf16>
  }
}
