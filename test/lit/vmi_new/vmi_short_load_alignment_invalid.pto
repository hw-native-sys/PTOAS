// RUN: pto-test-opt %s -split-input-file -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto -verify-diagnostics

// Known misalignment and unknown alignment both exclude VSLDB.
module {
  func.func @ui8_8_constant_offset() -> !pto.vmi.vreg<8xui8> {
    %addr = arith.constant 1024 : i64
    %src = pto.castptr %addr : i64 -> !pto.ptr<ui8, ub>
    %off = arith.constant 1 : index
    // expected-error@+1 {{bounded contiguous load requires a provably 32-byte-aligned effective address for pto.vsldb, including single-block reads; no safe unaligned full-read fallback: requires statically shaped memref source}}
    %v = pto.vmi.vload %src[%off] : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<8xui8>
    return %v : !pto.vmi.vreg<8xui8>
  }
}

// -----

module {
  func.func @ui8_8_dynamic_offset(%arg: index) -> !pto.vmi.vreg<8xui8> {
