// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

// These are the one-VCG-block-per-group shapes that occupy only half of a
// physical VReg for group=4.  The source IR intentionally leaves layouts open:
// support is defined by element type and logical length, while layout selection
// remains an implementation detail of the compiler.

module {
  func.func @group4_broadcast_i8_128(%scalar: i8)
      -> !pto.vmi.vreg<128xi8> {
    %source = pto.vmi.vbrc %scalar : i8 -> !pto.vmi.vreg<4xi8>
    %result = pto.vmi.vbrc %source {group = 4}
        : !pto.vmi.vreg<4xi8> -> !pto.vmi.vreg<128xi8>
    return %result : !pto.vmi.vreg<128xi8>
  }

  func.func @group4_broadcast_bf16_64(%scalar: bf16)
      -> !pto.vmi.vreg<64xbf16> {
    %source = pto.vmi.vbrc %scalar : bf16 -> !pto.vmi.vreg<4xbf16>
    %result = pto.vmi.vbrc %source {group = 4}
        : !pto.vmi.vreg<4xbf16> -> !pto.vmi.vreg<64xbf16>
    return %result : !pto.vmi.vreg<64xbf16>
  }

  func.func @group4_broadcast_f32_32(%scalar: f32)
      -> !pto.vmi.vreg<32xf32> {
    %source = pto.vmi.vbrc %scalar : f32 -> !pto.vmi.vreg<4xf32>
    %result = pto.vmi.vbrc %source {group = 4}
        : !pto.vmi.vreg<4xf32> -> !pto.vmi.vreg<32xf32>
    return %result : !pto.vmi.vreg<32xf32>
  }
}

// ASSIGN-LABEL: func.func @group4_broadcast_i8_128(
// ASSIGN: pto.vmi.broadcast
// ASSIGN-SAME: -> !pto.vmi.vreg<4xi8, #pto.vmi.layout<num_groups = 4, slots = 8>>
// ASSIGN: pto.vmi.group_broadcast
// ASSIGN-SAME: -> !pto.vmi.vreg<128xi8, #pto.vmi.layout<contiguous, lane_stride = 2>>

// ASSIGN-LABEL: func.func @group4_broadcast_bf16_64(
// ASSIGN: pto.vmi.broadcast
// ASSIGN-SAME: -> !pto.vmi.vreg<4xbf16, #pto.vmi.layout<num_groups = 4, slots = 8>>
// ASSIGN: pto.vmi.group_broadcast
// ASSIGN-SAME: -> !pto.vmi.vreg<64xbf16, #pto.vmi.layout<contiguous, lane_stride = 2>>

// ASSIGN-LABEL: func.func @group4_broadcast_f32_32(
// ASSIGN: pto.vmi.broadcast
// ASSIGN-SAME: -> !pto.vmi.vreg<4xf32, #pto.vmi.layout<num_groups = 4, slots = 8>>
// ASSIGN: pto.vmi.group_broadcast
// ASSIGN-SAME: -> !pto.vmi.vreg<32xf32, #pto.vmi.layout<contiguous, lane_stride = 2>>

// LOWER-LABEL: func.func @group4_broadcast_i8_128(
// LOWER: pto.vselr
// LOWER-NOT: pto.vmi.

// LOWER-LABEL: func.func @group4_broadcast_bf16_64(
// LOWER: pto.vselr
// LOWER-NOT: pto.vmi.

// LOWER-LABEL: func.func @group4_broadcast_f32_32(
// LOWER: pto.vselr
// LOWER-NOT: pto.vmi.
