// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

// 128xf32 reduced with group=4 is a gb(4) shape (32 lanes per group) fed by a
// contiguous source, so its plan comes from the dense rows: the result carries
// one group value per physical part (slots=1) and is written back with one
// point store per group.  This pins that choice so a one-carrier slots=8 packet
// row cannot be introduced for the same shape unnoticed.

module {
  func.func @group_reduce_maxf_gb4_contiguous_slots1(
      %src: !pto.ptr<f32, ub>, %off: index, %scale_out: !pto.ptr<f32, ub>) {
    %c128 = arith.constant 128 : index
    %c1 = arith.constant 1 : index
    %mask = pto.vmi.create_mask %c128 : index -> !pto.vmi.mask<128xpred>
    %x = pto.vmi.vload %src[%off]
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<128xf32>
    %abs = pto.vmi.vabs %x
        : !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xf32>
    %amax = pto.vmi.vcmax %abs, %mask {group = 4}
        : !pto.vmi.vreg<128xf32>, !pto.vmi.mask<128xpred> -> !pto.vmi.vreg<4xf32>
    pto.vmi.vstore %amax, %scale_out[%off], %c1 {group = 4}
        : !pto.vmi.vreg<4xf32>, !pto.ptr<f32, ub>
    return
  }
}

// ASSIGN-LABEL: func.func @group_reduce_maxf_gb4_contiguous_slots1(
// ASSIGN: pto.vmi.group_reduce_maxf
// ASSIGN-SAME: -> !pto.vmi.vreg<4xf32, #pto.vmi.layout<num_groups = 4, slots = 1>>
// ASSIGN: pto.vmi.group_store
// ASSIGN-SAME: {num_groups = 4 : i64}

// LOWER-LABEL: func.func @group_reduce_maxf_gb4_contiguous_slots1(
// LOWER-COUNT-4: pto.vcmax
// LOWER-COUNT-4: pto.vsts {{.*}} {dist = "1PT_B32"}
// LOWER-NOT: pto.vmi.
