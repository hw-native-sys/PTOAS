// LOWER-LABEL: func.func @f32_fp8_f32_roundtrip(
// LOWER-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.ptr<bf16, ub>,
// LOWER-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: bf16,
// LOWER-SAME: %[[VAL_2:[a-zA-Z0-9_.$-]+]]: !pto.ptr<bf16, ub>) {
// LOWER-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = arith.constant 192 : index
// LOWER-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = arith.constant 64 : index
// LOWER-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = arith.constant 0.000000e+00 : bf16
// LOWER-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = arith.constant 128 : index
// LOWER-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : index
// LOWER-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.vlds %[[VAL_0]]{{\[}}%[[VAL_7]]] : !pto.ptr<bf16, ub>, index -> !pto.vreg<128xbf16>
