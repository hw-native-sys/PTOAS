// ASSIGN-NEXT: %[[VAL_12:[a-zA-Z0-9_.$-]+]] = pto.vmi.vmul %[[VAL_9]], %[[VAL_11]] : !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_13:[a-zA-Z0-9_.$-]+]] = pto.vmi.truncf %[[VAL_12]] {saturate = "SAT"} : !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN-NEXT: %[[VAL_14:[a-zA-Z0-9_.$-]+]] = pto.vmi.create_mask %[[VAL_4]] : index -> !pto.vmi.mask<256xb16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN-NEXT: pto.vmi.masked_store %[[VAL_13]], %[[VAL_2]]{{\[}}%[[VAL_3]]], %[[VAL_14]] : !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous, lane_stride = 2>>, !pto.ptr<bf16, ub>, !pto.vmi.mask<256xb16, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN-NEXT: return
