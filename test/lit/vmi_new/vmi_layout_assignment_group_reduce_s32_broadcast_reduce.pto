// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

module {
  func.func @vmi_layout_assignment_group_reduce_s32_broadcast_reduce(
      %source: !pto.vmi.vreg<256xf32>,
      %mask: !pto.vmi.mask<256xpred>,
      %dst: !pto.ptr<f32, ub>,
      %off: index) {
    %c1 = arith.constant 1 : index
    %sum = pto.vmi.vcadd %source, %mask
        {group = 8, reassoc}
        : !pto.vmi.vreg<256xf32>, !pto.vmi.mask<256xpred>
        -> !pto.vmi.vreg<8xf32>
    %broadcast = pto.vmi.vbrc %sum {group = 8}
        : !pto.vmi.vreg<8xf32> -> !pto.vmi.vreg<256xf32>
    %scaled = pto.vmi.vmul %source, %broadcast
        : !pto.vmi.vreg<256xf32>, !pto.vmi.vreg<256xf32>
        -> !pto.vmi.vreg<256xf32>
    %scaled_sum = pto.vmi.vcadd %scaled, %mask
        {group = 8, reassoc}
        : !pto.vmi.vreg<256xf32>, !pto.vmi.mask<256xpred>
        -> !pto.vmi.vreg<8xf32>
    pto.vmi.vstore %scaled_sum, %dst[%off], %c1 {group = 8}
        : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    return
  }
}

