// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

module {
  func.func @vmi_layout_assignment_group_reduce_s32_broadcast_reduce(
      %source: !pto.vmi.vreg<256xf32>,
      %mask: !pto.vmi.mask<256xpred>,
      %dst: !pto.ptr<f32, ub>,
      %off: index) {
    %c1 = arith.constant 1 : index
    %sum = pto.vmi.vcadd %source, %mask
        {group = 8, reassoc}
        : !pto.vmi.vreg<256xf32>, !pto.vmi.mask<256xpred>
        -> !pto.vmi.vreg<8xf32>
    %broadcast = pto.vmi.vbrc %sum {group = 8}
        : !pto.vmi.vreg<8xf32> -> !pto.vmi.vreg<256xf32>
    %scaled = pto.vmi.vmul %source, %broadcast
        : !pto.vmi.vreg<256xf32>, !pto.vmi.vreg<256xf32>
        -> !pto.vmi.vreg<256xf32>
    %scaled_sum = pto.vmi.vcadd %scaled, %mask
        {group = 8, reassoc}
        : !pto.vmi.vreg<256xf32>, !pto.vmi.mask<256xpred>
        -> !pto.vmi.vreg<8xf32>
    pto.vmi.vstore %scaled_sum, %dst[%off], %c1 {group = 8}
        : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    return
  }
}

// ASSIGN-LABEL: func.func @vmi_layout_assignment_group_reduce_s32_broadcast_reduce(
// ASSIGN-SAME: %[[SOURCE:arg[0-9]+]]: !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>
// ASSIGN: %[[SOURCE_GROUP:.*]] = pto.vmi.ensure_layout %[[SOURCE]]
// ASSIGN-SAME: -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN: %[[SUM:.*]] = pto.vmi.group_reduce_addf %[[SOURCE_GROUP]]
// ASSIGN-SAME: -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// ASSIGN: %[[BROADCAST:.*]] = pto.vmi.group_broadcast %[[SUM]]
// ASSIGN-SAME: -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN: %[[SOURCE_GROUP_2:.*]] = pto.vmi.ensure_layout %[[SOURCE]]
// ASSIGN-SAME: -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN: %[[SCALED:.*]] = pto.vmi.mulf %[[SOURCE_GROUP_2]], %[[BROADCAST]]
// ASSIGN-SAME: -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN: %[[SCALED_SUM:.*]] = pto.vmi.group_reduce_addf %[[SCALED]]

// LOWER-LABEL: func.func @vmi_layout_assignment_group_reduce_s32_broadcast_reduce(
// LOWER: %[[IOTA:.*]] = pto.vci {{.*}} -> !pto.vreg<64xui32>
// LOWER: %[[RAMP:.*]] = pto.vshrs %[[IOTA]], {{.*}}
// LOWER-COUNT-4: pto.vselr {{.*}}, %[[RAMP]]
// LOWER-NOT: pto.vsel {{.*}}
// LOWER-NOT: pto.vdup
// LOWER-COUNT-4: pto.vmul
// LOWER: pto.init_align
// LOWER: pto.vstus
// LOWER: pto.vstas
// LOWER-NOT: pto.vmi.
// LOWER-NOT: !pto.vmi.
// LOWER-NOT: unrealized_conversion_cast
