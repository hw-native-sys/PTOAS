// ASSIGN-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_broadcast %[[VAL_5]] {num_groups = 8 : i64} : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>> -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.vmi.vmul %[[VAL_0]], %[[VAL_6]] : !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_reduce_addf %[[VAL_7]], %[[VAL_1]] {num_groups = 8 : i64, reassoc} : !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>>
// ASSIGN-NEXT: pto.vmi.group_store %[[VAL_8]], %[[VAL_2]]{{\[}}%[[VAL_3]]], %[[VAL_4]] {num_groups = 8 : i64} : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>>, !pto.ptr<f32, ub>
// ASSIGN-NEXT: return
