// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s

// vunzip / vzip keep the logical lane count and only change the element width.
// A wide source register holds one half of every element, so bitcasting it to
// the half-width carrier interleaves the two halves and a single pto.vdintlv
// separates them again (pto.vintlv merges them for vzip).  The same lowering
// covers 32 -> 16 and 16 -> 8: it depends only on the element widths, not on
// the lane count.
//
// The op is a pure layout pass-through: whichever side fixes a layout the
// others follow, so the halves always carry the wide operand's layout and the
// one lowering above covers every layout the assignment may pick -- here
// contiguous, deinterleaved, lane strided and group-slotted.

module {
  func.func @vunzip_contiguous_128(
      %src: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>)
      -> (!pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>) {
    %low, %high = pto.vmi.vunzip %src
        : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>
    return %low, %high : !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>
  }

  func.func @vunzip_deinterleaved_256(
      %src: !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>>)
      -> (!pto.vmi.vreg<256xui16, #pto.vmi.layout<deinterleaved = 2>>, !pto.vmi.vreg<256xui16, #pto.vmi.layout<deinterleaved = 2>>) {
    %low, %high = pto.vmi.vunzip %src
        : !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>>
        -> !pto.vmi.vreg<256xui16, #pto.vmi.layout<deinterleaved = 2>>, !pto.vmi.vreg<256xui16, #pto.vmi.layout<deinterleaved = 2>>
    return %low, %high : !pto.vmi.vreg<256xui16, #pto.vmi.layout<deinterleaved = 2>>, !pto.vmi.vreg<256xui16, #pto.vmi.layout<deinterleaved = 2>>
  }

  func.func @vunzip_lane_stride_128(
      %src: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous, lane_stride = 2>>)
      -> (!pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>, !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>) {
    %low, %high = pto.vmi.vunzip %src
        : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous, lane_stride = 2>>
        -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>, !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>
    return %low, %high : !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>, !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous, lane_stride = 2>>
  }

  func.func @vunzip_group_slots_8(
      %src: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>)
      -> (!pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8>>, !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8>>) {
    %low, %high = pto.vmi.vunzip %src
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8>>, !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8>>
    return %low, %high : !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8>>, !pto.vmi.vreg<8xui16, #pto.vmi.layout<num_groups = 8, slots = 8>>
  }

  func.func @vunzip_ui16_to_ui8_128(
      %src: !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>)
      -> (!pto.vmi.vreg<128xui8, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<128xui8, #pto.vmi.layout<contiguous>>) {
    %low, %high = pto.vmi.vunzip %src
        : !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xui8, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<128xui8, #pto.vmi.layout<contiguous>>
    return %low, %high : !pto.vmi.vreg<128xui8, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<128xui8, #pto.vmi.layout<contiguous>>
  }

  func.func @vunzip_ui16_to_ui8_256(
      %src: !pto.vmi.vreg<256xui16, #pto.vmi.layout<contiguous>>)
      -> (!pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous>>) {
    %low, %high = pto.vmi.vunzip %src
        : !pto.vmi.vreg<256xui16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous>>
    return %low, %high : !pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous>>
  }

  func.func @vzip_contiguous_128(
      %low: !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>, %high: !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<128xui32, #pto.vmi.layout<contiguous>> {
    %r = pto.vmi.vzip %low, %high
        : !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xui32, #pto.vmi.layout<contiguous>>
    return %r : !pto.vmi.vreg<128xui32, #pto.vmi.layout<contiguous>>
  }

  func.func @vzip_ui8_to_ui16_128(
      %low: !pto.vmi.vreg<128xui8, #pto.vmi.layout<contiguous>>, %high: !pto.vmi.vreg<128xui8, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>> {
    %r = pto.vmi.vzip %low, %high
        : !pto.vmi.vreg<128xui8, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<128xui8, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>
    return %r : !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>
  }

  func.func @vzip_ui8_to_ui16_256(
      %low: !pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous>>, %high: !pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<256xui16, #pto.vmi.layout<contiguous>> {
    %r = pto.vmi.vzip %low, %high
        : !pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<256xui16, #pto.vmi.layout<contiguous>>
    return %r : !pto.vmi.vreg<256xui16, #pto.vmi.layout<contiguous>>
  }

  func.func @vzip_deinterleaved_256(
      %low: !pto.vmi.vreg<256xui8, #pto.vmi.layout<deinterleaved = 2>>, %high: !pto.vmi.vreg<256xui8, #pto.vmi.layout<deinterleaved = 2>>)
      -> !pto.vmi.vreg<256xui16, #pto.vmi.layout<deinterleaved = 2>> {
    %r = pto.vmi.vzip %low, %high
        : !pto.vmi.vreg<256xui8, #pto.vmi.layout<deinterleaved = 2>>, !pto.vmi.vreg<256xui8, #pto.vmi.layout<deinterleaved = 2>>
        -> !pto.vmi.vreg<256xui16, #pto.vmi.layout<deinterleaved = 2>>
    return %r : !pto.vmi.vreg<256xui16, #pto.vmi.layout<deinterleaved = 2>>
  }

}
// The passing, deinterleaved, lane-strided and group-slotted sources all take
// the same path: one pto.vdintlv per wide part pair, and the layout never
// appears in the lowering.  A half-full result reuses its single source
// register as both operands.
// CHECK-LABEL: func.func @vunzip_contiguous_128
// CHECK: %[[A:.*]] = pto.vbitcast {{.*}} : !pto.vreg<64xf32> -> !pto.vreg<128xui16>
// CHECK: %[[B:.*]] = pto.vbitcast {{.*}} : !pto.vreg<64xf32> -> !pto.vreg<128xui16>
// CHECK: %[[LOW:.*]], %[[HIGH:.*]] = pto.vdintlv %[[A]], %[[B]] : !pto.vreg<128xui16>, !pto.vreg<128xui16> -> !pto.vreg<128xui16>, !pto.vreg<128xui16>
// CHECK: return %[[LOW]], %[[HIGH]]

// CHECK-LABEL: func.func @vunzip_deinterleaved_256
// CHECK: %[[A:.*]] = pto.vbitcast {{.*}} : !pto.vreg<64xf32> -> !pto.vreg<128xui16>
// CHECK: %[[B:.*]] = pto.vbitcast {{.*}} : !pto.vreg<64xf32> -> !pto.vreg<128xui16>
// CHECK: %[[L0:.*]], %[[H0:.*]] = pto.vdintlv %[[A]], %[[B]]
// CHECK: %[[C:.*]] = pto.vbitcast {{.*}} : !pto.vreg<64xf32> -> !pto.vreg<128xui16>
// CHECK: %[[D:.*]] = pto.vbitcast {{.*}} : !pto.vreg<64xf32> -> !pto.vreg<128xui16>
// CHECK: %[[L1:.*]], %[[H1:.*]] = pto.vdintlv %[[C]], %[[D]]
// CHECK: return %[[L0]], %[[L1]], %[[H0]], %[[H1]]

// CHECK-LABEL: func.func @vunzip_lane_stride_128
// CHECK: %[[A:.*]] = pto.vbitcast {{.*}} : !pto.vreg<64xf32> -> !pto.vreg<128xui16>
// CHECK: %[[B:.*]] = pto.vbitcast {{.*}} : !pto.vreg<64xf32> -> !pto.vreg<128xui16>
// CHECK: %[[L0:.*]], %[[H0:.*]] = pto.vdintlv %[[A]], %[[B]]
// CHECK: %[[C:.*]] = pto.vbitcast {{.*}} : !pto.vreg<64xf32> -> !pto.vreg<128xui16>
// CHECK: %[[D:.*]] = pto.vbitcast {{.*}} : !pto.vreg<64xf32> -> !pto.vreg<128xui16>
// CHECK: %[[L1:.*]], %[[H1:.*]] = pto.vdintlv %[[C]], %[[D]]
// CHECK: return %[[L0]], %[[L1]], %[[H0]], %[[H1]]

// CHECK-LABEL: func.func @vunzip_group_slots_8
// CHECK: %[[A:.*]] = pto.vbitcast {{.*}} : !pto.vreg<64xf32> -> !pto.vreg<128xui16>
// CHECK: %[[LOW:.*]], %[[HIGH:.*]] = pto.vdintlv %[[A]], %[[A]] : !pto.vreg<128xui16>, !pto.vreg<128xui16> -> !pto.vreg<128xui16>, !pto.vreg<128xui16>
// CHECK: return %[[LOW]], %[[HIGH]]

// CHECK-LABEL: func.func @vunzip_ui16_to_ui8_128
// CHECK: %[[A:.*]] = pto.vbitcast {{.*}} : !pto.vreg<128xui16> -> !pto.vreg<256xui8>
// CHECK: %[[LOW:.*]], %[[HIGH:.*]] = pto.vdintlv %[[A]], %[[A]] : !pto.vreg<256xui8>, !pto.vreg<256xui8> -> !pto.vreg<256xui8>, !pto.vreg<256xui8>
// CHECK: return %[[LOW]], %[[HIGH]]

// CHECK-LABEL: func.func @vunzip_ui16_to_ui8_256
// CHECK: %[[A:.*]] = pto.vbitcast {{.*}} : !pto.vreg<128xui16> -> !pto.vreg<256xui8>
// CHECK: %[[B:.*]] = pto.vbitcast {{.*}} : !pto.vreg<128xui16> -> !pto.vreg<256xui8>
// CHECK: %[[LOW:.*]], %[[HIGH:.*]] = pto.vdintlv %[[A]], %[[B]] : !pto.vreg<256xui8>, !pto.vreg<256xui8> -> !pto.vreg<256xui8>, !pto.vreg<256xui8>
// CHECK: return %[[LOW]], %[[HIGH]]

// CHECK-LABEL: func.func @vzip_contiguous_128
// CHECK: %[[LOW:.*]], %[[HIGH:.*]] = pto.vintlv {{.*}} : !pto.vreg<128xui16>, !pto.vreg<128xui16> -> !pto.vreg<128xui16>, !pto.vreg<128xui16>
// CHECK: %[[P0:.*]] = pto.vbitcast %[[LOW]] : !pto.vreg<128xui16> -> !pto.vreg<64xui32>
// CHECK: %[[P1:.*]] = pto.vbitcast %[[HIGH]] : !pto.vreg<128xui16> -> !pto.vreg<64xui32>
// CHECK: return %[[P0]], %[[P1]]

// CHECK-LABEL: func.func @vzip_ui8_to_ui16_128
// CHECK: %[[LOW:.*]], %[[HIGH:.*]] = pto.vintlv {{.*}} : !pto.vreg<256xui8>, !pto.vreg<256xui8> -> !pto.vreg<256xui8>, !pto.vreg<256xui8>
// CHECK: %[[R0:.*]] = pto.vbitcast %[[LOW]] : !pto.vreg<256xui8> -> !pto.vreg<128xui16>
// CHECK: return %[[R0]]

// CHECK-LABEL: func.func @vzip_ui8_to_ui16_256
// CHECK: %[[LOW:.*]], %[[HIGH:.*]] = pto.vintlv {{.*}} : !pto.vreg<256xui8>, !pto.vreg<256xui8> -> !pto.vreg<256xui8>, !pto.vreg<256xui8>
// CHECK: %[[P0:.*]] = pto.vbitcast %[[LOW]] : !pto.vreg<256xui8> -> !pto.vreg<128xui16>
// CHECK: %[[P1:.*]] = pto.vbitcast %[[HIGH]] : !pto.vreg<256xui8> -> !pto.vreg<128xui16>
// CHECK: return %[[P0]], %[[P1]]

// The deinterleaved merge pairs the low and high operands group by group.
// CHECK-LABEL: func.func @vzip_deinterleaved_256
// CHECK: %[[LOW:.*]], %[[HIGH:.*]] = pto.vintlv %arg0, %arg2 : !pto.vreg<256xui8>, !pto.vreg<256xui8> -> !pto.vreg<256xui8>, !pto.vreg<256xui8>
// CHECK: %[[P0:.*]] = pto.vbitcast %[[LOW]] : !pto.vreg<256xui8> -> !pto.vreg<128xui16>
// CHECK: %[[LOW1:.*]], %[[HIGH1:.*]] = pto.vintlv %arg1, %arg3 : !pto.vreg<256xui8>, !pto.vreg<256xui8> -> !pto.vreg<256xui8>, !pto.vreg<256xui8>
// CHECK: %[[P1:.*]] = pto.vbitcast %[[LOW1]] : !pto.vreg<256xui8> -> !pto.vreg<128xui16>
// CHECK: return %[[P0]], %[[P1]]

// CHECK-NOT: pto.vmi.
// CHECK-NOT: unrealized_conversion_cast
