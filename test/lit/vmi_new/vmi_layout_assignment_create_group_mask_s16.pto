// ASSIGN-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_load %[[VAL_0]]{{\[}}%[[VAL_2]]], %[[VAL_5]] {num_groups = 8 : i64} : !pto.ptr<f32, ub> -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<block_deinterleaved = 2>>
// ASSIGN-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.vmi.create_group_mask %[[VAL_4]] {group_size = 16 : i64, num_groups = 8 : i64} : index -> !pto.vmi.mask<128xb32, #pto.vmi.layout<block_deinterleaved = 2>>
// ASSIGN-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_reduce_addf %[[VAL_6]], %[[VAL_7]] {num_groups = 8 : i64, reassoc} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<block_deinterleaved = 2>>, !pto.vmi.mask<128xb32, #pto.vmi.layout<block_deinterleaved = 2>> -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// ASSIGN-NEXT: pto.vmi.group_store %[[VAL_8]], %[[VAL_1]]{{\[}}%[[VAL_2]]], %[[VAL_3]] {num_groups = 8 : i64} : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>, !pto.ptr<f32, ub>
// ASSIGN-NEXT: return
// ASSIGN-NEXT: }

