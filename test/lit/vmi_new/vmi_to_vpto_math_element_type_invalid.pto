// RUN: not pto-test-opt %s -split-input-file -vmi-lower-unified-to-legacy -vmi-to-vpto 2>&1 | FileCheck %s

module {
  func.func @vmi_to_vpto_addf_f8_invalid(
      %lhs: !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>,
      %rhs: !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>) {
    %out = pto.vmi.vadd %lhs, %rhs
        : !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: 'pto.vmi.vadd' op requires i8, i16, i32, f16, bf16, or f32 VMI element type

// -----

module {
  func.func @vmi_to_vpto_divf_bf16_invalid(
      %lhs: !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>,
      %rhs: !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>) {
    %out = pto.vmi.vdiv %lhs, %rhs
        : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: 'pto.vmi.vdiv' op requires f16 or f32 VMI element type

// -----

module {
  func.func @vmi_to_vpto_sqrt_bf16_invalid(
      %source: !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>) {
    %out = pto.vmi.vsqrt %source
        : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: 'pto.vmi.vsqrt' op requires f16 or f32 VMI element type

// -----

module {
  func.func @vmi_to_vpto_exp_f8_invalid(
      %source: !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>) {
    %out = pto.vmi.vexp %source
        : !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: 'pto.vmi.vexp' op requires f16 or f32 VMI element type

// -----

module {
  func.func @vmi_to_vpto_negf_bf16_invalid(
      %source: !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>) {
    %out = pto.vmi.vneg %source
        : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: 'pto.vmi.vneg' op requires i8, i16, i32, f16, or f32 VMI element type

// -----

module {
  func.func @vmi_to_vpto_ln_bf16_invalid(
      %source: !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>) {
    %out = pto.vmi.vln %source
        : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: 'pto.vmi.vln' op requires f16 or f32 VMI element type

// -----

module {
  func.func @vmi_to_vpto_absi_unsigned_invalid(
      %source: !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>) {
    %out = pto.vmi.vabs %source
        : !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: 'pto.vmi.vabs' op requires si8, si16, si32, f16, bf16, or f32 VMI element type

// -----

module {
  func.func @vmi_to_vpto_absi_signless_invalid(
      %source: !pto.vmi.vreg<128xi16, #pto.vmi.layout<contiguous>>) {
    %out = pto.vmi.vabs %source
        : !pto.vmi.vreg<128xi16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xi16, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: 'pto.vmi.vabs' op requires si8, si16, si32, f16, bf16, or f32 VMI element type

// -----

module {
  func.func @vmi_to_vpto_muli_i8_invalid(
      %lhs: !pto.vmi.vreg<256xi8, #pto.vmi.layout<contiguous>>,
      %rhs: !pto.vmi.vreg<256xi8, #pto.vmi.layout<contiguous>>) {
    %out = pto.vmi.vmul %lhs, %rhs
        : !pto.vmi.vreg<256xi8, #pto.vmi.layout<contiguous>>,
          !pto.vmi.vreg<256xi8, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<256xi8, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: 'pto.vmi.vmul' op requires i16, i32, f16, bf16, or f32 VMI element type

// -----

module {
  func.func @vmi_to_vpto_vmuls_bf16_invalid(
      %source: !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>,
      %scalar: bf16,
      %mask: !pto.vmi.mask<128xpred>) {
    %out = pto.vmi.vmuls %source, %scalar, %mask
        : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>, bf16,
          !pto.vmi.mask<128xpred>
        -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: 'pto.vmi.vmuls' op requires i16, i32, f16, or f32 VMI element type
