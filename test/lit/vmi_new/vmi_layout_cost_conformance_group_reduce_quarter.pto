// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance | FileCheck %s
// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance -vmi-to-vpto -test-vmi-layout-lowering-conformance > /dev/null

module {
  func.func @quarter_block(
      %source: !pto.vmi.vreg<64xi8,
          #pto.vmi.layout<contiguous, lane_stride = 4>>,
      %mask: !pto.vmi.mask<64xb8,
          #pto.vmi.layout<contiguous, lane_stride = 4>>)
      -> !pto.vmi.vreg<8xi8,
          #pto.vmi.layout<num_groups = 8, slots = 8>> {
    %result = pto.vmi.group_reduce_addi %source, %mask {
        num_groups = 8, test.vmi_layout_cost_conformance
      } : !pto.vmi.vreg<64xi8,
            #pto.vmi.layout<contiguous, lane_stride = 4>>,
          !pto.vmi.mask<64xb8,
            #pto.vmi.layout<contiguous, lane_stride = 4>>
        -> !pto.vmi.vreg<8xi8,
            #pto.vmi.layout<num_groups = 8, slots = 8>>
    return %result : !pto.vmi.vreg<8xi8,
        #pto.vmi.layout<num_groups = 8, slots = 8>>
  }
}

// CHECK: quarter_block pto.vmi.group_reduce_addi relation=0 cost=0
// CHECK: quarter_block pto.vmi.group_reduce_addi relations=1
