// RUN: ptoas --pto-arch=a5 --pto-level=level3 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s --check-prefix=LOWER --implicit-check-not='pto.vmi.'

// These reductions consume explicitly extended 16-bit inputs. Eight-bit
// stores and broadcasts of their explicitly truncated results remain legal.
module {
 func.func @si8_vl128_g1_add(%src: !pto.ptr<si8, ub>, %dst: !pto.ptr<si8, ub>, %active: index) {
 %zero = arith.constant 0 : index
 %x = pto.vmi.vload %src[%zero] : !pto.ptr<si8, ub> -> !pto.vmi.vreg<128xsi8>
 %mask = pto.vmi.create_mask %active : index -> !pto.vmi.mask<128xpred>
 %wide = pto.vmi.extsi %x : !pto.vmi.vreg<128xsi8> -> !pto.vmi.vreg<128xsi16>
 %wide_r = pto.vmi.vcadd %wide, %mask {group = 1} : !pto.vmi.vreg<128xsi16>, !pto.vmi.mask<128xpred> -> !pto.vmi.vreg<1xsi16>
 %r = pto.vmi.trunci %wide_r {saturate = "NOSAT"} : !pto.vmi.vreg<1xsi16> -> !pto.vmi.vreg<1xsi8>
 %b = pto.vmi.vbrc %r {group = 1} : !pto.vmi.vreg<1xsi8> -> !pto.vmi.vreg<128xsi8>
 pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<128xsi8>, !pto.ptr<si8, ub>
 return
 }
 func.func @ui8_vl64_g2_add(%src: !pto.ptr<ui8, ub>, %dst: !pto.ptr<ui8, ub>, %active: index) {
 %zero = arith.constant 0 : index
 %x = pto.vmi.vload %src[%zero] : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<64xui8>
 %mask = pto.vmi.create_mask %active : index -> !pto.vmi.mask<64xpred>
 %wide = pto.vmi.extui %x : !pto.vmi.vreg<64xui8> -> !pto.vmi.vreg<64xui16>
 %wide_r = pto.vmi.vcadd %wide, %mask {group = 2} : !pto.vmi.vreg<64xui16>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<2xui16>
 %r = pto.vmi.trunci %wide_r {saturate = "NOSAT"} : !pto.vmi.vreg<2xui16> -> !pto.vmi.vreg<2xui8>
 %b = pto.vmi.vbrc %r {group = 2} : !pto.vmi.vreg<2xui8> -> !pto.vmi.vreg<64xui8>
 pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<64xui8>, !pto.ptr<ui8, ub>
 return
 }
 func.func @ui8_vl64_g8_max(%src: !pto.ptr<ui8, ub>, %dst: !pto.ptr<ui8, ub>, %active: index) {
 %zero = arith.constant 0 : index
 %x = pto.vmi.vload %src[%zero] : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<64xui8>
 %mask = pto.vmi.create_mask %active : index -> !pto.vmi.mask<64xpred>
 %wide = pto.vmi.extui %x : !pto.vmi.vreg<64xui8> -> !pto.vmi.vreg<64xui16>
 %neutral = "pto.vmi.constant"() {value = dense<0> : vector<64xui16>} : () -> !pto.vmi.vreg<64xui16>
 %selected = pto.vmi.select %mask, %wide, %neutral : !pto.vmi.mask<64xpred>, !pto.vmi.vreg<64xui16>, !pto.vmi.vreg<64xui16> -> !pto.vmi.vreg<64xui16>
 %lanes = arith.constant 64 : index
 %all = pto.vmi.create_mask %lanes : index -> !pto.vmi.mask<64xpred>
 %wide_r = pto.vmi.vcmax %selected, %all {group = 8} : !pto.vmi.vreg<64xui16>, !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<8xui16>
 %r = pto.vmi.trunci %wide_r {saturate = "NOSAT"} : !pto.vmi.vreg<8xui16> -> !pto.vmi.vreg<8xui8>
 %b = pto.vmi.vbrc %r {group = 8} : !pto.vmi.vreg<8xui8> -> !pto.vmi.vreg<64xui8>
 pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<64xui8>, !pto.ptr<ui8, ub>
 return
 }
 func.func @ui8_vl256_g8_explicit_add(%src: !pto.ptr<ui8, ub>, %dst: !pto.ptr<ui8, ub>, %active: index) {
 %zero = arith.constant 0 : index
 %x = pto.vmi.vload %src[%zero] : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<256xui8>
 %mask = pto.vmi.create_mask %active : index -> !pto.vmi.mask<256xpred>
 %wide = pto.vmi.extui %x : !pto.vmi.vreg<256xui8> -> !pto.vmi.vreg<256xui16>
 %wide_r = pto.vmi.vcadd %wide, %mask {group = 8} : !pto.vmi.vreg<256xui16>, !pto.vmi.mask<256xpred> -> !pto.vmi.vreg<8xui16>
 %r = pto.vmi.trunci %wide_r {saturate = "NOSAT"} : !pto.vmi.vreg<8xui16> -> !pto.vmi.vreg<8xui8>
 %b = pto.vmi.vbrc %r {group = 8} : !pto.vmi.vreg<8xui8> -> !pto.vmi.vreg<256xui8>
 pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<256xui8>, !pto.ptr<ui8, ub>
 return
 }
 func.func @ui8_vl128_g8_explicit_add(%src: !pto.ptr<ui8, ub>, %dst: !pto.ptr<ui8, ub>, %active: index) {
 %zero = arith.constant 0 : index
 %x = pto.vmi.vload %src[%zero] : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<128xui8>
 %mask = pto.vmi.create_mask %active : index -> !pto.vmi.mask<128xpred>
 %wide = pto.vmi.extui %x : !pto.vmi.vreg<128xui8> -> !pto.vmi.vreg<128xui16>
 %wide_r = pto.vmi.vcadd %wide, %mask {group = 8} : !pto.vmi.vreg<128xui16>, !pto.vmi.mask<128xpred> -> !pto.vmi.vreg<8xui16>
 %r = pto.vmi.trunci %wide_r {saturate = "NOSAT"} : !pto.vmi.vreg<8xui16> -> !pto.vmi.vreg<8xui8>
 %b = pto.vmi.vbrc %r {group = 8} : !pto.vmi.vreg<8xui8> -> !pto.vmi.vreg<128xui8>
 pto.vmi.vstore %b, %dst[%zero] : !pto.vmi.vreg<128xui8>, !pto.ptr<ui8, ub>
 return
 }
}

// LOWER-LABEL: func.func @si8_vl128_g1_add
// LOWER: pto.vcadd
// LOWER-NOT: pto.vcvt {{.*}} -> !pto.vreg<256xsi8>
// LOWER-LABEL: func.func @ui8_vl64_g2_add
// The dense fallback returns one wide sum per group (slots=1), then
// broadcasts each group's low byte and selects the corresponding lanes.
// LOWER: pto.vcadd {{.*}} -> !pto.vreg<64xui32>
// LOWER: pto.vdup {{.*}} {position = "LOWEST"} : !pto.vreg<256xui8>
// LOWER: pto.vcadd {{.*}} -> !pto.vreg<64xui32>
// LOWER: pto.vdup {{.*}} {position = "LOWEST"} : !pto.vreg<256xui8>
// LOWER: pto.vsel
// LOWER-LABEL: func.func @ui8_vl64_g8_max
// LOWER: pto.pbitcast {{.*}}!pto.mask<b32> -> !pto.mask<b16>
// LOWER: pto.vshls
// LOWER: pto.vsel
// LOWER: pto.vselr
// LOWER-LABEL: func.func @ui8_vl256_g8_explicit_add
// LOWER-COUNT-2: pto.vcvt {{.*}}!pto.vreg<256xui8>{{.*}} -> !pto.vreg<128xui16>
// LOWER-COUNT-2: pto.vcgadd
// LOWER: pto.vadd
// LOWER-LABEL: func.func @ui8_vl128_g8_explicit_add
// LOWER: pto.vcgadd
// LOWER-NOT: pto.vpack
// LOWER-NOT: pto.vcvt
// LOWER-DAG: pto.vbitcast {{.*}}!pto.vreg<128xui16> -> !pto.vreg<256xui8>
// LOWER-DAG: pto.vshls
// LOWER: pto.vselr
