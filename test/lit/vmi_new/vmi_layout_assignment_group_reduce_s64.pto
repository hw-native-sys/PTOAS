// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s

// A compact group result (one scalar per group) is not carried across the
// function boundary; it is stored to UB through the group-store path.
module {
  func.func @vmi_layout_assignment_group_reduce_s64(
      %source: !pto.vmi.vreg<512xf32>,
      %mask: !pto.vmi.mask<512xpred>,
      %dst: !pto.ptr<f32, ub>, %off: index) {
    %c1 = arith.constant 1 : index
    %out = pto.vmi.vcadd %source, %mask {group = 8, reassoc}
        : !pto.vmi.vreg<512xf32>, !pto.vmi.mask<512xpred>
        -> !pto.vmi.vreg<8xf32>
    pto.vmi.vstore %out, %dst[%off], %c1 {group = 8}
        : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    return
  }
}

// CHECK-LABEL: func.func @vmi_layout_assignment_group_reduce_s64(
// CHECK-SAME: %arg0: !pto.vmi.vreg<512xf32, #pto.vmi.layout<contiguous>>
// CHECK-SAME: %arg1: !pto.vmi.mask<512xb32, #pto.vmi.layout<contiguous>>
// CHECK: %[[OUT:.*]] = pto.vmi.group_reduce_addf %arg0, %arg1
// CHECK-SAME: -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>>
// CHECK: pto.vmi.group_store %[[OUT]]
// CHECK-SAME: !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 1>>, {{(!pto\.ptr)?<f32, ub>}}
