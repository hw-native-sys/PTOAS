// RUN: pto-test-opt %s -vmi-set-fastmath=vmi-fastmath=true -vmi-lower-unified-to-legacy -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN

module attributes {pto.target_arch = "a5"} {
  func.func @round_a_store(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<bf16, ub>, %off: index) {
    %source = pto.vmi.vload %src[%off] : !pto.ptr<f32, ub>, index -> !pto.vmi.vreg<4xf32>
    %result = pto.vmi.vcvt %source {rounding = "A", saturate = "NOSAT"}
      : !pto.vmi.vreg<4xf32> -> !pto.vmi.vreg<4xbf16>
    pto.vmi.vstore %result, %dst[%off]
      : !pto.vmi.vreg<4xbf16>, !pto.ptr<bf16, ub>, index
    return
  }

  func.func @round_z_store(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<bf16, ub>, %off: index) {
    %source = pto.vmi.vload %src[%off] : !pto.ptr<f32, ub>, index -> !pto.vmi.vreg<4xf32>
    %result = pto.vmi.vcvt %source {rounding = "Z", saturate = "NOSAT"}
      : !pto.vmi.vreg<4xf32> -> !pto.vmi.vreg<4xbf16>
    pto.vmi.vstore %result, %dst[%off]
      : !pto.vmi.vreg<4xbf16>, !pto.ptr<bf16, ub>, index
    return
  }
}

// ASSIGN-LABEL: func.func @round_a_store
// ASSIGN: pto.vmi.truncf {{.*}} -> !pto.vmi.vreg<4xbf16, #pto.vmi.layout<num_groups = 4, slots = 8, lane_stride = 2>>
// ASSIGN: pto.vmi.ensure_layout {{.*}}lane_stride = 2>> -> !pto.vmi.vreg<4xbf16, #pto.vmi.layout<num_groups = 4, slots = 8>>
// ASSIGN: pto.vmi.group_store
// ASSIGN-LABEL: func.func @round_z_store
// ASSIGN: pto.vmi.truncf {{.*}} -> !pto.vmi.vreg<4xbf16, #pto.vmi.layout<num_groups = 4, slots = 8>>
// ASSIGN-NOT: pto.vmi.ensure_layout
// ASSIGN: pto.vmi.group_store
