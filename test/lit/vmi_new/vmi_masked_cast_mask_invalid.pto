// RUN: not pto-test-opt %s 2>&1 | FileCheck %s

// The conversion mask must match the source vector: wrong lane count and wrong
// granularity are rejected by the cast verifiers (issue #1671).

// CHECK: error: {{.*}}mask{{.*}}
module {
  func.func @masked_extf_lane_mismatch(%src: !pto.vmi.vreg<128xf16>, %mask: !pto.vmi.mask<64xb16>) -> !pto.vmi.vreg<128xf32> {
    %0 = pto.vmi.extf %src, %mask : !pto.vmi.vreg<128xf16>, !pto.vmi.mask<64xb16> -> !pto.vmi.vreg<128xf32>
    return %0 : !pto.vmi.vreg<128xf32>
  }
}
