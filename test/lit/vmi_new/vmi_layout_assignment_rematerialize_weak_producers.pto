// ASSIGN-NEXT: pto.vmi.store %[[VAL_12]], %[[VAL_3]]{{\[}}%[[VAL_7]]] : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>, !pto.ptr<f32, ub>
// ASSIGN-NEXT: %[[VAL_13:[a-zA-Z0-9_.$-]+]] = pto.vmi.create_mask %[[VAL_5]] : index -> !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>
