// ASSIGN-NEXT: %[[VAL_20:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_reduce_addf %[[VAL_19]], %[[VAL_18]] {num_groups = 8 : i64, reassoc} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>, !pto.vmi.mask<128xb32, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
