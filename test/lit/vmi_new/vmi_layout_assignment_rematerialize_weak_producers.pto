// ASSIGN-NEXT: %[[VAL_15:[a-zA-Z0-9_.$-]+]] = pto.vmi.iota %[[VAL_2]] : f32 -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_16:[a-zA-Z0-9_.$-]+]] = pto.vmi.vadd %[[VAL_14]], %[[VAL_15]] : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_17:[a-zA-Z0-9_.$-]+]] = arith.constant 1 : index
// ASSIGN-NEXT: %[[VAL_18:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_mask_layout %[[VAL_8]] : !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.mask<128xb32, #pto.vmi.layout<deinterleaved = 2>>
