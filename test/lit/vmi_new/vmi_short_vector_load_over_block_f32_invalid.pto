// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto 2>&1 | FileCheck %s

// 16 f32 is 64 bytes: two VCG blocks.  A PtrType source with a dynamic offset
// cannot prove 32-byte alignment statically, so the bounded multi-block vsldb
// path is unavailable.  The stateful vldas+vldus fallback is used instead and
// emits a load-safety=warn remark.
module {
  func.func @over_block_f32_16(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<16xf32> {
    %v = pto.vmi.vload %src[%off] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<16xf32>
    return %v : !pto.vmi.vreg<16xf32>
  }
}

// CHECK: remark: VMI load physical read is not proven safe
// CHECK: pto.vldas
// CHECK: pto.vldus
// CHECK-NOT: pto.vsldb
