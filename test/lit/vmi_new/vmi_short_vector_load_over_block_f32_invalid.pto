// RUN: not pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto 2>&1 | FileCheck %s

// 16 f32 is 64 bytes: two VCG blocks. A dynamic offset without a 32-byte
// alignment proof cannot use the bounded multi-block vsldb path.
module {
  func.func @over_block_f32_16(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<16xf32> {
    %v = pto.vmi.vload %src[%off] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<16xf32>
    return %v : !pto.vmi.vreg<16xf32>
  }
}

// CHECK: VMI-UNSUPPORTED{{:}} bounded contiguous load requires a provably 32-byte-aligned effective address for pto.vsldb, including single-block reads; no safe unaligned full-read fallback: requires statically shaped memref source
