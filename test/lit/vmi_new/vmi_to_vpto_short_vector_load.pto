// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --implicit-check-not=pto.vmi. --implicit-check-not='!pto.vmi.'

// Multi-element short reads require a known aligned effective address and a
// caller-provided readable 32-byte block. These functions use explicit aligned
// UB addresses. The scalar case keeps an arbitrary element-aligned address.
module {
  func.func @block_ui8_8() -> !pto.vmi.vreg<8xui8> {
    %addr = arith.constant 1024 : i64
    %src = pto.castptr %addr : i64 -> !pto.ptr<ui8, ub>
    %off = arith.constant 0 : index
    %v = pto.vmi.vload %src[%off] : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<8xui8>
    return %v : !pto.vmi.vreg<8xui8>
  }

  func.func @block_ui8_32() -> !pto.vmi.vreg<32xui8> {
    %addr = arith.constant 1024 : i64
    %src = pto.castptr %addr : i64 -> !pto.ptr<ui8, ub>
    %off = arith.constant 0 : index
    %v = pto.vmi.vload %src[%off] : !pto.ptr<ui8, ub> -> !pto.vmi.vreg<32xui8>
    return %v : !pto.vmi.vreg<32xui8>
  }

  func.func @block_f16_16() -> !pto.vmi.vreg<16xf16> {
    %addr = arith.constant 1024 : i64
    %src = pto.castptr %addr : i64 -> !pto.ptr<f16, ub>
    %off = arith.constant 0 : index
    %v = pto.vmi.vload %src[%off] : !pto.ptr<f16, ub> -> !pto.vmi.vreg<16xf16>
    return %v : !pto.vmi.vreg<16xf16>
  }

  func.func @block_f32_8() -> !pto.vmi.vreg<8xf32> {
    %addr = arith.constant 1024 : i64
    %src = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
    %off = arith.constant 0 : index
    %v = pto.vmi.vload %src[%off] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<8xf32>
    return %v : !pto.vmi.vreg<8xf32>
  }

  // One element has no 32B-aligned base to give vsldb -- base + k only
  // guarantees element alignment -- so it broadcast-loads that element.
  func.func @scalar_f32(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<1xf32> {
    %v = pto.vmi.vload %src[%off] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<1xf32>
    return %v : !pto.vmi.vreg<1xf32>
  }
}

// CHECK-LABEL: func.func @block_ui8_8(
// CHECK: %[[Z:.*]] = arith.constant 0 : i16
// CHECK: %[[M:.*]] = pto.pset_b8 "PAT_VL1"
// CHECK: %[[B:.*]] = pto.addptr
// CHECK: pto.vsldb %[[B]], %[[Z]], %[[Z]], %[[M]]

// CHECK-LABEL: func.func @block_ui8_32(
// CHECK: pto.pset_b8 "PAT_VL1"
// CHECK: pto.vsldb

// CHECK-LABEL: func.func @block_f16_16(
// CHECK: pto.pset_b16 "PAT_VL1"
// CHECK: pto.vsldb

// CHECK-LABEL: func.func @block_f32_8(
// CHECK: pto.pset_b32 "PAT_VL1"
// CHECK: pto.vsldb

// CHECK-LABEL: func.func @scalar_f32(
// CHECK-NOT: pto.vsldb
// CHECK: pto.vlds {{.*}} {dist = "BRC_B32"}
