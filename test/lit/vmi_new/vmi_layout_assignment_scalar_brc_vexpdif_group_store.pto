// LOWER-NEXT: %[[VAL_19:[a-zA-Z0-9_.$-]+]] = pto.vcvt %[[VAL_15]], %[[VAL_16]] {part = "ODD", rnd = "R", sat = "SAT"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<128xbf16>
