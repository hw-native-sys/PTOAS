// LOWER-NEXT: %[[VAL_15:[a-zA-Z0-9_.$-]+]] = pto.vexpdif %[[VAL_9]], %[[VAL_11]], %[[VAL_13]], "ODD" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// LOWER-NEXT: %[[VAL_16:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
