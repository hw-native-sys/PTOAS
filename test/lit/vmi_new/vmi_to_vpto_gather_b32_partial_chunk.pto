// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s

// B32 gathers whose result fits in one partially filled physical chunk
// (issue #1638). Padding lanes stay masked off, so each case lowers to one
// pto.vgather2_bc over the full 64-lane physical register. The instruction
// zero-fills inactive lanes, so the zero-mode gather needs no pto.vsel.

module {
  func.func @gather_f32_vl1_allactive(
      %src: !pto.ptr<f32, ub>,
      %indices: !pto.vmi.vreg<1xi32, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<64xf32> {
    %c1 = arith.constant 1 : index
    %mask = pto.vmi.create_mask %c1 : index -> !pto.vmi.mask<1xb32, #pto.vmi.layout<contiguous>>
    %out = pto.vmi.vgather %src, %indices, %mask
        : !pto.ptr<f32, ub>,
          !pto.vmi.vreg<1xi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<1xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
    %p0 = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>) -> (!pto.vreg<64xf32>)
    return %p0 : !pto.vreg<64xf32>
  }

  func.func @gather_f32_vl2_allactive(
      %src: !pto.ptr<f32, ub>,
      %indices: !pto.vmi.vreg<2xi32, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<64xf32> {
    %c2 = arith.constant 2 : index
    %mask = pto.vmi.create_mask %c2 : index -> !pto.vmi.mask<2xb32, #pto.vmi.layout<contiguous>>
    %out = pto.vmi.vgather %src, %indices, %mask
        : !pto.ptr<f32, ub>,
          !pto.vmi.vreg<2xi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<2xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<2xf32, #pto.vmi.layout<contiguous>>
    %p0 = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<2xf32, #pto.vmi.layout<contiguous>>) -> (!pto.vreg<64xf32>)
    return %p0 : !pto.vreg<64xf32>
  }

  func.func @gather_f32_vl4_allactive(
      %src: !pto.ptr<f32, ub>,
      %indices: !pto.vmi.vreg<4xi32, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<64xf32> {
    %c4 = arith.constant 4 : index
    %mask = pto.vmi.create_mask %c4 : index -> !pto.vmi.mask<4xb32, #pto.vmi.layout<contiguous>>
    %out = pto.vmi.vgather %src, %indices, %mask
        : !pto.ptr<f32, ub>,
          !pto.vmi.vreg<4xi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<4xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<4xf32, #pto.vmi.layout<contiguous>>
    %p0 = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<4xf32, #pto.vmi.layout<contiguous>>) -> (!pto.vreg<64xf32>)
    return %p0 : !pto.vreg<64xf32>
  }

  func.func @gather_f32_vl8_allactive(
      %src: !pto.ptr<f32, ub>,
      %indices: !pto.vmi.vreg<8xi32, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<64xf32> {
    %c8 = arith.constant 8 : index
    %mask = pto.vmi.create_mask %c8 : index -> !pto.vmi.mask<8xb32, #pto.vmi.layout<contiguous>>
    %out = pto.vmi.vgather %src, %indices, %mask
        : !pto.ptr<f32, ub>,
          !pto.vmi.vreg<8xi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<8xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<contiguous>>
    %p0 = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<8xf32, #pto.vmi.layout<contiguous>>) -> (!pto.vreg<64xf32>)
    return %p0 : !pto.vreg<64xf32>
  }

  func.func @gather_f32_vl32_allactive(
      %src: !pto.ptr<f32, ub>,
      %indices: !pto.vmi.vreg<32xi32, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<64xf32> {
    %c32 = arith.constant 32 : index
    %mask = pto.vmi.create_mask %c32 : index -> !pto.vmi.mask<32xb32, #pto.vmi.layout<contiguous>>
    %out = pto.vmi.vgather %src, %indices, %mask
        : !pto.ptr<f32, ub>,
          !pto.vmi.vreg<32xi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<32xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<32xf32, #pto.vmi.layout<contiguous>>
    %p0 = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<32xf32, #pto.vmi.layout<contiguous>>) -> (!pto.vreg<64xf32>)
    return %p0 : !pto.vreg<64xf32>
  }

  func.func @gather_f32_vl8_dynamic(
      %src: !pto.ptr<f32, ub>,
      %indices: !pto.vmi.vreg<8xi32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<8xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<64xf32> {
    %out = pto.vmi.vgather %src, %indices, %mask
        : !pto.ptr<f32, ub>,
          !pto.vmi.vreg<8xi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<8xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<contiguous>>
    %p0 = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<8xf32, #pto.vmi.layout<contiguous>>) -> (!pto.vreg<64xf32>)
    return %p0 : !pto.vreg<64xf32>
  }

  func.func @gather_f32_vl8_prefix_mask(
      %src: !pto.ptr<f32, ub>,
      %indices: !pto.vmi.vreg<8xi32, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<64xf32> {
    %c4 = arith.constant 4 : index
    %mask = pto.vmi.create_mask %c4 : index -> !pto.vmi.mask<8xb32, #pto.vmi.layout<contiguous>>
    %out = pto.vmi.vgather %src, %indices, %mask
        : !pto.ptr<f32, ub>,
          !pto.vmi.vreg<8xi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<8xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<contiguous>>
    %p0 = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<8xf32, #pto.vmi.layout<contiguous>>) -> (!pto.vreg<64xf32>)
    return %p0 : !pto.vreg<64xf32>
  }

  func.func @gather_i32_vl8_allactive(
      %src: !pto.ptr<i32, ub>,
      %indices: !pto.vmi.vreg<8xi32, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<64xi32> {
    %c8 = arith.constant 8 : index
    %mask = pto.vmi.create_mask %c8 : index -> !pto.vmi.mask<8xb32, #pto.vmi.layout<contiguous>>
    %out = pto.vmi.vgather %src, %indices, %mask
        : !pto.ptr<i32, ub>,
          !pto.vmi.vreg<8xi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<8xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<8xi32, #pto.vmi.layout<contiguous>>
    %p0 = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<8xi32, #pto.vmi.layout<contiguous>>) -> (!pto.vreg<64xi32>)
    return %p0 : !pto.vreg<64xi32>
  }

  func.func @gather_ui32_vl8_allactive(
      %src: !pto.ptr<ui32, ub>,
      %indices: !pto.vmi.vreg<8xi32, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<64xui32> {
    %c8 = arith.constant 8 : index
    %mask = pto.vmi.create_mask %c8 : index -> !pto.vmi.mask<8xb32, #pto.vmi.layout<contiguous>>
    %out = pto.vmi.vgather %src, %indices, %mask
        : !pto.ptr<ui32, ub>,
          !pto.vmi.vreg<8xi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<8xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<8xui32, #pto.vmi.layout<contiguous>>
    %p0 = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<8xui32, #pto.vmi.layout<contiguous>>) -> (!pto.vreg<64xui32>)
    return %p0 : !pto.vreg<64xui32>
  }
}

// CHECK-LABEL: func.func @gather_f32_vl1_allactive(
// The gather mask activates exactly the 1 logical lanes, so every
// padding lane in the 64-lane physical register stays masked off.
// CHECK: %[[MASK:.*]] = pto.pset_b32 "PAT_VL1" : !pto.mask<b32>
// CHECK: pto.vgather2_bc %arg0, %arg1, %[[MASK]] : !pto.ptr<f32, ub>, !pto.vreg<64xi32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NOT: pto.vsel
// CHECK: return

// CHECK-LABEL: func.func @gather_f32_vl2_allactive(
// The gather mask activates exactly the 2 logical lanes, so every
// padding lane in the 64-lane physical register stays masked off.
// CHECK: %[[MASK:.*]] = pto.pset_b32 "PAT_VL2" : !pto.mask<b32>
// CHECK: pto.vgather2_bc %arg0, %arg1, %[[MASK]] : !pto.ptr<f32, ub>, !pto.vreg<64xi32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NOT: pto.vsel
// CHECK: return

// CHECK-LABEL: func.func @gather_f32_vl4_allactive(
// The gather mask activates exactly the 4 logical lanes, so every
// padding lane in the 64-lane physical register stays masked off.
// CHECK: %[[MASK:.*]] = pto.pset_b32 "PAT_VL4" : !pto.mask<b32>
// CHECK: pto.vgather2_bc %arg0, %arg1, %[[MASK]] : !pto.ptr<f32, ub>, !pto.vreg<64xi32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NOT: pto.vsel
// CHECK: return

// CHECK-LABEL: func.func @gather_f32_vl8_allactive(
// The gather mask activates exactly the 8 logical lanes, so every
// padding lane in the 64-lane physical register stays masked off.
// CHECK: %[[MASK:.*]] = pto.pset_b32 "PAT_VL8" : !pto.mask<b32>
// CHECK: pto.vgather2_bc %arg0, %arg1, %[[MASK]] : !pto.ptr<f32, ub>, !pto.vreg<64xi32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NOT: pto.vsel
// CHECK: return

// CHECK-LABEL: func.func @gather_f32_vl32_allactive(
// The gather mask activates exactly the 32 logical lanes, so every
// padding lane in the 64-lane physical register stays masked off.
// CHECK: %[[MASK:.*]] = pto.pset_b32 "PAT_VL32" : !pto.mask<b32>
// CHECK: pto.vgather2_bc %arg0, %arg1, %[[MASK]] : !pto.ptr<f32, ub>, !pto.vreg<64xi32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NOT: pto.vsel
// CHECK: return

// CHECK-LABEL: func.func @gather_f32_vl8_dynamic(
// CHECK: %[[GATHER:.*]] = pto.vgather2_bc %arg0, %arg1, %arg2 : !pto.ptr<f32, ub>, !pto.vreg<64xi32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NEXT: return %[[GATHER]]

// CHECK-LABEL: func.func @gather_f32_vl8_prefix_mask(
// Only the first 4 of 8 logical lanes read memory. The gather also
// zero-fills the inactive logical lanes and the padding lanes.
// CHECK: %[[MASK:.*]] = pto.pset_b32 "PAT_VL4" : !pto.mask<b32>
// CHECK: %[[GATHER:.*]] = pto.vgather2_bc %arg0, %arg1, %[[MASK]] : !pto.ptr<f32, ub>, !pto.vreg<64xi32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NEXT: return %[[GATHER]]

// CHECK-LABEL: func.func @gather_i32_vl8_allactive(
// CHECK: %[[MASK:.*]] = pto.pset_b32 "PAT_VL8" : !pto.mask<b32>
// CHECK: pto.vgather2_bc %arg0, %arg1, %[[MASK]] : !pto.ptr<i32, ub>, !pto.vreg<64xi32>, !pto.mask<b32> -> !pto.vreg<64xi32>
// CHECK-NOT: pto.vsel
// CHECK: return

// CHECK-LABEL: func.func @gather_ui32_vl8_allactive(
// CHECK: %[[MASK:.*]] = pto.pset_b32 "PAT_VL8" : !pto.mask<b32>
// CHECK: pto.vgather2_bc %arg0, %arg1, %[[MASK]] : !pto.ptr<ui32, ub>, !pto.vreg<64xi32>, !pto.mask<b32> -> !pto.vreg<64xui32>
// CHECK-NOT: pto.vsel
// CHECK: return
