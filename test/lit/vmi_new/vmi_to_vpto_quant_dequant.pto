// CHECK-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: f32,
// CHECK-SAME: %[[VAL_2:[a-zA-Z0-9_.$-]+]]: !pto.ptr<f32, ub>,
// CHECK-SAME: %[[VAL_3:[a-zA-Z0-9_.$-]+]]: index,
// CHECK-SAME: %[[VAL_4:[a-zA-Z0-9_.$-]+]]: index,
// CHECK-SAME: %[[VAL_5:[a-zA-Z0-9_.$-]+]]: index,
// CHECK-SAME: %[[VAL_6:[a-zA-Z0-9_.$-]+]]: index,
// CHECK-SAME: %[[VAL_7:[a-zA-Z0-9_.$-]+]]: index) {
// CHECK-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = arith.constant 64 : index
// CHECK-NEXT: %[[VAL_9:[a-zA-Z0-9_.$-]+]] = arith.constant 128 : i32
// CHECK-NEXT: %[[VAL_10:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : i32
// CHECK-NEXT: %[[VAL_11:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : index
// CHECK-NEXT: %[[VAL_12:[a-zA-Z0-9_.$-]+]] = arith.constant 1 : index
// CHECK-NEXT: %[[VAL_13:[a-zA-Z0-9_.$-]+]] = arith.constant 128 : index
// CHECK-NEXT: %[[VAL_14:[a-zA-Z0-9_.$-]+]] = arith.muli %[[VAL_6]], %[[VAL_13]] : index
// CHECK-NEXT: %[[VAL_15:[a-zA-Z0-9_.$-]+]] = arith.muli %[[VAL_7]], %[[VAL_13]] : index
// CHECK-NEXT: %[[VAL_16:[a-zA-Z0-9_.$-]+]] = arith.cmpi ne, %[[VAL_5]], %[[VAL_11]] : index
