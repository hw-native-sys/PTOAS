// CHECK-NEXT: %[[VAL_18:[a-zA-Z0-9_.$-]+]] = arith.muli %[[VAL_17]], %[[VAL_14]] : index
// CHECK-NEXT: %[[VAL_19:[a-zA-Z0-9_.$-]+]] = arith.muli %[[VAL_17]], %[[VAL_15]] : index
