// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance | FileCheck %s --check-prefix=COST
// RUN: pto-test-opt %s -test-vmi-layout-cost-conformance -vmi-to-vpto -test-vmi-layout-lowering-conformance > /dev/null

module {
  func.func @quarter_block_lane_stride4(
      %src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous, lane_stride = 4>> {
    %c1 = arith.constant 1 : index
    %value = pto.vmi.group_broadcast_load %src[%off], %c1
        {num_groups = 32 : i64, test.vmi_layout_cost_conformance}
        : !pto.ptr<f32, ub>
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous, lane_stride = 4>>
    return %value
        : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous, lane_stride = 4>>
  }

  func.func @half_block_lane_stride2(
      %src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous, lane_stride = 2>> {
    %c1 = arith.constant 1 : index
    %value = pto.vmi.group_broadcast_load %src[%off], %c1
        {num_groups = 16 : i64, test.vmi_layout_cost_conformance}
        : !pto.ptr<f32, ub>
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous, lane_stride = 2>>
    return %value
        : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous, lane_stride = 2>>
  }

  func.func @e2b_f32_one_block_deinterleaved4(
      %src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<deinterleaved = 4>> {
    %c1 = arith.constant 1 : index
    %value = pto.vmi.group_broadcast_load %src[%off], %c1
        {num_groups = 8 : i64, test.vmi_layout_cost_conformance}
        : !pto.ptr<f32, ub>
          -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<deinterleaved = 4>>
    return %value
        : !pto.vmi.vreg<64xf32, #pto.vmi.layout<deinterleaved = 4>>
  }

  func.func @two_blocks_contiguous(
      %src: !pto.ptr<f8E4M3FN, ub>, %off: index)
      -> !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>> {
    %c1 = arith.constant 1 : index
    %value = pto.vmi.group_broadcast_load %src[%off], %c1
        {num_groups = 4 : i64, test.vmi_layout_cost_conformance}
        : !pto.ptr<f8E4M3FN, ub>
          -> !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>
    return %value : !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>
  }

  func.func @four_blocks_contiguous(
      %src: !pto.ptr<f8E4M3FN, ub>, %off: index)
      -> !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>> {
    %c1 = arith.constant 1 : index
    %value = pto.vmi.group_broadcast_load %src[%off], %c1
        {num_groups = 2 : i64, test.vmi_layout_cost_conformance}
        : !pto.ptr<f8E4M3FN, ub>
          -> !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>
    return %value : !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>
  }

  func.func @full_group_contiguous(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>> {
    %c64 = arith.constant 64 : index
    %value = pto.vmi.group_broadcast_load %src[%off], %c64
        {num_groups = 2 : i64, test.vmi_layout_cost_conformance}
        : !pto.ptr<f32, ub>
          -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
    return %value : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
  }

  func.func @e2b_f32_deinterleaved4(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>> {
    %c1 = arith.constant 1 : index
    %value = pto.vmi.group_broadcast_load %src[%off], %c1
        {num_groups = 8 : i64, test.vmi_layout_cost_conformance}
        : !pto.ptr<f32, ub>
          -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>
    return %value
        : !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>
  }

  func.func @e2b_bf16_deinterleaved2(%src: !pto.ptr<bf16, ub>, %off: index)
      -> !pto.vmi.vreg<256xbf16, #pto.vmi.layout<deinterleaved = 2>> {
    %c1 = arith.constant 1 : index
    %value = pto.vmi.group_broadcast_load %src[%off], %c1
        {num_groups = 8 : i64, test.vmi_layout_cost_conformance}
        : !pto.ptr<bf16, ub>
          -> !pto.vmi.vreg<256xbf16, #pto.vmi.layout<deinterleaved = 2>>
    return %value
        : !pto.vmi.vreg<256xbf16, #pto.vmi.layout<deinterleaved = 2>>
  }

  func.func @brc_scalar_deinterleaved2(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>> {
    %c64 = arith.constant 64 : index
    %value = pto.vmi.group_broadcast_load %src[%off], %c64
        {num_groups = 1 : i64, test.vmi_layout_cost_conformance}
        : !pto.ptr<f32, ub>
          -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
    return %value
        : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
  }

  func.func @brc_scalar_deinterleaved4(%src: !pto.ptr<f32, ub>, %off: index)
      -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>> {
    %c64 = arith.constant 64 : index
    %value = pto.vmi.group_broadcast_load %src[%off], %c64
        {num_groups = 1 : i64, test.vmi_layout_cost_conformance}
        : !pto.ptr<f32, ub>
          -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>
    return %value
        : !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>
  }

  func.func @fallback_f8_contiguous(%src: !pto.ptr<f8E4M3FN, ub>, %off: index)
      -> !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>> {
    %c1 = arith.constant 1 : index
    %value = pto.vmi.group_broadcast_load %src[%off], %c1
        {num_groups = 8 : i64, test.vmi_layout_cost_conformance}
        : !pto.ptr<f8E4M3FN, ub>
          -> !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>
    return %value
        : !pto.vmi.vreg<256xf8E4M3FN, #pto.vmi.layout<contiguous>>
  }
}

// COST: vmi-layout-cost-conformance quarter_block_lane_stride4 pto.vmi.group_broadcast_load relation=0 cost=0
// COST: vmi-layout-cost-conformance half_block_lane_stride2 pto.vmi.group_broadcast_load relation=0 cost=0
// COST: vmi-layout-cost-conformance e2b_f32_one_block_deinterleaved4 pto.vmi.group_broadcast_load relation=0 cost=0
// COST: vmi-layout-cost-conformance two_blocks_contiguous pto.vmi.group_broadcast_load relation=0 cost=0
// COST: vmi-layout-cost-conformance four_blocks_contiguous pto.vmi.group_broadcast_load relation=0 cost=0
// COST: vmi-layout-cost-conformance full_group_contiguous pto.vmi.group_broadcast_load relation=0 cost=0
// COST: vmi-layout-cost-conformance e2b_f32_deinterleaved4 pto.vmi.group_broadcast_load relation=0 cost=0
// COST: vmi-layout-cost-conformance-summary e2b_f32_deinterleaved4 pto.vmi.group_broadcast_load relations=1
// COST: vmi-layout-cost-conformance e2b_bf16_deinterleaved2 pto.vmi.group_broadcast_load relation=0 cost=0
// COST: vmi-layout-cost-conformance-summary e2b_bf16_deinterleaved2 pto.vmi.group_broadcast_load relations=1
// COST: vmi-layout-cost-conformance brc_scalar_deinterleaved2 pto.vmi.group_broadcast_load relation=0 cost=0
// COST: vmi-layout-cost-conformance-summary brc_scalar_deinterleaved2 pto.vmi.group_broadcast_load relations=1
// COST: vmi-layout-cost-conformance brc_scalar_deinterleaved4 pto.vmi.group_broadcast_load relation=0 cost=0
// COST: vmi-layout-cost-conformance-summary brc_scalar_deinterleaved4 pto.vmi.group_broadcast_load relations=1
// COST: vmi-layout-cost-conformance fallback_f8_contiguous pto.vmi.group_broadcast_load relation=0 cost=0
// COST: vmi-layout-cost-conformance-summary fallback_f8_contiguous pto.vmi.group_broadcast_load relations=1
