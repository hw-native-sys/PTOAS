// RUN: not pto-test-opt %s 2>&1 | FileCheck %s

// vunzip preserves the logical lane count; a result that narrows the lanes as
// well as the element width is invalid.

module {
  func.func @vunzip_lane_count_invalid(
      %src: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>) {
    %low, %high = pto.vmi.vunzip %src
        : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<64xui16, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<64xui16, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK: requires the lane count to be preserved
