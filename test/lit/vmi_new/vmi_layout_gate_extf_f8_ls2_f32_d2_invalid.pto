// RUN: not pto-test-opt %s -pto-validate-vmi-layout-ir 2>&1 | FileCheck %s

module {
  func.func @vmi_layout_gate_extf_f8_ls2_f32_d2_invalid(
      %source: !pto.vmi.vreg<256xf8E4M3FN,
          #pto.vmi.layout<contiguous, lane_stride = 2>>) {
    // CHECK: VMI-LAYOUT-CONTRACT: pto.vmi.extf has no registered layout support
    // CHECK-SAME: requires a legal cast relation for the source layout
    %result = pto.vmi.extf %source
        : !pto.vmi.vreg<256xf8E4M3FN,
            #pto.vmi.layout<contiguous, lane_stride = 2>>
        -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>>
    return
  }
}
