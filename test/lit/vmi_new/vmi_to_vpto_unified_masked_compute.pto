// RUN: pto-test-opt %s -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s

module {
  func.func @binary_all_off(%lhs: !pto.vmi.vreg<64xf32>,
                            %rhs: !pto.vmi.vreg<64xf32>)
      -> !pto.vmi.vreg<64xf32> {
    %c0 = arith.constant 0 : index
    %mask = pto.vmi.create_mask %c0 : index -> !pto.vmi.mask<64xpred>
    %result = pto.vmi.vadd %lhs, %rhs, %mask {pmode = "zero"}
        : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>,
          !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
    return %result : !pto.vmi.vreg<64xf32>
  }

  func.func @shift_partial(%lhs: !pto.vmi.vreg<64xsi32>,
                           %rhs: !pto.vmi.vreg<64xsi32>)
      -> !pto.vmi.vreg<64xsi32> {
    %c13 = arith.constant 13 : index
    %mask = pto.vmi.create_mask %c13 : index -> !pto.vmi.mask<64xpred>
    %result = pto.vmi.vshr %lhs, %rhs, %mask {pmode = "zero"}
        : !pto.vmi.vreg<64xsi32>, !pto.vmi.vreg<64xsi32>,
          !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xsi32>
    return %result : !pto.vmi.vreg<64xsi32>
  }

  func.func @unary_without_mask(%source: !pto.vmi.vreg<64xf32>)
      -> !pto.vmi.vreg<64xf32> {
    %result = pto.vmi.vneg %source {pmode = "zero"}
        : !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xf32>
    return %result : !pto.vmi.vreg<64xf32>
  }

  func.func @fused(%acc: !pto.vmi.vreg<64xf32>,
                   %lhs: !pto.vmi.vreg<64xf32>,
                   %rhs: !pto.vmi.vreg<64xf32>,
                   %mask: !pto.vmi.mask<64xpred>, %alpha: f32)
      -> (!pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>,
          !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>) {
    %mula = pto.vmi.vmula %acc, %lhs, %rhs, %mask {pmode = "zero"}
        : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>,
          !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred>
          -> !pto.vmi.vreg<64xf32>
    %axpy = "pto.vmi.vaxpy"(%lhs, %acc, %alpha, %mask) {pmode = "zero"}
        : (!pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, f32,
           !pto.vmi.mask<64xpred>) -> !pto.vmi.vreg<64xf32>
    %lrelu = "pto.vmi.vlrelu"(%lhs, %alpha, %mask) {pmode = "zero"}
        : (!pto.vmi.vreg<64xf32>, f32, !pto.vmi.mask<64xpred>)
          -> !pto.vmi.vreg<64xf32>
    %prelu = pto.vmi.vprelu %lhs, %rhs, %mask {pmode = "zero"}
        : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>,
          !pto.vmi.mask<64xpred> -> !pto.vmi.vreg<64xf32>
    return %mula, %axpy, %lrelu, %prelu
        : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>,
          !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>
  }
}

// CHECK-LABEL: func.func @binary_all_off
// CHECK: %[[OFF:.*]] = pto.pset_b32 "PAT_ALLF"
// CHECK: pto.vadd {{.*}}, %[[OFF]]
// CHECK-NOT: pto.vmi.
// CHECK-NOT: pto.vsel

// CHECK-LABEL: func.func @shift_partial
// CHECK: %[[PARTIAL:.*]], {{.*}} = pto.plt_b32
// CHECK: pto.vshr {{.*}}, %[[PARTIAL]]
// CHECK-NOT: pto.vmi.
// CHECK-NOT: pto.vsel

// CHECK-LABEL: func.func @unary_without_mask
// CHECK: %[[ALL:.*]] = pto.pset_b32 "PAT_ALL"
// CHECK: pto.vneg {{.*}}, %[[ALL]]
// CHECK-NOT: pto.vmi.
// CHECK-NOT: pto.vsel

// CHECK-LABEL: func.func @fused
// CHECK-SAME: %[[MASK:[^,]+]]: !pto.mask<b32>
// CHECK-DAG: pto.vmula {{.*}}, %[[MASK]]
// CHECK-DAG: pto.vaxpy {{.*}}, %[[MASK]]
// CHECK-DAG: pto.vlrelu {{.*}}, %[[MASK]]
// CHECK-DAG: pto.vprelu {{.*}}, %[[MASK]]
// CHECK-NOT: pto.vmi.
// CHECK-NOT: pto.vsel
