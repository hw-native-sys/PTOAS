// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

// Reverse widen (dequant) f4x2 -> bf16x2, compact path: lane-stride-4 source
// (1/4 active f4x2 lanes) -> contiguous bf16x2 result. Single vcvt{P0} 1:1
// plus the result-side bf16 -> bf16x2 reinterpret. No vor, no rnd, no sat.

module {
  func.func @f4e1m2x2_ls4_to_bf16x2_contiguous(
      %src: !pto.vmi.vreg<64x!pto.f4E1M2x2,
                           #pto.vmi.layout<contiguous, lane_stride = 4>>,
      %dst: !pto.ptr<!pto.bf16x2, ub>,
      %off: index) {
    %r = pto.vmi.vcvt %src
        : !pto.vmi.vreg<64x!pto.f4E1M2x2,
                        #pto.vmi.layout<contiguous, lane_stride = 4>>
       -> !pto.vmi.vreg<64x!pto.bf16x2, #pto.vmi.layout<contiguous>>
    pto.vmi.vstore %r, %dst[%off]
        : !pto.vmi.vreg<64x!pto.bf16x2, #pto.vmi.layout<contiguous>>,
          !pto.ptr<!pto.bf16x2, ub>
    return
  }
}

// LOWER-LABEL: func.func @f4e1m2x2_ls4_to_bf16x2_contiguous(
// LOWER: pto.pset_b8 "PAT_ALL" : !pto.mask<b8>
// LOWER: pto.vcvt {{.*}} {part = "P0"} : !pto.vreg<256x!pto.f4E1M2x2>, !pto.mask<b8> -> !pto.vreg<128xbf16>
// LOWER: pto.vbitcast {{.*}} : !pto.vreg<128xbf16> -> !pto.vreg<64x!pto.bf16x2>
// LOWER-NOT: pto.vor
// LOWER-NOT: rnd =
// LOWER-NOT: sat =
