// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s

// A compact group result (one scalar per group) is not carried across the
// function boundary; it is stored to UB through the group-store path.

module {
  func.func @group_reduce_addi_i16(
      %source: !pto.vmi.vreg<128xi16>,
      %mask: !pto.vmi.mask<128xpred>,
      %dst: !pto.ptr<i16, ub>, %off: index) {
    %c1 = arith.constant 1 : index
    %sum = pto.vmi.vcadd %source, %mask {group = 8}
        : !pto.vmi.vreg<128xi16>, !pto.vmi.mask<128xpred>
        -> !pto.vmi.vreg<8xi16>
    pto.vmi.vstore %sum, %dst[%off], %c1 {group = 8}
        : !pto.vmi.vreg<8xi16>, !pto.ptr<i16, ub>
    return
  }
}

// CHECK-LABEL: func.func @group_reduce_addi_i16(
// CHECK: %[[SUM:.*]] = pto.vcgadd {{.*}} : !pto.vreg<128xi16>, !pto.mask<b16> -> !pto.vreg<128xi16>
// CHECK: pto.vsts %[[SUM]], {{.*}} : !pto.vreg<128xi16>, !pto.ptr<i16, ub>, !pto.mask<b16>
