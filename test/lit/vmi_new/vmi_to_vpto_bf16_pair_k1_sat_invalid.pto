// A hand-written dense same-layout (contiguous -> contiguous) f32-to-bf16
// narrowing that does not satisfy the NaN-relaxed fastmath condition
// (saturate="SAT").  The truncf layout support must reject it and name the
// condition; a silent per-part vcvt would leave the result half-filled.

// The failure is the saturate="SAT" attribute, not the pipeline state: both
// runs use the default (fastmath enabled) state.
// RUN: not pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto 2>&1 | FileCheck %s
// RUN: not pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-layout-assignment 2>&1 | FileCheck %s --check-prefix=ASSIGN

module {
  func.func @f32_to_bf16_pair_64_sat(
      %src: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<64xbf16, #pto.vmi.layout<contiguous>> {
    %result = pto.vmi.vcvt %src {rounding = "Z", saturate = "SAT"}
        : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<64xbf16, #pto.vmi.layout<contiguous>>
    return %result : !pto.vmi.vreg<64xbf16, #pto.vmi.layout<contiguous>>
  }
}

// CHECK: error: VMI-UNSUPPORTED: pto.vmi.truncf
// CHECK-SAME: dense same-layout BF16 narrowing relation is only realized by the NaN-relaxed fastmath lowering
// CHECK-SAME: rounding="Z" and saturate="NOSAT"
// CHECK-SAME: saturate="SAT"

// Layout assignment rejects the hand-written dense pair itself, before any
// lowering runs.
// ASSIGN: error: VMI-LAYOUT-CONTRACT: a dense same-layout BF16 narrowing (contiguous -> contiguous) is only realized by the NaN-relaxed fastmath lowering
// ASSIGN-SAME: rounding="Z" and saturate="NOSAT"
// ASSIGN-SAME: saturate="SAT"
