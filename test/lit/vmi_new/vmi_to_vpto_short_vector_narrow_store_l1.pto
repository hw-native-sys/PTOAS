// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto %s -o - | FileCheck %s --check-prefix=STRIDE --implicit-check-not=pto.vmi. --implicit-check-not='!pto.vmi.'
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --vmi-prefer-lane-stride-narrowing=false %s -o - | FileCheck %s --check-prefix=NOSTRIDE --implicit-check-not=pto.vmi. --implicit-check-not='!pto.vmi.'

// The one-element case reaches the same single-carrier bridge on both paths.
// A one-element narrowing cannot use the deinterleaved alternative the
// preference would otherwise fall back to -- its logical lane count is smaller
// than the deinterleave factor, so the trailing sub-parts are empty and neither
// the deinterleaving read nor the narrowing plan has a form for it -- so the
// preference must not switch this shape away from the lane-stride relation.
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @short_narrow_store_f16_L1(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<f16, ub>, %off: index) attributes {pto.kernel} {
    %c16 = arith.constant 16 : index
    %aoff = arith.muli %off, %c16 : index
    pto.vecscope {
      %s = pto.vmi.vload %src[%aoff] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<1xf32>
      %n = pto.vmi.vcvt %s {saturate = "SAT"} : !pto.vmi.vreg<1xf32> -> !pto.vmi.vreg<1xf16>
      pto.vmi.vstore %n, %dst[%aoff] : !pto.vmi.vreg<1xf16>, !pto.ptr<f16, ub>
    }
    return
  }

}

// STRIDE-LABEL: func.func @short_narrow_store_f16_L1(
// STRIDE: pto.vcvt
// STRIDE: pto.vsts
// NOSTRIDE-LABEL: func.func @short_narrow_store_f16_L1(
// NOSTRIDE: pto.vcvt
// NOSTRIDE: pto.vsts
