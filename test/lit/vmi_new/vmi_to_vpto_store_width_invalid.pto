// RUN: not pto-test-opt %s -split-input-file -vmi-lower-unified-to-legacy -vmi-to-vpto 2>&1 | FileCheck %s

module {
  func.func @vmi_store_f64_unsupported(
      %value: !pto.vmi.vreg<32xf64>,
      %dst: memref<32xf64, #pto.address_space<vec>>,
      %offset: index) {
    pto.vmi.vstore %value, %dst[%offset]
        : !pto.vmi.vreg<32xf64>, memref<32xf64, #pto.address_space<vec>>, index
    return
  }
}

// CHECK: expected an 8-bit, 16-bit, or 32-bit logical element type
