// RUN: pto-test-opt %s -split-input-file -verify-diagnostics

module {
  func.func @wrong_type(%src: !pto.vmi.vreg<128xf16>) {
    // expected-error@+1 {{requires BF16 source and F32 results}}
    %a, %b = pto.vmi.deinterleave_extf %src : !pto.vmi.vreg<128xf16> -> !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>
    return
  }
}

// -----

module {
  func.func @wrong_count(%src: !pto.vmi.vreg<128xbf16>) {
    // expected-error@+1 {{requires two results with half the source lane count}}
    %a, %b = pto.vmi.deinterleave_extf %src : !pto.vmi.vreg<128xbf16> -> !pto.vmi.vreg<128xf32>, !pto.vmi.vreg<64xf32>
    return
  }
}
