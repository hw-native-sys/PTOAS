// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s

// The dense e4m3 path used by per_channel_cast materializes its input through
// UNPK_B8. Valid bytes occupy even lanes, so extf must select P0/P2 rather than
// the zero-fill P1/P3 lanes.

module {
  func.func @dense_f8_ls2_to_f32_d2(
      %x: !pto.vmi.vreg<128xf8E4M3FN, #pto.vmi.layout<contiguous, lane_stride = 2>>)
      -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>> {
    %r = pto.vmi.vcvt %x
        : !pto.vmi.vreg<128xf8E4M3FN, #pto.vmi.layout<contiguous, lane_stride = 2>>
       -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
    return %r : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
  }
}

// CHECK-LABEL: func.func @dense_f8_ls2_to_f32_d2(
// CHECK: pto.vcvt {{.*}} {part = "P0"}
// CHECK: pto.vcvt {{.*}} {part = "P2"}
// CHECK-NOT: part = "P1"
// CHECK-NOT: part = "P3"
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast
