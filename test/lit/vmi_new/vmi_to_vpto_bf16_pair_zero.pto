// The VMI conversion state is recorded once on the module (vmi-set-fastmath)
// and read back by every VMI pass, so both runs pin it explicitly.
// RUN: pto-test-opt %s -vmi-set-fastmath=vmi-fastmath=true -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s
// RUN: pto-test-opt %s -vmi-set-fastmath=vmi-fastmath=false -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s --check-prefix=STRICT

module {
  // Saturating narrowing keeps the honest lane_stride relation: the per-part
  // vcvt writes the converted lanes at lane_stride 2, so the result says so and
  // no dense value is ever claimed.  (The K=1 dense fastmath form lives in
  // vmi_to_vpto_bf16_pair_zero_k1.pto; a dense pair here would be rejected.)
  func.func @f32_to_bf16_pair_64_sat(
      %src: !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<64xbf16, #pto.vmi.layout<contiguous, lane_stride = 2>> {
    %result = pto.vmi.vcvt %src {rounding = "Z", saturate = "SAT"}
        : !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<64xbf16, #pto.vmi.layout<contiguous, lane_stride = 2>>
    return %result : !pto.vmi.vreg<64xbf16,
                                    #pto.vmi.layout<contiguous, lane_stride = 2>>
  }

  func.func @f32_to_bf16_pair_128(
      %src: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<64x!pto.f4E2M1x2,
                        #pto.vmi.layout<contiguous, lane_stride = 4>> {
    %result = pto.vmi.vcvt %src {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
    %pair = pto.vmi.vinterpret_cast %result
        : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<64x!pto.bf16x2, #pto.vmi.layout<contiguous>>
    %packed = pto.vmi.vcvt %pair {rounding = "R"}
        : !pto.vmi.vreg<64x!pto.bf16x2, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<64x!pto.f4E2M1x2,
                          #pto.vmi.layout<contiguous, lane_stride = 4>>
    return %packed : !pto.vmi.vreg<64x!pto.f4E2M1x2,
                                   #pto.vmi.layout<contiguous, lane_stride = 4>>
  }

  func.func @f32_to_bf16_pair_256(
      %src: !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<128x!pto.f4E2M1x2,
                        #pto.vmi.layout<contiguous, lane_stride = 4>> {
    %result = pto.vmi.vcvt %src {rounding = "Z", saturate = "NOSAT"}
        : !pto.vmi.vreg<256xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous>>
    %pair = pto.vmi.vinterpret_cast %result
        : !pto.vmi.vreg<256xbf16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128x!pto.bf16x2, #pto.vmi.layout<contiguous>>
    %packed = pto.vmi.vcvt %pair {rounding = "R"}
        : !pto.vmi.vreg<128x!pto.bf16x2, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128x!pto.f4E2M1x2,
                          #pto.vmi.layout<contiguous, lane_stride = 4>>
    return %packed : !pto.vmi.vreg<128x!pto.f4E2M1x2,
                                   #pto.vmi.layout<contiguous, lane_stride = 4>>
  }

  func.func @bf16_to_f32_pair_128(
      %src: !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>> {
    %result = pto.vmi.vcvt %src
        : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
    %reduced = pto.vmi.vcmax %result, %mask {group = 2}
        : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>>
    return %reduced : !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>>
  }
}

// CHECK-LABEL: func.func @f32_to_bf16_pair_64_sat(
// CHECK: pto.vcvt
// CHECK-NOT: pto.vdintlv
// CHECK-LABEL: func.func @f32_to_bf16_pair_128(
// CHECK: %[[F32_128_0:.*]] = pto.vbitcast %{{.*}} : !pto.vreg<64xf32> -> !pto.vreg<128xi16>
// CHECK: %[[F32_128_1:.*]] = pto.vbitcast %{{.*}} : !pto.vreg<64xf32> -> !pto.vreg<128xi16>
// CHECK: pto.vdintlv %[[F32_128_0]], %[[F32_128_1]]
// CHECK-COUNT-1: pto.vcvt
// CHECK-LABEL: func.func @f32_to_bf16_pair_256(
// CHECK: pto.vdintlv
// CHECK: pto.vdintlv
// CHECK-COUNT-2: pto.vcvt
// CHECK-LABEL: func.func @bf16_to_f32_pair_128(
// CHECK: %[[BF16_ZERO:.*]] = pto.vdup {{.*}} -> !pto.vreg<128xbf16>
// CHECK: %[[LOW128:.*]], %[[HIGH128:.*]] = pto.vintlv %[[BF16_ZERO]], %{{.*}}
// CHECK: %{{.*}} = pto.vbitcast %[[LOW128]] : !pto.vreg<128xbf16> -> !pto.vreg<64xf32>
// CHECK: %{{.*}} = pto.vbitcast %[[HIGH128]] : !pto.vreg<128xbf16> -> !pto.vreg<64xf32>
// CHECK-NOT: pto.vcvt

// STRICT-LABEL: func.func @f32_to_bf16_pair_64_sat(
// STRICT: pto.vcvt
// STRICT-NOT: pto.vdintlv
// STRICT-LABEL: func.func @f32_to_bf16_pair_128(
// STRICT: pto.vcvt
// STRICT: pto.vbitcast
// STRICT: pto.vdintlv
// STRICT: pto.vcvt
// STRICT-LABEL: func.func @f32_to_bf16_pair_256(
// STRICT: pto.vdintlv
// STRICT: pto.vdintlv
// STRICT: pto.vcvt
