// Paired by the ISA FFTS host harness, with one cube and two vector participants.
module attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @ptoas_ffts_signal(%ffts: !pto.ptr<i64>, %event: index) attributes {pto.kernel} {
    pto.set_ffts %ffts : !pto.ptr<i64>
    pto.sync.set <PIPE_FIX>, %event {ffts_mode = 2 : i32}
    return
  }
  func.func @ptoas_ffts_wait(%ffts: !pto.ptr<i64>, %event: index) attributes {pto.kernel} {
    pto.set_ffts %ffts : !pto.ptr<i64>
    pto.sync.wait <PIPE_MTE2>, %event
    return
  }
}
