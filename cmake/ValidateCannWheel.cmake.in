# Check the actual wheel at install/CPack staging time, including nested ELF
# files that CMake's --strip cannot reach inside a ZIP archive.
execute_process(
  COMMAND "@Python3_EXECUTABLE@"
          "@PTOAS_ROOT_DIR@/scripts/package/harden_cann_wheel.py"
          "@PTOAS_WHEEL_FILE@" --check
  RESULT_VARIABLE _ptoas_wheel_check_result
)
if(NOT _ptoas_wheel_check_result EQUAL 0)
  message(FATAL_ERROR "CANN wheel ELF hardening validation failed")
endif()
