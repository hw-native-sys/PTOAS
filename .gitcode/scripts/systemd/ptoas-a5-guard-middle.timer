[Unit]
Description=PTOAS A5 nightly guard (middle) at 02:00
Documentation=https://gitcode.com/cann/pto-as/blob/master/docs/ci/a5-nightly-board.md

[Timer]
# middle checkpoint. Times are local (CST, UTC+8); the nightly itself starts
# at 00:00 and needs roughly four hours on a dedicated card.
OnCalendar=*-*-* 02:00:00
Persistent=false
RandomizedDelaySec=0
Unit=ptoas-a5-guard@middle.service

[Install]
WantedBy=timers.target
