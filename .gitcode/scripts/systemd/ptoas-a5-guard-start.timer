[Unit]
Description=PTOAS A5 nightly guard (start) at 00:05
Documentation=https://gitcode.com/cann/pto-as/blob/master/docs/ci/a5-nightly-board.md

[Timer]
# start checkpoint. Times are local (CST, UTC+8); the nightly itself starts
# at 00:00 and needs roughly four hours on a dedicated card.
OnCalendar=*-*-* 00:05:00
Persistent=false
RandomizedDelaySec=0
Unit=ptoas-a5-guard@start.service

[Install]
WantedBy=timers.target
